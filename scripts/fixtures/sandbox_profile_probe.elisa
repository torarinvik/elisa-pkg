include "../../src/platform.elisa"
include "../../src/sandbox.elisa"

module SandboxProfileProbe:
    private:
        def copy_environment(name: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            if Platform::pkg_getenv(name) is raw_value:
                value: cstr = raw_value.cast[cstr] can Unsafe.PointerCast
                length: usize = Platform::pkg_strlen(value)
                return false if length == 0 or length > 4096.usize()
                for index in 0..<length |out, value|:
                    out.push(value[index].u8())
                return true
            return false

    public:
        def run() -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            home: mutable cstr = ""
            if Platform::pkg_getenv("HOME") is raw_home:
                home <- raw_home.cast[cstr] can Unsafe.PointerCast
            else:
                return 1
            project: mutable darray[u8] = []
            build: mutable darray[u8] = []
            source_snapshot: mutable darray[u8] = []
            return 2 if not copy_environment("ELISAPKG_TEST_PROJECT_ROOT", &project)
            return 3 if not copy_environment("ELISAPKG_TEST_BUILD_ROOT", &build)
            return 3 if not copy_environment("ELISAPKG_TEST_SOURCE_SNAPSHOT", &source_snapshot)
            output: mutable cstr = ""
            executable_one: mutable cstr = ""
            executable_two: mutable cstr = ""
            if Platform::pkg_getenv("ELISAPKG_TEST_OUTPUT") is raw_output:
                output <- raw_output.cast[cstr] can Unsafe.PointerCast
            else:
                return 4
            if Platform::pkg_getenv("ELISAPKG_TEST_EXECUTABLE_ONE") is raw_executable_one:
                executable_one <- raw_executable_one.cast[cstr] can Unsafe.PointerCast
            else:
                return 4
            if Platform::pkg_getenv("ELISAPKG_TEST_EXECUTABLE_TWO") is raw_executable_two:
                executable_two <- raw_executable_two.cast[cstr] can Unsafe.PointerCast
            else:
                return 4
            dependencies: mutable darray[u8] = []
            tools: mutable darray[cstr] = []
            executables: mutable darray[cstr] = []
            executables.push(executable_one)
            executables.push(executable_two)
            profile: mutable darray[u8] = Sandbox::darwin_build_profile(home, project, build, source_snapshot, dependencies, tools, executables, output)
            return 5 if profile.count == 0
            offset: mutable usize = 0.usize()
            while offset < profile.count |profile, offset|:
                raw: void& = (&profile[offset]).cast[void&] can Unsafe.PointerCast
                written: i64 = Platform::pkg_write(1, raw, profile.count - offset) can Console.Write
                return 6 if written <= 0 or written > (profile.count - offset).i64()
                offset <- offset + written.usize()
            return 0

def main() -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return SandboxProfileProbe::run()
