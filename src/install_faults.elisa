# Production transaction-boundary hook.
#
# The default implementation is deliberately inert. Regression builds replace
# this module in a private copied source tree so process-stop controls are never
# compiled into the shipped binary.
module InstallFaults:
    public:
        def transaction_boundary(name: cstr) -> void can[Console.Write, Memory.Allocate, Unsafe.PointerCast]:
            return

        # Test binaries may use a prebuilt fixture to reach transaction
        # publication without depending on a host compiler or linker setup.
        def use_test_prebuilt_artifact() -> bool can[Memory.Allocate, Unsafe.PointerCast]:
            return false
