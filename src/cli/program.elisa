# Execute a built program with a bounded lifetime and a scrubbed environment.
include "../build.elisa"
include "./status.elisa"
include "../package/model.elisa"
include "../package/targets.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../text/bytes.elisa"
include "../toolchain.elisa"
include "./output.elisa"

module ProgramCommand:
    public:
        def run(argument_count: i64, slots: cstr&&, options: Model::CommandOptions, expected_kind: cstr) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                child_process_identifier: i64 =
                    # The selected target's built executable, NUL-terminated.
                    artifact_path_c: darray[u8] =
                        manifest_raw: mutable darray[u8] = []
                        manifest_raw <- manifest_raw.resize(ProjectFiles::project_document_limit)
                        target_name: mutable darray[u8] = []
                        target_kind: mutable darray[u8] = []
                        target_entry: mutable darray[u8] = []
                        if not ProjectFiles::read_c_string_into("elisapkg.json", &manifest_raw) or not ManifestTargets::select_target(manifest_raw, options.target_name, options.target_kind, &target_name, &target_kind, &target_entry):
                            return CliStatus::build_failed
                        elif not ByteText::equal_text(target_kind, expected_kind):
                            CliOutput::write_error("error: selected target does not produce an executable\n")
                            return CliStatus::build_failed
                        else:
                            artifact_path: darray[u8] =
                                artifact_label: darray[u8] = ManifestTargets::artifact_leaf(target_name, false)
                                build_root: darray[u8] =
                                    current_directory: darray[u8] = []
                                    Build::output_directory(current_directory, Platform::c_string_equal(options.profile, "release"))
                                ProjectFiles::path_join_bytes(build_root, artifact_label)
                            ProjectFiles::with_null_terminator(&artifact_path)
                    arguments: mutable darray[cstr] = ["/usr/bin/env", "-i", Toolchain::isolated_path_environment, ((&artifact_path_c[0]).cast[cstr] can Unsafe.PointerCast)]
                    # Pass the arguments after the first `--` through to the program.
                    while index < argument_count |arguments, index: i64 = 2, passing: bool = false|:
                        if passing:
                            arguments <- arguments.push(slots[index].cast[cstr])
                        elif Platform::c_string_equal(slots[index].cast[cstr], "--"):
                            passing <- true
                        index <- index + 1
                    arguments <- arguments.push(null)
                    fork_program(&artifact_path_c, &arguments)
                if child_process_identifier < 0:
                    CliStatus::build_failed
                else:
                    status: mutable i32 = 0
                    waited: i64 = Platform::wait_for_process_group_with_timeout(child_process_identifier, &status, PROGRAM_TIMEOUT_MS)
                    if waited == Platform::timeout_error():
                        CliStatus::cancelled
                    elif waited < 0:
                        CliStatus::build_failed
                    else:
                        # waitpid returns the platform wait status. Preserve a normal child's exit
                        # code for `run`, and map signal termination to the documented cancellation
                        # status instead of exposing the platform-specific wait encoding.
                        status.i64() / 256.i64() if status % 256 == 0 else CliStatus::cancelled

    private:
        const PROGRAM_TIMEOUT_MS: i64 = 120000

        # Fork the program child. `artifact_path` backs the argument vector's
        # program name, so the caller keeps it alive until the fork copies it.
        def fork_program(artifact_path: darray[u8]&, arguments: mutable darray[cstr]&) -> i64 can[Unsafe.PointerCast]:
            requires artifact_path.count > 0
            child_process_identifier: i64 = Platform::fork_process()
            if child_process_identifier == 0:
                run_program_child((&arguments[0]).cast[mutable cstr&&] can Unsafe.PointerCast)
            child_process_identifier

        # In the forked child: isolate the process and execute the program
        # with an empty environment. Package code must not inherit file,
        # socket, or credential-agent descriptors supplied by the invoking
        # process, so only the standard streams survive, and the child stops
        # if the close sweep cannot prove cleanup. Never returns.
        def run_program_child(child_argument_vector: mutable cstr&&) -> void can[Unsafe.PointerCast]:
            if Platform::set_process_group() != 0:
                Platform::exit_process(126)
            if Platform::set_process_limits(2) != 0:
                Platform::exit_process(126)
            if Platform::close_inherited_file_descriptors() != 0:
                Platform::exit_process(126)
            _ = Platform::execute_program("/usr/bin/env", child_argument_vector)
            Platform::exit_process(127)
