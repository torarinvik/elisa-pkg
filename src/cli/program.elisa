# Execute a built program with a bounded lifetime and a scrubbed environment.
include "../build.elisa"
include "./status.elisa"
include "../package/model.elisa"
include "../package/targets.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../text/bytes.elisa"
include "../toolchain.elisa"
include "./output.elisa"

module ProgramCommand:
    public:
        def run(argument_count: i64, slots: mutable cstr&&, options: Model::CommandOptions, expected_kind: cstr) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                manifest_raw: mutable darray[u8] = []
                manifest_raw <- manifest_raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::build_failed if not ProjectFiles::read_c_string_into("elisapkg.json", &manifest_raw)
                artifact_label: darray[u8] =
                    target_name: mutable darray[u8] = []
                    target_kind: mutable darray[u8] = []
                    region target_entry_scope:
                        target_entry: mutable darray[u8] = []
                        return CliStatus::build_failed if not ManifestTargets::select_target(manifest_raw, options.target_name, options.target_kind, &target_name, &target_kind, &target_entry)
                    if not ByteText::equal_text(target_kind, expected_kind):
                        CliOutput::write_error("error: selected target does not produce an executable\n")
                        return CliStatus::build_failed
                    ManifestTargets::artifact_leaf(target_name, false)
                build_root: darray[u8] =
                    current_directory: darray[u8] = []
                    Build::output_directory(current_directory, Platform::c_string_equal(options.profile, "release"))
                artifact_path: mutable darray[u8] = []
                ProjectFiles::path_join_bytes_into(build_root, artifact_label, &artifact_path)
                artifact_path_c: mutable darray[u8] = []
                ProjectFiles::path_with_null_terminator_into(&artifact_path, &artifact_path_c)
                artifact_name: cstr = (&artifact_path_c[0]).cast[cstr] can Unsafe.PointerCast
                arguments: mutable darray[cstr] = []
                arguments <- arguments.push("/usr/bin/env")
                arguments <- arguments.push("-i")
                arguments <- arguments.push(Toolchain::isolated_path_environment)
                arguments <- arguments.push(artifact_name)
                index: mutable i64 = 2
                while index < argument_count and not Platform::c_string_equal(slots[index].cast[cstr], "--") |slots, index|:
                    index <- index + 1
                index <- index + 1 if index < argument_count and Platform::c_string_equal(slots[index].cast[cstr], "--")
                while index < argument_count |arguments, slots, index|:
                    arguments <- arguments.push(slots[index].cast[cstr])
                    index <- index + 1
                arguments <- arguments.push(null)
                child_argument_vector: mutable cstr&& = (&arguments[0]).cast[mutable cstr&&] can Unsafe.PointerCast
                child_process_identifier: i64 = Platform::fork_process()
                if child_process_identifier == 0:
                    if Platform::set_process_group() != 0:
                        Platform::exit_process(126)
                    if Platform::set_process_limits(2) != 0:
                        Platform::exit_process(126)
                    # Package code must not inherit file, socket, or credential-agent
                    # descriptors supplied by the invoking process. Preserve only the
                    # standard streams and stop if the close sweep cannot prove cleanup.
                    if Platform::close_inherited_file_descriptors() != 0:
                        Platform::exit_process(126)
                    _ = Platform::execute_program("/usr/bin/env", child_argument_vector)
                    Platform::exit_process(127)
                return CliStatus::build_failed if child_process_identifier < 0
                status: mutable i32 = 0
                region waited_scope:
                    waited: i64 = Platform::wait_for_process_group_with_timeout(child_process_identifier, &status, PROGRAM_TIMEOUT_MS)
                    return CliStatus::cancelled if waited == Platform::timeout_error()
                    return CliStatus::build_failed if waited < 0
                # waitpid returns the platform wait status. Preserve a normal child's exit
                # code for `run`, and map signal termination to the documented cancellation
                # status instead of exposing the platform-specific wait encoding.
                return status.i64() / 256.i64() if status % 256 == 0
                return CliStatus::cancelled

    private:
        const PROGRAM_TIMEOUT_MS: i64 = 120000
