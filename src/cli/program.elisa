# Execute a built program with a bounded lifetime and a scrubbed environment.
include "../build.elisa"
include "./status.elisa"
include "../package/model.elisa"
include "../package/targets.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../text/bytes.elisa"
include "../toolchain.elisa"
include "./output.elisa"

module ProgramCommand:
    public:
        def run(argc: i64, slots: mutable cstr&&, options: Model::CommandOptions, expected_kind: cstr) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                manifest_raw: mutable darray[u8] = []
                manifest_raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::build_failed if not ProjectFiles::read_cstr_into("elisapkg.json", &manifest_raw)
                target_name: mutable darray[u8] = []
                target_kind: mutable darray[u8] = []
                target_entry: mutable darray[u8] = []
                return CliStatus::build_failed if not ManifestTargets::select_target(manifest_raw, options.target_name, options.target_kind, &target_name, &target_kind, &target_entry)
                if not ByteText::equal_text(target_kind, expected_kind):
                    CliOutput::write_error("error: selected target does not produce an executable\n")
                    return CliStatus::build_failed
                artifact_label: darray[u8] = ManifestTargets::artifact_leaf(target_name, false)
                artifact_leaf_storage: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(artifact_label, &artifact_leaf_storage)
                artifact_leaf: cstr = (&artifact_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
                current_directory: darray[u8] = []
                build_root: darray[u8] = Build::output_directory(current_directory, Platform::pkg_cstr_equal(options.profile, "release"))
                artifact_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(build_root, artifact_leaf, &artifact_path)
                artifact_path_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&artifact_path, &artifact_path_c)
                artifact_name: cstr = (&artifact_path_c[0]).cast[cstr] can Unsafe.PointerCast
                args: mutable darray[cstr] = []
                args.push("/usr/bin/env")
                args.push("-i")
                args.push(Toolchain::isolated_path_environment)
                args.push(artifact_name)
                index: mutable i64 = 2
                while index < argc and not Platform::pkg_cstr_equal(slots[index].cast[cstr], "--") |slots, index|:
                    index <- index + 1
                index <- index + 1 if index < argc and Platform::pkg_cstr_equal(slots[index].cast[cstr], "--")
                while index < argc |args, slots, index|:
                    args.push(slots[index].cast[cstr])
                    index <- index + 1
                args.push(null)
                child_argv: mutable cstr&& = (&args[0]).cast[mutable cstr&&] can Unsafe.PointerCast
                pid: i64 = Platform::pkg_fork()
                if pid == 0:
                    if Platform::pkg_set_process_group() != 0:
                        Platform::pkg_process_exit(126)
                    if Platform::pkg_set_process_limits(2) != 0:
                        Platform::pkg_process_exit(126)
                    # Package code must not inherit file, socket, or credential-agent
                    # descriptors supplied by the invoking process. Preserve only the
                    # standard streams and stop if the close sweep cannot prove cleanup.
                    if Platform::pkg_close_inherited_fds() != 0:
                        Platform::pkg_process_exit(126)
                    _ = Platform::pkg_execvp("/usr/bin/env", child_argv)
                    Platform::pkg_process_exit(127)
                return CliStatus::build_failed if pid < 0
                status: mutable i32 = 0
                waited: i64 = Platform::pkg_waitpid_group_timeout(pid, &status, PROGRAM_TIMEOUT_MS)
                return CliStatus::cancelled if waited == Platform::pkg_timeout_error()
                return CliStatus::build_failed if waited < 0
                # waitpid returns the platform wait status. Preserve a normal child's exit
                # code for `run`, and map signal termination to the documented cancellation
                # status instead of exposing the platform-specific wait encoding.
                return status.i64() / 256.i64() if status % 256 == 0
                return CliStatus::cancelled

    private:
        const PROGRAM_TIMEOUT_MS: i64 = 120000
