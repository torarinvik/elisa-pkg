# The CLI argument grammar and argument_vector compaction. The caller owns output policy
# and dispatches the command after validation.
include "../package/model.elisa"
include "../platform.elisa"

module CliArguments:
    public:
        # `init` and dependency mutations have command-specific positional
        # grammars, so they are dispatched before the common parser below.
        # Strip the output-only global modes first so those commands still
        # honor the same quiet/color contract as every other command without
        # accidentally accepting flags intended for a different operation.
        def compact_output_modes(argument_count: i64, slots: mutable cstr&&, out: mutable darray[cstr]&, quiet: mutable bool&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return -1 if argument_count < 2
            out.push(slots[0].cast[cstr])
            out.push(slots[1].cast[cstr])
            color_seen: mutable bool = false
            index: mutable i64 = 2
            while index < argument_count |slots, out, color_seen, index|:
                argument: cstr = slots[index].cast[cstr]
                if Platform::c_string_equal(argument, "--quiet"):
                    quiet <- true
                    index <- index + 1
                    continue
                if Platform::c_string_equal(argument, "--color"):
                    return -1 if color_seen or index + 1 >= argument_count
                    region color_value_scope:
                        color_value: cstr = slots[index + 1].cast[cstr]
                        return -1 if not valid_color_mode(color_value)
                    color_seen <- true
                    index <- index + 2
                    continue
                out.push(argument)
                index <- index + 1
            out.push(null)
            return out.count.i64() - 1

        def compact_manifest_arguments(argument_count: i64, slots: mutable cstr&&, out: mutable darray[cstr]&, quiet: mutable bool&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return 0 if argument_count < 2
            out.push(slots[0].cast[cstr])
            out.push(slots[1].cast[cstr])
            index: mutable i64 = 2
            separator_seen: mutable bool = false
            color_seen: mutable bool = false
            while index < argument_count |slots, out, index, separator_seen, color_seen|:
                if Platform::c_string_equal(slots[index].cast[cstr], "--"):
                    separator_seen <- true
                    out.push(slots[index].cast[cstr])
                    index <- index + 1
                    continue
                if not separator_seen and Platform::c_string_equal(slots[index].cast[cstr], "--quiet"):
                    quiet <- true
                    index <- index + 1
                    continue
                if not separator_seen and Platform::c_string_equal(slots[index].cast[cstr], "--color"):
                    return -1 if color_seen or index + 1 >= argument_count
                    region color_value_scope:
                        color_value: cstr = slots[index + 1].cast[cstr]
                        return -1 if not valid_color_mode(color_value)
                    color_seen <- true
                    index <- index + 2
                    continue
                if not separator_seen and Platform::c_string_equal(slots[index].cast[cstr], "--manifest-path"):
                    index <- index + 2
                    continue
                out.push(slots[index].cast[cstr])
                index <- index + 1
            out.push(null)
            return out.count.i64() - 1

        # The common parser has already copied these modes into `options` or
        # process-local output state. Remove them before dispatch so handlers
        # that inspect argument_vector see only command-specific flags and positionals.
        # Keep everything after `--` intact because run/test forward that tail
        # to the selected program.
        def compact_validated_global_options(argument_count: i64, slots: mutable cstr&&, out: mutable darray[cstr]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return -1 if argument_count < 2
            out.push(slots[0].cast[cstr])
            out.push(slots[1].cast[cstr])
            index: mutable i64 = 2
            separator_seen: mutable bool = false
            while index < argument_count |slots, out, index, separator_seen|:
                argument: cstr = slots[index].cast[cstr]
                if not separator_seen and Platform::c_string_equal(argument, "--"):
                    separator_seen <- true
                    out.push(argument)
                    index <- index + 1
                    continue
                if not separator_seen and (Platform::c_string_equal(argument, "--locked") or Platform::c_string_equal(argument, "--offline") or Platform::c_string_equal(argument, "--frozen") or Platform::c_string_equal(argument, "--json") or Platform::c_string_equal(argument, "--verbose") or Platform::c_string_equal(argument, "--quiet")):
                    index <- index + 1
                    continue
                if not separator_seen and Platform::c_string_equal(argument, "--color"):
                    index <- index + 2
                    continue
                if not separator_seen and Platform::c_string_equal(argument, "--manifest-path"):
                    index <- index + 2
                    continue
                out.push(argument)
                index <- index + 1
            out.push(null)
            return out.count.i64() - 1

        def read_common_flags(argument_count: i64, slots: mutable cstr&&, command: cstr, options: mutable Model::CommandOptions&, quiet: mutable bool&, publish_dry_run: mutable bool&) -> bool can[Unsafe.PointerCast]:
            flags_ok: mutable bool = true
            positional_count: mutable i64 = 0
            separator_seen: mutable bool = false
            profile_seen: mutable bool = false
            target_name_seen: mutable bool = false
            color_seen: mutable bool = false
            index: mutable i64 = 2
            while index < argument_count |slots, options, flags_ok, positional_count, separator_seen, profile_seen, target_name_seen, publish_dry_run, index|:
                flag: cstr = slots[index].cast[cstr]
                if Platform::c_string_equal(flag, "--"):
                    separator_seen <- true
                    flags_ok <- false if not (Platform::c_string_equal(command, "run") or Platform::c_string_equal(command, "test"))
                    index <- index + 1
                    continue
                if separator_seen:
                    index <- index + 1
                    continue
                if Platform::c_string_equal(flag, "--bin") or Platform::c_string_equal(flag, "--lib") or Platform::c_string_equal(flag, "--test"):
                    flags_ok <- false if not flags_ok or not target_flag_valid(argument_count, slots, index, command, flag) or target_name_seen
                    target_name_seen <- true if flags_ok
                    index <- index + 2
                    continue
                if Platform::c_string_equal(flag, "--profile"):
                    flags_ok <- false if not flags_ok or profile_seen or not profile_flag_valid(argument_count, slots, index, command)
                    profile_seen <- true if flags_ok
                    index <- index + 2
                    continue
                options.locked <- true if Platform::c_string_equal(flag, "--locked")
                options.offline <- true if Platform::c_string_equal(flag, "--offline")
                options.frozen <- true if Platform::c_string_equal(flag, "--frozen")
                options.json <- true if Platform::c_string_equal(flag, "--json")
                options.verbose <- true if Platform::c_string_equal(flag, "--verbose")
                quiet <- true if Platform::c_string_equal(flag, "--quiet")
                publish_dry_run <- true if Platform::c_string_equal(command, "publish") and Platform::c_string_equal(flag, "--dry-run")
                if Platform::c_string_equal(flag, "--color"):
                    flags_ok <- false if color_seen or index + 1 >= argument_count
                    if flags_ok:
                        region color_value_scope:
                            color_value: cstr = slots[index + 1].cast[cstr]
                            flags_ok <- false if not valid_color_mode(color_value)
                        color_seen <- true if flags_ok
                    index <- index + 2
                    continue
                is_positional: bool =
                    flag_length: usize = Platform::c_string_length(flag)
                    flag_length > 0.usize() and flag[0].u8() != 45
                positional_allowed: bool = (Platform::c_string_equal(command, "why") and positional_count == 0) or (Platform::c_string_equal(command, "install") and positional_count == 0) or (Platform::c_string_equal(command, "uninstall") and positional_count == 0) or (Platform::c_string_equal(command, "cache") and positional_count == 0) or (Platform::c_string_equal(command, "fetch") and positional_count < 2)
                region recognized_scope:
                    recognized: mutable bool = is_positional and positional_allowed
                    recognized <- true if not is_positional and (Platform::c_string_equal(flag, "--locked") or Platform::c_string_equal(flag, "--offline") or Platform::c_string_equal(flag, "--frozen") or Platform::c_string_equal(flag, "--json") or Platform::c_string_equal(flag, "--verbose") or Platform::c_string_equal(flag, "--quiet") or (Platform::c_string_equal(flag, "--list") and Platform::c_string_equal(command, "package")) or (Platform::c_string_equal(flag, "--dry-run") and (Platform::c_string_equal(command, "cache") or Platform::c_string_equal(command, "publish"))) or (Platform::c_string_equal(command, "install") and Platform::c_string_equal(flag, "--local")) or (Platform::c_string_equal(command, "uninstall") and Platform::c_string_equal(flag, "--local")))
                    flags_ok <- false if not recognized
                    positional_count <- positional_count + 1 if recognized and is_positional
                index <- index + 1
            return flags_ok

        # A target flag the command accepts, followed by a short name that is
        # not itself a flag.
        def target_flag_valid(argument_count: i64, slots: mutable cstr&&, index: i64, command: cstr, flag: cstr) -> bool can[Unsafe.PointerCast]:
            target_allowed: bool = (Platform::c_string_equal(command, "build") and (Platform::c_string_equal(flag, "--bin") or Platform::c_string_equal(flag, "--lib") or Platform::c_string_equal(flag, "--test"))) or (Platform::c_string_equal(command, "run") and Platform::c_string_equal(flag, "--bin")) or (Platform::c_string_equal(command, "test") and Platform::c_string_equal(flag, "--test")) or (Platform::c_string_equal(command, "install") and Platform::c_string_equal(flag, "--bin"))
            return false if not target_allowed or index + 1 >= argument_count
            target_value: cstr = slots[index + 1].cast[cstr]
            target_length: usize = Platform::c_string_length(target_value)
            return target_length > 0.usize() and target_length <= 64.usize() and target_value[0].u8() != 45

        # `--profile debug` or `--profile release` on a building command.
        def profile_flag_valid(argument_count: i64, slots: mutable cstr&&, index: i64, command: cstr) -> bool can[Unsafe.PointerCast]:
            profile_allowed: bool = Platform::c_string_equal(command, "build") or Platform::c_string_equal(command, "run") or Platform::c_string_equal(command, "test") or Platform::c_string_equal(command, "install")
            return false if not profile_allowed or index + 1 >= argument_count
            profile_value: cstr = slots[index + 1].cast[cstr]
            return Platform::c_string_equal(profile_value, "debug") or Platform::c_string_equal(profile_value, "release")

        def read_target_flags(argument_count: i64, dispatch_slots: mutable cstr&&, command: cstr, options: mutable Model::CommandOptions&) -> void can[Unsafe.PointerCast]:
            dispatch_index: mutable i64 = 2
            dispatch_separator_seen: mutable bool = false
            while dispatch_index < argument_count |dispatch_slots, dispatch_index, dispatch_separator_seen, options|:
                region dispatch_flag_scope:
                    dispatch_flag: cstr = dispatch_slots[dispatch_index].cast[cstr]
                    if Platform::c_string_equal(dispatch_flag, "--"):
                        dispatch_separator_seen <- true
                        dispatch_index <- dispatch_index + 1
                        continue
                    if dispatch_separator_seen:
                        dispatch_index <- dispatch_index + 1
                        continue
                    if Platform::c_string_equal(dispatch_flag, "--profile"):
                        options.profile <- dispatch_slots[dispatch_index + 1].cast[cstr]
                        dispatch_index <- dispatch_index + 2
                        continue
                    if Platform::c_string_equal(dispatch_flag, "--bin") or Platform::c_string_equal(dispatch_flag, "--lib") or Platform::c_string_equal(dispatch_flag, "--test"):
                        options.target_name <- dispatch_slots[dispatch_index + 1].cast[cstr]
                        options.target_kind <- "bin" if Platform::c_string_equal(dispatch_flag, "--bin")
                        options.target_kind <- "lib" if Platform::c_string_equal(dispatch_flag, "--lib")
                        options.target_kind <- "test" if Platform::c_string_equal(dispatch_flag, "--test")
                        dispatch_index <- dispatch_index + 2
                        continue
                dispatch_index <- dispatch_index + 1
            if Platform::c_string_equal(command, "run") and Platform::c_string_length(options.target_kind) == 0.usize():
                options.target_kind <- "bin"
            if Platform::c_string_equal(command, "test") and Platform::c_string_length(options.target_kind) == 0.usize():
                options.target_kind <- "test"

    private:
        def valid_color_mode(value: cstr) -> bool:
            return Platform::c_string_equal(value, "auto") or Platform::c_string_equal(value, "always") or Platform::c_string_equal(value, "never")
