# Fetch registry releases or verify their authenticated offline cache.
include "../archive.elisa"
include "./status.elisa"
include "../cache.elisa"
include "../cache/registry.elisa"
include "../integrity.elisa"
include "../json.elisa"
include "../package/model.elisa"
include "../package/package_identity.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../project/lock_resolution.elisa"
include "../project/lock_validation.elisa"
include "../project/lockfile.elisa"
include "../project/manifest.elisa"
include "../project/schema_fields.elisa"
include "../project/transaction.elisa"
include "../registry.elisa"
include "../resolution/dependency_graph.elisa"
include "../resolution/registry_roots.elisa"
include "../resolution/semver.elisa"
include "../resolution/solver.elisa"
include "../text/bytes.elisa"
include "./output.elisa"
include "./project_context.elisa"

module FetchCommand:
    public:
        def run(argc: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                positional_count: mutable i64 = 0
                package: mutable darray[u8] = []
                requirement: mutable darray[u8] = []
                index: mutable i64 = 2
                while index < argc:
                    argument: cstr = slots[index].cast[cstr]
                    if Platform::pkg_cstr_equal(argument, "--"):
                        index <- index + 1
                        return CliStatus::usage if index < argc
                        break
                    if Platform::pkg_strlen(argument) == 0.usize():
                        CliOutput::write_error("error: fetch does not accept empty arguments\n")
                        return CliStatus::usage
                    if argument[0].u8() == 45:
                        CliOutput::write_error("error: fetch does not accept command-specific options\n")
                        return CliStatus::usage
                    if positional_count == 0:
                        ByteText::append_bounded_text(&package, argument)
                    elif positional_count == 1:
                        ByteText::append_bounded_text(&requirement, argument)
                    else:
                        CliOutput::write_error("error: fetch accepts at most PACKAGE REQUIREMENT\n")
                        return CliStatus::usage
                    positional_count <- positional_count + 1
                    index <- index + 1
                if positional_count > 0:
                    return CliStatus::usage if positional_count != 2
                    if not PackageIdentity::valid_name(package):
                        CliOutput::write_error("error: fetch requires a valid package name\n")
                        return CliStatus::usage
                    exact_version: mutable Model::Version = Model::Version{major: 0,minor: 0,patch: 0,prerelease: false}
                    if not SemVer::parse(requirement, &exact_version) or exact_version.prerelease:
                        CliOutput::write_error("error: named fetch requires an exact stable version such as 1.2.3\n")
                        return CliStatus::usage
                    if options.offline or options.frozen:
                        CliOutput::write_error("error: offline fetch requires an existing lockfile; package-specific registry fetch is unavailable\n")
                        return CliStatus::resolution_failed
                    if options.locked:
                        CliOutput::write_error("error: fetch --locked takes its package selections from elisapkg.lock; omit PACKAGE VERSION\n")
                        return CliStatus::resolution_failed
                    selected: mutable darray[u8] = []
                    archive: mutable darray[u8] = []
                    digest: mutable darray[u8] = []
                    metadata: mutable darray[u8] = []
                    archive_size: mutable u64 = 0
                    previous_version: Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                    selected_index_generation: mutable u64 = 0
                    selected_index_digest: mutable darray[u8] = []
                    selected_index_identity: mutable darray[u8] = []
                    registry_status: Registry::ResultCode = Registry::resolve_with_index_evidence(package, requirement, previous_version, &selected, &archive, &digest, &archive_size, &metadata, &selected_index_generation, &selected_index_digest, &selected_index_identity)
                    if registry_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(registry_status))
                        CliOutput::write_error("\n")
                        return CliStatus::security_failed if Registry::is_security_failure(registry_status)
                        return CliStatus::resolution_failed
                    metadata_digest_bytes: mutable darray[u8] = []
                    metadata_digest: mutable darray[u8] = []
                    metadata_expires: mutable u64 = 0
                    return CliStatus::security_failed if Integrity::sha256(metadata, &metadata_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(metadata_digest_bytes, &metadata_digest) or not Json::object_unsigned_value(metadata, 0, Json::object_end(metadata, 0), "expires", &metadata_expires)
                    metadata_signature: mutable darray[u8] = []
                    signature_status: Registry::ResultCode = Registry::read_signature(package, selected, &metadata_signature)
                    return CliStatus::security_failed if signature_status != Registry::ResultCode.Ok
                    snapshot_archive: mutable darray[u8] = []
                    snapshot_digest: mutable darray[u8] = []
                    snapshot_size: mutable u64 = 0
                    snapshot_expires: mutable u64 = 0
                    snapshot_dependencies: mutable darray[Solver::Constraint] = []
                    snapshot_status: Registry::ResultCode = Registry::verify_metadata_snapshot(package, selected, metadata_digest, metadata, metadata_signature, &snapshot_archive, &snapshot_digest, &snapshot_size, &snapshot_expires, &snapshot_dependencies)
                    return CliStatus::security_failed if snapshot_status != Registry::ResultCode.Ok or snapshot_expires != metadata_expires or not ByteText::equal(snapshot_archive, archive) or not ByteText::equal(snapshot_digest, digest) or snapshot_size != archive_size
                    archive_bytes: mutable darray[u8] = []
                    archive_status: Registry::ResultCode = Registry::read_archive(package, selected, metadata, archive, digest, archive_size, &archive_bytes)
                    if archive_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(archive_status))
                        CliOutput::write_error("\n")
                        return CliStatus::security_failed if Registry::is_security_failure(archive_status)
                        return CliStatus::source_failed
                    trust_status: Registry::ResultCode = Registry::record_trusted_at_index(package, selected, digest, metadata_digest, snapshot_expires, selected_index_generation, selected_index_digest, selected_index_identity)
                    if trust_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(trust_status))
                        CliOutput::write_error(" while recording ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return CliStatus::security_failed
                    return CliStatus::security_failed if not RegistryCache::store_metadata(metadata_digest, metadata, metadata_signature)
                    return CliStatus::source_failed if not RegistryCache::store_archive(digest, archive_bytes)
                    return CliStatus::security_failed if not RegistryCache::store_receipt(package, selected, archive, archive_size, digest, metadata_digest, metadata_expires)
                    CliOutput::write_ok("verified registry artifact ")
                    CliOutput::write_bytes(1, &package)
                    CliOutput::write_ok(" ")
                    CliOutput::write_bytes(1, &selected)
                    CliOutput::write_ok(" sha256:")
                    CliOutput::write_bytes(1, &digest)
                    CliOutput::write_ok(" (cached)\n")
                    return CliStatus::success
                return CliStatus::security_failed if not ProjectTransaction::recover()
                if not ProjectContext::manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return CliStatus::usage
                raw: mutable darray[u8] = []
                raw <- raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::usage if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return CliStatus::resolution_failed if not ProjectManifest::validate_at(raw, start, &name, &version)
                lock: mutable darray[u8] = []
                lock <- lock.resize(ProjectFiles::project_document_limit)
                return CliStatus::resolution_failed if not ProjectFiles::read_cstr_into("elisapkg.lock", &lock)
                if not LockValidation::matches_manifest(raw, lock, name, version, start):
                    CliOutput::write_error("error: elisapkg.lock is invalid or does not match the current project\n")
                    return CliStatus::resolution_failed
                if Lockfile::version_is(lock, Lockfile::registry_version):
                    return fetch_registry_lock_offline(raw, lock) if options.offline or options.frozen else fetch_registry_lock(raw, lock, name, version, start)
                CliOutput::write_ok("verified local locked sources\n")
                return CliStatus::success

    private:
        def report_cached_release_error(message: cstr, package: darray[u8]&, version: darray[u8]&) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error(message)
                CliOutput::write_bytes(2, package)
                CliOutput::write_error(" ")
                CliOutput::write_bytes(2, version)
                CliOutput::write_error("\n")

        def registry_offline_graph_closure(manifest: darray[u8]&, lock: darray[u8]&, starts: darray[usize]&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            roots: mutable darray[Solver::Constraint] = []
            has_local: mutable bool = false
            return CliStatus::resolution_failed if not RegistryRoots::collect(manifest, &roots, &has_local) or has_local or roots.count == 0.usize()
            queue_positions: mutable darray[usize] = []
            queue_positions <- queue_positions.resize(starts.count)
            for index in 0..<starts.count |queue_positions, starts|:
                queue_positions[index] <- starts.count
            pending: mutable darray[usize] = []
            for index in 0..<roots.count |lock, starts, roots, queue_positions, pending|:
                matched_record: i64 = Lockfile::matching_registry_record(lock, starts, roots[index])
                return CliStatus::security_failed if matched_record < 0
                record_index: usize = matched_record.usize()
                if queue_positions[record_index] == starts.count:
                    queue_positions[record_index] <- pending.count
                    pending <- pending.push(record_index)
            edges: mutable darray[usize] = []
            edge_offsets: mutable darray[usize] = [0.usize()]
            processed: mutable usize = 0.usize()
            while processed < pending.count:
                record_start: usize = starts[pending[processed]]
                record_end: usize = Json::object_end(lock, record_start)
                package: mutable darray[u8] = []
                version_text: mutable darray[u8] = []
                return CliStatus::security_failed if not Json::object_string_value(lock, record_start, record_end, "name", &package) or not Json::object_string_value(lock, record_start, record_end, "version", &version_text)
                source_start: mutable usize = 0.usize()
                source_end: mutable usize = 0.usize()
                return CliStatus::security_failed if not Json::object_value_span(lock, record_start, record_end, "source", &source_start, &source_end)
                archive: mutable darray[u8] = []
                digest: mutable darray[u8] = []
                metadata_digest: mutable darray[u8] = []
                return CliStatus::resolution_failed if:
                    not Json::object_string_value(lock, source_start, source_end, "archive", &archive)
                    not Lockfile::read_sha256_field(lock, record_start, record_end, "archive-digest", &digest)
                    not Lockfile::read_sha256_field(lock, record_start, record_end, "metadata-digest", &metadata_digest)
                archive_size: mutable u64 = 0
                return CliStatus::security_failed if not Json::object_unsigned_value(lock, record_start, record_end, "archive-size", &archive_size)
                cached_metadata: mutable darray[u8] = []
                cached_signature: mutable darray[u8] = []
                if not RegistryCache::read_metadata(metadata_digest, &cached_metadata, &cached_signature):
                    can Global.Read:
                        report_cached_release_error("error: could not read cached signed metadata for ", package, version_text)
                    return CliStatus::security_failed
                resolved_archive: mutable darray[u8] = []
                resolved_digest: mutable darray[u8] = []
                resolved_size: mutable u64 = 0
                expires: mutable u64 = 0
                dependencies: mutable darray[Solver::Constraint] = []
                status: Registry::ResultCode = Registry::verify_metadata_snapshot(package, version_text, metadata_digest, cached_metadata, cached_signature, &resolved_archive, &resolved_digest, &resolved_size, &expires, &dependencies)
                return CliStatus::security_failed if:
                    status != Registry::ResultCode.Ok or not ByteText::equal(resolved_archive, archive) or not ByteText::equal(resolved_digest, digest) or resolved_size != archive_size
                    dependencies.count > Solver::maximum_constraints - edges.count
                for dependency_index in 0..<dependencies.count |lock, starts, dependencies, queue_positions, pending, edges|:
                    matched_record: i64 = Lockfile::matching_registry_record(lock, starts, dependencies[dependency_index])
                    return CliStatus::security_failed if matched_record < 0
                    record_index: usize = matched_record.usize()
                    if queue_positions[record_index] == starts.count:
                        queue_positions[record_index] <- pending.count
                        pending <- pending.push(record_index)
                    edges <- edges.push(queue_positions[record_index])
                edge_offsets <- edge_offsets.push(edges.count)
                processed <- processed + 1.usize()
            # Only distinct authenticated records enter the queue.
            return CliStatus::resolution_failed if starts.count != pending.count
            if not DependencyGraph::is_acyclic(pending.count, edges, edge_offsets):
                can Global.Read:
                    CliOutput::write_error("error: cached registry dependency graph contains a cycle\n")
                return CliStatus::security_failed
            return CliStatus::success

        def fetch_registry_lock_offline(manifest: darray[u8]&, lock: darray[u8]&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                packages_start: usize = Json::root_value_offset(lock, "packages")
                packages_end: usize = Json::array_end(lock, packages_start)
                return CliStatus::resolution_failed if packages_start >= lock.count or packages_end <= packages_start
                starts: mutable darray[usize] = []
                return CliStatus::resolution_failed if not Lockfile::registry_record_starts(lock, packages_start, packages_end, &starts)
                closure_status: i64 = registry_offline_graph_closure(manifest, lock, starts)
                if closure_status != CliStatus::success:
                    CliOutput::write_error("error: offline registry lock does not match its signed dependency graph\n") if closure_status == CliStatus::resolution_failed
                    return closure_status
                now: i64 = Platform::pkg_wall_clock_seconds()
                return CliStatus::security_failed if now < 0
                for record_index in 0..<starts.count |starts, lock|:
                    cursor: usize = starts[record_index]
                    record_end: usize = Json::object_end(lock, cursor)
                    return CliStatus::resolution_failed if record_end <= cursor or record_end >= packages_end or not SchemaFields::valid(lock, cursor, record_end, SchemaFields::Kind.RegistryLockRecord)
                    package: mutable darray[u8] = []
                    version_text: mutable darray[u8] = []
                    return CliStatus::resolution_failed if not Json::object_string_value(lock, cursor, record_end, "name", &package) or not Json::object_string_value(lock, cursor, record_end, "version", &version_text) or not PackageIdentity::valid_name(package)
                    parsed_version: mutable Model::Version = Model::Version{major: 0,minor: 0,patch: 0,prerelease:false}
                    return CliStatus::resolution_failed if not SemVer::parse(version_text, &parsed_version) or parsed_version.prerelease
                    source_start: mutable usize = 0.usize()
                    source_end: mutable usize = 0.usize()
                    return CliStatus::resolution_failed if not Json::object_value_span(lock, cursor, record_end, "source", &source_start, &source_end) or not SchemaFields::valid(lock, source_start, source_end, SchemaFields::Kind.RegistryLockSource)
                    source_type: mutable darray[u8] = []
                    registry: mutable darray[u8] = []
                    archive: mutable darray[u8] = []
                    return CliStatus::resolution_failed if not Json::object_string_value(lock, source_start, source_end, "type", &source_type) or not ByteText::equal_text(source_type, "registry") or not Json::object_string_value(lock, source_start, source_end, "registry", &registry) or not ByteText::equal_text(registry, "primary") or not Json::object_string_value(lock, source_start, source_end, "archive", &archive) or not Archive::is_safe_entry(archive)
                    digest: mutable darray[u8] = []
                    metadata_digest: mutable darray[u8] = []
                    return CliStatus::resolution_failed if:
                        not Lockfile::read_sha256_field(lock, cursor, record_end, "archive-digest", &digest)
                        not Lockfile::read_sha256_field(lock, cursor, record_end, "metadata-digest", &metadata_digest)
                    archive_size: mutable u64 = 0
                    return CliStatus::resolution_failed if not Json::object_unsigned_value(lock, cursor, record_end, "archive-size", &archive_size) or archive_size > Archive::max_archive_bytes.u64()
                    receipt: mutable darray[u8] = []
                    return CliStatus::security_failed if not Cache::read_registry_receipt(digest, metadata_digest, &receipt)
                    expires: mutable u64 = 0
                    return CliStatus::security_failed if:
                        not Cache::registry_receipt_matches(receipt, package, version_text, archive, archive_size, digest, metadata_digest, &expires)
                        expires <= now.u64()
                    cached_metadata: mutable darray[u8] = []
                    cached_signature: mutable darray[u8] = []
                    if not RegistryCache::read_metadata(metadata_digest, &cached_metadata, &cached_signature):
                        report_cached_release_error("error: could not read cached signed metadata for ", package, version_text)
                        return CliStatus::security_failed
                    resolved_archive: mutable darray[u8] = []
                    resolved_digest: mutable darray[u8] = []
                    resolved_size: mutable u64 = 0
                    metadata_expires: mutable u64 = 0
                    metadata_dependencies: mutable darray[Solver::Constraint] = []
                    metadata_status: Registry::ResultCode = Registry::verify_metadata_snapshot(package, version_text, metadata_digest, cached_metadata, cached_signature, &resolved_archive, &resolved_digest, &resolved_size, &metadata_expires, &metadata_dependencies)
                    return CliStatus::security_failed if metadata_status != Registry::ResultCode.Ok or not ByteText::equal(resolved_archive, archive) or not ByteText::equal(resolved_digest, digest) or resolved_size != archive_size or metadata_expires != expires
                    # The digest binds this snapshot to the same dependency
                    # bytes already checked during graph traversal.
                    archive_bytes: mutable darray[u8] = []
                    archive_verified: bool = Cache::read_verified_blob(digest, archive_size.usize(), &archive_bytes) and archive_bytes.count.u64() == archive_size and Registry::release_archive_matches_metadata(package, version_text, cached_metadata, archive_bytes)
                    if not archive_verified:
                        report_cached_release_error("error: could not verify cached archive for ", package, version_text)
                        return CliStatus::security_failed
                    # Only authenticated cache content may advance the durable
                    # trust clock. Do this after snapshot, dependency, expiry, and
                    # archive validation so rejected cache data cannot update it.
                    trust_status: Registry::ResultCode = Registry::verify_trusted(package, version_text, digest, metadata_digest, metadata_expires)
                    if trust_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(trust_status))
                        CliOutput::write_error(" while using cached ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return CliStatus::security_failed
                    CliOutput::write_ok("verified cached registry artifact ")
                    CliOutput::write_bytes(1, &package)
                    CliOutput::write_ok(" ")
                    CliOutput::write_bytes(1, &version_text)
                    CliOutput::write_ok(" sha256:")
                    CliOutput::write_bytes(1, &digest)
                    CliOutput::write_ok(" (offline)\n")
                return CliStatus::success

        def fetch_registry_lock(manifest: darray[u8]&, lock: darray[u8]&, root_name: darray[u8]&, root_version: darray[u8]&, start: darray[u8]&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                # A lockfile is a graph contract, not merely a list of independently
                # authenticated archives. Recompute the canonical graph from the signed
                # registry metadata and compare bytes before any cache mutation. This
                # rejects duplicate, omitted, reordered, or otherwise hand-edited records
                # that could make fetch operate on a graph different from resolution.
                expected_lock: darray[u8] = LockResolution::replay_registry(root_name, root_version, manifest, start, lock)
                return CliStatus::security_failed if expected_lock.count == 0.usize()
                return CliStatus::resolution_failed if not ByteText::equal(expected_lock, lock)
                packages_start: usize = Json::root_value_offset(lock, "packages")
                packages_end: usize = Json::array_end(lock, packages_start)
                return CliStatus::resolution_failed if packages_start >= lock.count or packages_end <= packages_start
                cursor: mutable usize = packages_start + 1.usize()
                fetched: mutable usize = 0.usize()
                while cursor < packages_end:
                    while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                        cursor <- cursor + 1.usize()
                    break if cursor == packages_end
                    return CliStatus::resolution_failed if lock[cursor] != 123
                    record_end: usize = Json::object_end(lock, cursor)
                    return CliStatus::resolution_failed if:
                        record_end <= cursor or record_end >= packages_end
                        not SchemaFields::valid(lock, cursor, record_end, SchemaFields::Kind.RegistryLockRecord)
                    package: mutable darray[u8] = []
                    version_text: mutable darray[u8] = []
                    return CliStatus::resolution_failed if not Json::object_string_value(lock, cursor, record_end, "name", &package) or not Json::object_string_value(lock, cursor, record_end, "version", &version_text) or not PackageIdentity::valid_name(package)
                    parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                    return CliStatus::resolution_failed if not SemVer::parse(version_text, &parsed_version) or parsed_version.prerelease
                    source_start: mutable usize = 0.usize()
                    source_end: mutable usize = 0.usize()
                    return CliStatus::resolution_failed if:
                        not Json::object_value_span(lock, cursor, record_end, "source", &source_start, &source_end)
                        not SchemaFields::valid(lock, source_start, source_end, SchemaFields::Kind.RegistryLockSource)
                    source_type: mutable darray[u8] = []
                    registry: mutable darray[u8] = []
                    archive: mutable darray[u8] = []
                    return CliStatus::resolution_failed if not Json::object_string_value(lock, source_start, source_end, "type", &source_type) or not ByteText::equal_text(source_type, "registry") or not Json::object_string_value(lock, source_start, source_end, "registry", &registry) or not ByteText::equal_text(registry, "primary") or not Json::object_string_value(lock, source_start, source_end, "archive", &archive) or not Archive::is_safe_entry(archive)
                    digest: mutable darray[u8] = []
                    metadata_digest: mutable darray[u8] = []
                    return CliStatus::resolution_failed if:
                        not Lockfile::read_sha256_field(lock, cursor, record_end, "archive-digest", &digest)
                        not Lockfile::read_sha256_field(lock, cursor, record_end, "metadata-digest", &metadata_digest)
                    archive_size: mutable u64 = 0
                    return CliStatus::resolution_failed if not Json::object_unsigned_value(lock, cursor, record_end, "archive-size", &archive_size)
                    exact: mutable darray[u8] = []
                    Registry::exact_requirement(parsed_version, &exact)
                    selected: mutable darray[u8] = []
                    resolved_archive: mutable darray[u8] = []
                    resolved_digest: mutable darray[u8] = []
                    metadata: mutable darray[u8] = []
                    resolved_size: mutable u64 = 0
                    selected_index_generation: mutable u64 = 0
                    selected_index_digest: mutable darray[u8] = []
                    selected_index_identity: mutable darray[u8] = []
                    registry_status: Registry::ResultCode = Registry::resolve_with_index_evidence(package, exact, Model::Version{major:0,minor:0,patch:0,prerelease:false}, &selected, &resolved_archive, &resolved_digest, &resolved_size, &metadata, &selected_index_generation, &selected_index_digest, &selected_index_identity)
                    if registry_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(registry_status))
                        CliOutput::write_error(" while verifying locked ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return CliStatus::security_failed if Registry::is_security_failure(registry_status)
                        return CliStatus::source_failed
                    if not ByteText::equal(selected, version_text):
                        CliOutput::write_error("error: locked registry version does not match signed metadata\n")
                        return CliStatus::security_failed
                    if not ByteText::equal(resolved_archive, archive):
                        CliOutput::write_error("error: locked registry archive name does not match signed metadata\n")
                        return CliStatus::security_failed
                    if not ByteText::equal(resolved_digest, digest):
                        CliOutput::write_error("error: locked registry archive digest does not match signed metadata\n")
                        return CliStatus::security_failed
                    if resolved_size != archive_size:
                        CliOutput::write_error("error: locked registry archive size does not match signed metadata\n")
                        return CliStatus::security_failed
                    metadata_digest_bytes: mutable darray[u8] = []
                    computed_metadata_digest: mutable darray[u8] = []
                    if Integrity::sha256(metadata, &metadata_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(metadata_digest_bytes, &computed_metadata_digest) or not ByteText::equal(computed_metadata_digest, metadata_digest):
                        CliOutput::write_error("error: locked metadata digest does not match signed metadata\n")
                        return CliStatus::security_failed
                    metadata_expires: mutable u64 = 0
                    return CliStatus::security_failed if not Json::object_unsigned_value(metadata, 0, Json::object_end(metadata, 0), "expires", &metadata_expires)
                    metadata_signature: mutable darray[u8] = []
                    signature_status: Registry::ResultCode = Registry::read_signature(package, selected, &metadata_signature)
                    return CliStatus::security_failed if signature_status != Registry::ResultCode.Ok
                    snapshot_archive: mutable darray[u8] = []
                    snapshot_digest: mutable darray[u8] = []
                    snapshot_size: mutable u64 = 0
                    snapshot_expires: mutable u64 = 0
                    snapshot_dependencies: mutable darray[Solver::Constraint] = []
                    snapshot_status: Registry::ResultCode = Registry::verify_metadata_snapshot(package, selected, metadata_digest, metadata, metadata_signature, &snapshot_archive, &snapshot_digest, &snapshot_size, &snapshot_expires, &snapshot_dependencies)
                    return CliStatus::security_failed if:
                        snapshot_status != Registry::ResultCode.Ok
                        snapshot_expires != metadata_expires
                        not ByteText::equal(snapshot_archive, archive)
                        not ByteText::equal(snapshot_digest, digest)
                        snapshot_size != archive_size
                    archive_bytes: mutable darray[u8] = []
                    archive_status: Registry::ResultCode = Registry::read_archive(package, version_text, metadata, archive, digest, archive_size, &archive_bytes)
                    if archive_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(archive_status))
                        CliOutput::write_error(" for locked ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return CliStatus::security_failed if Registry::is_security_failure(archive_status)
                        return CliStatus::source_failed
                    trust_status: Registry::ResultCode = Registry::record_trusted_at_index(package, version_text, digest, metadata_digest, snapshot_expires, selected_index_generation, selected_index_digest, selected_index_identity)
                    if trust_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(trust_status))
                        CliOutput::write_error(" while recording locked ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return CliStatus::security_failed
                    return CliStatus::security_failed if not RegistryCache::store_metadata(metadata_digest, metadata, metadata_signature)
                    return CliStatus::source_failed if not RegistryCache::store_archive(digest, archive_bytes)
                    return CliStatus::security_failed if not RegistryCache::store_receipt(package, version_text, archive, archive_size, digest, metadata_digest, metadata_expires)
                    CliOutput::write_ok("verified locked registry artifact ")
                    CliOutput::write_bytes(1, &package)
                    CliOutput::write_ok(" ")
                    CliOutput::write_bytes(1, &version_text)
                    CliOutput::write_ok(" sha256:")
                    CliOutput::write_bytes(1, &digest)
                    CliOutput::write_ok(" (cached)\n")
                    fetched <- fetched + 1.usize()
                    return CliStatus::resolution_failed if fetched > 4096.usize()
                    cursor <- record_end + 1.usize()
                    while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                        cursor <- cursor + 1.usize()
                    if cursor < packages_end:
                        return CliStatus::resolution_failed if lock[cursor] != 44
                        cursor <- cursor + 1.usize()
                return CliStatus::success
