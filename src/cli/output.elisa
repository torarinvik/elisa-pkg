# Command output policy and help text.
include "../project/files.elisa"
include "../text/bytes.elisa"

module CliOutput:
    private:
        global mutable suppress_stdout: bool = false

    public:
        def configure(quiet: bool, json: bool) -> void can[Global.Write]:
            can Global.Write:
                suppress_stdout <- quiet and not json

        def write_bytes(file_descriptor: i64, value: darray[u8]&) -> void can[Global.Read, Console.Write, Unsafe.PointerCast]:
            can Global.Read:
                return if file_descriptor == 1 and suppress_stdout
                _ = ProjectFiles::write_file_descriptor_all(file_descriptor, value)

        def write_text(file_descriptor: i64, value: cstr) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                return if file_descriptor == 1 and suppress_stdout
                buffer: mutable darray[u8] = []
                ByteText::append_text(&buffer, value)
                write_bytes(file_descriptor, &buffer)

        def write_error(value: cstr) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                write_text(2, value)

        def write_ok(value: cstr) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                write_text(1, value)

        def usage() -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                write_ok("elisapkg — Elisa Packaging System\n\nUsage: elisapkg <command> [options]\n\nCommands:\n  init [PATH] [--bin|--lib]    create a package\n  check-manifest              validate elisapkg.json\n  add NAME --path PATH        add a verified local path dependency\n  add NAME --version RANGE --registry primary\n                              add a signed registry dependency\n  remove NAME                 remove a declared dependency\n  update [NAME]               recompute the dependency lock\n  resolve [--locked|--offline]\n                              validate and write elisapkg.lock\n  tree                        show the resolved package graph\n  metadata --json             print normalized package metadata\n  doctor                      report toolchain and trust capabilities\n  build [--bin NAME|--lib NAME|--test NAME]\n                              compile a selected target\n                              --profile debug|release\n  run [--bin NAME] [--profile debug|release] -- ARGS\n                              build and run a binary target\n  test [--test NAME]          build and run a selected test target\n  clean                       remove known local build/package outputs\n  fetch [--locked|--offline]  verify sources selected by elisapkg.lock\n  fetch PACKAGE VERSION       verify a signed local registry release at an exact stable version\n  cache verify                inspect cached verification records\n  cache gc --dry-run          preview unreachable cache entries\n  package [--list]            create or preview the deterministic archive\n  install --local [--bin NAME] install the selected binary target into the user prefix\n  uninstall --local NAME      remove a receipt-owned local binary\n\nModes: --locked  --offline  --frozen  --json  --verbose  --quiet  --color auto|always|never\n")
                write_ok("  why NAME                    show the root edge for a locked package\n")
                write_ok("  publish --dry-run           validate a release without writing or uploading\n")
                write_ok("remote publish/install/uninstall are trust-gated; use install --local for a receipt-backed local binary\n")

        def forward_descriptor(file_descriptor: i64, target: i64) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global.Read:
                return false if Platform::seek_file_descriptor(file_descriptor, 0, 0) < 0
                total: mutable i64 = 0
                region buffer_scope:
                    buffer: mutable darray[u8] = []
                    buffer <- buffer.resize(8192)
                    while total < 134217728 |total, buffer, file_descriptor, target|:
                        raw: mutable u8& = (&buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
                        capacity: mutable usize = 8192.usize()
                        if 134217728 - total < capacity.i64():
                            capacity <- (134217728 - total).usize()
                        amount: i64 = Platform::read_file_descriptor(file_descriptor, raw, capacity)
                        return false if amount < 0 or amount > capacity.i64()
                        break if amount == 0
                        buffer <- buffer.resize(amount.usize())
                        write_bytes(target, &buffer)
                        total <- total + amount
                        buffer <- buffer.resize(8192)
                return true
