# Resolve, edit, and present project dependency locks.
include "../package/manifest.elisa"
include "./status.elisa"
include "../package/manifest_edits.elisa"
include "../package/model.elisa"
include "../package/package_identity.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../project/lock_resolution.elisa"
include "../project/lock_validation.elisa"
include "../project/lockfile.elisa"
include "../project/manifest.elisa"
include "../project/transaction.elisa"
include "../registry.elisa"
include "../resolution/registry_roots.elisa"
include "../resolution/semver.elisa"
include "../resolution/solver.elisa"
include "../text/bytes.elisa"
include "./output.elisa"
include "./project_context.elisa"

module ResolutionCommand:
    public:
        # Run `add NAME --path PATH` or `add NAME --version REQUIREMENT --registry primary`.
        def add(argument_count: i64, slots: cstr&&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                local_form: bool = argument_count == 5 and Platform::c_string_equal(slots[3].cast[cstr], "--path")
                registry_form: bool = argument_count == 7 and Platform::c_string_equal(slots[3].cast[cstr], "--version") and Platform::c_string_equal(slots[5].cast[cstr], "--registry") and Platform::c_string_equal(slots[6].cast[cstr], "primary")
                CliStatus::usage if not local_form and not registry_form else add_dependency(slots[2].cast[cstr], slots[4].cast[cstr], local_form)

        def why(argument_count: i64, slots: cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                return CliStatus::usage if argument_count < 3
                wanted: mutable darray[u8] = []
                ByteText::append_bounded_text(&wanted, slots[2].cast[cstr])
                CliStatus::usage if not PackageIdentity::valid_name(wanted) else explain_dependency(start, options, wanted)

        def resolve(start: darray[u8]&, options: Model::CommandOptions, transaction_owned: bool, emit_result: bool) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if not ProjectContext::manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return CliStatus::usage
                manifest: mutable ManifestDocument = empty_manifest_document()
                # Read up to the manifest policy limit. A smaller buffer would silently
                # validate only a prefix of an attacker-controlled document.
                CliStatus::usage if not ProjectFiles::read_project_document("elisapkg.json", &manifest.raw) or not ProjectManifest::validate(manifest.raw, &manifest.name, &manifest.version) else resolve_manifest(start, ResolveRun{options: options, transaction_owned: transaction_owned, emit_result: emit_result}, manifest)

        def tree(start: darray[u8]&, options: Model::CommandOptions) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if not ProjectContext::manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return CliStatus::resolution_failed
                manifest: mutable ManifestDocument = empty_manifest_document()
                lock: mutable darray[u8] = []
                CliStatus::resolution_failed if not ProjectFiles::read_project_document("elisapkg.json", &manifest.raw) or not ProjectManifest::validate(manifest.raw, &manifest.name, &manifest.version) or not ProjectFiles::c_string_file_exists("elisapkg.lock") or not ProjectFiles::read_project_document("elisapkg.lock", &lock) or not LockValidation::matches_manifest(manifest.raw, lock, manifest.name, manifest.version, start) else print_lock(lock, options.json)

        # Run `remove NAME`.
        def remove(argument_count: i64, slots: cstr&&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return CliStatus::usage if argument_count != 3
                alias: mutable darray[u8] = []
                ByteText::append_bounded_text(&alias, slots[2].cast[cstr])
                CliStatus::usage if not PackageIdentity::valid_name(alias) or not ProjectContext::manifest_exists() else CliStatus::security_failed if not ProjectTransaction::recover() else finish_removal(alias)

        # Run `update [NAME]`.
        def update(argument_count: i64, slots: cstr&&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return CliStatus::usage if argument_count > 3
                update_name: cstr = slots[2].cast[cstr] if argument_count == 3 else ""
                wanted: mutable darray[u8] = []
                ByteText::append_bounded_text(&wanted, update_name)
                CliStatus::usage if (argument_count == 3 and not PackageIdentity::valid_name(wanted)) or not ProjectContext::manifest_exists() else CliStatus::security_failed if not ProjectTransaction::recover() else finish_update(wanted, update_name)

    private:
        # The bytes of a project manifest and the identity it declares.
        struct ManifestDocument:
            raw: mutable darray[u8]
            name: mutable darray[u8]
            version: mutable darray[u8]

        # How one resolution runs and reports.
        struct ResolveRun:
            options: Model::CommandOptions
            transaction_owned: bool
            emit_result: bool

        # The aliased dependency an `add` command declares: a local path or a
        # registry requirement.
        struct DependencyEdit:
            alias: mutable darray[u8]
            dependency_path: mutable darray[u8]
            requirement: mutable darray[u8]

        def empty_manifest_document() -> ManifestDocument:
            ManifestDocument{raw: [], name: [], version: []}

        # Read and validate the project manifest at `root`.
        def read_root_manifest(root: mutable darray[u8]&, raw: mutable darray[u8]&, root_name: mutable darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                raw.resize(ProjectFiles::project_document_limit)
                root_version: mutable darray[u8] = []
                ProjectFiles::read_c_string_into("elisapkg.json", raw) and ProjectManifest::validate_at(raw, root, root_name, &root_version)

        # Read the manifest at `start` and its lockfile, and check that the
        # lock still matches the manifest.
        def read_locked_project(start: darray[u8]&, raw: mutable darray[u8]&, lock: mutable darray[u8]&, root_name: mutable darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                raw.resize(ProjectFiles::project_document_limit)
                lock.resize(ProjectFiles::project_document_limit)
                root_version: mutable darray[u8] = []
                ProjectFiles::read_c_string_into("elisapkg.json", raw) and ProjectManifest::validate_at(raw, start, root_name, &root_version) and ProjectFiles::c_string_file_exists("elisapkg.lock") and ProjectFiles::read_c_string_into("elisapkg.lock", lock) and LockValidation::matches_manifest(raw, lock, root_name, root_version, start)

        def edit_options() -> Model::CommandOptions:
            Model::CommandOptions{locked: false, offline: false, frozen: false, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}

        # Restore the manifest and lockfile after a failed edit. Returns the
        # failure, or a security failure when the restore itself fails.
        # A step that failed before beginning its transaction has nothing to restore.
        def restore_after_failure(failure: i64, message: cstr) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return failure if not ProjectTransaction::active() or ProjectTransaction::restore()
                CliOutput::write_error(message)
                CliStatus::security_failed

        # Commit a successful edit, or restore the project after a failed one.
        def committed_edit(resolved: i64, failure_message: cstr) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                restore_after_failure(resolved, failure_message) if resolved != CliStatus::success else CliStatus::security_failed if not ProjectTransaction::commit() else CliStatus::success

        # Begin a transaction over `raw` and publish the edited manifest
        # `updated`. An empty `updated` means the edit was rejected.
        def publish_manifest_edit(raw: darray[u8]&, updated: darray[u8]&, rejected_message: cstr) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if updated.count == 0.usize():
                    CliOutput::write_error(rejected_message)
                    return CliStatus::resolution_failed
                return CliStatus::security_failed if not ProjectTransaction::begin(raw)
                return CliStatus::success if ProjectTransaction::publish_manifest(updated)
                _ = ProjectTransaction::restore()
                CliStatus::source_failed

        # Publish the edited manifest, then resolve the project at `root`
        # inside the transaction the publication began.
        def publish_and_resolve(root: darray[u8]&, raw: darray[u8]&, updated: darray[u8]&, rejected_message: cstr) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                publish_status: i64 = publish_manifest_edit(raw, updated, rejected_message)
                publish_status if publish_status != CliStatus::success else resolve(root, edit_options(), true, false)

        # ---------- add -----------------------------------------------------------------------

        def add_dependency(alias_text: cstr, value_text: cstr, local_form: bool) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                edit: mutable DependencyEdit = DependencyEdit{alias: [], dependency_path: [], requirement: []}
                status: i64 = read_dependency_edit(alias_text, value_text, local_form, &edit)
                status if status != CliStatus::success else CliStatus::usage if not ProjectContext::manifest_exists() else CliStatus::security_failed if not ProjectTransaction::recover() else finish_addition(edit, local_form)

        # Read and validate the alias and the local path or registry requirement.
        def read_dependency_edit(alias_text: cstr, value_text: cstr, local_form: bool, edit: mutable DependencyEdit&) -> CliStatus::ExitStatus can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            ByteText::append_bounded_text(&edit.alias, alias_text)
            return CliStatus::usage if not PackageIdentity::valid_name(edit.alias)
            if local_form:
                ByteText::append_bounded_text(&edit.dependency_path, value_text)
                return CliStatus::success if Manifest::valid_dependency_path(edit.dependency_path) else CliStatus::usage
            ByteText::append_bounded_text(&edit.requirement, value_text)
            CliStatus::success if requirement_valid(edit.requirement) else CliStatus::usage

        def requirement_valid(requirement: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            parsed_requirement: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
            SemVer::parse_requirement(requirement, &parsed_requirement)

        def finish_addition(edit: DependencyEdit&, local_form: bool) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                status: i64 = committed_edit(resolve_addition(edit, local_form), "error: dependency edit failed and the original manifest could not be restored\n")
                status if status != CliStatus::success else report_added(local_form, edit.alias, edit.dependency_path, edit.requirement)

        # Check the new dependency against the root manifest, publish the
        # edited manifest, and resolve.
        def resolve_addition(edit: DependencyEdit&, local_form: bool) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                root: mutable darray[u8] = [46]
                raw: mutable darray[u8] = []
                root_name: mutable darray[u8] = []
                CliStatus::usage if not read_root_manifest(&root, &raw, &root_name) else CliStatus::resolution_failed if not addition_identity_valid(edit, local_form, root_name) else publish_and_resolve(root, raw, ManifestEdits::append_path(raw, edit.alias, edit.dependency_path) if local_form else ManifestEdits::append_registry(raw, edit.alias, edit.requirement), "error: could not add the dependency; check for a duplicate name or a manifest limit\n")

        # A dependency cannot share the root's name, and a local dependency
        # must declare the name it is added under.
        def addition_identity_valid(edit: DependencyEdit&, local_form: bool, root_name: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            (not local_form or local_dependency_matches(edit)) and not ByteText::equal(edit.alias, root_name)

        def local_dependency_matches(edit: DependencyEdit&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            dependency_name: mutable darray[u8] = []
            dependency_version: mutable darray[u8] = []
            ProjectManifest::load_at(edit.dependency_path, &dependency_name, &dependency_version) and ByteText::equal(edit.alias, dependency_name)

        # Print what `add` changed. Returns success for the command to exit with.
        def report_added(local_form: bool, alias: darray[u8]&, dependency_path: darray[u8]&, requirement: darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok("added ")
                CliOutput::write_ok("local " if local_form else "registry ")
                CliOutput::write_ok("dependency ")
                CliOutput::write_bytes(1, alias)
                if local_form:
                    CliOutput::write_ok(" from ")
                    CliOutput::write_bytes(1, dependency_path)
                else:
                    CliOutput::write_ok(" with requirement ")
                    CliOutput::write_bytes(1, requirement)
                CliOutput::write_ok("\n")
                CliStatus::success

        # ---------- why -----------------------------------------------------------------------

        # `why` reports the root edge. A lockfile also contains transitive
        # records, so merely finding a name in the lock is insufficient and
        # would misreport `root -> transitive` as a direct dependency.
        def explain_dependency(start: darray[u8]&, options: Model::CommandOptions, wanted: darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                raw: mutable darray[u8] = []
                lock: mutable darray[u8] = []
                root_name: mutable darray[u8] = []
                CliStatus::resolution_failed if not read_locked_project(start, &raw, &lock, &root_name) or ByteText::equal(wanted, root_name) or not declares_dependency(raw, wanted) or not Lockfile::contains_package(lock, wanted) else report_root_edge(root_name, wanted, options.json)

        def declares_dependency(raw: darray[u8]&, wanted: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            dependency_start: mutable usize = 0.usize()
            dependency_end: mutable usize = 0.usize()
            Manifest::find_dependency_span(raw, wanted, &dependency_start, &dependency_end)

        def report_root_edge(root_name: darray[u8]&, wanted: darray[u8]&, json: bool) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if json:
                    CliOutput::write_ok("{\"schema-version\":1,\"root\":\"")
                    CliOutput::write_bytes(1, root_name)
                    CliOutput::write_ok("\",\"package\":\"")
                    CliOutput::write_bytes(1, wanted)
                    CliOutput::write_ok("\"}\n")
                    return CliStatus::success
                CliOutput::write_bytes(1, root_name)
                CliOutput::write_ok(" -> ")
                CliOutput::write_bytes(1, wanted)
                CliOutput::write_ok("\n")
                CliStatus::success

        # ---------- resolve -------------------------------------------------------------------

        # Keep output identity in owned copies. The resolver walks and
        # normalizes graph records; the copies keep that traversal from
        # emptying the manifest fields before the success envelope is emitted.
        def resolve_manifest(start: darray[u8]&, run: ResolveRun, manifest: ManifestDocument&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                reported: ManifestDocument = ManifestDocument{raw: [], name: manifest.name.clone(), version: manifest.version.clone()}
                lock_state: i64 = Platform::package_file_size("elisapkg.lock")
                preferred_lock: mutable darray[u8] = []
                status: i64 = read_preferred_lock(lock_state, &preferred_lock)
                status if status != CliStatus::success else resolve_against_lock(start, run, manifest, reported, lock_state, preferred_lock)

        # Read the existing lock when there is one. An existing lock that
        # cannot be opened is not equivalent to an absent lock. Refusing to
        # replace it preserves the operator's ability to investigate
        # permissions, corruption, or a hostile filesystem.
        def read_preferred_lock(lock_state: i64, out: mutable darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                (CliStatus::success if ProjectFiles::read_project_document("elisapkg.lock", out) else CliStatus::resolution_failed) if lock_state >= 0 else CliStatus::success if lock_state == -2 else report_unreadable_lock()

        def report_unreadable_lock() -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error("error: existing elisapkg.lock is unreadable; refusing to replace it\n")
                CliStatus::resolution_failed

        def resolve_against_lock(start: darray[u8]&, run: ResolveRun, manifest: ManifestDocument&, reported: ManifestDocument&, lock_state: i64, preferred_lock: darray[u8]&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                mode: i64 = lock_replay_mode(manifest.raw, run.options)
                CliStatus::resolution_failed if mode == replay_unavailable else replay_lock(start, run, manifest, reported, lock_state, preferred_lock) if mode == replay_existing else resolve_new_lock(start, run, manifest, reported, lock_state, preferred_lock)

        const replay_unavailable: i64 = -1
        const resolve_fresh: i64 = 0
        const replay_existing: i64 = 1

        # Locked and frozen modes validate an existing lock without consulting
        # a registry provider. Offline mode may replay an existing lock but
        # never consults a provider or refreshes signed metadata, so a registry
        # graph without a lock is unavailable offline; local graphs resolve
        # normally and use the same canonical byte comparison.
        # Returns `replay_unavailable` when the manifest's registry roots
        # cannot be read.
        def lock_replay_mode(raw: darray[u8]&, options: Model::CommandOptions) -> i64 can[Memory.Allocate, Abort.Panic]:
            replay_existing if options.locked or options.frozen else resolve_fresh if not options.offline else offline_replay_mode(raw)

        def offline_replay_mode(raw: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            registry_roots: mutable darray[Solver::Constraint] = []
            has_local_dependency: mutable bool = false
            (replay_existing if registry_roots.count > 0.usize() else resolve_fresh) if RegistryRoots::collect(raw, &registry_roots, &has_local_dependency) else replay_unavailable

        def replay_lock(start: darray[u8]&, run: ResolveRun, manifest: ManifestDocument&, reported: ManifestDocument&, lock_state: i64, preferred_lock: darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliStatus::resolution_failed if lock_state == -2 or not LockValidation::matches_manifest(manifest.raw, preferred_lock, manifest.name, manifest.version, start) else report_resolved(reported, run)

        def resolve_new_lock(start: darray[u8]&, run: ResolveRun, manifest: ManifestDocument&, reported: ManifestDocument&, lock_state: i64, preferred_lock: darray[u8]&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                lock: darray[u8] = LockResolution::canonical_with_options(manifest.name, manifest.version, manifest.raw, start, run.options, preferred_lock)
                report_resolution_failure(lock) if lock.count > 0.usize() and lock[0] > 0 and lock[0] < 32 else CliStatus::resolution_failed if lock.count == 0.usize() else publish_and_report(lock, manifest.raw, lock_state, preferred_lock, run, reported)

        def publish_and_report(lock: darray[u8]&, raw: darray[u8]&, lock_state: i64, preferred_lock: darray[u8]&, run: ResolveRun, reported: ManifestDocument&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                publication_status: i64 = publish_resolved_lock(lock, raw, lock_state, preferred_lock, run.transaction_owned)
                publication_status if publication_status != CliStatus::success else report_resolved(reported, run)

        def report_resolved(reported: ManifestDocument&, run: ResolveRun) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                write_resolved_text(reported.name, reported.version, run.options) if run.emit_result
                CliStatus::success

        # Claim the project transaction unless the caller owns it, publish the
        # lock, and commit. A failed publication restores the project.
        def publish_resolved_lock(lock: darray[u8]&, raw: darray[u8]&, lock_state: i64, preferred_lock: darray[u8]&, transaction_owned: bool) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if not transaction_owned and not ProjectTransaction::begin_with_lock(raw, lock_state, preferred_lock):
                    CliOutput::write_error("error: could not claim the package transaction; another edit may be active or the manifest or lockfile may have changed\n")
                    return CliStatus::security_failed
                publication: ProjectTransaction::LockPublication =
                    owned_lock: mutable darray[u8] = lock.clone()
                    ProjectTransaction::publish_lock(&owned_lock)
                finish_lock_publication(publication, transaction_owned)

        def finish_lock_publication(publication: ProjectTransaction::LockPublication, transaction_owned: bool) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                abandon_lock_publication(publication, transaction_owned) if publication != ProjectTransaction::LockPublication.Published else CliStatus::security_failed if not transaction_owned and not ProjectTransaction::commit() else CliStatus::success

        def abandon_lock_publication(publication: ProjectTransaction::LockPublication, transaction_owned: bool) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if not transaction_owned:
                    _ = ProjectTransaction::restore()
                CliStatus::resolution_failed if publication == ProjectTransaction::LockPublication.WriteFailed else CliStatus::security_failed

        # The resolver reports a registry failure as a one-byte lock holding
        # the result code plus one, so an empty lock stays reserved for an
        # ordinary resolution failure.
        def report_resolution_failure(lock: darray[u8]&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                code: Registry::ResultCode = decoded_result_code(lock[0] - 1.u8())
                CliOutput::write_error("error: ")
                CliOutput::write_error(Registry::result_message(code))
                if code == Registry::ResultCode.Unsatisfiable:
                    write_registry_conflict(lock)
                    CliOutput::write_error("\n")
                    return CliStatus::resolution_failed
                if code == Registry::ResultCode.TrustStateUnavailable or code == Registry::ResultCode.TrustStateMalformed or code == Registry::ResultCode.ClockRollback:
                    CliOutput::write_error(" while recording registry trust state\n")
                else:
                    CliOutput::write_error("\n")
                CliStatus::security_failed if Registry::is_security_failure(code) else CliStatus::resolution_failed

        # Unknown codes decode as a malformed trust state.
        def decoded_result_code(encoded: u8) -> Registry::ResultCode:
            codes: darray[Registry::ResultCode] = [
                Registry::ResultCode.NotConfigured, Registry::ResultCode.InvalidConfiguration, Registry::ResultCode.MissingIndex,
                Registry::ResultCode.NoMatchingVersion, Registry::ResultCode.MalformedMetadata, Registry::ResultCode.MissingSignature,
                Registry::ResultCode.MissingTrustRoot, Registry::ResultCode.InvalidSignature, Registry::ResultCode.ExpiredMetadata,
                Registry::ResultCode.RollbackDetected, Registry::ResultCode.DigestMismatch, Registry::ResultCode.ArchiveMissing,
                Registry::ResultCode.ResourceLimit, Registry::ResultCode.TrustStateUnavailable, Registry::ResultCode.TrustStateMalformed,
                Registry::ResultCode.ClockRollback, Registry::ResultCode.Unsatisfiable, Registry::ResultCode.ClockUnavailable,
                Registry::ResultCode.ExpiryHorizon, Registry::ResultCode.TrustRootChanged, Registry::ResultCode.TufEquivocationDetected]
            index: usize = while index < codes.count and codes[index].u8() != encoded |index: usize = 0.usize()| -> index:
                index <- index + 1.usize()
            codes[index] if index < codes.count else Registry::ResultCode.TrustStateMalformed

        def write_resolved_text(name: darray[u8]&, version: darray[u8]&, options: Model::CommandOptions) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if options.json:
                    CliOutput::write_ok("{\"schema-version\":1,\"resolved\":true,\"package\":{\"name\":\"")
                    CliOutput::write_bytes(1, name)
                    CliOutput::write_ok("\",\"version\":\"")
                    CliOutput::write_bytes(1, version)
                    CliOutput::write_ok("\"}}\n")
                    return
                CliOutput::write_ok("resolved ")
                CliOutput::write_bytes(1, name)
                CliOutput::write_ok(" ")
                CliOutput::write_bytes(1, version)
                CliOutput::write_ok("\n")

        # ---------- tree ----------------------------------------------------------------------

        def print_lock(lock: darray[u8]&, json: bool) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                (CliStatus::success if print_lock_packages_json(lock) else CliStatus::resolution_failed) if json else CliStatus::success if print_lock_packages(lock) else CliStatus::resolution_failed

        def print_lock_packages(raw: darray[u8]&) -> bool can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic]:
            can Global.Read:
                found: mutable usize = 0.usize()
                for index in 0..<raw.count |raw, found|:
                    continue if raw[index] != 123
                    object_end: usize = Json::object_end(raw, index)
                    continue if object_end <= index
                    package_name: mutable darray[u8] = []
                    package_version: mutable darray[u8] = []
                    if Json::object_string_value(raw, index, object_end, "name", &package_name) and Json::object_string_value(raw, index, object_end, "version", &package_version):
                        CliOutput::write_bytes(1, &package_name)
                        CliOutput::write_ok(" ")
                        CliOutput::write_bytes(1, &package_version)
                        CliOutput::write_ok("\n")
                        found <- found + 1.usize()
                found > 0.usize()

        def print_lock_packages_json(raw: darray[u8]&) -> bool can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic]:
            can Global.Read:
                CliOutput::write_ok("{\"schema-version\":1,\"packages\":[")
                write_lock_package_objects(raw) > 0.usize() and write_closing_brackets()

        # Write each locked package as a JSON object. Returns how many were written.
        def write_lock_package_objects(raw: darray[u8]&) -> usize can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic]:
            can Global.Read:
                found: mutable usize = 0.usize()
                for index in 0..<raw.count |raw, found|:
                    continue if raw[index] != 123
                    object_end: usize = Json::object_end(raw, index)
                    continue if object_end <= index
                    package_name: mutable darray[u8] = []
                    package_version: mutable darray[u8] = []
                    if Json::object_string_value(raw, index, object_end, "name", &package_name) and Json::object_string_value(raw, index, object_end, "version", &package_version):
                        CliOutput::write_ok(",") if found > 0.usize()
                        CliOutput::write_ok("{\"name\":\"")
                        CliOutput::write_bytes(1, &package_name)
                        CliOutput::write_ok("\",\"version\":\"")
                        CliOutput::write_bytes(1, &package_version)
                        CliOutput::write_ok("\"}")
                        found <- found + 1.usize()
                found

        def write_closing_brackets() -> bool can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic]:
            can Global.Read:
                CliOutput::write_ok("]}\n")
                true

        # ---------- remove and update ---------------------------------------------------------

        def finish_removal(alias: darray[u8]&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                status: i64 = committed_edit(resolve_removal(alias), "error: dependency removal failed and the original manifest could not be restored\n")
                status if status != CliStatus::success else report_removed(alias)

        def resolve_removal(alias: darray[u8]&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                root: mutable darray[u8] = [46]
                raw: mutable darray[u8] = []
                root_name: mutable darray[u8] = []
                CliStatus::usage if not read_root_manifest(&root, &raw, &root_name) else publish_and_resolve(root, raw, ManifestEdits::remove(raw, alias), "error: dependency is not declared; no manifest or lockfile mutation was performed\n")

        def report_removed(alias: darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok("removed dependency ")
                CliOutput::write_bytes(1, alias)
                CliOutput::write_ok("\n")
                CliStatus::success

        # Resolve with an update, require a named package to stay locked,
        # and commit.
        def finish_update(wanted: darray[u8]&, update_name: cstr) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                resolved: i64 = resolve_update(wanted, update_name)
                restore_after_failure(resolved, "error: update failed and the original manifest or lockfile could not be restored\n") if resolved != CliStatus::success else abandon_update() if wanted.count > 0.usize() and not lock_contains(wanted) else CliStatus::security_failed if not ProjectTransaction::commit() else report_updated()

        def resolve_update(wanted: darray[u8]&, update_name: cstr) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                root: mutable darray[u8] = [46]
                raw: mutable darray[u8] = []
                root_name: mutable darray[u8] = []
                CliStatus::usage if not read_root_manifest(&root, &raw, &root_name) or (wanted.count > 0.usize() and ByteText::equal(wanted, root_name)) else CliStatus::security_failed if not ProjectTransaction::begin(raw) else resolve(root, update_options(update_name, wanted.count > 0.usize()), true, false)

        # Edit options that update only `update_name` when `named`.
        def update_options(update_name: cstr, named: bool) -> Model::CommandOptions:
            options: mutable Model::CommandOptions = edit_options()
            options.update_name <- update_name if named
            options

        def lock_contains(wanted: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            lock: mutable darray[u8] = []
            ProjectFiles::read_project_document("elisapkg.lock", &lock) and Lockfile::contains_package(lock, wanted)

        def abandon_update() -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                _ = ProjectTransaction::restore()
                CliStatus::resolution_failed

        def report_updated() -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok("updated dependency lock\n")
                CliStatus::success

        # ---------- registry conflicts --------------------------------------------------------

        def registry_conflict_field(raw: darray[u8]&, wanted: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            # Fields follow the status byte, each ended by a null byte.
            while true |raw, out, cursor: usize = 1.usize(), current: usize = 0.usize()|:
                return false if cursor >= raw.count
                finish: usize = while finish < raw.count and raw[finish] != 0 |finish: usize = cursor| -> finish:
                    finish <- finish + 1.usize()
                return false if finish == raw.count
                if current == wanted:
                    ByteText::append_range(out, raw, cursor, finish)
                    return true
                current <- current + 1.usize()
                cursor <- finish + 1.usize()

        def write_registry_conflict(raw: darray[u8]&) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                package: mutable darray[u8] = []
                first_requirement: mutable darray[u8] = []
                second_requirement: mutable darray[u8] = []
                if registry_conflict_fields(raw, &package, &first_requirement, &second_requirement):
                    write_conflict(package, first_requirement, second_requirement)

        # Read the three non-empty conflict fields.
        def registry_conflict_fields(raw: darray[u8]&, package: mutable darray[u8]&, first_requirement: mutable darray[u8]&, second_requirement: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            registry_conflict_field(raw, 0, package) and registry_conflict_field(raw, 1, first_requirement) and registry_conflict_field(raw, 2, second_requirement) and package.count > 0.usize() and first_requirement.count > 0.usize() and second_requirement.count > 0.usize()

        def write_conflict(package: darray[u8]&, first_requirement: darray[u8]&, second_requirement: darray[u8]&) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error(" (package ")
                CliOutput::write_bytes(2, package)
                CliOutput::write_error("; requirements ")
                CliOutput::write_bytes(2, first_requirement)
                CliOutput::write_error(" and ")
                CliOutput::write_bytes(2, second_requirement)
                CliOutput::write_error(")")
