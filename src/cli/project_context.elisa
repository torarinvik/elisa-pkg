# Project discovery and working directory selection.
include "../platform.elisa"
include "../project/files.elisa"
include "../project/manifest.elisa"
include "../text/bytes.elisa"

module ProjectContext:
    public:
        def manifest_exists() -> bool:
            current: bool = ProjectFiles::c_string_file_exists("elisapkg.json")
            legacy: bool = ProjectFiles::c_string_file_exists("manifest.json")
            # Two manifests would create an ambiguous authority boundary. Refuse both
            # rather than silently preferring one based on filename order.
            current and not legacy

        def change_to_manifest_path(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not ProjectFiles::valid_path_bytes(path)
            path_c: darray[u8] = ProjectFiles::with_null_terminator(path)
            selected_path: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            # The offset of the last `/`, or `path.count` when there is none.
            last_separator: usize = for index in 0..<path.count |last: usize = path.count| -> last:
                last <- index if path[index] == 47
            if Platform::change_directory(selected_path) == 0:
                true
            else:
                # A file-form manifest path is accepted only when its basename is the
                # package manifest. Otherwise a typo such as `--manifest-path settings.json`
                # would silently switch to a different `elisapkg.json` in the same parent.
                manifest_leaf: darray[u8] =
                    leaf_start: usize = 0.usize() if last_separator == path.count else last_separator + 1.usize()
                    [path[index] for index in leaf_start..<path.count]
                if not ByteText::equal_text(manifest_leaf, "elisapkg.json") or not ProjectFiles::c_string_file_exists(selected_path):
                    false
                else:
                    parent: darray[u8] =
                        if last_separator == path.count:
                            [46]
                        elif last_separator == 0.usize():
                            [47]
                        else:
                            [path[index] for index in 0..<last_separator]
                    change_directory(parent)

        def load_package(start: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            _ = start
            return false if not manifest_exists()
            raw: mutable darray[u8] = []
            raw <- raw.resize(ProjectFiles::project_document_limit)
            name: mutable darray[u8] = []
            version: mutable darray[u8] = []
            ProjectFiles::read_c_string_into("elisapkg.json", &raw) and raw.count > 0.usize() and ProjectManifest::validate(raw, &name, &version)

    private:
        def change_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not ProjectFiles::valid_path_bytes(path)
            path_c: darray[u8] = ProjectFiles::with_null_terminator(path)
            Platform::change_directory((&path_c[0]).cast[cstr] can Unsafe.PointerCast) == 0
