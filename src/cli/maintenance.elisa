# Clean build outputs and verify package cache contents.
include "../archive.elisa"
include "./status.elisa"
include "../build.elisa"
include "../cache.elisa"
include "../integrity.elisa"
include "../package/receipt.elisa"
include "../package/targets.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../project/lock_validation.elisa"
include "../project/manifest.elisa"
include "../text/bytes.elisa"
include "./output.elisa"

module MaintenanceCommand:
    public:
        def clean() -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                root: mutable darray[u8] = [46]
                state: mutable darray[u8] = []
                build_directory: mutable darray[u8] = []
                release_build_directory: mutable darray[u8] = []
                artifact: mutable darray[u8] = []
                library_artifact: mutable darray[u8] = []
                receipt: mutable darray[u8] = []
                package_archive: mutable darray[u8] = []
                package_receipt: mutable darray[u8] = []
                ProjectFiles::path_join_into(root, ".elisapkg", &state)
                return CliStatus::build_failed if not ProjectFiles::make_directory(&state)
                build_directory <- Build::output_directory(root, false)
                release_build_directory <- Build::output_directory(root, true)
                ProjectFiles::path_join_into(build_directory, "app", &artifact)
                ProjectFiles::path_join_into(build_directory, "app.o", &library_artifact)
                ProjectFiles::path_join_into(build_directory, "receipt", &receipt)
                ProjectFiles::path_join_into(state, "package.tar", &package_archive)
                ProjectFiles::path_join_into(state, "package.receipt", &package_receipt)
                region manifest_raw_scope:
                    manifest_raw: mutable darray[u8] = []
                    manifest_raw <- manifest_raw.resize(ProjectFiles::project_document_limit)
                    if ProjectFiles::read_c_string_into("elisapkg.json", &manifest_raw):
                        output_leaves: mutable darray[darray[u8]] = []
                        return CliStatus::build_failed if:
                            not ManifestTargets::cleanup_output_leaves(manifest_raw, &output_leaves)
                            not remove_target_outputs(output_leaves, build_directory)
                            not remove_target_outputs(output_leaves, release_build_directory)
                # Remove legacy single-target names left by older receipts as well as the
                # manifest-declared target outputs.
                return CliStatus::build_failed if:
                    not ProjectFiles::remove_known_file(&artifact)
                    not ProjectFiles::remove_known_file(&library_artifact)
                    not ProjectFiles::remove_known_file(&receipt)
                    not ProjectFiles::remove_known_file(&package_archive)
                    not ProjectFiles::remove_known_file(&package_receipt)
                    not remove_build_directory_if_empty(&release_build_directory)
                    not remove_build_directory_if_empty(&build_directory)
                # `.elisapkg` is removed only when it is empty; cache/state files are never
                # traversed or recursively deleted by clean. A retained cache makes this
                # directory intentionally non-empty, which is a successful clean result.
                return CliStatus::build_failed if not remove_state_directory(&state)
                CliOutput::write_ok("cleaned known .elisapkg outputs\n")
                return CliStatus::success

        def verify_cache(start: darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                raw: mutable darray[u8] = []
                raw <- raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::usage if not ProjectFiles::read_c_string_into("elisapkg.json", &raw)
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return CliStatus::security_failed if not ProjectManifest::validate_at(raw, start, &name, &version)
                lock: mutable darray[u8] = []
                lock <- lock.resize(ProjectFiles::project_document_limit)
                return CliStatus::security_failed if:
                    not ProjectFiles::read_c_string_into("elisapkg.lock", &lock)
                    not LockValidation::matches_manifest(raw, lock, name, version, start)
                archive_state: i64 = Platform::package_file_size(".elisapkg/package.tar")
                receipt_state: i64 = Platform::package_file_size(".elisapkg/package.receipt")
                return CliStatus::security_failed if:
                    archive_state < 0 and archive_state != -2
                    receipt_state < 0 and receipt_state != -2
                archive_present: bool = archive_state >= 0
                receipt_present: bool = receipt_state >= 0
                return CliStatus::security_failed if archive_present != receipt_present
                archive_bytes: mutable darray[u8] = []
                receipt: mutable darray[u8] = []
                region archive_digest_scope:
                    archive_digest: mutable darray[u8] = []
                    return CliStatus::security_failed if archive_present and not verify_package_archive(raw, lock, name, version, &archive_bytes, &receipt, &archive_digest)
                    return CliStatus::security_failed if not inputs_unchanged(raw, lock, archive_present, receipt_present, &archive_bytes, archive_digest, receipt)
                CliOutput::write_ok("cache: local lock and manifest digests verified\n")
                if archive_present:
                    CliOutput::write_ok("cache: deterministic package archive and receipt verified\n")
                CliOutput::write_ok("cache: no shared remote cache configured\n")
                return CliStatus::success

        # Verify the packaged archive and check that its receipt binds this
        # manifest, lock, and archive digest.
        def verify_package_archive(raw: darray[u8]&, lock: darray[u8]&, name: darray[u8]&, version: darray[u8]&, archive_bytes: mutable darray[u8]&, receipt: mutable darray[u8]&, archive_digest: mutable darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                manifest_digest: mutable darray[u8] = []
                lock_digest: mutable darray[u8] = []
                return false if:
                    not Integrity::sha256_hex(raw, &manifest_digest)
                    not Integrity::sha256_hex(lock, &lock_digest)
                region archive_path_scope:
                    archive_path: mutable darray[u8] = []
                    ByteText::append_text(&archive_path, ".elisapkg/package.tar")
                    return false if:
                        not read_package_file(&archive_path, archive_bytes)
                        not Archive::verify_ustar_archive(archive_bytes)
                        not Integrity::sha256_hex(archive_bytes, archive_digest)
                receipt.resize(PackageReceipt::maximum_encode + 1.usize())
                return false if not ProjectFiles::read_c_string_into(".elisapkg/package.receipt", receipt)
                region expected_receipt_scope:
                    expected_receipt: darray[u8] = PackageReceipt::encode(name, version, manifest_digest, lock_digest, archive_digest)
                    return false if not ByteText::equal(receipt, expected_receipt)
                return true

        # Re-read every input after verification so a concurrent edit cannot
        # pass. The archive re-read reuses the first bounded buffer rather
        # than retaining a second full-size archive copy.
        def inputs_unchanged(raw: darray[u8]&, lock: darray[u8]&, archive_present: bool, receipt_present: bool, archive_bytes: mutable darray[u8]&, archive_digest: darray[u8]&, receipt: darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                manifest_after: mutable darray[u8] = []
                manifest_after <- manifest_after.resize(ProjectFiles::project_document_limit)
                region lock_after_scope:
                    lock_after: mutable darray[u8] = []
                    lock_after <- lock_after.resize(ProjectFiles::project_document_limit)
                    return false if:
                        not ProjectFiles::read_c_string_into("elisapkg.json", &manifest_after) or not ProjectFiles::read_c_string_into("elisapkg.lock", &lock_after)
                        not ByteText::equal(manifest_after, raw) or not ByteText::equal(lock_after, lock)
                archive_state_after: i64 = Platform::package_file_size(".elisapkg/package.tar")
                region receipt_state_after_scope:
                    receipt_state_after: i64 = Platform::package_file_size(".elisapkg/package.receipt")
                    return false if:
                        archive_state_after < 0 and archive_state_after != -2
                        receipt_state_after < 0 and receipt_state_after != -2
                        archive_present != (archive_state_after >= 0) or receipt_present != (receipt_state_after >= 0)
                if archive_present:
                    archive_path_after: mutable darray[u8] = []
                    ByteText::append_text(&archive_path_after, ".elisapkg/package.tar")
                    # Reuse the first bounded buffer: verify the bytes still at the
                    # pathname without retaining a second full-size archive copy.
                    archive_after_digest: mutable darray[u8] = []
                    receipt_after: mutable darray[u8] = []
                    receipt_after <- receipt_after.resize(PackageReceipt::maximum_encode + 1.usize())
                    return false if:
                        not read_package_file(&archive_path_after, archive_bytes) or not ProjectFiles::read_c_string_into(".elisapkg/package.receipt", &receipt_after)
                        not Integrity::sha256_hex(archive_bytes, &archive_after_digest)
                        not ByteText::equal(archive_after_digest, archive_digest) or not ByteText::equal(receipt_after, receipt)
                        not Cache::verify_blob(archive_digest)
                return true

        def run_cache(argument_count: i64, slots: mutable cstr&&, start: darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                return verify_cache(start) if argument_count == 3 and Platform::c_string_equal(slots[2].cast[cstr], "verify")
                if argument_count == 4 and Platform::c_string_equal(slots[2].cast[cstr], "gc") and Platform::c_string_equal(slots[3].cast[cstr], "--dry-run"):
                    CliOutput::write_ok("cache: no shared cache configured; nothing would be collected\n")
                    return CliStatus::success
                if argument_count == 3 and Platform::c_string_equal(slots[2].cast[cstr], "gc"):
                    CliOutput::write_error("error: cache garbage collection is disabled until a verified cache store is configured; use `cache gc --dry-run`\n")
                    return CliStatus::operation_failed
                return CliStatus::usage

    private:
        def remove_build_directory_if_empty(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            path_c <- ProjectFiles::with_null_terminator(path)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            region result_scope:
                result: i64 = Platform::remove_directory(path_name)
                # Keep compiler metadata and any unrecognized build files. Clean
                # owns only the artifacts named by the manifest and their receipts.
                return true if result == 0 or result == -2 or result == -Platform::directory_not_empty_error()
            return false

        def remove_state_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            path_c <- ProjectFiles::with_null_terminator(path)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            region result_scope:
                result: i64 = Platform::remove_directory(path_name)
                # A retained cache makes the state directory intentionally non-empty.
                return true if result == 0 or result == -2 or result == -Platform::directory_not_empty_error()
            return false

        def remove_target_outputs(leaves: darray[darray[u8]]&, build_directory: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            for index in 0..<leaves.count |leaves, build_directory|:
                path: mutable darray[u8] = []
                ProjectFiles::path_join_bytes_into(build_directory, leaves[index], &path)
                return false if not ProjectFiles::remove_known_file(path)
            return true

        def read_package_file(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return Platform::read_bounded_file(path, Integrity::maximum_input, out)
