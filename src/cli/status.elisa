# Process exit statuses shared by all CLI commands.

# `self` lies in the closed interval `low..high`.
law InRange(self: i64, low: i64, high: i64) = self >= low and self <= high

module CliStatus:
    public:
        # A process exit status as the operating system reports it.
        type ExitStatus = i64 is InRange[0, 255]

        const success: ExitStatus = 0
        const usage: ExitStatus = 2
        const resolution_failed: ExitStatus = 3
        const source_failed: ExitStatus = 4
        const security_failed: ExitStatus = 5
        const build_failed: ExitStatus = 6
        const operation_failed: ExitStatus = 7
        const cancelled: ExitStatus = 130
