# Process exit statuses shared by all CLI commands.
module CliStatus:
    public:
        const success: i64 = 0
        const usage: i64 = 2
        const resolution_failed: i64 = 3
        const source_failed: i64 = 4
        const security_failed: i64 = 5
        const build_failed: i64 = 6
        const operation_failed: i64 = 7
        const cancelled: i64 = 130
