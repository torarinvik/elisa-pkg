# Orchestrate the verified, sandboxed compiler build.
include "../build.elisa"
include "./status.elisa"
include "../integrity.elisa"
include "../package/model.elisa"
include "../package/selection.elisa"
include "../package/targets.elisa"
include "../platform.elisa"
include "../project/build_cache.elisa"
include "../project/build_paths.elisa"
include "../project/build_publication.elisa"
include "../project/build_receipt.elisa"
include "../project/build_toolchain.elisa"
include "../project/files.elisa"
include "../project/local_build_plan.elisa"
include "../project/lock_validation.elisa"
include "../project/manifest.elisa"
include "../resolution/local_build_graph.elisa"
include "../sandbox.elisa"
include "../source/fingerprint.elisa"
include "../source/snapshots.elisa"
include "../text/bytes.elisa"
include "../toolchain.elisa"
include "./build_execution.elisa"
include "./build_inputs.elisa"
include "./build_sources.elisa"
include "./build_target.elisa"
include "./build_toolchain_setup.elisa"
include "./build_workspace.elisa"
include "./compiler_process.elisa"
include "./output.elisa"
include "./project_context.elisa"

module BuildCommand:
    public:
        def run(start: darray[u8]&, options: Model::CommandOptions) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                artifact_digest: mutable darray[u8] = []
                run_with_digest(start, options, &artifact_digest)

        def run_with_digest(start: darray[u8]&, options: Model::CommandOptions, out_artifact_digest: mutable darray[u8]&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                # Allocate the SHA-256 text output before the build scratch region.
                out_artifact_digest.resize(64.usize())
                status: i64 = build_into_digest(start, options, out_artifact_digest)
                if status != CliStatus::success:
                    out_artifact_digest.resize(0.usize())
                status

    private:
        def build_into_digest(start: darray[u8]&, options: Model::CommandOptions, out_artifact_digest: mutable darray[u8]&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if not Sandbox::build_sandbox_available():
                    CliOutput::write_error("error: compiler builds require the macOS Seatbelt sandbox; builds fail closed on this platform\n")
                    return CliStatus::build_failed
                return CliStatus::usage if not Platform::c_string_equal(options.profile, "debug") and not Platform::c_string_equal(options.profile, "release")
                return CliStatus::build_failed if not ProjectContext::load_package(start)
                target: mutable BuildTarget::Selection = BuildTarget::empty()
                inputs: mutable BuildExecution::Inputs = BuildExecution::Inputs{lock: [], lock_digest: [], source_tree_digest: [], source_tree_bytes: 0.usize(), source_digest: [],
                                                dependency_aggregate: [], dependency_aggregate_digest: [], compiler_dependency_aggregate: [],
                                                has_local_build_dependencies: false}
                if CliStatus::failure(read_project(start, options, &target, &inputs)) is failed:
                    return failed
                region build_state(67108864):
                    # Infer both arrays' storage from this enclosing region so the
                    # planner can allocate nested package buffers in the same scope.
                    dependency_packages: mutable darray[LocalBuildGraph::Package] = []
                    dependency_order: mutable darray[usize] = []
                    if inputs.source_tree_bytes > SourceFingerprint::maximum_snapshot_bytes or not LocalBuildPlan::read_ordered_includes(inputs.lock, start, BuildTarget::resolved_entry_name(target), SourceFingerprint::maximum_snapshot_bytes - inputs.source_tree_bytes, &inputs.dependency_aggregate, &inputs.has_local_build_dependencies, dependency_packages, dependency_order):
                        CliOutput::write_error("error: local dependency graph is invalid, unreadable, or exceeds the combined source-size limits; refusing to compile an incomplete graph\n")
                        return CliStatus::build_failed
                    destination: mutable BuildExecution::Destination = BuildExecution::Destination{build_directory: [], artifact_label: [], artifact: [], artifact_c_string: [], receipt_path: []}
                    toolchain: mutable BuildToolchainSetup::Setup = BuildToolchainSetup::empty()
                    access: mutable BuildExecution::SandboxAccess = BuildExecution::SandboxAccess{home_name: "", dependency_roots: []}
                    if CliStatus::failure(prepare_build(start, options, target, &inputs, &destination, &toolchain, &access)) is failed:
                        return failed
                    workspace: mutable BuildWorkspace::Workspace = BuildWorkspace::empty()
                    return CliStatus::build_failed if not BuildSources::prepare_root(destination.build_directory, start, inputs.source_tree_digest, target.entry, &workspace.snapshot_template, &workspace.snapshot_root, &workspace.snapshot_roots, &workspace.snapshot_total_bytes, &workspace.root_snapshot_entry)
                    if not BuildSnapshots::create_dependencies(&dependency_packages, dependency_order, workspace.snapshot_root, &workspace.snapshot_roots, &workspace.snapshot_total_bytes):
                        _ = BuildSnapshots::remove_all(BuildWorkspace::snapshot_container_name(workspace), workspace.snapshot_roots)
                        CliOutput::write_error("error: local dependency changed or could not be copied into the verified build snapshot\n")
                        return CliStatus::build_failed
                    if not BuildSources::target_matches(workspace.root_snapshot_entry, inputs.source_digest):
                        _ = BuildSnapshots::remove_all(BuildWorkspace::snapshot_container_name(workspace), workspace.snapshot_roots)
                        return CliStatus::build_failed
                    if inputs.has_local_build_dependencies and not LocalBuildGraph::write_snapshot_includes(dependency_packages, dependency_order, workspace.root_snapshot_entry, &inputs.compiler_dependency_aggregate):
                        _ = BuildSnapshots::remove_all(BuildWorkspace::snapshot_container_name(workspace), workspace.snapshot_roots)
                        CliOutput::write_error("error: verified dependency aggregate exceeds the configured build limit\n")
                        return CliStatus::build_failed
                    receipt: mutable darray[u8] = build_receipt(target, inputs, toolchain, options)
                    # The lock digest includes every resolved local dependency identity and
                    # source digest. Recompile whenever that graph changes instead of reusing a
                    # root-only artifact.
                    if reuse_cached_artifact(target, destination, toolchain, workspace, receipt, out_artifact_digest) is cached_status:
                        return cached_status
                    if CliStatus::failure(prepare_workspace(inputs, destination, &workspace)) is failed:
                        return failed
                    if CliStatus::failure(BuildExecution::compile(options, target, toolchain, access, start, &workspace)) is failed:
                        return failed
                    return BuildExecution::verify_and_publish(start, target, inputs, destination, toolchain, &workspace, &receipt, out_artifact_digest)

        # Read the manifest, select the target, resolve the lock, and fingerprint the source tree.
        def read_project(start: darray[u8]&, options: Model::CommandOptions, target: mutable BuildTarget::Selection&, inputs: mutable BuildExecution::Inputs&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if CliStatus::failure(BuildTarget::select(start, options, target)) is failed:
                    return failed
                if CliStatus::failure(BuildInputs::resolve_local_lock(start, options, target.manifest, target.root_name, target.root_version, &inputs.lock, &inputs.lock_digest)) is failed:
                    return failed
                CliStatus::build_failed if not BuildInputs::fingerprint_source(&inputs.source_tree_digest, &inputs.source_tree_bytes) else CliStatus::success

        # Fingerprint the dependency graph and target, choose the output paths,
        # resolve the toolchain, and find what the sandbox must be allowed to read.
        def prepare_build(start: darray[u8]&, options: Model::CommandOptions, target: BuildTarget::Selection&, inputs: mutable BuildExecution::Inputs&, destination: mutable BuildExecution::Destination&, toolchain: mutable BuildToolchainSetup::Setup&, access: mutable BuildExecution::SandboxAccess&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if inputs.has_local_build_dependencies:
                    region aggregate_digest_bytes_scope:
                        aggregate_digest_bytes: mutable darray[u8] = []
                        if Integrity::sha256(inputs.dependency_aggregate, &aggregate_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(aggregate_digest_bytes, &inputs.dependency_aggregate_digest):
                            CliOutput::write_error("error: unable to fingerprint the verified dependency aggregate\n")
                            return CliStatus::build_failed
                if PackageSelection::publish_path_forbidden(target.entry):
                    CliOutput::write_error("error: selected target entry is not a safe package source path\n")
                    return CliStatus::build_failed
                return CliStatus::build_failed if not BuildInputs::fingerprint_target(BuildTarget::entry_name(target), &inputs.source_digest)
                destination.build_directory <- Build::output_directory(start, Platform::c_string_equal(options.profile, "release"))
                destination.artifact_label <- ManifestTargets::artifact_leaf(target.name, target.is_library)
                ProjectFiles::path_join_bytes_into(destination.build_directory, destination.artifact_label, &destination.artifact)
                destination.artifact_c_string <- ProjectFiles::with_null_terminator(&destination.artifact)
                region receipt_label_scope:
                    receipt_label: darray[u8] = ManifestTargets::receipt_leaf(target.name)
                    ProjectFiles::path_join_bytes_into(destination.build_directory, receipt_label, &destination.receipt_path)
                return CliStatus::build_failed if not ProjectFiles::make_directory(&destination.build_directory)
                if CliStatus::failure(BuildToolchainSetup::prepare(toolchain)) is failed:
                    return failed
                if Platform::environment_variable("HOME") is configured_home:
                    access.home_name <- configured_home.cast[cstr]
                else:
                    CliOutput::write_error("error: HOME must name an existing directory to construct the build sandbox\n")
                    return CliStatus::build_failed
                CliStatus::build_failed if not BuildPaths::sandbox_dependency_roots(inputs.lock, start, &access.dependency_roots) else CliStatus::success

        def build_receipt(target: BuildTarget::Selection&, inputs: BuildExecution::Inputs&, toolchain: BuildToolchainSetup::Setup&, options: Model::CommandOptions) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            receipt: mutable darray[u8] = []
            region identities_scope:
                identities: BuildToolchainSetup::Identities& = &toolchain.identities
                BuildReceipt::append_target(&receipt, target.entry, target.kind, ManifestTargets::artifact_leaf(target.name, target.is_library), options.profile)
                BuildReceipt::append_input_digests(&receipt, inputs.source_tree_digest, inputs.source_digest, target.manifest_digest, inputs.lock_digest, inputs.has_local_build_dependencies, inputs.dependency_aggregate_digest)
                BuildReceipt::append_toolchain(&receipt, toolchain.compiler, toolchain.compiler_executable, toolchain.environment.stage1_binary, toolchain.environment.runtime_object,
                                              identities.compiler.bytes, identities.stage1.bytes, identities.runtime.bytes, toolchain.clang, identities.clang.bytes)
                BuildReceipt::append_sandbox(&receipt, toolchain.sdk_root, toolchain.developer_directory, identities.developer_linker.bytes,
                                            identities.developer_assembler.bytes, identities.sdk_settings.bytes, toolchain.environment.allow_stale)
            receipt

        # Reuse a published artifact whose receipt matches this build exactly.
        # Returns null when there is no such artifact and it must be rebuilt.
        def reuse_cached_artifact(target: BuildTarget::Selection&, destination: BuildExecution::Destination&, toolchain: BuildToolchainSetup::Setup&, workspace: BuildWorkspace::Workspace&, receipt: darray[u8]&, out_artifact_digest: mutable darray[u8]&) -> i64? can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                cached_digest: mutable darray[u8] = []
                return null if not:
                    BuildToolchainSetup::all_available(&toolchain.identities)
                    BuildCache::verified_digest(destination.artifact, destination.receipt_path, receipt, BuildTarget::artifact_access_mode(target), &cached_digest)
                if not BuildSnapshots::remove_all(BuildWorkspace::snapshot_container_name(workspace), workspace.snapshot_roots):
                    CliOutput::write_error("error: unable to remove the verified build source snapshots\n")
                    return CliStatus::build_failed
                BuildExecution::report_built(destination, " (cached)\n", cached_digest, out_artifact_digest)
                CliStatus::success

        def prepare_workspace(inputs: BuildExecution::Inputs&, destination: BuildExecution::Destination&, workspace: mutable BuildWorkspace::Workspace&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if CliStatus::failure(BuildWorkspace::create_directory(destination.build_directory, workspace)) is failed:
                    return failed
                if inputs.has_local_build_dependencies:
                    if CliStatus::failure(BuildWorkspace::write_aggregate(inputs.compiler_dependency_aggregate, workspace)) is failed:
                        return failed
                BuildWorkspace::create_output_file(destination.artifact_label, workspace)
