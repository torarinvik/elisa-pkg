# `elisapkg install`: install the built binary target locally. Remote
# installation stays behind the trust policy.
include "../../build.elisa"
include "../../install_faults.elisa"
include "../../integrity.elisa"
include "../../package/install_prefix.elisa"
include "../../package/model.elisa"
include "../../package/targets.elisa"
include "../../platform.elisa"
include "../../project/files.elisa"
include "../../project/manifest.elisa"
include "../../resolution/semver.elisa"
include "../../security.elisa"
include "../../text/bytes.elisa"
include "../build_command.elisa"
include "../local_install.elisa"
include "../output.elisa"
include "../resolution.elisa"
include "../status.elisa"

module InstallCommand:
    public:
        # Run `install --local`, or refuse a remote package install.
        def run(argument_count: i64, slots: cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                mode: i64 = install_mode(argument_count, slots)
                CliStatus::usage if mode == usage_mode else install_local(start, options) if mode == local_mode else refuse_remote_install()

    private:
        # Package version identities share the SemVer parser's bounded length.
        # Install metadata then adds only bounded paths, names, and fixed fields.
        const maximum_install_version_bytes: usize = SemVer::maximum_version_bytes

        const usage_mode: i64 = 0
        const local_mode: i64 = 1
        const remote_mode: i64 = 2

        # What a local install publishes: the prefix, the binary target, and
        # the package identity recorded in the receipt.
        struct LocalInstall:
            prefix: mutable darray[u8]
            target_name: mutable darray[u8]
            name: mutable darray[u8]
            version: mutable darray[u8]

        # Classify `install` arguments: `--local` alone, one remote package,
        # or a usage error. `--bin NAME` is consumed and otherwise ignored.
        def install_mode(argument_count: i64, slots: cstr&&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            while true |slots, index: i64 = 2, local_seen: bool = false, package_seen: bool = false|:
                if index >= argument_count:
                    return usage_mode if local_seen == package_seen else local_mode if local_seen else remote_mode
                argument: cstr = slots[index].cast[cstr]
                index <- index + 1
                if Platform::c_string_equal(argument, "--local"):
                    return usage_mode if local_seen
                    local_seen <- true
                elif Platform::c_string_equal(argument, "--bin"):
                    return usage_mode if index >= argument_count
                    # The common option parser has already validated and
                    # stored this target name. Consume its value here so it
                    # cannot be mistaken for a remote package argument.
                    index <- index + 1
                elif not package_seen:
                    package_seen <- true
                else:
                    return usage_mode

        # Report that remote installation is disabled by the trust policy.
        def refuse_remote_install() -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error(Security::install_message())
                Security::install_status()

        def install_local(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                install: mutable LocalInstall = LocalInstall{prefix: [], target_name: [], name: [], version: []}
                status: i64 = prepare_local_install(options, &install)
                status if status != CliStatus::success else install_artifact(start, options, install)

        # Read and check the install prefix, resolve the project, and select
        # the binary target and the package identity.
        def prepare_local_install(options: Model::CommandOptions, install: mutable LocalInstall&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                CliStatus::usage if not InstallPrefix::read_configured(&install.prefix) else report_untrusted_prefix() if not InstallPrefix::trusted_existing_ancestor(install.prefix) else resolve_and_select(options, install)

        def report_untrusted_prefix() -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error("error: install prefix directories must be owned by root or the current user, without group or other write permission\n")
                CliStatus::operation_failed

        def resolve_and_select(options: Model::CommandOptions, install: mutable LocalInstall&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                resolved: i64 =
                    root: darray[u8] = [46]
                    ResolutionCommand::resolve(root, options, false, false)
                resolved if resolved != CliStatus::success else select_and_load(options, install)

        def select_and_load(options: Model::CommandOptions, install: mutable LocalInstall&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                target_status: i64 = select_binary_target(options, &install.target_name)
                target_status if target_status != CliStatus::success else load_identity(install)

        def load_identity(install: mutable LocalInstall&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                root: darray[u8] = [46]
                CliStatus::usage if not ProjectManifest::load_at(root, &install.name, &install.version) else report_version_too_long() if install.version.count > maximum_install_version_bytes else CliStatus::success

        def report_version_too_long() -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error("error: local install package versions exceed the bounded receipt limit\n")
                CliStatus::usage

        # Select the manifest target named by `options`; installation needs a
        # binary target.
        def select_binary_target(options: Model::CommandOptions, target_name: mutable darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                manifest_raw: mutable darray[u8] = []
                target_kind: mutable darray[u8] = []
                target_entry: mutable darray[u8] = []
                CliStatus::build_failed if not ProjectFiles::read_project_document("elisapkg.json", &manifest_raw) or not ManifestTargets::select_target(manifest_raw, options.target_name, options.target_kind, target_name, &target_kind, &target_entry) else CliStatus::success if ByteText::equal_text(target_kind, "bin") else report_not_binary()

        def report_not_binary() -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error("error: install --local requires a binary target\n")
                CliStatus::operation_failed

        # Build the target unless a test prebuilt artifact is in use, then
        # install the artifact.
        def install_artifact(start: darray[u8]&, options: Model::CommandOptions, install: LocalInstall&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                use_prebuilt_artifact: bool = InstallFaults::use_test_prebuilt_artifact()
                expected_build_digest: mutable darray[u8] = []
                CliStatus::build_failed if not use_prebuilt_artifact and BuildCommand::run_with_digest(start, options, &expected_build_digest) != CliStatus::success else install_built(start, options, install, use_prebuilt_artifact, expected_build_digest)

        # Read the built artifact, require it to match the digest the build
        # reported, and publish it.
        def install_built(start: darray[u8]&, options: Model::CommandOptions, install: LocalInstall&, use_prebuilt_artifact: bool, expected_build_digest: darray[u8]&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                artifact: darray[u8] =
                    build_directory: darray[u8] = Build::output_directory(start, Platform::c_string_equal(options.profile, "release"))
                    ProjectFiles::path_join_bytes(build_directory, install.target_name)
                artifact_bytes: mutable darray[u8] = []
                digest: mutable darray[u8] = []
                CliStatus::operation_failed if not read_artifact_with_digest(artifact, &artifact_bytes, &digest) else report_changed_build() if not use_prebuilt_artifact and (expected_build_digest.count != 64.usize() or not ByteText::equal(digest, expected_build_digest)) else LocalInstallCommand::publish_verified(install.prefix, install.name, install.version, artifact_bytes, digest)

        def report_changed_build() -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error("error: build output changed after compilation; refusing to install an unverified artifact\n")
                CliStatus::build_failed

        # Read the built artifact and its hex SHA-256 digest.
        def read_artifact_with_digest(artifact: darray[u8]&, artifact_bytes: mutable darray[u8]&, digest: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not Platform::read_bounded_file(artifact, Integrity::maximum_input, artifact_bytes)
            digest_bytes: mutable darray[u8] = []
            Integrity::sha256(artifact_bytes, &digest_bytes) == Integrity::DigestCode.Ok and Integrity::hex_digest(digest_bytes, digest)
