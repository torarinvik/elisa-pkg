# Resolve and fingerprint the inputs bound to a build receipt.
include "../integrity.elisa"
include "./status.elisa"
include "../json.elisa"
include "../package/model.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../project/lock_validation.elisa"
include "../project/lockfile.elisa"
include "../source/fingerprint.elisa"
include "../text/bytes.elisa"
include "./output.elisa"
include "./resolution.elisa"

module BuildInputs:
    public:
        def resolve_local_lock(start: darray[u8]&, options: Model::CommandOptions, manifest_raw: darray[u8]&, root_name: darray[u8]&, root_version: darray[u8]&, lock_raw: mutable darray[u8]&, lock_digest: mutable darray[u8]&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                lock_raw.resize(0)
                lock_digest.resize(0)
                region lock_status_scope:
                    lock_status: i64 = ResolutionCommand::resolve(start, options, false, false)
                    return lock_status if lock_status != CliStatus::success
                region candidate_lock_scope:
                    candidate_lock: mutable darray[u8] = []
                    candidate_lock <- candidate_lock.resize(Json::maximum_document_bytes + 1.usize())
                    # Resolution reads the manifest again and may replace the lock. Bind
                    # both results to the exact manifest snapshot used above to select the
                    # target and compute its receipt, before trusting registry evidence or
                    # starting the compiler.
                    region manifest_after_resolve_scope:
                        manifest_after_resolve: mutable darray[u8] = []
                        manifest_after_resolve <- manifest_after_resolve.resize(Json::maximum_document_bytes + 1.usize())
                        return CliStatus::build_failed if:
                            not ProjectFiles::read_c_string_into("elisapkg.lock", &candidate_lock)
                            not ProjectFiles::read_c_string_into("elisapkg.json", &manifest_after_resolve)
                            not ByteText::equal(manifest_after_resolve, manifest_raw)
                            not LockValidation::matches_manifest(manifest_raw, candidate_lock, root_name, root_version, start)
                    if Lockfile::version_is(candidate_lock, Lockfile::registry_version):
                        CliOutput::write_error("error: builds with registry dependencies are not supported; local dependency builds require a version 2 local lock\n")
                        return CliStatus::build_failed
                    return CliStatus::build_failed if not Integrity::sha256_hex(candidate_lock, lock_digest)
                    ByteText::append(lock_raw, candidate_lock)
                return CliStatus::success

        def fingerprint_source(source_tree_digest: mutable darray[u8]&, source_tree_bytes: mutable usize&) -> bool can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if not SourceFingerprint::current_bounded(source_tree_digest, SourceFingerprint::maximum_snapshot_bytes, source_tree_bytes):
                    CliOutput::write_error("error: package source tree is unreadable, unsafe, or exceeds the supported source-size limits; refusing to build\n")
                    return false
                return true

        def fingerprint_target(target_entry_raw: cstr, source_digest: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            source_digest.resize(0)
            target_source_size: i64 = Platform::package_file_size(target_entry_raw)
            return false if target_source_size < 0 or target_source_size > Integrity::maximum_input.i64()
            target_source: mutable darray[u8] = []
            # One spare byte distinguishes a file that grew after the size check.
            target_source <- target_source.resize(target_source_size.usize() + 1.usize())
            return false if read_into(target_entry_raw, &target_source) != target_source_size
            target_source <- target_source.resize(target_source_size.usize())
            return Integrity::sha256_hex(target_source, source_digest)

        # Read a package file into `buffer`. Returns the byte count or a negative errno.
        def read_into(path: cstr, buffer: mutable darray[u8]&) -> i64 can[Unsafe.PointerCast]:
            requires buffer.count > 0
            buffer_raw: mutable u8& = (&buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            return Platform::read_package_file(path, buffer_raw, buffer.count)
