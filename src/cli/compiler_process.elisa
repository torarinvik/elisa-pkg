# Launch the sandboxed compiler with only its scratch directory and standard streams.
include "../platform.elisa"
include "../source/snapshots.elisa"
include "../toolchain.elisa"

module CompilerProcess:
    public:
        def spawn(args: darray[cstr]&, callback_parameter: mutable darray[u8]&, callback_digits_offset: usize, sandbox_work_directory_fd: i64, compiler_stdout_fd: i64, compiler_stderr_fd: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            child_argv: mutable cstr&& = (&args[0]).cast[mutable cstr&&] can Unsafe.PointerCast
            pid: i64 = Platform::pkg_fork()
            if pid == 0:
                process_id: i64 = Platform::pkg_process_id()
                if not Toolchain::set_callback_path_pid(callback_parameter, callback_digits_offset, process_id):
                    Platform::pkg_process_exit(126)
                callback_file_name: cstr = (&callback_parameter[14]).cast[cstr] can Unsafe.PointerCast
                if Platform::pkg_create_exclusive_file(callback_file_name) != 0:
                    Platform::pkg_process_exit(126)
                if Platform::pkg_set_process_group() != 0:
                    Platform::pkg_process_exit(126)
                if Platform::pkg_set_process_limits(1) != 0:
                    Platform::pkg_process_exit(126)
                if Platform::pkg_fchdir(sandbox_work_directory_fd) != 0:
                    Platform::pkg_process_exit(126)
                null_fd: i64 = Platform::pkg_open_null()
                if null_fd < 0 or Platform::pkg_dup2(null_fd, 0) != 0 or Platform::pkg_dup2(compiler_stdout_fd, 1) != 1 or Platform::pkg_dup2(compiler_stderr_fd, 2) != 2:
                    Platform::pkg_process_exit(126)
                if null_fd > 2:
                    _ = Platform::pkg_close(null_fd)
                if Platform::pkg_close_inherited_fds() != 0:
                    Platform::pkg_process_exit(126)
                _ = Platform::pkg_execvp("/usr/bin/sandbox-exec", child_argv)
                Platform::pkg_process_exit(127)
            return pid

        # For failed builds whose compiler is no longer running.
        def discard_scratch(sandbox_directory: cstr, output_path: cstr, aggregate_path: cstr, snapshot_container: cstr, snapshot_roots: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if output_path[0].u8() != 0:
                _ = Platform::pkg_unlink(output_path)
            _ = BuildSnapshots::remove_all(snapshot_container, snapshot_roots)
            _ = BuildSnapshots::remove_aggregate(aggregate_path)
            _ = Platform::pkg_rmdir(sandbox_directory)

        def discard_logs(stdout_descriptor: i64, stderr_descriptor: i64, stdout_path: cstr, stderr_path: cstr) -> void:
            _ = Platform::pkg_close(stdout_descriptor)
            _ = Platform::pkg_close(stderr_descriptor)
            _ = Platform::pkg_unlink(stdout_path)
            _ = Platform::pkg_unlink(stderr_path)
