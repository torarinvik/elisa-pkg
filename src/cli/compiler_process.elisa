# Launch the sandboxed compiler with only its scratch directory and standard streams.
include "../platform.elisa"
include "../source/snapshots.elisa"
include "../toolchain.elisa"
include "../text/bytes.elisa"
include "./output.elisa"

module CompilerProcess:
    public:
        struct Invocation:
            profile: cstr
            scratch_directory: cstr
            stage1_binary: cstr
            runtime_object: cstr
            allow_stale: cstr
            clang: cstr
            executable: cstr
            release: bool
            emit_kind: cstr
            output_path: cstr
            source_path: cstr

        # Keep the environment buffers alive in this frame through fork and exec.
        def spawn(invocation: Invocation, sdk_root: darray[u8]&, developer_dir: darray[u8]&, callback_parameter: mutable darray[u8]&, callback_digits_offset: usize, sandbox_work_directory_fd: i64, compiler_stdout_fd: i64, compiler_stderr_fd: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # The compiler was resolved against the fixed child PATH above;
            # invoking its absolute path keeps execution and sandbox policy aligned.
            stage1_env: mutable darray[u8] = []
            runtime_env: mutable darray[u8] = []
            stale_env: mutable darray[u8] = []
            clang_env: mutable darray[u8] = []
            sdkroot_env: mutable darray[u8] = []
            developer_dir_env: mutable darray[u8] = []
            temporary_env: mutable darray[u8] = []
            args: mutable darray[cstr] = []
            args.push("/usr/bin/sandbox-exec")
            args.push("-D")
            args.push((&callback_parameter[0]).cast[cstr] can Unsafe.PointerCast)
            args.push("-p")
            args.push(invocation.profile)
            args.push("/usr/bin/env")
            args.push("-i")
            args.push(Toolchain::isolated_path_environment)
            ByteText::append_text(&temporary_env, "TMPDIR=")
            ByteText::append_bounded_text(&temporary_env, invocation.scratch_directory)
            temporary_env.push(0)
            args.push((&temporary_env[0]).cast[cstr] can Unsafe.PointerCast)
            sandbox_home_env: mutable darray[u8] = []
            ByteText::append_text(&sandbox_home_env, "HOME=")
            ByteText::append_bounded_text(&sandbox_home_env, invocation.scratch_directory)
            sandbox_home_env.push(0)
            args.push((&sandbox_home_env[0]).cast[cstr] can Unsafe.PointerCast)
            fixed_home_env: mutable darray[u8] = []
            ByteText::append_text(&fixed_home_env, "CFFIXED_USER_HOME=")
            ByteText::append_bounded_text(&fixed_home_env, invocation.scratch_directory)
            fixed_home_env.push(0)
            args.push((&fixed_home_env[0]).cast[cstr] can Unsafe.PointerCast)
            cache_home_env: mutable darray[u8] = []
            ByteText::append_text(&cache_home_env, "XDG_CACHE_HOME=")
            ByteText::append_bounded_text(&cache_home_env, invocation.scratch_directory)
            cache_home_env.push(0)
            args.push((&cache_home_env[0]).cast[cstr] can Unsafe.PointerCast)
            args.push("ELISA_STAGE1_SEMANTIC_GATE=1")
            if not Platform::pkg_cstr_equal(invocation.stage1_binary, ""):
                ByteText::append_text(&stage1_env, "ELISA_STAGE1_BIN=")
                ByteText::append_bounded_text(&stage1_env, invocation.stage1_binary)
                stage1_env.push(0)
                args.push((&stage1_env[0]).cast[cstr] can Unsafe.PointerCast)
            if not Platform::pkg_cstr_equal(invocation.runtime_object, ""):
                ByteText::append_text(&runtime_env, "ELISA_RUNTIME_OBJ=")
                ByteText::append_bounded_text(&runtime_env, invocation.runtime_object)
                runtime_env.push(0)
                args.push((&runtime_env[0]).cast[cstr] can Unsafe.PointerCast)
            if not Platform::pkg_cstr_equal(invocation.allow_stale, ""):
                ByteText::append_text(&stale_env, "ELISA_ALLOW_STALE_STAGE1=")
                ByteText::append_bounded_text(&stale_env, invocation.allow_stale)
                stale_env.push(0)
                args.push((&stale_env[0]).cast[cstr] can Unsafe.PointerCast)
            if invocation.clang[0].u8() != 0:
                ByteText::append_text(&clang_env, "ELISA_CLANG=")
                ByteText::append_bounded_text(&clang_env, invocation.clang)
                clang_env.push(0)
                args.push((&clang_env[0]).cast[cstr] can Unsafe.PointerCast)
            if sdk_root.count > 0.usize():
                ByteText::append_text(&sdkroot_env, "SDKROOT=")
                ByteText::append(&sdkroot_env, sdk_root)
                sdkroot_env.push(0)
                args.push((&sdkroot_env[0]).cast[cstr] can Unsafe.PointerCast)
                ByteText::append_text(&developer_dir_env, "DEVELOPER_DIR=")
                ByteText::append(&developer_dir_env, developer_dir)
                developer_dir_env.push(0)
                args.push((&developer_dir_env[0]).cast[cstr] can Unsafe.PointerCast)
            args.push(invocation.executable)
            if invocation.release:
                args.push("-O2")
            else:
                args.push("-O0")
                args.push("-g")
            args.push("-emit")
            args.push(invocation.emit_kind)
            args.push("-o")
            args.push(invocation.output_path)
            args.push(invocation.source_path)
            args.push(null)
            child_argv: mutable cstr&& = (&args[0]).cast[mutable cstr&&] can Unsafe.PointerCast
            pid: i64 = Platform::pkg_fork()
            if pid == 0:
                process_id: i64 = Platform::pkg_process_id()
                if not Toolchain::set_callback_path_pid(callback_parameter, callback_digits_offset, process_id):
                    Platform::pkg_process_exit(126)
                callback_file_name: cstr = (&callback_parameter[14]).cast[cstr] can Unsafe.PointerCast
                if Platform::pkg_create_exclusive_file(callback_file_name) != 0:
                    Platform::pkg_process_exit(126)
                if Platform::pkg_set_process_group() != 0:
                    Platform::pkg_process_exit(126)
                if Platform::pkg_set_process_limits(1) != 0:
                    Platform::pkg_process_exit(126)
                if Platform::pkg_fchdir(sandbox_work_directory_fd) != 0:
                    Platform::pkg_process_exit(126)
                null_fd: i64 = Platform::pkg_open_null()
                if null_fd < 0 or Platform::pkg_dup2(null_fd, 0) != 0 or Platform::pkg_dup2(compiler_stdout_fd, 1) != 1 or Platform::pkg_dup2(compiler_stderr_fd, 2) != 2:
                    Platform::pkg_process_exit(126)
                if null_fd > 2:
                    _ = Platform::pkg_close(null_fd)
                if Platform::pkg_close_inherited_fds() != 0:
                    Platform::pkg_process_exit(126)
                _ = Platform::pkg_execvp("/usr/bin/sandbox-exec", child_argv)
                Platform::pkg_process_exit(127)
            return pid

        struct Completion:
            wait_status: i64
            exit_status: i32
            group_stopped: bool

        def await_exit(pid: i64, timeout_milliseconds: i64) -> Completion can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            exit_status: mutable i32 = 0
            wait_status: i64 = Platform::pkg_waitpid_timeout(pid, &exit_status, timeout_milliseconds)
            group_stopped: bool = Platform::pkg_terminate_process_group(pid) == 0
            return Completion{wait_status: wait_status, exit_status: exit_status, group_stopped: group_stopped}

        def stop_after_setup_failure(pid: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            exit_status: mutable i32 = 0
            # Give an already exited child one millisecond to be reaped.
            # The wait helper then terminates and reaps a child that is still running.
            wait_status: i64 = Platform::pkg_waitpid_group_timeout(pid, &exit_status, 1)
            return wait_status == 0 or wait_status == Platform::pkg_timeout_error()

        # For failed builds whose compiler is no longer running.
        def discard_scratch(sandbox_directory: cstr, output_path: cstr, aggregate_path: cstr, snapshot_container: cstr, snapshot_roots: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if output_path[0].u8() != 0:
                _ = Platform::pkg_unlink(output_path)
            _ = BuildSnapshots::remove_all(snapshot_container, snapshot_roots)
            _ = BuildSnapshots::remove_aggregate(aggregate_path)
            _ = Platform::pkg_rmdir(sandbox_directory)

        # Publication requires successful removal of all compiler scratch files.
        # Return the first failure message, or an empty string on success.
        def retire_scratch_for_publication(sandbox_directory: cstr, output_path: cstr, aggregate_path: cstr, snapshot_container: cstr, snapshot_roots: darray[u8]&) -> cstr can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if not BuildSnapshots::remove_aggregate(aggregate_path):
                _ = Platform::pkg_unlink(output_path)
                _ = BuildSnapshots::remove_all(snapshot_container, snapshot_roots)
                return "error: unable to remove the private dependency aggregate source\n"
            if Platform::pkg_rmdir(sandbox_directory) != 0:
                _ = Platform::pkg_unlink(output_path)
                _ = BuildSnapshots::remove_all(snapshot_container, snapshot_roots)
                return "error: compiler left files in its private scratch directory; refusing to publish the build result\n"
            if not BuildSnapshots::remove_all(snapshot_container, snapshot_roots):
                _ = Platform::pkg_unlink(output_path)
                return "error: unable to remove the verified build source snapshots\n"
            return ""

        struct LogCapture:
            descriptor: i64
            diagnostic: cstr

        # Keep the template buffer in the caller through collection and cleanup.
        def open_log_capture(directory: darray[u8]&, capture_stdout: bool, path: mutable darray[u8]&) -> LogCapture can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path.resize(0)
            ByteText::append(path, directory)
            if path.count == 0.usize() or path[path.count - 1.usize()] != 47:
                path.push(47)
            ByteText::append_text(path, "compiler.stdout.XXXXXX" if capture_stdout else "compiler.stderr.XXXXXX")
            path.push(0)
            descriptor: i64 = Platform::pkg_mkstemp(path)
            if descriptor < 0:
                diagnostic: cstr = "error: unable to create the private compiler stdout capture\n" if capture_stdout else "error: unable to create the private compiler stderr capture\n"
                return LogCapture{descriptor: descriptor, diagnostic: diagnostic}
            return LogCapture{descriptor: descriptor, diagnostic: ""} if descriptor >= 3
            raised_descriptor: i64 = Platform::pkg_dup_fd_min(descriptor, 3)
            _ = Platform::pkg_close(descriptor)
            if raised_descriptor < 0:
                _ = Platform::pkg_unlink((&path[0]).cast[cstr] can Unsafe.PointerCast)
                diagnostic: cstr = "error: unable to secure the compiler stdout capture descriptor\n" if capture_stdout else "error: unable to secure the compiler stderr capture descriptor\n"
                return LogCapture{descriptor: raised_descriptor, diagnostic: diagnostic}
            return LogCapture{descriptor: raised_descriptor, diagnostic: ""}

        # Attempt every close and unlink even if forwarding fails.
        def collect_logs(stdout_descriptor: i64, stderr_descriptor: i64, stdout_path: cstr, stderr_path: cstr) -> bool can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                stdout_forwarded: bool = CliOutput::forward_descriptor(stdout_descriptor, 1)
                stderr_forwarded: bool = CliOutput::forward_descriptor(stderr_descriptor, 2)
                stdout_close_status: i64 = Platform::pkg_close(stdout_descriptor)
                stderr_close_status: i64 = Platform::pkg_close(stderr_descriptor)
                stdout_remove_status: i64 = Platform::pkg_unlink(stdout_path)
                stderr_remove_status: i64 = Platform::pkg_unlink(stderr_path)
                return stdout_forwarded and stderr_forwarded and stdout_close_status == 0 and stderr_close_status == 0 and stdout_remove_status == 0 and stderr_remove_status == 0

        def discard_logs(stdout_descriptor: i64, stderr_descriptor: i64, stdout_path: cstr, stderr_path: cstr) -> void:
            _ = Platform::pkg_close(stdout_descriptor)
            _ = Platform::pkg_close(stderr_descriptor)
            _ = Platform::pkg_unlink(stdout_path)
            _ = Platform::pkg_unlink(stderr_path)
