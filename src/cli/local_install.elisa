# Publish and remove verified local installations.
include "../install_faults.elisa"
include "./status.elisa"
include "../integrity.elisa"
include "../package/install_prefix.elisa"
include "../package/install_records.elisa"
include "../package/install_transaction.elisa"
include "../package/model.elisa"
include "../package/package_identity.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../text/bytes.elisa"
include "./output.elisa"

module LocalInstallCommand:
    public:
        def uninstall(argument_count: i64, slots: cstr&&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                # The package name, or empty when `--local` is missing.
                name: cstr =
                    local_seen: mutable bool = false
                    collected_name: cstr = while index < argument_count |local_seen, index: i64 = 2, collected: cstr = ""| -> collected:
                        argument: cstr = slots[index].cast[cstr]
                        index <- index + 1
                        if Platform::c_string_equal(argument, "--local"):
                            return CliStatus::usage if local_seen
                            local_seen <- true
                        elif Platform::c_string_equal(argument, "--") or Platform::c_string_length(argument) == 0.usize() or argument[0].u8() == 45 or Platform::c_string_length(collected) != 0.usize():
                            CliOutput::write_error("error: invalid uninstall arguments\n")
                            return CliStatus::usage
                        else:
                            collected <- argument
                    collected_name if local_seen else ""
                if Platform::c_string_length(name) == 0.usize():
                    CliStatus::usage
                else:
                    name_bytes: mutable darray[u8] = []
                    ByteText::append_bounded_text(&name_bytes, name)
                    CliStatus::usage if not PackageIdentity::valid_name(name_bytes) else uninstall_local(name_bytes)

        # The caller verifies artifact_bytes against the build receipt before publication.
        def publish_verified(prefix: darray[u8]&, name: darray[u8]&, version: darray[u8]&, artifact_bytes: darray[u8]&, digest: darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                return CliStatus::usage if:
                    not PackageIdentity::valid_name(name)
                    not PackageIdentity::valid_version(version)
                    not Integrity::valid_sha256_hex(digest)
                paths: InstallPaths = install_paths(prefix, name)
                return CliStatus::operation_failed if not InstallPrefix::ensure_trusted_directory(paths.binary_directory) or not InstallPrefix::ensure_trusted_directory(paths.receipt_directory)
                if not trusted_directories(paths):
                    CliOutput::write_error("error: install directories are not trusted; refusing publication\n")
                    return CliStatus::operation_failed
                recovered: mutable RecoveredTransaction = empty_journal()
                lock_file_descriptor: i64 = lock_and_recover(prefix, &recovered)
                return CliStatus::operation_failed if lock_file_descriptor < 0
                if recovered.install_published and ByteText::equal_text(recovered.operation, "install") and ByteText::equal(recovered.name, name) and ByteText::equal(recovered.version, version) and ByteText::equal(recovered.digest, digest):
                    if not InstallTransaction::release_install_lock(lock_file_descriptor):
                        CliOutput::write_error("error: could not close the recovered local installation lock descriptor\n")
                        CliStatus::operation_failed
                    else:
                        report_installed("already installed ", name, paths.destination)
                        CliStatus::success
                else:
                    publish_new(lock_file_descriptor, prefix, name, version, artifact_bytes, digest, paths)

    private:
        # Where one package is installed below a prefix. FFI calls may
        # invalidate caller-owned array headers, so every native call receives
        # a fresh copy of these paths.
        struct InstallPaths:
            binary_directory: darray[u8]
            receipt_directory: darray[u8]
            destination: darray[u8]
            receipt: darray[u8]

        def install_paths(prefix: darray[u8]&, name: darray[u8]&) -> InstallPaths can[Memory.Allocate, Abort.Panic]:
            binary_directory: mutable darray[u8] = []
            receipt_directory: mutable darray[u8] = []
            ProjectFiles::path_join_into(prefix, "bin", &binary_directory)
            ProjectFiles::path_join_into(prefix, "share/elisapkg/receipts", &receipt_directory)
            destination: mutable darray[u8] = []
            receipt: mutable darray[u8] = []
            ProjectFiles::path_join_bytes_into(binary_directory, name, &destination)
            ProjectFiles::path_join_bytes_into(receipt_directory, name, &receipt)
            InstallPaths{binary_directory: binary_directory, receipt_directory: receipt_directory, destination: destination, receipt: receipt}

        def fresh_copy(path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            [path[index] for index in 0..<path.count]

        def c_string_copy(path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            copy: mutable darray[u8] = []
            copy <- ProjectFiles::with_null_terminator(path)
            copy

        def trusted_directories(paths: InstallPaths&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            InstallPrefix::trusted_directory(paths.binary_directory) and InstallPrefix::trusted_directory(paths.receipt_directory)

        # The interrupted transaction recovery found and finished, if any.
        struct RecoveredTransaction:
            operation: mutable darray[u8]
            name: mutable darray[u8]
            version: mutable darray[u8]
            digest: mutable darray[u8]
            install_published: mutable bool

        def empty_journal() -> RecoveredTransaction:
            RecoveredTransaction{operation: [], name: [], version: [], digest: [], install_published: false}

        # Take the installation lock and finish any interrupted transaction.
        # Returns the lock descriptor, or -1 after reporting the failure.
        def lock_and_recover(prefix: darray[u8]&, recovered: mutable RecoveredTransaction&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                lock_file_descriptor: i64 =
                    prefix_c: darray[u8] = c_string_copy(prefix)
                    Platform::acquire_install_lock((&prefix_c[0]).cast[cstr] can Unsafe.PointerCast)
                if lock_file_descriptor < 0:
                    CliOutput::write_error("error: could not acquire the local installation lock; check the prefix and any legacy lock path\n")
                    return -1
                if not InstallTransaction::recover_local_install_transaction(prefix, &recovered.operation, &recovered.name, &recovered.version, &recovered.digest, &recovered.install_published):
                    _ = finish_error(lock_file_descriptor, "error: an interrupted local installation could not be safely recovered; preserve the journal and files for review\n")
                    return -1
                lock_file_descriptor

        def report_installed(prefix: cstr, name: darray[u8]&, destination: darray[u8]&) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok(prefix)
                CliOutput::write_bytes(1, name)
                CliOutput::write_ok(" to ")
                CliOutput::write_bytes(1, destination)
                CliOutput::write_ok("\n")

        def report_uninstalled(name: darray[u8]&) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok("uninstalled ")
                CliOutput::write_bytes(1, name)
                CliOutput::write_ok("\n")

        def finish_error(lock_file_descriptor: i64, message: cstr) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if Platform::c_string_length(message) > 0.usize():
                    CliOutput::write_error(message)
                if not InstallTransaction::release_install_lock(lock_file_descriptor):
                    CliOutput::write_error("error: could not close the local installation lock descriptor\n")
                CliStatus::operation_failed

        # Journal the installation, then publish the binary and its receipt.
        # Every step after the journal is recoverable from it.
        def publish_new(lock_file_descriptor: i64, prefix: darray[u8]&, name: darray[u8]&, version: darray[u8]&, artifact_bytes: darray[u8]&, digest: darray[u8]&, paths: InstallPaths&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                region occupied_scope:
                    destination: mutable darray[u8] = fresh_copy(paths.destination)
                    receipt_path: mutable darray[u8] = fresh_copy(paths.receipt)
                    if ProjectFiles::path_occupied(&destination) or ProjectFiles::path_occupied(&receipt_path):
                        return finish_error(lock_file_descriptor, "error: install destination or receipt already exists; refusing to overwrite\n")
                transaction_path: darray[u8] = InstallTransaction::local_install_transaction_path(prefix)
                region transaction_scope:
                    transaction: mutable darray[u8] = []
                    InstallRecords::encode_journal("install", name, version, digest, &transaction)
                    if ProjectFiles::publish_file_exclusively(transaction_path, &transaction) != 0:
                        return finish_error(lock_file_descriptor, "error: could not durably record the local installation transaction\n")
                InstallFaults::transaction_boundary("install.journal.durable")
                if ProjectFiles::publish_file_exclusively(fresh_copy(paths.destination), artifact_bytes) != 0:
                    return finish_error(lock_file_descriptor, "error: could not publish the local installation binary; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.binary.durable")
                region mode_scope:
                    destination_c: darray[u8] = c_string_copy(fresh_copy(paths.destination))
                    if Platform::change_mode(((&destination_c[0]).cast[cstr] can Unsafe.PointerCast), 493.u16()) != 0:
                        return finish_error(lock_file_descriptor, "error: could not set local installation permissions; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.binary.mode.durable")
                region receipt_scope:
                    receipt: mutable darray[u8] = []
                    InstallRecords::encode_receipt(name, version, paths.destination, digest, &receipt)
                    if not InstallTransaction::publish_local_install_receipt(fresh_copy(paths.receipt), receipt):
                        return finish_error(lock_file_descriptor, "error: could not publish the local installation receipt; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.receipt.durable")
                region receipt_sync_scope:
                    destination_c: darray[u8] = c_string_copy(fresh_copy(paths.destination))
                    receipt_c: darray[u8] = c_string_copy(fresh_copy(paths.receipt))
                    if not InstallTransaction::sync_local_install_entry_parents(((&destination_c[0]).cast[cstr] can Unsafe.PointerCast), (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast):
                        return finish_error(lock_file_descriptor, "error: could not sync local installation directories; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.targets.synced")
                if not InstallTransaction::retire_local_install_transaction(transaction_path):
                    finish_error(lock_file_descriptor, "error: the local installation was published but its transaction journal could not be retired\n")
                elif not InstallTransaction::release_install_lock(lock_file_descriptor):
                    CliStatus::operation_failed
                else:
                    report_installed("installed ", name, paths.destination)
                    CliStatus::success

        def uninstall_local(name: darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                prefix: mutable darray[u8] = []
                return CliStatus::usage if not InstallPrefix::read_configured(&prefix)
                paths: InstallPaths = install_paths(prefix, name)
                if not trusted_directories(paths):
                    CliOutput::write_error("error: install directories are not trusted; refusing removal\n")
                    return CliStatus::operation_failed
                recovered: mutable RecoveredTransaction = empty_journal()
                lock_file_descriptor: i64 = lock_and_recover(prefix, &recovered)
                return CliStatus::operation_failed if lock_file_descriptor < 0
                if ByteText::equal_text(recovered.operation, "uninstall") and ByteText::equal(recovered.name, name):
                    if not InstallTransaction::release_install_lock(lock_file_descriptor):
                        CliOutput::write_error("error: could not close the recovered local installation lock\n")
                        CliStatus::operation_failed
                    else:
                        report_uninstalled(name)
                        CliStatus::success
                else:
                    remove_installed(lock_file_descriptor, prefix, name, paths)

        # The installed binary and receipt, pinned by their file identities so
        # removal cannot delete a file that replaced them.
        struct InstalledFiles:
            artifact: mutable darray[u8]
            receipt: mutable darray[u8]
            artifact_device: mutable u64
            artifact_inode: mutable u64
            receipt_device: mutable u64
            receipt_inode: mutable u64

        # Verify the installed binary against its receipt, journal the
        # removal, then remove both files. Every step after the journal is
        # recoverable from it.
        def remove_installed(lock_file_descriptor: i64, prefix: darray[u8]&, name: darray[u8]&, paths: InstallPaths&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                region destination_state_scope:
                    destination_state: i64 =
                        destination_c: darray[u8] = c_string_copy(fresh_copy(paths.destination))
                        Platform::package_file_size((&destination_c[0]).cast[cstr] can Unsafe.PointerCast)
                    return finish_error(lock_file_descriptor, "error: no matching local installation receipt is available\n") if destination_state == -2
                    return finish_error(lock_file_descriptor, "error: local installation is not a trusted regular file; refusing removal\n") if destination_state < 0
                region receipt_state_scope:
                    receipt_state: i64 =
                        receipt_c: darray[u8] = c_string_copy(fresh_copy(paths.receipt))
                        Platform::package_file_size((&receipt_c[0]).cast[cstr] can Unsafe.PointerCast)
                    return finish_error(lock_file_descriptor, "error: no matching local installation receipt is available\n") if receipt_state == -2
                    return finish_error(lock_file_descriptor, "error: local installation receipt is not a trusted regular file; refusing removal\n") if receipt_state < 0
                transaction_path: darray[u8] = InstallTransaction::local_install_transaction_path(prefix)
                region removal_scope:
                    files: mutable InstalledFiles = InstalledFiles{artifact: [], receipt: [], artifact_device: 0.u64(), artifact_inode: 0.u64(), receipt_device: 0.u64(), receipt_inode: 0.u64()}
                    return finish_error(lock_file_descriptor, "error: could not read the local installation or its receipt\n") if:
                        not InstallTransaction::read_trusted_install_file_identity(fresh_copy(paths.destination), 67108864.usize(), &files.artifact, &files.artifact_device, &files.artifact_inode)
                        not InstallTransaction::read_trusted_install_file_identity(fresh_copy(paths.receipt), InstallRecords::maximum_record_bytes, &files.receipt, &files.receipt_device, &files.receipt_inode)
                    region journal_scope:
                        transaction: mutable darray[u8] = []
                        region encode_scope:
                            digest: darray[u8] =
                                digest_hex: mutable darray[u8] = []
                                region digest_bytes_scope:
                                    digest_bytes: mutable darray[u8] = []
                                    if Integrity::sha256(files.artifact, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest_hex):
                                        return finish_error(lock_file_descriptor, "error: could not verify the local installation binary\n")
                                digest_hex
                            version: mutable darray[u8] = []
                            return finish_error(lock_file_descriptor, "error: installation receipt does not match the current file; refusing removal\n") if not receipt_version(files.receipt, name, paths.destination, digest, &version)
                            InstallRecords::encode_journal("uninstall", name, version, digest, &transaction)
                        if ProjectFiles::publish_file_exclusively(transaction_path, &transaction) != 0:
                            return finish_error(lock_file_descriptor, "error: could not durably record the local uninstallation transaction\n")
                    InstallFaults::transaction_boundary("uninstall.journal.durable")
                    if not InstallTransaction::remove_trusted_install_file_identity(fresh_copy(paths.destination), files.artifact_device, files.artifact_inode):
                        return finish_error(lock_file_descriptor, "error: could not remove the local installation; recovery will inspect the durable transaction\n")
                    InstallFaults::transaction_boundary("uninstall.binary.removed")
                    if not InstallTransaction::remove_trusted_install_file_identity(fresh_copy(paths.receipt), files.receipt_device, files.receipt_inode):
                        return finish_error(lock_file_descriptor, "error: could not remove the local installation receipt; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("uninstall.receipt.removed")
                region sync_scope:
                    destination_c: darray[u8] = c_string_copy(fresh_copy(paths.destination))
                    receipt_c: darray[u8] = c_string_copy(fresh_copy(paths.receipt))
                    if not InstallTransaction::sync_local_install_entry_parents(((&destination_c[0]).cast[cstr] can Unsafe.PointerCast), (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast):
                        return finish_error(lock_file_descriptor, "error: could not sync local installation directories; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("uninstall.targets.synced")
                if not InstallTransaction::retire_local_install_transaction(transaction_path):
                    finish_error(lock_file_descriptor, "error: the local installation was removed but its transaction journal could not be retired\n")
                elif not InstallTransaction::release_install_lock(lock_file_descriptor):
                    CliStatus::operation_failed
                else:
                    report_uninstalled(name)
                    CliStatus::success

        # A receipt reads "elisapkg-install-receipt:1", the name, a stable
        # version, the install path, and the artifact digest. Extract the
        # version when every other field matches.
        def receipt_version(receipt: darray[u8]&, name: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            expected_prefix: darray[u8] =
                text: mutable darray[u8] = []
                ByteText::append_text(&text, "elisapkg-install-receipt:1\nname:")
                ByteText::append(&text, name)
                ByteText::append_text(&text, "\nversion:")
                text
            expected_suffix: darray[u8] =
                text: mutable darray[u8] = []
                ByteText::append_text(&text, "\npath:")
                ByteText::append(&text, destination)
                ByteText::append_text(&text, "\nartifact-digest:sha256:")
                ByteText::append(&text, digest)
                ByteText::append_text(&text, "\n")
                text
            version_end: usize = receipt.count - expected_suffix.count if receipt.count >= expected_suffix.count else 0.usize()
            if not ByteText::starts_with(receipt, expected_prefix) or not ByteText::ends_with(receipt, expected_suffix) or version_end <= expected_prefix.count:
                false
            else:
                ByteText::append_range(out, receipt, expected_prefix.count, version_end)
                parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                PackageIdentity::parse_version(out, &parsed_version)
