# Publish and remove verified local installations.
include "../install_faults.elisa"
include "./status.elisa"
include "../integrity.elisa"
include "../package/install_prefix.elisa"
include "../package/install_records.elisa"
include "../package/install_transaction.elisa"
include "../package/model.elisa"
include "../package/package_identity.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../text/bytes.elisa"
include "./output.elisa"

module LocalInstallCommand:
    public:
        def uninstall(argument_count: i64, slots: mutable cstr&&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                local_seen: mutable bool = false
                name: mutable cstr = ""
                while index < argument_count |index: i64 = 2|:
                    region argument_scope:
                        argument: cstr = slots[index].cast[cstr]
                        if Platform::c_string_equal(argument, "--local"):
                            return CliStatus::usage if local_seen
                            local_seen <- true
                        elif Platform::c_string_equal(argument, "--") or Platform::c_string_length(argument) == 0.usize() or argument[0].u8() == 45 or Platform::c_string_length(name) != 0.usize():
                            CliOutput::write_error("error: invalid uninstall arguments\n")
                            return CliStatus::usage
                        else:
                            name <- argument
                    index <- index + 1
                return CliStatus::usage if not local_seen or Platform::c_string_length(name) == 0.usize()
                name_bytes: mutable darray[u8] = []
                ByteText::append_bounded_text(&name_bytes, name)
                return CliStatus::usage if not PackageIdentity::valid_name(name_bytes)
                return uninstall_local(name_bytes)

        # The caller verifies artifact_bytes against the build receipt before publication.
        def publish_verified(prefix: darray[u8]&, name: darray[u8]&, version: darray[u8]&, artifact_bytes: darray[u8]&, digest: darray[u8]&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                return CliStatus::usage if:
                    not PackageIdentity::valid_name(name)
                    not PackageIdentity::valid_version(version)
                    not Integrity::valid_sha256_hex(digest)
                binary_directory: mutable darray[u8] = []
                receipt_directory: mutable darray[u8] = []
                ProjectFiles::path_join_into(prefix, "bin", &binary_directory)
                ProjectFiles::path_join_into(prefix, "share/elisapkg/receipts", &receipt_directory)
                return CliStatus::operation_failed if not InstallPrefix::ensure_trusted_directory(binary_directory) or not InstallPrefix::ensure_trusted_directory(receipt_directory)
                if not InstallPrefix::trusted_directory(binary_directory) or not InstallPrefix::trusted_directory(receipt_directory):
                    CliOutput::write_error("error: install directories are not trusted; refusing publication\n")
                    return CliStatus::operation_failed
                destination: mutable darray[u8] = []
                receipt_path: mutable darray[u8] = []
                ProjectFiles::path_join_bytes_into(binary_directory, name, &destination)
                ProjectFiles::path_join_bytes_into(receipt_directory, name, &receipt_path)
                destination_snapshot: mutable darray[u8] = []
                receipt_snapshot: mutable darray[u8] = []
                ByteText::append(&destination_snapshot, destination)
                ByteText::append(&receipt_snapshot, receipt_path)
                lock_file_descriptor: i64 =
                    prefix_c: mutable darray[u8] = []
                    ProjectFiles::path_with_null_terminator_into(prefix, &prefix_c)
                    prefix_name: cstr = (&prefix_c[0]).cast[cstr] can Unsafe.PointerCast
                    Platform::acquire_install_lock(prefix_name)
                if lock_file_descriptor < 0:
                    CliOutput::write_error("error: could not acquire the local installation lock; check the prefix and any legacy lock path\n")
                    return CliStatus::operation_failed
                recovered_operation: mutable darray[u8] = []
                recovered_name: mutable darray[u8] = []
                recovered_version: mutable darray[u8] = []
                recovered_digest: mutable darray[u8] = []
                recovered_install_published: mutable bool = false
                if not InstallTransaction::recover_local_install_transaction(prefix, &recovered_operation, &recovered_name, &recovered_version, &recovered_digest, &recovered_install_published):
                    return finish_error(lock_file_descriptor, "error: an interrupted local installation could not be safely recovered; preserve the journal and files for review\n")
                destination <- destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                if recovered_install_published and ByteText::equal_text(recovered_operation, "install") and ByteText::equal(recovered_name, name) and ByteText::equal(recovered_version, version) and ByteText::equal(recovered_digest, digest):
                    if not InstallTransaction::release_install_lock(lock_file_descriptor):
                        CliOutput::write_error("error: could not close the recovered local installation lock descriptor\n")
                        return CliStatus::operation_failed
                    CliOutput::write_ok("already installed ")
                    CliOutput::write_bytes(1, name)
                    CliOutput::write_ok(" to ")
                    CliOutput::write_bytes(1, &destination)
                    CliOutput::write_ok("\n")
                    return CliStatus::success
                if ProjectFiles::path_occupied(&destination):
                    return finish_error(lock_file_descriptor, "error: install destination or receipt already exists; refusing to overwrite\n")
                receipt_path <- receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                if ProjectFiles::path_occupied(&receipt_path):
                    return finish_error(lock_file_descriptor, "error: install destination or receipt already exists; refusing to overwrite\n")
                receipt: mutable darray[u8] = []
                InstallRecords::encode_receipt(name, version, destination_snapshot, digest, &receipt)
                transaction: mutable darray[u8] = []
                InstallRecords::encode_journal("install", name, version, digest, &transaction)
                transaction_path: mutable darray[u8] = []
                InstallTransaction::local_install_transaction_path(prefix, &transaction_path)
                if ProjectFiles::publish_file_exclusively(transaction_path, &transaction) != 0:
                    return finish_error(lock_file_descriptor, "error: could not durably record the local installation transaction\n")
                InstallFaults::transaction_boundary("install.journal.durable")
                destination <- destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                if ProjectFiles::publish_file_exclusively(destination, artifact_bytes) != 0:
                    return finish_error(lock_file_descriptor, "error: could not publish the local installation binary; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.binary.durable")
                destination <- destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                destination_c: mutable darray[u8] = []
                ProjectFiles::path_with_null_terminator_into(&destination, &destination_c)
                destination_name: cstr = (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
                if Platform::change_mode(destination_name, 493.u16()) != 0:
                    return finish_error(lock_file_descriptor, "error: could not set local installation permissions; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.binary.mode.durable")
                receipt_path <- receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                if not InstallTransaction::publish_local_install_receipt(receipt_path, receipt):
                    return finish_error(lock_file_descriptor, "error: could not publish the local installation receipt; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.receipt.durable")
                receipt_sync_c: mutable darray[u8] = []
                ProjectFiles::path_with_null_terminator_into(&receipt_path, &receipt_sync_c)
                region receipt_sync_name_scope:
                    receipt_sync_name: cstr = (&receipt_sync_c[0]).cast[cstr] can Unsafe.PointerCast
                    if not InstallTransaction::sync_local_install_entry_parents(destination_name, receipt_sync_name):
                        return finish_error(lock_file_descriptor, "error: could not sync local installation directories; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.targets.synced")
                return finish_error(lock_file_descriptor, "error: the local installation was published but its transaction journal could not be retired\n") if not InstallTransaction::retire_local_install_transaction(transaction_path)
                return CliStatus::operation_failed if not InstallTransaction::release_install_lock(lock_file_descriptor)
                CliOutput::write_ok("installed ")
                CliOutput::write_bytes(1, name)
                CliOutput::write_ok(" to ")
                CliOutput::write_bytes(1, &destination)
                CliOutput::write_ok("\n")
                return CliStatus::success

    private:
        def finish_error(lock_file_descriptor: i64, message: cstr) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if Platform::c_string_length(message) > 0.usize():
                    CliOutput::write_error(message)
                if not InstallTransaction::release_install_lock(lock_file_descriptor):
                    CliOutput::write_error("error: could not close the local installation lock descriptor\n")
                return CliStatus::operation_failed


        def uninstall_local(name: darray[u8]&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                prefix: mutable darray[u8] = []
                return CliStatus::usage if not InstallPrefix::read_configured(&prefix)
                binary_directory: mutable darray[u8] = []
                receipt_directory: mutable darray[u8] = []
                ProjectFiles::path_join_into(prefix, "bin", &binary_directory)
                ProjectFiles::path_join_into(prefix, "share/elisapkg/receipts", &receipt_directory)
                if not InstallPrefix::trusted_directory(binary_directory) or not InstallPrefix::trusted_directory(receipt_directory):
                    CliOutput::write_error("error: install directories are not trusted; refusing removal\n")
                    return CliStatus::operation_failed
                destination: mutable darray[u8] = []
                receipt_path: mutable darray[u8] = []
                ProjectFiles::path_join_bytes_into(binary_directory, name, &destination)
                ProjectFiles::path_join_bytes_into(receipt_directory, name, &receipt_path)
                destination_snapshot: mutable darray[u8] = []
                receipt_snapshot: mutable darray[u8] = []
                ByteText::append(&destination_snapshot, destination)
                ByteText::append(&receipt_snapshot, receipt_path)
                lock_file_descriptor: i64 =
                    prefix_c: mutable darray[u8] = []
                    ProjectFiles::path_with_null_terminator_into(&prefix, &prefix_c)
                    prefix_name: cstr = (&prefix_c[0]).cast[cstr] can Unsafe.PointerCast
                    Platform::acquire_install_lock(prefix_name)
                if lock_file_descriptor < 0:
                    CliOutput::write_error("error: could not acquire the local installation lock; check the prefix and any legacy lock path\n")
                    return CliStatus::operation_failed
                recovered_operation: mutable darray[u8] = []
                recovered_name: mutable darray[u8] = []
                recovered_version: mutable darray[u8] = []
                recovered_digest: mutable darray[u8] = []
                recovered_install_published: mutable bool = false
                if not InstallTransaction::recover_local_install_transaction(prefix, &recovered_operation, &recovered_name, &recovered_version, &recovered_digest, &recovered_install_published):
                    return finish_error(lock_file_descriptor, "error: an interrupted local installation could not be safely recovered; preserve the journal and files for review\n")
                if ByteText::equal_text(recovered_operation, "uninstall") and ByteText::equal(recovered_name, name):
                    if not InstallTransaction::release_install_lock(lock_file_descriptor):
                        CliOutput::write_error("error: could not close the recovered local installation lock\n")
                        return CliStatus::operation_failed
                    CliOutput::write_ok("uninstalled ")
                    CliOutput::write_bytes(1, name)
                    CliOutput::write_ok("\n")
                    return CliStatus::success
                destination <- destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                destination_c: mutable darray[u8] = []
                ProjectFiles::path_with_null_terminator_into(&destination, &destination_c)
                destination_name: cstr = (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
                region destination_state_scope:
                    destination_state: i64 = Platform::package_file_size(destination_name)
                    if destination_state == -2:
                        return finish_error(lock_file_descriptor, "error: no matching local installation receipt is available\n")
                    if destination_state < 0:
                        return finish_error(lock_file_descriptor, "error: local installation is not a trusted regular file; refusing removal\n")
                receipt_path <- receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                receipt_c: mutable darray[u8] = []
                ProjectFiles::path_with_null_terminator_into(&receipt_path, &receipt_c)
                receipt_name: cstr = (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast
                region receipt_state_scope:
                    receipt_state: i64 = Platform::package_file_size(receipt_name)
                    if receipt_state == -2:
                        return finish_error(lock_file_descriptor, "error: no matching local installation receipt is available\n")
                    if receipt_state < 0:
                        return finish_error(lock_file_descriptor, "error: local installation receipt is not a trusted regular file; refusing removal\n")
                artifact_bytes: mutable darray[u8] = []
                receipt: mutable darray[u8] = []
                artifact_device: mutable u64 = 0.u64()
                artifact_inode: mutable u64 = 0.u64()
                receipt_device: mutable u64 = 0.u64()
                receipt_inode: mutable u64 = 0.u64()
                destination <- destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                if not InstallTransaction::read_trusted_install_file_identity(destination, 67108864.usize(), &artifact_bytes, &artifact_device, &artifact_inode):
                    return finish_error(lock_file_descriptor, "error: could not read the local installation or its receipt\n")
                receipt_path <- receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                if not InstallTransaction::read_trusted_install_file_identity(receipt_path, InstallRecords::maximum_record_bytes, &receipt, &receipt_device, &receipt_inode):
                    return finish_error(lock_file_descriptor, "error: could not read the local installation or its receipt\n")
                digest_bytes: mutable darray[u8] = []
                digest: mutable darray[u8] = []
                if Integrity::sha256(artifact_bytes, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest):
                    return finish_error(lock_file_descriptor, "error: could not verify the local installation binary\n")
                expected_prefix: mutable darray[u8] = []
                expected_suffix: mutable darray[u8] = []
                ByteText::append_text(&expected_prefix, "elisapkg-install-receipt:1\nname:")
                ByteText::append(&expected_prefix, name)
                ByteText::append_text(&expected_prefix, "\nversion:")
                ByteText::append_text(&expected_suffix, "\npath:")
                ByteText::append(&expected_suffix, destination_snapshot)
                ByteText::append_text(&expected_suffix, "\nartifact-digest:sha256:")
                ByteText::append(&expected_suffix, digest)
                ByteText::append_text(&expected_suffix, "\n")
                version_bytes: mutable darray[u8] = []
                version_end: usize = receipt.count - expected_suffix.count if receipt.count >= expected_suffix.count else 0.usize()
                if not ByteText::starts_with(receipt, expected_prefix) or not ByteText::ends_with(receipt, expected_suffix) or version_end <= expected_prefix.count:
                    return finish_error(lock_file_descriptor, "error: installation receipt does not match the current file; refusing removal\n")
                for index in expected_prefix.count..<version_end |receipt, version_bytes|:
                    version_bytes <- version_bytes.push(receipt[index])
                region parsed_version_scope:
                    parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                    if not parse_version(version_bytes, &parsed_version):
                        return finish_error(lock_file_descriptor, "error: installation receipt does not match the current file; refusing removal\n")
                transaction: mutable darray[u8] = []
                InstallRecords::encode_journal("uninstall", name, version_bytes, digest, &transaction)
                transaction_path: mutable darray[u8] = []
                InstallTransaction::local_install_transaction_path(prefix, &transaction_path)
                if ProjectFiles::publish_file_exclusively(transaction_path, &transaction) != 0:
                    return finish_error(lock_file_descriptor, "error: could not durably record the local uninstallation transaction\n")
                InstallFaults::transaction_boundary("uninstall.journal.durable")
                destination <- destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                if not InstallTransaction::remove_trusted_install_file_identity(destination, artifact_device, artifact_inode):
                    return finish_error(lock_file_descriptor, "error: could not remove the local installation; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("uninstall.binary.removed")
                receipt_path <- receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                if not InstallTransaction::remove_trusted_install_file_identity(receipt_path, receipt_device, receipt_inode):
                    return finish_error(lock_file_descriptor, "error: could not remove the local installation receipt; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("uninstall.receipt.removed")
                if not InstallTransaction::sync_local_install_entry_parents(destination_name, receipt_name):
                    return finish_error(lock_file_descriptor, "error: could not sync local installation directories; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("uninstall.targets.synced")
                if not InstallTransaction::retire_local_install_transaction(transaction_path):
                    return finish_error(lock_file_descriptor, "error: the local installation was removed but its transaction journal could not be retired\n")
                return CliStatus::operation_failed if not InstallTransaction::release_install_lock(lock_file_descriptor)
                CliOutput::write_ok("uninstalled ")
                CliOutput::write_bytes(1, name)
                CliOutput::write_ok("\n")
                return CliStatus::success

        def parse_version(value: darray[u8]&, out: mutable Model::Version&) -> bool:
            out <- Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return false if not PackageIdentity::parse_version(value, &parsed)
            out.major <- parsed.major
            out.minor <- parsed.minor
            out.patch <- parsed.patch
            out.prerelease <- parsed.prerelease
            return true
