# Verify the receipt and bytes of an existing build artifact before reuse.
include "./build_receipt.elisa"
include "./files.elisa"

module BuildCache:
    public:
        def verified_digest(artifact: darray[u8]&, receipt_path: darray[u8]&, expected_prefix: darray[u8]&, access_mode: i64, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            region cached_receipt_scope:
                cached_receipt: mutable darray[u8] = []
                return false if not:
                    Platform::read_bounded_file(receipt_path, BuildReceipt::receipt_size(expected_prefix.count), &cached_receipt)
                    BuildReceipt::receipt_header_matches(cached_receipt, expected_prefix)
                    ProjectFiles::valid_path_bytes(artifact)
                    artifact_accessible(artifact, access_mode)
                return true if artifact_digest(artifact, out) and BuildReceipt::receipt_digest_matches(cached_receipt, out)
            out.resize(0)
            false

    private:
        def artifact_accessible(artifact: darray[u8]&, access_mode: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            name_bytes: darray[u8] = ProjectFiles::with_null_terminator(artifact)
            name: cstr = (&name_bytes[0]).cast[cstr] can Unsafe.PointerCast
            Platform::access_path(name, access_mode) == 0

        def artifact_digest(artifact: darray[u8]&, digest: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            content: mutable darray[u8] = []
            Platform::read_bounded_file(artifact, Integrity::maximum_input, &content) and Integrity::sha256_hex(content, digest)
