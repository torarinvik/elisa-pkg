# Verify the receipt and bytes of an existing build artifact before reuse.
include "./build_receipt.elisa"
include "./files.elisa"

module BuildCache:
    public:
        def verified_digest(artifact: darray[u8]&, receipt_path: darray[u8]&, expected_prefix: darray[u8]&, access_mode: i64, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            cached_receipt: mutable darray[u8] = []
            return false if not:
                Platform::pkg_read_bounded_file(receipt_path, BuildReceipt::receipt_size(expected_prefix.count), &cached_receipt)
                BuildReceipt::receipt_header_matches(cached_receipt, expected_prefix)
                ProjectFiles::valid_path_bytes(artifact)
            name_bytes: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(artifact, &name_bytes)
            name: cstr = (&name_bytes[0]).cast[cstr] can Unsafe.PointerCast
            return false if Platform::pkg_access(name, access_mode) != 0
            content: mutable darray[u8] = []
            return false if not Platform::pkg_read_bounded_file(artifact, Integrity::max_input, &content)
            digest: mutable darray[u8] = []
            return false if not:
                Integrity::sha256_hex(content, &digest)
                BuildReceipt::receipt_digest_matches(cached_receipt, digest)
            ByteText::append(out, digest)
            return true
