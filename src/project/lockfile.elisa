# Lockfile field validation and indexed registry-record lookup.
include "../archive.elisa"
include "../integrity.elisa"
include "../json.elisa"
include "../package/package_identity.elisa"
include "../resolution/solver.elisa"
include "../text/bytes.elisa"
include "./schema_fields.elisa"

module Lockfile:
    public:
        const enum Format of u8:
            Local
            Registry

        const local_version: u64 = 2
        const registry_version: u64 = 3
        const registry_resolver: cstr = "elisapkg-registry-v1"

        # Leave room for the closing array, object, and line endings.
        const maximum_body_bytes: usize = Json::maximum_document_bytes - 7.usize()

        def append_header(out: mutable darray[u8]&, format: Format, name: darray[u8]&, version: darray[u8]&, manifest_digest: darray[u8]&, source_digest: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(out, "{\n  \"lock-version\": ")
            ByteText::append_decimal(out, local_version if format == Format.Local else registry_version)
            ByteText::append_text(out, ",\n  \"resolver\": \"")
            ByteText::append_text(out, "elisapkg-v2" if format == Format.Local else registry_resolver)
            ByteText::append_text(out, "\",\n  \"package\": {\n    \"name\": \"")
            ByteText::append(out, name)
            ByteText::append_text(out, "\",\n    \"version\": \"")
            ByteText::append(out, version)
            ByteText::append_text(out, "\",\n    \"manifest-digest\": \"sha256:")
            ByteText::append(out, manifest_digest)
            ByteText::append_text(out, "\",\n    \"source-digest\": \"sha256:")
            ByteText::append(out, source_digest)
            ByteText::append_text(out, "\"\n  },\n  \"packages\": [")

        def append_footer(out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(out, "\n  ]\n}\n")

        def version_is(raw: darray[u8]&, wanted: u64) -> bool can[Memory.Allocate, Abort.Panic]:
            start: usize = Json::root_start(raw)
            finish: usize = Json::root_object_end(raw, start)
            parsed: mutable u64 = 0
            Json::object_unsigned_value(raw, start, finish, "lock-version", &parsed) and parsed == wanted

        def read_registry_version(raw: darray[u8]&, record_start: usize, record_end: usize, out: mutable Model::Version&) -> bool:
            start: mutable usize = 0
            finish: mutable usize = 0
            Json::object_string_span(raw, record_start, record_end, "version", &start, &finish) and SemVer::parse_range(raw, start, finish, out) and not out.prerelease

        def read_registry_archive(raw: darray[u8]&, record_start: usize, record_end: usize, archive: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            source_start: mutable usize = 0
            source_end: mutable usize = 0
            Json::object_value_span(raw, record_start, record_end, "source", &source_start, &source_end) and SchemaFields::valid(raw, source_start, source_end, SchemaFields::Kind.RegistryLockSource) and Json::object_string_equals_text(raw, source_start, source_end, "type", "registry") and Json::object_string_equals_text(raw, source_start, source_end, "registry", "primary") and Json::object_string_value(raw, source_start, source_end, "archive", archive) and Archive::is_safe_entry(archive)

        def read_sha256_field(raw: darray[u8]&, object_start: usize, object_end: usize, field: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            start: usize = sha256_field_start(raw, object_start, object_end, field)
            if start >= raw.count:
                false
            else:
                ByteText::append_range(out, raw, start, start + 64.usize())
                true

        def has_sha256_field(raw: darray[u8]&, object_start: usize, object_end: usize, field: cstr) -> bool:
            sha256_field_start(raw, object_start, object_end, field) < raw.count

        def sha256_field_equals(raw: darray[u8]&, object_start: usize, object_end: usize, field: cstr, expected: darray[u8]&) -> bool:
            start: usize = sha256_field_start(raw, object_start, object_end, field)
            start < raw.count and ByteText::range_equals(raw, start, start + 64.usize(), expected)

        def name_precedes(lock: darray[u8]&, left_start: usize, left_end: usize, right_start: usize, right_end: usize) -> bool:
            requires left_start <= left_end and left_end <= lock.count
            requires right_start <= right_end and right_end <= lock.count
            left_length: usize = left_end - left_start
            right_length: usize = right_end - right_start
            # The first differing byte decides; otherwise the shorter name sorts first.
            for offset in 0..<(left_length if left_length < right_length else right_length) |precedes: bool = left_length < right_length| -> precedes:
                break true if lock[left_start + offset] < lock[right_start + offset]
                break false if lock[left_start + offset] > lock[right_start + offset]

        def registry_record_starts(lock: darray[u8]&, packages_start: usize, packages_end: usize, out: mutable darray[usize]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if:
                packages_end >= lock.count or packages_start >= packages_end
                lock[packages_start] != 91 or lock[packages_end] != 93
            while true |starts: darray[usize] = [], cursor: usize = packages_start + 1.usize(), record_end: usize = 0.usize(), name_start: usize = 0.usize(), name_end: usize = 0.usize(), previous_start: usize = 0.usize(), previous_end: usize = 0.usize()|:
                cursor <- Json::skip_whitespace(lock, cursor, packages_end)
                return false if cursor >= packages_end or lock[cursor] != 123 or starts.count >= maximum_registry_records
                record_end <- Json::object_end(lock, cursor)
                return false if record_end <= cursor or record_end >= packages_end
                return false if not:
                    Json::object_string_span(lock, cursor, record_end, "name", &name_start, &name_end)
                    PackageIdentity::valid_name_segment(lock, name_start, name_end)
                    previous_end <= previous_start or name_precedes(lock, previous_start, previous_end, name_start, name_end)
                previous_start <- name_start
                previous_end <- name_end
                starts <- starts.push(cursor)
                cursor <- Json::skip_whitespace(lock, record_end + 1.usize(), packages_end)
                if cursor == packages_end:
                    for index in 0..<starts.count |out, starts|:
                        out.push(starts[index])
                    return true
                return false if lock[cursor] != 44
                cursor <- cursor + 1.usize()

        def registry_record_index(lock: darray[u8]&, starts: darray[usize]&, wanted: darray[u8]&, out: mutable usize&) -> bool:
            out <- 0.usize()
            lower: usize =
                while first < last |first: usize = 0, last: usize = starts.count| -> first:
                    middle: usize = first + (last - first) / 2.usize()
                    comparison: i64 = compare_record_name(lock, starts[middle], wanted)
                    return false if comparison == invalid_record_name
                    if comparison < 0:
                        first <- middle + 1.usize()
                    else:
                        last <- middle
            if lower >= starts.count or compare_record_name(lock, starts[lower], wanted) != 0:
                false
            else:
                out <- lower
                true

        def matching_registry_record(lock: darray[u8]&, starts: darray[usize]&, wanted: Solver::Constraint) -> i64:
            record_index: mutable usize = 0.usize()
            return -1 if not registry_record_index(lock, starts, wanted.package, &record_index)
            record_start: usize = starts[record_index]
            record_end: usize = Json::object_end(lock, record_start)
            version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            requirement: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
            record_index.i64() if record_end > record_start and record_end < lock.count and read_registry_version(lock, record_start, record_end, &version) and SemVer::parse_requirement(wanted.requirement, &requirement) and SemVer::matches(requirement, version) else -1

        # Match only direct records in the packages array.
        def contains_package(raw: darray[u8]&, wanted: darray[u8]&) -> bool:
            start: usize = Json::root_value_offset(raw, "packages")
            return false if start >= raw.count or raw[start] != 91
            finish: usize = Json::array_end(raw, start)
            if finish <= start or finish >= raw.count:
                false
            else:
                while cursor < finish |cursor: usize = start + 1.usize(), record_end: usize = 0.usize(), found: bool = false| -> found:
                    cursor <- Json::skip_whitespace(raw, cursor, finish)
                    break false if cursor >= finish or raw[cursor] != 123
                    record_end <- Json::object_end(raw, cursor)
                    break false if record_end <= cursor or record_end >= finish
                    break true if Json::object_string_equals(raw, cursor, record_end, "name", wanted)
                    cursor <- Json::skip_whitespace(raw, record_end + 1.usize(), finish)
                    break false if cursor >= finish or raw[cursor] != 44
                    cursor <- cursor + 1.usize()

        # The caller supplies record offsets in strictly increasing package-name order.
        def registry_satisfies_roots(lock: darray[u8]&, starts: darray[usize]&, roots: darray[Solver::Constraint]&) -> bool:
            for root_index in 0..<roots.count |lock, starts, roots|:
                return false if matching_registry_record(lock, starts, roots[root_index]) < 0
            true

    private:
        const invalid_record_name: i64 = 2

        def compare_record_name(lock: darray[u8]&, record_start: usize, wanted: darray[u8]&) -> i64:
            start: mutable usize = 0
            length: usize =
                record_end: usize = Json::object_end(lock, record_start)
                finish: mutable usize = 0
                if record_end <= record_start or record_end >= lock.count or not Json::object_string_span(lock, record_start, record_end, "name", &start, &finish):
                    return invalid_record_name
                else:
                    finish - start
            # The first differing byte decides; otherwise the shorter name sorts first.
            for offset in 0..<(length if length < wanted.count else wanted.count) |order: i64 = -1 if length < wanted.count else 1 if length > wanted.count else 0| -> order:
                break -1 if lock[start + offset] < wanted[offset]
                break 1 if lock[start + offset] > wanted[offset]

        # Return the validated hex span's start, or the input length on failure.
        def sha256_field_start(raw: darray[u8]&, object_start: usize, object_end: usize, field: cstr) -> usize:
            start: mutable usize = 0
            finish: mutable usize = 0
            start + 7.usize() if Json::object_string_span(raw, object_start, object_end, field, &start, &finish) and finish - start == 71.usize() and ByteText::range_equals_text(raw, start, start + 7.usize(), "sha256:") and Integrity::valid_sha256_hex_range(raw, start + 7.usize(), finish) else raw.count

        const maximum_registry_records: usize = 4096.usize()
