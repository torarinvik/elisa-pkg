# Project file operations shared by commands and transaction recovery.
include "../platform.elisa"
include "../text/bytes.elisa"

module ProjectFiles:
    public:
        # Keep the historical read bound so recovery can inspect older journals.
        # New JSON documents must fit the parser's document bound.
        const project_document_limit: usize = 1048577.usize()

        # Return zero after durable publication, -17 if the destination exists,
        # or another negative status for invalid input or failed publication.
        def publish_file_exclusively(path: darray[u8]&, value: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            # Link the fsynced temporary into place so an existing destination can
            # never be replaced by a rename race. The temporary is removed after the
            # link, leaving one durable directory entry for the caller to own.
            return -22 if path.count > maximum_publication_path_bytes or not valid_path_bytes(path)
            temporary_path: mutable darray[u8] = []
            -5 if not stage_file_for_publication(path, value, &temporary_path) else linked_exclusively(path, temporary_path)

        def remove_known_file(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not valid_path_bytes(path)
            path_c: darray[u8] = with_null_terminator(path)
            remove_c_string_file((&path_c[0]).cast[cstr] can Unsafe.PointerCast)

        def valid_path_bytes(path: darray[u8]&) -> bool:
            return false if path.count == 0.usize() or path.count > 4096.usize()
            for index in 0..<path.count |path|:
                return false if path[index] == 0
            true

        # `path` followed by a NUL byte, for native calls that take C strings.
        def with_null_terminator(path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            terminated: mutable darray[u8] = [path[index] for index in 0..<path.count]
            terminated <- terminated.push(0)
            terminated

        def make_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return true if path.count == 0.usize()
            return false if not valid_path_bytes(path)
            work: mutable darray[u8] = []
            work <- with_null_terminator(path)
            for index in 1..<work.count |work, path|:
                continue if work[index] != 47
                work[index] <- 0
                valid: bool =
                    prefix: cstr = (&work[0]).cast[cstr] can Unsafe.PointerCast
                    created: i64 = Platform::make_directory(prefix, 493.u16())
                    Platform::synchronize_parent_directory(prefix) == 0 if created == 0 else Platform::is_directory(prefix) == 1
                work[index] <- 47
                return false if not valid
            final_directory_ready(work)

        def read_c_string_into(path_name: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if out.count == 0.usize() or out.count > 67108864.usize()
            # Reserve one extra byte so a file exactly at the caller's bound
            # remains distinguishable from an oversized file. Use the
            # descriptor reader directly so bounded project reads share one
            # implementation and do not allocate a stdio stream per call.
            loaded: i64 = |out|
                capacity: usize = out.count
                out.resize(capacity + 1.usize())
                read_count: i64 =
                    out_raw: mutable u8& = (&out[0]).cast[mutable u8&] can Unsafe.PointerCast
                    Platform::read_package_file(path_name, out_raw, out.count)
                -1 if read_count < 0 or read_count > capacity.i64() else read_count
            out.resize(0 if loaded < 0 else loaded.usize())
            loaded >= 0

        def write_file_descriptor_all(file_descriptor: i64, value: darray[u8]&) -> bool can[Unsafe.PointerCast, Console.Write]:
            while offset < value.count |value, offset: usize = 0.usize()|:
                wrote: i64 =
                    value_raw: void& = (&value[offset]).cast[void&] can Unsafe.PointerCast
                    Platform::write_file_descriptor(file_descriptor, value_raw, value.count - offset) can Console.Write
                # A native write must never report more bytes than requested.
                # Treat a malformed FFI result as a failed publication instead
                # of allowing the cursor conversion below to overrun the
                # caller's buffer or wrap an unsigned offset.
                return false if wrote <= 0 or wrote > (value.count - offset).i64()
                offset <- offset + wrote.usize()
            true

        def write_c_string_file(path_name: cstr, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            # mkstemp provides an exclusive 0600 temporary file; fsync and rename make
            # the lockfile transition atomic and prevent readers from seeing a prefix.
            path_length: usize = Platform::c_string_length(path_name)
            path_length > 0.usize() and path_length <= maximum_publication_path_bytes and replace_file(c_string_bytes(path_name), value)

        # Atomically replace the destination and sync its parent directory.
        def replace_file(path: darray[u8]&, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            temporary_path: mutable darray[u8] = []
            stage_file_for_publication(path, value, &temporary_path) and renamed_into_place(temporary_path, path) and sync_parent_directory(path)

        def sync_parent_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not valid_path_bytes(path)
            path_c: darray[u8] = with_null_terminator(path)
            Platform::synchronize_parent_directory((&path_c[0]).cast[cstr] can Unsafe.PointerCast) == 0

        def path_occupied(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return true if not valid_path_bytes(path)
            path_c: darray[u8] = with_null_terminator(path)
            # Treat anything except definite ENOENT as occupied. In
            # particular, symlinks and special files must not be mistaken for
            # an available destination just because the regular-file opener
            # refuses to read them.
            Platform::package_file_size((&path_c[0]).cast[cstr] can Unsafe.PointerCast) != -2

        def c_string_file_exists(path_name: cstr) -> bool:
            Platform::access_path(path_name, 0) == 0

        # A missing directory counts as removed.
        def remove_empty_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not valid_path_bytes(path)
            path_c: darray[u8] = with_null_terminator(path)
            removed_or_missing(Platform::remove_directory((&path_c[0]).cast[cstr] can Unsafe.PointerCast))

        # A missing file counts as removed; any other unreadable state fails.
        def remove_c_string_file(path_name: cstr) -> bool:
            state: i64 = Platform::package_file_size(path_name)
            true if state == -2 else false if state < 0 else Platform::unlink_path(path_name) == 0

        # `left`, a separating slash when it lacks one, then `right`.
        def path_join(left: darray[u8]&, right: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            joined: mutable darray[u8] = [left[index] for index in 0..<left.count]
            if joined.count > 0.usize() and joined[joined.count - 1.usize()] != 47:
                joined <- joined.push(47)
            ByteText::with_text(joined, right)

        # `left`, a separating slash when it lacks one, then the bytes of `right`.
        def path_join_bytes(left: darray[u8]&, right: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            joined: mutable darray[u8] = [left[index] for index in 0..<left.count]
            if joined.count > 0.usize() and joined[joined.count - 1.usize()] != 47:
                joined <- joined.push(47)
            ByteText::with_bytes(joined, right)

        # Read the project document `path_name` into `out`, up to `project_document_limit` bytes.
        def read_project_document(path_name: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(project_document_limit)
            read_c_string_into(path_name, out)

        def path_join_into(left: darray[u8]&, right: cstr, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            append_directory_prefix(left, out)
            ByteText::append_text(out, right)

        def path_join_bytes_into(left: darray[u8]&, right: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            append_directory_prefix(left, out)
            ByteText::append(out, right)

        def canonical_existing_path(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return false if not valid_path_bytes(path)
            path_c: darray[u8] = with_null_terminator(path)
            canonical_existing_c_string_path(((&path_c[0]).cast[cstr] can Unsafe.PointerCast), out)

        def canonical_existing_c_string_path(path: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            resolved: mutable darray[u8] = []
            resolved.resize(4096)
            copied_real_path(path, &resolved, out)

        # Compare normalized path bytes at a component boundary.
        def path_is_same_or_beneath(candidate: darray[u8]&, parent: darray[u8]&) -> bool:
            return false if parent.count == 0.usize() or not ByteText::starts_with(candidate, parent)
            return true if:
                candidate.count == parent.count
                parent.count == 1.usize() and parent[0] == 47
            candidate[parent.count] == 47

        # Resolve both paths and require the entry to be strictly beneath the root.
        def resolve_entry_beneath(root: darray[u8]&, entry: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            canonical_root: mutable darray[u8] = []
            false if not canonical_existing_path(root, &canonical_root) else resolve_entry_beneath_canonical_root(canonical_root, entry, out)

        def resolve_entry_beneath_canonical_root(canonical_root: darray[u8]&, entry: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            resolved_entry: mutable darray[u8] = []
            canonical_root.count > 0.usize() and canonical_root[0] == 47 and canonical_existing_path(entry, &resolved_entry) and resolved_entry.count > canonical_root.count and path_is_same_or_beneath(resolved_entry, canonical_root) and appended_bytes(out, resolved_entry)

        # Collapse "." and "name/.." segments of a relative path; a leading
        # ".." stays. False when nothing remains.
        def normalize_relative_path(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            while index <= path.count |path, out, index: usize = 0.usize(), segment_start: usize = 0.usize()|:
                if index == path.count or path[index] == 47:
                    append_normalized_segment(path, segment_start, index, out)
                    segment_start <- index + 1.usize()
                index <- index + 1.usize()
            out.count > 0.usize()

        # Whether a removal succeeded or found nothing to remove (ENOENT).
        def removed_or_missing(status: i64) -> bool:
            status == 0 or status == -2

    private:
        const maximum_publication_path_bytes: usize = 4084.usize()

        # Create and sync an exclusive sibling. The returned path includes its NUL terminator.
        def stage_file_for_publication(path: darray[u8]&, value: darray[u8]&, temporary_path: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            temporary_path.resize(0)
            return false if path.count > maximum_publication_path_bytes or not valid_path_bytes(path)
            template: mutable darray[u8] = temporary_template(path)
            file_descriptor: i64 = Platform::make_temporary_file(&template)
            file_descriptor >= 0 and written_and_closed(file_descriptor, value) and appended_bytes(temporary_path, template)

        # `path` with a mkstemp suffix and a NUL terminator.
        def temporary_template(path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            template: mutable darray[u8] = [path[item] for item in 0..<path.count]
            ByteText::append_text(&template, ".tmp.XXXXXX")
            template <- template.push(0)
            template

        # Write and sync `value`; the descriptor is closed either way.
        def written_and_closed(file_descriptor: i64, value: darray[u8]&) -> bool can[Unsafe.PointerCast, Console.Write]:
            durable: bool = write_file_descriptor_all(file_descriptor, value) and Platform::synchronize_file(file_descriptor) == 0
            Platform::close_file_descriptor(file_descriptor) == 0 and durable

        # Keep the exclusive temporary for recovery when the link fails.
        # Unlinking that pathname after the descriptor is closed could remove
        # a replacement installed by another actor.
        def linked_exclusively(path: darray[u8]&, temporary_path: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            link_status: i64 = hard_linked(temporary_path, path)
            link_status if link_status != 0 else retired_temporary(path, temporary_path)

        def hard_linked(temporary_path: darray[u8]&, path: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: darray[u8] = with_null_terminator(path)
            Platform::create_hard_link(((&temporary_path[0]).cast[cstr] can Unsafe.PointerCast), ((&path_c[0]).cast[cstr] can Unsafe.PointerCast))

        # The destination link is already published. Do not remove it by
        # pathname after a cleanup or durability failure: another actor may
        # have replaced that name meanwhile. Report the failure and leave the
        # published evidence for a later recovery pass.
        def retired_temporary(path: darray[u8]&, temporary_path: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            -5 if Platform::unlink_path((&temporary_path[0]).cast[cstr] can Unsafe.PointerCast) != 0 or not sync_parent_directory(path) else 0

        # Preserve the staged name if publication fails.
        def renamed_into_place(temporary_path: darray[u8]&, path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: darray[u8] = with_null_terminator(path)
            Platform::rename_path(((&temporary_path[0]).cast[cstr] can Unsafe.PointerCast), ((&path_c[0]).cast[cstr] can Unsafe.PointerCast)) == 0

        def final_directory_ready(work: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            final_path: cstr = (&work[0]).cast[cstr] can Unsafe.PointerCast
            created: i64 = Platform::make_directory(final_path, 493.u16())
            (Platform::synchronize_parent_directory(final_path) == 0 if created == 0 else Platform::is_directory(final_path) == 1) and Platform::is_directory(final_path) == 1

        def c_string_bytes(value: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            bytes: mutable darray[u8] = []
            ByteText::append_text(&bytes, value)
            bytes

        def appended_bytes(out: mutable darray[u8]&, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            ByteText::append(out, value)
            true

        def copied_real_path(path: cstr, resolved: mutable darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if Platform::resolve_real_path(path, resolved) is canonical:
                return copied_c_string(canonical, out)
            false

        def copied_c_string(value: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            length: usize = Platform::c_string_length(value)
            length > 0.usize() and length < 4096.usize() and appended_c_string(value, length, out)

        def appended_c_string(value: cstr, length: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            for index in 0..<length |out, value|:
                out.push(value[index].u8())
            true

        # Append one segment: skip empty and "." segments, resolve "..".
        def append_normalized_segment(path: darray[u8]&, start: usize, finish: usize, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            segment_length: usize = finish - start
            return if segment_length == 0.usize() or (segment_length == 1.usize() and path[start] == 46)
            if segment_length == 2.usize() and path[start] == 46 and path[start + 1.usize()] == 46:
                append_parent_segment(out)
            else:
                out.push(47) if out.count > 0.usize()
                ByteText::append_range(out, path, start, finish)

        # Remove the last component, or keep stacking ".." past the start.
        def append_parent_segment(out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            if out.count == 0.usize():
                ByteText::append_text(out, "..")
            else:
                apply_parent_segment(out, last_component_start(out))

        def apply_parent_segment(out: mutable darray[u8]&, last: usize) -> void can[Memory.Allocate, Abort.Panic]:
            if out.count - last == 2.usize() and out[last] == 46 and out[last + 1.usize()] == 46:
                ByteText::append_text(out, "/..")
            else:
                # `last` points to the component start; remove its preceding separator as well.
                out.resize(last - 1.usize() if last > 0.usize() and out[last - 1.usize()] == 47 else last)

        def last_component_start(out: darray[u8]&) -> usize:
            while last > 0.usize() and out[last - 1.usize()] != 47 |last: usize = out.count| -> last:
                last <- last - 1.usize()

        def append_directory_prefix(directory: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            ByteText::append(out, directory)
            if out.count > 0.usize() and out[out.count - 1.usize()] != 47:
                out.push(47)
