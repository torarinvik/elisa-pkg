# Direct fields accepted by manifests, lockfiles, and registry metadata.
include "../text/bytes.elisa"

module SchemaFields:
    public:
        const enum Kind of u8:
            ManifestPackage
            ManifestTarget
            RegistryLock
            RegistryLockRecord
            RegistryLockSource
            RegistryLockPackage
            ManifestPathDependency
            RegistryDependency
            RegistryRelease

        # The caller checks JSON syntax and duplicate keys before schema validation.
        def valid(raw: darray[u8]&, object_start: usize, object_end: usize, kind: Kind) -> bool:
            return false if object_start >= object_end or object_end >= raw.count or raw[object_start] != 123 or raw[object_end] != 125
            # Track strings and nesting so only the object's own keys are checked.
            for index in (object_start + 1.usize())..<object_end |in_string: bool = false, escaped: bool = false, string_start: usize = 0.usize(), braces: i64 = 1, brackets: i64 = 0, valid: bool = true| -> valid:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1.usize()
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    # A string followed by `:` at the top level is a key.
                    after: usize = Json::skip_whitespace(raw, index + 1.usize(), object_end)
                    in_string <- false
                    break false if braces == 1 and brackets == 0 and after < object_end and raw[after] == 58 and not allowed(kind, raw, string_start, index)

    private:
        def allowed(kind: Kind, raw: darray[u8]&, start: usize, finish: usize) -> bool:
            if kind == Kind.ManifestPackage:
                ByteText::range_equals_text(raw, start, finish, "name") or ByteText::range_equals_text(raw, start, finish, "version") or ByteText::range_equals_text(raw, start, finish, "description") or ByteText::range_equals_text(raw, start, finish, "license") or ByteText::range_equals_text(raw, start, finish, "elisa")
            elif kind == Kind.ManifestTarget:
                ByteText::range_equals_text(raw, start, finish, "name") or ByteText::range_equals_text(raw, start, finish, "kind") or ByteText::range_equals_text(raw, start, finish, "entry")
            elif kind == Kind.RegistryLock:
                ByteText::range_equals_text(raw, start, finish, "lock-version") or ByteText::range_equals_text(raw, start, finish, "resolver") or ByteText::range_equals_text(raw, start, finish, "package") or ByteText::range_equals_text(raw, start, finish, "packages")
            elif kind == Kind.RegistryLockRecord:
                ByteText::range_equals_text(raw, start, finish, "name") or ByteText::range_equals_text(raw, start, finish, "version") or ByteText::range_equals_text(raw, start, finish, "source") or ByteText::range_equals_text(raw, start, finish, "archive-size") or ByteText::range_equals_text(raw, start, finish, "archive-digest") or ByteText::range_equals_text(raw, start, finish, "metadata-digest")
            elif kind == Kind.RegistryLockSource:
                ByteText::range_equals_text(raw, start, finish, "type") or ByteText::range_equals_text(raw, start, finish, "registry") or ByteText::range_equals_text(raw, start, finish, "archive")
            elif kind == Kind.RegistryLockPackage:
                ByteText::range_equals_text(raw, start, finish, "name") or ByteText::range_equals_text(raw, start, finish, "version") or ByteText::range_equals_text(raw, start, finish, "manifest-digest") or ByteText::range_equals_text(raw, start, finish, "source-digest")
            elif kind == Kind.ManifestPathDependency:
                ByteText::range_equals_text(raw, start, finish, "path")
            elif kind == Kind.RegistryDependency:
                ByteText::range_equals_text(raw, start, finish, "registry") or ByteText::range_equals_text(raw, start, finish, "version")
            elif kind == Kind.RegistryRelease:
                ByteText::range_equals_text(raw, start, finish, "schema-version") or ByteText::range_equals_text(raw, start, finish, "algorithm") or ByteText::range_equals_text(raw, start, finish, "registry") or ByteText::range_equals_text(raw, start, finish, "package") or ByteText::range_equals_text(raw, start, finish, "version") or ByteText::range_equals_text(raw, start, finish, "archive") or ByteText::range_equals_text(raw, start, finish, "archive-size") or ByteText::range_equals_text(raw, start, finish, "archive-digest") or ByteText::range_equals_text(raw, start, finish, "expires") or ByteText::range_equals_text(raw, start, finish, "dependencies")
            else:
                false
