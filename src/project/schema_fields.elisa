# Direct fields accepted by manifests, lockfiles, and registry metadata.
include "../text/bytes.elisa"

module SchemaFields:
    public:
        const enum Kind of u8:
            ManifestPackage
            ManifestTarget
            RegistryLock
            RegistryLockRecord
            RegistryLockSource
            RegistryLockPackage
            ManifestPathDependency
            RegistryDependency
            RegistryRelease

        # The caller checks JSON syntax and duplicate keys before schema validation.
        def valid(raw: darray[u8]&, object_start: usize, object_end: usize, kind: Kind) -> bool:
            return false if object_start >= object_end or object_end >= raw.count or raw[object_start] != 123 or raw[object_end] != 125
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0.usize()
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (object_start + 1.usize())..<object_end |raw, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1.usize()
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1.usize()
                    while after < object_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                        after <- after + 1.usize()
                    if braces == 1 and brackets == 0 and after < object_end and raw[after] == 58:
                        return false if not allowed(kind, raw, string_start, index)
                    in_string <- false
            return true

    private:
        def allowed(kind: Kind, raw: darray[u8]&, start: usize, finish: usize) -> bool:
            if kind == Kind.ManifestPackage:
                return ByteText::range_equals_text(raw, start, finish, "name") or ByteText::range_equals_text(raw, start, finish, "version") or ByteText::range_equals_text(raw, start, finish, "description") or ByteText::range_equals_text(raw, start, finish, "license") or ByteText::range_equals_text(raw, start, finish, "elisa")
            if kind == Kind.ManifestTarget:
                return ByteText::range_equals_text(raw, start, finish, "name") or ByteText::range_equals_text(raw, start, finish, "kind") or ByteText::range_equals_text(raw, start, finish, "entry")
            if kind == Kind.RegistryLock:
                return ByteText::range_equals_text(raw, start, finish, "lock-version") or ByteText::range_equals_text(raw, start, finish, "resolver") or ByteText::range_equals_text(raw, start, finish, "package") or ByteText::range_equals_text(raw, start, finish, "packages")
            if kind == Kind.RegistryLockRecord:
                return ByteText::range_equals_text(raw, start, finish, "name") or ByteText::range_equals_text(raw, start, finish, "version") or ByteText::range_equals_text(raw, start, finish, "source") or ByteText::range_equals_text(raw, start, finish, "archive-size") or ByteText::range_equals_text(raw, start, finish, "archive-digest") or ByteText::range_equals_text(raw, start, finish, "metadata-digest")
            if kind == Kind.RegistryLockSource:
                return ByteText::range_equals_text(raw, start, finish, "type") or ByteText::range_equals_text(raw, start, finish, "registry") or ByteText::range_equals_text(raw, start, finish, "archive")
            if kind == Kind.RegistryLockPackage:
                return ByteText::range_equals_text(raw, start, finish, "name") or ByteText::range_equals_text(raw, start, finish, "version") or ByteText::range_equals_text(raw, start, finish, "manifest-digest") or ByteText::range_equals_text(raw, start, finish, "source-digest")
            if kind == Kind.ManifestPathDependency:
                return ByteText::range_equals_text(raw, start, finish, "path")
            if kind == Kind.RegistryDependency:
                return ByteText::range_equals_text(raw, start, finish, "registry") or ByteText::range_equals_text(raw, start, finish, "version")
            if kind == Kind.RegistryRelease:
                return ByteText::range_equals_text(raw, start, finish, "schema-version") or ByteText::range_equals_text(raw, start, finish, "algorithm") or ByteText::range_equals_text(raw, start, finish, "registry") or ByteText::range_equals_text(raw, start, finish, "package") or ByteText::range_equals_text(raw, start, finish, "version") or ByteText::range_equals_text(raw, start, finish, "archive") or ByteText::range_equals_text(raw, start, finish, "archive-size") or ByteText::range_equals_text(raw, start, finish, "archive-digest") or ByteText::range_equals_text(raw, start, finish, "expires") or ByteText::range_equals_text(raw, start, finish, "dependencies")
            return false
