# Build a deterministic lockfile for the transitive local dependency graph.
include "../integrity.elisa"
include "../json.elisa"
include "../package/manifest.elisa"
include "../package/dependency_entry.elisa"
include "../package/package_identity.elisa"
include "../platform.elisa"
include "../resolution/dependency_graph.elisa"
include "../source/fingerprint.elisa"
include "../text/bytes.elisa"
include "./files.elisa"
include "./local_build_plan.elisa"
include "./lockfile.elisa"
include "./manifest.elisa"

module LocalLock:
    public:
        def canonical(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out: mutable darray[u8] = []
            graph_source_bytes: mutable usize = 0.usize()
            region root_digest_scope:
                root_digest: mutable darray[u8] = []
                root_source_digest: mutable darray[u8] = []
                return [] if:
                    not Integrity::sha256_hex(raw, &root_digest)
                    not SourceFingerprint::at_bounded(root, &root_source_digest, SourceFingerprint::maximum_snapshot_bytes, &graph_source_bytes)
                Lockfile::append_header(&out, Lockfile::Format.Local, name, version, root_digest, root_source_digest)
            queue: mutable darray[u8] = []
            record_starts: mutable darray[usize] = []
            sorted_records: mutable darray[usize] = []
            edges: mutable darray[usize] = []
            edge_count: mutable usize = 0.usize()
            total: mutable usize = 0.usize()
            return [] if not append_local_dependency_records(raw, root, &queue, &record_starts, &sorted_records, &edges, &edge_count, &total, 18446744073709551615.usize())
            if total == 0.usize():
                ByteText::append_text(&out, "]\n}\n")
                return out
            traversed_manifest_digests: mutable darray[u8] = []
            return [] if not traverse_dependencies(name, &queue, &record_starts, &sorted_records, &edges, &edge_count, &total, &traversed_manifest_digests)
            return [] if sorted_records.count != total
            if append_sorted_records(queue, record_starts, sorted_records, total, traversed_manifest_digests, graph_source_bytes, out) is body:
                out <- body
            else:
                return []
            Lockfile::append_footer(&out)
            return out

    private:
        # Breadth-first traversal of the local dependency graph. Each queued
        # package's manifest must name the queued package and version; its
        # own local dependencies join the queue. The graph must be acyclic.
        def traverse_dependencies(name: darray[u8]&, queue: mutable darray[u8]&, record_starts: mutable darray[usize]&, sorted_records: mutable darray[usize]&, edges: mutable darray[usize]&, edge_count: mutable usize&, total: mutable usize&, traversed_manifest_digests: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            edge_offsets: mutable darray[usize] = []
            edge_offsets <- edge_offsets.push(0.usize())
            processed: mutable usize = 0.usize()
            while processed < total |edge_offsets, processed|:
                package_root: mutable darray[u8] = []
                child_raw: mutable darray[u8] = []
                return false if:
                    not read_queued_manifest(name, queue, record_starts, processed, &package_root, &child_raw)
                    not append_local_dependency_records(child_raw, &package_root, queue, record_starts, sorted_records, edges, edge_count, total, processed)
                region digest_scope:
                    digest: mutable darray[u8] = []
                    return false if Integrity::sha256(child_raw, &digest) != Integrity::DigestCode.Ok
                    ByteText::append(traversed_manifest_digests, digest)
                processed <- processed + 1.usize()
                edge_offsets <- edge_offsets.push(edges.count)
            return DependencyGraph::is_acyclic(total, edges, edge_offsets)

        # Read the manifest of queued package `processed`. It must not be the
        # root package and must name the queued package and version.
        def read_queued_manifest(name: darray[u8]&, queue: darray[u8]&, record_starts: darray[usize]&, processed: usize, package_root: mutable darray[u8]&, child_raw: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not queue_field_at(queue, record_starts, processed, 0, package_root)
            manifest_path: mutable darray[u8] = []
            ProjectFiles::path_join_into(package_root, "elisapkg.json", &manifest_path)
            return false if not Platform::read_bounded_file(manifest_path, Json::maximum_document_bytes, child_raw)
            child_name: mutable darray[u8] = []
            child_version: mutable darray[u8] = []
            return false if not ProjectManifest::validate_at(child_raw, package_root, &child_name, &child_version) or ByteText::equal(child_name, name)
            queued_name: mutable darray[u8] = []
            queued_version: mutable darray[u8] = []
            return queue_field_at(queue, record_starts, processed, 1, &queued_name) and queue_field_at(queue, record_starts, processed, 2, &queued_version) and ByteText::equal(queued_name, child_name) and ByteText::equal(queued_version, child_version)

        # Append one dependency record per package in name order, binding each
        # to its source digest and to the manifest digest seen in traversal.
        def append_sorted_records(queue: darray[u8]&, record_starts: darray[usize]&, sorted_records: darray[usize]&, total: usize, traversed_manifest_digests: darray[u8]&, root_source_bytes: usize, body: mutable darray[u8]) -> darray[u8]? can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            graph_source_bytes: mutable usize = root_source_bytes
            for sorted_position in 0..<total |body, graph_source_bytes|:
                record: darray[u8] = sorted_record(queue, record_starts, sorted_records[sorted_position], traversed_manifest_digests, &graph_source_bytes)
                return null if record.count == 0.usize()
                body <- body.push(44) if sorted_position > 0.usize()
                for index in 0..<record.count |body, record|:
                    body <- body.push(record[index])
                # Reserve seven bytes for the closing array, object, and line endings.
                return null if body.count > Lockfile::maximum_body_bytes
            return body

        # Render the dependency record of queue record `selected`, adding its
        # source size to the bounded `graph_source_bytes` total. Returns an
        # empty array when the record cannot be verified.
        def sorted_record(queue: darray[u8]&, record_starts: darray[usize]&, selected: usize, traversed_manifest_digests: darray[u8]&, graph_source_bytes: mutable usize&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return [] if selected >= record_starts.count
            selected_name: mutable darray[u8] = []
            selected_path: mutable darray[u8] = []
            selected_version: mutable darray[u8] = []
            return [] if not queue_field_at(queue, record_starts, selected, 0, &selected_path) or not queue_field_at(queue, record_starts, selected, 1, &selected_name) or not queue_field_at(queue, record_starts, selected, 2, &selected_version)
            selected_source_digest: mutable darray[u8] = []
            region selected_source_bytes_scope:
                selected_source_bytes: mutable usize = 0.usize()
                return [] if graph_source_bytes > SourceFingerprint::maximum_snapshot_bytes or not SourceFingerprint::at_bounded(selected_path, &selected_source_digest, SourceFingerprint::maximum_snapshot_bytes - graph_source_bytes, &selected_source_bytes)
                graph_source_bytes <- graph_source_bytes + selected_source_bytes
            selected_digest: mutable darray[u8] = []
            selected_manifest_path: mutable darray[u8] = []
            ProjectFiles::path_join_into(&selected_path, "elisapkg.json", &selected_manifest_path)
            selected_manifest: mutable darray[u8] = []
            return [] if not Platform::read_bounded_file(selected_manifest_path, Json::maximum_document_bytes, &selected_manifest)
            return [] if not verified_manifest_digest(selected_manifest, traversed_manifest_digests, selected, &selected_digest)
            record: dstr = dependency_record(selected_name, selected_version, selected_path, selected_digest, selected_source_digest)
            return [record[index].u8() for index in 0..<record.count]

        def dependency_record(name: darray[u8]&, version: darray[u8]&, path: darray[u8]&, manifest_digest: darray[u8]&, source_digest: darray[u8]&) -> dstr can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            requires name.count > 0 and version.count > 0 and path.count > 0 and manifest_digest.count > 0 and source_digest.count > 0
            name_text: sview = sview((&name[0]).cast[cstr], 0, name.count)
            version_text: sview = sview((&version[0]).cast[cstr], 0, version.count)
            path_text: sview = sview((&path[0]).cast[cstr], 0, path.count)
            manifest_hex: sview = sview((&manifest_digest[0]).cast[cstr], 0, manifest_digest.count)
            source_hex: sview = sview((&source_digest[0]).cast[cstr], 0, source_digest.count)
            return f"\n    {{\"name\":\"{name_text}\",\"version\":\"{version_text}\",\"source\":{{\"type\":\"path\",\"path\":\"{path_text}\"}},\"manifest-digest\":\"sha256:{manifest_hex}\",\"source-digest\":\"sha256:{source_hex}\"}}"

        # Bind the emitted digest to the manifest used to traverse dependency edges.
        def verified_manifest_digest(manifest: darray[u8]&, traversed_digests: darray[u8]&, record_index: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            digest_width: usize = 32.usize()
            return false if record_index >= traversed_digests.count / digest_width
            digest_start: usize = record_index * digest_width
            digest: mutable darray[u8] = []
            return false if:
                Integrity::sha256(manifest, &digest) != Integrity::DigestCode.Ok
                not ByteText::range_equals(traversed_digests, digest_start, digest_start + digest_width, digest)
            return Integrity::hex_digest(digest, out)

        def queue_append_field(queue: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |queue, value|:
                queue.push(value[index])
            queue.push(0)

        def queue_append_record(queue: mutable darray[u8]&, record_starts: mutable darray[usize]&, path: darray[u8]&, name: darray[u8]&, version: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            record_starts.push(queue.count)
            queue_append_field(queue, path)
            queue_append_field(queue, name)
            queue_append_field(queue, version)

        def queue_field_at(queue: darray[u8]&, record_starts: darray[usize]&, record: usize, field: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if record >= record_starts.count or field >= 3.usize()
            region cursor_scope:
                cursor: mutable usize = record_starts[record]
                for current_field in 0..<3 |queue, record_starts, record, field, current_field, cursor, out|:
                    return false if cursor >= queue.count
                    end: mutable usize = cursor
                    while end < queue.count and queue[end] != 0 |queue, end|:
                        end <- end + 1.usize()
                    return false if end >= queue.count
                    if current_field == field:
                        ByteText::append_range(out, queue, cursor, end)
                        return true
                    cursor <- end + 1.usize()
            return false

        def queue_name_record(queue: darray[u8]&, record_starts: darray[usize]&, sorted_records: darray[usize]&, total: usize, wanted: darray[u8]&, insertion_out: mutable usize&) -> usize can[Memory.Allocate, Abort.Panic]:
            insertion_out <- total + 1.usize()
            return total if sorted_records.count != total
            lower: mutable usize = 0.usize()
            region upper_scope:
                upper: mutable usize = sorted_records.count
                while lower < upper |queue, record_starts, sorted_records, wanted, lower, upper|:
                    middle: usize = lower + (upper - lower) / 2.usize()
                    record: usize = sorted_records[middle]
                    return total if record >= record_starts.count
                    candidate: mutable darray[u8] = []
                    if not queue_field_at(queue, record_starts, record, 1, &candidate):
                        return total
                    if ByteText::less(candidate, wanted):
                        lower <- middle + 1.usize()
                    else:
                        upper <- middle
            insertion_out <- lower
            return total if lower >= sorted_records.count
            record: usize = sorted_records[lower]
            if record >= record_starts.count:
                insertion_out <- total + 1.usize()
                return total
            candidate: mutable darray[u8] = []
            if not queue_field_at(queue, record_starts, record, 1, &candidate):
                insertion_out <- total + 1.usize()
                return total
            return record if ByteText::equal(candidate, wanted)
            return total

        # Queue record `record` has package root `path` and `version`.
        def queued_record_matches(queue: darray[u8]&, record_starts: darray[usize]&, record: usize, path: darray[u8]&, version: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            queued_path: mutable darray[u8] = []
            queued_version: mutable darray[u8] = []
            return queue_field_at(queue, record_starts, record, 0, &queued_path) and queue_field_at(queue, record_starts, record, 2, &queued_version) and ByteText::equal(queued_path, path) and ByteText::equal(queued_version, version)

        def queue_insert_sorted_record(sorted_records: mutable darray[usize]&, insertion: usize, record: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if insertion > sorted_records.count
            previous_count: usize = sorted_records.count
            sorted_records.resize(previous_count + 1.usize())
            region cursor_scope:
                cursor: mutable usize = previous_count
                while cursor > insertion |sorted_records, cursor|:
                    sorted_records[cursor] <- sorted_records[cursor - 1.usize()]
                    cursor <- cursor - 1.usize()
            sorted_records[insertion] <- record
            return true

        def append_local_dependency_records(raw: darray[u8]&, package_root: darray[u8]&, queue: mutable darray[u8]&, record_starts: mutable darray[usize]&, sorted_records: mutable darray[usize]&, edges: mutable darray[usize]&, edge_count: mutable usize&, total: mutable usize&, parent: usize) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            dependency_start: usize = Json::root_value_offset(raw, "dependencies")
            return true if dependency_start >= raw.count
            dependency_end: usize = Json::object_end(raw, dependency_start)
            return false if dependency_end <= dependency_start or dependency_end >= raw.count or raw[dependency_start] != 123
            cursor: mutable usize = Json::skip_whitespace(raw, dependency_start + 1.usize(), dependency_end)
            return true if cursor == dependency_end
            while cursor < dependency_end:
                entry: mutable DependencyEntry::Span = DependencyEntry::Span{name_start: 0, name_end: 0, object_start: 0, object_end: 0}
                return false if:
                    edge_count >= LocalBuildPlan::maximum_edges
                    not DependencyEntry::read(raw, cursor, dependency_end, &entry)
                edge_count <- edge_count + 1.usize()
                cursor <- DependencyEntry::next_start(raw, entry.object_end, dependency_end)
                return false if cursor > dependency_end
                child_root: mutable darray[u8] = []
                return false if not dependency_root(raw, entry, package_root, &child_root)
                child_name: mutable darray[u8] = []
                child_version: mutable darray[u8] = []
                return false if not:
                    ProjectManifest::load_at(&child_root, &child_name, &child_version)
                    ByteText::range_equals(raw, entry.name_start, entry.name_end, child_name)
                insertion: mutable usize = 0.usize()
                existing: usize = queue_name_record(queue, record_starts, sorted_records, total, child_name, &insertion)
                return false if insertion > sorted_records.count
                if existing < total:
                    return false if not queued_record_matches(queue, record_starts, existing, child_root, child_version)
                    edges.push(existing) if parent < total
                    continue
                return false if total >= 4096.usize()
                queue_append_record(queue, record_starts, &child_root, child_name, child_version)
                return false if not queue_insert_sorted_record(sorted_records, insertion, total)
                edges.push(total) if parent < total
                total <- total + 1.usize()
            return true

        # Resolve the `path` of one dependency entry against `package_root`
        # into a normalized relative package root.
        def dependency_root(raw: darray[u8]&, entry: DependencyEntry::Span&, package_root: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            dependency_path: mutable darray[u8] = []
            return false if not:
                Json::object_string_value(raw, entry.object_start, entry.object_end, "path", &dependency_path)
                Manifest::valid_dependency_path(dependency_path)
            parent_root: darray[u8] = [] if package_root.count == 0.usize() or (package_root.count == 1.usize() and package_root[0] == 46) else [package_root[index] for index in 0..<package_root.count]
            joined_root: mutable darray[u8] = []
            region terminated_path_scope:
                terminated_path: darray[u8] = ProjectFiles::with_null_terminator(&dependency_path)
                ProjectFiles::path_join_into(&parent_root, ((&terminated_path[0]).cast[cstr] can Unsafe.PointerCast), &joined_root)
            return ProjectFiles::normalize_relative_path(&joined_root, out)
