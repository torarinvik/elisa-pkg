# Serialized manifest and lockfile edits with a durable recovery journal.
include "./files.elisa"
include "../json.elisa"

module ProjectTransaction:
    private:
        const kernel_lock_path: cstr = ".elisapkg/transaction.flock"
        const guard_path: cstr = ".elisapkg/transaction.guard"
        const original_lock_path: cstr = ".elisapkg/transaction.lock"
        const original_manifest_path: cstr = ".elisapkg/transaction.manifest"
        const staged_lock_path: cstr = ".elisapkg/transaction.new-lock"
        const staged_missing_lock_path: cstr = ".elisapkg/transaction.new-lock-missing"
        const staged_manifest_path: cstr = ".elisapkg/transaction.new-manifest"
        const phase_path: cstr = ".elisapkg/transaction.state"
        const live_manifest_path: cstr = "elisapkg.json"
        const live_lock_path: cstr = "elisapkg.lock"

        # Serialized phase names are part of the on-disk journal format.
        const prepared_with_lock: cstr = "prepared-lock\n"
        const prepared_without_lock: cstr = "prepared-no-lock\n"
        const manifest_pending: cstr = "manifest-pending\n"
        const legacy_manifest_replaced: cstr = "manifest-replaced\n"
        const committed: cstr = "complete\n"
        const rolled_back: cstr = "restored\n"

        # One descriptor holds the project-local transaction flock across the
        # entire manifest/lock update and its recovery or cleanup.
        global mutable transaction_lock_file_descriptor: i64 = -1

        def transaction_lock_acquire() -> bool can[Global{Read,Write}, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return false if transaction_lock_file_descriptor >= 0
                file_descriptor: i64 = Platform::acquire_project_transaction_lock(kernel_lock_path)
                return false if file_descriptor < 0
                transaction_lock_file_descriptor <- file_descriptor
                return true

        def transaction_lock_release() -> bool can[Global{Read,Write}]:
            can Global{Read,Write}:
                return true if transaction_lock_file_descriptor < 0
                file_descriptor: i64 = transaction_lock_file_descriptor
                transaction_lock_file_descriptor <- -1
                return Platform::close_file_descriptor(file_descriptor) == 0

        def transaction_abort_begin(guard: darray[u8]&) -> bool can[Global{Read,Write}, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                removed: bool = ProjectFiles::remove_empty_directory(guard)
                released: bool = transaction_lock_release()
                return removed and released

        def transaction_guard_state() -> i64:
            # The transaction guard is intentionally a directory. The regular
            # file size helper returns -21 for directories, so verify that case
            # with the no-follow directory opener instead of treating every
            # negative result as an absent guard.
            region state_scope:
                state: i64 = Platform::package_file_size(guard_path)
                return 0 if state == -2
                return -1 if state >= 0 or state != -21
            return 1 if Platform::is_directory(guard_path) == 1
            return -1

        def invalid_journal_file(size_result: i64) -> bool:
            return size_result < 0 and size_result != -2

        def transaction_cleanup() -> bool can[Global{Read,Write}]:
            can Global{Read,Write}:
                cleaned: bool = remove_transaction_files()
                released: bool = transaction_lock_release()
                return cleaned and released

        def remove_transaction_files() -> bool:
            return false if not:
                ProjectFiles::remove_c_string_file(original_manifest_path)
                ProjectFiles::remove_c_string_file(original_lock_path)
                ProjectFiles::remove_c_string_file(staged_manifest_path)
                ProjectFiles::remove_c_string_file(staged_lock_path)
                ProjectFiles::remove_c_string_file(staged_missing_lock_path)
            region guard_scope:
                guard: mutable darray[u8] = []
                ByteText::append_text(&guard, guard_path)
                return false if not ProjectFiles::remove_empty_directory(&guard)
            return ProjectFiles::remove_c_string_file(phase_path)

        def live_file_matches(expected_path: cstr, live_path: cstr) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            expected: mutable darray[u8] = []
            expected <- expected.resize(ProjectFiles::project_document_limit)
            live: mutable darray[u8] = []
            live <- live.resize(ProjectFiles::project_document_limit)
            return false if not:
                ProjectFiles::read_c_string_into(expected_path, &expected)
                ProjectFiles::read_c_string_into(live_path, &live)
            return ByteText::equal(expected, live)

        def has_manifest_intent(state: darray[u8]&) -> bool:
            return ByteText::equal_text(state, manifest_pending) or ByteText::equal_text(state, legacy_manifest_replaced)

        def published_manifest_matches_journal() -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            region state_scope:
                state: mutable darray[u8] = []
                state <- state.resize(128)
                return false if not ProjectFiles::read_c_string_into(phase_path, &state)
                if ByteText::equal_text(state, prepared_with_lock) or ByteText::equal_text(state, prepared_without_lock):
                    return live_file_matches(original_manifest_path, live_manifest_path)
                if has_manifest_intent(state):
                    return live_file_matches(staged_manifest_path, live_manifest_path)
            return false

        def report_recovery_error(message: cstr) -> void can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            bytes: mutable darray[u8] = []
            ByteText::append_text(&bytes, message)
            _ = ProjectFiles::write_file_descriptor_all(2, &bytes)

    public:
        const enum LockPublication of u8:
            Published = 0
            JournalFailed = 1
            WriteFailed = 2

        def begin_with_lock(original_manifest: darray[u8]&, expected_lock_state: i64, expected_lock: darray[u8]&) -> bool can[Global{Read,Write}, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global{Read,Write}:
                # Preserve legacy guards before opening a lock file that would
                # change how recovery classifies them.
                return false if transaction_guard_state() != 0
                region state_root_scope:
                    state_root: mutable darray[u8] = []
                    ByteText::append_text(&state_root, ".elisapkg")
                    return false if not:
                        ProjectFiles::make_directory(&state_root)
                        transaction_lock_acquire()
                region journal_exists_scope:
                    journal_exists: bool =
                        Platform::package_file_size(phase_path) != -2 or
                        Platform::package_file_size(original_manifest_path) != -2 or
                        Platform::package_file_size(original_lock_path) != -2 or
                        Platform::package_file_size(staged_manifest_path) != -2 or
                        Platform::package_file_size(staged_lock_path) != -2 or
                        Platform::package_file_size(staged_missing_lock_path) != -2
                    if journal_exists:
                        _ = transaction_lock_release()
                        return false
                guard: mutable darray[u8] = []
                ByteText::append_text(&guard, guard_path)
                if Platform::make_directory(guard_path, 448.u16()) != 0:
                    _ = transaction_lock_release()
                    return false
                if not live_files_match(original_manifest, expected_lock_state, expected_lock):
                    _ = transaction_abort_begin(guard)
                    return false
                if not ProjectFiles::write_c_string_file(original_manifest_path, original_manifest):
                    _ = transaction_cleanup()
                    return false
                if not record_prepared_state():
                    _ = transaction_cleanup()
                    return false
                return true

        def begin(original_manifest: darray[u8]&) -> bool can[Global{Read,Write}, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global{Read,Write}:
                no_expected_lock: mutable darray[u8] = []
                return begin_with_lock(original_manifest, -3, no_expected_lock)

        def publish_manifest(new_manifest: darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            # Persist the exact intended content and publish a recovery phase
            # before replacing the live manifest. Recovery can then distinguish
            # the old, new, and externally edited states even across a crash at
            # either atomic rename boundary.
            can Global.Read:
                return false if transaction_lock_file_descriptor < 0
            if new_manifest.count > Json::maximum_document_bytes:
                report_recovery_error("error: manifest replacement exceeds the project document size limit\n")
                return false
            if not valid_replacement_document(new_manifest):
                report_recovery_error("error: manifest replacement must be a valid JSON object with unique keys\n")
                return false
            if Platform::package_file_size(staged_manifest_path) != -2:
                report_recovery_error("error: a manifest replacement is already staged or its journal entry is unreadable\n")
                return false
            if not live_file_matches(original_manifest_path, live_manifest_path):
                report_recovery_error("error: manifest changed before transaction publication\n")
                return false
            return false if not ProjectFiles::write_c_string_file(staged_manifest_path, new_manifest)
            region state_scope:
                state: mutable darray[u8] = []
                ByteText::append_text(&state, manifest_pending)
                return false if not ProjectFiles::write_c_string_file(phase_path, &state)
            return ProjectFiles::write_c_string_file(live_manifest_path, new_manifest)

        def publish_lock(new_lock: darray[u8]&) -> LockPublication can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            # Record the intended bytes before replacing the live lockfile so
            # recovery can distinguish publication from an external edit.
            can Global.Read:
                return LockPublication.JournalFailed if transaction_lock_file_descriptor < 0
            if new_lock.count > Json::maximum_document_bytes:
                report_recovery_error("error: lockfile replacement exceeds the project document size limit\n")
                return LockPublication.WriteFailed
            if not valid_replacement_document(new_lock):
                report_recovery_error("error: lockfile replacement must be a valid JSON object with unique keys\n")
                return LockPublication.WriteFailed
            if Platform::package_file_size(staged_lock_path) != -2 or Platform::package_file_size(staged_missing_lock_path) != -2:
                report_recovery_error("error: a lockfile replacement is already staged or its journal entry is unreadable\n")
                return LockPublication.JournalFailed
            original_size: i64 = Platform::package_file_size(original_lock_path)
            region original_matches_scope:
                original_matches: bool = Platform::package_file_size(live_lock_path) == -2 if original_size == -2 else live_file_matches(original_lock_path, live_lock_path)
                if not original_matches:
                    report_recovery_error("error: lockfile changed before transaction publication\n")
                    return LockPublication.JournalFailed
            return LockPublication.JournalFailed if not ProjectFiles::write_c_string_file(staged_lock_path, new_lock)
            return LockPublication.Published if ProjectFiles::write_c_string_file(live_lock_path, new_lock) else LockPublication.WriteFailed

        def restore() -> bool can[Global{Read,Write}, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global{Read,Write}:
                return false if transaction_lock_file_descriptor < 0
                restored: bool = restore_journal()
                released: bool = transaction_lock_release()
                return restored and released

    private:
        def valid_replacement_document(document: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not Json::valid_document(document)
            start: usize = Json::root_start(document)
            return start < document.count and document[start] == 123 and Json::unique_object_keys(document)

        def restore_journal() -> bool can[Global{Read,Write}, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global{Read,Write}:
                state: mutable darray[u8] = []
                state <- state.resize(128)
                return false if not ProjectFiles::read_c_string_into(phase_path, &state)
                region recognized_scope:
                    recognized: bool = ByteText::equal_text(state, prepared_with_lock) or ByteText::equal_text(state, prepared_without_lock) or has_manifest_intent(state)
                    if not recognized:
                        report_recovery_error("error: unrecognized project transaction state; preserve .elisapkg/transaction.* for recovery\n")
                        return false
                original_manifest: mutable darray[u8] = []
                current_manifest: mutable darray[u8] = []
                return false if not read_document(original_manifest_path, &original_manifest) or not read_document(live_manifest_path, &current_manifest)
                manifest_is_original: bool = ByteText::equal(current_manifest, original_manifest)
                return false if not manifest_edit_expected(state, manifest_is_original, current_manifest)
                original_lock_present: mutable bool = false
                return false if not file_present(original_lock_path, &original_lock_present)
                if ByteText::equal_text(state, prepared_with_lock) and not original_lock_present:
                    report_recovery_error("error: transaction recovery is missing the original lockfile backup; recovery files were retained\n")
                    return false
                if ByteText::equal_text(state, prepared_without_lock) and original_lock_present:
                    report_recovery_error("error: transaction recovery found an unexpected lockfile backup; recovery files were retained\n")
                    return false
                original_lock: mutable darray[u8] = []
                return false if original_lock_present and not read_document(original_lock_path, &original_lock)
                lock_is_original: mutable bool = false
                return false if not classify_live_lock(original_lock_present, original_lock, &lock_is_original)
                return false if not manifest_is_original and not ProjectFiles::write_c_string_file(live_manifest_path, &original_manifest)
                if not lock_is_original:
                    if original_lock_present:
                        return false if not ProjectFiles::write_c_string_file(live_lock_path, &original_lock)
                    else:
                        return false if not ProjectFiles::remove_c_string_file(live_lock_path)
                region restored_state_scope:
                    restored_state: mutable darray[u8] = []
                    ByteText::append_text(&restored_state, rolled_back)
                    return false if not ProjectFiles::write_c_string_file(phase_path, &restored_state)
                return remove_transaction_files()

        # The caller prepared its edit before taking the guard. Another
        # transaction may have committed in that interval, so compare the live
        # manifest and lock again while holding the exclusive guard instead of
        # overwriting a newer dependency edit from a stale snapshot. An
        # expected lock state of -3 skips the lock comparison.
        def live_files_match(original_manifest: darray[u8]&, expected_lock_state: i64, expected_lock: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            region current_manifest_scope:
                current_manifest: mutable darray[u8] = []
                return false if not read_document(live_manifest_path, &current_manifest) or not ByteText::equal(current_manifest, original_manifest)
            return true if expected_lock_state == -3
            current_lock_state: i64 = Platform::package_file_size(live_lock_path)
            return false if current_lock_state != expected_lock_state
            return true if current_lock_state < 0
            current_lock: mutable darray[u8] = []
            return read_document(live_lock_path, &current_lock) and ByteText::equal(current_lock, expected_lock)

        # Back up the live lock, when present, and record which prepared
        # state recovery should expect.
        def record_prepared_state() -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            state: mutable darray[u8] = []
            lock_state: i64 = Platform::package_file_size(live_lock_path)
            if lock_state >= 0:
                region original_lock_scope:
                    original_lock: mutable darray[u8] = []
                    return false if not read_document(live_lock_path, &original_lock) or not ProjectFiles::write_c_string_file(original_lock_path, &original_lock)
                ByteText::append_text(&state, prepared_with_lock)
            elif lock_state == -2:
                ByteText::append_text(&state, prepared_without_lock)
            else:
                return false
            return ProjectFiles::write_c_string_file(phase_path, &state)

        def read_document(path: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(ProjectFiles::project_document_limit)
            return ProjectFiles::read_c_string_into(path, out)

        # Whether a regular file exists at `path`. Returns false when its
        # state cannot be determined.
        def file_present(path: cstr, present: mutable bool&) -> bool can[Unsafe.PointerCast]:
            file_state: i64 = Platform::package_file_size(path)
            return false if file_state < 0 and file_state != -2
            present <- file_state >= 0
            return true

        # A live manifest may differ from the original only when the journal
        # records a manifest intent and the live file is the staged one.
        def manifest_edit_expected(state: darray[u8]&, manifest_is_original: bool, current_manifest: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return true if manifest_is_original
            if has_manifest_intent(state):
                new_manifest: mutable darray[u8] = []
                return false if not read_document(staged_manifest_path, &new_manifest)
                return true if ByteText::equal(current_manifest, new_manifest)
            report_recovery_error("error: transaction recovery found an external manifest edit; recovery files were retained\n")
            return false

        # Decide whether the live lockfile is still the original. A live lock
        # that is neither the original nor the staged replacement, or a
        # missing lock the transaction did not intend, is an external edit.
        def classify_live_lock(original_lock_present: bool, original_lock: darray[u8]&, lock_is_original: mutable bool&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            current_lock_present: mutable bool = false
            return false if not file_present(live_lock_path, &current_lock_present)
            new_lock_state: i64 = Platform::package_file_size(staged_lock_path)
            return false if new_lock_state < 0 and new_lock_state != -2
            new_lock_missing_state: i64 = Platform::package_file_size(staged_missing_lock_path)
            return false if:
                new_lock_missing_state < 0 and new_lock_missing_state != -2
                new_lock_state >= 0 and new_lock_missing_state >= 0
            if new_lock_missing_state >= 0:
                missing_lock_marker: mutable darray[u8] = []
                missing_lock_marker <- missing_lock_marker.resize(64)
                return false if not ProjectFiles::read_c_string_into(staged_missing_lock_path, &missing_lock_marker) or not ByteText::equal_text(missing_lock_marker, "missing\n")
            lock_is_original <- not current_lock_present and not original_lock_present
            if not current_lock_present:
                return true if not original_lock_present or new_lock_missing_state >= 0
                report_recovery_error("error: transaction recovery found an external lockfile edit; recovery files were retained\n")
                return false
            current_lock: mutable darray[u8] = []
            return false if not read_document(live_lock_path, &current_lock)
            lock_is_original <- original_lock_present and ByteText::equal(current_lock, original_lock)
            return true if original_lock_present and ByteText::equal(current_lock, original_lock)
            if new_lock_state >= 0:
                new_lock: mutable darray[u8] = []
                return false if not read_document(staged_lock_path, &new_lock)
                return true if ByteText::equal(current_lock, new_lock)
            report_recovery_error("error: transaction recovery found an external lockfile edit; recovery files were retained\n")
            return false

    public:
        def recover() -> bool can[Global{Read,Write}, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global{Read,Write}:
                return false if transaction_lock_file_descriptor >= 0
                transaction_state: mutable i64 = Platform::package_file_size(phase_path)
                return false if invalid_journal_file(transaction_state)
                guard_state: mutable i64 = transaction_guard_state()
                if guard_state < 0:
                    report_recovery_error("error: invalid project transaction guard at .elisapkg/transaction.guard; preserve it for recovery\n")
                    return false
                lock_state: i64 = Platform::package_file_size(kernel_lock_path)
                return false if invalid_journal_file(lock_state)
                original_manifest_state: i64 = Platform::package_file_size(original_manifest_path)
                original_lock_state: i64 = Platform::package_file_size(original_lock_path)
                new_manifest_state: i64 = Platform::package_file_size(staged_manifest_path)
                new_lock_state: i64 = Platform::package_file_size(staged_lock_path)
                missing_lock_state: i64 = Platform::package_file_size(staged_missing_lock_path)
                return false if:
                    invalid_journal_file(original_manifest_state)
                    invalid_journal_file(original_lock_state)
                    invalid_journal_file(new_manifest_state)
                    invalid_journal_file(new_lock_state)
                    invalid_journal_file(missing_lock_state)
                region journal_absent_scope:
                    journal_absent: bool = transaction_state == -2 and original_manifest_state == -2 and
                        original_lock_state == -2 and new_manifest_state == -2 and
                        new_lock_state == -2 and missing_lock_state == -2
                    # Once the lock file exists, an editor may hold it just before
                    # creating its guard. Check ownership even with no visible journal.
                    return true if journal_absent and guard_state == 0 and lock_state == -2
                if guard_state == 1 and lock_state == -2:
                    report_recovery_error("error: this transaction guard predates automatic recovery; preserve its journal and guard for operator recovery\n")
                    return false
                region state_root_scope:
                    state_root: mutable darray[u8] = []
                    ByteText::append_text(&state_root, ".elisapkg")
                    return false if not ProjectFiles::make_directory(&state_root)
                if not transaction_lock_acquire():
                    report_recovery_error("error: could not acquire the project transaction lock; wait for any active edit to finish, then retry\n")
                    return false
                transaction_state <- Platform::package_file_size(phase_path)
                guard_state <- transaction_guard_state()
                if invalid_journal_file(transaction_state) or guard_state < 0:
                    _ = transaction_lock_release()
                    return false
                if transaction_state == -2:
                    # A crash before the first journal state is published cannot
                    # have changed the live manifest or lock. Remove any partial
                    # backups and the stale guard while holding the kernel lock.
                    return transaction_cleanup()
                region state_scope:
                    state: mutable darray[u8] = []
                    state <- state.resize(128)
                    if not ProjectFiles::read_c_string_into(phase_path, &state):
                        _ = transaction_lock_release()
                        return false
                    return transaction_cleanup() if ByteText::equal_text(state, committed) or ByteText::equal_text(state, rolled_back)
                if guard_state == 0 and Platform::make_directory(guard_path, 448.u16()) != 0:
                    _ = transaction_lock_release()
                    return false
                return restore()

        def commit() -> bool can[Global{Read,Write}, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global{Read,Write}:
                return false if transaction_lock_file_descriptor < 0
                if not published_manifest_matches_journal():
                    report_recovery_error("error: published manifest does not match the transaction journal\n")
                    _ = restore()
                    return false
                if not live_file_matches(staged_lock_path, live_lock_path):
                    report_recovery_error("error: published lockfile does not match the staged transaction bytes\n")
                    _ = restore()
                    return false
                region state_scope:
                    state: mutable darray[u8] = []
                    ByteText::append_text(&state, committed)
                    if not ProjectFiles::write_c_string_file(phase_path, &state):
                        _ = transaction_lock_release()
                        return false
                return transaction_cleanup()
