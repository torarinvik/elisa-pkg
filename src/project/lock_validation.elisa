# Match a frozen lock to the selected manifest and source tree.
include "../archive.elisa"
include "../integrity.elisa"
include "../json.elisa"
include "../package/model.elisa"
include "../package/package_identity.elisa"
include "../resolution/registry_roots.elisa"
include "../resolution/semver.elisa"
include "../resolution/solver.elisa"
include "../source/fingerprint.elisa"
include "../text/bytes.elisa"
include "./local_build_plan.elisa"
include "./local_lock.elisa"
include "./lockfile.elisa"
include "./schema_fields.elisa"

module LockValidation:
    public:
        def matches_manifest(manifest: darray[u8]&, lock: darray[u8]&, name: darray[u8]&, version: darray[u8]&, start: darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                # Local locks can be compared with the deterministic resolver. Registry
                # locks are already authenticated artifacts; inspection commands must
                # validate their signed identity and shape without refreshing registry
                # metadata or changing trust state.
                return matches_local_lock(manifest, lock, name, version, start) if not Lockfile::version_is(lock, Lockfile::registry_version)
                registry_roots: mutable darray[Solver::Constraint] = []
                has_local_dependency: mutable bool = false
                record_starts: mutable darray[usize] = []
                # A v3 lock is emitted only for a registry-only graph. Requiring the same
                # root shape here prevents an edited lock from bypassing the local/registry
                # source separation before offline cache evidence is inspected.
                if not RegistryRoots::collect(manifest, &registry_roots, &has_local_dependency) or has_local_dependency or registry_roots.count == 0.usize() or not Json::valid_document(lock) or not Json::unique_object_keys(lock):
                    false
                else:
                    lock_end: usize = Json::object_end(lock, 0)
                    packages_start: usize = Json::root_value_offset(lock, "packages")
                    packages_end: usize = Json::array_end(lock, packages_start)
                    # Direct registry requirements are the minimum graph contract that can be
                    # checked without loading signed metadata in offline mode. Transitive
                    # edges are authenticated by the cached metadata digest when an online
                    # fetch revalidates the lock; offline mode must at least reject omission
                    # of any dependency named by the manifest itself.
                    lock_end < lock.count and SchemaFields::valid(lock, 0, lock_end, SchemaFields::Kind.RegistryLock) and Json::object_string_equals_text(lock, 0, lock_end, "resolver", Lockfile::registry_resolver) and root_package_matches(manifest, lock, name, version, start) and packages_start < lock.count and packages_end > packages_start and packages_end < lock.count and read_dependency_records(lock, packages_start, packages_end, name, &record_starts) and record_starts.count > 0.usize() and Lockfile::registry_satisfies_roots(lock, record_starts, registry_roots)

    private:
        # A local lock must be exactly what the deterministic resolver emits
        # for a manifest with no registry roots.
        def matches_local_lock(manifest: darray[u8]&, lock: darray[u8]&, name: darray[u8]&, version: darray[u8]&, start: darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                local_roots: mutable darray[Solver::Constraint] = []
                has_local: mutable bool = false
                if not Lockfile::version_is(lock, Lockfile::local_version) or not RegistryRoots::collect(manifest, &local_roots, &has_local) or local_roots.count != 0.usize():
                    false
                else:
                    expected: darray[u8] = LocalLock::canonical(name, version, manifest, start)
                    expected.count > 0.usize() and ByteText::equal(expected, lock)

        # The lock's root package names this project and binds its manifest
        # and source digests.
        def root_package_matches(manifest: darray[u8]&, lock: darray[u8]&, name: darray[u8]&, version: darray[u8]&, start: darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                package_start: usize = Json::root_value_offset(lock, "package")
                package_end: usize = Json::object_end(lock, package_start)
                manifest_digest: mutable darray[u8] = []
                source_digest: mutable darray[u8] = []
                package_start < lock.count and package_end > package_start and SchemaFields::valid(lock, package_start, package_end, SchemaFields::Kind.RegistryLockPackage) and Json::object_string_equals(lock, package_start, package_end, "name", name) and Json::object_string_equals(lock, package_start, package_end, "version", version) and Integrity::sha256_hex(manifest, &manifest_digest) and Lockfile::sha256_field_equals(lock, package_start, package_end, "manifest-digest", manifest_digest) and SourceFingerprint::at(start, &source_digest) and Lockfile::sha256_field_equals(lock, package_start, package_end, "source-digest", source_digest)

        # Read the dependency records of a registry lock. Each is
        # schema-valid, names a dependency other than the root package, and
        # follows the previous record in strictly increasing name order.
        def read_dependency_records(lock: darray[u8]&, packages_start: usize, packages_end: usize, name: darray[u8]&, record_starts: mutable darray[usize]&) -> bool can[Memory.Allocate, Abort.Panic]:
            while cursor < packages_end |cursor: usize = packages_start + 1.usize(), record_end: usize = 0.usize(), name_start: usize = 0.usize(), name_end: usize = 0.usize(), previous_start: usize = 0.usize(), previous_end: usize = 0.usize(), parsed_version: Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, archive: darray[u8] = [], archive_size: u64 = 0.u64()|:
                cursor <- Json::skip_whitespace(lock, cursor, packages_end)
                break if cursor == packages_end
                return false if lock[cursor] != 123 or record_starts.count >= LocalBuildPlan::maximum_packages
                record_end <- Json::object_end(lock, cursor)
                # The root package is never a dependency record, and dependency
                # names must appear in strictly increasing order.
                return false if not:
                    record_end > cursor and record_end < packages_end and SchemaFields::valid(lock, cursor, record_end, SchemaFields::Kind.RegistryLockRecord)
                    Json::object_string_span(lock, cursor, record_end, "name", &name_start, &name_end)
                    PackageIdentity::valid_name_segment(lock, name_start, name_end)
                    not ByteText::range_equals(lock, name_start, name_end, name)
                    previous_end <= previous_start or Lockfile::name_precedes(lock, previous_start, previous_end, name_start, name_end)
                    Lockfile::read_registry_version(lock, cursor, record_end, &parsed_version)
                    Lockfile::read_registry_archive(lock, cursor, record_end, &archive)
                    Json::object_unsigned_value(lock, cursor, record_end, "archive-size", &archive_size) and archive_size <= Archive::maximum_archive_bytes.u64()
                    Lockfile::has_sha256_field(lock, cursor, record_end, "archive-digest")
                    Lockfile::has_sha256_field(lock, cursor, record_end, "metadata-digest")
                previous_start <- name_start
                previous_end <- name_end
                record_starts <- record_starts.push(cursor)
                cursor <- Json::skip_whitespace(lock, record_end + 1.usize(), packages_end)
                if cursor < packages_end:
                    return false if lock[cursor] != 44
                    cursor <- cursor + 1.usize()
            true
