# Match a frozen lock to the selected manifest and source tree.
include "../archive.elisa"
include "../integrity.elisa"
include "../json.elisa"
include "../package/model.elisa"
include "../package/package_identity.elisa"
include "../resolution/registry_roots.elisa"
include "../resolution/semver.elisa"
include "../resolution/solver.elisa"
include "../source/fingerprint.elisa"
include "../text/bytes.elisa"
include "./local_build_plan.elisa"
include "./local_lock.elisa"
include "./lockfile.elisa"
include "./schema_fields.elisa"

module LockValidation:
    public:
        def matches_manifest(manifest: darray[u8]&, lock: darray[u8]&, name: darray[u8]&, version: darray[u8]&, start: darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                # Local locks can be compared with the deterministic resolver. Registry
                # locks are already authenticated artifacts; inspection commands must
                # validate their signed identity and shape without refreshing registry
                # metadata or changing trust state.
                if not Lockfile::version_is(lock, Lockfile::registry_version):
                    return false if not Lockfile::version_is(lock, Lockfile::local_version)
                    local_roots: mutable darray[Solver::Constraint] = []
                    has_local: mutable bool = false
                    return false if not RegistryRoots::collect(manifest, &local_roots, &has_local) or local_roots.count != 0.usize()
                    expected: darray[u8] = LocalLock::canonical(name, version, manifest, start)
                    return expected.count > 0.usize() and ByteText::equal(expected, lock)
                registry_roots: mutable darray[Solver::Constraint] = []
                has_local_dependency: mutable bool = false
                # A v3 lock is emitted only for a registry-only graph. Requiring the same
                # root shape here prevents an edited lock from bypassing the local/registry
                # source separation before offline cache evidence is inspected.
                return false if:
                    not RegistryRoots::collect(manifest, &registry_roots, &has_local_dependency) or has_local_dependency or registry_roots.count == 0.usize()
                    not Json::valid_document(lock) or not Json::unique_object_keys(lock)
                lock_end: usize = Json::object_end(lock, 0)
                return false if lock_end >= lock.count or not SchemaFields::valid(lock, 0, lock_end, SchemaFields::Kind.RegistryLock)
                return false if not Json::object_string_equals_text(lock, 0, lock_end, "resolver", Lockfile::registry_resolver)
                package_start: usize = Json::root_value_offset(lock, "package")
                package_end: usize = Json::object_end(lock, package_start)
                return false if package_start >= lock.count or package_end <= package_start or not SchemaFields::valid(lock, package_start, package_end, SchemaFields::Kind.RegistryLockPackage)
                locked_name: mutable darray[u8] = []
                locked_version: mutable darray[u8] = []
                return false if:
                    not Json::object_string_value(lock, package_start, package_end, "name", &locked_name) or not Json::object_string_value(lock, package_start, package_end, "version", &locked_version)
                    not ByteText::equal(locked_name, name) or not ByteText::equal(locked_version, version)
                manifest_digest: mutable darray[u8] = []
                return false if:
                    not Integrity::sha256_hex(manifest, &manifest_digest)
                    not Lockfile::sha256_field_equals(lock, package_start, package_end, "manifest-digest", manifest_digest)
                source_digest: mutable darray[u8] = []
                return false if:
                    not SourceFingerprint::at(start, &source_digest)
                    not Lockfile::sha256_field_equals(lock, package_start, package_end, "source-digest", source_digest)
                packages_start: usize = Json::root_value_offset(lock, "packages")
                packages_end: usize = Json::array_end(lock, packages_start)
                return false if packages_start >= lock.count or packages_end <= packages_start or packages_end >= lock.count
                cursor: mutable usize = packages_start + 1.usize()
                record_starts: mutable darray[usize] = []
                previous_package: mutable darray[u8] = []
                while cursor < packages_end:
                    cursor <- Json::skip_whitespace(lock, cursor, packages_end)
                    break if cursor == packages_end
                    return false if lock[cursor] != 123 or record_starts.count >= LocalBuildPlan::maximum_packages
                    record_end: usize = Json::object_end(lock, cursor)
                    return false if record_end <= cursor or record_end >= packages_end or not SchemaFields::valid(lock, cursor, record_end, SchemaFields::Kind.RegistryLockRecord)
                    package: mutable darray[u8] = []
                    return false if not Json::object_string_value(lock, cursor, record_end, "name", &package) or not PackageIdentity::valid_name(package)
                    # Canonical registry locks sort package records by name and never
                    # serialize the root package itself. Enforce both properties before
                    # trusting any receipt-backed record in an offline build.
                    return false if:
                        ByteText::equal(package, name)
                        previous_package.count > 0.usize() and not ByteText::less(previous_package, package)
                    version_start: mutable usize = 0
                    version_end: mutable usize = 0
                    parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                    return false if:
                        not Json::object_string_span(lock, cursor, record_end, "version", &version_start, &version_end)
                        not SemVer::parse_range(lock, version_start, version_end, &parsed_version)
                        parsed_version.prerelease
                    archive: mutable darray[u8] = []
                    return false if not Lockfile::read_registry_archive(lock, cursor, record_end, &archive)
                    archive_size: mutable u64 = 0
                    return false if not Json::object_unsigned_value(lock, cursor, record_end, "archive-size", &archive_size) or archive_size > Archive::max_archive_bytes.u64()
                    return false if:
                        not Lockfile::has_sha256_field(lock, cursor, record_end, "archive-digest")
                        not Lockfile::has_sha256_field(lock, cursor, record_end, "metadata-digest")
                    previous_package <- previous_package.resize(0)
                    ByteText::append(&previous_package, package)
                    record_starts <- record_starts.push(cursor)
                    cursor <- record_end + 1.usize()
                    cursor <- Json::skip_whitespace(lock, cursor, packages_end)
                    if cursor < packages_end:
                        return false if lock[cursor] != 44
                        cursor <- cursor + 1.usize()
                return false if record_starts.count == 0.usize()
                # Direct registry requirements are the minimum graph contract that can be
                # checked without loading signed metadata in offline mode. Transitive
                # edges are authenticated by the cached metadata digest when an online
                # fetch revalidates the lock; offline mode must at least reject omission
                # of any dependency named by the manifest itself.
                return Lockfile::registry_satisfies_roots(lock, record_starts, registry_roots)
