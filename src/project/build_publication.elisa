# Publish a validated compiler artifact and its build receipt.
include "../cli/output.elisa"
include "../platform.elisa"
include "../text/bytes.elisa"
include "./build_receipt.elisa"
include "./files.elisa"

module BuildPublication:
    public:
        def publish(build_directory: darray[u8]&, artifact_leaf: darray[u8]&, emit_kind: cstr, artifact_access_mode: i64, temporary_name: cstr, artifact_name: cstr, receipt_path: darray[u8]&, artifact_content: darray[u8]&, artifact_digest: darray[u8]&, receipt: mutable darray[u8]&) -> bool can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # Never publish the compiler-owned inode directly. A descendant can
            # leave its process group and retain an already-open descriptor even
            # after the main compiler exits. Copy the bytes we hashed into a new
            # parent-owned inode that was not present in the sandbox during build.
            publish_template: mutable darray[u8] = []
            ByteText::append(&publish_template, build_directory)
            if publish_template.count == 0.usize() or publish_template[publish_template.count - 1.usize()] != 47:
                publish_template <- publish_template.push(47)
            ByteText::append(&publish_template, artifact_leaf)
            ByteText::append_text(&publish_template, ".publish.XXXXXX")
            publish_template <- publish_template.push(0)
            publish_file_descriptor: i64 = Platform::make_temporary_file(&publish_template)
            if publish_file_descriptor < 0:
                _ = Platform::unlink_path(temporary_name)
                return false
            publish_name: cstr = (&publish_template[0]).cast[cstr] can Unsafe.PointerCast
            output_mode: u16 = 493.u16() if Platform::c_string_equal(emit_kind, "exe") else 420.u16()
            publish_ok: mutable bool = ProjectFiles::write_file_descriptor_all(publish_file_descriptor, artifact_content)
            publish_ok <- false if Platform::change_mode(publish_name, output_mode) != 0
            publish_ok <- false if Platform::access_path(publish_name, artifact_access_mode) != 0
            publish_ok <- false if Platform::synchronize_file(publish_file_descriptor) != 0
            publish_close_status: i64 = Platform::close_file_descriptor(publish_file_descriptor)
            if not publish_ok or publish_close_status != 0:
                _ = Platform::unlink_path(publish_name)
                _ = Platform::unlink_path(temporary_name)
                CliOutput::write_error("error: unable to create a normalized parent-owned build artifact\n") can Global.Read
                return false
            if Platform::rename_path(publish_name, artifact_name) != 0:
                _ = Platform::unlink_path(publish_name)
                _ = Platform::unlink_path(temporary_name)
                return false
            BuildReceipt::append_receipt_digest(receipt, artifact_digest)
            if not ProjectFiles::replace_file(receipt_path, receipt):
                # The artifact has already been atomically published. Do not unlink
                # this pathname after a receipt failure: an older artifact may have
                # been replaced by the rename, and removing it would destroy package
                # output whose ownership is no longer distinguishable at this point.
                # The missing or stale receipt makes the next build reject the cache
                # and re-establish the pair before reuse.
                return false
            return true
