# Validate project manifests and their target files as a single operation.
include "../package/manifest.elisa"
include "../package/targets.elisa"
include "./files.elisa"
include "./schema_fields.elisa"

module ProjectManifest:
    public:
        def validate_at(raw: darray[u8]&, root: darray[u8]&, name_out: mutable darray[u8]&, version_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            name_out.resize(0)
            version_out.resize(0)
            return false if not:
                Json::valid_document(raw)
                Json::unique_object_keys(raw)
                Manifest::allowed_keys(raw)
            for index in 0..<raw.count |raw|:
                return false if raw[index] == 0
            object_start: usize = Json::root_start(raw)
            object_finish: usize = Json::root_object_end(raw, object_start)
            schema_version: mutable u64 = 0.u64()
            return false if not:
                Json::object_unsigned_value(raw, object_start, object_finish, "schema-version", &schema_version)
                schema_version == 1.u64()
                Manifest::valid_optional_package_strings(raw)
                Manifest::valid_pattern_array(raw, "include")
                Manifest::valid_pattern_array(raw, "exclude")
                valid_target_objects(raw, root)
                Manifest::valid_dependency_map(raw, "dependencies")
                Manifest::valid_dependency_map(raw, "dev-dependencies")
                dependency_map_empty(raw, "dev-dependencies")
            name: mutable darray[u8] = []
            version: mutable darray[u8] = []
            package_start: mutable usize = 0.usize()
            package_end: mutable usize = 0.usize()
            return false if not:
                Json::object_value_span(raw, object_start, object_finish, "package", &package_start, &package_end)
                Json::object_string_value(raw, package_start, package_end, "name", &name)
                Json::object_string_value(raw, package_start, package_end, "version", &version)
                PackageIdentity::valid_name(name)
                PackageIdentity::valid_version(version)
            for index in 0..<name.count |name_out, name|:
                name_out.push(name[index])
            for index in 0..<version.count |version_out, version|:
                version_out.push(version[index])
            return true

        def validate(raw: darray[u8]&, name_out: mutable darray[u8]&, version_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root: mutable darray[u8] = [46]
            return validate_at(raw, &root, name_out, version_out)

        def load_at(root: darray[u8]&, name_out: mutable darray[u8]&, version_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            name_out.resize(0)
            version_out.resize(0)
            manifest_path: mutable darray[u8] = []
            ProjectFiles::path_join_into(root, "elisapkg.json", &manifest_path)
            raw: mutable darray[u8] = []
            return false if not:
                Platform::pkg_read_bounded_file(manifest_path, Json::max_document_bytes, &raw)
                validate_at(raw, root, name_out, version_out)
            return true

    private:
        def target_file_is_valid(root: darray[u8]&, canonical_root: darray[u8]&, entry: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            entry_path: mutable darray[u8] = []
            ProjectFiles::path_join_bytes_into(root, entry, &entry_path)
            canonical_entry: mutable darray[u8] = []
            return false if not ProjectFiles::resolve_entry_beneath_canonical_root(canonical_root, &entry_path, &canonical_entry)
            entry_path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&entry_path, &entry_path_c)
            entry_path_name: cstr = (&entry_path_c[0]).cast[cstr] can Unsafe.PointerCast
            return false if Platform::pkg_package_file_size(entry_path_name) < 0
            return true

        def valid_target_objects(raw: darray[u8]&, root: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            targets_start: usize = Json::root_value_offset(raw, "targets")
            return false if targets_start >= raw.count or raw[targets_start] != 91
            targets_end: usize = Json::array_end(raw, targets_start)
            return false if targets_end <= targets_start or targets_end >= raw.count
            canonical_root: mutable darray[u8] = []
            return false if not ProjectFiles::canonical_existing_path(root, &canonical_root)
            seen: mutable darray[u8] = []
            name_offsets: mutable darray[usize] = []
            name_offsets <- name_offsets.resize(2.usize() * ManifestTargets::max_targets + 1.usize())
            found: mutable usize = 0.usize()
            cursor: mutable usize = Json::skip_whitespace(raw, targets_start + 1.usize(), targets_end)
            while cursor < targets_end |raw, root, canonical_root, seen, name_offsets, found, cursor, targets_end|:
                return false if found >= ManifestTargets::max_targets or raw[cursor] != 123
                object_end: usize = Json::object_end(raw, cursor)
                return false if:
                    object_end <= cursor or object_end >= targets_end
                    not SchemaFields::valid(raw, cursor, object_end, SchemaFields::Kind.ManifestTarget)
                target_name: mutable darray[u8] = []
                return false if not:
                    Json::object_string_value(raw, cursor, object_end, "name", &target_name)
                    PackageIdentity::valid_name(target_name)
                    register_target_name(target_name, &seen, &name_offsets)
                target_kind: mutable darray[u8] = []
                return false if not:
                    Json::object_string_value(raw, cursor, object_end, "kind", &target_kind)
                    ByteText::equal_text(target_kind, "bin") or ByteText::equal_text(target_kind, "lib") or ByteText::equal_text(target_kind, "test")
                target_entry: mutable darray[u8] = []
                return false if not:
                    Json::object_string_value(raw, cursor, object_end, "entry", &target_entry)
                    Manifest::is_safe_relative_entry(target_entry)
                    target_file_is_valid(root, canonical_root, target_entry)
                found <- found + 1.usize()
                cursor <- Json::skip_whitespace(raw, object_end + 1.usize(), targets_end)
                return true if cursor == targets_end
                return false if raw[cursor] != 44
                cursor <- Json::skip_whitespace(raw, cursor + 1.usize(), targets_end)
            return false

        # Each occupied slot stores a one-based offset into the packed names.
        # Compare the full name on collisions before rejecting a duplicate.
        def register_target_name(name: darray[u8]&, names: mutable darray[u8]&, offsets: mutable darray[usize]&) -> bool can[Memory.Allocate, Abort.Panic]:
            hash: mutable u32 = 2166136261.u32()
            for index in 0..<name.count |hash, name|:
                hash <- (hash ^ name[index].u32()) * 16777619.u32()
            slot: mutable usize = hash.usize() % offsets.count
            for attempt in 0..<offsets.count |slot, offsets, names, name|:
                stored: usize = offsets[slot]
                if stored == 0.usize():
                    offsets[slot] <- names.count + 1.usize()
                    ByteText::append(names, name)
                    names.push(0)
                    return true
                start: usize = stored - 1.usize()
                finish: mutable usize = start
                while names[finish] != 0 |names, finish|:
                    finish <- finish + 1.usize()
                return false if ByteText::range_equals(names, start, finish, name)
                slot <- (slot + 1.usize()) % offsets.count
            return false

        def dependency_map_empty(raw: darray[u8]&, wanted: cstr) -> bool:
            start: usize = Json::root_value_offset(raw, wanted)
            return true if start >= raw.count
            finish: usize = Json::object_end(raw, start)
            return false if finish <= start or finish >= raw.count
            for index in (start + 1.usize())..<finish |raw|:
                byte: u8 = raw[index]
                return false if byte != 32 and byte != 9 and byte != 10 and byte != 13
            return true
