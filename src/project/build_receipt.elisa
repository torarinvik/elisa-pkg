# Canonical build receipt fields used for artifact reuse.
include "../integrity.elisa"
include "../platform.elisa"
include "../text/bytes.elisa"

module BuildReceipt:
    public:
        def append_target(receipt: mutable darray[u8]&, target_entry: darray[u8]&, target_kind: darray[u8]&, artifact_leaf: darray[u8]&, profile: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(receipt, "elisapkg-build-receipt:12\nentry:")
            ByteText::append(receipt, target_entry)
            ByteText::append_text(receipt, "\ntarget-kind:")
            ByteText::append(receipt, target_kind)
            ByteText::append_text(receipt, "\nartifact:")
            ByteText::append(receipt, artifact_leaf)
            ByteText::append_text(receipt, "\nprofile:")
            ByteText::append_bounded_text(receipt, profile)
            ByteText::append_text(receipt, "\ncompiler-flags:")
            if Platform::pkg_cstr_equal(profile, "release"):
                ByteText::append_text(receipt, "-O2")
            else:
                ByteText::append_text(receipt, "-O0,-g")

        def append_input_digests(receipt: mutable darray[u8]&, source_tree_digest: darray[u8]&, source_digest: darray[u8]&,
                                 manifest_digest: darray[u8]&, lock_digest: darray[u8]&, has_dependencies: bool, aggregate_digest: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(receipt, "\nsource-tree-digest:sha256:")
            ByteText::append(receipt, source_tree_digest)
            ByteText::append_text(receipt, "\nsource-digest:sha256:")
            ByteText::append(receipt, source_digest)
            ByteText::append_text(receipt, "\nmanifest-digest:sha256:")
            ByteText::append(receipt, manifest_digest)
            ByteText::append_text(receipt, "\nlock-digest:sha256:")
            ByteText::append(receipt, lock_digest)
            if has_dependencies:
                ByteText::append_text(receipt, "\ndependency-aggregate-digest:sha256:")
                ByteText::append(receipt, aggregate_digest)
            else:
                ByteText::append_text(receipt, "\ndependency-aggregate-digest:none")

        def append_toolchain(receipt: mutable darray[u8]&, compiler: cstr, compiler_executable: cstr, stage1_bin: cstr,
                             runtime_obj: cstr, compiler_identity: darray[u8]&, stage1_identity: darray[u8]&,
                             runtime_identity: darray[u8]&, clang_tool: cstr, clang_identity: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(receipt, "\ncompiler:")
            ByteText::append_bounded_text(receipt, compiler)
            ByteText::append_text(receipt, "\ncompiler-executable:")
            ByteText::append_bounded_text(receipt, compiler_executable)
            ByteText::append_text(receipt, "\nstage1-bin:")
            ByteText::append_bounded_text(receipt, stage1_bin)
            ByteText::append_text(receipt, "\nruntime-object:")
            ByteText::append_bounded_text(receipt, runtime_obj)
            ByteText::append_text(receipt, "\ncompiler-identity:")
            ByteText::append(receipt, compiler_identity)
            ByteText::append_text(receipt, "\nstage1-identity:")
            ByteText::append(receipt, stage1_identity)
            ByteText::append_text(receipt, "\nruntime-identity:")
            ByteText::append(receipt, runtime_identity)
            ByteText::append_text(receipt, "\nclang-tool:")
            ByteText::append_bounded_text(receipt, clang_tool)
            ByteText::append_text(receipt, "\nclang-identity:")
            ByteText::append(receipt, clang_identity)

        def append_sandbox(receipt: mutable darray[u8]&, sdk_root: darray[u8]&, developer_dir: darray[u8]&,
                           developer_linker_identity: darray[u8]&, developer_assembler_identity: darray[u8]&,
                           sdk_identity: darray[u8]&, allow_stale: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(receipt, "\nmacos-sdk-root:")
            ByteText::append(receipt, sdk_root)
            ByteText::append_text(receipt, "\nmacos-developer-dir:")
            ByteText::append(receipt, developer_dir)
            ByteText::append_text(receipt, "\nmacos-linker-identity:")
            ByteText::append(receipt, developer_linker_identity)
            ByteText::append_text(receipt, "\nmacos-assembler-identity:")
            ByteText::append(receipt, developer_assembler_identity)
            ByteText::append_text(receipt, "\nmacos-sdk-identity:")
            ByteText::append(receipt, sdk_identity)
            ByteText::append_text(receipt, "\nallow-stale:")
            ByteText::append_bounded_text(receipt, allow_stale)
            ByteText::append_text(receipt, "\nsemantic-gate:1\nsandbox-policy:macos-seatbelt-v3")

        def receipt_size(prefix_bytes: usize) -> usize:
            return prefix_bytes + digest_label_bytes + digest_hex_bytes + 1.usize()

        def append_receipt_digest(receipt: mutable darray[u8]&, digest: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(receipt, digest_label)
            ByteText::append(receipt, digest)
            receipt.push(10)

        def receipt_header_matches(receipt: darray[u8]&, prefix: darray[u8]&) -> bool:
            return false if receipt.count != receipt_size(prefix.count) or not ByteText::starts_with(receipt, prefix)
            digest_start: usize = prefix.count + digest_label_bytes
            digest_end: usize = receipt.count - 1.usize()
            return receipt[digest_end] == 10 and ByteText::range_equals_text(receipt, prefix.count, digest_start, digest_label) and Integrity::valid_sha256_hex_range(receipt, digest_start, digest_end)

        # Called after the receipt header has been checked.
        def receipt_digest_matches(receipt: darray[u8]&, digest: darray[u8]&) -> bool:
            return false if receipt.count < digest_hex_bytes + 1.usize() or digest.count != digest_hex_bytes
            digest_end: usize = receipt.count - 1.usize()
            return ByteText::range_equals(receipt, digest_end - digest_hex_bytes, digest_end, digest)

    private:
        const digest_label: cstr = "\nartifact-digest:sha256:"
        const digest_label_bytes: usize = 24.usize()
        const digest_hex_bytes: usize = 64.usize()
