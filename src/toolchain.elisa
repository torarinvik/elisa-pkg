# Compiler argument policy and toolchain path identification.

include "./platform.elisa"

module Toolchain:
    private:
        def executable_path(path: cstr, canonical: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not canonical_path_bytes(path, canonical)
            canonical.push(0)
            name: cstr = (&canonical[0]).cast[cstr] can Unsafe.PointerCast
            executable: bool = Platform::pkg_access(name, 1) == 0
            canonical.resize(canonical.count - 1.usize())
            return executable

        def path_without_suffix(path: darray[u8]&, suffix: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            suffix_length: usize = Platform::pkg_strlen(suffix)
            return false if suffix_length >= path.count
            offset: usize = path.count - suffix_length
            for index in 0..<suffix_length |path, suffix, offset|:
                return false if path[offset + index] != suffix[index].u8()
            return false if offset == 0.usize() or path[offset - 1.usize()] == 47
            for index in 0..<offset |out, path|:
                out.push(path[index])
            return true

        def bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            false return if left.count != right.count
            for index in 0..<left.count |left, right|:
                false return if left[index] != right[index]
            return true

    public:
        # Use the same search order for lookup and for the child environment.
        const isolated_path_environment: cstr = "PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin"

        def resolve_build_compiler(path: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return false if not valid_compiler_argument(path)
            length: usize = Platform::pkg_strlen(path)
            for index in 0..<length |path, length, out|:
                if path[index].u8() == 47:
                    canonical: mutable darray[u8] = []
                    return false if not executable_path(path, &canonical)
                    # Keep an explicit absolute spelling for wrapper recognition.
                    if path[0].u8() == 47:
                        for offset in 0..<length |out, path|:
                            out.push(path[offset].u8())
                    else:
                        for index in 0..<canonical.count |out, canonical|:
                            out.push(canonical[index])
                    return true
            search_end: usize = Platform::pkg_strlen(isolated_path_environment)
            directory_start: mutable usize = 5.usize()
            for directory_end in directory_start..=search_end |directory_start, search_end, path, length, out|:
                if directory_end == search_end or isolated_path_environment[directory_end].u8() == 58:
                    candidate: mutable darray[u8] = []
                    for index in directory_start..<directory_end |candidate|:
                        candidate.push(isolated_path_environment[index].u8())
                    candidate.push(47)
                    for index in 0..<length |candidate, path|:
                        candidate.push(path[index].u8())
                    candidate.push(0)
                    candidate_name: cstr = (&candidate[0]).cast[cstr] can Unsafe.PointerCast
                    canonical: mutable darray[u8] = []
                    if executable_path(candidate_name, &canonical):
                        candidate.resize(candidate.count - 1.usize())
                        for index in 0..<candidate.count |out, candidate|:
                            out.push(candidate[index])
                        return true
                    directory_start <- directory_end + 1.usize()
            return false

        def valid_compiler_argument(value: cstr) -> bool:
            length: usize = Platform::pkg_strlen(value)
            # The compiler is the first utility argument after `env -i`. Reject forms
            # that the env utility would interpret as an option or NAME=VALUE prefix;
            # a malformed override must fail before child process construction.
            return false if length == 0.usize() or length > 4096.usize() or value[0].u8() == 45 or value[0].u8() == 61
            for index in 0..<length |value|:
                byte: u8 = value[index].u8()
                return false if byte == 61 or byte < 32 or byte == 127
            return true

        def valid_toolchain_value(value: cstr, maximum: usize) -> bool:
            length: usize = Platform::pkg_strlen(value)
            return false if length > maximum
            for index in 0..<length |value|:
                byte: u8 = value[index].u8()
                return false if byte < 32 or byte == 127
            return true

        def canonical_path_bytes(path: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            resolved: mutable darray[u8] = []
            resolved.resize(4096)
            if Platform::pkg_realpath(path, &resolved) is canonical:
                length: usize = Platform::pkg_strlen(canonical)
                return false if length == 0.usize() or length >= 4096.usize()
                for index in 0..<length |out, canonical|:
                    out.push(canonical[index].u8())
                return true
            return false

        def stage1_wrapper_pair_matches(wrapper: cstr, stage1: cstr) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if Platform::pkg_strlen(wrapper) == 0.usize() or Platform::pkg_strlen(stage1) == 0.usize()
            wrapper_real: mutable darray[u8] = []
            stage1_real: mutable darray[u8] = []
            return false if not canonical_path_bytes(wrapper, &wrapper_real) or not canonical_path_bytes(stage1, &stage1_real)
            wrapper_root: mutable darray[u8] = []
            stage1_root: mutable darray[u8] = []
            return false if not path_without_suffix(wrapper_real, "/scripts/elisac_stage1.sh", &wrapper_root)
            return false if not path_without_suffix(stage1_real, "/bin/elisac-stage1", &stage1_root)
            return bytes_equal(wrapper_root, stage1_root)
