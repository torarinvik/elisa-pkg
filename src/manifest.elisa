# Manifest policy surface. Parsing and schema validation remain in the command
# implementation for now; archive path policy is shared through one reviewed
# module so target and extraction callers cannot drift.

include "./archive.elisa"

module Manifest:
    public:
        def is_safe_relative_entry(entry: darray[u8]&) -> bool:
            return false if not Archive::is_safe_entry(entry)
            segment_start: mutable usize = 0.usize()
            for index in 0..=entry.count |entry, segment_start|:
                if index == entry.count or entry[index] == 47:
                    return false if index == segment_start or entry[segment_start] == 46
                    segment_start <- index + 1.usize()
            return true

    private:
        const manifest_path_policy: cstr = "archive-safe relative paths"
