# Bounded policy primitives for the selected TUF v1.0.36 profile.
#
# This is not a TUF client: callers must still parse metadata, canonicalize the
# signed object, verify each signature, validate roles/delegations, and commit
# trusted state atomically before exposing targets.

include "./json.elisa"

module Tuf:
    public:
        const enum ValidationCode of u8:
            WellFormed
            UnsupportedSpecVersion
            MalformedKeyId
            DuplicateKeyId
            InvalidThreshold
            ThresholdInsufficient
            ResourceLimit
            MalformedJson
            InvalidJsonKeys
            NoncanonicalNumber
            UnsupportedHashAlgorithm
            MalformedHash

        const enum CheckpointCode of u8:
            Accepted
            Malformed
            Rollback
            Equivocation

        # Check one already-authenticated role checkpoint before the caller
        # includes it in the durable registry-state transaction. The caller
        # must maintain a separate previous version and digest for each
        # registry/role identity and commit all accepted role checkpoints
        # atomically only after the complete metadata chain has verified.
        def check_authenticated_checkpoint(previous_version: u64, previous_digest: darray[u8]&, candidate_version: u64, candidate_digest: darray[u8]&) -> CheckpointCode:
            return CheckpointCode.Malformed if candidate_version == 0.u64() or not valid_sha256_digest(candidate_digest)
            if previous_version == 0.u64():
                return CheckpointCode.Malformed if previous_digest.count != 0.usize()
                return CheckpointCode.Accepted
            return CheckpointCode.Malformed if not valid_sha256_digest(previous_digest)
            return CheckpointCode.Rollback if candidate_version < previous_version
            return CheckpointCode.Equivocation if candidate_version == previous_version and not tuf_bytes_equal(candidate_digest, previous_digest)
            return CheckpointCode.Accepted

        # These limits bound a single repository refresh under the current
        # package-scoped delegation model. Changing them requires independent
        # metadata-size and worst-case-work review.
        const max_metadata_file_bytes: usize = Json::max_document_bytes
        const max_authorized_keys_per_role: usize = 64.usize()
        const max_registry_identity_bytes: usize = 128.usize()
        const max_signatures_per_metadata: usize = 64.usize()
        const max_delegated_roles: usize = 4096.usize()
        const max_delegation_depth: usize = 1.usize()
        const max_targets_per_package_role: usize = 4096.usize()
        const max_root_updates_per_refresh: usize = 1024.usize()
        const max_json_container_depth: usize = Json::max_container_depth
        const max_json_object_keys: usize = Json::max_object_keys
        const max_duplicate_key_candidates: usize = Json::max_duplicate_key_candidates
        const max_duplicate_key_comparison_bytes: usize = Json::max_duplicate_key_comparison_bytes

        # Bounded syntax precheck for the pinned metadata profile. This does
        # not decode role schemas, canonicalize signed bytes, verify signatures,
        # or authorize targets.
        def precheck_metadata_json(raw: darray[u8]&) -> ValidationCode can[Memory.Allocate, Abort.Panic]:
            return ValidationCode.MalformedJson if raw.count == 0.usize()
            return ValidationCode.ResourceLimit if raw.count > max_metadata_file_bytes
            return ValidationCode.MalformedJson if not Json::valid_document(raw)
            return ValidationCode.InvalidJsonKeys if not Json::unique_object_keys(raw)
            return ValidationCode.NoncanonicalNumber if not tuf_integer_numbers_only(raw)
            return ValidationCode.WellFormed

        # The selected package profile allows SHA-256 only in TUF `hashes`
        # maps. This bounded lexical pass runs after general JSON validation;
        # it does not replace the upstream schema or target-length checks.
        def precheck_sha256_hashes(raw: darray[u8]&) -> ValidationCode can[Memory.Allocate, Abort.Panic]:
            syntax_status: ValidationCode = precheck_metadata_json(raw)
            return syntax_status if syntax_status != ValidationCode.WellFormed
            cursor: mutable usize = 0.usize()
            while cursor < raw.count |raw, cursor|:
                if raw[cursor] == 34:
                    content_start: usize = cursor + 1.usize()
                    content_end: usize = json_string_content_end(raw, cursor)
                    return ValidationCode.MalformedJson if content_end >= raw.count
                    after_string: mutable usize = content_end + 1.usize()
                    while after_string < raw.count and tuf_space(raw[after_string]) |raw, after_string|:
                        after_string <- after_string + 1.usize()
                    if after_string < raw.count and raw[after_string] == 58 and raw_slice_equals_text(raw, content_start, content_end, "hashes"):
                        hashes_start: mutable usize = after_string + 1.usize()
                        while hashes_start < raw.count and tuf_space(raw[hashes_start]) |raw, hashes_start|:
                            hashes_start <- hashes_start + 1.usize()
                        return ValidationCode.MalformedHash if hashes_start >= raw.count or raw[hashes_start] != 123
                        hashes_end: mutable usize = hashes_start
                        hash_status: ValidationCode = validate_sha256_hash_map(raw, hashes_start, &hashes_end)
                        return hash_status if hash_status != ValidationCode.WellFormed
                        cursor <- hashes_end
                        continue
                    cursor <- content_end + 1.usize()
                    continue
                cursor <- cursor + 1.usize()
            return ValidationCode.WellFormed

        # Registry identities are stable configuration labels, never URLs or
        # credentials. TUF targets must echo this configured token exactly.
        def valid_registry_identity_bytes(value: darray[u8]&) -> bool:
            return false if value.count == 0.usize() or value.count > max_registry_identity_bytes
            first: u8 = value[0]
            return false if not ((first >= 48 and first <= 57) or (first >= 97 and first <= 122))
            for index in 0..<value.count |value, index|:
                byte: u8 = value[index]
                return false if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 122) or byte == 46 or byte == 95 or byte == 58 or byte == 45)
            return true

        # The selected profile accepts stable 1.0.P versions through the pinned
        # v1.0.36 patch, inclusive. This checks only the protocol version text;
        # it does not validate or authenticate a metadata document.
        def precheck_spec_version(value: darray[u8]&) -> ValidationCode:
            return ValidationCode.UnsupportedSpecVersion if value.count < 5.usize() or value.count > 6.usize()
            return ValidationCode.UnsupportedSpecVersion if value[0] != 49 or value[1] != 46 or value[2] != 48 or value[3] != 46
            patch_start: usize = 4.usize()
            return ValidationCode.UnsupportedSpecVersion if value[patch_start] < 48 or value[patch_start] > 57
            return ValidationCode.UnsupportedSpecVersion if value.count == 6.usize() and (value[patch_start] == 48 or value[5] < 48 or value[5] > 57)
            patch: mutable u64 = (value[patch_start] - 48).u64()
            patch <- patch * 10.u64() + (value[5] - 48).u64() if value.count == 6.usize()
            return ValidationCode.UnsupportedSpecVersion if patch > 36.u64()
            return ValidationCode.WellFormed

        # Validate the shape of the authorized and supplied signature key-id
        # lists. Each input is a flat sequence of 64-byte lowercase SHA-256
        # hex IDs. Unknown supplied IDs are permitted but cannot satisfy the
        # role threshold. The matching count is only a pre-verification upper
        # bound: it does not prove that any signature is cryptographically
        # valid or authorized by the exact role metadata.
        def precheck_signature_key_ids(authorized_ids: darray[u8]&, supplied_ids: darray[u8]&, threshold: u64) -> ValidationCode:
            return ValidationCode.ResourceLimit if authorized_ids.count > max_authorized_keys_per_role * 64.usize() or supplied_ids.count > max_signatures_per_metadata * 64.usize()
            return ValidationCode.MalformedKeyId if authorized_ids.count % 64.usize() != 0.usize() or supplied_ids.count % 64.usize() != 0.usize()
            authorized_count: usize = authorized_ids.count / 64.usize()
            supplied_count: usize = supplied_ids.count / 64.usize()
            return ValidationCode.InvalidThreshold if threshold == 0.u64() or threshold > authorized_count.u64()
            authorized_status: ValidationCode = validate_key_id_list(authorized_ids)
            return authorized_status if authorized_status != ValidationCode.WellFormed
            supplied_status: ValidationCode = validate_key_id_list(supplied_ids)
            return supplied_status if supplied_status != ValidationCode.WellFormed
            authorized_signatures: mutable usize = 0.usize()
            for supplied_index in 0..<supplied_count |authorized_ids, supplied_ids, supplied_index, authorized_signatures|:
                supplied_offset: usize = supplied_index * 64.usize()
                for authorized_index in 0..<authorized_count |authorized_ids, supplied_ids, supplied_offset, authorized_index, authorized_signatures|:
                    authorized_offset: usize = authorized_index * 64.usize()
                    if key_id_equal(authorized_ids, authorized_offset, supplied_ids, supplied_offset):
                        authorized_signatures <- authorized_signatures + 1.usize()
                        break
            return ValidationCode.ThresholdInsufficient if authorized_signatures.u64() < threshold
            return ValidationCode.WellFormed

    private:
        const key_id_size: usize = 64.usize()

        # TUF's canonical JSON subdialect contains integers only and forbids
        # negative zero. Json::valid_document has already established token
        # boundaries and ordinary JSON number grammar before this scan runs.
        def tuf_integer_numbers_only(raw: darray[u8]&) -> bool:
            in_string: mutable bool = false
            escaped: mutable bool = false
            cursor: mutable usize = 0.usize()
            while cursor < raw.count |raw, in_string, escaped, cursor|:
                byte: u8 = raw[cursor]
                if in_string:
                    if escaped:
                        escaped <- false
                    elif byte == 92:
                        escaped <- true
                    elif byte == 34:
                        in_string <- false
                    cursor <- cursor + 1.usize()
                    continue
                if byte == 34:
                    in_string <- true
                    cursor <- cursor + 1.usize()
                    continue
                if byte == 45 or (byte >= 48 and byte <= 57):
                    start: usize = cursor
                    cursor <- cursor + 1.usize()
                    while cursor < raw.count and ((raw[cursor] >= 48 and raw[cursor] <= 57) or raw[cursor] == 46 or raw[cursor] == 69 or raw[cursor] == 101 or raw[cursor] == 43 or raw[cursor] == 45) |raw, cursor|:
                        return false if raw[cursor] == 46 or raw[cursor] == 69 or raw[cursor] == 101
                        cursor <- cursor + 1.usize()
                    return false if cursor - start == 2.usize() and raw[start] == 45 and raw[start + 1.usize()] == 48
                    continue
                cursor <- cursor + 1.usize()
            return not in_string and not escaped

        def validate_sha256_hash_map(raw: darray[u8]&, object_start: usize, end_out: mutable usize&) -> ValidationCode:
            end_out <- 0.usize()
            cursor: mutable usize = object_start + 1.usize()
            while cursor < raw.count and tuf_space(raw[cursor]) |raw, cursor|:
                cursor <- cursor + 1.usize()
            return ValidationCode.MalformedHash if cursor >= raw.count or raw[cursor] == 125
            while cursor < raw.count |raw, cursor|:
                return ValidationCode.MalformedHash if raw[cursor] != 34
                key_start: usize = cursor + 1.usize()
                key_end: usize = json_string_content_end(raw, cursor)
                return ValidationCode.MalformedHash if key_end >= raw.count
                return ValidationCode.UnsupportedHashAlgorithm if not raw_slice_equals_text(raw, key_start, key_end, "sha256")
                cursor <- key_end + 1.usize()
                while cursor < raw.count and tuf_space(raw[cursor]) |raw, cursor|:
                    cursor <- cursor + 1.usize()
                return ValidationCode.MalformedHash if cursor >= raw.count or raw[cursor] != 58
                cursor <- cursor + 1.usize()
                while cursor < raw.count and tuf_space(raw[cursor]) |raw, cursor|:
                    cursor <- cursor + 1.usize()
                return ValidationCode.MalformedHash if cursor >= raw.count or raw[cursor] != 34
                digest_start: usize = cursor + 1.usize()
                digest_end: usize = json_string_content_end(raw, cursor)
                return ValidationCode.MalformedHash if digest_end >= raw.count or not valid_sha256_digest_range(raw, digest_start, digest_end)
                cursor <- digest_end + 1.usize()
                while cursor < raw.count and tuf_space(raw[cursor]) |raw, cursor|:
                    cursor <- cursor + 1.usize()
                if cursor < raw.count and raw[cursor] == 125:
                    end_out <- cursor + 1.usize()
                    return ValidationCode.WellFormed
                return ValidationCode.MalformedHash if cursor >= raw.count or raw[cursor] != 44
                cursor <- cursor + 1.usize()
                while cursor < raw.count and tuf_space(raw[cursor]) |raw, cursor|:
                    cursor <- cursor + 1.usize()
            return ValidationCode.MalformedHash

        def json_string_content_end(raw: darray[u8]&, quote_start: usize) -> usize:
            cursor: mutable usize = quote_start + 1.usize()
            while cursor < raw.count |raw, cursor|:
                if raw[cursor] == 92:
                    cursor <- cursor + 2.usize()
                    continue
                return cursor if raw[cursor] == 34
                cursor <- cursor + 1.usize()
            return raw.count

        def raw_slice_equals_text(raw: darray[u8]&, start: usize, end: usize, expected: cstr) -> bool:
            cursor: mutable usize = 0.usize()
            while expected[cursor].u8() != 0:
                return false if start + cursor >= end or raw[start + cursor] != expected[cursor].u8()
                cursor <- cursor + 1.usize()
            return end - start == cursor

        def tuf_space(byte: u8) -> bool:
            return byte == 32 or byte == 9 or byte == 10 or byte == 13

        def validate_key_id_list(ids: darray[u8]&) -> ValidationCode:
            count: usize = ids.count / key_id_size
            for index in 0..<count |ids, count|:
                offset: usize = index * key_id_size
                for byte_index in 0..<key_id_size |ids, offset|:
                    byte: u8 = ids[offset + byte_index]
                    return ValidationCode.MalformedKeyId if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
                for previous in 0..<index |ids, offset|:
                    return ValidationCode.DuplicateKeyId if key_id_equal(ids, previous * key_id_size, ids, offset)
            return ValidationCode.WellFormed

        def valid_sha256_digest(value: darray[u8]&) -> bool:
            return false if value.count != 64.usize()
            for index in 0..<value.count |value|:
                byte: u8 = value[index]
                return false if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
            return true

        def valid_sha256_digest_range(raw: darray[u8]&, start: usize, finish: usize) -> bool:
            return false if finish < start or finish - start != 64.usize()
            for index in start..<finish |raw|:
                byte: u8 = raw[index]
                return false if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
            return true

        def tuf_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true

        def key_id_equal(left: darray[u8]&, left_offset: usize, right: darray[u8]&, right_offset: usize) -> bool:
            for byte_index in 0..<key_id_size |left, right, left_offset, right_offset|:
                return false if left[left_offset + byte_index] != right[right_offset + byte_index]
            return true
