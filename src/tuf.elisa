# Bounded policy primitives for the selected TUF v1.0.36 profile.
#
# This is not a TUF client: callers must still parse metadata, canonicalize the
# signed object, verify each signature, validate roles/delegations, and commit
# trusted state atomically before exposing targets. TUF v1.0.36 uses the OLPC
# Canonical JSON dialect; RFC 8785/JCS is not an interchangeable substitute.

include "./json.elisa"
include "./integrity.elisa"
include "./text/bytes.elisa"

module Tuf:
    public:
        const enum ValidationCode of u8:
            WellFormed
            UnsupportedSpecVersion
            MalformedKeyId
            DuplicateKeyId
            InvalidThreshold
            ThresholdInsufficient
            ResourceLimit
            MalformedJson
            InvalidJsonKeys
            NoncanonicalNumber
            UnsupportedHashAlgorithm
            MalformedHash
            MalformedCheckpointBatch

        const enum CheckpointCode of u8:
            Accepted
            Malformed
            Rollback
            Equivocation

        # Check one already-authenticated role checkpoint before the caller
        # includes it in the durable registry-state transaction. Digests are
        # SHA-256 over the canonical JSON encoding of the signed ROLE object;
        # parent metadata links still verify the full metadata-file bytes and
        # length. The caller must maintain separate floors per registry/role
        # and commit all accepted role checkpoints only after the full chain.
        def check_authenticated_checkpoint(previous_version: u64, previous_digest: darray[u8]&, candidate_version: u64, candidate_digest: darray[u8]&) -> CheckpointCode:
            return CheckpointCode.Malformed if candidate_version == 0.u64() or not Integrity::valid_sha256_hex(candidate_digest)
            if previous_version == 0.u64():
                return CheckpointCode.Malformed if previous_digest.count != 0.usize()
                return CheckpointCode.Accepted
            return CheckpointCode.Malformed if not Integrity::valid_sha256_hex(previous_digest)
            CheckpointCode.Rollback if candidate_version < previous_version else CheckpointCode.Equivocation if candidate_version == previous_version and not tuf_bytes_equal(candidate_digest, previous_digest) else CheckpointCode.Accepted

        # Batch format used by the protected checkpoint store:
        # `elisapkg-tuf-batch:1\n` followed by sorted, unique
        # `role version digest\n` records. Each digest is the SHA-256 of that
        # role's canonical signed object. Canonical ordering makes the
        # authenticated role set deterministic and lets storage merge it with
        # existing floors in linear time.
        def validate_checkpoint_batch(batch: darray[u8]&) -> ValidationCode can[Memory.Allocate, Abort.Panic]:
            return ValidationCode.ResourceLimit if batch.count > maximum_metadata_file_bytes
            return ValidationCode.MalformedCheckpointBatch if batch.count <= ByteText::text_length(checkpoint_batch_header) or not ByteText::starts_with_text(batch, checkpoint_batch_header)
            role_count: usize =
                while cursor < batch.count |cursor: usize = ByteText::text_length(checkpoint_batch_header), count: usize = 0.usize(), previous_role: darray[u8] = []| -> count:
                    finish: usize =
                        while line_end < batch.count and batch[line_end] != 10 |line_end: usize = cursor| -> line_end:
                            line_end <- line_end + 1.usize()
                    return ValidationCode.MalformedCheckpointBatch if finish == cursor or finish == batch.count
                    role: mutable darray[u8] = []
                    line_status: ValidationCode = validate_batch_line(batch, cursor, finish, &role)
                    if line_status != ValidationCode.WellFormed:
                        return line_status
                    else:
                        return ValidationCode.ResourceLimit if count >= maximum_checkpoint_roles
                        return ValidationCode.MalformedCheckpointBatch if count > 0.usize() and compare_checkpoint_role(previous_role, role) >= 0
                        ByteText::replace(&previous_role, role)
                        count <- count + 1.usize()
                        cursor <- finish + 1.usize()
            ValidationCode.MalformedCheckpointBatch if role_count == 0.usize() else ValidationCode.WellFormed

        # Check one "ROLE VERSION DIGEST" batch line spanning `cursor..<finish`
        # and return its role.
        def validate_batch_line(batch: darray[u8]&, cursor: usize, finish: usize, role: mutable darray[u8]&) -> ValidationCode can[Memory.Allocate, Abort.Panic]:
            requires cursor < finish and finish < batch.count
            first_separator: usize = while position < finish and batch[position] != 32 |position: usize = cursor| -> position:
                position <- position + 1.usize()
            second_separator: usize = while position < finish and batch[position] != 32 |position: usize = first_separator + 1.usize()| -> position:
                position <- position + 1.usize()
            return ValidationCode.MalformedCheckpointBatch if:
                first_separator == cursor or second_separator >= finish or first_separator + 1.usize() == second_separator or second_separator + 1.usize() == finish
                contains_byte_between(batch, second_separator + 1.usize(), finish, 32)
            ByteText::append_range(role, batch, cursor, first_separator)
            if not valid_checkpoint_role(role):
                ValidationCode.MalformedCheckpointBatch
            else:
                version: darray[u8] = [batch[index] for index in (first_separator + 1.usize())..<second_separator]
                parsed_version: mutable u64 = 0.u64()
                ValidationCode.MalformedCheckpointBatch if not parse_checkpoint_version(version, &parsed_version) else ValidationCode.MalformedHash if not Integrity::valid_sha256_hex_range(batch, second_separator + 1.usize(), finish) else ValidationCode.WellFormed

        def valid_checkpoint_role(role: darray[u8]&) -> bool:
            return false if role.count == 0.usize() or role.count > maximum_checkpoint_role_bytes
            return false if not checkpoint_role_alphanumeric(role[0]) or not checkpoint_role_alphanumeric(role[role.count - 1.usize()])
            for index in 0..<role.count |role, index|:
                byte: u8 = role[index]
                return false if not checkpoint_role_alphanumeric(byte) and byte != 45 and byte != 46 and byte != 95
            true

        # Parse one canonical, positive TUF metadata version without allowing
        # decimal truncation, leading zeroes, or uint64 overflow.
        def parse_checkpoint_version(raw: darray[u8]&, out: mutable u64&) -> bool:
            out <- 0.u64()
            value: mutable u64 = 0.u64()
            if ByteText::parse_canonical_unsigned_decimal(raw, 0, raw.count, &value) and value != 0.u64():
                out <- value
                true
            else:
                false

        # These limits bound a single repository refresh under the current
        # package-scoped delegation model. Changing them requires independent
        # metadata-size and worst-case-work review.
        const maximum_metadata_file_bytes: usize = Json::maximum_document_bytes
        const maximum_authorized_keys_per_role: usize = 64.usize()
        const maximum_registry_identity_bytes: usize = 128.usize()
        const maximum_signatures_per_metadata: usize = 64.usize()
        const maximum_delegated_roles: usize = 4096.usize()
        # The batch can contain roles retained from older metadata even when
        # the current root has revoked or removed them. The byte cap remains
        # the tighter practical bound for long identities and digest records.
        const maximum_checkpoint_roles: usize = 32768.usize()
        const maximum_checkpoint_role_bytes: usize = 128.usize()
        const maximum_delegation_depth: usize = 1.usize()
        const maximum_targets_per_package_role: usize = 4096.usize()
        const maximum_root_updates_per_refresh: usize = 1024.usize()
        const maximum_json_container_depth: usize = Json::maximum_container_depth
        const maximum_json_object_keys: usize = Json::maximum_object_keys
        const maximum_duplicate_key_candidates: usize = Json::maximum_duplicate_key_candidates
        const maximum_duplicate_key_comparison_bytes: usize = Json::maximum_duplicate_key_comparison_bytes

        # Bounded syntax precheck for the pinned metadata profile. This does
        # not decode role schemas, canonicalize signed bytes, verify signatures,
        # or authorize targets.
        def precheck_metadata_json(raw: darray[u8]&) -> ValidationCode can[Memory.Allocate, Abort.Panic]:
            return ValidationCode.MalformedJson if raw.count == 0.usize()
            return ValidationCode.ResourceLimit if raw.count > maximum_metadata_file_bytes
            return ValidationCode.MalformedJson if not Json::valid_document(raw)
            ValidationCode.InvalidJsonKeys if not Json::unique_object_keys(raw) else ValidationCode.NoncanonicalNumber if not tuf_integer_numbers_only(raw) else ValidationCode.WellFormed

        # The selected package profile allows SHA-256 only in TUF `hashes`
        # maps. This bounded lexical pass runs after general JSON validation;
        # it does not replace the upstream schema or target-length checks.
        def precheck_sha256_hashes(raw: darray[u8]&) -> ValidationCode can[Memory.Allocate, Abort.Panic]:
            syntax_status: ValidationCode = precheck_metadata_json(raw)
            if syntax_status != ValidationCode.WellFormed:
                syntax_status
            else:
                while cursor < raw.count |cursor: usize = 0.usize(), content_end: usize = 0.usize(), after_string: usize = 0.usize(), hashes_end: usize = 0.usize()|:
                    if raw[cursor] != 34:
                        cursor <- cursor + 1.usize()
                        continue
                    content_end <- json_string_content_end(raw, cursor)
                    return ValidationCode.MalformedJson if content_end >= raw.count
                    after_string <- Json::skip_whitespace(raw, content_end + 1.usize(), raw.count)
                    if after_string < raw.count and raw[after_string] == 58 and ByteText::range_equals_text(raw, cursor + 1.usize(), content_end, "hashes"):
                        # The cursor moves to the opening brace of the hashes map.
                        cursor <- Json::skip_whitespace(raw, after_string + 1.usize(), raw.count)
                        return ValidationCode.MalformedHash if cursor >= raw.count or raw[cursor] != 123
                        hash_status: ValidationCode = validate_sha256_hash_map(raw, cursor, &hashes_end)
                        cursor <- hashes_end
                        return hash_status if hash_status != ValidationCode.WellFormed
                    else:
                        cursor <- content_end + 1.usize()
                ValidationCode.WellFormed

        # Registry identities are stable configuration labels, never URLs or
        # credentials. TUF targets must echo this configured token exactly.
        def valid_registry_identity_bytes(value: darray[u8]&) -> bool:
            return false if value.count == 0.usize() or value.count > maximum_registry_identity_bytes or not checkpoint_role_alphanumeric(value[0])
            for index in 0..<value.count |value, index|:
                byte: u8 = value[index]
                return false if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 122) or byte == 46 or byte == 95 or byte == 58 or byte == 45)
            true

        # The selected profile accepts stable 1.0.P versions through the pinned
        # v1.0.36 patch, inclusive. This checks only the protocol version text;
        # it does not validate or authenticate a metadata document.
        def precheck_spec_version(value: darray[u8]&) -> ValidationCode:
            return ValidationCode.UnsupportedSpecVersion if:
                value.count < 5.usize() or value.count > 6.usize()
                value[0] != 49 or value[1] != 46 or value[2] != 48 or value[3] != 46
            patch: u64 =
                patch_start: usize = 4.usize()
                return ValidationCode.UnsupportedSpecVersion if:
                    value[patch_start] < 48 or value[patch_start] > 57
                    value.count == 6.usize() and (value[patch_start] == 48 or value[5] < 48 or value[5] > 57)
                (value[patch_start] - 48).u64() * 10.u64() + (value[5] - 48).u64() if value.count == 6.usize() else (value[patch_start] - 48).u64()
            ValidationCode.UnsupportedSpecVersion if patch > 36.u64() else ValidationCode.WellFormed

        # Validate the shape of the authorized and supplied signature key-identifier
        # lists. Each input is a flat sequence of 64-byte lowercase SHA-256
        # hex IDs. Unknown supplied IDs are permitted but cannot satisfy the
        # role threshold. The matching count is only a pre-verification upper
        # bound: it does not prove that any signature is cryptographically
        # valid or authorized by the exact role metadata.
        def precheck_signature_key_identifiers(authorized_identifiers: darray[u8]&, supplied_identifiers: darray[u8]&, threshold: u64) -> ValidationCode:
            return ValidationCode.ResourceLimit if authorized_identifiers.count > maximum_authorized_keys_per_role * key_identifier_size or supplied_identifiers.count > maximum_signatures_per_metadata * key_identifier_size
            return ValidationCode.MalformedKeyId if authorized_identifiers.count % key_identifier_size != 0.usize() or supplied_identifiers.count % key_identifier_size != 0.usize()
            return ValidationCode.InvalidThreshold if threshold == 0.u64() or threshold > (authorized_identifiers.count / key_identifier_size).u64()
            authorized_status: ValidationCode = validate_key_identifier_list(authorized_identifiers)
            supplied_status: ValidationCode = validate_key_identifier_list(supplied_identifiers)
            if authorized_status != ValidationCode.WellFormed:
                authorized_status
            elif supplied_status != ValidationCode.WellFormed:
                supplied_status
            else:
                # Each supplied identifier counts once when it is authorized.
                authorized_signatures: usize =
                    for supplied_index in 0..<(supplied_identifiers.count / key_identifier_size) |count: usize = 0.usize()| -> count:
                        listed: bool =
                            for authorized_index in 0..<(authorized_identifiers.count / key_identifier_size) |found: bool = false| -> found:
                                break true if key_identifier_equal(authorized_identifiers, authorized_index * key_identifier_size, supplied_identifiers, supplied_index * key_identifier_size)
                        count <- count + 1.usize() if listed
                ValidationCode.ThresholdInsufficient if authorized_signatures.u64() < threshold else ValidationCode.WellFormed

    private:
        const key_identifier_size: usize = 64.usize()
        const checkpoint_batch_header: cstr = "elisapkg-tuf-batch:1\n"

        def compare_checkpoint_role(left: darray[u8]&, right: darray[u8]&) -> i64:
            prefix_order: i64 =
                common: usize = left.count if left.count < right.count else right.count
                for index in 0..<common |order: i64 = 0| -> order:
                    break -1 if left[index] < right[index]
                    break 1 if left[index] > right[index]
            prefix_order if prefix_order != 0 else -1 if left.count < right.count else 1 if left.count > right.count else 0

        def contains_byte_between(value: darray[u8]&, start: usize, finish: usize, wanted: u8) -> bool:
            for index in start..<finish |value|:
                return true if value[index] == wanted
            false

        def checkpoint_role_alphanumeric(byte: u8) -> bool:
            (byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 122)

        def tuf_integer_numbers_only(raw: darray[u8]&) -> bool:
            # A backslash only escapes inside a string, so an open escape
            # always means an open string.
            string_open: bool =
                while cursor < raw.count |cursor: usize = 0.usize(), in_string: bool = false, escaped: bool = false| -> in_string:
                    byte: u8 = raw[cursor]
                    if in_string:
                        if escaped:
                            escaped <- false
                        elif byte == 92:
                            escaped <- true
                        elif byte == 34:
                            in_string <- false
                        cursor <- cursor + 1.usize()
                    elif byte == 34:
                        in_string <- true
                        cursor <- cursor + 1.usize()
                    elif byte == 45 or (byte >= 48 and byte <= 57):
                        cursor <-
                            number_end: usize =
                                while number_cursor < raw.count and ((raw[number_cursor] >= 48 and raw[number_cursor] <= 57) or raw[number_cursor] == 46 or raw[number_cursor] == 69 or raw[number_cursor] == 101 or raw[number_cursor] == 43 or raw[number_cursor] == 45) |number_cursor: usize = cursor + 1.usize()| -> number_cursor:
                                    # Fractions and exponents are not canonical TUF numbers.
                                    return false if raw[number_cursor] == 46 or raw[number_cursor] == 69 or raw[number_cursor] == 101
                                    number_cursor <- number_cursor + 1.usize()
                            return false if number_end - cursor == 2.usize() and raw[cursor] == 45 and raw[cursor + 1.usize()] == 48
                            number_end
                    else:
                        cursor <- cursor + 1.usize()
            not string_open

        def validate_sha256_hash_map(raw: darray[u8]&, object_start: usize, end_out: mutable usize&) -> ValidationCode:
            end_out <- 0.usize()
            first_entry: usize = Json::skip_whitespace(raw, object_start + 1.usize(), raw.count)
            if first_entry >= raw.count or raw[first_entry] == 125:
                ValidationCode.MalformedHash
            else:
                # `string_end` is the closing quote of the key, then of the digest.
                while cursor < raw.count |cursor: usize = first_entry, string_end: usize = 0.usize()|:
                    return ValidationCode.MalformedHash if raw[cursor] != 34
                    string_end <- json_string_content_end(raw, cursor)
                    return ValidationCode.MalformedHash if string_end >= raw.count
                    return ValidationCode.UnsupportedHashAlgorithm if not ByteText::range_equals_text(raw, cursor + 1.usize(), string_end, "sha256")
                    cursor <- Json::skip_whitespace(raw, string_end + 1.usize(), raw.count)
                    return ValidationCode.MalformedHash if cursor >= raw.count or raw[cursor] != 58
                    cursor <- Json::skip_whitespace(raw, cursor + 1.usize(), raw.count)
                    return ValidationCode.MalformedHash if cursor >= raw.count or raw[cursor] != 34
                    string_end <- json_string_content_end(raw, cursor)
                    return ValidationCode.MalformedHash if string_end >= raw.count or not Integrity::valid_sha256_hex_range(raw, cursor + 1.usize(), string_end)
                    cursor <- Json::skip_whitespace(raw, string_end + 1.usize(), raw.count)
                    if cursor < raw.count and raw[cursor] == 125:
                        end_out <- cursor + 1.usize()
                        return ValidationCode.WellFormed
                    return ValidationCode.MalformedHash if cursor >= raw.count or raw[cursor] != 44
                    cursor <- Json::skip_whitespace(raw, cursor + 1.usize(), raw.count)
                ValidationCode.MalformedHash

        def json_string_content_end(raw: darray[u8]&, quote_start: usize) -> usize:
            while cursor < raw.count |cursor: usize = quote_start + 1.usize()|:
                return cursor if raw[cursor] == 34
                cursor <- cursor + 2.usize() if raw[cursor] == 92 else cursor + 1.usize()
            raw.count

        def validate_key_identifier_list(identifiers: darray[u8]&) -> ValidationCode:
            for index in 0..<(identifiers.count / key_identifier_size) |identifiers|:
                offset: usize = index * key_identifier_size
                for byte_index in 0..<key_identifier_size |identifiers, offset|:
                    byte: u8 = identifiers[offset + byte_index]
                    return ValidationCode.MalformedKeyId if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
                for previous in 0..<index |identifiers, offset|:
                    return ValidationCode.DuplicateKeyId if key_identifier_equal(identifiers, previous * key_identifier_size, identifiers, offset)
            ValidationCode.WellFormed

        def tuf_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            true

        def key_identifier_equal(left: darray[u8]&, left_offset: usize, right: darray[u8]&, right_offset: usize) -> bool:
            for byte_index in 0..<key_identifier_size |left, right, left_offset, right_offset|:
                return false if left[left_offset + byte_index] != right[right_offset + byte_index]
            true
