# Bounded JSON lexical safety checks shared by manifest and lock boundaries.
# This is intentionally a small structural pass, not a value decoder. It
# rejects duplicate keys in every object so later field lookup cannot silently
# choose a different meaning from another conforming JSON implementation.

include "./text/bytes.elisa"
include "./text/utf8.elisa"

module Json:
    public:
        # Locate a closing delimiter in an already validated document.
        # Return raw.count if the requested container is missing or unfinished.
        def object_end(raw: darray[u8]&, start: usize) -> usize:
            return container_end(raw, start, 123, 125)

        def array_end(raw: darray[u8]&, start: usize) -> usize:
            return container_end(raw, start, 91, 93)

        const max_document_bytes: usize = 1048576.usize()
        const max_container_depth: usize = 64.usize()
        # TUF package-target metadata may contain several fields per target.
        # Keep a document-wide key ceiling above the target-count bound while
        # separately limiting collision work and compared bytes below.
        const max_object_keys: usize = 65536.usize()
        # Covers 4096 target keys' pairwise scans plus a bounded allowance for
        # members inside each target record; hash-collision work also fails closed.
        const max_duplicate_key_candidates: usize = 8500000.usize()
        const max_duplicate_key_comparison_bytes: usize = 65536.usize()

        def root_start(raw: darray[u8]&) -> usize:
            return skip_spaces(raw, 0.usize(), raw.count)

        def root_object_end(raw: darray[u8]&, start: usize) -> usize:
            finish: usize = object_end(raw, start)
            return raw.count if finish == raw.count
            for index in (finish + 1.usize())..<raw.count |raw|:
                return raw.count if not is_space(raw[index])
            return finish

        def root_value_offset(raw: darray[u8]&, wanted: cstr) -> usize:
            start: usize = root_start(raw)
            return direct_value_offset(raw, start, root_object_end(raw, start), wanted)

        def unsigned_at(raw: darray[u8]&, start: usize, finish: usize, out: mutable u64&) -> bool:
            out <- 0.u64()
            return false if finish > raw.count or start >= finish
            first_digit: usize = skip_spaces(raw, start, finish)
            cursor, value =
                while cursor < finish and raw[cursor] >= 48 and raw[cursor] <= 57 |cursor: usize = first_digit, value: u64 = 0| -> (cursor, value):
                    digit: u64 = (raw[cursor] - 48).u64()
                    return false if value > (18446744073709551615.u64() - digit) / 10.u64()
                    value <- value * 10.u64() + digit
                    cursor <- cursor + 1.usize()
            return false if cursor == first_digit or skip_spaces(raw, cursor, finish) != finish
            out <- value
            return true

        # Field readers expect a validated object and a literal, unescaped key.
        def object_has_key(raw: darray[u8]&, start: usize, finish: usize, wanted: cstr) -> bool:
            return direct_value_offset(raw, start, finish, wanted) < finish

        def object_string_value(raw: darray[u8]&, start: usize, finish: usize, wanted: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            value_start: usize = direct_value_offset(raw, start, finish, wanted)
            return false if value_start >= raw.count or value_start >= finish or raw[value_start] != 34
            content_start: usize = value_start + 1.usize()
            content_end: usize =
                while cursor < finish and raw[cursor] != 34 |cursor: usize = content_start| -> cursor:
                    return false if raw[cursor] < 32 or raw[cursor] == 92
                    cursor <- cursor + 1.usize()
            return false if content_end == finish
            ByteText::append_range(out, raw, content_start, content_end)
            return true

        def object_value_span(raw: darray[u8]&, start: usize, finish: usize, wanted: cstr, value_start_out: mutable usize&, value_end_out: mutable usize&) -> bool:
            value_start_out <- 0.usize()
            value_end_out <- 0.usize()
            value_start: usize = direct_value_offset(raw, start, finish, wanted)
            return false if value_start >= raw.count or value_start >= finish or raw[value_start] != 123
            value_end: usize = object_end(raw, value_start)
            return false if value_end >= finish
            value_start_out <- value_start
            value_end_out <- value_end
            return true

        def object_unsigned_value(raw: darray[u8]&, start: usize, finish: usize, wanted: cstr, out: mutable u64&) -> bool:
            out <- 0.u64()
            value_start: usize = direct_value_offset(raw, start, finish, wanted)
            return false if value_start >= raw.count or value_start >= finish
            value_end: usize =
                while cursor < finish and raw[cursor] != 44 and raw[cursor] != 125 |cursor: usize = value_start| -> cursor:
                    cursor <- cursor + 1.usize()
            return unsigned_at(raw, value_start, value_end, out)

        # Iterative grammar validation; stack states distinguish object keys,
        # values and separators, with a fixed maximum nesting depth.
        def valid_document(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if raw.count == 0.usize() or raw.count > max_document_bytes or not valid_utf8(raw)
            frames: mutable darray[GrammarFrame] = [GrammarFrame{kind: ContainerKind.Root, state: GrammarState.Value}]
            cursor: mutable usize = 0.usize()
            while cursor < raw.count:
                byte: u8 = raw[cursor]
                if is_space(byte):
                    cursor <- cursor + 1.usize()
                    continue
                top: usize = frames.count - 1.usize()
                frame: GrammarFrame = frames[top]
                state: GrammarState = frame.state
                return false if state == GrammarState.Done
                object_closes: bool = frame.kind == ContainerKind.Object and (state == GrammarState.FirstKey or state == GrammarState.ObjectSeparator) and byte == 125
                array_closes: bool = frame.kind == ContainerKind.Array and (state == GrammarState.FirstArrayValue or state == GrammarState.ArraySeparator) and byte == 93
                if object_closes or array_closes:
                    frames <- frames.resize(top)
                    cursor <- cursor + 1.usize()
                    continue
                if state == GrammarState.Colon:
                    return false if byte != 58
                    frames[top].state <- GrammarState.Value
                    cursor <- cursor + 1.usize()
                    continue
                if state == GrammarState.ObjectSeparator or state == GrammarState.ArraySeparator:
                    return false if byte != 44
                    frames[top].state <- GrammarState.Key if state == GrammarState.ObjectSeparator else GrammarState.Value
                    cursor <- cursor + 1.usize()
                    continue
                object_key: bool = state == GrammarState.FirstKey or state == GrammarState.Key
                expects_value: bool = state == GrammarState.Value or state == GrammarState.FirstArrayValue
                return false if:
                    object_key and byte != 34
                    not object_key and not expects_value
                if byte == 34:
                    cursor <- string_end(raw, cursor + 1.usize(), object_key)
                    return false if cursor == 0.usize()
                    frames[top].state <- GrammarState.Colon if object_key else after_value(frame.kind)
                elif byte == 123 or byte == 91:
                    return false if not expects_value or frames.count > max_container_depth
                    # The parent resumes only after this child frame is closed.
                    frames[top].state <- after_value(frame.kind)
                    child: GrammarFrame = GrammarFrame{kind: ContainerKind.Object, state: GrammarState.FirstKey} if byte == 123 else GrammarFrame{kind: ContainerKind.Array, state: GrammarState.FirstArrayValue}
                    frames <- frames.push(child)
                    cursor <- cursor + 1.usize()
                else:
                    start: usize = cursor
                    while cursor < raw.count and not is_space(raw[cursor]) and raw[cursor] != 44 and raw[cursor] != 93 and raw[cursor] != 125:
                        cursor <- cursor + 1.usize()
                    return false if not json_scalar(raw, start, cursor)
                    frames[top].state <- after_value(frame.kind)
            return frames.count == 1.usize() and frames[0].state == GrammarState.Done

        def valid_utf8(raw: darray[u8]&) -> bool:
            return Utf8::valid(raw)

        def unique_object_keys(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if raw.count == 0.usize() or raw.count > max_document_bytes
            # Keep each object's keys in a linked chain. Nested objects may
            # interleave their keys with a parent's keys in the input, so a
            # flat scan needlessly compares every key against unrelated
            # objects as well.
            object_last_keys: mutable darray[usize] = []
            keys: mutable darray[ObjectKey] = []
            candidate_checks: mutable usize = 0.usize()
            comparison_bytes: mutable usize = 0.usize()
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0.usize()
            for index in 0..<raw.count |raw, object_last_keys, keys, candidate_checks, comparison_bytes, in_string, escaped, string_start|:
                byte: u8 = raw[index]
                if in_string:
                    if escaped:
                        escaped <- false
                    elif byte == 92:
                        escaped <- true
                    elif byte == 34:
                        after: usize = skip_spaces(raw, index + 1.usize(), raw.count)
                        if after < raw.count and raw[after] == 58 and object_last_keys.count > 0.usize():
                            object_index: usize = object_last_keys.count - 1.usize()
                            key: ObjectKey = ObjectKey{hash: key_hash(raw, string_start, index), start: string_start, length: index - string_start, previous: object_last_keys[object_index]}
                            return false if:
                                duplicate_key(raw, key, keys, &candidate_checks, &comparison_bytes)
                                keys.count >= max_object_keys
                            object_last_keys[object_index] <- keys.count
                            keys <- keys.push(key)
                        in_string <- false
                    continue
                if byte == 34:
                    in_string <- true
                    string_start <- index + 1.usize()
                elif byte == 123:
                    return false if object_last_keys.count >= max_container_depth
                    object_last_keys <- object_last_keys.push(no_key)
                elif byte == 125:
                    return false if object_last_keys.count == 0.usize()
                    object_last_keys <- object_last_keys.resize(object_last_keys.count - 1.usize())
            return false if in_string or escaped or object_last_keys.count != 0.usize()
            return true

    private:
        const enum ContainerKind of u8:
            Root
            Object
            Array

        const enum GrammarState of u8:
            Value
            Done
            FirstKey
            Key
            Colon
            ObjectSeparator
            FirstArrayValue
            ArraySeparator

        struct GrammarFrame:
            kind: ContainerKind
            state: mutable GrammarState

        def after_value(kind: ContainerKind) -> GrammarState:
            return GrammarState.ObjectSeparator if kind == ContainerKind.Object
            return GrammarState.ArraySeparator if kind == ContainerKind.Array
            return GrammarState.Done

        def direct_value_offset(raw: darray[u8]&, object_start: usize, finish: usize, wanted: cstr) -> usize:
            return raw.count if:
                finish >= raw.count or object_start >= finish
                raw[object_start] != 123 or raw[finish] != 125
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0.usize()
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (object_start + 1.usize())..<finish |raw, finish, wanted, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1.usize()
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    if braces == 1 and brackets == 0 and ByteText::range_equals_text(raw, string_start, index, wanted):
                        after: usize = skip_spaces(raw, index + 1.usize(), finish)
                        if after < finish and raw[after] == 58:
                            return skip_spaces(raw, after + 1.usize(), finish)
                    in_string <- false
            return raw.count

        def container_end(raw: darray[u8]&, start: usize, opening: u8, closing: u8) -> usize:
            return raw.count if start >= raw.count or raw[start] != opening
            depth: mutable i64 = 0
            in_string: mutable bool = false
            escaped: mutable bool = false
            for index in start..<raw.count |raw, depth, in_string, escaped, opening, closing|:
                byte: u8 = raw[index]
                if in_string:
                    if escaped:
                        escaped <- false
                    elif byte == 92:
                        escaped <- true
                    elif byte == 34:
                        in_string <- false
                elif byte == 34:
                    in_string <- true
                elif byte == opening:
                    depth <- depth + 1
                elif byte == closing:
                    depth <- depth - 1
                    return index if depth == 0
                    return raw.count if depth < 0
            return raw.count

        # A 4096-target role can require over eight million candidate comparisons.
        # Keep that work ceiling explicit and shared with callers.
        def json_scalar(raw: darray[u8]&, start: usize, end: usize) -> bool:
            return false if start >= end
            first: u8 = raw[start]
            return ByteText::range_equals_text(raw, start, end, "true") if first == 116
            return ByteText::range_equals_text(raw, start, end, "null") if first == 110
            return ByteText::range_equals_text(raw, start, end, "false") if first == 102
            integer_start: usize = start + 1.usize() if first == 45 else start
            return false if integer_start >= end
            cursor: mutable usize = integer_start
            if raw[integer_start] == 48:
                cursor <- integer_start + 1.usize()
            else:
                cursor <- decimal_digits_end(raw, integer_start, end)
                return false if cursor == integer_start
            if cursor < end and raw[cursor] == 46:
                fraction_start: usize = cursor + 1.usize()
                cursor <- decimal_digits_end(raw, fraction_start, end)
                return false if cursor == fraction_start
            if cursor < end and (raw[cursor] == 101 or raw[cursor] == 69):
                cursor <- cursor + 1.usize()
                if cursor < end and (raw[cursor] == 43 or raw[cursor] == 45):
                    cursor <- cursor + 1.usize()
                exponent_start: usize = cursor
                cursor <- decimal_digits_end(raw, exponent_start, end)
                return false if cursor == exponent_start
            return cursor == end

        def decimal_digits_end(raw: darray[u8]&, start: usize, end: usize) -> usize:
            requires start <= end and end <= raw.count
            ensure result >= start and result <= end
            return while cursor < end and raw[cursor] >= 48 and raw[cursor] <= 57 |cursor: usize = start| -> cursor:
                cursor <- cursor + 1.usize()

        # Return the offset after the closing quote, or zero on rejection.
        def string_end(raw: darray[u8]&, start: usize, object_key: bool) -> usize:
            cursor: mutable usize = start
            while cursor < raw.count:
                byte: u8 = raw[cursor]
                cursor <- cursor + 1.usize()
                return cursor if byte == 34
                return 0.usize() if byte < 32
                continue if byte != 92
                # Escaped keys would bypass literal field lookup and duplicate checks.
                return 0.usize() if object_key or cursor >= raw.count
                escape: u8 = raw[cursor]
                if escape == 117:
                    escape_size: usize = unicode_escape_size(raw, cursor)
                    return 0.usize() if escape_size == 0.usize()
                    cursor <- cursor + escape_size
                else:
                    return 0.usize() if escape != 34 and escape != 92 and escape != 47 and escape != 98 and escape != 102 and escape != 110 and escape != 114 and escape != 116
                    cursor <- cursor + 1.usize()
            return 0.usize()

        # The cursor points at the 'u'. A high surrogate must be followed by
        # a low surrogate. Isolated surrogate code units are rejected.
        def unicode_escape_size(raw: darray[u8]&, cursor: usize) -> usize:
            return 0.usize() if cursor + 4.usize() >= raw.count
            code_unit: i64 = hexadecimal_code_unit(raw, cursor + 1.usize())
            return 0.usize() if code_unit < 0 or (code_unit >= 56320 and code_unit <= 57343)
            if code_unit >= 55296 and code_unit <= 56319:
                return 0.usize() if cursor + 10.usize() >= raw.count or raw[cursor + 5.usize()] != 92 or raw[cursor + 6.usize()] != 117
                low_surrogate: i64 = hexadecimal_code_unit(raw, cursor + 7.usize())
                return 0.usize() if low_surrogate < 56320 or low_surrogate > 57343
                return 11.usize()
            return 5.usize()

        def hexadecimal_code_unit(raw: darray[u8]&, start: usize) -> i64:
            requires start <= raw.count and raw.count - start >= 4.usize()
            ensure result >= -1 and result <= 65535
            return for index in start..<(start + 4.usize()) |code_unit: i64 = 0| -> code_unit:
                digit: i64 = json_hex_nibble(raw[index])
                return -1 if digit < 0
                code_unit <- code_unit * 16 + digit

        def json_hex_nibble(byte: u8) -> i64:
            return (byte - 48).i64() if byte >= 48 and byte <= 57
            return (byte - 55).i64() if byte >= 65 and byte <= 70
            return (byte - 87).i64() if byte >= 97 and byte <= 102
            return -1

        def key_hash(raw: darray[u8]&, start: usize, end: usize) -> u32:
            return for index in start..<end |hash: u32 = 2166136261.u32()| -> hash:
                hash <- (hash ^ raw[index].u32()) * 16777619.u32()

        def is_space(byte: u8) -> bool:
            return byte == 32 or byte == 9 or byte == 10 or byte == 13

        def skip_spaces(raw: darray[u8]&, start: usize, finish: usize) -> usize:
            requires start <= finish and finish <= raw.count
            ensure result >= start and result <= finish
            return while cursor < finish and is_space(raw[cursor]) |cursor: usize = start| -> cursor:
                cursor <- cursor + 1.usize()

        # The stack uses an out-of-range key index for an object with no keys.
        const no_key: usize = max_object_keys

        struct ObjectKey:
            hash: u32
            start: usize
            length: usize
            previous: usize

        def duplicate_key(raw: darray[u8]&, key: ObjectKey, keys: darray[ObjectKey]&, candidate_checks: mutable usize&, comparison_bytes: mutable usize&) -> bool:
            item: mutable usize = key.previous
            while item != no_key:
                return true if candidate_checks >= max_duplicate_key_candidates
                candidate_checks <- candidate_checks + 1.usize()
                prior: ObjectKey = keys[item]
                if prior.hash == key.hash and prior.length == key.length:
                    # Charge the full span before comparing, even for a hash collision.
                    return true if key.length > max_duplicate_key_comparison_bytes - comparison_bytes
                    comparison_bytes <- comparison_bytes + key.length
                    matches: bool =
                        for offset in 0..<key.length |matches: bool = true| -> matches:
                            break false if raw[key.start + offset] != raw[prior.start + offset]
                    return true if matches
                item <- prior.previous
            return false
