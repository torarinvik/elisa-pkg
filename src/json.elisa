# Bounded JSON lexical safety checks shared by manifest and lock boundaries.
# This is intentionally a small structural pass, not a value decoder. It
# rejects duplicate keys in every object so later field lookup cannot silently
# choose a different meaning from another conforming JSON implementation.

module Json:
    public:
        # Locate a closing delimiter in an already validated document.
        # Return raw.count if the requested container is missing or unfinished.
        def object_end(raw: darray[u8]&, start: usize) -> usize:
            return container_end(raw, start, 123, 125)

        def array_end(raw: darray[u8]&, start: usize) -> usize:
            return container_end(raw, start, 91, 93)

        const max_document_bytes: usize = 1048576.usize()
        const max_container_depth: usize = 64.usize()
        # TUF package-target metadata may contain several fields per target.
        # Keep a document-wide key ceiling above the target-count bound while
        # separately limiting collision work and compared bytes below.
        const max_object_keys: usize = 65536.usize()
        # Covers 4096 target keys' pairwise scans plus a bounded allowance for
        # members inside each target record; hash-collision work also fails closed.
        const max_duplicate_key_candidates: usize = 8500000.usize()
        const max_duplicate_key_comparison_bytes: usize = 65536.usize()

        def root_start(raw: darray[u8]&) -> usize:
            start: mutable usize = 0.usize()
            while start < raw.count and is_space(raw[start]) |raw, start|:
                start <- start + 1.usize()
            return start

        def root_object_end(raw: darray[u8]&, start: usize) -> usize:
            finish: usize = object_end(raw, start)
            return raw.count if finish == raw.count
            for index in (finish + 1.usize())..<raw.count |raw|:
                return raw.count if not is_space(raw[index])
            return finish

        def root_value_offset(raw: darray[u8]&, wanted: cstr) -> usize:
            start: usize = root_start(raw)
            return direct_value_offset(raw, start, root_object_end(raw, start), wanted)

        def unsigned_at(raw: darray[u8]&, start: usize, finish: usize, out: mutable u64&) -> bool:
            out <- 0.u64()
            return false if finish > raw.count or start >= finish
            cursor: mutable usize = start
            while cursor < finish and (raw[cursor] == 32 or raw[cursor] == 9 or raw[cursor] == 10 or raw[cursor] == 13) |raw, cursor|:
                cursor <- cursor + 1.usize()
            return false if cursor >= finish or raw[cursor] < 48 or raw[cursor] > 57
            value: mutable u64 = 0
            digits: mutable usize = 0.usize()
            while cursor < finish and raw[cursor] >= 48 and raw[cursor] <= 57 |raw, cursor, value, digits|:
                digit: u64 = (raw[cursor] - 48).u64()
                return false if value > (18446744073709551615.u64() - digit) / 10.u64()
                value <- value * 10.u64() + digit
                digits <- digits + 1.usize()
                cursor <- cursor + 1.usize()
            return false if digits == 0.usize()
            while cursor < finish and (raw[cursor] == 32 or raw[cursor] == 9 or raw[cursor] == 10 or raw[cursor] == 13) |raw, cursor|:
                cursor <- cursor + 1.usize()
            return false if cursor != finish
            out <- value
            return true

        # Field readers expect a validated object and a literal, unescaped key.
        def object_string_value(raw: darray[u8]&, start: usize, finish: usize, wanted: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            value_start: usize = direct_value_offset(raw, start, finish, wanted)
            return false if value_start >= raw.count or value_start >= finish or raw[value_start] != 34
            content_start: usize = value_start + 1.usize()
            content_end: mutable usize = content_start
            while content_end < finish and raw[content_end] != 34 |raw, finish, content_end|:
                return false if raw[content_end] < 32 or raw[content_end] == 92
                content_end <- content_end + 1.usize()
            return false if content_end == finish
            for index in content_start..<content_end |raw, out|:
                out.push(raw[index])
            return true

        def object_value_span(raw: darray[u8]&, start: usize, finish: usize, wanted: cstr, value_start_out: mutable usize&, value_end_out: mutable usize&) -> bool:
            value_start_out <- 0.usize()
            value_end_out <- 0.usize()
            value_start: usize = direct_value_offset(raw, start, finish, wanted)
            return false if value_start >= raw.count or value_start >= finish or raw[value_start] != 123
            value_end: usize = object_end(raw, value_start)
            return false if value_end >= finish
            value_start_out <- value_start
            value_end_out <- value_end
            return true

        def object_unsigned_value(raw: darray[u8]&, start: usize, finish: usize, wanted: cstr, out: mutable u64&) -> bool:
            out <- 0.u64()
            value_start: usize = direct_value_offset(raw, start, finish, wanted)
            return false if value_start >= raw.count or value_start >= finish
            value_end: mutable usize = value_start
            while value_end < finish and raw[value_end] != 44 and raw[value_end] != 125 |raw, finish, value_end|:
                value_end <- value_end + 1.usize()
            return unsigned_at(raw, value_start, value_end, out)

        # Iterative grammar validation; stack states distinguish object keys,
        # values and separators, with a fixed maximum nesting depth.
        def valid_document(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if raw.count == 0.usize() or raw.count > max_document_bytes or not valid_utf8(raw)
            # The root frame has kind 0. Object frames use kind 1 and array
            # frames use kind 2. A frame state is one of:
            #   root: 0=value, 1=done
            #   object: 2=key-or-close, 3=key-after-comma, 4=colon,
            #           5=comma-or-close
            #   array: 6=value-or-close-at-start, 7=comma-or-close,
            #          0=value-after-comma
            # Parent frames are marked 8 (object), 9 (array), or 10 (root)
            # while a nested value is being parsed. Keeping container kind
            # separate avoids inferring it from a transient value state.
            states: mutable darray[u8] = [0]
            kinds: mutable darray[u8] = [0]
            cursor: mutable usize = 0.usize()
            while cursor < raw.count:
                byte: u8 = raw[cursor]
                if is_space(byte):
                    cursor <- cursor + 1.usize()
                    continue
                top: usize = states.count - 1.usize()
                state: u8 = states[top]
                if state == 1:
                    return false
                if kinds[top] == 1 and (state == 2 or state == 5) and byte == 125:
                    states.resize(top)
                    kinds.resize(top)
                    current: usize = states.count - 1.usize()
                    states[current] <- 1 if states[current] == 10 else (5 if states[current] == 8 else 7)
                    cursor <- cursor + 1.usize()
                    continue
                if kinds[top] == 2 and (state == 6 or state == 7) and byte == 93:
                    states.resize(top)
                    kinds.resize(top)
                    current: usize = states.count - 1.usize()
                    states[current] <- 1 if states[current] == 10 else (5 if states[current] == 8 else 7)
                    cursor <- cursor + 1.usize()
                    continue
                if state == 4:
                    return false if byte != 58
                    states[top] <- 0
                    cursor <- cursor + 1.usize()
                    continue
                if state == 5 or state == 7:
                    return false if byte != 44
                    states[top] <- 3 if state == 5 else 0
                    cursor <- cursor + 1.usize()
                    continue
                object_key: bool = kinds[top] == 1 and (state == 2 or state == 3)
                expects_value: bool = state == 0 or state == 6
                return false if object_key and byte != 34
                return false if not object_key and not expects_value
                if byte == 34:
                    cursor <- cursor + 1.usize()
                    closed: mutable bool = false
                    while cursor < raw.count:
                        char: u8 = raw[cursor]
                        cursor <- cursor + 1.usize()
                        if char == 34:
                            closed <- true
                            break
                        return false if char < 32
                        if char == 92:
                            # Schema lookups and duplicate-key tracking use
                            # literal UTF-8 key bytes. Reject escaped key
                            # spellings so equivalent JSON member names cannot
                            # bypass those checks; value escapes remain valid.
                            return false if object_key
                            return false if cursor >= raw.count
                            escape: u8 = raw[cursor]
                            if escape == 117:
                                return false if cursor + 4.usize() >= raw.count
                                code_unit: mutable u64 = 0.u64()
                                for digit in 1..<5 |raw, cursor|:
                                    nibble: i64 = json_hex_nibble(raw[cursor + digit])
                                    return false if nibble < 0
                                    code_unit <- code_unit * 16.u64() + nibble.u64()
                                if code_unit >= 55296.u64() and code_unit <= 56319.u64():
                                    # UTF-16 high surrogates must be followed
                                    # immediately by one escaped low surrogate.
                                    # Accepting isolated code units lets JSON
                                    # consumers disagree about the signed text.
                                    return false if cursor + 10.usize() >= raw.count or raw[cursor + 5.usize()] != 92 or raw[cursor + 6.usize()] != 117
                                    low_surrogate: mutable u64 = 0.u64()
                                    for digit in 7..<11 |raw, cursor|:
                                        nibble: i64 = json_hex_nibble(raw[cursor + digit])
                                        return false if nibble < 0
                                        low_surrogate <- low_surrogate * 16.u64() + nibble.u64()
                                    return false if low_surrogate < 56320.u64() or low_surrogate > 57343.u64()
                                    cursor <- cursor + 11.usize()
                                else:
                                    return false if code_unit >= 56320.u64() and code_unit <= 57343.u64()
                                    cursor <- cursor + 5.usize()
                            else:
                                return false if escape != 34 and escape != 92 and escape != 47 and escape != 98 and escape != 102 and escape != 110 and escape != 114 and escape != 116
                                cursor <- cursor + 1.usize()
                    return false if not closed
                    states[top] <- 4 if object_key else (5 if kinds[top] == 1 else (7 if kinds[top] == 2 else 1))
                elif byte == 123 or byte == 91:
                    return false if not expects_value or states.count > max_container_depth
                    states[top] <- 8 if kinds[top] == 1 else (9 if kinds[top] == 2 else 10)
                    states.push(2 if byte == 123 else 6)
                    kinds.push(1 if byte == 123 else 2)
                    cursor <- cursor + 1.usize()
                else:
                    start: usize = cursor
                    while cursor < raw.count and not is_space(raw[cursor]) and raw[cursor] != 44 and raw[cursor] != 93 and raw[cursor] != 125:
                        cursor <- cursor + 1.usize()
                    return false if not json_scalar(raw, start, cursor)
                    states[top] <- 5 if kinds[top] == 1 else (7 if kinds[top] == 2 else 1)
            return states.count == 1.usize() and states[0] == 1

        def valid_utf8(raw: darray[u8]&) -> bool:
            index: mutable usize = 0.usize()
            while index < raw.count:
                first: u8 = raw[index]
                if first <= 127:
                    index <- index + 1.usize()
                    continue
                if first >= 194 and first <= 223:
                    return false if index + 1.usize() >= raw.count or not is_continuation(raw[index + 1.usize()])
                    index <- index + 2.usize()
                    continue
                if first >= 224 and first <= 239:
                    return false if index + 2.usize() >= raw.count
                    second: u8 = raw[index + 1.usize()]
                    return false if not is_continuation(second) or not is_continuation(raw[index + 2.usize()])
                    return false if first == 224 and second < 160
                    return false if first == 237 and second >= 160
                    index <- index + 3.usize()
                    continue
                if first >= 240 and first <= 244:
                    return false if index + 3.usize() >= raw.count
                    second: u8 = raw[index + 1.usize()]
                    return false if not is_continuation(second) or not is_continuation(raw[index + 2.usize()]) or not is_continuation(raw[index + 3.usize()])
                    return false if first == 240 and second < 144
                    return false if first == 244 and second > 143
                    index <- index + 4.usize()
                    continue
                return false
            return true

        def unique_object_keys(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if raw.count == 0.usize() or raw.count > max_document_bytes
            # Keep each object's keys in a linked chain. Nested objects may
            # interleave their keys with a parent's keys in the input, so a
            # flat scan needlessly compares every key against unrelated
            # objects as well.
            object_last_keys: mutable darray[usize] = []
            object_has_keys: mutable darray[bool] = []
            seen_hashes: mutable darray[u32] = []
            seen_starts: mutable darray[usize] = []
            seen_ends: mutable darray[usize] = []
            seen_previous_keys: mutable darray[usize] = []
            seen_has_previous_keys: mutable darray[bool] = []
            candidate_checks: mutable usize = 0.usize()
            comparison_bytes: mutable usize = 0.usize()
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0.usize()
            for index in 0..<raw.count |raw, object_last_keys, object_has_keys, seen_hashes, seen_starts, seen_ends, seen_previous_keys, seen_has_previous_keys, candidate_checks, comparison_bytes, in_string, escaped, string_start|:
                byte: u8 = raw[index]
                if in_string:
                    if escaped:
                        escaped <- false
                    elif byte == 92:
                        escaped <- true
                    elif byte == 34:
                        after: mutable usize = index + 1.usize()
                        while after < raw.count and is_space(raw[after]) |raw, after|:
                            after <- after + 1.usize()
                        if after < raw.count and raw[after] == 58 and object_last_keys.count > 0.usize():
                            object_index: usize = object_last_keys.count - 1.usize()
                            return false if duplicate_key(raw, string_start, index, object_last_keys[object_index], object_has_keys[object_index], seen_hashes, seen_starts, seen_ends, seen_previous_keys, seen_has_previous_keys, &candidate_checks, &comparison_bytes)
                            return false if seen_hashes.count >= max_object_keys
                            key_index: usize = seen_hashes.count
                            seen_previous_keys.push(object_last_keys[object_index])
                            seen_has_previous_keys.push(object_has_keys[object_index])
                            seen_hashes.push(key_hash(raw, string_start, index))
                            seen_starts.push(string_start)
                            seen_ends.push(index)
                            object_last_keys[object_index] <- key_index
                            object_has_keys[object_index] <- true
                        in_string <- false
                    continue
                if byte == 34:
                    in_string <- true
                    string_start <- index + 1.usize()
                elif byte == 123:
                    return false if object_last_keys.count >= max_container_depth
                    object_last_keys.push(0.usize())
                    object_has_keys.push(false)
                elif byte == 125:
                    return false if object_last_keys.count == 0.usize()
                    object_last_keys.resize(object_last_keys.count - 1.usize())
                    object_has_keys.resize(object_has_keys.count - 1.usize())
            return false if in_string or escaped or object_last_keys.count != 0.usize()
            return true

    private:
        def direct_value_offset(raw: darray[u8]&, object_start: usize, finish: usize, wanted: cstr) -> usize:
            return raw.count if finish >= raw.count or object_start >= finish
            return raw.count if raw[object_start] != 123 or raw[finish] != 125
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0.usize()
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            key_length: mutable usize = 0.usize()
            while wanted[key_length].u8() != 0 |wanted, key_length|:
                key_length <- key_length + 1.usize()
            for index in (object_start + 1.usize())..<finish |raw, finish, wanted, key_length, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1.usize()
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1.usize()
                    while after < finish and is_space(raw[after]) |raw, after|:
                        after <- after + 1.usize()
                    matched: mutable bool = braces == 1 and brackets == 0 and after < finish and raw[after] == 58 and index - string_start == key_length
                    if matched:
                        for key_index in 0..<key_length |raw, wanted, string_start, matched|:
                            matched <- false if raw[string_start + key_index] != wanted[key_index].u8()
                    if matched:
                        after <- after + 1.usize()
                        while after < finish and is_space(raw[after]) |raw, after|:
                            after <- after + 1.usize()
                        return after
                    in_string <- false
            return raw.count

        def container_end(raw: darray[u8]&, start: usize, opening: u8, closing: u8) -> usize:
            return raw.count if start >= raw.count or raw[start] != opening
            depth: mutable i64 = 0
            in_string: mutable bool = false
            escaped: mutable bool = false
            for index in start..<raw.count |raw, depth, in_string, escaped, opening, closing|:
                byte: u8 = raw[index]
                if in_string:
                    if escaped:
                        escaped <- false
                    elif byte == 92:
                        escaped <- true
                    elif byte == 34:
                        in_string <- false
                elif byte == 34:
                    in_string <- true
                elif byte == opening:
                    depth <- depth + 1
                elif byte == closing:
                    depth <- depth - 1
                    return index if depth == 0
                    return raw.count if depth < 0
            return raw.count

        # A 4096-target role can require over eight million candidate comparisons.
        # Keep that work ceiling explicit and shared with callers.
        def json_scalar(raw: darray[u8]&, start: usize, end: usize) -> bool:
            return false if start == end
            if end - start == 4.usize():
                return true if raw[start] == 116 and raw[start + 1.usize()] == 114 and raw[start + 2.usize()] == 117 and raw[start + 3.usize()] == 101
                return true if raw[start] == 110 and raw[start + 1.usize()] == 117 and raw[start + 2.usize()] == 108 and raw[start + 3.usize()] == 108
            if end - start == 5.usize():
                return true if raw[start] == 102 and raw[start + 1.usize()] == 97 and raw[start + 2.usize()] == 108 and raw[start + 3.usize()] == 115 and raw[start + 4.usize()] == 101
            cursor: mutable usize = start
            cursor <- cursor + 1.usize() if raw[cursor] == 45
            return false if cursor >= end
            if raw[cursor] == 48:
                cursor <- cursor + 1.usize()
            else:
                return false if raw[cursor] < 49 or raw[cursor] > 57
                while cursor < end and raw[cursor] >= 48 and raw[cursor] <= 57:
                    cursor <- cursor + 1.usize()
            if cursor < end and raw[cursor] == 46:
                cursor <- cursor + 1.usize()
                digits: usize = cursor
                while cursor < end and raw[cursor] >= 48 and raw[cursor] <= 57:
                    cursor <- cursor + 1.usize()
                return false if cursor == digits
            if cursor < end and (raw[cursor] == 101 or raw[cursor] == 69):
                cursor <- cursor + 1.usize()
                if cursor < end and (raw[cursor] == 43 or raw[cursor] == 45):
                    cursor <- cursor + 1.usize()
                digits: usize = cursor
                while cursor < end and raw[cursor] >= 48 and raw[cursor] <= 57:
                    cursor <- cursor + 1.usize()
                return false if cursor == digits
            return cursor == end

        def is_continuation(byte: u8) -> bool:
            return byte >= 128 and byte <= 191

        def json_hex_nibble(byte: u8) -> i64:
            return (byte - 48).i64() if byte >= 48 and byte <= 57
            return (byte - 55).i64() if byte >= 65 and byte <= 70
            return (byte - 87).i64() if byte >= 97 and byte <= 102
            return -1

        def key_hash(raw: darray[u8]&, start: usize, end: usize) -> u32:
            hash: mutable u32 = 2166136261.u32()
            for index in start..<end |raw, hash|:
                hash <- (hash ^ raw[index].u32()) * 16777619.u32()
            return hash

        def is_space(byte: u8) -> bool:
            return byte == 32 or byte == 9 or byte == 10 or byte == 13

        def duplicate_key(raw: darray[u8]&, start: usize, end: usize, previous_key: usize, has_previous_key: bool, seen_hashes: darray[u32]&, seen_starts: darray[usize]&, seen_ends: darray[usize]&, seen_previous_keys: darray[usize]&, seen_has_previous_keys: darray[bool]&, candidate_checks: mutable usize&, comparison_bytes: mutable usize&) -> bool:
            return false if end < start
            current_hash: u32 = key_hash(raw, start, end)
            key_length: usize = end - start
            item: mutable usize = previous_key
            has_item: mutable bool = has_previous_key
            while has_item |raw, seen_hashes, seen_starts, seen_ends, seen_previous_keys, seen_has_previous_keys, start, end, current_hash, key_length, item, has_item, candidate_checks, comparison_bytes|:
                # Keep candidate traversal bounded independently of key length.
                return true if candidate_checks >= max_duplicate_key_candidates
                candidate_checks <- candidate_checks + 1.usize()
                if seen_hashes[item] == current_hash:
                    prior_start: usize = seen_starts[item]
                    prior_end: usize = seen_ends[item]
                    if prior_end - prior_start == key_length:
                        # Only bytes actually compared consume this budget.
                        # Fail closed before a deliberate low-width-hash
                        # collision can turn equality checks quadratic.
                        return true if key_length > max_duplicate_key_comparison_bytes - comparison_bytes
                        comparison_bytes <- comparison_bytes + key_length
                        matches: mutable bool = true
                        for offset in 0..<key_length |raw, start, prior_start, matches|:
                            matches <- false if raw[start + offset] != raw[prior_start + offset]
                        return true if matches
                has_item <- seen_has_previous_keys[item]
                item <- seen_previous_keys[item]
            return false
