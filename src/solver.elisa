# Deterministic bounded dependency solving.
#
# This module accepts already authenticated candidate metadata. It never reads
# files or performs network operations. The caller owns source identity and
# signature policy; this module only proves that one stable candidate per
# package identity satisfies every accumulated requirement.

include "./model.elisa"
include "./semver.elisa"

module Solver:
    public:
        const enum SolveCode of u8:
            Solved
            Unsatisfiable
            Malformed
            ResourceLimit

        struct Constraint:
            package: mutable darray[u8]
            requirement: mutable darray[u8]

        struct Conflict:
            package: mutable darray[u8]
            first_requirement: mutable darray[u8]
            second_requirement: mutable darray[u8]

        struct Candidate:
            package: mutable darray[u8]
            version: mutable Model::Version
            dependencies: mutable darray[Constraint]
            yanked: mutable bool

        # A preference changes deterministic search order only. Unlike a
        # constraint, it never makes a package reachable or rules out a
        # candidate that otherwise satisfies the graph.
        struct Preference:
            package: mutable darray[u8]
            version: mutable Model::Version

        # Candidates are expected to have been checked against authenticated
        # metadata before entering this API. `selected` receives candidate
        # indexes in canonical package-name order.
        def solve(candidates: darray[Candidate]&, roots: darray[Constraint]&, selected: mutable darray[usize]&) -> SolveCode can[Memory.Allocate, Abort.Panic]:
            preferences: mutable darray[Preference] = []
            return solve_with_preferences(candidates, roots, preferences, selected)

        # Apply existing lock choices as soft ordering hints. A preference may
        # rank one candidate first for its package, but it cannot add an
        # otherwise unreachable package to the graph or make a satisfiable
        # graph unsatisfiable.
        def solve_with_preferences(candidates: darray[Candidate]&, roots: darray[Constraint]&, preferences: darray[Preference]&, selected: mutable darray[usize]&) -> SolveCode can[Memory.Allocate, Abort.Panic]:
            failure_constraints: mutable darray[Constraint] = []
            return solver_solve_with_preferences(candidates, roots, preferences, selected, &failure_constraints)

        # The conflict companion records constraints from one actual failed
        # search branch. Candidate dependencies from mutually exclusive
        # versions must never be combined into a synthetic conflict.
        def solve_with_preferences_and_conflict(candidates: darray[Candidate]&, roots: darray[Constraint]&, preferences: darray[Preference]&, selected: mutable darray[usize]&, conflict: mutable Conflict&) -> SolveCode can[Memory.Allocate, Abort.Panic]:
            conflict.package.resize(0)
            conflict.first_requirement.resize(0)
            conflict.second_requirement.resize(0)
            failure_constraints: mutable darray[Constraint] = []
            result: SolveCode = solver_solve_with_preferences(candidates, roots, preferences, selected, &failure_constraints)
            return result if result != SolveCode.Unsatisfiable
            for first in 0..<failure_constraints.count |failure_constraints, candidates, conflict|:
                if not solver_requirement_has_candidate(candidates, failure_constraints[first]):
                    conflict.package.resize(0)
                    conflict.first_requirement.resize(0)
                    conflict.second_requirement.resize(0)
                    for byte_index in 0..<failure_constraints[first].package.count |failure_constraints, conflict, first|:
                        conflict.package.push(failure_constraints[first].package[byte_index])
                    for byte_index in 0..<failure_constraints[first].requirement.count |failure_constraints, conflict, first|:
                        conflict.first_requirement.push(failure_constraints[first].requirement[byte_index])
                        conflict.second_requirement.push(failure_constraints[first].requirement[byte_index])
                    return result
            for first in 0..<failure_constraints.count |failure_constraints, candidates, conflict|:
                comparisons: mutable usize = 0.usize()
                for second in first + 1.usize()..<failure_constraints.count |failure_constraints, candidates, first, second, comparisons, conflict|:
                    continue if not solver_equal(failure_constraints[first].package, failure_constraints[second].package)
                    comparisons <- comparisons + 1.usize()
                    continue if comparisons > 128.usize()
                    if not solver_requirement_pair_has_candidate(candidates, failure_constraints[first], failure_constraints[second]):
                        conflict.package.resize(0)
                        conflict.first_requirement.resize(0)
                        conflict.second_requirement.resize(0)
                        for byte_index in 0..<failure_constraints[first].package.count |failure_constraints, conflict, first|:
                            conflict.package.push(failure_constraints[first].package[byte_index])
                        for byte_index in 0..<failure_constraints[first].requirement.count |failure_constraints, conflict, first|:
                            conflict.first_requirement.push(failure_constraints[first].requirement[byte_index])
                        for byte_index in 0..<failure_constraints[second].requirement.count |failure_constraints, conflict, second|:
                            conflict.second_requirement.push(failure_constraints[second].requirement[byte_index])
                        return result
            return result

        # Solve while retaining a bounded, deterministic explanation for an
        # unsatisfiable graph. The original `solve` API remains unchanged for
        # callers that only need a status; this companion records the first
        # package whose requirements have no common candidate. A repeated
        # requirement in both fields means that one range has no candidates at
        # all. The explanation is diagnostic data only and never affects the
        # selected graph or candidate ordering.
        def solve_with_conflict(candidates: darray[Candidate]&, roots: darray[Constraint]&, selected: mutable darray[usize]&, conflict: mutable Conflict&) -> SolveCode can[Memory.Allocate, Abort.Panic]:
            preferences: mutable darray[Preference] = []
            return solve_with_preferences_and_conflict(candidates, roots, preferences, selected, conflict)

    private:
        def solver_solve_with_preferences(candidates: darray[Candidate]&, roots: darray[Constraint]&, preferences: darray[Preference]&, selected: mutable darray[usize]&, failure_constraints: mutable darray[Constraint]&) -> SolveCode can[Memory.Allocate, Abort.Panic]:
            selected.resize(0)
            failure_constraints.resize(0)
            return SolveCode.Malformed if candidates.count == 0.usize() or candidates.count > 4096.usize() or roots.count > 4096.usize() or preferences.count > max_packages
            package_slots: mutable darray[usize] = []
            total_dependencies: mutable usize = 0.usize()
            for candidate_index in 0..<candidates.count |candidates, package_slots, total_dependencies|:
                return SolveCode.Malformed if not solver_valid_name(candidates[candidate_index].package)
                # Version values are normalized by the provider boundary, but
                # prereleases are outside the v1 graph identity. Reject them at
                # this API boundary so unchecked callers cannot create an
                # ambiguous duplicate/version ordering.
                return SolveCode.Malformed if candidates[candidate_index].version.prerelease
                existing: mutable bool = false
                for slot_index in 0..<package_slots.count |candidates, package_slots, candidate_index, existing|:
                    existing <- true if solver_equal(candidates[package_slots[slot_index]].package, candidates[candidate_index].package)
                if not existing:
                    package_slots.push(candidate_index)
                    return SolveCode.ResourceLimit if package_slots.count > max_packages
                dependency_count: usize = candidates[candidate_index].dependencies.count
                return SolveCode.ResourceLimit if dependency_count > max_constraints or total_dependencies > max_constraints - dependency_count
                total_dependencies <- total_dependencies + dependency_count
                for dependency_index in 0..<candidates[candidate_index].dependencies.count |candidates, candidate_index|:
                    dependency: Constraint = candidates[candidate_index].dependencies[dependency_index]
                    return SolveCode.Malformed if not solver_valid_name(dependency.package) or dependency.requirement.count == 0.usize()
                    dependency_requirement: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
                    return SolveCode.Malformed if not SemVer::parse_requirement(dependency.requirement, &dependency_requirement)
                for previous in 0..<candidate_index |candidates, candidate_index|:
                    return SolveCode.Malformed if solver_equal(candidates[previous].package, candidates[candidate_index].package) and SemVer::compare(candidates[previous].version, candidates[candidate_index].version) == 0
            for root_index in 0..<roots.count |roots|:
                return SolveCode.Malformed if not solver_valid_name(roots[root_index].package) or roots[root_index].requirement.count == 0.usize()
                root_requirement: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
                return SolveCode.Malformed if not SemVer::parse_requirement(roots[root_index].requirement, &root_requirement)
            for preference_index in 0..<preferences.count |preferences|:
                return SolveCode.Malformed if not solver_valid_name(preferences[preference_index].package) or preferences[preference_index].version.prerelease
                for previous in 0..<preference_index |preferences, preference_index|:
                    return SolveCode.Malformed if solver_equal(preferences[previous].package, preferences[preference_index].package)
            ordered_preferences: mutable darray[Preference] = []
            for preference_index in 0..<preferences.count |preferences, ordered_preferences|:
                ordered_preferences.push(preferences[preference_index])
            solver_sort_preferences(&ordered_preferences)
            solver_sort_slots(&package_slots, candidates)
            constraints: mutable darray[Constraint] = []
            for index in 0..<roots.count |constraints, roots|:
                constraints.push(roots[index])
            assigned: mutable darray[i64] = []
            for _index in 0..<package_slots.count |assigned|:
                assigned.push(-1)
            decisions: mutable usize = 0.usize()
            result: SolveCode = solver_search(candidates, package_slots, &constraints, ordered_preferences, &assigned, &decisions, failure_constraints)
            return result if result != SolveCode.Solved
            # A dependency edge can point at an already selected package, so
            # satisfiability alone does not rule out A -> B -> A (or A -> A).
            # Reject cycles after selection before exposing indexes to lockfile
            # serialization or compiler planning.
            for slot in 0..<assigned.count |assigned, candidates|:
                return SolveCode.Malformed if assigned[slot] >= candidates.count.i64()
            return SolveCode.Malformed if not solver_selected_graph_acyclic(candidates, package_slots, assigned)
            for slot in 0..<assigned.count |assigned, selected|:
                selected.push(assigned[slot].usize()) if assigned[slot] >= 0
            return SolveCode.Solved

        const max_decisions: usize = 16384
        const max_constraints: usize = 16384
        const max_packages: usize = 1024

        def solver_search(candidates: darray[Candidate]&, package_slots: darray[usize]&, constraints: mutable darray[Constraint]&, preferences: darray[Preference]&, assigned: mutable darray[i64]&, decisions: mutable usize&, failure_constraints: mutable darray[Constraint]&) -> SolveCode can[Memory.Allocate, Abort.Panic]:
            return SolveCode.ResourceLimit if decisions >= max_decisions or constraints.count > max_constraints
            for constraint_index in 0..<constraints.count |constraints, package_slots, candidates|:
                if solver_slot_for(constraints[constraint_index].package, package_slots, candidates) == package_slots.count:
                    return solver_record_unsatisfiable(constraints, failure_constraints)
            for slot in 0..<assigned.count |assigned, candidates, package_slots, constraints|:
                continue if assigned[slot] < 0
                if not solver_candidate_satisfies(candidates[assigned[slot].usize()], package_slots[slot], constraints, package_slots, candidates):
                    return solver_record_unsatisfiable(constraints, failure_constraints)
            best_slot: mutable usize = package_slots.count
            best_count: mutable usize = 18446744073709551615.usize()
            for slot in 0..<package_slots.count |package_slots, assigned, candidates, constraints, best_slot, best_count|:
                continue if assigned[slot] >= 0
                possible: mutable usize = 0.usize()
                has_requirement: mutable bool = false
                for constraint_index in 0..<constraints.count |constraints, candidates, package_slots, slot, has_requirement|:
                    has_requirement <- true if solver_slot_for(constraints[constraint_index].package, package_slots, candidates) == slot
                continue if not has_requirement
                for candidate_index in 0..<candidates.count |candidates, package_slots, slot, constraints, possible|:
                    continue if solver_slot_for(candidates[candidate_index].package, package_slots, candidates) != slot or candidates[candidate_index].yanked
                    possible <- possible + 1.usize() if solver_candidate_satisfies(candidates[candidate_index], package_slots[slot], constraints, package_slots, candidates)
                return solver_record_unsatisfiable(constraints, failure_constraints) if possible == 0.usize()
                if possible < best_count:
                    best_count <- possible
                    best_slot <- slot
            if best_slot == package_slots.count:
                # A cyclic assignment is a failed branch, not malformed
                # solver input. Return Unsatisfiable here so search can
                # backtrack to a version that forms an acyclic graph.
                return solver_record_unsatisfiable(constraints, failure_constraints) if not solver_selected_graph_acyclic(candidates, package_slots, assigned)
                return SolveCode.Solved

            order: mutable darray[usize] = []
            for candidate_index in 0..<candidates.count |candidates, package_slots, best_slot, constraints, order|:
                continue if solver_slot_for(candidates[candidate_index].package, package_slots, candidates) != best_slot or candidates[candidate_index].yanked
                order.push(candidate_index) if solver_candidate_satisfies(candidates[candidate_index], package_slots[best_slot], constraints, package_slots, candidates)
            solver_sort_candidates(&order, candidates, preferences)
            for order_index in 0..<order.count |order, candidates, package_slots, best_slot, constraints, assigned, decisions|:
                candidate_index: usize = order[order_index]
                assigned[best_slot] <- candidate_index.i64()
                constraint_mark: usize = constraints.count
                decisions <- decisions + 1.usize()
                for dependency_index in 0..<candidates[candidate_index].dependencies.count |candidates, candidate_index, constraints|:
                    constraints.push(candidates[candidate_index].dependencies[dependency_index])
                result: SolveCode = solver_search(candidates, package_slots, constraints, preferences, assigned, decisions, failure_constraints)
                return result if result == SolveCode.Solved or result == SolveCode.ResourceLimit or result == SolveCode.Malformed
                constraints.resize(constraint_mark)
                assigned[best_slot] <- -1
            return SolveCode.Unsatisfiable

        def solver_record_unsatisfiable(constraints: darray[Constraint]&, failure_constraints: mutable darray[Constraint]&) -> SolveCode can[Memory.Allocate, Abort.Panic]:
            # Keep only the first concrete failure witness. Re-copying the
            # whole active graph at every dead search leaf would multiply the
            # solver's bounded branch count by its bounded constraint count.
            if failure_constraints.count == 0.usize():
                for index in 0..<constraints.count |constraints, failure_constraints|:
                    failure_constraints.push(constraints[index])
            return SolveCode.Unsatisfiable

        def solver_requirement_has_candidate(candidates: darray[Candidate]&, constraint: Constraint) -> bool:
            for candidate_index in 0..<candidates.count |candidates, constraint|:
                candidate: Candidate = candidates[candidate_index]
                continue if candidate.yanked or not solver_equal(candidate.package, constraint.package)
                parsed: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
                return true if SemVer::parse_requirement(constraint.requirement, &parsed) and SemVer::matches(parsed, candidate.version)
            return false

        def solver_requirement_pair_has_candidate(candidates: darray[Candidate]&, first: Constraint, second: Constraint) -> bool:
            for candidate_index in 0..<candidates.count |candidates, first, second|:
                candidate: Candidate = candidates[candidate_index]
                continue if candidate.yanked or not solver_equal(candidate.package, first.package)
                first_parsed: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
                second_parsed: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
                return true if SemVer::parse_requirement(first.requirement, &first_parsed) and SemVer::parse_requirement(second.requirement, &second_parsed) and SemVer::matches(first_parsed, candidate.version) and SemVer::matches(second_parsed, candidate.version)
            return false

        def solver_candidate_satisfies(candidate: Candidate, slot_candidate: usize, constraints: darray[Constraint]&, package_slots: darray[usize]&, candidates: darray[Candidate]&) -> bool:
            for index in 0..<constraints.count |candidate, slot_candidate, constraints, package_slots, candidates|:
                continue if solver_slot_for(constraints[index].package, package_slots, candidates) != solver_slot_for(candidates[slot_candidate].package, package_slots, candidates)
                requirement: darray[u8] = constraints[index].requirement
                parsed: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
                return false if not SemVer::parse_requirement(requirement, &parsed)
                return false if not SemVer::matches(parsed, candidate.version)
            return true

        def solver_selected_graph_acyclic(candidates: darray[Candidate]&, package_slots: darray[usize]&, selected: darray[i64]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if selected.count != package_slots.count
            colors: mutable darray[u8] = []
            colors.resize(package_slots.count)
            stack_slots: mutable darray[usize] = []
            stack_edges: mutable darray[usize] = []
            for start in 0..<package_slots.count |candidates, package_slots, selected, colors, stack_slots, stack_edges|:
                continue if selected[start] < 0 or colors[start] != 0
                stack_slots.push(start)
                stack_edges.push(0)
                colors[start] <- 1
                while stack_slots.count > 0 |candidates, package_slots, selected, colors, stack_slots, stack_edges|:
                    current_slot: usize = stack_slots[stack_slots.count - 1.usize()]
                    return false if selected[current_slot] < 0 or selected[current_slot] >= candidates.count.i64()
                    candidate: Candidate = candidates[selected[current_slot].usize()]
                    edge_cursor: usize = stack_edges[stack_edges.count - 1.usize()]
                    if edge_cursor >= candidate.dependencies.count:
                        colors[current_slot] <- 2
                        stack_slots.resize(stack_slots.count - 1.usize())
                        stack_edges.resize(stack_edges.count - 1.usize())
                        continue
                    stack_edges[stack_edges.count - 1.usize()] <- edge_cursor + 1.usize()
                    dependency_slot: usize = solver_slot_for(candidate.dependencies[edge_cursor].package, package_slots, candidates)
                    return false if dependency_slot == package_slots.count or selected[dependency_slot] < 0
                    return false if colors[dependency_slot] == 1
                    continue if colors[dependency_slot] == 2
                    stack_slots.push(dependency_slot)
                    stack_edges.push(0)
                    colors[dependency_slot] <- 1
            return true

        def solver_slot_for(package: darray[u8]&, package_slots: darray[usize]&, candidates: darray[Candidate]&) -> usize:
            for slot in 0..<package_slots.count |package, package_slots, candidates|:
                return slot if solver_equal(package, candidates[package_slots[slot]].package)
            return package_slots.count

        def solver_sort_slots(slots: mutable darray[usize]&, candidates: darray[Candidate]&) -> void:
            for index in 1..<slots.count |slots, candidates, index|:
                value: usize = slots[index]
                cursor: mutable usize = index
                while cursor > 0.usize() and solver_less(candidates[value].package, candidates[slots[cursor - 1.usize()]].package):
                    slots[cursor] <- slots[cursor - 1.usize()]
                    cursor <- cursor - 1.usize()
                slots[cursor] <- value

        def solver_sort_candidates(order: mutable darray[usize]&, candidates: darray[Candidate]&, preferences: darray[Preference]&) -> void:
            for index in 1..<order.count |order, candidates, index|:
                value: usize = order[index]
                cursor: mutable usize = index
                while cursor > 0.usize() and solver_candidate_before(value, order[cursor - 1.usize()], candidates, preferences):
                    order[cursor] <- order[cursor - 1.usize()]
                    cursor <- cursor - 1.usize()
                order[cursor] <- value

        def solver_sort_preferences(preferences: mutable darray[Preference]&) -> void:
            for index in 1..<preferences.count |preferences, index|:
                value: Preference = preferences[index]
                cursor: mutable usize = index
                while cursor > 0.usize() and solver_less(value.package, preferences[cursor - 1.usize()].package):
                    preferences[cursor] <- preferences[cursor - 1.usize()]
                    cursor <- cursor - 1.usize()
                preferences[cursor] <- value

        def solver_candidate_before(left: usize, right: usize, candidates: darray[Candidate]&, preferences: darray[Preference]&) -> bool:
            preference_index: usize = solver_preference_index(preferences, candidates[left].package)
            if preference_index < preferences.count:
                left_preferred: bool = SemVer::compare(candidates[left].version, preferences[preference_index].version) == 0
                right_preferred: bool = SemVer::compare(candidates[right].version, preferences[preference_index].version) == 0
                return true if left_preferred and not right_preferred
                return false if right_preferred and not left_preferred
            comparison: i64 = SemVer::compare(candidates[left].version, candidates[right].version)
            return true if comparison > 0
            return false if comparison < 0
            return solver_less(candidates[left].package, candidates[right].package)

        def solver_preference_index(preferences: darray[Preference]&, package: darray[u8]&) -> usize:
            lower: mutable usize = 0.usize()
            upper: mutable usize = preferences.count
            while lower < upper |preferences, package, lower, upper|:
                middle: usize = lower + (upper - lower) / 2.usize()
                if solver_less(preferences[middle].package, package):
                    lower <- middle + 1.usize()
                else:
                    upper <- middle
            return preferences.count if lower >= preferences.count or not solver_equal(preferences[lower].package, package)
            return lower

        def solver_valid_name(value: darray[u8]&) -> bool:
            return false if value.count == 0.usize() or value.count > 64.usize()
            return false if value[0] < 97 or value[0] > 122
            previous_hyphen: mutable bool = false
            for index in 0..<value.count |value, previous_hyphen|:
                byte: u8 = value[index]
                return false if (byte < 97 or byte > 122) and (byte < 48 or byte > 57) and byte != 45
                return false if byte == 45 and (index == value.count - 1.usize() or previous_hyphen)
                previous_hyphen <- byte == 45
            return true

        def solver_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true

        def solver_less(left: darray[u8]&, right: darray[u8]&) -> bool:
            limit: usize = left.count if left.count < right.count else right.count
            for index in 0..<limit |left, right|:
                return true if left[index] < right[index]
                return false if left[index] > right[index]
            return left.count < right.count
