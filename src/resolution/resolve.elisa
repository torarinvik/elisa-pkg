# Deterministic in-memory resolution primitives.
#
# This module is deliberately provider-agnostic. A future registry adapter may
# translate authenticated metadata into the bounded catalog representation, but
# this selector never performs I/O, interprets URLs, or receives trust keys.

include "../package/model.elisa"
include "./semver.elisa"

module Resolve:
    public:
        # Select the highest valid version in a newline-separated catalog that
        # satisfies one SemVer requirement. Empty catalogs, malformed entries,
        # duplicate versions, and overlarge records fail closed.
        def select_highest_version(catalog: darray[u8]&, requirement: darray[u8]&, selected: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            selected.resize(0)
            return false if catalog.count == 0.usize() or catalog.count > 1048576.usize()
            parsed_requirement: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
            if not SemVer::parse_requirement(requirement, &parsed_requirement):
                false
            else:
                found: mutable bool = false
                best_text: mutable darray[u8] = []
                # One catalog line per iteration; `finish` is its newline and
                # `line_end` drops an optional carriage return.
                while cursor < catalog.count |found, best_text, cursor: usize = 0.usize(), finish: usize = 0.usize(), line_end: usize = 0.usize(), candidate: Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, best: Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, candidates: usize = 0.usize(), seen_slots: darray[usize] = [0.usize() for slot in 0..<version_hash_capacity], seen_versions: darray[u8] = [], seen_offsets: darray[usize] = [], seen_hashes: darray[u64] = []|:
                    finish <- while position < catalog.count and catalog[position] != 10 |position: usize = cursor| -> position:
                        position <- position + 1.usize()
                    line_end <- finish - 1.usize() if finish > cursor and catalog[finish - 1.usize()] == 13 else finish
                    return false if line_end == cursor or line_end - cursor > 128.usize()
                    candidate_text: darray[u8] = [catalog[index] for index in cursor..<line_end]
                    cursor <- finish + 1.usize()
                    return false if not:
                        SemVer::parse(candidate_text, &candidate)
                        version_record_unique(&seen_slots, &seen_versions, &seen_offsets, &seen_hashes, candidate_text)
                    candidates <- candidates + 1.usize()
                    return false if candidates > 4096.usize()
                    if SemVer::matches(parsed_requirement, candidate) and (not found or SemVer::compare(candidate, best) > 0):
                        best <- candidate
                        best_text <- [candidate_text[index] for index in 0..<candidate_text.count]
                        found <- true
                if found:
                    ByteText::append(selected, best_text)
                    true
                else:
                    false

    private:
        const version_hash_capacity: usize = 8192
        const version_hash_probe_limit: usize = 32

        # Bounded open addressing avoids rescanning every earlier catalog entry
        # for each version. A deliberately collision-heavy catalog is rejected
        # after a small fixed number of probes, so attacker-controlled text
        # cannot turn this lookup back into an unbounded quadratic scan.
        def version_record_unique(slots: mutable darray[usize]&, versions: mutable darray[u8]&, offsets: mutable darray[usize]&, hashes: mutable darray[u64]&, wanted: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if slots.count != version_hash_capacity or offsets.count >= 4096.usize() or hashes.count != offsets.count
            while probes < version_hash_probe_limit |hash: u64 = version_hash(wanted), slot: usize = (hash & (version_hash_capacity - 1.usize()).u64()).usize(), probes: usize = 0.usize()|:
                existing_index: usize = slots[slot]
                if existing_index == 0.usize():
                    offsets.push(versions.count)
                    hashes.push(hash)
                    ByteText::append_terminated(versions, wanted)
                    slots[slot] <- offsets.count
                    return true
                elif hashes[existing_index - 1.usize()] == hash and version_text_equal(versions, offsets[existing_index - 1.usize()], wanted):
                    return false
                else:
                    slot <- (slot + 1.usize()) & (version_hash_capacity - 1.usize())
                    probes <- probes + 1.usize()
            false

        def version_text_equal(versions: darray[u8]&, start: usize, wanted: darray[u8]&) -> bool:
            return false if start >= versions.count
            finish: mutable usize = start
            while finish < versions.count and versions[finish] != 0 |versions, finish|:
                finish <- finish + 1.usize()
            slice_equal(versions, start, finish, wanted)

        def version_hash(value: darray[u8]&) -> u64:
            hash: mutable u64 = 14695981039346656037
            for index in 0..<value.count |value, hash|:
                hash <- (hash ^ value[index].u64()) * 1099511628211
            hash

        def slice_equal(value: darray[u8]&, start: usize, finish: usize, wanted: darray[u8]&) -> bool:
            return false if finish < start or finish - start != wanted.count
            for index in 0..<wanted.count |value, start, wanted|:
                return false if value[start + index] != wanted[index]
            true
