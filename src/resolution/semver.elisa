# Semantic-version policy. Parsing and matching are pure and carry no filesystem,
# network, or trust state across the module boundary.

include "../package/model.elisa"
include "../text/bytes.elisa"

module SemVer:
    public:
        # A comparison outside -1/0/1 means the available value did not carry
        # enough information to establish SemVer precedence.
        const COMPARE_INCOMPARABLE: i64 = 2
        const maximum_version_bytes: usize = 128.usize()

        struct Requirement:
            lower: mutable Model::Version
            upper: mutable Model::Version
            has_lower: mutable bool
            has_upper: mutable bool
            include_lower: mutable bool
            include_upper: mutable bool

        # Compares the precedence representable by Model::Version. That model
        # stores only whether a version has a prerelease, not its identifiers,
        # so same-core prereleases cannot safely be ordered or declared equal.
        # Use compare_text when full SemVer values are available.
        def compare(left: Model::Version, right: Model::Version) -> i64:
            return -1 if left.major < right.major
            return 1 if left.major > right.major
            return -1 if left.minor < right.minor
            return 1 if left.minor > right.minor
            return -1 if left.patch < right.patch
            1 if left.patch > right.patch else COMPARE_INCOMPARABLE if left.prerelease and right.prerelease else -1 if left.prerelease and not right.prerelease else 1 if right.prerelease and not left.prerelease else 0

        def compare_text(left: darray[u8]&, right: darray[u8]&) -> i64:
            left_parts: mutable ParsedToken = ParsedToken{major: 0, minor: 0, patch: 0, pre_start: 0, pre_end: 0, has_pre: false}
            right_parts: mutable ParsedToken = ParsedToken{major: 0, minor: 0, patch: 0, pre_start: 0, pre_end: 0, has_pre: false}
            COMPARE_INCOMPARABLE if not parse_token_parts(left, 0, left.count, &left_parts) or not parse_token_parts(right, 0, right.count, &right_parts) else compare_parts(left_parts, right_parts, left, right)

        def parse(value: darray[u8]&, out: mutable Model::Version&) -> bool:
            parse_range(value, 0, value.count, out)

        def parse_range(value: darray[u8]&, start: usize, finish: usize, out: mutable Model::Version&) -> bool:
            out <- Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            parts: mutable ParsedToken = ParsedToken{major: 0, minor: 0, patch: 0, pre_start: 0, pre_end: 0, has_pre: false}
            return false if not parse_token_parts(value, start, finish, &parts)
            out <- Model::Version{major: parts.major, minor: parts.minor, patch: parts.patch, prerelease: parts.has_pre}
            true

        # v1 requirement grammar: exact versions, ^, ~, and one comparison.
        # The resolver will reject a range it cannot parse; it never guesses.
        def parse_requirement(value: darray[u8]&, out: mutable Requirement&) -> bool:
            out <- unbounded_requirement()
            return false if value.count == 0.usize() or value.count > maximum_requirement_bytes
            # The text without surrounding spaces, its leading operator (0 for
            # an exact version), and where the version starts.
            rebind finish: usize, operator: u8, operator_length: usize, version_start: usize =
                start: usize = skip_spaces(value, 0.usize(), value.count)
                trimmed_end: usize =
                    while end > start and is_space(value[end - 1.usize()]) |end: usize = value.count| -> end:
                        end <- end - 1.usize()
                return false if start >= trimmed_end
                found_operator: u8 = value[start] if value[start] == 94 or value[start] == 126 or value[start] == 60 or value[start] == 62 else 0
                found_length: usize = 0.usize() if found_operator == 0 else 2.usize() if (found_operator == 60 or found_operator == 62) and start + 1.usize() < trimmed_end and value[start + 1.usize()] == 61 else 1.usize()
                trimmed_end, found_operator, found_length, skip_spaces(value, start + found_length, trimmed_end)
            version_end: usize = token_end(value, version_start, finish)
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            if version_start >= version_end or not parse_range(value, version_start, version_end, &parsed) or parsed.prerelease:
                false
            elif version_end < finish:
                parse_bounded_range(value, operator, operator_length, parsed, version_end, finish, out)
            else:
                single_bound_requirement(operator, operator_length, parsed, out)

        def unbounded_requirement() -> Requirement:
            empty: Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            Requirement{lower: empty, upper: empty, has_lower: false, has_upper: false, include_lower: false, include_upper: false}

        # A two-sided range such as ">=1.0.0 <2.0.0": one `>` bound and one
        # `<` bound, in either order, forming a non-empty interval.
        def parse_bounded_range(value: darray[u8]&, operator: u8, operator_length: usize, parsed: Model::Version, version_end: usize, finish: usize, out: mutable Requirement&) -> bool:
            return false if operator != 60 and operator != 62
            # The second comparator's operator length and where its version starts.
            rebind second_length: usize, second_start: usize =
                cursor: usize = skip_spaces(value, version_end, finish)
                return false if cursor >= finish or (value[cursor] != 60 and value[cursor] != 62) or value[cursor] == operator
                length: usize = 2.usize() if cursor + 1.usize() < finish and value[cursor + 1.usize()] == 61 else 1.usize()
                length, skip_spaces(value, cursor + length, finish)
            second_end: usize = token_end(value, second_start, finish)
            second: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            if second_start >= second_end or second_end != finish or not parse_range(value, second_start, second_end, &second) or second.prerelease:
                false
            else:
                candidate: Requirement = Requirement{lower: parsed if operator == 62 else second, upper: parsed if operator == 60 else second, has_lower: true, has_upper: true, include_lower: operator_length == 2.usize() if operator == 62 else second_length == 2.usize(), include_upper: operator_length == 2.usize() if operator == 60 else second_length == 2.usize()}
                if compare(candidate.lower, candidate.upper) > 0 or (compare(candidate.lower, candidate.upper) == 0 and (not candidate.include_lower or not candidate.include_upper)):
                    false
                else:
                    out <- candidate
                    true

        # A single comparator: exact, caret, tilde, or a one-sided bound.
        def single_bound_requirement(operator: u8, operator_length: usize, parsed: Model::Version, out: mutable Requirement&) -> bool:
            candidate: mutable Requirement = unbounded_requirement()
            candidate.lower <- parsed
            candidate.upper <- parsed
            candidate.has_lower <- true
            candidate.has_upper <- true
            candidate.include_lower <- true
            candidate.include_upper <- true
            if operator == 94:
                return false if parsed.major == 18446744073709551615 or (parsed.major == 0 and parsed.minor == 18446744073709551615) or (parsed.major == 0 and parsed.minor == 0 and parsed.patch == 18446744073709551615)
                candidate.upper <- caret_upper(parsed)
                candidate.include_upper <- false
            elif operator == 126:
                return false if parsed.minor == 18446744073709551615
                candidate.upper <- Model::Version{major: parsed.major, minor: parsed.minor + 1, patch: 0, prerelease: false}
                candidate.include_upper <- false
            elif operator == 60:
                candidate.has_lower <- false
                candidate.include_upper <- operator_length == 2.usize()
            elif operator == 62:
                candidate.has_upper <- false
                candidate.include_lower <- operator_length == 2.usize()
            out <- candidate
            true

        def matches(requirement: Requirement, candidate: Model::Version) -> bool:
            return false if candidate.prerelease
            lower_comparison: i64 = compare(candidate, requirement.lower)
            upper_comparison: i64 = compare(candidate, requirement.upper)
            not (requirement.has_lower and (lower_comparison < 0 or (lower_comparison == 0 and not requirement.include_lower))) and not (requirement.has_upper and (upper_comparison > 0 or (upper_comparison == 0 and not requirement.include_upper)))

    private:
        const precedence_contract: cstr = "SemVer 2.0 precedence; build metadata excluded from ordering"
        const maximum_requirement_bytes: usize = 128.usize()

        struct ParsedToken:
            major: mutable u64
            minor: mutable u64
            patch: mutable u64
            pre_start: mutable usize
            pre_end: mutable usize
            has_pre: mutable bool

        def compare_parts(left: ParsedToken, right: ParsedToken, left_raw: darray[u8]&, right_raw: darray[u8]&) -> i64:
            return -1 if left.major < right.major
            return 1 if left.major > right.major
            return -1 if left.minor < right.minor
            return 1 if left.minor > right.minor
            return -1 if left.patch < right.patch
            return 1 if left.patch > right.patch
            if left.has_pre != right.has_pre:
                return -1 if left.has_pre else 1
            return 0 if not left.has_pre
            # Compare dot-separated prerelease identifiers in order.
            while left_cursor < left.pre_end or right_cursor < right.pre_end |left_cursor: usize = left.pre_start, right_cursor: usize = right.pre_start, left_end: usize = 0.usize(), right_end: usize = 0.usize()|:
                return -1 if left_cursor >= left.pre_end
                return 1 if right_cursor >= right.pre_end
                left_end <- while position < left.pre_end and left_raw[position] != 46 |position: usize = left_cursor| -> position:
                    position <- position + 1.usize()
                right_end <- while position < right.pre_end and right_raw[position] != 46 |position: usize = right_cursor| -> position:
                    position <- position + 1.usize()
                segment_order: i64 =
                    left_numeric: bool = for index in left_cursor..<left_end |numeric: bool = true| -> numeric:
                        break false if left_raw[index] < 48 or left_raw[index] > 57
                    right_numeric: bool = for index in right_cursor..<right_end |numeric: bool = true| -> numeric:
                        break false if right_raw[index] < 48 or right_raw[index] > 57
                    left_length: usize = left_end - left_cursor
                    right_length: usize = right_end - right_cursor
                    if left_numeric != right_numeric:
                        # Numeric identifiers sort before alphanumeric ones.
                        -1 if left_numeric else 1
                    elif left_numeric and left_length != right_length:
                        -1 if left_length < right_length else 1
                    else:
                        # Equal-length numbers, or ASCII text with a shorter
                        # identifier first when one is a prefix of the other.
                        prefix_order: i64 = for index in 0..<(left_length if left_length < right_length else right_length) |order: i64 = 0| -> order:
                            break -1 if left_raw[left_cursor + index] < right_raw[right_cursor + index]
                            break 1 if left_raw[left_cursor + index] > right_raw[right_cursor + index]
                        prefix_order if prefix_order != 0 else -1 if left_length < right_length else 1 if left_length > right_length else 0
                left_cursor <- left_end + 1.usize()
                right_cursor <- right_end + 1.usize()
                return segment_order if segment_order != 0
            0

        def parse_token_parts(value: darray[u8]&, start: usize, finish: usize, out: mutable ParsedToken&) -> bool:
            out <- ParsedToken{major: 0, minor: 0, patch: 0, pre_start: 0, pre_end: 0, has_pre: false}
            return false if finish > value.count or start >= finish or finish - start > maximum_version_bytes
            cursor: mutable usize = start
            return false if:
                not consume_component(value, finish, &cursor, &out.major)
                cursor >= finish or value[cursor] != 46
            cursor <- cursor + 1.usize()
            return false if:
                not consume_component(value, finish, &cursor, &out.minor)
                cursor >= finish or value[cursor] != 46
            cursor <- cursor + 1.usize()
            return false if:
                not consume_component(value, finish, &cursor, &out.patch)
                cursor < finish and (value[cursor] != 45 or cursor + 1.usize() == finish)
            out.has_pre <- cursor < finish
            out.pre_start <- cursor + 1.usize() if out.has_pre else finish
            out.pre_end <- finish
            cursor == finish or valid_prerelease(value, cursor + 1.usize(), finish)

        def valid_prerelease(value: darray[u8]&, start: usize, finish: usize) -> bool:
            requires start < finish and finish <= value.count
            segment_start: mutable usize = start
            numeric: mutable bool = true
            for index in start..<finish |value, segment_start, numeric|:
                byte: u8 = value[index]
                if byte == 46:
                    return false if not valid_prerelease_segment(value, segment_start, index, numeric)
                    segment_start <- index + 1.usize()
                    numeric <- true
                else:
                    digit: bool = byte >= 48 and byte <= 57
                    return false if not digit and not (byte >= 65 and byte <= 90 or byte >= 97 and byte <= 122 or byte == 45)
                    numeric <- numeric and digit
            valid_prerelease_segment(value, segment_start, finish, numeric)

        def valid_prerelease_segment(value: darray[u8]&, start: usize, finish: usize, numeric: bool) -> bool:
            requires start <= finish and finish <= value.count
            start < finish and (not numeric or finish - start == 1.usize() or value[start] != 48)

        def consume_component(value: darray[u8]&, finish: usize, cursor: mutable usize&, out: mutable u64&) -> bool:
            start: usize = cursor
            false if not ByteText::scan_unsigned_decimal(value, start, finish, cursor, out) else cursor - start == 1.usize() or value[start] != 48

        def is_space(byte: u8) -> bool:
            byte == 32 or byte == 9 or byte == 10 or byte == 13

        def skip_spaces(value: darray[u8]&, start: usize, finish: usize) -> usize:
            while cursor < finish and is_space(value[cursor]) |cursor: usize = start| -> cursor:
                cursor <- cursor + 1.usize()

        def token_end(value: darray[u8]&, start: usize, finish: usize) -> usize:
            while cursor < finish and not is_space(value[cursor]) |cursor: usize = start| -> cursor:
                cursor <- cursor + 1.usize()

        def caret_upper(value: Model::Version) -> Model::Version:
            return Model::Version{major: value.major + 1, minor: 0, patch: 0, prerelease: false} if value.major > 0
            Model::Version{major: 0, minor: value.minor + 1, patch: 0, prerelease: false} if value.minor > 0 else Model::Version{major: 0, minor: 0, patch: value.patch + 1, prerelease: false}
