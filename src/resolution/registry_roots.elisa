# Collect direct registry constraints from a validated package manifest.
include "../json.elisa"
include "../package/dependency_entry.elisa"
include "../text/bytes.elisa"
include "./solver.elisa"

module RegistryRoots:
    public:
        def collect[@r](raw: darray[u8]&, out: mutable darray[Solver::Constraint]& @r, has_local: mutable bool&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            has_local <- false
            dependency_start: usize = Json::root_value_offset(raw, "dependencies")
            return true if dependency_start >= raw.count
            dependency_end: usize = Json::object_end(raw, dependency_start)
            if dependency_end <= dependency_start or dependency_end >= raw.count or raw[dependency_start] != 123:
                false
            else:
                # The cursor starts inside the object; each entry either ends it
                # exactly or the object is malformed.
                while cursor < dependency_end |out, has_local, cursor: usize = Json::skip_whitespace(raw, dependency_start + 1.usize(), dependency_end), entry: DependencyEntry::Span = DependencyEntry::Span{name_start: 0, name_end: 0, object_start: 0, object_end: 0}| -> cursor == dependency_end:
                    return false if not DependencyEntry::read(raw, cursor, dependency_end, &entry)
                    if Json::object_has_key(raw, entry.object_start, entry.object_end, "path"):
                        has_local <- true
                    else:
                        requirement: mutable darray[u8] @r = []
                        return false if not:
                            Json::object_string_equals_text(raw, entry.object_start, entry.object_end, "registry", "primary")
                            Json::object_string_value(raw, entry.object_start, entry.object_end, "version", &requirement)
                            out.count < maximum_dependencies
                        alias: mutable darray[u8] @r = []
                        ByteText::append_range(&alias, raw, entry.name_start, entry.name_end)
                        out.push(Solver::Constraint{package: alias, requirement: requirement})
                    cursor <- DependencyEntry::next_start(raw, entry.object_end, dependency_end)

    private:
        const maximum_dependencies: usize = 4096.usize()
