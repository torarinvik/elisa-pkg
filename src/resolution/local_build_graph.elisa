# Deterministic include order for the validated local dependency graph.
include "../build.elisa"
include "../platform.elisa"
include "../text/bytes.elisa"

module LocalBuildGraph:
    public:
        const maximum_aggregate_bytes: usize = 33554432.usize()

        struct Package:
            name: mutable darray[u8]
            root: mutable darray[u8]
            entry: mutable darray[u8]
            relative_entry: mutable darray[u8]
            source_digest: mutable darray[u8]
            snapshot_entry: mutable darray[u8]
            dependency_names: mutable darray[u8]
            dependents: mutable darray[usize]
            remaining_dependencies: mutable usize
            emitted: mutable bool

        # Packages arrive sorted by name with empty reverse edges and counters.
        # The pass consumes that graph state and emits prerequisites first.
        def write_ordered_includes[@r](packages: mutable darray[Package]& @r, order: mutable darray[usize]& @r, root_entry: cstr, aggregate: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            for package_index in 0..<packages.count |packages|:
                dependency_cursor: mutable usize = 0.usize()
                while dependency_cursor < packages[package_index].dependency_names.count:
                    dependency_end: mutable usize = dependency_cursor
                    while dependency_end < packages[package_index].dependency_names.count and packages[package_index].dependency_names[dependency_end] != 0 |packages, dependency_end|:
                        dependency_end <- dependency_end + 1.usize()
                    dependency_name: mutable darray[u8] = []
                    for byte_index in dependency_cursor..<dependency_end |dependency_name, packages|:
                        dependency_name.push(packages[package_index].dependency_names[byte_index])
                    dependency_index: usize = package_index_for_name(packages, dependency_name)
                    return false if dependency_end == dependency_cursor or dependency_end == packages[package_index].dependency_names.count or dependency_index >= packages.count
                    packages[package_index].remaining_dependencies <- packages[package_index].remaining_dependencies + 1.usize()
                    packages[dependency_index].dependents.push(package_index)
                    dependency_cursor <- dependency_end + 1.usize()
            completed: mutable usize = 0.usize()
            while completed < packages.count |packages, completed, aggregate|:
                selected: mutable usize = packages.count
                for candidate in 0..<packages.count |packages, selected|:
                    if not packages[candidate].emitted and packages[candidate].remaining_dependencies == 0.usize():
                        selected <- candidate
                        break
                return false if selected >= packages.count
                return false if not Build::append_include_path(packages[selected].entry, aggregate)
                order.push(selected)
                packages[selected].emitted <- true
                completed <- completed + 1.usize()
                return false if aggregate.count > maximum_aggregate_bytes
                for dependent_index in 0..<packages[selected].dependents.count |packages, selected, dependent_index|:
                    dependent: usize = packages[selected].dependents[dependent_index]
                    return false if packages[dependent].remaining_dependencies == 0.usize()
                    packages[dependent].remaining_dependencies <- packages[dependent].remaining_dependencies - 1.usize()
            root_entry_bytes: mutable darray[u8] = []
            root_entry_length: usize = Platform::pkg_strlen(root_entry)
            return false if root_entry_length == 0.usize() or root_entry_length > 4096.usize()
            for index in 0..<root_entry_length |root_entry_bytes, root_entry|:
                root_entry_bytes.push(root_entry[index].u8())
            return false if not Build::append_include_path(root_entry_bytes, aggregate) or aggregate.count > maximum_aggregate_bytes
            return true

    private:
        def package_index_for_name(packages: darray[Package]&, wanted: darray[u8]&) -> usize:
            lower: mutable usize = 0.usize()
            upper: mutable usize = packages.count
            while lower < upper |packages, wanted, lower, upper|:
                middle: usize = lower + (upper - lower) / 2.usize()
                return middle if ByteText::equal(packages[middle].name, wanted)
                if ByteText::less(packages[middle].name, wanted):
                    lower <- middle + 1.usize()
                else:
                    upper <- middle
            return packages.count
