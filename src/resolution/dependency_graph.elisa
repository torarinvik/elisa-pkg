# Cycle checks for dependency graphs stored as adjacency ranges.
module DependencyGraph:
    public:
        def is_acyclic(total: usize, edges: darray[usize]&, edge_offsets: darray[usize]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if:
                edge_offsets.count == 0.usize() or edge_offsets.count - 1.usize() != total
                edge_offsets[0] != 0.usize() or edge_offsets[total] != edges.count
            indegrees: mutable darray[usize] = [0.usize() for _node in 0..<total]
            return false if not count_indegrees(total, edges, edge_offsets, &indegrees)
            return removable_node_count(total, edges, edge_offsets, indegrees) == total

    private:
        # Count the incoming edges of every node. Returns false for malformed
        # offsets or an edge to a node outside the graph.
        def count_indegrees(total: usize, edges: darray[usize]&, edge_offsets: darray[usize]&, indegrees: mutable darray[usize]&) -> bool:
            requires edge_offsets.count == total + 1 and indegrees.count == total
            for source in 0..<total |indegrees|:
                return false if edge_offsets[source + 1.usize()] < edge_offsets[source] or edge_offsets[source + 1.usize()] > edges.count
                for edge_index in edge_offsets[source]..<edge_offsets[source + 1.usize()] |indegrees|:
                    target: usize = edges[edge_index]
                    return false if target >= total
                    indegrees[target] <- indegrees[target] + 1.usize()
            return true

        # Repeatedly remove nodes with no remaining incoming edges (Kahn's
        # algorithm). Every node is removed exactly when the graph is acyclic.
        def removable_node_count(total: usize, edges: darray[usize]&, edge_offsets: darray[usize]&, indegrees: mutable darray[usize]) -> usize can[Memory.Allocate, Abort.Panic]:
            requires edge_offsets.count == total + 1 and indegrees.count == total
            ready: mutable darray[usize] = [index for index in 0..<total if indegrees[index] == 0.usize()]
            while ready_cursor < ready.count |ready, indegrees, ready_cursor: usize = 0.usize()|:
                source: usize = ready[ready_cursor]
                ready_cursor <- ready_cursor + 1.usize()
                for edge_index in edge_offsets[source]..<edge_offsets[source + 1.usize()] |indegrees, ready|:
                    target: usize = edges[edge_index]
                    return total + 1.usize() if indegrees[target] == 0.usize()
                    indegrees[target] <- indegrees[target] - 1.usize()
                    ready <- ready.push(target) if indegrees[target] == 0.usize()
            return ready.count
