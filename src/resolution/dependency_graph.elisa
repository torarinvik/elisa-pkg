# Cycle checks for dependency graphs stored as adjacency ranges.
module DependencyGraph:
    public:
        def is_acyclic(total: usize, edges: darray[usize]&, edge_offsets: darray[usize]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if:
                edge_offsets.count == 0.usize() or edge_offsets.count - 1.usize() != total
                edge_offsets[0] != 0.usize() or edge_offsets[total] != edges.count
            indegrees: mutable darray[usize] = []
            indegrees <- indegrees.resize(total)
            for index in 0..<total |indegrees|:
                indegrees[index] <- 0.usize()
            for source in 0..<total |edge_offsets, edges, indegrees|:
                return false if edge_offsets[source + 1.usize()] < edge_offsets[source] or edge_offsets[source + 1.usize()] > edges.count
                for edge_index in edge_offsets[source]..<edge_offsets[source + 1.usize()] |edges, indegrees|:
                    target: usize = edges[edge_index]
                    return false if target >= total
                    indegrees[target] <- indegrees[target] + 1.usize()
            ready: mutable darray[usize] = []
            for index in 0..<total |indegrees, ready|:
                ready <- ready.push(index) if indegrees[index] == 0.usize()
            ready_cursor: mutable usize = 0.usize()
            while ready_cursor < ready.count |ready, ready_cursor, edges, edge_offsets, indegrees|:
                source: usize = ready[ready_cursor]
                for edge_index in edge_offsets[source]..<edge_offsets[source + 1.usize()] |edges, indegrees, ready|:
                    target: usize = edges[edge_index]
                    return false if indegrees[target] == 0.usize()
                    indegrees[target] <- indegrees[target] - 1.usize()
                    ready <- ready.push(target) if indegrees[target] == 0.usize()
                ready_cursor <- ready_cursor + 1.usize()
            return ready.count == total
