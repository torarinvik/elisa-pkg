# Archive path policy. Extraction is deliberately not enabled yet; this module
# owns the lexical invariant that every future archive writer and extractor must
# share before any destination filesystem operation is attempted.

module Archive:
    public:
        def is_safe_entry(entry: darray[u8]&) -> bool:
            return false if entry.count == 0.usize() or entry.count > 4096.usize()
            return false if entry[0] == 47 or entry[0] == 92
            return false if contains_parent_segment(entry)
            return false if contains_double_separator(entry)
            return false if contains_dot_segment(entry)
            return false if entry.count >= 2.usize() and entry[entry.count - 2.usize()] == 47 and entry[entry.count - 1.usize()] == 46
            return true

    private:
        def contains_parent_segment(entry: darray[u8]&) -> bool:
            for index in 0..<entry.count |entry|:
                return true if entry[index] == 46 and index + 1.usize() < entry.count and entry[index + 1.usize()] == 46
            return false

        def contains_double_separator(entry: darray[u8]&) -> bool:
            for index in 1..<entry.count |entry|:
                return true if entry[index - 1.usize()] == 47 and entry[index] == 47
            return false

        def contains_dot_segment(entry: darray[u8]&) -> bool:
            for index in 1..<entry.count |entry|:
                return true if entry[index - 1.usize()] == 47 and entry[index] == 46 and index + 1.usize() < entry.count and entry[index + 1.usize()] == 47
            return false
