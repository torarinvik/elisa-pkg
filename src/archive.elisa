# Archive path policy. The writer, verifier, and narrow staged extractor share
# one lexical invariant before any destination filesystem operation is attempted.

include "./package/ustar_fields.elisa"
include "./platform.elisa"
include "./package/model.elisa"
include "./package_path_policy.elisa"
include "./package/package_identity.elisa"

module Archive:
    public:
        const max_archive_bytes: usize = UstarFields::max_archive_bytes

        # Maximum package name, version, three SHA-256 digests, and receipt
        # labels occupy 493 bytes. Keep a small explicit margin for disk reads.
        const max_package_receipt_bytes: usize = 512.usize()

        def is_safe_entry(entry: darray[u8]&) -> bool:
            return UstarFields::safe_relative_path(entry)

        # ustar's name field is intentionally bounded. Long-name/PAX/GNU
        # extensions are rejected until their canonical semantics have a
        # dedicated parser and test corpus.
        def tar_file_header(entry: darray[u8]&, size: usize) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not is_safe_entry(entry) or entry.count >= 100.usize() or size > UstarFields::max_payload_bytes
            header: mutable darray[u8] = []
            header.resize(512)
            for index in 0..<entry.count |header, entry|:
                header[index] <- entry[index]
            write_octal(&header, 100, 420, 8)
            write_octal(&header, 108, 0, 8)
            write_octal(&header, 116, 0, 8)
            write_octal(&header, 124, size, 12)
            write_octal(&header, 136, 0, 12)
            for index in 148..<156 |header|:
                header[index] <- 32
            header[156] <- 48
            header[257] <- 117
            header[258] <- 115
            header[259] <- 116
            header[260] <- 97
            header[261] <- 114
            header[262] <- 0
            header[263] <- 48
            header[264] <- 48
            checksum: mutable usize = 0.usize()
            for index in 0..<512 |header, checksum|:
                checksum <- checksum + header[index].usize()
            write_octal(&header, 148, checksum, 7)
            header[154] <- 0
            header[155] <- 32
            return header

        def package_receipt_bytes(name: darray[u8]&, version: darray[u8]&, manifest_digest: darray[u8]&, lock_digest: darray[u8]&, archive_digest: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not PackageIdentity::valid_name(name) or not archive_valid_version(version)
            return [] if not archive_valid_digest(manifest_digest) or not archive_valid_digest(lock_digest) or not archive_valid_digest(archive_digest)
            receipt: mutable darray[u8] = []
            archive_push_text(&receipt, "elisapkg-package-receipt:1\nname:")
            archive_push_array(&receipt, name)
            archive_push_text(&receipt, "\nversion:")
            archive_push_array(&receipt, version)
            archive_push_text(&receipt, "\nmanifest-digest:sha256:")
            archive_push_array(&receipt, manifest_digest)
            archive_push_text(&receipt, "\nlock-digest:sha256:")
            archive_push_array(&receipt, lock_digest)
            archive_push_text(&receipt, "\narchive-digest:sha256:")
            archive_push_array(&receipt, archive_digest)
            archive_push_text(&receipt, "\n")
            return [] if receipt.count > max_package_receipt_bytes
            return receipt

        def extract_ustar_archive(archive: darray[u8]&, destination: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if archive.count == 0.usize() or destination.count == 0.usize() or destination.count > 4096.usize()
            return Platform::pkg_extract_ustar(archive, destination) == 0

        def verify_ustar_archive(archive: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            ignored_entry: mutable darray[u8] = []
            empty_name: mutable darray[u8] = []
            return scan_ustar_archive(archive, empty_name, &ignored_entry, false)

        # Extract one bounded regular-file entry while validating every archive
        # header and terminator. The output is cleared on any failure, including
        # a malformed entry that appears after the requested file.
        def read_ustar_entry(archive: darray[u8]&, wanted: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if not is_safe_entry(wanted)
            return scan_ustar_archive(archive, wanted, out, true)

        # Serialize the NUL-delimited relative paths selected for this package.
        # The output stays empty on failure.
        def write_ustar_from_paths(paths: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return false if paths.count == 0.usize() or paths.count > PackagePathPolicy::max_package_archive_entries * 100.usize()
            if not write_selected_paths(paths, out):
                out.resize(0)
                return false
            return true

    private:
        def write_selected_paths(paths: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            cursor: mutable usize = 0.usize()
            entry_count: mutable usize = 0.usize()
            seen: mutable darray[u8] = []
            while cursor < paths.count:
                return false if entry_count >= PackagePathPolicy::max_package_archive_entries
                entry: mutable darray[u8] = []
                while cursor < paths.count and paths[cursor] != 0 |paths, cursor, entry|:
                    return false if entry.count == 99.usize()
                    entry.push(paths[cursor])
                    cursor <- cursor + 1.usize()
                return false if cursor >= paths.count
                cursor <- cursor + 1.usize()
                content: mutable darray[u8] = []
                entry_c: mutable darray[u8] = []
                return false if not is_safe_entry(entry) or UstarFields::archive_name_seen(seen, entry)
                archive_push_array(&seen, entry)
                seen.push(0)
                entry_count <- entry_count + 1.usize()
                archive_push_array(&entry_c, entry)
                entry_c.push(0)
                entry_name: cstr = (&entry_c[0]).cast[cstr] can Unsafe.PointerCast
                entry_size: i64 = Platform::pkg_package_file_size(entry_name)
                return false if entry_size < 0 or entry_size > UstarFields::max_payload_bytes.i64()
                payload_size: usize = entry_size.usize()
                padding: usize = UstarFields::padding_bytes(payload_size)
                padded_payload: usize = payload_size + padding
                return false if padded_payload > UstarFields::max_payload_bytes
                return false if out.count > UstarFields::max_payload_bytes - padded_payload
                header: darray[u8] = tar_file_header(entry, payload_size)
                return false if header.count != 512.usize()
                content.resize(payload_size + 1.usize())
                content_raw: mutable u8& = (&content[0]).cast[mutable u8&] can Unsafe.PointerCast
                read_size: i64 = Platform::pkg_read_package_file(entry_name, content_raw, content.count)
                return false if read_size != entry_size
                content.resize(payload_size)
                header_start: usize = out.count
                out.resize(out.count + 512.usize())
                for header_index in 0..<512.usize() |out, header, header_start, header_index|:
                    out[header_start + header_index] <- header[header_index]
                for content_index in 0..<content.count |out, content|:
                    out.push(content[content_index])
                out.resize(out.count + padding)
            out.resize(out.count + 1024.usize())
            return out.count <= UstarFields::max_archive_bytes

        const max_embedded_manifest_size: usize = 1048576

        def scan_ustar_archive(archive: darray[u8]&, wanted: darray[u8]&, out: mutable darray[u8]&, extract: bool) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if archive.count < 1024.usize() or archive.count > UstarFields::max_archive_bytes
            return false if archive.count % 512.usize() != 0.usize()
            cursor: mutable usize = 0.usize()
            entries: mutable usize = 0.usize()
            seen: mutable darray[u8] = []
            selected_payload_start: mutable usize = 0.usize()
            selected_payload_size: mutable usize = 0.usize()
            while cursor + 512.usize() <= archive.count:
                if UstarFields::archive_block_zero(archive, cursor):
                    valid_end: bool = UstarFields::archive_block_zero(archive, cursor + 512.usize()) and cursor + 1024.usize() == archive.count and entries > 0.usize()
                    return valid_end if not extract
                    return false if not valid_end or selected_payload_start == 0.usize()
                    out.resize(selected_payload_size)
                    for index in 0..<selected_payload_size |archive, selected_payload_start, out|:
                        out[index] <- archive[selected_payload_start + index]
                    return true
                return false if entries >= PackagePathPolicy::max_package_archive_entries
                return false if cursor + 512.usize() > archive.count
                name: mutable darray[u8] = []
                name_end: mutable usize = 0.usize()
                while name_end < 100.usize() and archive[cursor + name_end] != 0:
                    name.push(archive[cursor + name_end])
                    name_end <- name_end + 1.usize()
                return false if name_end == 0.usize() or name_end == 100.usize() or not is_safe_entry(name)
                return false if UstarFields::archive_name_seen(seen, name)
                for index in 0..<name.count |seen, name|:
                    seen.push(name[index])
                seen.push(0)
                payload_size: i64 = UstarFields::normalized_payload_size(archive, cursor, name_end)
                return false if payload_size < 0
                size: usize = payload_size.usize()
                next_offset: usize = UstarFields::next_entry_offset(archive, cursor, size)
                return false if next_offset == 0.usize()
                if extract and archive_entry_equal(name, wanted):
                    return false if selected_payload_start != 0.usize() or size > max_embedded_manifest_size
                    selected_payload_start <- cursor + 512.usize()
                    selected_payload_size <- size
                cursor <- next_offset
                entries <- entries + 1.usize()
            return false

        def archive_entry_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true

        def archive_valid_version(value: darray[u8]&) -> bool:
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return PackageIdentity::parse_version(value, &parsed)

        def archive_valid_digest(value: darray[u8]&) -> bool:
            return false if value.count != 64.usize()
            for index in 0..<value.count |value|:
                byte: u8 = value[index]
                return false if (byte < 48 or byte > 57) and (byte < 97 or byte > 102)
            return true

        def archive_push_text(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            index: mutable usize = 0.usize()
            while index < 1048576.usize() |out, value, index|:
                byte: u8 = value[index].u8()
                return if byte == 0
                out.push(byte)
                index <- index + 1.usize()

        def archive_push_array(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out.push(value[index])

        def write_octal(header: mutable darray[u8]&, offset: usize, value: usize, width: usize) -> void:
            return if width == 0.usize()
            divisor: mutable usize = 1.usize()
            for _step in 1..<(width - 1.usize()) |divisor|:
                divisor <- divisor * 8.usize()
            for step in 0..<(width - 1.usize()) |header, offset, width, value, divisor, step|:
                header[offset + step] <- 48 + ((value / divisor) % 8.usize()).u8()
                divisor <- divisor / 8.usize() if divisor > 1.usize()
            header[offset + width - 1.usize()] <- 0
