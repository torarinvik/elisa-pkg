# Operating-system seams for elisapkg.
#
# The current Elisa backend requires foreign declarations at the compilation-unit
# boundary. They are kept together here and wrapped by the namespaced public
# `Platform` API below. No command module links libc directly.

@link_name("elisapkg_fopen")
extern platform_fopen(path: cstr, mode: cstr) -> mutable heap void&?
@link_name("ferror")
extern platform_ferror(stream: heap void&) -> int
@link_name("fclose")
extern platform_fclose(stream: heap void&) -> int
@link_name("fread")
extern platform_fread(buffer: mutable void&, size: usize, count: usize, stream: void&) -> usize
@link_name("fwrite")
extern platform_fwrite(buffer: void&, size: usize, count: usize, stream: void&) -> usize
@link_name("elisapkg_mkdir")
extern platform_mkdir(path: cstr, mode: u16) -> i64
@link_name("elisapkg_chdir")
extern platform_chdir(path: cstr) -> i64
@link_name("getcwd")
extern platform_getcwd(buffer: void&, size: usize) -> void&
@link_name("strlen")
extern platform_strlen(value: cstr) -> usize
@link_name("write")
extern platform_write(fd: i64, buffer: void&, count: usize) -> i64 can[Console.Write]
@link_name("close")
extern platform_close(fd: i64) -> i64
@link_name("elisapkg_mkstemp")
extern platform_mkstemp(template: mutable u8&) -> i64
@link_name("fsync")
extern platform_fsync(fd: i64) -> i64
@link_name("elisapkg_rename")
extern platform_rename(old_path: cstr, new_path: cstr) -> i64
@link_name("elisapkg_link")
extern platform_link(old_path: cstr, new_path: cstr) -> i64
@link_name("elisapkg_unlink")
extern platform_unlink(path: cstr) -> i64
@link_name("elisapkg_rmdir")
extern platform_rmdir(path: cstr) -> i64
@link_name("elisapkg_chmod")
extern platform_chmod(path: cstr, mode: u16) -> i64
@link_name("elisapkg_collect_files")
extern platform_collect_files(root: cstr, output: mutable u8&, capacity: usize) -> i64
@link_name("elisapkg_access")
extern platform_access(path: cstr, mode: i64) -> i64
@link_name("elisapkg_realpath")
extern platform_realpath(path: cstr, resolved: mutable u8&, capacity: usize) -> cstr?
@link_name("getenv")
extern platform_getenv(name: cstr) -> u8&?
@link_name("fork")
extern platform_fork() -> i64
@link_name("execvp")
extern platform_execvp(path: cstr, argv: mutable cstr&&) -> i64
@link_name("waitpid")
extern platform_waitpid(pid: i64, status: mutable i64&, options: i64) -> i64
@link_name("elisapkg_set_process_group")
extern platform_set_process_group() -> i64
@link_name("elisapkg_set_process_limits")
extern platform_set_process_limits(profile: i64) -> i64
@link_name("elisapkg_waitpid_timeout")
extern platform_waitpid_timeout(pid: i64, status: mutable i64&, timeout_ms: i64) -> i64
@link_name("elisapkg_timeout_error")
extern platform_timeout_error() -> i64
@link_name("_exit")
extern platform_process_exit(code: i64)

@link_name("elisapkg_read_package_file")
extern platform_read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64
@link_name("elisapkg_package_file_size")
extern platform_package_file_size(path: cstr) -> i64
@link_name("elisapkg_is_directory")
extern platform_is_directory(path: cstr) -> i64
@link_name("elisapkg_extract_ustar")
extern platform_extract_ustar(archive: mutable u8&, archive_size: usize, destination: cstr) -> i64

module Platform:
    public:
        def pkg_read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64:
            return platform_read_package_file(path, output, capacity)
        def pkg_package_file_size(path: cstr) -> i64:
            return platform_package_file_size(path)
        def pkg_is_directory(path: cstr) -> i64:
            return platform_is_directory(path)
        def pkg_extract_ustar(archive: mutable u8&, archive_size: usize, destination: cstr) -> i64:
            return platform_extract_ustar(archive, archive_size, destination)
        def pkg_fopen(path: cstr, mode: cstr) -> mutable heap void&?:
            return platform_fopen(path, mode)
        def pkg_ferror(stream: heap void&) -> int:
            return platform_ferror(stream)
        def pkg_fclose(stream: heap void&) -> int:
            return platform_fclose(stream)
        def pkg_fread(buffer: mutable void&, size: usize, count: usize, stream: void&) -> usize:
            return platform_fread(buffer, size, count, stream)
        def pkg_fwrite(buffer: void&, size: usize, count: usize, stream: void&) -> usize:
            return platform_fwrite(buffer, size, count, stream)
        def pkg_mkdir(path: cstr, mode: u16) -> i64:
            return platform_mkdir(path, mode)
        def pkg_getcwd(buffer: void&, size: usize) -> void&:
            return platform_getcwd(buffer, size)
        def pkg_chdir(path: cstr) -> i64:
            return platform_chdir(path)
        def pkg_strlen(value: cstr) -> usize:
            return platform_strlen(value)
        def pkg_write(fd: i64, buffer: void&, count: usize) -> i64 can[Console.Write]:
            return platform_write(fd, buffer, count) can Console.Write
        def pkg_close(fd: i64) -> i64:
            return platform_close(fd)
        def pkg_mkstemp(template: mutable u8&) -> i64:
            return platform_mkstemp(template)
        def pkg_fsync(fd: i64) -> i64:
            return platform_fsync(fd)
        def pkg_rename(old_path: cstr, new_path: cstr) -> i64:
            return platform_rename(old_path, new_path)
        def pkg_link(old_path: cstr, new_path: cstr) -> i64:
            return platform_link(old_path, new_path)
        def pkg_unlink(path: cstr) -> i64:
            return platform_unlink(path)
        def pkg_rmdir(path: cstr) -> i64:
            return platform_rmdir(path)
        def pkg_chmod(path: cstr, mode: u16) -> i64:
            return platform_chmod(path, mode)
        def pkg_collect_files(root: cstr, output: mutable u8&, capacity: usize) -> i64:
            return platform_collect_files(root, output, capacity)
        def pkg_access(path: cstr, mode: i64) -> i64:
            return platform_access(path, mode)
        def pkg_realpath(path: cstr, resolved: mutable u8&) -> cstr?:
            return platform_realpath(path, resolved, 4096.usize())
        def pkg_getenv(name: cstr) -> u8&?:
            return platform_getenv(name)
        def pkg_fork() -> i64:
            return platform_fork()
        def pkg_execvp(path: cstr, argv: mutable cstr&&) -> i64:
            return platform_execvp(path, argv)
        def pkg_waitpid(pid: i64, status: mutable i64&, options: i64) -> i64:
            return platform_waitpid(pid, status, options)
        def pkg_set_process_group() -> i64:
            return platform_set_process_group()
        def pkg_set_process_limits(profile: i64) -> i64:
            return platform_set_process_limits(profile)
        def pkg_waitpid_timeout(pid: i64, status: mutable i64&, timeout_ms: i64) -> i64:
            return platform_waitpid_timeout(pid, status, timeout_ms)
        def pkg_timeout_error() -> i64:
            return platform_timeout_error()
        def pkg_process_exit(code: i64):
            platform_process_exit(code)

    private:
        # Stable libc modes are private policy details of file helpers.
        const read_mode: cstr = "rb"
        const write_mode: cstr = "wb"
