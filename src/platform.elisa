# Public platform boundary for elisapkg.
#
# PlatformNative is deliberately private to this compilation unit. Callers use
# this namespace rather than binding libc directly, which keeps OS details and
# security policy out of command modules.

include "./platform_native.elisa"

module Platform:
    public:
        def pkg_read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return PlatformNative::read_package_file(path, output, capacity)
        def pkg_package_file_size(path: cstr) -> i64:
            return PlatformNative::package_file_size(path)
        def pkg_is_directory(path: cstr) -> i64:
            return PlatformNative::is_directory(path)
        def pkg_extract_ustar(archive: darray[u8]&, destination: darray[u8]&) -> i64:
            return PlatformNative::extract_ustar(archive, destination)
        def pkg_fopen(path: cstr, mode: cstr) -> mutable heap void&? can[Unsafe.PointerCast]:
            return PlatformNative::fopen(path, mode)
        def pkg_ferror(stream: heap void&) -> int:
            return PlatformNative::ferror(stream)
        def pkg_fclose(stream: heap void&) -> int:
            return PlatformNative::fclose(stream)
        def pkg_fread(buffer: mutable void&, size: usize, count: usize, stream: void&) -> usize:
            return PlatformNative::fread(buffer, size, count, stream)
        def pkg_fwrite(buffer: void&, size: usize, count: usize, stream: void&) -> usize:
            return PlatformNative::fwrite(buffer, size, count, stream)
        def pkg_mkdir(path: cstr, mode: u16) -> i64 can[Unsafe.PointerCast]:
            return PlatformNative::mkdir(path, mode)
        def pkg_getcwd(buffer: void&, size: usize) -> void&:
            return native_getcwd(buffer, size)
        def pkg_chdir(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::chdir(path)
        def pkg_strlen(value: cstr) -> usize:
            return native_strlen(value)
        def pkg_cstr_equal(left: cstr, right: cstr) -> bool:
            left_length: usize = native_strlen(left)
            right_length: usize = native_strlen(right)
            return false if left_length != right_length
            for index in 0..<left_length |left, right|:
                return false if left[index].u8() != right[index].u8()
            return true
        def pkg_write(fd: i64, buffer: void&, count: usize) -> i64 can[Console.Write]:
            result: i64 = native_write(fd, buffer, count) can Console.Write
            return -75 if result > count.i64()
            return result
        def pkg_close(fd: i64) -> i64:
            return native_close(fd)
        def pkg_mkstemp(template: mutable u8&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::mkstemp(template)
        def pkg_fsync(fd: i64) -> i64:
            return native_fsync(fd)
        def pkg_fsync_parent(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::fsync_parent(path)
        def pkg_rename(old_path: cstr, new_path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::rename(old_path, new_path)
        def pkg_link(old_path: cstr, new_path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::link(old_path, new_path)
        def pkg_unlink(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::unlink(path)
        def pkg_rmdir(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::rmdir(path)
        def pkg_chmod(path: cstr, mode: u16) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::chmod(path, mode)
        def pkg_collect_files(root: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Unsafe.PointerCast]:
            return PlatformNative::collect_files(root, output, capacity)
        def pkg_access(path: cstr, mode: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::access(path, mode)
        def pkg_realpath(path: cstr, resolved: mutable u8&) -> cstr? can[Unsafe.PointerCast]:
            return PlatformNative::realpath(path, resolved, 4096.usize())
        def pkg_getenv(name: cstr) -> u8&?:
            return native_getenv(name)
        def pkg_fork() -> i64:
            return PlatformNative::fork()
        def pkg_execvp(path: cstr, argv: mutable cstr&&) -> i64:
            return PlatformNative::execvp(path, argv)
        def pkg_waitpid(pid: i64, status: mutable i64&, options: i64) -> i64:
            return native_waitpid(pid, status, options)
        def pkg_set_process_group() -> i64:
            return PlatformNative::set_process_group()
        def pkg_set_process_limits(profile: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::set_process_limits(profile)
        def pkg_waitpid_timeout(pid: i64, status: mutable i64&, timeout_ms: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::waitpid_timeout(pid, status, timeout_ms)
        def pkg_timeout_error() -> i64:
            return PlatformNative::timeout_error()
        def pkg_process_exit(code: i64):
            PlatformNative::process_exit(code)
        def pkg_verify_ed25519(public_key: darray[u8]&, message: darray[u8]&, signature: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::verify_ed25519(public_key, message, signature)
        def pkg_wall_clock_seconds() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::wall_clock_seconds()

    private:
        const read_mode: cstr = "rb"
        const write_mode: cstr = "wb"
