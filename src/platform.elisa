# Public platform boundary for elisapkg.
#
# PlatformNative is deliberately private to this compilation unit. Callers use
# this namespace rather than binding libc directly, which keeps OS details and
# security policy out of command modules.

include "./platform_native.elisa"
include "./platform/trusted_paths.elisa"
include "./platform/file_mutation.elisa"
include "./platform/process.elisa"
include "./platform/ed25519.elisa"
include "./platform/archive_extract.elisa"
include "./platform/file_collection.elisa"
include "./platform/locks.elisa"
include "./platform/snapshot_tree.elisa"

module Platform:
    public:
        def read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            PlatformNative::read_package_file(path, output, capacity)
        def read_bounded_file(path: darray[u8]&, maximum_bytes: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return false if path.count == 0.usize() or path.count > 4096.usize() or maximum_bytes > 67108864.usize()
            path_snapshot: mutable darray[u8] = []
            for index in 0..<path.count |path, path_snapshot|:
                return false if path[index] == 0
                path_snapshot <- path_snapshot.push(path[index])
            path_snapshot <- path_snapshot.push(0)
            path_name: cstr = (&path_snapshot[0]).cast[cstr] can Unsafe.PointerCast
            PlatformNative::read_bounded_regular_file(path_name, maximum_bytes, out)

        def read_trusted_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeTrustedPaths::read_trusted_file(path, output, capacity)
        def read_trusted_file_identity(path: cstr, output: mutable u8&, capacity: usize, out_device: mutable u64&, out_inode: mutable u64&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeTrustedPaths::read_trusted_file_identity(path, output, capacity, out_device, out_inode)
        def is_trusted_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeTrustedPaths::is_trusted_directory(path)
        def trusted_directory_status(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeTrustedPaths::trusted_directory_status(path)
        def ensure_trusted_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeTrustedPaths::ensure_trusted_directory(path)
        def package_file_size(path: cstr) -> i64:
            PlatformNative::package_file_size(path)
        def is_directory(path: cstr) -> i64:
            PlatformNative::is_directory(path)
        def extract_ustar_archive(archive: darray[u8]&, destination: darray[u8]&) -> i64:
            NativeArchiveExtract::extract_ustar(archive, destination)
        def make_directory(path: cstr, mode: u16) -> i64 can[Unsafe.PointerCast]:
            NativeFileMutation::mkdir(path, mode)
        def change_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            PlatformNative::chdir(path)
        def open_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            PlatformNative::open_directory_for_process(path)
        def change_directory_to_descriptor(file_descriptor: i64) -> i64:
            PlatformNative::fchdir(file_descriptor)
        def c_string_length(value: cstr) -> usize:
            PlatformNative::strlen(value)
        def c_string_equal(left: cstr, right: cstr) -> bool:
            PlatformNative::c_string_equal(left, right)
        def write_file_descriptor(file_descriptor: i64, buffer: void&, count: usize) -> i64 can[Console.Write]:
            result: i64 = PlatformNative::write(file_descriptor, buffer, count) can Console.Write
            -75 if result > count.i64() else result
        def read_file_descriptor(file_descriptor: i64, buffer: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            PlatformNative::read_file_descriptor(file_descriptor, buffer, capacity)
        def seek_file_descriptor(file_descriptor: i64, offset: i64, origin: i64) -> i64:
            PlatformNative::seek_file_descriptor(file_descriptor, offset, origin)
        def duplicate_file_descriptor_to(file_descriptor: i64, target: i64) -> i64:
            PlatformNative::duplicate_file_descriptor(file_descriptor, target)
        def duplicate_file_descriptor_at_least(file_descriptor: i64, minimum: i64) -> i64:
            PlatformNative::duplicate_file_descriptor_minimum(file_descriptor, minimum)
        def open_null_device() -> i64:
            PlatformNative::open_null()
        def close_file_descriptor(file_descriptor: i64) -> i64:
            PlatformNative::close(file_descriptor)
        def close_inherited_file_descriptors() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            PlatformNative::close_inherited_file_descriptors()
        def make_temporary_file(template: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeFileMutation::mkstemp(template)
        def create_exclusive_file(path: cstr) -> i64:
            NativeFileMutation::create_exclusive_file(path)
        def make_temporary_directory(template: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeFileMutation::mkdtemp(template)
        def synchronize_file(file_descriptor: i64) -> i64:
            PlatformNative::fsync(file_descriptor)
        def synchronize_parent_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeFileMutation::fsync_parent(path)
        def rename_path(old_path: cstr, new_path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeFileMutation::rename(old_path, new_path)
        def create_hard_link(old_path: cstr, new_path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeFileMutation::link(old_path, new_path)
        def unlink_path(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeFileMutation::unlink(path)
        def unlink_file_identity(path: cstr, device: u64, inode: u64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeFileMutation::unlink_file_identity(path, device, inode)
        def remove_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeFileMutation::rmdir(path)
        def change_mode(path: cstr, mode: u16) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeFileMutation::chmod(path, mode)
        def acquire_install_lock(prefix: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeLocks::acquire_install_lock(prefix)
        def acquire_project_transaction_lock(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeLocks::acquire_project_transaction_lock(path)
        def acquire_trust_state_lock(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeLocks::acquire_trust_state_lock(path)
        def collect_files(root: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Unsafe.PointerCast]:
            NativeFileCollection::collect_files(root, output, capacity)
        def snapshot_package_tree(source_root: cstr, destination: cstr, maximum_bytes: usize) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeSnapshotTree::snapshot_package_tree(source_root, destination, maximum_bytes)
        def cleanup_package_snapshot(destination: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeSnapshotTree::cleanup_package_snapshot(destination)
        def access_path(path: cstr, mode: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeTrustedPaths::access(path, mode)
        def resolve_real_path(path: cstr, resolved: mutable darray[u8]&) -> cstr? can[Unsafe.PointerCast]:
            PlatformNative::realpath(path, resolved)
        def environment_variable(name: cstr) -> u8&?:
            PlatformNative::getenv(name)
        def fork_process() -> i64:
            NativeProcess::fork()
        def execute_program(path: cstr, argument_vector: mutable cstr&&) -> i64 can[Unsafe.PointerCast]:
            NativeProcess::execvp(path, argument_vector)
        def set_process_group() -> i64:
            NativeProcess::set_process_group()
        def monotonic_milliseconds() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeProcess::monotonic_clock_milliseconds()
        def sleep_milliseconds(duration: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeProcess::sleep_milliseconds(duration)
        def process_identifier() -> i64:
            NativeProcess::process_identifier()
        def terminate_process_group(process_group: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeProcess::terminate_process_group(process_group)
        def set_process_limits(profile: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeProcess::set_process_limits(profile)
        def wait_for_process_with_timeout(child_process_identifier: i64, status: mutable i32&, timeout_milliseconds: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeProcess::waitpid_timeout(child_process_identifier, status, timeout_milliseconds)
        def wait_for_process_group_with_timeout(child_process_identifier: i64, status: mutable i32&, timeout_milliseconds: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeProcess::waitpid_group_timeout(child_process_identifier, status, timeout_milliseconds)
        def timeout_error() -> i64:
            NativeProcess::timeout_error()
        def directory_not_empty_error() -> i64:
            PlatformNative::directory_not_empty_error_code()
        def exit_process(code: i64):
            NativeProcess::process_exit(code)
        def verify_ed25519_signature(public_key: darray[u8]&, message: darray[u8]&, signature: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeEd25519::verify_ed25519(public_key, message, signature)
        def wall_clock_seconds() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            NativeProcess::wall_clock_seconds()
        def macos_toolchain_paths(sdk_root: mutable darray[u8]&, developer_directory: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            resolve_macos_toolchain_paths(sdk_root, developer_directory)

    private:
        const read_mode: cstr = "rb"
        const write_mode: cstr = "wb"

        def resolve_macos_toolchain_paths(sdk_root: mutable darray[u8]&, developer_directory: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            sdk_root.resize(0)
            developer_directory.resize(0)
            static if ELISA_TARGET_OS_MACOS:
                return false if not resolve_macos_sdk_root(sdk_root)
                return true if sdk_root.count == 0.usize()
                clt_prefix: darray[u8] = bytes_from_view("/Library/Developer/CommandLineTools/SDKs/")
                xcode_prefix: darray[u8] = bytes_from_view("/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/")
                if bytes_starts_with(sdk_root, clt_prefix):
                    bytes_append_view(developer_directory, "/Library/Developer/CommandLineTools")
                    return true
                if bytes_starts_with(sdk_root, xcode_prefix):
                    bytes_append_view(developer_directory, "/Applications/Xcode.app/Contents/Developer")
                    return true
                return false
            static else:
                return true

        def resolve_macos_sdk_root(out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            static if not ELISA_TARGET_OS_MACOS:
                return true

            if environment_variable("DEVELOPER_DIR") is configured_developer:
                developer_length: usize = c_string_length(configured_developer.cast[cstr] can Unsafe.PointerCast)
                if developer_length == 0.usize() or developer_length > 4096.usize():
                    false
                else:
                    developer: darray[u8] = [configured_developer[index] for index in 0..<developer_length]
                    absolute_path(developer) and (resolve_macos_sdk_candidate(macos_sdk_candidate(developer, "Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"), out) or resolve_macos_sdk_candidate(macos_sdk_candidate(developer, "SDKs/MacOSX.sdk"), out))
            elif resolve_macos_sdk_candidate(bytes_from_view("/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"), out):
                true
            else:
                # Match the stage1 wrapper's headless-host policy: if Command Line
                # Tools are installed, use them even when a launcher injected an
                # unrelated Xcode SDKROOT into the environment.
                configured_sdk: darray[u8] =
                    if environment_variable("SDKROOT") is configured:
                        configured_length: usize = c_string_length(configured.cast[cstr] can Unsafe.PointerCast)
                        if configured_length > 4096.usize():
                            return false
                        else:
                            [configured[index] for index in 0..<configured_length]
                    else:
                        []
                if configured_sdk.count > 0.usize():
                    resolve_macos_sdk_candidate(configured_sdk, out)
                else:
                    resolve_macos_sdk_candidate(bytes_from_view("/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"), out)

        # `developer`, a separating slash when it lacks one, then `suffix`.
        def macos_sdk_candidate(developer: darray[u8]&, suffix: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            candidate: mutable darray[u8] = developer.clone()
            if candidate.count == 0.usize() or candidate[candidate.count - 1.usize()] != 47:
                candidate <- candidate.push(47)
            for index in 0..<c_string_length(suffix) |candidate, suffix|:
                candidate <- candidate.push(suffix[index].u8())
            candidate

        def resolve_macos_sdk_candidate(candidate: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            printable: bool = for index in 0..<candidate.count |valid: bool = true| -> valid:
                byte: u8 = candidate[index]
                break false if byte == 0 or byte < 32 or byte == 127
            if candidate.count == 0.usize() or candidate.count > 4096.usize() or not absolute_path(candidate) or not printable:
                false
            else:
                candidate_c: mutable darray[u8] = candidate.clone()
                candidate_c <- candidate_c.push(0)
                resolved: mutable darray[u8] = []
                resolved <- resolved.resize(4096)
                if resolve_real_path(((&candidate_c[0]).cast[cstr] can Unsafe.PointerCast), &resolved) is canonical:
                    canonical_length: usize = c_string_length(canonical)
                    if canonical_length == 0.usize() or canonical_length >= 4096.usize() or is_directory(canonical) != 1:
                        false
                    else:
                        canonical_bytes: darray[u8] = [canonical[index].u8() for index in 0..<canonical_length]
                        if not supported_macos_sdk_path(canonical_bytes):
                            false
                        else:
                            bytes_append_array(out, canonical_bytes)
                            true
                else:
                    false

        def supported_macos_sdk_path(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            xcode_prefix: darray[u8] = bytes_from_view("/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/")
            command_line_tools_prefix: darray[u8] = bytes_from_view("/Library/Developer/CommandLineTools/SDKs/")
            # The leaf must start with `MacOSX`.
            leaf_start: usize = while position > 0.usize() and path[position - 1.usize()] != 47 |position: usize = path.count| -> position:
                position <- position - 1.usize()
            (bytes_starts_with(path, xcode_prefix) or bytes_starts_with(path, command_line_tools_prefix)) and path.count - leaf_start >= 7.usize() and path[leaf_start] == 77 and path[leaf_start + 1.usize()] == 97 and path[leaf_start + 2.usize()] == 99 and path[leaf_start + 3.usize()] == 79 and path[leaf_start + 4.usize()] == 83 and path[leaf_start + 5.usize()] == 88

        def absolute_path(path: darray[u8]&) -> bool:
            path.count > 0.usize() and path[0] == 47

        def bytes_starts_with(value: darray[u8]&, prefix: darray[u8]&) -> bool:
            return false if prefix.count > value.count
            for index in 0..<prefix.count |value, prefix|:
                return false if value[index] != prefix[index]
            true

        def bytes_append_array(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out.push(value[index])

        def bytes_from_view(value: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            [value[index].u8() for index in 0..<c_string_length(value)]

        def bytes_append_view(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            length: usize = c_string_length(value)
            for index in 0..<length |out, value|:
                out.push(value[index].u8())
