# Public platform boundary for elisapkg.
#
# PlatformNative is deliberately private to this compilation unit. Callers use
# this namespace rather than binding libc directly, which keeps OS details and
# security policy out of command modules.

include "./platform_native.elisa"

module Platform:
    public:
        def pkg_read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return PlatformNative::read_package_file(path, output, capacity)
        def pkg_read_trusted_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::read_trusted_file(path, output, capacity)
        def pkg_read_trusted_file_identity(path: cstr, output: mutable u8&, capacity: usize, out_device: mutable u64&, out_inode: mutable u64&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::read_trusted_file_identity(path, output, capacity, out_device, out_inode)
        def pkg_is_trusted_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::is_trusted_directory(path)
        def pkg_package_file_size(path: cstr) -> i64:
            return PlatformNative::package_file_size(path)
        def pkg_is_directory(path: cstr) -> i64:
            return PlatformNative::is_directory(path)
        def pkg_extract_ustar(archive: darray[u8]&, destination: darray[u8]&) -> i64:
            return PlatformNative::extract_ustar(archive, destination)
        def pkg_mkdir(path: cstr, mode: u16) -> i64 can[Unsafe.PointerCast]:
            return PlatformNative::mkdir(path, mode)
        def pkg_chdir(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::chdir(path)
        def pkg_open_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::open_directory_for_process(path)
        def pkg_fchdir(fd: i64) -> i64:
            return PlatformNative::fchdir(fd)
        def pkg_strlen(value: cstr) -> usize:
            return PlatformNative::strlen(value)
        def pkg_cstr_equal(left: cstr, right: cstr) -> bool:
            return PlatformNative::cstr_equal(left, right)
        def pkg_write(fd: i64, buffer: void&, count: usize) -> i64 can[Console.Write]:
            result: i64 = PlatformNative::write(fd, buffer, count) can Console.Write
            return -75 if result > count.i64()
            return result
        def pkg_read_fd(fd: i64, buffer: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return PlatformNative::read_fd(fd, buffer, capacity)
        def pkg_seek_fd(fd: i64, offset: i64, origin: i64) -> i64:
            return PlatformNative::seek_fd(fd, offset, origin)
        def pkg_dup2(fd: i64, target: i64) -> i64:
            return PlatformNative::duplicate_fd(fd, target)
        def pkg_dup_fd_min(fd: i64, minimum: i64) -> i64:
            return PlatformNative::duplicate_fd_min(fd, minimum)
        def pkg_open_null() -> i64:
            return PlatformNative::open_null()
        def pkg_close(fd: i64) -> i64:
            return PlatformNative::close(fd)
        def pkg_close_inherited_fds() -> i64:
            return PlatformNative::close_inherited_fds()
        def pkg_mkstemp(template: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::mkstemp(template)
        def pkg_create_exclusive_file(path: cstr) -> i64:
            return PlatformNative::create_exclusive_file(path)
        def pkg_mkdtemp(template: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::mkdtemp(template)
        def pkg_fsync(fd: i64) -> i64:
            return PlatformNative::fsync(fd)
        def pkg_fsync_parent(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::fsync_parent(path)
        def pkg_rename(old_path: cstr, new_path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::rename(old_path, new_path)
        def pkg_link(old_path: cstr, new_path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::link(old_path, new_path)
        def pkg_unlink(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::unlink(path)
        def pkg_unlink_file_identity(path: cstr, device: u64, inode: u64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::unlink_file_identity(path, device, inode)
        def pkg_rmdir(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::rmdir(path)
        def pkg_chmod(path: cstr, mode: u16) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::chmod(path, mode)
        def pkg_acquire_install_lock(prefix: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::acquire_install_lock(prefix)
        def pkg_acquire_project_transaction_lock(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::acquire_project_transaction_lock(path)
        def pkg_acquire_trust_state_lock(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::acquire_trust_state_lock(path)
        def pkg_collect_files(root: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Unsafe.PointerCast]:
            return PlatformNative::collect_files(root, output, capacity)
        def pkg_snapshot_package_tree(source_root: cstr, destination: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::snapshot_package_tree(source_root, destination)
        def pkg_cleanup_package_snapshot(destination: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::cleanup_package_snapshot(destination)
        def pkg_access(path: cstr, mode: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::access(path, mode)
        def pkg_realpath(path: cstr, resolved: mutable darray[u8]&) -> cstr? can[Unsafe.PointerCast]:
            return PlatformNative::realpath(path, resolved)
        def pkg_getenv(name: cstr) -> u8&?:
            return PlatformNative::getenv(name)
        def pkg_fork() -> i64:
            return PlatformNative::fork()
        def pkg_execvp(path: cstr, argv: mutable cstr&&) -> i64 can[Unsafe.PointerCast]:
            return PlatformNative::execvp(path, argv)
        def pkg_waitpid(pid: i64, status: mutable i32&, options: i64) -> i64:
            return PlatformNative::waitpid(pid, status, options)
        def pkg_set_process_group() -> i64:
            return PlatformNative::set_process_group()
        def pkg_monotonic_milliseconds() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::monotonic_clock_milliseconds()
        def pkg_sleep_milliseconds(duration: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::sleep_milliseconds(duration)
        def pkg_process_id() -> i64:
            return PlatformNative::process_id()
        def pkg_terminate_process_group(process_group: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::terminate_process_group(process_group)
        def pkg_set_process_limits(profile: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::set_process_limits(profile)
        def pkg_waitpid_timeout(pid: i64, status: mutable i32&, timeout_ms: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::waitpid_timeout(pid, status, timeout_ms)
        def pkg_waitpid_group_timeout(pid: i64, status: mutable i32&, timeout_ms: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::waitpid_group_timeout(pid, status, timeout_ms)
        def pkg_timeout_error() -> i64:
            return PlatformNative::timeout_error()
        def pkg_directory_not_empty_error() -> i64:
            return PlatformNative::directory_not_empty_error_code()
        def pkg_process_exit(code: i64):
            PlatformNative::process_exit(code)
        def pkg_verify_ed25519(public_key: darray[u8]&, message: darray[u8]&, signature: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::verify_ed25519(public_key, message, signature)
        def pkg_wall_clock_seconds() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return PlatformNative::wall_clock_seconds()
        def pkg_macos_toolchain_paths(sdk_root: mutable darray[u8]&, developer_dir: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return resolve_macos_toolchain_paths(sdk_root, developer_dir)

    private:
        const read_mode: cstr = "rb"
        const write_mode: cstr = "wb"

        def resolve_macos_toolchain_paths(sdk_root: mutable darray[u8]&, developer_dir: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            sdk_root.resize(0)
            developer_dir.resize(0)
            static if ELISA_TARGET_OS_MACOS:
                return false if not resolve_macos_sdk_root(sdk_root)
                return true if sdk_root.count == 0.usize()
                clt_prefix: mutable darray[u8] = []
                xcode_prefix: mutable darray[u8] = []
                bytes_append_view(&clt_prefix, "/Library/Developer/CommandLineTools/SDKs/")
                bytes_append_view(&xcode_prefix, "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/")
                if bytes_starts_with(sdk_root, clt_prefix):
                    bytes_append_view(developer_dir, "/Library/Developer/CommandLineTools")
                    return true
                if bytes_starts_with(sdk_root, xcode_prefix):
                    bytes_append_view(developer_dir, "/Applications/Xcode.app/Contents/Developer")
                    return true
                return false
            static else:
                return true

        def resolve_macos_sdk_root(out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            static if not ELISA_TARGET_OS_MACOS:
                return true

            if pkg_getenv("DEVELOPER_DIR") is configured_developer:
                developer_length: usize = pkg_strlen(configured_developer.cast[cstr] can Unsafe.PointerCast)
                return false if developer_length == 0.usize() or developer_length > 4096.usize()
                developer: mutable darray[u8] = []
                for index in 0..<developer_length |developer, configured_developer|:
                    developer.push(configured_developer[index])
                return false if not absolute_path(developer)
                candidate: mutable darray[u8] = []
                append_macos_sdk_candidate(developer, "Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk", &candidate)
                return true if resolve_macos_sdk_candidate(candidate, out)
                candidate.resize(0)
                append_macos_sdk_candidate(developer, "SDKs/MacOSX.sdk", &candidate)
                return resolve_macos_sdk_candidate(candidate, out)

            candidate: mutable darray[u8] = []
            clt_sdk: cstr = "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
            clt_sdk_length: usize = pkg_strlen(clt_sdk)
            for index in 0..<clt_sdk_length |candidate, clt_sdk|:
                candidate.push(clt_sdk[index].u8())
            return true if resolve_macos_sdk_candidate(candidate, out)

            # Match the stage1 wrapper's headless-host policy: if Command Line
            # Tools are installed, use them even when a launcher injected an
            # unrelated Xcode SDKROOT into the environment.
            if pkg_getenv("SDKROOT") is configured_sdk:
                configured_length: usize = pkg_strlen(configured_sdk.cast[cstr] can Unsafe.PointerCast)
                if configured_length > 0.usize():
                    candidate.resize(0)
                    return false if configured_length > 4096.usize()
                    for index in 0..<configured_length |candidate, configured_sdk|:
                        candidate.push(configured_sdk[index])
                    return resolve_macos_sdk_candidate(candidate, out)

            candidate.resize(0)
            xcode_sdk: cstr = "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
            xcode_sdk_length: usize = pkg_strlen(xcode_sdk)
            for index in 0..<xcode_sdk_length |candidate, xcode_sdk|:
                candidate.push(xcode_sdk[index].u8())
            return resolve_macos_sdk_candidate(candidate, out)

        def append_macos_sdk_candidate(developer: darray[u8]&, suffix: cstr, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            bytes_append_array(out, developer)
            if out.count == 0.usize() or out[out.count - 1.usize()] != 47:
                out.push(47)
            suffix_length: usize = pkg_strlen(suffix)
            for index in 0..<suffix_length |out, suffix|:
                out.push(suffix[index].u8())

        def resolve_macos_sdk_candidate(candidate: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return false if candidate.count == 0.usize() or candidate.count > 4096.usize() or not absolute_path(candidate)
            for index in 0..<candidate.count |candidate|:
                byte: u8 = candidate[index]
                return false if byte == 0 or byte < 32 or byte == 127
            candidate_c: mutable darray[u8] = []
            bytes_append_array(&candidate_c, candidate)
            candidate_c.push(0)
            resolved: mutable darray[u8] = []
            resolved.resize(4096)
            candidate_name: cstr = (&candidate_c[0]).cast[cstr] can Unsafe.PointerCast
            if pkg_realpath(candidate_name, &resolved) is canonical:
                canonical_length: usize = pkg_strlen(canonical)
                return false if canonical_length == 0.usize() or canonical_length >= 4096.usize() or pkg_is_directory(canonical) != 1
                canonical_bytes: mutable darray[u8] = []
                for index in 0..<canonical_length |canonical_bytes, canonical|:
                    canonical_bytes.push(canonical[index].u8())
                return false if not supported_macos_sdk_path(canonical_bytes)
                bytes_append_array(out, canonical_bytes)
                return true
            return false

        def supported_macos_sdk_path(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            xcode_prefix: mutable darray[u8] = []
            clt_prefix: mutable darray[u8] = []
            bytes_append_view(&xcode_prefix, "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/")
            bytes_append_view(&clt_prefix, "/Library/Developer/CommandLineTools/SDKs/")
            return false if not bytes_starts_with(path, xcode_prefix) and not bytes_starts_with(path, clt_prefix)
            leaf_start: mutable usize = path.count
            while leaf_start > 0.usize() and path[leaf_start - 1.usize()] != 47 |path, leaf_start|:
                leaf_start <- leaf_start - 1.usize()
            return false if path.count - leaf_start < 7.usize()
            return false if path[leaf_start] != 77 or path[leaf_start + 1.usize()] != 97 or path[leaf_start + 2.usize()] != 99 or path[leaf_start + 3.usize()] != 79 or path[leaf_start + 4.usize()] != 83 or path[leaf_start + 5.usize()] != 88
            return true

        def absolute_path(path: darray[u8]&) -> bool:
            return path.count > 0.usize() and path[0] == 47

        def bytes_starts_with(value: darray[u8]&, prefix: darray[u8]&) -> bool:
            return false if prefix.count > value.count
            for index in 0..<prefix.count |value, prefix|:
                return false if value[index] != prefix[index]
            return true

        def bytes_append_array(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out.push(value[index])

        def bytes_append_view(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            length: usize = pkg_strlen(value)
            for index in 0..<length |out, value|:
                out.push(value[index].u8())
