# Filesystem operations for the file-backed registry and its trust state.
include "../package/package_identity.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../text/bytes.elisa"
include "./root.elisa"

module RegistryFiles:
    public:
        def join_path_leaf(root: darray[u8]&, package: darray[u8]&, leaf: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if root.count == 0 or not RegistryRoot::valid(root)
            ByteText::append(out, root)
            if package.count > 0:
                out.push(47) if out.count == 0 or out[out.count - 1.usize()] != 47
                ByteText::append(out, package)
            leaf_length: usize = Platform::pkg_strlen(leaf)
            if leaf_length > 0:
                out.push(47) if out.count == 0 or out[out.count - 1.usize()] != 47
                for index in 0..<leaf_length |out, leaf|:
                    out.push(leaf[index].u8())
            return out.count <= 4096

        def join_path_version(root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if not PackageIdentity::valid_version(version)
            ByteText::append(out, root)
            out.push(47) if out.count == 0 or out[out.count - 1.usize()] != 47
            ByteText::append(out, package)
            out.push(47) if out.count == 0 or out[out.count - 1.usize()] != 47
            ByteText::append(out, version)
            return out.count <= 4096

        # The caller supplies an archive entry already checked by Archive.
        def join_archive_path(root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not join_path_version(root, package, version, out)
            out.push(47)
            ByteText::append(out, archive)
            return true

        def sibling_path(path: darray[u8]&, leaf: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            cursor: mutable usize = path.count
            while cursor > 0 and path[cursor - 1] != 47:
                cursor <- cursor - 1
            return false if cursor == 0
            ByteText::append_range(out, path, 0, cursor)
            ByteText::append_text(out, leaf)
            return out.count <= 4096

        def read_file(path: darray[u8]&, maximum: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            canonical: mutable darray[u8] = []
            return false if not:
                ProjectFiles::canonical_existing_path(path, &canonical)
                ByteText::equal(path, canonical)
            return Platform::pkg_read_bounded_file(path, maximum, out)

        def read_trusted_file(path: darray[u8]&, maximum: usize, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return -22 if not:
                maximum > 0.usize()
                maximum <= 1048576.usize()
                ProjectFiles::valid_path_bytes(path)
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            out.resize(maximum + 1.usize())
            raw: mutable u8& = (&out[0]).cast[mutable u8&] can Unsafe.PointerCast
            loaded: i64 = Platform::pkg_read_trusted_file(path_name, raw, out.count)
            if loaded < 0:
                out.resize(0)
                return loaded
            if loaded > maximum.i64():
                out.resize(0)
                return -27
            out.resize(loaded.usize())
            return loaded
