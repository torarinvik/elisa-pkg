# Parser for the signed version index, independent of file I/O and trust state.
include "../platform.elisa"
include "../package/package_identity.elisa"
include "../resolution/semver.elisa"
include "./root.elisa"
include "./bytes.elisa"

module RegistryIndexSnapshot:
    public:
        def parse(raw: darray[u8]&, registry_out: mutable darray[u8]&, package_out: mutable darray[u8]&, generation_out: mutable u64&, expires_out: mutable u64&, versions_out: mutable darray[u8]&, yanked_flags_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            registry_out.resize(0)
            package_out.resize(0)
            generation_out <- 0
            expires_out <- 0
            versions_out.resize(0)
            yanked_flags_out.resize(0)
            return false if raw.count == 0 or raw.count > 1048576 or raw[raw.count - 1.usize()] != 10
            cursor: mutable usize = 0
            header: cstr = "elisapkg-index:1\n"
            header_length: usize = Platform::pkg_strlen(header)
            return false if header_length > raw.count
            for index in 0..<header_length |raw, header|:
                return false if raw[index] != header[index].u8()
            cursor <- header_length

            registry_prefix: cstr = "registry:"
            registry_prefix_length: usize = Platform::pkg_strlen(registry_prefix)
            return false if cursor > raw.count or registry_prefix_length > raw.count - cursor
            for index in 0..<registry_prefix_length |raw, cursor, registry_prefix|:
                return false if raw[cursor + index] != registry_prefix[index].u8()
            cursor <- cursor + registry_prefix_length
            registry_start: usize = cursor
            while cursor < raw.count and raw[cursor] != 10 |raw, cursor|:
                return false if raw[cursor] < 32 or raw[cursor] == 127 or raw[cursor] == 92
                cursor <- cursor + 1
            return false if cursor == raw.count or cursor == registry_start
            for index in registry_start..<cursor |registry_out, raw|:
                registry_out.push(raw[index])
            cursor <- cursor + 1

            package_prefix: cstr = "package:"
            package_prefix_length: usize = Platform::pkg_strlen(package_prefix)
            return false if cursor > raw.count or package_prefix_length > raw.count - cursor
            for index in 0..<package_prefix_length |raw, cursor, package_prefix|:
                return false if raw[cursor + index] != package_prefix[index].u8()
            cursor <- cursor + package_prefix_length
            package_start: usize = cursor
            while cursor < raw.count and raw[cursor] != 10 |raw, cursor|:
                return false if raw[cursor] < 32 or raw[cursor] == 127 or raw[cursor] == 92
                cursor <- cursor + 1
            return false if cursor == raw.count or cursor == package_start
            for index in package_start..<cursor |package_out, raw|:
                package_out.push(raw[index])
            cursor <- cursor + 1

            generation_prefix: cstr = "generation:"
            generation_prefix_length: usize = Platform::pkg_strlen(generation_prefix)
            return false if cursor > raw.count or generation_prefix_length > raw.count - cursor
            for index in 0..<generation_prefix_length |raw, cursor, generation_prefix|:
                return false if raw[cursor + index] != generation_prefix[index].u8()
            cursor <- cursor + generation_prefix_length
            generation_start: usize = cursor
            generation_value: mutable u64 = 0
            while cursor < raw.count and raw[cursor] >= 48 and raw[cursor] <= 57 |raw, cursor, generation_value|:
                digit: u64 = (raw[cursor] - 48).u64()
                return false if generation_value > 1844674407370955161 or generation_value == 1844674407370955161 and digit > 5
                generation_value <- generation_value * 10 + digit
                cursor <- cursor + 1
            return false if cursor == generation_start or cursor >= raw.count or raw[cursor] != 10 or cursor - generation_start > 1.usize() and raw[generation_start] == 48
            return false if generation_value == 0
            generation_out <- generation_value
            cursor <- cursor + 1

            expires_prefix: cstr = "expires:"
            expires_prefix_length: usize = Platform::pkg_strlen(expires_prefix)
            return false if cursor > raw.count or expires_prefix_length > raw.count - cursor
            for index in 0..<expires_prefix_length |raw, cursor, expires_prefix|:
                return false if raw[cursor + index] != expires_prefix[index].u8()
            cursor <- cursor + expires_prefix_length
            expires_start: usize = cursor
            expires_value: mutable u64 = 0
            while cursor < raw.count and raw[cursor] >= 48 and raw[cursor] <= 57 |raw, cursor, expires_value|:
                digit: u64 = (raw[cursor] - 48).u64()
                return false if expires_value > 1844674407370955161 or expires_value == 1844674407370955161 and digit > 5
                expires_value <- expires_value * 10 + digit
                cursor <- cursor + 1
            return false if cursor == expires_start or cursor >= raw.count or raw[cursor] != 10 or cursor - expires_start > 1.usize() and raw[expires_start] == 48
            return false if expires_value == 0
            expires_out <- expires_value
            cursor <- cursor + 1

            versions_header: cstr = "versions:\n"
            versions_header_length: usize = Platform::pkg_strlen(versions_header)
            return false if cursor > raw.count or versions_header_length > raw.count - cursor
            for index in 0..<versions_header_length |raw, cursor, versions_header|:
                return false if raw[cursor + index] != versions_header[index].u8()
            cursor <- cursor + versions_header_length
            return false if not RegistryRoot::valid(registry_out) or not PackageIdentity::valid_name(package_out)
            previous: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            yanked_versions: mutable darray[u8] = []
            previous_yanked: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            candidates: mutable usize = 0
            yanked_count: mutable usize = 0
            reading_yanked: mutable bool = false
            while cursor < raw.count:
                start: usize = cursor
                finish: mutable usize = start
                while finish < raw.count and raw[finish] != 10 |raw, finish|:
                    finish <- finish + 1
                return false if finish == raw.count or finish == start or finish - start > 128
                version: mutable darray[u8] = []
                for index in start..<finish |version, raw|:
                    return false if raw[index] < 33 or raw[index] == 127 or raw[index] == 92
                    version.push(raw[index])
                if not reading_yanked and candidates > 0.usize() and RegistryBytes::equal_text(version, "yanked:"):
                    reading_yanked <- true
                    cursor <- finish + 1.usize()
                    continue
                parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                return false if not SemVer::parse(version, &parsed) or parsed.prerelease
                if reading_yanked:
                    return false if yanked_count > 0.usize() and SemVer::compare(parsed, previous_yanked) <= 0
                    for index in 0..<version.count |yanked_versions, version|:
                        yanked_versions.push(version[index])
                    yanked_versions.push(10)
                    previous_yanked <- parsed
                    yanked_count <- yanked_count + 1.usize()
                    return false if yanked_count > candidates
                else:
                    # Stable versions must have strictly increasing precedence.
                    # This also rules out duplicate spellings and build variants.
                    return false if candidates > 0 and SemVer::compare(parsed, previous) <= 0
                    previous <- parsed
                    for index in 0..<version.count |versions_out, version|:
                        versions_out.push(version[index])
                    versions_out.push(10)
                    candidates <- candidates + 1.usize()
                    return false if candidates > 4096.usize()
                cursor <- finish + 1
            return false if candidates == 0.usize()

            version_cursor: mutable usize = 0.usize()
            yanked_cursor: mutable usize = 0.usize()
            while version_cursor < versions_out.count:
                version_finish: mutable usize = version_cursor
                while version_finish < versions_out.count and versions_out[version_finish] != 10 |versions_out, version_finish|:
                    version_finish <- version_finish + 1.usize()
                return false if version_finish == versions_out.count
                current_version: mutable darray[u8] = []
                for index in version_cursor..<version_finish |current_version, versions_out|:
                    current_version.push(versions_out[index])
                current_parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                return false if not SemVer::parse(current_version, &current_parsed)
                is_yanked: mutable bool = false
                if yanked_cursor < yanked_versions.count:
                    yanked_finish: mutable usize = yanked_cursor
                    while yanked_finish < yanked_versions.count and yanked_versions[yanked_finish] != 10 |yanked_versions, yanked_finish|:
                        yanked_finish <- yanked_finish + 1.usize()
                    return false if yanked_finish == yanked_versions.count
                    yanked_version: mutable darray[u8] = []
                    for index in yanked_cursor..<yanked_finish |yanked_version, yanked_versions|:
                        yanked_version.push(yanked_versions[index])
                    yanked_parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                    return false if not SemVer::parse(yanked_version, &yanked_parsed)
                    comparison: i64 = SemVer::compare(yanked_parsed, current_parsed)
                    return false if comparison < 0
                    if comparison == 0:
                        return false if not RegistryBytes::equal(current_version, yanked_version)
                        is_yanked <- true
                        yanked_cursor <- yanked_finish + 1.usize()
                yanked_flags_out.push(1 if is_yanked else 0)
                version_cursor <- version_finish + 1.usize()
            return yanked_cursor == yanked_versions.count
