# Paths for rollback state kept outside the registry directory.
include "../integrity.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../state/user_data.elisa"
include "../text/bytes.elisa"

module TrustPaths:
    public:
        def prepare(root: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            resolve(root, true)

        def lookup(root: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            resolve(root, false)

    private:
        def resolve(root: darray[u8]&, create_directories: bool) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            override: u8&? = Platform::environment_variable("ELISAPKG_TRUST_STATE")
            if override is configured:
                final_path: darray[u8] =
                    value: cstr = configured.cast[cstr]
                    length: usize = Platform::c_string_length(value)
                    return [] if length == 0 or length > 4096 or value[0].u8() != 47
                    resolved: mutable darray[u8] = []
                    for index in 0..<length |resolved, value|:
                        byte: u8 = value[index].u8()
                        return [] if byte == 0 or byte < 32 or byte == 127 or byte == 92
                        resolved <- resolved.push(byte)
                    return [] if resolved[resolved.count - 1.usize()] == 47
                    for index in 1..<(length + 1.usize()) |segment_start: usize = 1.usize()|:
                        if index == length or value[index].u8() == 47:
                            region segment_length_scope:
                                segment_length: usize = index - segment_start
                                return [] if segment_length == 0.usize() or segment_length == 1.usize() and value[segment_start].u8() == 46 or segment_length == 2.usize() and value[segment_start].u8() == 46 and value[segment_start + 1.usize()].u8() == 46
                            segment_start <- index + 1.usize()
                    return [] if not trusted_state_parent(resolved)
                    [value[index].u8() for index in 0..<length]
                final_path
            else:
                directory: darray[u8] = UserData::prepare("trust") if create_directories else UserData::directory("trust")
                trust_state_path(root, directory)

        def trusted_state_parent(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if path.count == 0.usize() or path[0] != 47
            # The position just after the last slash.
            slash: usize = while position > 0.usize() and path[position - 1.usize()] != 47 |position: usize = path.count| -> position:
                position <- position - 1.usize()
            if slash == 0.usize():
                false
            else:
                parent: mutable darray[u8] = []
                if slash == 1.usize():
                    parent <- parent.push(47)
                else:
                    for index in 0..<(slash - 1.usize()) |parent, path|:
                        parent <- parent.push(path[index])
                parent <- parent.push(0)
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                Platform::is_trusted_directory(parent_name) == 1

        # "DIRECTORY/DIGEST.state" for `root`, or empty when the directory is
        # unavailable or `root` cannot be digested.
        def trust_state_path(root: darray[u8]&, directory: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            digest: mutable darray[u8] = []
            if directory.count == 0.usize() or not Integrity::sha256_hex(root, &digest):
                []
            else:
                state_path: darray[u8] = ByteText::with_text(ByteText::with_bytes(ProjectFiles::path_join(directory, ""), digest), ".state")
                [] if state_path.count > 4096.usize() else state_path
