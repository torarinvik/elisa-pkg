# Registry outcomes, user-facing diagnostics, and failure classification.

extend Registry:
    public:
        const enum ResultCode of u8:
            Ok
            NotConfigured
            InvalidConfiguration
            MissingIndex
            NoMatchingVersion
            MalformedMetadata
            MissingSignature
            MissingTrustRoot
            InvalidSignature
            ExpiredMetadata
            RollbackDetected
            DigestMismatch
            ArchiveMissing
            ResourceLimit
            TrustStateUnavailable
            TrustStateMalformed
            ClockRollback
            Unsatisfiable
            ClockUnavailable
            ExpiryHorizon
            TrustRootChanged
            TufEquivocationDetected

        def is_security_failure(code: ResultCode) -> bool:
            code == ResultCode.InvalidConfiguration or code == ResultCode.MalformedMetadata or code == ResultCode.MissingSignature or code == ResultCode.MissingTrustRoot or code == ResultCode.InvalidSignature or code == ResultCode.ExpiredMetadata or code == ResultCode.RollbackDetected or code == ResultCode.DigestMismatch or code == ResultCode.ResourceLimit or code == ResultCode.TrustStateUnavailable or code == ResultCode.TrustStateMalformed or code == ResultCode.ClockRollback or code == ResultCode.ClockUnavailable or code == ResultCode.ExpiryHorizon or code == ResultCode.TrustRootChanged or code == ResultCode.TufEquivocationDetected

        def result_message(code: ResultCode) -> cstr:
            match code:
                ResultCode.Ok: "ok"
                ResultCode.NotConfigured: "registry is not configured"
                ResultCode.InvalidConfiguration: "registry configuration is invalid"
                ResultCode.MissingIndex: "registry index is missing or unreadable"
                ResultCode.NoMatchingVersion: "no registry version satisfies the requirement"
                ResultCode.MalformedMetadata: "registry metadata or index snapshot is malformed"
                ResultCode.MissingSignature: "registry signature is missing"
                ResultCode.MissingTrustRoot: "registry trust root is missing"
                ResultCode.InvalidSignature: "registry signature is invalid"
                ResultCode.ExpiredMetadata: "registry metadata or index snapshot is expired"
                ResultCode.RollbackDetected: "registry metadata rollback detected"
                ResultCode.DigestMismatch: "registry archive digest does not match metadata"
                ResultCode.ArchiveMissing: "registry archive is missing or unreadable"
                ResultCode.ResourceLimit: "registry data or dependency resolution exceeds a resource limit"
                ResultCode.TrustStateUnavailable: "registry trust state is unavailable"
                ResultCode.TrustStateMalformed: "registry trust state is malformed"
                ResultCode.TrustRootChanged: "registry trust root changed without an authenticated rotation"
                ResultCode.ClockRollback: "registry trust clock moved backwards"
                ResultCode.Unsatisfiable: "registry dependency graph is unsatisfiable"
                ResultCode.ClockUnavailable: "host wall clock is unavailable"
                ResultCode.ExpiryHorizon: "registry metadata or index snapshot expiry exceeds the 30-day policy horizon"
                ResultCode.TufEquivocationDetected: "TUF metadata equivocation detected"
