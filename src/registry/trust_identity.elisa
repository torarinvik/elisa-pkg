# Persistent identities for registry rollback history and signing-key pins.
include "../integrity.elisa"
include "../package/package_identity.elisa"
include "../text/bytes.elisa"

module TrustIdentity:
    public:
        def valid(identity: darray[u8]&) -> bool:
            return PackageIdentity::valid_name(identity) or valid_root_key(identity) or history_digest_start(identity) > 0.usize()

        def valid_root_key(identity: darray[u8]&) -> bool:
            return ByteText::starts_with_text(identity, root_key_prefix) and Integrity::valid_sha256_hex_range(identity, 10.usize(), identity.count)

        def package(root: darray[u8]&, name: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return history_identity(root, name, package_prefix, out)

        def index(root: darray[u8]&, name: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return history_identity(root, name, index_prefix, out)

        # Keep the signing-key pin separate from package and index history.
        def root_key(root: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return append_root_digest(root, root_key_prefix, out)

        def root_key_from_history(identity: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            start: usize = history_digest_start(identity)
            return false if start == 0.usize()
            ByteText::append_text(out, root_key_prefix)
            for index in start..<(start + digest_bytes) |out, identity|:
                out.push(identity[index])
            return true

    private:
        const root_key_prefix: cstr = "@root-key:"
        const package_prefix: cstr = "@package:"
        const index_prefix: cstr = "@index:"
        const digest_bytes: usize = 64.usize()

        def history_digest_start(identity: darray[u8]&) -> usize:
            start: usize = 9.usize() if ByteText::starts_with_text(identity, package_prefix) else (7.usize() if ByteText::starts_with_text(identity, index_prefix) else 0.usize())
            separator: usize = start + digest_bytes
            return 0.usize() if:
                start == 0.usize() or identity.count <= separator + 1.usize()
                identity[separator] != 58
                not Integrity::valid_sha256_hex_range(identity, start, separator)
                not PackageIdentity::valid_name_segment(identity, separator + 1.usize(), identity.count)
            return start

        def history_identity(root: darray[u8]&, name: darray[u8]&, prefix: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if not PackageIdentity::valid_name(name) or not append_root_digest(root, prefix, out)
            out.push(58)
            ByteText::append(out, name)
            return true

        def append_root_digest(root: darray[u8]&, prefix: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            digest: mutable darray[u8] = []
            hex: mutable darray[u8] = []
            return false if Integrity::sha256(root, &digest) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest, &hex)
            ByteText::append_text(out, prefix)
            ByteText::append(out, hex)
            return true
