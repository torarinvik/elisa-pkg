# Locked persistence for authenticated TUF checkpoints.
include "../integrity.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../text/bytes.elisa"
include "../tuf.elisa"
include "./checkpoint_records.elisa"
include "./files.elisa"
include "./trust_paths.elisa"
include "./trust_storage.elisa"

module CheckpointStore:
    public:
        const enum Code of u8:
            InvalidConfiguration
            ResourceLimit
            MalformedMetadata
            TrustStateUnavailable
            Ok
            ClockUnavailable
            ClockRollback
            TrustStateMalformed
            RollbackDetected
            TufEquivocationDetected

        def commit_authenticated(registry_identity: darray[u8]&, batch: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return Code.InvalidConfiguration if not Tuf::valid_registry_identity_bytes(registry_identity)
            region batch_status_scope:
                batch_status: Tuf::ValidationCode = Tuf::validate_checkpoint_batch(batch)
                return Code.ResourceLimit if batch_status == Tuf::ValidationCode.ResourceLimit
                return Code.MalformedMetadata if batch_status != Tuf::ValidationCode.WellFormed
            scope_digest: mutable darray[u8] = []
            return Code.TrustStateUnavailable if not Integrity::sha256_hex(registry_identity, &scope_digest)
            state_path_snapshot: mutable darray[u8] = []
            lock_file_descriptor: i64 = acquire_state_lock(registry_identity, &state_path_snapshot)
            return Code.TrustStateUnavailable if lock_file_descriptor < 0
            state_path: mutable darray[u8] = [state_path_snapshot[index] for index in 0..<state_path_snapshot.count]
            state: mutable darray[u8] = []
            region read_status_scope:
                read_status: Code = trust_tuf_state_read(state_path, &state)
                return finish(lock_file_descriptor, read_status) if read_status != Code.Ok
            clock_path: darray[u8] = clock_path_for(state_path_snapshot)
            observed_clock: mutable u64 = 0.u64()
            clock_missing: mutable bool = false
            observed_state_digest: mutable darray[u8] = []
            region clock_status_scope:
                clock_status: Code = read_clock(clock_path, &observed_clock, &observed_state_digest, &clock_missing)
                return finish(lock_file_descriptor, clock_status) if clock_status != Code.Ok
            return finish(lock_file_descriptor, Code.TrustStateUnavailable) if clock_missing and state.count > 0.usize()
            current_state_digest: mutable darray[u8] = []
            return finish(lock_file_descriptor, Code.TrustStateUnavailable) if:
                not Integrity::sha256_hex(state, &current_state_digest)
                not clock_missing and not ByteText::equal(observed_state_digest, current_state_digest)
            now: i64 = Platform::wall_clock_seconds()
            return finish(lock_file_descriptor, Code.ClockUnavailable) if now < 0
            return finish(lock_file_descriptor, Code.ClockRollback) if observed_clock > now.u64()

            scoped_batch: mutable darray[u8] = []
            region scope_status_scope:
                scope_status: CheckpointRecords::Code = CheckpointRecords::scope_batch(scope_digest, batch, &scoped_batch)
                return finish(lock_file_descriptor, checkpoint_result(scope_status)) if scope_status != CheckpointRecords::Code.Ok
            updated_state: mutable darray[u8] = []
            region merge_status_scope:
                merge_status: CheckpointRecords::Code = CheckpointRecords::merge(state, scoped_batch, &updated_state)
                return finish(lock_file_descriptor, checkpoint_result(merge_status)) if merge_status != CheckpointRecords::Code.Ok

            region store_status_scope:
                store_status: Code = store_updated_state(state_path_snapshot, state, updated_state, current_state_digest, clock_missing or observed_clock < now.u64(), now.u64())
                return finish(lock_file_descriptor, store_status)

        def read(registry_identity: darray[u8]&, out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            out.resize(0)
            return Code.InvalidConfiguration if not Tuf::valid_registry_identity_bytes(registry_identity)
            scope_digest: mutable darray[u8] = []
            return Code.TrustStateUnavailable if not Integrity::sha256_hex(registry_identity, &scope_digest)
            state_path_snapshot: mutable darray[u8] = []
            lock_file_descriptor: i64 = acquire_state_lock(registry_identity, &state_path_snapshot)
            return Code.TrustStateUnavailable if lock_file_descriptor < 0
            state_path: mutable darray[u8] = [state_path_snapshot[index] for index in 0..<state_path_snapshot.count]
            state: mutable darray[u8] = []
            region read_status_scope:
                read_status: Code = trust_tuf_state_read(state_path, &state)
                return finish(lock_file_descriptor, read_status) if read_status != Code.Ok
            clock_path: darray[u8] = clock_path_for(state_path_snapshot)
            region clock_status_scope:
                clock_status: Code = verify_clock(clock_path, state)
                return finish(lock_file_descriptor, clock_status) if clock_status != Code.Ok
            return finish(lock_file_descriptor, Code.Ok) if state.count == 0.usize()
            batch: mutable darray[u8] = []
            return finish(lock_file_descriptor, Code.TrustStateMalformed) if not scoped_batch(state, scope_digest, &batch)
            region close_status_scope:
                close_status: Code = finish(lock_file_descriptor, Code.ResourceLimit if batch.count > Tuf::maximum_metadata_file_bytes else Code.Ok)
                return close_status if close_status != Code.Ok
            ByteText::append(out, batch)
            return Code.Ok

    private:
        def trust_tuf_state_read(path: darray[u8]&, out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            loaded: mutable darray[u8] = []
            region read_status_scope:
                read_status: i64 = RegistryFiles::read_trusted_file(path, CheckpointRecords::maximum_state_bytes, &loaded)
                if read_status < 0:
                    return Code.Ok if read_status == -2
                    return Code.TrustStateUnavailable
            return Code.TrustStateMalformed if not CheckpointRecords::valid(loaded)
            for index in 0..<loaded.count |out, loaded|:
                out.push(loaded[index])
            return Code.Ok

        # An empty state must have no clock. A non-empty state must have a
        # clock that records its digest and does not lie in the future.
        def verify_clock(clock_path: darray[u8]&, state: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            observed_clock: mutable u64 = 0.u64()
            clock_missing: mutable bool = false
            observed_state_digest: mutable darray[u8] = []
            region clock_status_scope:
                clock_status: Code = read_clock(clock_path, &observed_clock, &observed_state_digest, &clock_missing)
                return clock_status if clock_status != Code.Ok
            return Code.Ok if state.count == 0.usize() and clock_missing
            return Code.TrustStateUnavailable if state.count == 0.usize() or clock_missing
            region current_state_digest_scope:
                current_state_digest: mutable darray[u8] = []
                return Code.TrustStateUnavailable if not Integrity::sha256_hex(state, &current_state_digest) or not ByteText::equal(observed_state_digest, current_state_digest)
            now: i64 = Platform::wall_clock_seconds()
            return Code.ClockUnavailable if now < 0
            return Code.ClockRollback if observed_clock > now.u64()
            return Code.Ok

        # Collect the rows scoped to one registry as a TUF batch, with the
        # "SCOPE_DIGEST:" key prefix removed. Returns false for a malformed row.
        def scoped_batch(state: darray[u8]&, scope_digest: darray[u8]&, batch: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            prefix: mutable darray[u8] = [scope_digest[index] for index in 0..<scope_digest.count]
            prefix <- prefix.push(58)
            cursor: mutable usize = CheckpointRecords::header_length()
            while cursor < state.count |state, cursor, prefix, batch|:
                key: mutable darray[u8] = []
                version: mutable darray[u8] = []
                digest: mutable darray[u8] = []
                next_cursor: mutable usize = 0.usize()
                return false if not CheckpointRecords::parse_row(state, cursor, &key, &version, &digest, &next_cursor)
                if key.count > prefix.count and ByteText::starts_with(key, prefix):
                    if batch.count == 0.usize():
                        ByteText::append_text(batch, "elisapkg-tuf-batch:1\n")
                    ByteText::append_range(batch, key, prefix.count, key.count)
                    batch.push(32)
                    ByteText::append(batch, version)
                    batch.push(32)
                    ByteText::append(batch, digest)
                    batch.push(10)
                cursor <- next_cursor
            return true

        # Take the trust-state lock for one registry. Fills `state_path` with
        # the registry's ".tuf" state path and returns the lock descriptor,
        # or -1 when the paths are invalid or the lock is unavailable.
        def acquire_state_lock(registry_identity: darray[u8]&, state_path: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            prepared: mutable darray[u8] = TrustPaths::prepare(registry_identity)
            return -1 if prepared.count == 0 or prepared.count > 4080.usize()
            ByteText::append_text(&prepared, ".tuf")
            lock_path: mutable darray[u8] = []
            ByteText::append(&lock_path, prepared)
            ByteText::append_text(&lock_path, ".lock")
            return -1 if lock_path.count > 4096.usize()
            ByteText::append(state_path, prepared)
            lock_c: mutable darray[u8] = []
            lock_c <- ProjectFiles::with_null_terminator(lock_path)
            lock_name: cstr = (&lock_c[0]).cast[cstr] can Unsafe.PointerCast
            lock_file_descriptor: i64 = Platform::acquire_trust_state_lock(lock_name)
            return -1 if lock_file_descriptor < 0
            return lock_file_descriptor

        def clock_path_for(state_path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            clock_path: mutable darray[u8] = []
            ByteText::append(&clock_path, state_path)
            ByteText::append_text(&clock_path, ".clock")
            return clock_path

        # Persist a merge result. An unchanged state only advances its clock
        # when `advance_clock` is set; a changed state writes its clock first,
        # then the state itself.
        def store_updated_state(state_path: darray[u8]&, state: darray[u8]&, updated_state: darray[u8]&, current_state_digest: darray[u8]&, advance_clock: bool, now: u64) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if ByteText::equal(updated_state, state):
                return Code.Ok if not advance_clock
                return Code.Ok if TrustStorage::write_clock(clock_path_for(state_path), now, current_state_digest)
                return Code.TrustStateUnavailable
            updated_state_digest: mutable darray[u8] = []
            return Code.TrustStateUnavailable if not Integrity::sha256_hex(updated_state, &updated_state_digest)
            return Code.TrustStateUnavailable if not TrustStorage::write_clock(clock_path_for(state_path), now, updated_state_digest)
            state_path_copy: darray[u8] = [state_path[index] for index in 0..<state_path.count]
            return Code.TrustStateUnavailable if not TrustStorage::write(state_path_copy, updated_state)
            return Code.Ok

        def checkpoint_result(status: CheckpointRecords::Code) -> Code:
            return Code.MalformedMetadata if status == CheckpointRecords::Code.MalformedBatch
            return Code.ResourceLimit if status == CheckpointRecords::Code.ResourceLimit
            return Code.RollbackDetected if status == CheckpointRecords::Code.Rollback
            return Code.TufEquivocationDetected if status == CheckpointRecords::Code.Equivocation
            return Code.TrustStateMalformed if status == CheckpointRecords::Code.MalformedState
            return Code.Ok

        def finish(lock_file_descriptor: i64, code: Code) -> Code:
            return Code.TrustStateUnavailable if Platform::close_file_descriptor(lock_file_descriptor) != 0
            return code

        def read_clock(path: darray[u8]&, out: mutable u64&, state_digest: mutable darray[u8]&, missing: mutable bool&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return match TrustStorage::read_clock(path, out, state_digest, missing):
                TrustStorage::Code.Ok: Code.Ok
                TrustStorage::Code.Unavailable: Code.TrustStateUnavailable
                TrustStorage::Code.Malformed: Code.TrustStateMalformed
