# Schema and dependency checks for release records and packaged manifests.
include "../archive.elisa"
include "../integrity.elisa"
include "../json.elisa"
include "../package/package_identity.elisa"
include "../platform.elisa"
include "../resolution/semver.elisa"
include "../resolution/solver.elisa"
include "./bytes.elisa"

module ReleaseMetadata:
    public:
        def dependencies(raw: darray[u8]&, out: mutable darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            parsed: mutable darray[Solver::Constraint] = []
            return false if not parse_dependencies(raw, &parsed)
            for index in 0..<parsed.count |parsed, out|:
                out.push(parsed[index])
            return true

        def optional_object_empty(raw: darray[u8]&, wanted: cstr) -> bool:
            start: usize = value_start(raw, wanted)
            return true if start >= raw.count
            return false if raw[start] != 123
            finish: usize = Json::object_end(raw, start)
            return false if finish <= start or finish >= raw.count
            for index in (start + 1)..<finish |raw|:
                return false if not is_json_space(raw[index])
            return true

        def dependency_sets_equal(left: darray[Solver::Constraint]&, right: darray[Solver::Constraint]&) -> bool:
            return false if left.count != right.count
            for left_index in 0..<left.count |left, right|:
                found: mutable bool = false
                for right_index in 0..<right.count |left, right, left_index, found|:
                    found <- true if RegistryBytes::equal(left[left_index].package, right[right_index].package) and RegistryBytes::equal(left[left_index].requirement, right[right_index].requirement)
                return false if not found
            return true

        def value_start(raw: darray[u8]&, wanted: cstr) -> usize:
            key_length: usize = Platform::pkg_strlen(wanted)
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            braces: mutable i64 = 0
            brackets: mutable i64 = 0
            for index in 0..<raw.count |raw, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < raw.count and is_json_space(raw[after]) |raw, after|:
                        after <- after + 1
                    if braces == 1 and brackets == 0 and after < raw.count and raw[after] == 58 and index - string_start == key_length:
                        matched: mutable bool = true
                        for item in 0..<key_length |raw, wanted, string_start, matched|:
                            matched <- false if raw[string_start + item] != wanted[item].u8()
                        if matched:
                            after <- after + 1
                            while after < raw.count and is_json_space(raw[after]) |raw, after|:
                                after <- after + 1
                            return after
                    in_string <- false
            return raw.count

        def match_identity_fields(raw: darray[u8]&, root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, size_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            archive_out.resize(0)
            digest_out.resize(0)
            size_out <- 0.u64()
            return false if not PackageIdentity::valid_version(version)
            schema: mutable u64 = 0
            return false if not unsigned_field(raw, "schema-version", &schema) or schema != 1
            registry: mutable darray[u8] = []
            algorithm: mutable darray[u8] = []
            package_value: mutable darray[u8] = []
            version_value: mutable darray[u8] = []
            return false if not string_field(raw, "registry", &registry) or not string_field(raw, "algorithm", &algorithm) or not string_field(raw, "package", &package_value) or not string_field(raw, "version", &version_value)
            return false if not RegistryBytes::equal(registry, root) or not RegistryBytes::equal(package_value, package) or not RegistryBytes::equal(version_value, version)
            return false if not RegistryBytes::equal_text(algorithm, "ed25519")
            return false if not string_field(raw, "archive", archive_out) or not Archive::is_safe_entry(archive_out)
            return false if not string_field(raw, "archive-digest", digest_out) or not Integrity::valid_sha256_hex(digest_out)
            parsed_size: mutable u64 = 0
            return false if not unsigned_field(raw, "archive-size", &parsed_size) or parsed_size > Archive::max_archive_bytes.u64()
            size_out <- parsed_size
            return true

        def allowed_fields(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            first: mutable usize = 0
            last: mutable usize = raw.count
            while first < last and is_json_space(raw[first]) |raw, first|:
                first <- first + 1
            while last > first and is_json_space(raw[last - 1]) |raw, last|:
                last <- last - 1
            return false if first >= last or raw[first] != 123 or raw[last - 1] != 125
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (first + 1)..<last |raw, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < last and is_json_space(raw[after]) |raw, after|:
                        after <- after + 1
                    if braces == 1 and brackets == 0 and after < last and raw[after] == 58:
                        key: mutable darray[u8] = []
                        for item in string_start..<index |raw, key|:
                            key.push(raw[item])
                        allowed: bool = RegistryBytes::equal_text(key, "schema-version") or RegistryBytes::equal_text(key, "algorithm") or RegistryBytes::equal_text(key, "registry") or RegistryBytes::equal_text(key, "package") or RegistryBytes::equal_text(key, "version") or RegistryBytes::equal_text(key, "archive") or RegistryBytes::equal_text(key, "archive-size") or RegistryBytes::equal_text(key, "archive-digest") or RegistryBytes::equal_text(key, "expires") or RegistryBytes::equal_text(key, "dependencies")
                        return false if not allowed
                    in_string <- false
            return not in_string and not escaped and braces == 0 and brackets == 0

        def unsigned_field(raw: darray[u8]&, wanted: cstr, out: mutable u64&) -> bool:
            start: usize = Json::root_start(raw)
            return Json::object_unsigned_value(raw, start, Json::root_object_end(raw, start), wanted, out)

        def has_root_object(raw: darray[u8]&) -> bool:
            return Json::root_object_end(raw, Json::root_start(raw)) < raw.count

    private:
        const max_dependencies: usize = 4096

        def dependency_alias_seen(seen: darray[u8]&, wanted: darray[u8]&) -> bool:
            cursor: mutable usize = 0
            while cursor < seen.count:
                finish: mutable usize = cursor
                while finish < seen.count and seen[finish] != 0 |seen, finish|:
                    finish <- finish + 1
                return true if finish - cursor == wanted.count and alias_slice_equal(seen, cursor, finish, wanted)
                cursor <- finish + 1
            return false

        def alias_slice_equal(value: darray[u8]&, start: usize, finish: usize, wanted: darray[u8]&) -> bool:
            return false if finish < start or finish - start != wanted.count
            for item in 0..<wanted.count |value, start, wanted|:
                return false if value[start + item] != wanted[item]
            return true

        def parse_dependencies(raw: darray[u8]&, out: mutable darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            dependency_start: usize = value_start(raw, "dependencies")
            return true if dependency_start == raw.count
            dependency_end: usize = Json::object_end(raw, dependency_start)
            return false if dependency_start >= raw.count or dependency_end <= dependency_start or raw[dependency_start] != 123
            seen: mutable darray[u8] = []
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (dependency_start + 1)..<dependency_end |raw, out, seen, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < dependency_end and is_json_space(raw[after]) |raw, after|:
                        after <- after + 1
                    if braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58:
                        alias: mutable darray[u8] = []
                        for item in string_start..<index |raw, alias|:
                            alias.push(raw[item])
                        return false if not PackageIdentity::valid_name(alias) or dependency_alias_seen(seen, alias)
                        for item in 0..<alias.count |seen, alias|:
                            seen.push(alias[item])
                        seen.push(0)
                        after <- after + 1
                        while after < dependency_end and is_json_space(raw[after]) |raw, after|:
                            after <- after + 1
                        return false if after >= dependency_end or raw[after] != 123
                        value_end: usize = Json::object_end(raw, after)
                        return false if value_end <= after or value_end > dependency_end
                        return false if not dependency_allowed_fields(raw, after, value_end)
                        requirement: mutable darray[u8] = []
                        return false if not Json::object_string_value(raw, after, value_end, "version", &requirement)
                        parsed: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
                        return false if not SemVer::parse_requirement(requirement, &parsed)
                        registry_name: mutable darray[u8] = []
                        return false if not Json::object_string_value(raw, after, value_end, "registry", &registry_name) or not RegistryBytes::equal_text(registry_name, "primary")
                        return false if out.count >= max_dependencies
                        out.push(Solver::Constraint{package: alias, requirement: requirement})
                    in_string <- false
            return true

        def is_json_space(byte: u8) -> bool:
            return byte == 32 or byte == 9 or byte == 10 or byte == 13

        def string_field(raw: darray[u8]&, wanted: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            start: usize = Json::root_start(raw)
            return Json::object_string_value(raw, start, Json::root_object_end(raw, start), wanted, out)

        def dependency_allowed_fields(raw: darray[u8]&, start: usize, finish: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start >= finish or raw[start] != 123
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (start + 1)..<finish |raw, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < finish and is_json_space(raw[after]) |raw, after|:
                        after <- after + 1
                    if braces == 1 and brackets == 0 and after < finish and raw[after] == 58:
                        key: mutable darray[u8] = []
                        for item in string_start..<index |raw, key|:
                            key.push(raw[item])
                        return false if not RegistryBytes::equal_text(key, "registry") and not RegistryBytes::equal_text(key, "version")
                    in_string <- false
            return not in_string and not escaped and braces == 1 and brackets == 0
