# Schema and dependency checks for release records and packaged manifests.
include "../archive.elisa"
include "../integrity.elisa"
include "../json.elisa"
include "../package/package_identity.elisa"
include "../resolution/semver.elisa"
include "../resolution/solver.elisa"
include "../text/bytes.elisa"
include "../project/schema_fields.elisa"

module ReleaseMetadata:
    public:
        def dependencies(raw: darray[u8]&, out: mutable darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            if not parse_dependencies(raw, out):
                out.resize(0)
                return false
            return true

        def optional_object_empty(raw: darray[u8]&, wanted: cstr) -> bool:
            start: usize = Json::root_value_offset(raw, wanted)
            return true if start >= raw.count
            return false if raw[start] != 123
            finish: usize = Json::object_end(raw, start)
            return false if finish <= start or finish >= raw.count
            return Json::skip_whitespace(raw, start + 1.usize(), finish) == finish

        # Match each entry once so repeated constraints cannot hide a missing one.
        def dependency_sets_equal(left: darray[Solver::Constraint]&, right: darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if left.count != right.count
            used: mutable darray[bool] = []
            used <- used.resize(right.count)
            for left_index in 0..<left.count |left, right, used|:
                found: mutable bool = false
                for right_index in 0..<right.count |left, right, used, left_index, found|:
                    continue if used[right_index]
                    if ByteText::equal(left[left_index].package, right[right_index].package) and ByteText::equal(left[left_index].requirement, right[right_index].requirement):
                        used[right_index] <- true
                        found <- true
                        break
                return false if not found
            return true

        def match_identity_fields(raw: darray[u8]&, root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, size_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            archive_out.resize(0)
            digest_out.resize(0)
            size_out <- 0.u64()
            return false if not PackageIdentity::valid_version(version)
            schema: mutable u64 = 0
            return false if not unsigned_field(raw, "schema-version", &schema) or schema != 1
            start: usize = Json::root_start(raw)
            finish: usize = Json::root_object_end(raw, start)
            return false if:
                not Json::object_string_equals(raw, start, finish, "registry", root)
                not Json::object_string_equals_text(raw, start, finish, "algorithm", "ed25519")
                not Json::object_string_equals(raw, start, finish, "package", package)
                not Json::object_string_equals(raw, start, finish, "version", version)
                not Json::object_string_value(raw, start, finish, "archive", archive_out) or not Archive::is_safe_entry(archive_out)
                not Json::object_string_value(raw, start, finish, "archive-digest", digest_out) or not Integrity::valid_sha256_hex(digest_out)
            parsed_size: mutable u64 = 0
            return false if not Json::object_unsigned_value(raw, start, finish, "archive-size", &parsed_size) or parsed_size > Archive::max_archive_bytes.u64()
            size_out <- parsed_size
            return true

        def allowed_fields(raw: darray[u8]&) -> bool:
            start: usize = Json::root_start(raw)
            return SchemaFields::valid(raw, start, Json::root_object_end(raw, start), SchemaFields::Kind.RegistryRelease)

        def unsigned_field(raw: darray[u8]&, wanted: cstr, out: mutable u64&) -> bool:
            start: usize = Json::root_start(raw)
            return Json::object_unsigned_value(raw, start, Json::root_object_end(raw, start), wanted, out)

        def has_root_object(raw: darray[u8]&) -> bool:
            return Json::root_object_end(raw, Json::root_start(raw)) < raw.count

    private:
        const max_dependencies: usize = 4096

        def parse_dependencies(raw: darray[u8]&, out: mutable darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            dependency_start: usize = Json::root_value_offset(raw, "dependencies")
            return true if dependency_start == raw.count
            dependency_end: usize = Json::object_end(raw, dependency_start)
            return false if dependency_end <= dependency_start or dependency_end >= raw.count or raw[dependency_start] != 123
            cursor: mutable usize = Json::skip_whitespace(raw, dependency_start + 1.usize(), dependency_end)
            return true if cursor == dependency_end
            while cursor < dependency_end:
                return false if raw[cursor] != 34
                alias_start: usize = cursor + 1.usize()
                alias_end: usize =
                    while end < dependency_end and end - alias_start < PackageIdentity::max_name_bytes and raw[end] != 34 |end: usize = alias_start| -> end:
                        end <- end + 1.usize()
                return false if alias_end >= dependency_end or raw[alias_end] != 34
                separator: usize = Json::skip_whitespace(raw, alias_end + 1.usize(), dependency_end)
                return false if separator >= dependency_end or raw[separator] != 58
                value_start: usize = Json::skip_whitespace(raw, separator + 1.usize(), dependency_end)
                return false if value_start >= dependency_end or raw[value_start] != 123
                value_end: usize = Json::object_end(raw, value_start)
                return false if:
                    value_end <= value_start or value_end >= dependency_end
                    not append_dependency(raw, alias_start, alias_end, value_start, value_end, out)
                cursor <- Json::skip_whitespace(raw, value_end + 1.usize(), dependency_end)
                return true if cursor == dependency_end
                return false if raw[cursor] != 44
                cursor <- Json::skip_whitespace(raw, cursor + 1.usize(), dependency_end)
            return false

        def append_dependency(raw: darray[u8]&, alias_start: usize, alias_end: usize, value_start: usize, value_end: usize, out: mutable darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            requires alias_start <= alias_end and alias_end < value_start and value_start < value_end and value_end < raw.count
            return false if not PackageIdentity::valid_name_segment(raw, alias_start, alias_end)
            for existing in 0..<out.count |out, raw, alias_start, alias_end|:
                return false if ByteText::range_equals(raw, alias_start, alias_end, out[existing].package)
            alias: mutable darray[u8] = []
            ByteText::append_range(&alias, raw, alias_start, alias_end)
            return false if not SchemaFields::valid(raw, value_start, value_end, SchemaFields::Kind.RegistryDependency)
            requirement: mutable darray[u8] = []
            return false if not Json::object_string_value(raw, value_start, value_end, "version", &requirement)
            parsed: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
            return false if not SemVer::parse_requirement(requirement, &parsed)
            return false if:
                not Json::object_string_equals_text(raw, value_start, value_end, "registry", "primary")
                out.count >= max_dependencies
            out.push(Solver::Constraint{package: alias, requirement: requirement})
            return true
