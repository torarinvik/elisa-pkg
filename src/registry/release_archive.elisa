# Compare an authenticated release with the manifest embedded in its archive.
include "../archive.elisa"
include "../json.elisa"
include "../package/manifest.elisa"
include "../package/package_identity.elisa"
include "../resolution/solver.elisa"
include "../text/bytes.elisa"
include "./release_metadata.elisa"

module RegistryArchive:
    public:
        def matches_metadata(package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version)
            manifest_name: mutable darray[u8] = []
            ByteText::append_text(&manifest_name, "elisapkg.json")
            manifest: mutable darray[u8] = []
            return false if:
                not Archive::read_ustar_entry(archive, manifest_name, &manifest)
                manifest.count == 0 or manifest.count > Json::max_document_bytes or not Json::valid_utf8(manifest) or not Json::valid_document(manifest) or not Json::unique_object_keys(manifest) or not Manifest::allowed_keys(manifest) or not ReleaseMetadata::has_root_object(manifest)
            for index in 0..<manifest.count |manifest|:
                return false if manifest[index] == 0
            schema: mutable u64 = 0
            return false if not ReleaseMetadata::unsigned_field(manifest, "schema-version", &schema) or schema != 1
            package_start: usize = Json::root_value_offset(manifest, "package")
            package_end: usize = Json::object_end(manifest, package_start)
            return false if package_start >= manifest.count or manifest[package_start] != 123 or package_end <= package_start or package_end >= manifest.count
            return false if:
                not Json::object_string_equals(manifest, package_start, package_end, "name", package)
                not Json::object_string_equals(manifest, package_start, package_end, "version", version)
                not ReleaseMetadata::optional_object_empty(manifest, "dev-dependencies")
            signed_dependencies: mutable darray[Solver::Constraint] = []
            manifest_dependencies: mutable darray[Solver::Constraint] = []
            return false if:
                not ReleaseMetadata::dependencies(metadata, &signed_dependencies) or not ReleaseMetadata::dependencies(manifest, &manifest_dependencies)
                not ReleaseMetadata::dependency_sets_equal(signed_dependencies, manifest_dependencies)
            return true
