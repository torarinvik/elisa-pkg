# Compare an authenticated release with the manifest embedded in its archive.
include "../archive.elisa"
include "../json.elisa"
include "../package/manifest.elisa"
include "../package/package_identity.elisa"
include "../resolution/solver.elisa"
include "../text/bytes.elisa"
include "./release_metadata.elisa"

module RegistryArchive:
    public:
        def matches_metadata(package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version)
            manifest_name: mutable darray[u8] = []
            ByteText::append_text(&manifest_name, "elisapkg.json")
            manifest: mutable darray[u8] = []
            if not Archive::read_ustar_entry(archive, manifest_name, &manifest) or not Json::valid_document(manifest) or not Json::unique_object_keys(manifest) or not Manifest::allowed_keys(manifest):
                false
            else:
                root_start: usize = Json::root_start(manifest)
                root_end: usize = Json::root_object_end(manifest, root_start)
                schema: mutable u64 = 0
                package_start: mutable usize = 0
                package_end: mutable usize = 0
                signed_dependencies: mutable darray[Solver::Constraint] = []
                manifest_dependencies: mutable darray[Solver::Constraint] = []
                # The embedded manifest names this release and declares exactly
                # the dependencies the signed metadata lists.
                Json::object_unsigned_value(manifest, root_start, root_end, "schema-version", &schema) and schema == 1 and Json::object_value_span(manifest, root_start, root_end, "package", &package_start, &package_end) and Json::object_string_equals(manifest, package_start, package_end, "name", package) and Json::object_string_equals(manifest, package_start, package_end, "version", version) and ReleaseMetadata::optional_object_empty(manifest, "dev-dependencies") and ReleaseMetadata::dependencies(metadata, &signed_dependencies) and ReleaseMetadata::dependencies(manifest, &manifest_dependencies) and ReleaseMetadata::dependency_sets_equal(signed_dependencies, manifest_dependencies)
