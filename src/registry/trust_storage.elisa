# Durable state writes and clock records shared by both registry trust stores.
include "../project/files.elisa"
include "./files.elisa"
include "./trust_clock_record.elisa"

module TrustStorage:
    public:
        const enum Code of u8:
            Ok
            Unavailable
            Malformed

        def write(path: darray[u8]&, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            ProjectFiles::replace_file(path, value)

        def read_clock(path: darray[u8]&, out: mutable u64&, state_digest: mutable darray[u8]&, missing: mutable bool&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out <- 0
            state_digest.resize(0)
            missing <- false
            region loaded_scope:
                loaded: mutable darray[u8] = []
                region read_status_scope:
                    read_status: i64 = RegistryFiles::read_trusted_file(path, maximum_clock_read_bytes, &loaded)
                    if read_status < 0:
                        if read_status == -2:
                            missing <- true
                            return Code.Ok
                        return Code.Unavailable
                return Code.Malformed if not TrustClockRecord::decode(loaded, out, state_digest)
            Code.Ok

        def write_clock(path: darray[u8]&, value: u64, state_digest: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            encoded: mutable darray[u8] = []
            false if not TrustClockRecord::encode(value, state_digest, &encoded) else write(path, encoded)

    private:
        # Keep the read cap above the codec limit so small format violations
        # are reported as malformed records.
        const maximum_clock_read_bytes: usize = 128.usize()
