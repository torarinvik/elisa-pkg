# Parse on-disk registry rollback records and validate signing-key pins.
include "../integrity.elisa"
include "../package/model.elisa"
include "../package/package_identity.elisa"
include "../resolution/semver.elisa"
include "../text/bytes.elisa"
include "./trust_identity.elisa"

module RollbackRecords:
    public:
        const enum Code of u8:
            Ok
            Malformed
            Unavailable
            RootChanged

        def version_2(state: darray[u8]&) -> bool:
            return ByteText::starts_with_text(state, "elisapkg-trust-state:2\n")

        def version_3(state: darray[u8]&) -> bool:
            return ByteText::starts_with_text(state, "elisapkg-trust-state:3\n")

        def version_4(state: darray[u8]&) -> bool:
            return ByteText::starts_with_text(state, "elisapkg-trust-state:4\n")

        def find(state: darray[u8]&, package: darray[u8]&, version_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, metadata_digest_out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic]:
            version_out.resize(0)
            digest_out.resize(0)
            metadata_digest_out.resize(0)
            is_v2: bool = version_2(state)
            is_v3: bool = version_3(state)
            is_v4: bool = version_4(state)
            return Code.Malformed if not is_v2 and not is_v3 and not is_v4
            found: mutable bool = false
            while cursor < state.count |cursor: usize = 23.usize()|:
                finish: mutable usize = cursor
                while finish < state.count and state[finish] != 10 |state, finish|:
                    finish <- finish + 1.usize()
                # Every record is newline-terminated. A truncated final line
                # must not be treated as durable trust history.
                return Code.Malformed if finish == cursor or finish == state.count
                first_separator: mutable usize = cursor
                while first_separator < finish and state[first_separator] != 32 |state, first_separator|:
                    first_separator <- first_separator + 1.usize()
                second_separator: mutable usize = first_separator + 1.usize()
                while second_separator < finish and state[second_separator] != 32 |state, second_separator|:
                    second_separator <- second_separator + 1.usize()
                third_separator: mutable usize = second_separator + 1.usize()
                while third_separator < finish and state[third_separator] != 32 |state, third_separator|:
                    third_separator <- third_separator + 1.usize()
                return Code.Malformed if first_separator == cursor or second_separator >= finish or third_separator >= finish or first_separator + 1.usize() == second_separator or second_separator + 1.usize() == third_separator or third_separator + 1.usize() >= finish
                line_package: mutable darray[u8] = []
                line_version: mutable darray[u8] = []
                line_digest: mutable darray[u8] = []
                line_metadata_digest: mutable darray[u8] = []
                for index in cursor..<first_separator |line_package, state|:
                    line_package <- line_package.push(state[index])
                return Code.Malformed if:
                    is_v2 and ByteText::starts_with_text(line_package, "@package:")
                    (is_v3 or is_v4) and PackageIdentity::valid_name(line_package)
                for index in (first_separator + 1.usize())..<second_separator |line_version, state|:
                    line_version <- line_version.push(state[index])
                for index in (second_separator + 1.usize())..<third_separator |line_digest, state|:
                    line_digest <- line_digest.push(state[index])
                for index in (third_separator + 1.usize())..<finish |line_metadata_digest, state|:
                    line_metadata_digest <- line_metadata_digest.push(state[index])
                return Code.Malformed if not TrustIdentity::valid(line_package) or not Integrity::valid_sha256_hex(line_digest) or not Integrity::valid_sha256_hex(line_metadata_digest)
                parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                return Code.Malformed if not SemVer::parse(line_version, &parsed) or parsed.prerelease
                previous: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                should_copy: mutable bool = false
                if ByteText::equal(line_package, package):
                    if found:
                        return Code.Malformed if:
                            not SemVer::parse(version_out, &previous)
                            SemVer::compare(parsed, previous) < 0
                            SemVer::compare(parsed, previous) == 0 and (not ByteText::equal(digest_out, line_digest) or not ByteText::equal(metadata_digest_out, line_metadata_digest))
                        should_copy <- SemVer::compare(parsed, previous) > 0
                    else:
                        should_copy <- true
                    if should_copy:
                        version_out.resize(0)
                        digest_out.resize(0)
                        metadata_digest_out.resize(0)
                        for index in 0..<line_version.count |version_out, line_version|:
                            version_out.push(line_version[index])
                        for index in 0..<line_digest.count |digest_out, line_digest|:
                            digest_out.push(line_digest[index])
                        for index in 0..<line_metadata_digest.count |metadata_digest_out, line_metadata_digest|:
                            metadata_digest_out.push(line_metadata_digest[index])
                    found <- true
                cursor <- finish + 1.usize()
            return Code.Ok

        def check_root_pin(state: darray[u8]&, root_key_identity: darray[u8]&, key_fingerprint: darray[u8]&, require_existing: bool, compare_key: bool, found_out: mutable bool&) -> Code can[Memory.Allocate, Abort.Panic]:
            found_out <- false
            pinned_version: mutable darray[u8] = []
            pinned_digest: mutable darray[u8] = []
            pinned_metadata_digest: mutable darray[u8] = []
            region find_status_scope:
                find_status: Code = find(state, root_key_identity, &pinned_version, &pinned_digest, &pinned_metadata_digest) if state.count > 0 else Code.Ok
                return find_status if find_status != Code.Ok
            if pinned_version.count == 0:
                return Code.Unavailable if require_existing or version_4(state) and has_root_scoped_history(state, root_key_identity)
                return Code.Ok
            return Code.Malformed if not ByteText::equal_text(pinned_version, "0.0.0") or not ByteText::equal(pinned_digest, pinned_metadata_digest)
            return Code.RootChanged if compare_key and not ByteText::equal(pinned_digest, key_fingerprint)
            found_out <- true
            return Code.Ok

        def legacy_override_status(state: darray[u8]&, has_override: bool) -> Code can[Memory.Allocate, Abort.Panic]:
            return Code.Ok if:
                not version_2(state)
                not has_override
            empty_identity: mutable darray[u8] = []
            unused_version: mutable darray[u8] = []
            unused_digest: mutable darray[u8] = []
            unused_metadata_digest: mutable darray[u8] = []
            region validation_status_scope:
                validation_status: Code = find(state, empty_identity, &unused_version, &unused_digest, &unused_metadata_digest)
                return validation_status if validation_status != Code.Ok
            while cursor < state.count |cursor: usize = 23.usize()|:
                finish: mutable usize = cursor
                while finish < state.count and state[finish] != 10 |state, finish|:
                    finish <- finish + 1.usize()
                return Code.Malformed if finish == state.count
                separator: mutable usize = cursor
                while separator < finish and state[separator] != 32 |state, separator|:
                    separator <- separator + 1.usize()
                return Code.Malformed if separator == cursor or separator == finish
                region identity_scope:
                    identity: mutable darray[u8] = []
                    for index in cursor..<separator |identity, state|:
                        identity <- identity.push(state[index])
                    return Code.Unavailable if PackageIdentity::valid_name(identity)
                cursor <- finish + 1.usize()
            return Code.Ok

        def upgrade_to_v4(root: darray[u8]&, state: darray[u8]&, has_override: bool, out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            if state.count == 0:
                ByteText::append_text(out, "elisapkg-trust-state:4\n")
                return Code.Ok
            if version_4(state):
                for index in 0..<state.count |out, state|:
                    out.push(state[index])
                return Code.Ok
            return Code.Malformed if not version_2(state) and not version_3(state)
            empty_identity: mutable darray[u8] = []
            unused_version: mutable darray[u8] = []
            unused_digest: mutable darray[u8] = []
            unused_metadata_digest: mutable darray[u8] = []
            region validation_status_scope:
                validation_status: Code = legacy_override_status(state, true) if has_override and version_2(state) else find(state, empty_identity, &unused_version, &unused_digest, &unused_metadata_digest)
                return validation_status if validation_status != Code.Ok
            ByteText::append_text(out, "elisapkg-trust-state:4\n")
            while cursor < state.count |cursor: usize = 23.usize()|:
                finish: mutable usize = cursor
                while finish < state.count and state[finish] != 10 |state, finish|:
                    finish <- finish + 1.usize()
                return Code.Malformed if finish == state.count
                separator: mutable usize = cursor
                while separator < finish and state[separator] != 32 |state, separator|:
                    separator <- separator + 1.usize()
                return Code.Malformed if separator == cursor or separator == finish
                region identity_scope:
                    identity: mutable darray[u8] = []
                    for index in cursor..<separator |identity, state|:
                        identity <- identity.push(state[index])
                    if PackageIdentity::valid_name(identity):
                        scoped_identity: mutable darray[u8] = []
                        return Code.Unavailable if not TrustIdentity::package(root, identity, &scoped_identity)
                        ByteText::append(out, scoped_identity)
                    else:
                        ByteText::append(out, identity)
                for index in separator..=finish |out, state|:
                    out.push(state[index])
                return Code.Unavailable if out.count > 1048576.usize()
                cursor <- finish + 1.usize()
            return Code.Ok

    private:
        def has_root_scoped_history(state: darray[u8]&, root_key_identity: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not version_4(state) or state.count <= 23.usize()
            return true if not ByteText::starts_with_text(root_key_identity, "@root-key:") or root_key_identity.count != 74.usize()
            root_hash: mutable darray[u8] = []
            for index in 0..<64.usize() |root_hash, root_key_identity|:
                root_hash <- root_hash.push(root_key_identity[10.usize() + index])
            package_prefix: mutable darray[u8] = []
            ByteText::append_text(&package_prefix, "@package:")
            ByteText::append(&package_prefix, root_hash)
            package_prefix <- package_prefix.push(58)
            index_prefix: mutable darray[u8] = []
            ByteText::append_text(&index_prefix, "@index:")
            ByteText::append(&index_prefix, root_hash)
            index_prefix <- index_prefix.push(58)
            while cursor < state.count |cursor: usize = 23.usize()|:
                finish: mutable usize = cursor
                while finish < state.count and state[finish] != 10 |state, finish|:
                    finish <- finish + 1.usize()
                return true if finish == state.count
                identity_end: mutable usize = cursor
                while identity_end < finish and state[identity_end] != 32 |state, identity_end|:
                    identity_end <- identity_end + 1.usize()
                return true if identity_end == cursor or identity_end == finish
                package_match: mutable bool = identity_end - cursor >= package_prefix.count
                region index_match_scope:
                    index_match: mutable bool = identity_end - cursor >= index_prefix.count
                    for index in 0..<package_prefix.count |state, cursor, identity_end, package_prefix, package_match|:
                        package_match <- package_match and state[cursor + index] == package_prefix[index]
                    for index in 0..<index_prefix.count |state, cursor, identity_end, index_prefix, index_match|:
                        index_match <- index_match and state[cursor + index] == index_prefix[index]
                    return true if package_match or index_match
                cursor <- finish + 1.usize()
            return false
