# Exact byte comparisons for authenticated registry records.
module RegistryBytes:
    public:
        def equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true

        def equal_text(value: darray[u8]&, expected: cstr) -> bool:
            length: usize = text_length(expected)
            return false if value.count != length
            for index in 0..<length |value, expected|:
                return false if value[index] != expected[index].u8()
            return true

        def append_text(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            length: usize = text_length(value)
            for index in 0..<length |out, value|:
                out.push(value[index].u8())

        def append(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out.push(value[index])

        def starts_with_text(value: darray[u8]&, expected: cstr) -> bool:
            length: usize = text_length(expected)
            return false if value.count < length
            for index in 0..<length |value, expected|:
                return false if value[index] != expected[index].u8()
            return true

        def append_decimal(out: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            start: usize = out.count
            out.resize(start + 20.usize())
            number: mutable u64 = value
            cursor: mutable usize = start
            if number == 0:
                out[cursor] <- 48
                cursor <- cursor + 1.usize()
            else:
                while number > 0 |out, number, cursor|:
                    out[cursor] <- 48 + (number % 10).u8()
                    cursor <- cursor + 1.usize()
                    number <- number / 10
                left: mutable usize = start
                right: mutable usize = cursor
                while left < right and right - left > 1.usize() |out, left, right|:
                    right <- right - 1.usize()
                    temporary: u8 = out[left]
                    out[left] <- out[right]
                    out[right] <- temporary
                    left <- left + 1.usize()
            out.resize(cursor)

    private:
        def text_length(value: cstr) -> usize:
            length: mutable usize = 0.usize()
            while value[length].u8() != 0:
                length <- length + 1.usize()
            return length
