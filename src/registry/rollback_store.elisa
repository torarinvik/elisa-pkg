# Locked rollback transactions for the legacy signed registry.
include "../integrity.elisa"
include "../package/model.elisa"
include "../package/package_identity.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../resolution/semver.elisa"
include "../text/bytes.elisa"
include "./configuration.elisa"
include "./files.elisa"
include "./rollback_records.elisa"
include "./trust_identity.elisa"
include "./trust_paths.elisa"
include "./trust_storage.elisa"

module RollbackStore:
    public:
        const enum Code of u8:
            Ok
            TrustStateUnavailable
            TrustStateMalformed
            TrustRootChanged
            InvalidConfiguration
            NotConfigured
            ClockRollback
            RollbackDetected
            DigestMismatch
            ExpiredMetadata
            ExpiryHorizon
            MissingTrustRoot

        def record_index(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64, key_fingerprint: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return Code.InvalidConfiguration if not TrustIdentity::valid_index(package)
            guard: IndexGuard = IndexGuard{enabled: false, generation: 0, digest: [], identity: []}
            record(package, version, digest, metadata_digest, expires, guard, key_fingerprint)

        def record_release(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64, generation: u64, index_digest: darray[u8]&, index_identity: darray[u8]&, key_fingerprint: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return Code.InvalidConfiguration if not PackageIdentity::valid_name(package)
            guard: IndexGuard = IndexGuard{enabled: true, generation: generation, digest: copy(index_digest), identity: copy(index_identity)}
            record(package, version, digest, metadata_digest, expires, guard, key_fingerprint)

        def verify_release(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return Code.InvalidConfiguration if not TrustIdentity::valid(package) or not PackageIdentity::valid_version(version) or not Integrity::valid_sha256_hex(digest) or not Integrity::valid_sha256_hex(metadata_digest)
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return Code.InvalidConfiguration if not SemVer::parse(version, &parsed) or parsed.prerelease
            # FFI may invalidate caller-owned array headers, so work on copies.
            release: Release = Release{package: copy(package), version: copy(version), digest: copy(digest), metadata_digest: copy(metadata_digest)}
            lock_path: darray[u8] =
                root: mutable darray[u8] = []
                return Code.InvalidConfiguration if not read_environment_root(&root)
                lock_path_for(TrustPaths::lookup(root))
            return Code.TrustStateUnavailable if lock_path.count == 0.usize()
            lock_file_descriptor: i64 = acquire_lock(lock_path)
            Code.TrustStateUnavailable if lock_file_descriptor < 0 else trust_state_finish(lock_file_descriptor, verify_locked(release, parsed, expires, lock_path))

        def metadata_expiry_status(expires: u64, now: u64) -> Code:
            Code.ExpiredMetadata if expires <= now else Code.ExpiryHorizon if expires - now > maximum_metadata_lifetime_seconds else Code.Ok

    private:
        const maximum_metadata_lifetime_seconds: u64 = 2592000

        # The release a trust-state operation verifies or records.
        struct Release:
            package: darray[u8]
            version: darray[u8]
            digest: darray[u8]
            metadata_digest: darray[u8]

        # A release recorded from a package index must match the index
        # generation and digest the trust state already holds for it.
        struct IndexGuard:
            enabled: bool
            generation: u64
            digest: darray[u8]
            identity: darray[u8]

        # How the stored registry root-key pin must look.
        struct PinPolicy:
            require_existing: bool
            compare_key: bool
            recheck_root_key_after_clock: bool

        # A recorded release: its version and both digests.
        struct History:
            version: mutable darray[u8]
            digest: mutable darray[u8]
            metadata_digest: mutable darray[u8]

        # What a locked trust-state operation read before deciding.
        struct Observation:
            state: mutable darray[u8]
            key_pin_found: mutable bool
            observed_clock: mutable u64
            clock_missing: mutable bool
            current_state_digest: mutable darray[u8]
            now: mutable u64
            root_after_clock: mutable darray[u8]

        def copy(value: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            [value[index] for index in 0..<value.count]

        # Copy `ELISAPKG_REGISTRY_DIR` into `out`. An unset variable leaves
        # `out` empty; an empty or overlong value is invalid.
        def read_environment_root(out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            if Platform::environment_variable("ELISAPKG_REGISTRY_DIR") is configured_root:
                value: cstr = configured_root.cast[cstr]
                length: usize = Platform::c_string_length(value)
                return false if length == 0 or length > 4096
                for index in 0..<length:
                    out.push(value[index].u8())
            true

        # The lock path beside a trust-state file, or empty when the state
        # path is unusable.
        def lock_path_for(state_path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if state_path.count == 0 or state_path.count > 4090.usize()
            lock_path: mutable darray[u8] = copy(state_path)
            ByteText::append_text(&lock_path, ".lock")
            lock_path

        def clock_path_for(state_path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            clock_path: mutable darray[u8] = copy(state_path)
            ByteText::append_text(&clock_path, ".clock")
            clock_path

        def acquire_lock(lock_path: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            lock_c_string: mutable darray[u8] = []
            lock_c_string <- ProjectFiles::with_null_terminator(lock_path)
            Platform::acquire_trust_state_lock((&lock_c_string[0]).cast[cstr] can Unsafe.PointerCast)

        def record(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64, guard: IndexGuard&, key_fingerprint: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return Code.InvalidConfiguration if not TrustIdentity::valid(package) or not PackageIdentity::valid_version(version) or not Integrity::valid_sha256_hex(digest) or not Integrity::valid_sha256_hex(metadata_digest) or not guard.enabled and not Integrity::valid_sha256_hex(key_fingerprint)
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return Code.InvalidConfiguration if:
                not SemVer::parse(version, &parsed) or parsed.prerelease
                guard.enabled and (guard.generation == 0 or not Integrity::valid_sha256_hex(guard.digest) or not TrustIdentity::valid(guard.identity))
            lock_path: darray[u8] =
                root: mutable darray[u8] = []
                return Code.NotConfigured if not RegistryConfiguration::configured_root(&root)
                if guard.enabled:
                    expected_index_identity: mutable darray[u8] = []
                    return Code.TrustStateUnavailable if not TrustIdentity::index(root, package, &expected_index_identity)
                    return Code.InvalidConfiguration if not ByteText::equal(expected_index_identity, guard.identity)
                lock_path_for(TrustPaths::prepare(root))
            return Code.TrustStateUnavailable if lock_path.count == 0.usize()
            # The lock inode is held by the descriptor, so the lock needs no
            # pathname-based cleanup.
            lock_file_descriptor: i64 = acquire_lock(lock_path)
            return Code.TrustStateUnavailable if lock_file_descriptor < 0
            release: Release = Release{package: copy(package), version: copy(version), digest: copy(digest), metadata_digest: copy(metadata_digest)}
            trust_state_finish(lock_file_descriptor, record_locked(release, parsed, expires, guard, key_fingerprint, lock_path))

        # Rebuild every path after taking the lock: the stage1 ABI may
        # invalidate caller-owned arrays across FFI boundaries, and the
        # configuration must still name the state file that was locked.
        def verify_locked(release: Release&, parsed: Model::Version, expires: u64, lock_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            key_fingerprint: mutable darray[u8] = []
            key_status: Code = locked_key_fingerprint(&key_fingerprint)
            key_status if key_status != Code.Ok else verify_with_key(release, parsed, expires, lock_path, key_fingerprint)

        def locked_key_fingerprint(key_fingerprint: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root_after_lock: mutable darray[u8] = []
            Code.InvalidConfiguration if not read_environment_root(&root_after_lock) else read_key_fingerprint(root_after_lock, key_fingerprint)

        def verify_with_key(release: Release&, parsed: Model::Version, expires: u64, lock_path: darray[u8]&, key_fingerprint: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root_after_key: mutable darray[u8] = []
            root_key_identity: mutable darray[u8] = []
            Code.TrustStateUnavailable if not RegistryConfiguration::configured_root(&root_after_key) or not TrustIdentity::root_key(root_after_key, &root_key_identity) else verify_at_state(release, parsed, expires, lock_path, key_fingerprint, root_key_identity, TrustPaths::lookup(root_after_key))

        def verify_at_state(release: Release&, parsed: Model::Version, expires: u64, lock_path: darray[u8]&, key_fingerprint: darray[u8]&, root_key_identity: darray[u8]&, state_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return Code.TrustStateUnavailable if not ByteText::equal(lock_path_for(state_path), lock_path)
            observation: mutable Observation = empty_observation()
            observe_status: Code = observe(state_path, root_key_identity, key_fingerprint, PinPolicy{require_existing: true, compare_key: true, recheck_root_key_after_clock: true}, expires, &observation)
            observe_status if observe_status != Code.Ok else verify_observed(release, parsed, observation, state_path)

        # A verified release must already be the recorded release.
        def verify_observed(release: Release&, parsed: Model::Version, observation: Observation&, state_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            previous: mutable History = empty_history()
            find_status: Code = trust_state_find_package_history(observation.state, observation.root_after_clock, release.package, &previous.version, &previous.digest, &previous.metadata_digest)
            find_status if find_status != Code.Ok else Code.TrustStateUnavailable if previous.version.count == 0.usize() else verified_against_history(release, parsed, previous, observation, state_path)

        def verified_against_history(release: Release&, parsed: Model::Version, previous: History&, observation: Observation&, state_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            previous_parsed: mutable Model::Version = zero_version()
            Code.TrustStateMalformed if not SemVer::parse(previous.version, &previous_parsed) else verified_ordering(release, SemVer::compare(parsed, previous_parsed), previous, observation, state_path)

        def verified_ordering(release: Release&, ordering: i64, previous: History&, observation: Observation&, state_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            Code.RollbackDetected if ordering < 0 else Code.DigestMismatch if ordering == 0 and not same_digests(previous, release) else Code.TrustStateUnavailable if ordering > 0 else Code.Ok if observation.now <= observation.observed_clock else Code.TrustStateUnavailable if not TrustStorage::write_clock(clock_path_for(state_path), observation.now, observation.current_state_digest) else Code.Ok

        def record_locked(release: Release&, parsed: Model::Version, expires: u64, guard: IndexGuard&, key_fingerprint: darray[u8]&, lock_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            Code.TrustStateUnavailable if not configured_root_readable() else record_with_root(release, parsed, expires, guard, key_fingerprint, lock_path)

        def configured_root_readable() -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root_after_lock: mutable darray[u8] = []
            RegistryConfiguration::configured_root(&root_after_lock)

        def record_with_root(release: Release&, parsed: Model::Version, expires: u64, guard: IndexGuard&, key_fingerprint: darray[u8]&, lock_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root_after_fingerprint: mutable darray[u8] = []
            return Code.TrustStateUnavailable if not RegistryConfiguration::configured_root(&root_after_fingerprint)
            index_status: Code = current_index_status(root_after_fingerprint, release, guard)
            index_status if index_status != Code.Ok else record_for_identity(release, parsed, expires, guard, key_fingerprint, lock_path, root_after_fingerprint)

        # A guarded release must still belong to the index that selected it.
        def current_index_status(root: darray[u8]&, release: Release&, guard: IndexGuard&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return Code.Ok if not guard.enabled
            current_index_identity: mutable darray[u8] = []
            Code.TrustStateUnavailable if not TrustIdentity::index(root, release.package, &current_index_identity) else Code.InvalidConfiguration if not ByteText::equal(current_index_identity, guard.identity) else Code.Ok

        def record_for_identity(release: Release&, parsed: Model::Version, expires: u64, guard: IndexGuard&, key_fingerprint: darray[u8]&, lock_path: darray[u8]&, root: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            state_identity: mutable darray[u8] = []
            root_key_identity: mutable darray[u8] = []
            Code.TrustStateUnavailable if not state_identity_for(root, release.package, &state_identity) or not TrustIdentity::root_key_from_history(state_identity, &root_key_identity) else record_at_state(release, parsed, expires, guard, key_fingerprint, lock_path, state_identity, root_key_identity, TrustPaths::prepare(root))

        # Package names are scoped to the registry; index identities are
        # already scoped.
        def state_identity_for(root: darray[u8]&, package: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            TrustIdentity::package(root, package, out) if PackageIdentity::valid_name(package) else appended_bytes(out, package)

        def record_at_state(release: Release&, parsed: Model::Version, expires: u64, guard: IndexGuard&, key_fingerprint: darray[u8]&, lock_path: darray[u8]&, state_identity: darray[u8]&, root_key_identity: darray[u8]&, state_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return Code.TrustStateUnavailable if not ByteText::equal(lock_path_for(state_path), lock_path)
            observation: mutable Observation = empty_observation()
            observe_status: Code = observe(state_path, root_key_identity, key_fingerprint, PinPolicy{require_existing: guard.enabled, compare_key: not guard.enabled, recheck_root_key_after_clock: false}, expires, &observation)
            observe_status if observe_status != Code.Ok else record_observed(release, parsed, guard, key_fingerprint, state_identity, root_key_identity, observation, state_path)

        def record_observed(release: Release&, parsed: Model::Version, guard: IndexGuard&, key_fingerprint: darray[u8]&, state_identity: darray[u8]&, root_key_identity: darray[u8]&, observation: Observation&, state_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            index_status: Code = check_index_floor(observation.state, guard) if guard.enabled else Code.Ok
            index_status if index_status != Code.Ok else record_against_history(release, parsed, key_fingerprint, state_identity, root_key_identity, observation, state_path)

        def record_against_history(release: Release&, parsed: Model::Version, key_fingerprint: darray[u8]&, state_identity: darray[u8]&, root_key_identity: darray[u8]&, observation: Observation&, state_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if check_release_history(observation, release, parsed, state_path) is decided:
                return decided
            append_and_write(observation, release, state_identity, root_key_identity, key_fingerprint, state_path)

        def empty_observation() -> Observation:
            Observation{state: [], key_pin_found: false, observed_clock: 0, clock_missing: false, current_state_digest: [], now: 0, root_after_clock: []}

        def empty_history() -> History:
            History{version: [], digest: [], metadata_digest: []}

        def zero_version() -> Model::Version:
            Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}

        def same_digests(previous: History&, release: Release&) -> bool:
            ByteText::equal(previous.digest, release.digest) and ByteText::equal(previous.metadata_digest, release.metadata_digest)

        # ---------- observation ---------------------------------------------------------------

        # Read the state, its root-key pin, and its clock sidecar, and require
        # that they agree with each other, the wall clock, and the metadata expiry.
        def observe(state_path: darray[u8]&, root_key_identity: darray[u8]&, key_fingerprint: darray[u8]&, policy: PinPolicy, expires: u64, out: mutable Observation&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            state_status: Code = observe_state(state_path, root_key_identity, key_fingerprint, policy, out)
            state_status if state_status != Code.Ok else observe_clock(state_path, root_key_identity, policy, expires, out)

        def observe_state(state_path: darray[u8]&, root_key_identity: darray[u8]&, key_fingerprint: darray[u8]&, policy: PinPolicy, out: mutable Observation&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            read_status: Code = trust_state_read(state_path, &out.state)
            read_status if read_status != Code.Ok else state_pin_status(root_key_identity, key_fingerprint, policy, out)

        def state_pin_status(root_key_identity: darray[u8]&, key_fingerprint: darray[u8]&, policy: PinPolicy, out: mutable Observation&) -> Code can[Memory.Allocate, Abort.Panic]:
            key_pin_status: Code = trust_state_check_root_pin(out.state, root_key_identity, key_fingerprint, policy.require_existing, policy.compare_key, &out.key_pin_found)
            key_pin_status if key_pin_status != Code.Ok else rollback_result(RollbackRecords::legacy_override_status(out.state, trust_state_has_override()))

        def observe_clock(state_path: darray[u8]&, root_key_identity: darray[u8]&, policy: PinPolicy, expires: u64, out: mutable Observation&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            observed_state_digest: mutable darray[u8] = []
            clock_status: Code = read_rollback_clock(clock_path_for(state_path), &out.observed_clock, &observed_state_digest, &out.clock_missing)
            clock_status if clock_status != Code.Ok else observe_after_clock(root_key_identity, policy, expires, observed_state_digest, out)

        def observe_after_clock(root_key_identity: darray[u8]&, policy: PinPolicy, expires: u64, observed_state_digest: darray[u8]&, out: mutable Observation&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return Code.TrustStateUnavailable if not RegistryConfiguration::configured_root(&out.root_after_clock) or (policy.recheck_root_key_after_clock and not root_key_unchanged(out.root_after_clock, root_key_identity))
            return Code.TrustStateUnavailable if out.clock_missing and out.state.count > 23.usize()
            return Code.TrustStateUnavailable if:
                not Integrity::sha256_hex(out.state, &out.current_state_digest)
                not out.clock_missing and not ByteText::equal(observed_state_digest, out.current_state_digest)
            observed_now(expires, Platform::wall_clock_seconds(), out)

        def root_key_unchanged(root: darray[u8]&, root_key_identity: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            clock_root_key_identity: mutable darray[u8] = []
            TrustIdentity::root_key(root, &clock_root_key_identity) and ByteText::equal(clock_root_key_identity, root_key_identity)

        def observed_now(expires: u64, now: i64, out: mutable Observation&) -> Code:
            return Code.TrustStateUnavailable if now < 0
            out.now <- now.u64()
            Code.ClockRollback if out.observed_clock > out.now else metadata_expiry_status(expires, out.now)

        # ---------- index floor and release history -------------------------------------------

        # The stored index floor must equal the generation and digest the
        # caller resolved; a newer stored floor means the index rolled back.
        def check_index_floor(state: darray[u8]&, guard: IndexGuard&) -> Code can[Memory.Allocate, Abort.Panic]:
            observed: mutable History = empty_history()
            find_status: Code = trust_state_find(state, guard.identity, &observed.version, &observed.digest, &observed.metadata_digest) if state.count > 0 else Code.Ok
            find_status if find_status != Code.Ok else Code.TrustStateUnavailable if observed.version.count == 0 else index_floor_status(observed, guard)

        def index_floor_status(observed: History&, guard: IndexGuard&) -> Code can[Memory.Allocate, Abort.Panic]:
            expected_parsed: mutable Model::Version = zero_version()
            observed_parsed: mutable Model::Version = zero_version()
            Code.TrustStateMalformed if not SemVer::parse(index_floor_version(guard.generation), &expected_parsed) or not SemVer::parse(observed.version, &observed_parsed) else index_ordering_status(SemVer::compare(observed_parsed, expected_parsed), observed, guard)

        # Index generations are recorded as "0.0.GENERATION".
        def index_floor_version(generation: u64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            version: mutable darray[u8] = []
            ByteText::append_text(&version, "0.0.")
            ByteText::append_decimal(&version, generation)
            version

        def index_ordering_status(ordering: i64, observed: History&, guard: IndexGuard&) -> Code:
            Code.RollbackDetected if ordering > 0 else Code.TrustStateUnavailable if ordering < 0 else Code.DigestMismatch if not ByteText::equal(observed.digest, guard.digest) or not ByteText::equal(observed.metadata_digest, guard.digest) else Code.Ok

        # Compare the release with its recorded history. Returns null when a
        # new record must be appended, or the final code otherwise.
        def check_release_history(observation: Observation&, release: Release&, parsed: Model::Version, state_path: darray[u8]&) -> Code? can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            previous: mutable History = empty_history()
            find_status: Code = recorded_history_status(observation, release, &previous)
            find_status if find_status != Code.Ok else decided_by_history(observation, release, parsed, previous, state_path)

        def recorded_history_status(observation: Observation&, release: Release&, previous: mutable History&) -> Code can[Memory.Allocate, Abort.Panic]:
            Code.Ok if observation.state.count == 0 else trust_state_find_package_history(observation.state, observation.root_after_clock, release.package, &previous.version, &previous.digest, &previous.metadata_digest) if PackageIdentity::valid_name(release.package) else trust_state_find(observation.state, release.package, &previous.version, &previous.digest, &previous.metadata_digest)

        def decided_by_history(observation: Observation&, release: Release&, parsed: Model::Version, previous: History&, state_path: darray[u8]&) -> Code? can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return null if previous.version.count == 0.usize()
            previous_parsed: mutable Model::Version = zero_version()
            Code.TrustStateMalformed if not SemVer::parse(previous.version, &previous_parsed) else decided_by_ordering(observation, release, SemVer::compare(parsed, previous_parsed), previous, state_path)

        # The same release already recorded under a pinned key only advances
        # the clock; a newer release, or one without a pin, is appended.
        def decided_by_ordering(observation: Observation&, release: Release&, ordering: i64, previous: History&, state_path: darray[u8]&) -> Code? can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            Code.RollbackDetected if ordering < 0 else Code.DigestMismatch if ordering == 0 and not same_digests(previous, release) else null if ordering != 0 or not observation.key_pin_found else Code.Ok if observation.observed_clock == observation.now else Code.TrustStateUnavailable if not TrustStorage::write_clock(clock_path_for(state_path), observation.now, observation.current_state_digest) else Code.Ok

        # ---------- appending -----------------------------------------------------------------

        # Append the root-key pin (when missing) and the release record, then
        # publish the clock sidecar and the state.
        def append_and_write(observation: Observation&, release: Release&, state_identity: darray[u8]&, root_key_identity: darray[u8]&, key_fingerprint: darray[u8]&, state_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            state: mutable darray[u8] = []
            upgrade_status: Code = rollback_result(RollbackRecords::upgrade_to_v4(observation.root_after_clock, observation.state, trust_state_has_override(), &state))
            upgrade_status if upgrade_status != Code.Ok else Code.TrustStateUnavailable if not appended_root_pin(observation, root_key_identity, key_fingerprint, &state) or not appended_release_record(state_identity, release, &state) else published_state(observation, state, state_path)

        def appended_root_pin(observation: Observation&, root_key_identity: darray[u8]&, key_fingerprint: darray[u8]&, state: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if observation.key_pin_found
            return false if not TrustIdentity::valid_root_key(root_key_identity) or not fits_in_state(state, root_key_identity.count + 9.usize() + key_fingerprint.count * 2.usize())
            ByteText::append(state, root_key_identity)
            ByteText::append_text(state, " 0.0.0 ")
            ByteText::append(state, key_fingerprint)
            state.push(32)
            ByteText::append(state, key_fingerprint)
            state.push(10)
            true

        def appended_release_record(state_identity: darray[u8]&, release: Release&, state: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not fits_in_state(state, state_identity.count + release.version.count + release.digest.count + release.metadata_digest.count + 4.usize())
            ByteText::append(state, state_identity)
            state.push(32)
            ByteText::append(state, release.version)
            state.push(32)
            ByteText::append(state, release.digest)
            state.push(32)
            ByteText::append(state, release.metadata_digest)
            state.push(10)
            true

        # A record of `record_size` bytes keeps the state within 1 MiB.
        def fits_in_state(state: darray[u8]&, record_size: usize) -> bool:
            record_size <= 1048576.usize() and state.count <= 1048576.usize() - record_size

        # Bind the proposed state bytes into the sidecar before publishing
        # the state. A crash between these atomic writes leaves a mismatch,
        # which fails closed instead of accepting either history.
        def published_state(observation: Observation&, state: darray[u8]&, state_path: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            updated_state_digest: mutable darray[u8] = []
            Code.TrustStateUnavailable if not Integrity::sha256_hex(state, &updated_state_digest) or not TrustStorage::write_clock(clock_path_for(state_path), observation.now, updated_state_digest) or not TrustStorage::write(state_path, state) else Code.Ok

        # ---------- state files ---------------------------------------------------------------

        # Only the descriptor-relative ENOENT result is an empty history.
        # Insecure parents, symlinks, and unreadable files must never reset
        # rollback protection.
        def trust_state_read(path: darray[u8]&, out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            loaded: mutable darray[u8] = []
            read_status: i64 = RegistryFiles::read_trusted_file(path, 1048576.usize(), &loaded)
            Code.Ok if read_status == -2 else Code.TrustStateUnavailable if read_status < 0 else Code.TrustStateMalformed if not supported_state(loaded) else copied_state(loaded, out)

        # Version 2 is accepted only for safe migration. Versions 3 and 4
        # scope package identities to the registry root; v4 also records
        # each registry's configured signing-key fingerprint.
        def supported_state(loaded: darray[u8]&) -> bool:
            loaded.count > 0 and loaded.count <= 1048576 and (RollbackRecords::version_2(loaded) or RollbackRecords::version_3(loaded) or RollbackRecords::version_4(loaded))

        def copied_state(loaded: darray[u8]&, out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic]:
            ByteText::append(out, loaded)
            Code.Ok

        def appended_bytes(out: mutable darray[u8]&, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            ByteText::append(out, value)
            true

        def rollback_result(status: RollbackRecords::Code) -> Code:
            match status:
                RollbackRecords::Code.Ok: Code.Ok
                RollbackRecords::Code.Malformed: Code.TrustStateMalformed
                RollbackRecords::Code.Unavailable: Code.TrustStateUnavailable
                RollbackRecords::Code.RootChanged: Code.TrustRootChanged

        def trust_state_find(state: darray[u8]&, package: darray[u8]&, version_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, metadata_digest_out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic]:
            rollback_result(RollbackRecords::find(state, package, version_out, digest_out, metadata_digest_out))

        def trust_state_check_root_pin(state: darray[u8]&, root_key_identity: darray[u8]&, key_fingerprint: darray[u8]&, require_existing: bool, compare_key: bool, found_out: mutable bool&) -> Code can[Memory.Allocate, Abort.Panic]:
            rollback_result(RollbackRecords::check_root_pin(state, root_key_identity, key_fingerprint, require_existing, compare_key, found_out))

        # Package release history is scoped to the configured registry even
        # when callers deliberately share one trust-state file. The default
        # HOME-derived file was already registry-scoped; its older plain-name
        # records can be read as migration history. An override may have mixed
        # roots in one legacy record, so using that ambiguous history would
        # either contaminate another registry or silently drop rollback
        # protection. Fail closed for that one package until it is explicitly
        # re-provisioned into a fresh scoped record.
        def trust_state_find_package_history(state: darray[u8]&, root: darray[u8]&, package: darray[u8]&, version_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, metadata_digest_out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic]:
            version_out.resize(0)
            digest_out.resize(0)
            metadata_digest_out.resize(0)
            scoped_status: Code = scoped_package_history(state, root, package, version_out, digest_out, metadata_digest_out)
            scoped_status if scoped_status != Code.Ok or version_out.count > 0 else legacy_package_history(state, package, version_out, digest_out, metadata_digest_out)

        def scoped_package_history(state: darray[u8]&, root: darray[u8]&, package: darray[u8]&, version_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, metadata_digest_out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic]:
            scoped_identity: mutable darray[u8] = []
            Code.TrustStateUnavailable if not TrustIdentity::package(root, package, &scoped_identity) else trust_state_find(state, scoped_identity, version_out, digest_out, metadata_digest_out) if state.count > 0 else Code.Ok

        # V3 rows are exclusively scoped identities, so a missing scoped row
        # is a genuinely new package for this registry. Only v2 can carry a
        # legacy plain-name row that is eligible for safe default path
        # migration.
        def legacy_package_history(state: darray[u8]&, package: darray[u8]&, version_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, metadata_digest_out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic]:
            return Code.Ok if not RollbackRecords::version_2(state)
            legacy: mutable History = empty_history()
            legacy_status: Code = trust_state_find(state, package, &legacy.version, &legacy.digest, &legacy.metadata_digest) if state.count > 0 else Code.Ok
            legacy_status if legacy_status != Code.Ok or legacy.version.count == 0 else Code.TrustStateUnavailable if trust_state_has_override() else copied_history(legacy, version_out, digest_out, metadata_digest_out)

        def copied_history(history: History&, version_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, metadata_digest_out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic]:
            ByteText::append(version_out, history.version)
            ByteText::append(digest_out, history.digest)
            ByteText::append(metadata_digest_out, history.metadata_digest)
            Code.Ok

        def trust_state_finish(lock_file_descriptor: i64, code: Code) -> Code:
            Code.TrustStateUnavailable if Platform::close_file_descriptor(lock_file_descriptor) != 0 else code

        # Persist TUF role floors separately from the fixture provider's
        # SemVer history. The state file is scoped by registry identity inside
        # each row so an explicit shared trust-state override cannot mix roots.
        def trust_state_has_override() -> bool:
            region override_scope:
                override: u8&? = Platform::environment_variable("ELISAPKG_TRUST_STATE")
                return true if override is configured
            false

        def read_rollback_clock(path: darray[u8]&, out: mutable u64&, state_digest: mutable darray[u8]&, missing: mutable bool&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            match TrustStorage::read_clock(path, out, state_digest, missing):
                TrustStorage::Code.Ok: Code.Ok
                TrustStorage::Code.Unavailable: Code.TrustStateUnavailable
                TrustStorage::Code.Malformed: Code.TrustStateMalformed

        def read_key_fingerprint(root: darray[u8]&, out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            match RegistryConfiguration::configured_trust_key_fingerprint(root, out):
                RegistryConfiguration::Code.InvalidConfiguration: Code.InvalidConfiguration
                RegistryConfiguration::Code.MissingTrustRoot: Code.MissingTrustRoot
                RegistryConfiguration::Code.Ok: Code.Ok
                RegistryConfiguration::Code.TrustStateUnavailable: Code.TrustStateUnavailable
