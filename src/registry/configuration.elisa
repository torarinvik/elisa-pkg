# Registry configuration and the separately configured verification key.
include "../integrity.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../trust.elisa"
include "./files.elisa"
include "./root.elisa"

module RegistryConfiguration:
    public:
        const enum Code of u8:
            InvalidConfiguration
            MissingTrustRoot
            Ok
            TrustStateUnavailable

        def configured_root(out: mutable darray[u8]&) -> bool:
            out.resize(0)
            if Platform::environment_variable("ELISAPKG_REGISTRY_DIR") is configured:
                value: cstr = configured.cast[cstr]
                length: usize = Platform::c_string_length(value)
                if length == 0 or length > RegistryRoot::maximum_bytes:
                    false
                else:
                    for index in 0..<length |out, value|:
                        out.push(value[index].u8())
                    true
            else:
                false

        def configured_trust_root(registry_root: darray[u8]&, out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # Trust material is configured out of band. Keeping the key next
            # to mutable registry metadata would let a registry replacement
            # replace its own verification root as well.
            out.resize(0)
            if Platform::environment_variable("ELISAPKG_REGISTRY_TRUST_ROOT") is configured:
                value: cstr = configured.cast[cstr]
                length: usize = Platform::c_string_length(value)
                printable: bool = for index in 0..<length |valid: bool = true| -> valid:
                    byte: u8 = value[index].u8()
                    break false if byte == 0 or byte < 32 or byte == 127 or byte == 92
                canonical_registry: mutable darray[u8] = []
                canonical_trust: mutable darray[u8] = []
                if length == 0 or length > RegistryRoot::maximum_bytes or value[0].u8() != 47 or not printable:
                    Code.InvalidConfiguration
                else:
                    for index in 0..<length |out, value|:
                        out.push(value[index].u8())
                    if not RegistryRoot::valid(out) or ProjectFiles::path_is_same_or_beneath(out, registry_root) or not ProjectFiles::canonical_existing_path(registry_root, &canonical_registry):
                        Code.InvalidConfiguration
                    elif not ProjectFiles::canonical_existing_path(out, &canonical_trust):
                        Code.MissingTrustRoot
                    elif ProjectFiles::path_is_same_or_beneath(canonical_trust, canonical_registry):
                        Code.InvalidConfiguration
                    else:
                        Code.Ok
            else:
                Code.MissingTrustRoot

        def configured_trust_key_fingerprint(registry_root: darray[u8]&, out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            key_path: mutable darray[u8] = []
            public_key: mutable darray[u8] = []
            root_status: Code = configured_trust_root(registry_root, &key_path)
            if root_status != Code.Ok:
                root_status
            elif RegistryFiles::read_trusted_file(key_path, Trust::ed25519_public_key_bytes, &public_key) != Trust::ed25519_public_key_bytes.i64():
                Code.MissingTrustRoot
            elif not Integrity::sha256_hex(public_key, out):
                Code.TrustStateUnavailable
            else:
                Code.Ok
