# Clock floor and state digest recorded alongside registry trust state.
include "../integrity.elisa"
include "../text/bytes.elisa"

module TrustClockRecord:
    public:
        def decode(encoded: darray[u8]&, out: mutable u64&, state_digest: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out <- 0
            state_digest.resize(0)
            return false if encoded.count < minimum_record_bytes or encoded.count > maximum_record_bytes
            value: mutable u64 = 0
            # Where the digest starts after the `clock:` line, or a negative offset.
            digest_start: i64 =
                clock_start: i64 = ByteText::match_text_end(encoded, 0.usize(), clock_prefix)
                cursor: mutable usize = 0.usize()
                if clock_start < 0 or not ByteText::scan_unsigned_decimal(encoded, clock_start.usize(), encoded.count, &cursor, &value) or cursor >= encoded.count or encoded[cursor] != 10:
                    return false
                else:
                    ByteText::match_text_end(encoded, cursor + 1.usize(), digest_prefix)
            # The digest is the final line, ending at the last newline.
            if digest_start < 0 or encoded[encoded.count - 1.usize()] != 10 or not Integrity::valid_sha256_hex_range(encoded, digest_start.usize(), encoded.count - 1.usize()):
                false
            else:
                ByteText::append_range(state_digest, encoded, digest_start.usize(), encoded.count - 1.usize())
                out <- value
                true

        def encode(value: u64, state_digest: darray[u8]&, encoded: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            encoded.resize(0)
            return false if not Integrity::valid_sha256_hex(state_digest)
            ByteText::append_text(encoded, clock_prefix)
            ByteText::append_decimal(encoded, value)
            encoded.push(10)
            ByteText::append_text(encoded, digest_prefix)
            ByteText::append(encoded, state_digest)
            encoded.push(10)
            true

    private:
        # Two prefixes, two line feeds, a SHA-256 hex digest, and 1–20 digits.
        const minimum_record_bytes: usize = 86.usize()
        const maximum_record_bytes: usize = minimum_record_bytes + 19.usize()
        const clock_prefix: cstr = "clock:"
        const digest_prefix: cstr = "state-sha256:"
