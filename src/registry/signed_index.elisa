# Verify signed index snapshots and persist their rollback floors before use.
include "../integrity.elisa"
include "../package/package_identity.elisa"
include "../platform.elisa"
include "../text/bytes.elisa"
include "../trust.elisa"
include "./files.elisa"
include "./index_snapshot.elisa"
include "./rollback_store.elisa"
include "./trust_identity.elisa"

module SignedRegistryIndex:
    public:
        const enum Code of u8:
            InvalidConfiguration
            MissingIndex
            ResourceLimit
            MalformedMetadata
            MissingSignature
            MissingTrustRoot
            TrustStateUnavailable
            Ok
            InvalidSignature
            ClockUnavailable
            TrustStateMalformed
            TrustRootChanged
            NotConfigured
            ClockRollback
            RollbackDetected
            DigestMismatch
            ExpiredMetadata
            ExpiryHorizon

        def read(root: darray[u8]&, package: darray[u8]&, key_path: darray[u8]&, out: mutable darray[u8]&, yanked_flags_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, key_fingerprint_out: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            out.resize(0)
            yanked_flags_out.resize(0)
            generation_out <- 0
            snapshot_digest_out.resize(0)
            identity_out.resize(0)
            key_fingerprint_out.resize(0)
            return Code.InvalidConfiguration if not PackageIdentity::valid_name(package)
            snapshot: darray[u8] =
                contents: mutable darray[u8] = []
                loaded: i64 =
                    index_path: mutable darray[u8] = []
                    return Code.InvalidConfiguration if not RegistryFiles::join_path_leaf(root, package, "index", &index_path)
                    RegistryFiles::read_trusted_file(index_path, 1048576.usize(), &contents)
                if loaded == -2:
                    return Code.MissingIndex
                elif loaded == -27:
                    return Code.ResourceLimit
                elif loaded < 0:
                    return Code.InvalidConfiguration
                elif loaded == 0 or contents.count > 1048576:
                    return Code.MalformedMetadata
                else:
                    contents

            key_fingerprint_hex: mutable darray[u8] = []
            region signature_status_scope:
                signature_status: Code = verify_snapshot_signature(root, package, key_path, snapshot, &key_fingerprint_hex)
                return signature_status if signature_status != Code.Ok

            versions: mutable darray[u8] = []
            yanked_flags: mutable darray[u8] = []
            generation: mutable u64 = 0
            expires: mutable u64 = 0
            region snapshot_fields_scope:
                snapshot_root: mutable darray[u8] = []
                snapshot_package: mutable darray[u8] = []
                return Code.MalformedMetadata if not RegistryIndexSnapshot::parse(snapshot, &snapshot_root, &snapshot_package, &generation, &expires, &versions, &yanked_flags)
                return Code.InvalidSignature if not ByteText::equal(snapshot_root, root) or not ByteText::equal(snapshot_package, package)
            region expiry_status_scope:
                expiry_status: Code =
                    now: i64 = Platform::wall_clock_seconds()
                    return Code.ClockUnavailable if now < 0
                    rollback_result(RollbackStore::metadata_expiry_status(expires, now.u64()))
                return expiry_status if expiry_status != Code.Ok

            snapshot_digest: mutable darray[u8] = []
            index_identity: mutable darray[u8] = []
            if not Integrity::sha256_hex(snapshot, &snapshot_digest) or not TrustIdentity::index(root, package, &index_identity):
                Code.TrustStateUnavailable
            else:
                # The rollback floor is durable before any output is published.
                state_status: Code = record_index_generation(index_identity, generation, snapshot_digest, expires, key_fingerprint_hex)
                if state_status == Code.Ok:
                    ByteText::append(out, versions)
                    ByteText::append(yanked_flags_out, yanked_flags)
                    generation_out <- generation
                    ByteText::append(snapshot_digest_out, snapshot_digest)
                    ByteText::append(identity_out, index_identity)
                    ByteText::append(key_fingerprint_out, key_fingerprint_hex)
                state_status

        # Check the detached Ed25519 signature of an index snapshot against
        # the configured key, and report that key's fingerprint.
        def verify_snapshot_signature(root: darray[u8]&, package: darray[u8]&, key_path: darray[u8]&, snapshot: darray[u8]&, key_fingerprint_hex: mutable darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            signature: darray[u8] =
                signature_bytes: mutable darray[u8] = []
                signature_size: i64 =
                    signature_path: mutable darray[u8] = []
                    return Code.InvalidConfiguration if not RegistryFiles::join_path_leaf(root, package, "index.sig", &signature_path)
                    RegistryFiles::read_trusted_file(signature_path, Trust::ed25519_signature_bytes, &signature_bytes)
                if signature_size < 0 or signature_size != Trust::ed25519_signature_bytes.i64():
                    return Code.MissingSignature
                else:
                    signature_bytes
            public_key: mutable darray[u8] = []
            if RegistryFiles::read_trusted_file(key_path, Trust::ed25519_public_key_bytes, &public_key) != Trust::ed25519_public_key_bytes.i64():
                Code.MissingTrustRoot
            elif not Integrity::sha256_hex(public_key, key_fingerprint_hex):
                Code.TrustStateUnavailable
            elif Trust::verify_detached("ed25519", public_key, snapshot, signature) != Trust::VerificationCode.Valid:
                Code.InvalidSignature
            else:
                Code.Ok

        def contains_version(versions: darray[u8]&, version: darray[u8]&) -> bool:
            while cursor < versions.count |cursor: usize = 0.usize(), finish: usize = 0.usize()|:
                finish <- while position < versions.count and versions[position] != 10 |position: usize = cursor| -> position:
                    position <- position + 1.usize()
                return false if finish == versions.count
                return true if ByteText::range_equals(versions, cursor, finish, version)
                cursor <- finish + 1.usize()
            false

        def filter_yanked_versions(index: darray[u8]&, yanked_flags: darray[u8]&, eligible_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            eligible_out.resize(0)
            ordinal: mutable usize = 0.usize()
            while cursor < index.count |cursor: usize = 0.usize()|:
                finish: mutable usize = cursor
                while finish < index.count and index[finish] != 10 |index, finish|:
                    finish <- finish + 1.usize()
                return false if finish == index.count or finish == cursor or ordinal >= yanked_flags.count or yanked_flags[ordinal] > 1
                if yanked_flags[ordinal] == 0:
                    for item in cursor..<(finish + 1.usize()) |eligible_out, index|:
                        eligible_out.push(index[item])
                ordinal <- ordinal + 1.usize()
                cursor <- finish + 1.usize()
            ordinal == yanked_flags.count

    private:
        def record_index_generation(identity: darray[u8]&, generation: u64, snapshot_digest: darray[u8]&, expires: u64, key_fingerprint: darray[u8]&) -> Code can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            generation_version: mutable darray[u8] = []
            ByteText::append_text(&generation_version, "0.0.")
            ByteText::append_decimal(&generation_version, generation)
            rollback_result(RollbackStore::record_index(identity, generation_version, snapshot_digest, snapshot_digest, expires, key_fingerprint))

        def rollback_result(status: RollbackStore::Code) -> Code:
            match status:
                RollbackStore::Code.Ok: Code.Ok
                RollbackStore::Code.TrustStateUnavailable: Code.TrustStateUnavailable
                RollbackStore::Code.TrustStateMalformed: Code.TrustStateMalformed
                RollbackStore::Code.TrustRootChanged: Code.TrustRootChanged
                RollbackStore::Code.InvalidConfiguration: Code.InvalidConfiguration
                RollbackStore::Code.NotConfigured: Code.NotConfigured
                RollbackStore::Code.ClockRollback: Code.ClockRollback
                RollbackStore::Code.RollbackDetected: Code.RollbackDetected
                RollbackStore::Code.DigestMismatch: Code.DigestMismatch
                RollbackStore::Code.ExpiredMetadata: Code.ExpiredMetadata
                RollbackStore::Code.ExpiryHorizon: Code.ExpiryHorizon
                RollbackStore::Code.MissingTrustRoot: Code.MissingTrustRoot
