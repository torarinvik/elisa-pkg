                        ProjectFiles::path_with_nul_into(developer_linker_path, &developer_linker_path_c)
                        developer_linker_name <- (&developer_linker_path_c[0]).cast[cstr] can Unsafe.PointerCast
                        ProjectFiles::path_with_nul_into(developer_assembler_path, &developer_assembler_path_c)
                        developer_assembler_name <- (&developer_assembler_path_c[0]).cast[cstr] can Unsafe.PointerCast
                        executable_paths.push(developer_linker_name)
                        executable_paths.push(developer_assembler_name)
