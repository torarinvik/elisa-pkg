                    ByteText::append_text(&sandbox_home_env, "HOME=")
                    ByteText::append_bounded_text(&sandbox_home_env, canonical_sandbox_work_name)
                    sandbox_home_env.push(0)
                    args.push((&sandbox_home_env[0]).cast[cstr] can Unsafe.PointerCast)
                    fixed_home_env: mutable darray[u8] = []
                    ByteText::append_text(&fixed_home_env, "CFFIXED_USER_HOME=")
                    ByteText::append_bounded_text(&fixed_home_env, canonical_sandbox_work_name)
