                            return EXIT_BUILD
                    toolchain_unchanged: mutable bool = true
                    post_tool_identity: mutable darray[u8] = []
                    if compiler_identity_ok:
                        toolchain_unchanged <- tool_file_identity(compiler, true, true, &post_tool_identity) and ByteText::equal(post_tool_identity, compiler_identity)
                    if toolchain_unchanged and stage1_identity_ok:
                        toolchain_unchanged <- tool_file_identity(stage1_bin, false, true, &post_tool_identity) and ByteText::equal(post_tool_identity, stage1_identity)
                    if toolchain_unchanged and runtime_identity_ok:
                        toolchain_unchanged <- tool_file_identity(runtime_obj, false, false, &post_tool_identity) and ByteText::equal(post_tool_identity, runtime_identity)
                    if toolchain_unchanged and clang_identity_ok:
