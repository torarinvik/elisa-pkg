                    # exact manifest and lock too: local lock validation recomputes every
                    # transitive dependency source digest, including paths outside the root.
                    manifest_after_build: mutable darray[u8] = []
                    manifest_after_build.resize(1048577)
                    lock_after_build: mutable darray[u8] = []
                    lock_after_build.resize(1048577)
                    if not ProjectFiles::read_cstr_into("elisapkg.json", &manifest_after_build) or not ProjectFiles::read_cstr_into("elisapkg.lock", &lock_after_build):
                        _ = Platform::pkg_unlink(temp_name)
                        _ = BuildSnapshots::remove_all(source_snapshot_container_name, source_snapshot_roots)
                        _ = BuildSnapshots::remove_aggregate(aggregate_source_name)
                        _ = Platform::pkg_rmdir(sandbox_work_name)
