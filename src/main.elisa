                        source_snapshot_container_storage.push(snapshot_template[index])
                    source_snapshot_container_storage.push(0)
                    source_snapshot_container_name <- (&source_snapshot_container_storage[0]).cast[cstr] can Unsafe.PointerCast
                    snapshot_container_path: mutable darray[u8] = []
                    for index in 0..<snapshot_container_length |snapshot_container_path, source_snapshot_container_storage|:
                        snapshot_container_path.push(source_snapshot_container_storage[index])
                    if not ProjectFiles::canonical_existing_path(snapshot_container_path, &source_snapshot_root):
