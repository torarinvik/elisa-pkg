                    if toolchain_unchanged and developer_linker_identity_ok:
                        toolchain_unchanged <- tool_file_identity(developer_linker_name, sdk_root.count == 0.usize(), true, &post_tool_identity) and ByteText::equal(post_tool_identity, developer_linker_identity)
                    if toolchain_unchanged and developer_assembler_identity_ok:
                        toolchain_unchanged <- tool_file_identity(developer_assembler_name, sdk_root.count == 0.usize(), true, &post_tool_identity) and ByteText::equal(post_tool_identity, developer_assembler_identity)
