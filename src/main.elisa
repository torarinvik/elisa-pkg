                        _ = Platform::pkg_close(compiler_stdout_fd)
                        _ = Platform::pkg_unlink(compiler_stdout_name)
                        _ = Platform::pkg_unlink(temp_name)
                        _ = BuildSnapshots::remove_all(source_snapshot_container_name, source_snapshot_roots)
                        _ = BuildSnapshots::remove_aggregate(aggregate_source_name)
                        _ = Platform::pkg_rmdir(sandbox_work_name)
