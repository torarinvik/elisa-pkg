# Elisa Packaging System (`elisapkg`).
#
# The package manager keeps policy and algorithms in Elisa. Platform seams are
# small libc bindings with `pkg_` names so they cannot collide with the compiler
# runtime's declarations. Remote transport, archive extraction, and signing are
# separate capabilities and are refused until their trust configuration is
# present; no command silently falls back to an insecure mode.

include "./platform.elisa"
include "./install_faults.elisa"
include "./package/install_records.elisa"
include "./package/install_prefix.elisa"
include "./sandbox.elisa"
include "./package/model.elisa"
include "./trust.elisa"
include "./security.elisa"
include "./archive.elisa"
include "./package/manifest.elisa"
include "./package/manifest_edits.elisa"
include "./package/targets.elisa"
include "./package/selection.elisa"
include "./package/receipt.elisa"
include "./resolution/semver.elisa"
include "./package/package_identity.elisa"
include "./integrity.elisa"
include "./json.elisa"
include "./package_path_policy.elisa"
include "./build.elisa"
include "./toolchain.elisa"
include "./cache.elisa"
include "./resolution/resolve.elisa"
include "./resolution/solver.elisa"
include "./registry.elisa"
include "./text/bytes.elisa"
include "./cli/arguments.elisa"
include "./cli/output.elisa"
include "./source/fingerprint.elisa"
include "./source/snapshots.elisa"
include "./resolution/local_build_graph.elisa"
include "./project/transaction.elisa"
include "./project/lockfile.elisa"
include "./project/schema_fields.elisa"

module Cli:
    private:
        const EXIT_OK: i64 = 0
        const EXIT_USAGE: i64 = 2
        const EXIT_RESOLVE: i64 = 3
        const EXIT_SOURCE: i64 = 4
        const EXIT_SECURITY: i64 = 5
        const EXIT_BUILD: i64 = 6
        const EXIT_CANCEL: i64 = 130
        const BUILD_TIMEOUT_MS: i64 = 600000
        const PROGRAM_TIMEOUT_MS: i64 = 120000
        const MAX_DEPENDENCIES: usize = 4096
        const MAX_BUILD_GRAPH_EDGES: usize = 65536.usize()
        # Package version identities share the SemVer parser's bounded length.
        # Install metadata then adds only bounded paths, names, and fixed fields.
        const MAX_INSTALL_VERSION_BYTES: usize = SemVer::max_version_bytes

        # ---------- path and file primitives --------------------------------------------------

        def read_package_file_into(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return Platform::pkg_read_bounded_file(path, Integrity::max_input, out)

        # Build receipt identities bind both the selected path and executable
        # bytes. Resolve symlinks first so toolchain paths such as Homebrew's
        # `opt/llvm/bin/clang` identify the actual file that will be read.
        # An unavailable identity is never represented as a reusable value.
        def tool_file_identity(path: cstr, optional: bool, executable: bool, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            if path[0].u8() == 0:
                ByteText::append_text(out, "none" if optional else "unavailable")
                return optional
            resolved_path: mutable darray[u8] = []
            if not Toolchain::canonical_path_bytes(path, &resolved_path):
                ByteText::append_text(out, "unavailable")
                return false
            for index in 0..<resolved_path.count |resolved_path, out|:
                byte: u8 = resolved_path[index]
                if byte < 32 or byte == 127:
                    out.resize(0)
                    ByteText::append_text(out, "unavailable")
                    return false
            if executable:
                resolved_path_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&resolved_path, &resolved_path_c)
                resolved_path_name: cstr = (&resolved_path_c[0]).cast[cstr] can Unsafe.PointerCast
                if Platform::pkg_access(resolved_path_name, 1) != 0:
                    ByteText::append_text(out, "unavailable")
                    return false
            content: mutable darray[u8] = []
            if not read_package_file_into(&resolved_path, &content):
                ByteText::append_text(out, "unavailable")
                return false
            digest_bytes: mutable darray[u8] = []
            digest: mutable darray[u8] = []
            if Integrity::sha256(content, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest):
                ByteText::append_text(out, "unavailable")
                return false
            ByteText::append_text(out, "path:")
            ByteText::append(out, resolved_path)
            ByteText::append_text(out, ";sha256:")
            ByteText::append(out, digest)
            return true

        # Return zero when this call publishes the destination, -17 when an
        # existing destination wins the exclusive link, and another negative
        # value for an I/O or durability failure. Callers that tolerate a
        # concurrent writer must distinguish EEXIST from failed publication.
        def write_cstr_file_noclobber_status(path_name: cstr, value: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            # Link the fsynced temporary into place so an existing destination can
            # never be replaced by a rename race. The temporary is removed after the
            # link, leaving one durable directory entry for the caller to own.
            path_snapshot: mutable darray[u8] = []
            path_length: usize = Platform::pkg_strlen(path_name)
            return -22 if path_length == 0.usize() or path_length > 4084.usize()
            ByteText::append_text(&path_snapshot, path_name)
            template: mutable darray[u8] = []
            ByteText::append(&template, path_snapshot)
            ByteText::append_text(&template, ".tmp.XXXXXX")
            template.push(0)
            fd: i64 = Platform::pkg_mkstemp(&template)
            return -5 if fd < 0
            temp_snapshot: mutable darray[u8] = []
            ByteText::append(&temp_snapshot, template)
            if not ProjectFiles::write_fd_all(fd, value) or Platform::pkg_fsync(fd) != 0:
                _ = Platform::pkg_close(fd)
                return -5
            if Platform::pkg_close(fd) != 0:
                return -5
            temp_c: mutable darray[u8] = []
            ByteText::append(&temp_c, temp_snapshot)
            target_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&path_snapshot, &target_c)
            temp_name: mutable cstr = (&temp_c[0]).cast[cstr] can Unsafe.PointerCast
            target_name: mutable cstr = (&target_c[0]).cast[cstr] can Unsafe.PointerCast
            link_status: i64 = Platform::pkg_link(temp_name, target_name)
            if link_status != 0:
                # Keep the exclusive temporary for recovery. Unlinking this
                # pathname after the descriptor is closed could remove a
                # replacement installed by another actor.
                return link_status
            temp_c.resize(0)
            ByteText::append(&temp_c, temp_snapshot)
            temp_name <- (&temp_c[0]).cast[cstr] can Unsafe.PointerCast
            unlink_status: i64 = Platform::pkg_unlink(temp_name)
            if unlink_status != 0:
                # The destination link is already published. Do not remove it
                # by pathname after a cleanup failure: another actor may have
                # replaced that name while the temporary link was being
                # retired. Leave the evidence for a later recovery pass.
                return -5
            target_c.resize(0)
            ProjectFiles::path_with_nul_into(&path_snapshot, &target_c)
            target_name <- (&target_c[0]).cast[cstr] can Unsafe.PointerCast
            if Platform::pkg_fsync_parent(target_name) != 0:
                # The link is visible, but its directory durability is unknown.
                # Removing the destination by pathname could delete a concurrent
                # replacement, so report the durability failure and leave the
                # published evidence for recovery instead.
                return -5
            return 0

        def write_cstr_file_noclobber(path_name: cstr, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return write_cstr_file_noclobber_status(path_name, value) == 0

        def cache_store_verified_bytes(digest: darray[u8]&, content: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            # Cache publication is content-addressed and immutable. Verify the bytes
            # before creating any cache entry, then revalidate the final pathname after
            # the exclusive link so a concurrent writer or replacement cannot turn a
            # successful fetch into an unverified cache hit.
            digest_bytes: mutable darray[u8] = []
            actual: mutable darray[u8] = []
            return false if Integrity::sha256(content, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &actual) or not ByteText::equal(actual, digest)
            blob_path: mutable darray[u8] = []
            return false if not Cache::blob_path(digest, &blob_path)
            cache_parent: mutable darray[u8] = []
            return false if not Cache::shard_path(digest, &cache_parent)
            return false if not ProjectFiles::make_directory(&cache_parent)
            blob_name: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&blob_path, &blob_name)
            blob_c: cstr = (&blob_name[0]).cast[cstr] can Unsafe.PointerCast
            if ProjectFiles::cstr_file_exists(blob_c):
                return true if Cache::verify_blob(digest)
                quarantine_parent: mutable darray[u8] = []
                ByteText::append_text(&quarantine_parent, Cache::quarantine_directory)
                return false if not ProjectFiles::make_directory(&quarantine_parent)
                return false if not Cache::quarantine_blob(digest)
            publication_status: i64 = write_cstr_file_noclobber_status(blob_c, content)
            return Cache::verify_blob(digest) if publication_status == 0 or publication_status == -17
            return false

        def cache_store_verified_blob(digest: darray[u8]&, content: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return false if not Archive::verify_ustar_archive(content)
            return cache_store_verified_bytes(digest, content)

        def write_file(path: darray[u8]&, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: mutable cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            # Initialization files use the same durable atomic replacement primitive as
            # manifests and lockfiles. This keeps a crash from exposing a truncated
            # scaffold and avoids leaving a partially written file after an I/O error.
            return ProjectFiles::write_cstr_file(path_name, value)

        def write_file_noclobber(path: darray[u8]&, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            return write_cstr_file_noclobber(path_name, value)

        def file_exists(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            # Treat anything except definite ENOENT as occupied. In
            # particular, symlinks and special files must not be mistaken for
            # an available destination just because the regular-file opener
            # refuses to read them.
            return Platform::pkg_package_file_size(path_name) != -2

        def canonical_entry_within_root(root: darray[u8]&, entry: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root_path: mutable darray[u8] = []
            entry_path: mutable darray[u8] = []
            for index in 0..<root.count |root, root_path|:
                root_path.push(root[index])
            if root_path.count == 0.usize() or root_path[root_path.count - 1.usize()] != 47:
                root_path.push(47)
            for index in 0..<entry.count |entry, entry_path|:
                entry_path.push(entry[index])
            root_c: mutable darray[u8] = []
            entry_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&root_path, &root_c)
            ProjectFiles::path_with_nul_into(&entry_path, &entry_c)
            root_resolved: mutable darray[u8] = []
            entry_resolved: mutable darray[u8] = []
            root_resolved.resize(4096)
            entry_resolved.resize(4096)
            root_name: cstr = (&root_c[0]).cast[cstr] can Unsafe.PointerCast
            entry_name: cstr = (&entry_c[0]).cast[cstr] can Unsafe.PointerCast
            root_real: mutable cstr = ""
            entry_real: mutable cstr = ""
            if Platform::pkg_realpath(root_name, &root_resolved) is resolved_root:
                root_real <- resolved_root
            else:
                return false
            if Platform::pkg_realpath(entry_name, &entry_resolved) is resolved_entry:
                entry_real <- resolved_entry
            else:
                return false
            root_length: usize = Platform::pkg_strlen(root_real)
            entry_length: usize = Platform::pkg_strlen(entry_real)
            return false if entry_length <= root_length
            for index in 0..<root_length |root_real, entry_real|:
                return false if root_real[index].u8() != entry_real[index].u8()
            return entry_real[root_length].u8() == 47

        def remove_known_file(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_snapshot: mutable darray[u8] = []
            ByteText::append(&path_snapshot, path)
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&path_snapshot, &path_c)
            path_name: mutable cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            state: i64 = Platform::pkg_package_file_size(path_name)
            return true if state == -2
            return false if state < 0
            path_c.resize(0)
            ProjectFiles::path_with_nul_into(&path_snapshot, &path_c)
            path_name <- (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            return Platform::pkg_unlink(path_name) == 0

        # A local install transaction is recoverable state. Its unlink is not
        # complete until the containing prefix directory records that removal;
        # otherwise a power loss could resurrect an old intent after success.
        def retire_local_install_transaction(path: darray[u8]&) -> bool can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_snapshot: mutable darray[u8] = []
            ByteText::append(&path_snapshot, path)
            return false if not remove_known_file(&path_snapshot)
            InstallFaults::transaction_boundary("transaction.journal.unlinked")
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&path_snapshot, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            return Platform::pkg_fsync_parent(path_name) == 0

        def remove_build_directory_if_empty(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            result: i64 = Platform::pkg_rmdir(path_name)
            # Keep compiler metadata and any unrecognized build files. Clean
            # owns only the artifacts named by the manifest and their receipts.
            return true if result == 0 or result == -2 or result == -Platform::pkg_directory_not_empty_error()
            return false

        def remove_state_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            result: i64 = Platform::pkg_rmdir(path_name)
            # A retained cache makes the state directory intentionally non-empty.
            return true if result == 0 or result == -2 or result == -Platform::pkg_directory_not_empty_error()
            return false

        def safe_relative_entry(entry: darray[u8]&) -> bool:
            return Manifest::is_safe_relative_entry(entry)

        def target_file_is_valid(root: darray[u8]&, entry: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            entry_path: mutable darray[u8] = []
            for root_index in 0..<root.count |entry_path, root|:
                entry_path.push(root[root_index])
            if entry_path.count == 0.usize() or entry_path[entry_path.count - 1.usize()] != 47:
                entry_path.push(47)
            for entry_index in 0..<entry.count |entry_path, entry|:
                entry_path.push(entry[entry_index])
            return false if not canonical_entry_within_root(root, &entry_path)
            entry_path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&entry_path, &entry_path_c)
            entry_path_name: cstr = (&entry_path_c[0]).cast[cstr] can Unsafe.PointerCast
            return false if Platform::pkg_package_file_size(entry_path_name) < 0
            return true

        def valid_target_objects(raw: darray[u8]&, root: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            targets_start: usize = Json::root_value_offset(raw, "targets")
            return false if targets_start >= raw.count or raw[targets_start] != 91
            targets_end: usize = Json::array_end(raw, targets_start)
            return false if targets_end <= targets_start or targets_end >= raw.count
            seen: mutable darray[u8] = []
            found: mutable usize = 0.usize()
            index: mutable usize = targets_start + 1.usize()
            while index < targets_end |raw, root, seen, found, index|:
                if raw[index] == 123:
                    object_end: usize = Json::object_end(raw, index)
                    return false if object_end <= index or object_end >= targets_end
                    return false if not SchemaFields::valid(raw, index, object_end, SchemaFields::Kind.ManifestTarget)
                    target_name: mutable darray[u8] = []
                    return false if not Json::object_string_value(raw, index, object_end, "name", &target_name)
                    return false if not valid_package_name(target_name)
                    target_kind: mutable darray[u8] = []
                    return false if not Json::object_string_value(raw, index, object_end, "kind", &target_kind)
                    return false if not (ByteText::equal_text(target_kind, "bin") or ByteText::equal_text(target_kind, "lib") or ByteText::equal_text(target_kind, "test"))
                    target_entry: mutable darray[u8] = []
                    return false if not Json::object_string_value(raw, index, object_end, "entry", &target_entry)
                    return false if not safe_relative_entry(target_entry) or not target_file_is_valid(root, target_entry)
                    return false if dependency_alias_seen(seen, target_name)
                    return false if found >= ManifestTargets::max_targets
                    seen.push(0) if seen.count > 0.usize()
                    for name_index in 0..<target_name.count |seen, target_name|:
                        seen.push(target_name[name_index])
                    seen.push(0)
                    found <- found + 1.usize()
                    index <- object_end
                elif raw[index] != 32 and raw[index] != 9 and raw[index] != 10 and raw[index] != 13 and raw[index] != 44:
                    # Every array member must be a target object. Ignoring scalar or
                    # nested members here could let a syntactically valid but
                    # schema-invalid `targets` array influence selection indirectly.
                    return false
                index <- index + 1.usize()
            return found > 0.usize()

        # ---------- semantic versions ---------------------------------------------------------

        def parse_version(value: darray[u8]&, out: mutable Model::Version&) -> bool:
            out <- Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return false if not PackageIdentity::parse_version(value, &parsed)
            out.major <- parsed.major
            out.minor <- parsed.minor
            out.patch <- parsed.patch
            out.prerelease <- parsed.prerelease
            return true

        def version_compare(left: Model::Version, right: Model::Version) -> i64:
            return SemVer::compare(left, right)

        # ---------- manifest and lock ---------------------------------------------------------

        def valid_package_name(name: darray[u8]&) -> bool:
            return PackageIdentity::valid_name(name)

        def validate_manifest_at(raw: darray[u8]&, root: darray[u8]&, name_out: mutable darray[u8]&, version_out: mutable darray[u8]&) -> bool:
            name_out.resize(0)
            version_out.resize(0)
            return false if not Json::valid_document(raw)
            return false if not Json::unique_object_keys(raw)
            return false if not Manifest::allowed_keys(raw)
            for index in 0..<raw.count |raw|:
                return false if raw[index] == 0
            object_start: usize = Json::root_start(raw)
            object_finish: usize = Json::root_object_end(raw, object_start)
            schema_version: mutable u64 = 0.u64()
            return false if not Json::object_unsigned_value(raw, object_start, object_finish, "schema-version", &schema_version) or schema_version != 1.u64()
            return false if not Manifest::valid_optional_package_strings(raw)
            return false if not Manifest::valid_pattern_array(raw, "include") or not Manifest::valid_pattern_array(raw, "exclude")
            return false if not valid_target_objects(raw, root)
            return false if not Manifest::valid_dependency_map(raw, "dependencies")
            return false if not Manifest::valid_dependency_map(raw, "dev-dependencies")
            return false if not dependency_map_empty(raw, "dev-dependencies")
            name: mutable darray[u8] = []
            version: mutable darray[u8] = []
            package_start: mutable usize = 0.usize()
            package_end: mutable usize = 0.usize()
            return false if not Json::object_value_span(raw, object_start, object_finish, "package", &package_start, &package_end)
            return false if not Json::object_string_value(raw, package_start, package_end, "name", &name)
            return false if not Json::object_string_value(raw, package_start, package_end, "version", &version)
            return false if not valid_package_name(name)
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return false if not parse_version(version, &parsed)
            for index in 0..<name.count |name_out, name|:
                name_out.push(name[index])
            for index in 0..<version.count |version_out, version|:
                version_out.push(version[index])
            return true

        def validate_manifest(raw: darray[u8]&, name_out: mutable darray[u8]&, version_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root: mutable darray[u8] = [46]
            return validate_manifest_at(raw, &root, name_out, version_out)

        def load_package_at(root: darray[u8]&, name_out: mutable darray[u8]&, version_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            name_out.resize(0)
            version_out.resize(0)
            manifest_path: mutable darray[u8] = []
            ProjectFiles::path_join_into(root, "elisapkg.json", &manifest_path)
            raw: mutable darray[u8] = []
            return false if not Platform::pkg_read_bounded_file(manifest_path, Json::max_document_bytes, &raw)
            return false if not validate_manifest_at(raw, root, name_out, version_out)
            return true

        def slice_less_slice(raw: darray[u8]&, left_start: usize, left_end: usize, right_start: usize, right_end: usize) -> bool:
            left_count: usize = left_end - left_start
            right_count: usize = right_end - right_start
            limit: usize = left_count if left_count < right_count else right_count
            for index in 0..<limit |raw|:
                return true if raw[left_start + index] < raw[right_start + index]
                return false if raw[left_start + index] > raw[right_start + index]
            return left_count < right_count

        def emitted_contains_slice(emitted: darray[u8]&, raw: darray[u8]&, wanted_start: usize, wanted_end: usize) -> bool:
            cursor: mutable usize = 0.usize()
            while cursor < emitted.count:
                end: mutable usize = cursor
                while end < emitted.count and emitted[end] != 0 |emitted, end|:
                    end <- end + 1.usize()
                if end - cursor == wanted_end - wanted_start:
                    equal: mutable bool = true
                    for index in 0..<(wanted_end - wanted_start) |emitted, raw, equal|:
                        equal <- false if emitted[cursor + index] != raw[wanted_start + index]
                    return true if equal
                cursor <- end + 1.usize()
            return false

        def direct_dependency_count(raw: darray[u8]&, dependency_start: usize, dependency_end: usize) -> usize:
            count: mutable usize = 0.usize()
            in_string: mutable bool = false
            escaped: mutable bool = false
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (dependency_start + 1.usize())..<dependency_end |raw, count, in_string, escaped, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1.usize()
                    while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                        after <- after + 1.usize()
                    count <- count + 1.usize() if braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58
                    in_string <- false
            return count

        def dependency_map_empty(raw: darray[u8]&, wanted: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            dependency_start: usize = Json::root_value_offset(raw, wanted)
            return true if dependency_start >= raw.count
            dependency_end: usize = Json::object_end(raw, dependency_start)
            return false if dependency_end <= dependency_start or raw[dependency_start] != 123
            return direct_dependency_count(raw, dependency_start, dependency_end) == 0.usize()

        def queue_append_field(queue: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |queue, value|:
                queue.push(value[index])
            queue.push(0)

        def queue_append_record(queue: mutable darray[u8]&, record_starts: mutable darray[usize]&, path: darray[u8]&, name: darray[u8]&, version: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            record_starts.push(queue.count)
            queue_append_field(queue, path)
            queue_append_field(queue, name)
            queue_append_field(queue, version)

        def queue_field_at(queue: darray[u8]&, record_starts: darray[usize]&, record: usize, field: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if record >= record_starts.count or field >= 3.usize()
            cursor: mutable usize = record_starts[record]
            for current_field in 0..<3 |queue, record_starts, record, field, current_field, cursor, out|:
                return false if cursor >= queue.count
                end: mutable usize = cursor
                while end < queue.count and queue[end] != 0 |queue, end|:
                    end <- end + 1.usize()
                return false if end >= queue.count
                if current_field == field:
                    for index in cursor..<end |queue, out|:
                        out.push(queue[index])
                    return true
                cursor <- end + 1.usize()
            return false

        def queue_name_record(queue: darray[u8]&, record_starts: darray[usize]&, sorted_records: darray[usize]&, total: usize, wanted: darray[u8]&, insertion_out: mutable usize&) -> usize can[Memory.Allocate, Abort.Panic]:
            insertion_out <- total + 1.usize()
            return total if sorted_records.count != total
            lower: mutable usize = 0.usize()
            upper: mutable usize = sorted_records.count
            while lower < upper |queue, record_starts, sorted_records, wanted, lower, upper|:
                middle: usize = lower + (upper - lower) / 2.usize()
                record: usize = sorted_records[middle]
                return total if record >= record_starts.count
                candidate: mutable darray[u8] = []
                if not queue_field_at(queue, record_starts, record, 1, &candidate):
                    return total
                if ByteText::less(candidate, wanted):
                    lower <- middle + 1.usize()
                else:
                    upper <- middle
            insertion_out <- lower
            return total if lower >= sorted_records.count
            record: usize = sorted_records[lower]
            if record >= record_starts.count:
                insertion_out <- total + 1.usize()
                return total
            candidate: mutable darray[u8] = []
            if not queue_field_at(queue, record_starts, record, 1, &candidate):
                insertion_out <- total + 1.usize()
                return total
            return record if ByteText::equal(candidate, wanted)
            return total

        def queue_insert_sorted_record(sorted_records: mutable darray[usize]&, insertion: usize, record: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if insertion > sorted_records.count
            previous_count: usize = sorted_records.count
            sorted_records.resize(previous_count + 1.usize())
            cursor: mutable usize = previous_count
            while cursor > insertion |sorted_records, cursor|:
                sorted_records[cursor] <- sorted_records[cursor - 1.usize()]
                cursor <- cursor - 1.usize()
            sorted_records[insertion] <- record
            return true

        def append_local_dependency_records(raw: darray[u8]&, package_root: darray[u8]&, queue: mutable darray[u8]&, record_starts: mutable darray[usize]&, sorted_records: mutable darray[usize]&, edges: mutable darray[usize]&, edge_count: mutable usize&, total: mutable usize&, parent: usize) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            dependency_start: usize = Json::root_value_offset(raw, "dependencies")
            return true if dependency_start >= raw.count
            dependency_end: usize = Json::object_end(raw, dependency_start)
            return false if dependency_end <= dependency_start or raw[dependency_start] != 123
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0.usize()
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (dependency_start + 1.usize())..<dependency_end |raw, package_root, queue, record_starts, sorted_records, edges, edge_count, total, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1.usize()
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1.usize()
                    while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                        after <- after + 1.usize()
                    if braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58:
                        return false if edge_count >= MAX_BUILD_GRAPH_EDGES
                        edge_count <- edge_count + 1.usize()
                        alias: mutable darray[u8] = []
                        for key_index in string_start..<index |alias, raw|:
                            alias.push(raw[key_index])
                        return false if not valid_package_name(alias)
                        object_start: mutable usize = after + 1.usize()
                        while object_start < dependency_end and (raw[object_start] == 32 or raw[object_start] == 9 or raw[object_start] == 10 or raw[object_start] == 13) |raw, object_start|:
                            object_start <- object_start + 1.usize()
                        object_end: usize = Json::object_end(raw, object_start)
                        return false if object_start >= dependency_end or object_end <= object_start or raw[object_start] != 123 or object_end > dependency_end
                        dep_path: mutable darray[u8] = []
                        return false if not Json::object_string_value(raw, object_start, object_end, "path", &dep_path)
                        return false if not Manifest::valid_dependency_path(dep_path)
                        parent_root: mutable darray[u8] = []
                        if package_root.count > 0.usize() and not (package_root.count == 1.usize() and package_root[0] == 46):
                            for root_index in 0..<package_root.count |parent_root, package_root|:
                                parent_root.push(package_root[root_index])
                        dep_path_c: mutable darray[u8] = []
                        ProjectFiles::path_with_nul_into(&dep_path, &dep_path_c)
                        dep_path_name: cstr = (&dep_path_c[0]).cast[cstr] can Unsafe.PointerCast
                        child_root_raw: mutable darray[u8] = []
                        ProjectFiles::path_join_into(&parent_root, dep_path_name, &child_root_raw)
                        child_root: mutable darray[u8] = []
                        return false if not normalize_relative_path(&child_root_raw, &child_root)
                        child_name: mutable darray[u8] = []
                        child_version: mutable darray[u8] = []
                        return false if not load_package_at(&child_root, &child_name, &child_version)
                        return false if not ByteText::equal(alias, child_name)
                        insertion: mutable usize = 0.usize()
                        existing: usize = queue_name_record(queue, record_starts, sorted_records, total, child_name, &insertion)
                        return false if insertion > sorted_records.count
                        if existing < total:
                            existing_path: mutable darray[u8] = []
                            existing_version: mutable darray[u8] = []
                            return false if not queue_field_at(queue, record_starts, existing, 0, &existing_path) or not queue_field_at(queue, record_starts, existing, 2, &existing_version)
                            return false if not ByteText::equal(existing_path, child_root) or not ByteText::equal(existing_version, child_version)
                            edges.push(existing) if parent < total
                            in_string <- false
                            continue
                        return false if total >= 4096.usize()
                        queue_append_record(queue, record_starts, &child_root, child_name, child_version)
                        return false if not queue_insert_sorted_record(sorted_records, insertion, total)
                        edges.push(total) if parent < total
                        total <- total + 1.usize()
                    in_string <- false
            return true

        def local_dependency_graph_is_acyclic(total: usize, edges: darray[usize]&, edge_offsets: darray[usize]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if edge_offsets.count != total + 1.usize()
            indegrees: mutable darray[usize] = []
            indegrees.resize(total)
            for index in 0..<total |indegrees|:
                indegrees[index] <- 0.usize()
            for source in 0..<total |edge_offsets, edges, indegrees|:
                return false if edge_offsets[source + 1.usize()] < edge_offsets[source] or edge_offsets[source + 1.usize()] > edges.count
                for edge_index in edge_offsets[source]..<edge_offsets[source + 1.usize()] |edges, indegrees|:
                    target: usize = edges[edge_index]
                    return false if target >= total
                    indegrees[target] <- indegrees[target] + 1.usize()
            ready: mutable darray[usize] = []
            for index in 0..<total |indegrees, ready|:
                ready.push(index) if indegrees[index] == 0.usize()
            ready_cursor: mutable usize = 0.usize()
            while ready_cursor < ready.count |ready, ready_cursor, edges, edge_offsets, indegrees|:
                source: usize = ready[ready_cursor]
                for edge_index in edge_offsets[source]..<edge_offsets[source + 1.usize()] |edges, indegrees, ready|:
                    target: usize = edges[edge_index]
                    return false if indegrees[target] == 0.usize()
                    indegrees[target] <- indegrees[target] - 1.usize()
                    ready.push(target) if indegrees[target] == 0.usize()
                ready_cursor <- ready_cursor + 1.usize()
            return ready.count == total

        def canonical_transitive_local_lock(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out: mutable darray[u8] = []
            graph_source_bytes: mutable usize = 0.usize()
            root_digest_bytes: mutable darray[u8] = []
            root_digest: mutable darray[u8] = []
            return [] if Integrity::sha256(raw, &root_digest_bytes) != Integrity::DigestCode.Ok
            return [] if not Integrity::hex_digest(root_digest_bytes, &root_digest)
            root_source_digest: mutable darray[u8] = []
            root_source_bytes: mutable usize = 0.usize()
            return [] if not SourceFingerprint::at_bounded(root, &root_source_digest, SourceFingerprint::maximum_snapshot_bytes, &root_source_bytes)
            graph_source_bytes <- root_source_bytes
            ByteText::append_text(&out, "{\n  \"lock-version\": 2,\n  \"resolver\": \"elisapkg-v2\",\n  \"package\": {\n    \"name\": \"")
            ByteText::append(&out, name)
            ByteText::append_text(&out, "\",\n    \"version\": \"")
            ByteText::append(&out, version)
            ByteText::append_text(&out, "\",\n    \"manifest-digest\": \"sha256:")
            ByteText::append(&out, root_digest)
            ByteText::append_text(&out, "\",\n    \"source-digest\": \"sha256:")
            ByteText::append(&out, root_source_digest)
            ByteText::append_text(&out, "\"\n  },\n  \"packages\": [")
            queue: mutable darray[u8] = []
            record_starts: mutable darray[usize] = []
            sorted_records: mutable darray[usize] = []
            edges: mutable darray[usize] = []
            edge_count: mutable usize = 0.usize()
            total: mutable usize = 0.usize()
            return [] if not append_local_dependency_records(raw, root, &queue, &record_starts, &sorted_records, &edges, &edge_count, &total, 18446744073709551615.usize())
            if total == 0.usize():
                ByteText::append_text(&out, "]\n}\n")
                return out
            edge_offsets: mutable darray[usize] = []
            edge_offsets.push(0.usize())
            processed: mutable usize = 0.usize()
            while processed < total |queue, record_starts, sorted_records, edges, edge_count, edge_offsets, processed, total, root|:
                package_root: mutable darray[u8] = []
                return [] if not queue_field_at(queue, record_starts, processed, 0, &package_root)
                manifest_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(&package_root, "elisapkg.json", &manifest_path)
                child_raw: mutable darray[u8] = []
                return [] if not Platform::pkg_read_bounded_file(manifest_path, Json::max_document_bytes, &child_raw)
                child_name: mutable darray[u8] = []
                child_version: mutable darray[u8] = []
                return [] if not validate_manifest_at(child_raw, &package_root, &child_name, &child_version)
                return [] if ByteText::equal(child_name, name)
                queued_name: mutable darray[u8] = []
                queued_version: mutable darray[u8] = []
                return [] if not queue_field_at(queue, record_starts, processed, 1, &queued_name) or not queue_field_at(queue, record_starts, processed, 2, &queued_version)
                return [] if not ByteText::equal(queued_name, child_name) or not ByteText::equal(queued_version, child_version)
                return [] if not append_local_dependency_records(child_raw, &package_root, &queue, &record_starts, &sorted_records, &edges, &edge_count, &total, processed)
                processed <- processed + 1.usize()
                edge_offsets.push(edges.count)
            return [] if not local_dependency_graph_is_acyclic(total, edges, edge_offsets)
            first: mutable bool = true
            return [] if sorted_records.count != total
            for sorted_position in 0..<total |queue, record_starts, sorted_records, out, first|:
                selected: usize = sorted_records[sorted_position]
                return [] if selected >= record_starts.count
                selected_name: mutable darray[u8] = []
                selected_path: mutable darray[u8] = []
                selected_version: mutable darray[u8] = []
                return [] if not queue_field_at(queue, record_starts, selected, 0, &selected_path) or not queue_field_at(queue, record_starts, selected, 1, &selected_name) or not queue_field_at(queue, record_starts, selected, 2, &selected_version)
                selected_manifest_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(&selected_path, "elisapkg.json", &selected_manifest_path)
                selected_manifest: mutable darray[u8] = []
                return [] if not Platform::pkg_read_bounded_file(selected_manifest_path, Json::max_document_bytes, &selected_manifest)
                selected_source_digest: mutable darray[u8] = []
                selected_source_bytes: mutable usize = 0.usize()
                return [] if graph_source_bytes > SourceFingerprint::maximum_snapshot_bytes or not SourceFingerprint::at_bounded(selected_path, &selected_source_digest, SourceFingerprint::maximum_snapshot_bytes - graph_source_bytes, &selected_source_bytes)
                graph_source_bytes <- graph_source_bytes + selected_source_bytes
                selected_digest: mutable darray[u8] = []
                selected_digest_bytes: mutable darray[u8] = []
                return [] if Integrity::sha256(selected_manifest, &selected_digest_bytes) != Integrity::DigestCode.Ok
                return [] if not Integrity::hex_digest(selected_digest_bytes, &selected_digest)
                out.push(44) if not first
                ByteText::append_text(&out, "\n    {\"name\":\"")
                ByteText::append(&out, selected_name)
                ByteText::append_text(&out, "\",\"version\":\"")
                ByteText::append(&out, selected_version)
                ByteText::append_text(&out, "\",\"source\":{\"type\":\"path\",\"path\":\"")
                ByteText::append(&out, selected_path)
                ByteText::append_text(&out, "\"},\"manifest-digest\":\"sha256:")
                ByteText::append(&out, selected_digest)
                ByteText::append_text(&out, "\",\"source-digest\":\"sha256:")
                ByteText::append(&out, selected_source_digest)
                ByteText::append_text(&out, "\"}")
                first <- false
            ByteText::append_text(&out, "\n  ]\n}\n")
            return out

        def collect_registry_roots[@r](raw: darray[u8]&, out: mutable darray[Solver::Constraint]& @r, has_local: mutable bool&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            has_local <- false
            dependency_start: usize = Json::root_value_offset(raw, "dependencies")
            return true if dependency_start >= raw.count
            dependency_end: usize = Json::object_end(raw, dependency_start)
            return false if dependency_end <= dependency_start or raw[dependency_start] != 123
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (dependency_start + 1)..<dependency_end |raw, out, has_local, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                        after <- after + 1
                    if braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58:
                        alias: mutable darray[u8] @r = []
                        for item in string_start..<index |raw, alias|:
                            alias.push(raw[item])
                        after <- after + 1
                        while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                            after <- after + 1
                        value_end: usize = Json::object_end(raw, after)
                        return false if after >= dependency_end or value_end <= after or raw[after] != 123 or value_end > dependency_end
                        if Json::object_has_key(raw, after, value_end, "path"):
                            has_local <- true
                        else:
                            registry: mutable darray[u8] = []
                            requirement: mutable darray[u8] @r = []
                            return false if not Json::object_string_value(raw, after, value_end, "registry", &registry) or not Json::object_string_value(raw, after, value_end, "version", &requirement)
                            return false if not ByteText::equal_text(registry, "primary")
                            return false if out.count >= MAX_DEPENDENCIES
                            out.push(Solver::Constraint{package: alias, requirement: requirement})
                    in_string <- false
            return true

        def registry_queue_append(queue: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |queue, value|:
                queue.push(value[index])
            queue.push(0)

        def registry_queue_contains(queue: darray[u8]&, wanted: darray[u8]&) -> bool:
            cursor: mutable usize = 0
            while cursor < queue.count:
                finish: mutable usize = cursor
                while finish < queue.count and queue[finish] != 0 |queue, finish|:
                    finish <- finish + 1
                return true if finish - cursor == wanted.count and ByteText::range_equals(queue, cursor, finish, wanted)
                cursor <- finish + 1
            return false

        def registry_queue_field_at(queue: darray[u8]&, record: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            cursor: mutable usize = 0
            current: mutable usize = 0
            while cursor < queue.count |queue, cursor, current, out|:
                finish: mutable usize = cursor
                while finish < queue.count and queue[finish] != 0 |queue, finish|:
                    finish <- finish + 1
                if current == record:
                    out.resize(0)
                    for index in cursor..<finish |queue, out|:
                        out.push(queue[index])
                    return true
                cursor <- finish + 1
                current <- current + 1
            return false

        def registry_evidence_field_at(values: darray[u8]&, record: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return registry_queue_field_at(values, record, out)

        def registry_append_decimal(out: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            start: usize = out.count
            out.resize(start + 20.usize())
            number: mutable u64 = value
            cursor: mutable usize = start
            if number == 0:
                out[cursor] <- 48
                cursor <- cursor + 1.usize()
            else:
                while number > 0 |out, number, cursor|:
                    out[cursor] <- 48 + (number % 10).u8()
                    cursor <- cursor + 1.usize()
                    number <- number / 10
                left: mutable usize = start
                right: mutable usize = cursor
                while left < right and right - left > 1.usize() |out, left, right|:
                    right <- right - 1.usize()
                    temporary: u8 = out[left]
                    out[left] <- out[right]
                    out[right] <- temporary
                    left <- left + 1.usize()
            out.resize(cursor)

        def registry_security_status(code: Registry::ResultCode) -> bool:
            return code == Registry::ResultCode.InvalidConfiguration or code == Registry::ResultCode.MalformedMetadata or code == Registry::ResultCode.MissingSignature or code == Registry::ResultCode.MissingTrustRoot or code == Registry::ResultCode.InvalidSignature or code == Registry::ResultCode.ExpiredMetadata or code == Registry::ResultCode.RollbackDetected or code == Registry::ResultCode.DigestMismatch or code == Registry::ResultCode.ResourceLimit or code == Registry::ResultCode.TrustStateUnavailable or code == Registry::ResultCode.TrustStateMalformed or code == Registry::ResultCode.ClockRollback or code == Registry::ResultCode.ClockUnavailable or code == Registry::ResultCode.ExpiryHorizon or code == Registry::ResultCode.TrustRootChanged or code == Registry::ResultCode.TufEquivocationDetected

        def registry_candidate_matches(candidates: darray[Solver::Candidate]&, package: darray[u8]&, version: Model::Version) -> bool:
            for index in 0..<candidates.count |candidates, package, version|:
                return true if ByteText::equal(candidates[index].package, package) and SemVer::compare(candidates[index].version, version) == 0
            return false

        # Candidate enumeration drives graph solving before the selected
        # metadata is read a second time. Require the final signed dependency
        # set to match that exact graph input so a concurrent metadata change
        # cannot publish a lock for a different release graph.
        def registry_dependency_sets_equal(left: darray[Solver::Constraint]&, right: darray[Solver::Constraint]&) -> bool:
            return false if left.count != right.count
            used: mutable darray[bool] = []
            used.resize(right.count)
            for left_index in 0..<left.count |left, right, used|:
                found: mutable bool = false
                for right_index in 0..<right.count |left, right, used, left_index, found|:
                    continue if used[right_index]
                    if ByteText::equal(left[left_index].package, right[right_index].package) and ByteText::equal(left[left_index].requirement, right[right_index].requirement):
                        used[right_index] <- true
                        found <- true
                        break
                return false if not found
            return true

        def registry_preference_present(preferences: darray[Solver::Preference]&, package: darray[u8]&) -> bool:
            for index in 0..<preferences.count |preferences, package|:
                return true if ByteText::equal(preferences[index].package, package)
            return false

        # A prior lock entry is an ordering hint and permits retention of only
        # that exact soft-yanked release. It is never a constraint: the solver
        # checks every active requirement and backtracks when another version
        # is required by the manifest or a selected dependency.
        def append_registry_lock_preferences(lock: darray[u8]&, unlock: darray[u8]&, candidates: darray[Solver::Candidate]&, preferences: mutable darray[Solver::Preference]&) -> void can[Memory.Allocate, Abort.Panic]:
            return if lock.count == 0.usize() or not Json::valid_document(lock) or not Json::unique_object_keys(lock) or not Lockfile::version_is(lock, 3)
            for index in 0..<lock.count |lock, unlock, candidates, preferences|:
                continue if lock[index] != 123
                object_end: usize = Json::object_end(lock, index)
                continue if object_end <= index
                package: mutable darray[u8] = []
                version_text: mutable darray[u8] = []
                continue if not Json::object_string_value(lock, index, object_end, "name", &package) or not Json::object_string_value(lock, index, object_end, "version", &version_text)
                continue if unlock.count > 0.usize() and ByteText::equal(package, unlock)
                parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                continue if not SemVer::parse(version_text, &parsed) or parsed.prerelease
                continue if not registry_candidate_matches(candidates, package, parsed) or registry_preference_present(preferences, package)
                preferences.push(Solver::Preference{package: package, version: parsed})

        def canonical_registry_lock(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&, roots: darray[Solver::Constraint]&, preferred_lock: darray[u8]&, unlock: darray[u8]&, persist_trust: bool) -> darray[u8] can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global.Read:
                out: mutable darray[u8] = []
                root_digest_bytes: mutable darray[u8] = []
                root_digest: mutable darray[u8] = []
                return [] if Integrity::sha256(raw, &root_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(root_digest_bytes, &root_digest)
                root_source_digest: mutable darray[u8] = []
                return [] if not SourceFingerprint::at(root, &root_source_digest)

                candidates: mutable darray[Solver::Candidate] = []
                candidate_index_generations: mutable darray[u64] = []
                candidate_index_digests: mutable darray[u8] = []
                candidate_index_identities: mutable darray[u8] = []
                package_queue: mutable darray[u8] = []
                package_total: mutable usize = 0
                for index in 0..<roots.count |roots, package_queue, package_total|:
                    return [] if registry_queue_contains(package_queue, roots[index].package)
                    registry_queue_append(&package_queue, roots[index].package)
                    package_total <- package_total + 1
                processed: mutable usize = 0
                while processed < package_total:
                    package: mutable darray[u8] = []
                    return [] if not registry_queue_field_at(package_queue, processed, &package)
                    index_data: mutable darray[u8] = []
                    yanked_flags: mutable darray[u8] = []
                    index_generation: mutable u64 = 0
                    index_digest: mutable darray[u8] = []
                    index_identity: mutable darray[u8] = []
                    index_status: Registry::ResultCode = Registry::read_index_with_yanked(package, &index_data, &yanked_flags, &index_generation, &index_digest, &index_identity)
                    if index_status != Registry::ResultCode.Ok and persist_trust and registry_security_status(index_status):
                        out.push(index_status.u8() + 1.u8())
                        return out
                    return [] if index_status != Registry::ResultCode.Ok
                    cursor: mutable usize = 0
                    version_ordinal: mutable usize = 0
                    while cursor < index_data.count:
                        finish: mutable usize = cursor
                        while finish < index_data.count and index_data[finish] != 10 |index_data, finish|:
                            finish <- finish + 1
                        line_end: mutable usize = finish
                        line_end <- line_end - 1 if line_end > cursor and index_data[line_end - 1] == 13
                        return [] if line_end == cursor or line_end - cursor > 128
                        version_text: mutable darray[u8] = []
                        for item in cursor..<line_end |index_data, version_text|:
                            version_text.push(index_data[item])
                        parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                        return [] if not SemVer::parse(version_text, &parsed)
                        return [] if version_ordinal >= yanked_flags.count or yanked_flags[version_ordinal] > 1
                        candidate_yanked: bool = yanked_flags[version_ordinal] == 1
                        version_ordinal <- version_ordinal + 1.usize()
                        selected_text: mutable darray[u8] = []
                        archive: mutable darray[u8] = []
                        digest: mutable darray[u8] = []
                        metadata: mutable darray[u8] = []
                        archive_size: mutable u64 = 0
                        candidate_status: Registry::ResultCode = Registry::resolve_candidate_metadata(package, version_text, &selected_text, &archive, &digest, &archive_size, &metadata)
                        if candidate_status == Registry::ResultCode.ExpiredMetadata:
                            cursor <- finish + 1
                            continue
                        if candidate_status != Registry::ResultCode.Ok and persist_trust and registry_security_status(candidate_status):
                            out.push(candidate_status.u8() + 1.u8())
                            return out
                        return [] if candidate_status != Registry::ResultCode.Ok
                        dependencies: mutable darray[Solver::Constraint] = []
                        dependencies_valid: bool = Registry::read_dependencies(metadata, &dependencies)
                        if not dependencies_valid and persist_trust:
                            out.push(Registry::ResultCode.MalformedMetadata.u8() + 1.u8())
                            return out
                        return [] if not dependencies_valid
                        candidate_package: mutable darray[u8] = []
                        for item in 0..<package.count |candidate_package, package|:
                            candidate_package.push(package[item])
                        for dependency_index in 0..<dependencies.count |dependencies, package_queue, package_total|:
                            if not registry_queue_contains(package_queue, dependencies[dependency_index].package):
                                return [] if package_total >= MAX_DEPENDENCIES
                                registry_queue_append(&package_queue, dependencies[dependency_index].package)
                                package_total <- package_total + 1
                        candidate: Solver::Candidate = Solver::Candidate{package: candidate_package, version: parsed, dependencies: dependencies, yanked: candidate_yanked}
                        candidates.push(candidate)
                        candidate_index_generations.push(index_generation)
                        registry_queue_append(&candidate_index_digests, index_digest)
                        registry_queue_append(&candidate_index_identities, index_identity)
                        return [] if candidates.count > 4096
                        cursor <- finish + 1
                    return [] if version_ordinal != yanked_flags.count
                    processed <- processed + 1
                    return [] if processed > 4096

                selected_indexes: mutable darray[usize] = []
                solve_constraints: mutable darray[Solver::Constraint] = []
                for index in 0..<roots.count |roots, solve_constraints|:
                    solve_constraints.push(roots[index])
                lock_preferences: mutable darray[Solver::Preference] = []
                append_registry_lock_preferences(preferred_lock, unlock, candidates, &lock_preferences)
                solve_status: mutable Solver::SolveCode = Solver::SolveCode.Malformed
                conflict: mutable Solver::Conflict = Solver::Conflict{package: [], first_requirement: [], second_requirement: []}
                if persist_trust:
                    solve_status <- Solver::solve_with_preferences_and_conflict(candidates, solve_constraints, lock_preferences, &selected_indexes, &conflict)
                else:
                    solve_status <- Solver::solve_with_preferences(candidates, solve_constraints, lock_preferences, &selected_indexes)
                if solve_status == Solver::SolveCode.Unsatisfiable and persist_trust:
                    # A one-byte status sentinel is reserved for ordinary provider
                    # failures. Include three NUL-delimited, already validated
                    # fields after the new status so `run_resolve` can report the
                    # deterministic package/range pair without making this function
                    # return a second mutable record.
                    out.push(Registry::ResultCode.Unsatisfiable.u8() + 1.u8())
                    for byte_index in 0..<conflict.package.count |out, conflict|:
                        out.push(conflict.package[byte_index])
                    out.push(0)
                    for byte_index in 0..<conflict.first_requirement.count |out, conflict|:
                        out.push(conflict.first_requirement[byte_index])
                    out.push(0)
                    for byte_index in 0..<conflict.second_requirement.count |out, conflict|:
                        out.push(conflict.second_requirement[byte_index])
                    out.push(0)
                    return out
                return [] if solve_status != Solver::SolveCode.Solved
                ByteText::append_text(&out, "{\n  \"lock-version\": 3,\n  \"resolver\": \"elisapkg-registry-v1\",\n  \"package\": {\n    \"name\": \"")
                ByteText::append(&out, name)
                ByteText::append_text(&out, "\",\n    \"version\": \"")
                ByteText::append(&out, version)
                ByteText::append_text(&out, "\",\n    \"manifest-digest\": \"sha256:")
                ByteText::append(&out, root_digest)
                ByteText::append_text(&out, "\",\n    \"source-digest\": \"sha256:")
                ByteText::append(&out, root_source_digest)
                ByteText::append_text(&out, "\"\n  },\n  \"packages\": [")
                emitted: mutable darray[u8] = []
                first: mutable bool = true
                for _step in 0..<selected_indexes.count |selected_indexes, candidates, emitted, out, first|:
                    found: mutable bool = false
                    selected_slot: mutable usize = selected_indexes.count
                    selected_name: mutable darray[u8] = []
                    for item in 0..<selected_indexes.count |selected_indexes, candidates, emitted, found, selected_slot, selected_name|:
                        candidate_index: usize = selected_indexes[item]
                        candidate_name: darray[u8] = candidates[candidate_index].package
                        continue if emitted_contains_slice(emitted, candidate_name, 0, candidate_name.count)
                        if not found or ByteText::less(candidate_name, selected_name):
                            selected_slot <- item
                            selected_name.resize(0)
                            for byte_index in 0..<candidate_name.count |selected_name, candidate_name|:
                                selected_name.push(candidate_name[byte_index])
                            found <- true
                    return [] if not found
                    candidate_index: usize = selected_indexes[selected_slot]
                    candidate: Solver::Candidate = candidates[candidate_index]
                    if candidate.yanked and persist_trust:
                        warning: mutable darray[u8] = []
                        version_label: mutable darray[u8] = []
                        ByteText::append_text(&warning, "warning: retaining locked yanked release ")
                        ByteText::append(&warning, candidate.package)
                        warning.push(64)
                        Registry::exact_requirement(candidate.version, &version_label)
                        ByteText::append(&warning, version_label)
                        ByteText::append_text(&warning, "; run 'elisapkg update ")
                        ByteText::append(&warning, candidate.package)
                        ByteText::append_text(&warning, "' to select a non-yanked release\n")
                        CliOutput::write_bytes(2, warning)
                    selected_index_generation: u64 = candidate_index_generations[candidate_index]
                    selected_index_digest: mutable darray[u8] = []
                    selected_index_identity: mutable darray[u8] = []
                    return [] if not registry_evidence_field_at(candidate_index_digests, candidate_index, &selected_index_digest) or not registry_evidence_field_at(candidate_index_identities, candidate_index, &selected_index_identity)
                    exact: mutable darray[u8] = []
                    Registry::exact_requirement(candidate.version, &exact)
                    selected_text: mutable darray[u8] = []
                    archive: mutable darray[u8] = []
                    digest: mutable darray[u8] = []
                    metadata: mutable darray[u8] = []
                    archive_size: mutable u64 = 0
                    verified_index_generation: mutable u64 = 0
                    verified_index_digest: mutable darray[u8] = []
                    verified_index_identity: mutable darray[u8] = []
                    final_status: Registry::ResultCode = Registry::resolve_selected_with_index_evidence(candidate.package, exact, &selected_text, &archive, &digest, &archive_size, &metadata, &verified_index_generation, &verified_index_digest, &verified_index_identity)
                    if final_status != Registry::ResultCode.Ok and persist_trust and registry_security_status(final_status):
                        out.push(final_status.u8() + 1.u8())
                        return out
                    return [] if final_status != Registry::ResultCode.Ok
                    if verified_index_generation != selected_index_generation or not ByteText::equal(verified_index_digest, selected_index_digest) or not ByteText::equal(verified_index_identity, selected_index_identity):
                        if persist_trust:
                            out.push(Registry::ResultCode.RollbackDetected.u8() + 1.u8())
                            return out
                        return []
                    metadata_digest_bytes: mutable darray[u8] = []
                    metadata_digest: mutable darray[u8] = []
                    return [] if Integrity::sha256(metadata, &metadata_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(metadata_digest_bytes, &metadata_digest)
                    metadata_signature: mutable darray[u8] = []
                    signature_status: Registry::ResultCode = Registry::read_signature(candidate.package, selected_text, &metadata_signature)
                    if signature_status != Registry::ResultCode.Ok:
                        if persist_trust:
                            out.push(signature_status.u8() + 1.u8())
                            return out
                        return []
                    snapshot_archive: mutable darray[u8] = []
                    snapshot_digest: mutable darray[u8] = []
                    snapshot_size: mutable u64 = 0
                    snapshot_expires: mutable u64 = 0
                    snapshot_dependencies: mutable darray[Solver::Constraint] = []
                    snapshot_status: Registry::ResultCode = Registry::verify_metadata_snapshot(candidate.package, selected_text, metadata_digest, metadata, metadata_signature, &snapshot_archive, &snapshot_digest, &snapshot_size, &snapshot_expires, &snapshot_dependencies)
                    if snapshot_status != Registry::ResultCode.Ok or not ByteText::equal(snapshot_archive, archive) or not ByteText::equal(snapshot_digest, digest) or snapshot_size != archive_size or not registry_dependency_sets_equal(snapshot_dependencies, candidate.dependencies):
                        if persist_trust:
                            failure: Registry::ResultCode = snapshot_status if snapshot_status != Registry::ResultCode.Ok else Registry::ResultCode.DigestMismatch
                            out.push(failure.u8() + 1.u8())
                            return out
                        return []
                    if persist_trust:
                        trust_status: Registry::ResultCode = Registry::record_trusted_at_index(candidate.package, selected_text, digest, metadata_digest, snapshot_expires, selected_index_generation, selected_index_digest, selected_index_identity)
                        if trust_status != Registry::ResultCode.Ok:
                            out.push(trust_status.u8() + 1.u8())
                            return out
                    out.push(44) if not first
                    ByteText::append_text(&out, "\n    {\"name\":\"")
                    ByteText::append(&out, selected_name)
                    ByteText::append_text(&out, "\",\"version\":\"")
                    ByteText::append(&out, selected_text)
                    ByteText::append_text(&out, "\",\"source\":{\"type\":\"registry\",\"registry\":\"primary\",\"archive\":\"")
                    ByteText::append(&out, archive)
                    ByteText::append_text(&out, "\"},\"archive-size\":")
                    registry_append_decimal(&out, archive_size)
                    ByteText::append_text(&out, ",\"archive-digest\":\"sha256:")
                    ByteText::append(&out, digest)
                    ByteText::append_text(&out, "\",\"metadata-digest\":\"sha256:")
                    ByteText::append(&out, metadata_digest)
                    ByteText::append_text(&out, "\"}")
                    for byte_index in 0..<selected_name.count |emitted, selected_name|:
                        emitted.push(selected_name[byte_index])
                    emitted.push(0)
                    first <- false
                ByteText::append_text(&out, "\n  ]\n}\n")
                return out

        def canonical_lock_for_manifest(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&) -> darray[u8] can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                registry_roots: mutable darray[Solver::Constraint] = []
                has_local_dependency: mutable bool = false
                return [] if not collect_registry_roots(raw, &registry_roots, &has_local_dependency)
                if registry_roots.count > 0.usize():
                    return [] if has_local_dependency
                    empty_lock: mutable darray[u8] = []
                    empty_unlock: mutable darray[u8] = []
                    return canonical_registry_lock(name, version, raw, root, registry_roots, empty_lock, empty_unlock, false)
                return canonical_transitive_local_lock(name, version, raw, root)

        def canonical_registry_lock_for_existing_lock(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&, preferred_lock: darray[u8]&) -> darray[u8] can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global.Read:
                registry_roots: mutable darray[Solver::Constraint] = []
                has_local_dependency: mutable bool = false
                return [] if not collect_registry_roots(raw, &registry_roots, &has_local_dependency) or has_local_dependency or registry_roots.count == 0.usize()
                empty_unlock: mutable darray[u8] = []
                return canonical_registry_lock(name, version, raw, root, registry_roots, preferred_lock, empty_unlock, false)

        def canonical_lock_for_manifest_with_options(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&, options: Model::CommandOptions, preferred_lock: darray[u8]&) -> darray[u8] can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                registry_roots: mutable darray[Solver::Constraint] = []
                has_local_dependency: mutable bool = false
                return [] if not collect_registry_roots(raw, &registry_roots, &has_local_dependency)
                if registry_roots.count > 0.usize():
                    return [] if has_local_dependency
                    unlock: mutable darray[u8] = []
                    if Platform::pkg_strlen(options.update_name) > 0.usize():
                        ByteText::append_bounded_text(&unlock, options.update_name)
                    return canonical_registry_lock(name, version, raw, root, registry_roots, preferred_lock, unlock, true)
                return canonical_transitive_local_lock(name, version, raw, root)

        def normalize_relative_path(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            segment_start: mutable usize = 0.usize()
            index: mutable usize = 0.usize()
            while index <= path.count |path, out, segment_start, index|:
                at_end: bool = index == path.count
                if at_end or path[index] == 47:
                    segment_length: usize = index - segment_start
                    if segment_length > 0.usize() and not (segment_length == 1.usize() and path[segment_start] == 46):
                        is_parent: bool = segment_length == 2.usize() and path[segment_start] == 46 and path[segment_start + 1.usize()] == 46
                        if is_parent:
                            if out.count > 0.usize():
                                last: mutable usize = out.count
                                while last > 0.usize() and out[last - 1.usize()] != 47 |out, last|:
                                    last <- last - 1.usize()
                                previous_parent: bool = out.count - last == 2.usize() and out[last] == 46 and out[last + 1.usize()] == 46
                                if previous_parent:
                                    out.push(47)
                                    out.push(46)
                                    out.push(46)
                                else:
                                    # `last` points to the component start;
                                    # remove its preceding separator as well.
                                    if last > 0.usize() and out[last - 1.usize()] == 47:
                                        out.resize(last - 1.usize())
                                    else:
                                        out.resize(last)
                            else:
                                out.push(46)
                                out.push(46)
                        else:
                            if out.count > 0.usize():
                                out.push(47)
                            for part in segment_start..<index |path, out|:
                                out.push(path[part])
                    segment_start <- index + 1.usize()
                index <- index + 1.usize()
            return out.count > 0.usize()

        def dependency_alias_seen(seen: darray[u8]&, alias: darray[u8]&) -> bool:
            cursor: mutable usize = 0.usize()
            while cursor < seen.count:
                segment_end: mutable usize = cursor
                while segment_end < seen.count and seen[segment_end] != 0:
                    segment_end <- segment_end + 1.usize()
                return true if segment_end - cursor == alias.count and ByteText::range_equals(seen, cursor, segment_end, alias)
                cursor <- segment_end + 1.usize()
            return false

        # ---------- project discovery and commands -------------------------------------------

        def project_manifest_exists() -> bool:
            current: bool = ProjectFiles::cstr_file_exists("elisapkg.json")
            legacy: bool = ProjectFiles::cstr_file_exists("manifest.json")
            # Two manifests would create an ambiguous authority boundary. Refuse both
            # rather than silently preferring one based on filename order.
            return false if legacy
            return current

        def change_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not ProjectFiles::valid_path_bytes(path)
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            return Platform::pkg_chdir(path_name) == 0

        def change_to_manifest_path(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return true if change_directory(path)
            last_separator: mutable usize = path.count
            for index in 0..<path.count |path, last_separator|:
                last_separator <- index if path[index] == 47
            # A file-form manifest path is accepted only when its basename is the
            # package manifest. Otherwise a typo such as `--manifest-path settings.json`
            # would silently switch to a different `elisapkg.json` in the same parent.
            manifest_leaf: mutable darray[u8] = []
            leaf_start: usize = 0.usize() if last_separator == path.count else last_separator + 1.usize()
            for index in leaf_start..<path.count |manifest_leaf, path|:
                manifest_leaf.push(path[index])
            return false if not ByteText::equal_text(manifest_leaf, "elisapkg.json")
            parent: mutable darray[u8] = []
            if last_separator == path.count:
                parent.push(46)
            elif last_separator == 0.usize():
                parent.push(47)
            else:
                for index in 0..<last_separator |parent, path|:
                    parent.push(path[index])
            return change_directory(&parent)

        def run_init(argc: i64, slots: mutable cstr&&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                root: mutable darray[u8] = [46]
                target_kind: mutable cstr = "bin"
                target_kind_seen: mutable bool = false
                path_seen: mutable bool = false
                for index in 2..<argc |slots, root, target_kind, target_kind_seen, path_seen|:
                    argument: cstr = slots[index].cast[cstr]
                    if Platform::pkg_cstr_equal(argument, "--lib"):
                        return EXIT_USAGE if target_kind_seen and not Platform::pkg_cstr_equal(target_kind, "lib")
                        target_kind <- "lib"
                        target_kind_seen <- true
                    elif Platform::pkg_cstr_equal(argument, "--bin"):
                        return EXIT_USAGE if target_kind_seen and not Platform::pkg_cstr_equal(target_kind, "bin")
                        target_kind <- "bin"
                        target_kind_seen <- true
                    elif Platform::pkg_cstr_equal(argument, "--help"):
                        CliOutput::usage()
                        return EXIT_OK
                    elif Platform::pkg_strlen(argument) == 0.usize() or argument[0].u8() == 45 or path_seen:
                        return EXIT_USAGE
                    else:
                        root <- []
                        ByteText::append_bounded_text(&root, argument)
                        path_seen <- true
                return EXIT_USAGE if root.count == 0.usize()
                return EXIT_USAGE if root.count > 4096.usize()
                manifest_path: mutable darray[u8] = []
                legacy_manifest_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(root, "elisapkg.json", &manifest_path)
                ProjectFiles::path_join_into(root, "manifest.json", &legacy_manifest_path)
                # Keep init consistent with normal project discovery: an existing
                # compiler manifest and package manifest cannot share one root.
                return EXIT_USAGE if file_exists(&manifest_path)
                return EXIT_USAGE if file_exists(&legacy_manifest_path)
                source: mutable darray[u8] = []
                state: mutable darray[u8] = []
                entry_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(root, "src", &source)
                ProjectFiles::path_join_into(root, ".elisapkg", &state)
                ProjectFiles::path_join_into(source, "main.elisa", &entry_path)
                # Refuse an existing source file before creating any scaffold
                # directories, so a failed init leaves the destination untouched.
                return EXIT_USAGE if file_exists(&entry_path)
                return EXIT_SOURCE if not ProjectFiles::make_directory(&root)
                return EXIT_SOURCE if not ProjectFiles::make_directory(&source) or not ProjectFiles::make_directory(&state)
                manifest: mutable darray[u8] = []
                ByteText::append_text(&manifest, "{\n  \"schema-version\": 1,\n  \"package\": {\n    \"name\": \"app\",\n    \"version\": \"0.1.0\",\n    \"description\": \"An Elisa application\",\n    \"license\": \"MIT\",\n    \"elisa\": \">=0.1.0 <1.0.0\"\n  },\n  \"targets\": [{\"name\": \"app\", \"kind\": \"")
                ByteText::append_bounded_text(&manifest, target_kind)
                ByteText::append_text(&manifest, "\", \"entry\": \"src/main.elisa\"}],\n  \"dependencies\": {},\n  \"dev-dependencies\": {},\n  \"include\": [\"src/**\", \"elisapkg.json\", \"LICENSE\", \"README.md\"]\n}\n")
                entry: mutable darray[u8] = []
                ByteText::append_text(&entry, "def main() -> i64:\n    return 0\n")
                return EXIT_USAGE if file_exists(&entry_path)
                return EXIT_SOURCE if not write_file_noclobber(&manifest_path, &manifest)
                if not write_file_noclobber(&entry_path, &entry):
                    # The manifest was published exclusively. Keep it when the second
                    # scaffold file fails: removing by pathname could delete a file that
                    # another actor installed after the first publication.
                    return EXIT_SOURCE
                CliOutput::write_ok("created package\n")
                return EXIT_OK

        def run_add(argc: i64, slots: mutable cstr&&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return EXIT_SECURITY if not ProjectTransaction::recover()
                local_form: bool = argc == 5 and Platform::pkg_cstr_equal(slots[3].cast[cstr], "--path")
                registry_form: bool = argc == 7 and Platform::pkg_cstr_equal(slots[3].cast[cstr], "--version") and Platform::pkg_cstr_equal(slots[5].cast[cstr], "--registry") and Platform::pkg_cstr_equal(slots[6].cast[cstr], "primary")
                return EXIT_USAGE if not local_form and not registry_form
                alias: mutable darray[u8] = []
                ByteText::append_bounded_text(&alias, slots[2].cast[cstr])
                return EXIT_USAGE if not valid_package_name(alias)
                root: mutable darray[u8] = [46]
                root_name: mutable darray[u8] = []
                root_version: mutable darray[u8] = []
                return EXIT_USAGE if not load_package_at(&root, &root_name, &root_version)
                dependency_path: mutable darray[u8] = []
                requirement: mutable darray[u8] = []
                if local_form:
                    ByteText::append_bounded_text(&dependency_path, slots[4].cast[cstr])
                    return EXIT_USAGE if not Manifest::valid_dependency_path(dependency_path)
                    dependency_name: mutable darray[u8] = []
                    dependency_version: mutable darray[u8] = []
                    return EXIT_RESOLVE if not load_package_at(&dependency_path, &dependency_name, &dependency_version)
                    return EXIT_RESOLVE if not ByteText::equal(alias, dependency_name) or ByteText::equal(alias, root_name)
                else:
                    ByteText::append_bounded_text(&requirement, slots[4].cast[cstr])
                    parsed_requirement: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
                    return EXIT_USAGE if not SemVer::parse_requirement(requirement, &parsed_requirement)
                    return EXIT_RESOLVE if ByteText::equal(alias, root_name)
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                return EXIT_USAGE if not validate_manifest_at(raw, &root, &root_name, &root_version)
                updated: darray[u8] = ManifestEdits::append_path(raw, alias, dependency_path) if local_form else ManifestEdits::append_registry(raw, alias, requirement)
                if updated.count == 0.usize():
                    CliOutput::write_error("error: dependency is already declared or the manifest has no dependency object\n")
                    return EXIT_RESOLVE
                return EXIT_SECURITY if not ProjectTransaction::begin(raw)
                if not ProjectTransaction::stage_manifest(updated) or not ProjectFiles::write_cstr_file("elisapkg.json", &updated):
                    _ = ProjectTransaction::restore()
                    return EXIT_SOURCE
                options: Model::CommandOptions = Model::CommandOptions{locked: false, offline: false, frozen: false, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                resolved: i64 = run_resolve(&root, options, true, false)
                if resolved != EXIT_OK:
                    restored: bool = ProjectTransaction::restore()
                    if not restored:
                        CliOutput::write_error("error: dependency edit failed and the original manifest could not be restored\n")
                        return EXIT_SECURITY
                    return resolved
                if not ProjectTransaction::mark_lock():
                    _ = ProjectTransaction::restore()
                    return EXIT_SECURITY
                return EXIT_SECURITY if not ProjectTransaction::commit()
                CliOutput::write_ok("added ")
                CliOutput::write_ok("local " if local_form else "registry ")
                CliOutput::write_ok("dependency ")
                CliOutput::write_bytes(1, &alias)
                if local_form:
                    CliOutput::write_ok(" from ")
                    CliOutput::write_bytes(1, &dependency_path)
                else:
                    CliOutput::write_ok(" with requirement ")
                    CliOutput::write_bytes(1, &requirement)
                CliOutput::write_ok("\n")
                return EXIT_OK

        def load_package(start: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            exists: bool = project_manifest_exists()
            _ = start
            return false if not exists
            raw: mutable darray[u8] = []
            # One extra byte distinguishes an oversized document from a valid document
            # that happens to end exactly at the policy limit.
            raw.resize(1048577)
            return false if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
            return false if raw.count == 0.usize()
            name: mutable darray[u8] = []
            version: mutable darray[u8] = []
            valid: bool = validate_manifest(raw, &name, &version)
            return false if not valid
            return true

        def run_check(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if not load_package(start):
                    CliOutput::write_error("error: invalid or missing elisapkg.json (schema-version, package.name, package.version, and targets are required)\n")
                    return EXIT_USAGE
                if options.json:
                    CliOutput::write_ok("{\"schema-version\":1,\"valid\":true,\"manifest\":\"elisapkg.json\"}\n")
                    return EXIT_OK
                CliOutput::write_ok("manifest valid: ")
                CliOutput::write_ok("elisapkg.json")
                CliOutput::write_ok("\n")
                return EXIT_OK

        def print_lock_packages(raw: darray[u8]&) -> bool can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic]:
            can Global.Read:
                found: mutable usize = 0.usize()
                for index in 0..<raw.count |raw, found|:
                    continue if raw[index] != 123
                    object_end: usize = Json::object_end(raw, index)
                    continue if object_end <= index
                    package_name: mutable darray[u8] = []
                    package_version: mutable darray[u8] = []
                    if Json::object_string_value(raw, index, object_end, "name", &package_name) and Json::object_string_value(raw, index, object_end, "version", &package_version):
                        CliOutput::write_bytes(1, &package_name)
                        CliOutput::write_ok(" ")
                        CliOutput::write_bytes(1, &package_version)
                        CliOutput::write_ok("\n")
                        found <- found + 1.usize()
                return found > 0.usize()

        def print_lock_packages_json(raw: darray[u8]&) -> bool can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic]:
            can Global.Read:
                found: mutable usize = 0.usize()
                CliOutput::write_ok("{\"schema-version\":1,\"packages\":[")
                for index in 0..<raw.count |raw, found|:
                    continue if raw[index] != 123
                    object_end: usize = Json::object_end(raw, index)
                    continue if object_end <= index
                    package_name: mutable darray[u8] = []
                    package_version: mutable darray[u8] = []
                    if Json::object_string_value(raw, index, object_end, "name", &package_name) and Json::object_string_value(raw, index, object_end, "version", &package_version):
                        CliOutput::write_ok(",") if found > 0.usize()
                        CliOutput::write_ok("{\"name\":\"")
                        CliOutput::write_bytes(1, &package_name)
                        CliOutput::write_ok("\",\"version\":\"")
                        CliOutput::write_bytes(1, &package_version)
                        CliOutput::write_ok("\"}")
                        found <- found + 1.usize()
                return false if found == 0.usize()
                CliOutput::write_ok("]}\n")
                return true

        def write_resolved_text(name: cstr, version: cstr, options: Model::CommandOptions) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if options.json:
                    CliOutput::write_ok("{\"schema-version\":1,\"resolved\":true,\"package\":{\"name\":\"")
                    CliOutput::write_text(1, name)
                    CliOutput::write_ok("\",\"version\":\"")
                    CliOutput::write_text(1, version)
                    CliOutput::write_ok("\"}}\n")
                    return
                CliOutput::write_ok("resolved ")
                CliOutput::write_text(1, name)
                CliOutput::write_ok(" ")
                CliOutput::write_text(1, version)
                CliOutput::write_ok("\n")

        def registry_conflict_field(raw: darray[u8]&, wanted: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            cursor: mutable usize = 1.usize()
            current: mutable usize = 0.usize()
            while cursor < raw.count |raw, cursor, current, out|:
                finish: mutable usize = cursor
                while finish < raw.count and raw[finish] != 0 |raw, finish|:
                    finish <- finish + 1.usize()
                return false if finish == raw.count
                if current == wanted:
                    for index in cursor..<finish |raw, out|:
                        out.push(raw[index])
                    return true
                current <- current + 1.usize()
                cursor <- finish + 1.usize()
            return false

        def write_registry_conflict(raw: darray[u8]&) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                package: mutable darray[u8] = []
                first_requirement: mutable darray[u8] = []
                second_requirement: mutable darray[u8] = []
                return if not registry_conflict_field(raw, 0, &package) or not registry_conflict_field(raw, 1, &first_requirement) or not registry_conflict_field(raw, 2, &second_requirement)
                return if package.count == 0.usize() or first_requirement.count == 0.usize() or second_requirement.count == 0.usize()
                CliOutput::write_error(" (package ")
                CliOutput::write_bytes(2, &package)
                CliOutput::write_error("; requirements ")
                CliOutput::write_bytes(2, &first_requirement)
                CliOutput::write_error(" and ")
                CliOutput::write_bytes(2, &second_requirement)
                CliOutput::write_error(")")

        def lock_matches_manifest(manifest: darray[u8]&, lock: darray[u8]&, name: darray[u8]&, version: darray[u8]&, start: darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                # Local locks can be compared with the deterministic resolver. Registry
                # locks are already authenticated artifacts; inspection commands must
                # validate their signed identity and shape without refreshing registry
                # metadata or changing trust state.
                if not Lockfile::version_is(lock, 3):
                    expected: darray[u8] = canonical_lock_for_manifest(name, version, manifest, start)
                    return expected.count > 0.usize() and ByteText::equal(expected, lock)
                registry_roots: mutable darray[Solver::Constraint] = []
                has_local_dependency: mutable bool = false
                # A v3 lock is emitted only for a registry-only graph. Requiring the same
                # root shape here prevents an edited lock from bypassing the local/registry
                # source separation before offline cache evidence is inspected.
                return false if not collect_registry_roots(manifest, &registry_roots, &has_local_dependency) or has_local_dependency or registry_roots.count == 0.usize()
                return false if not Json::valid_document(lock) or not Json::unique_object_keys(lock)
                lock_end: usize = Json::object_end(lock, 0)
                return false if lock_end >= lock.count or not SchemaFields::valid(lock, 0, lock_end, SchemaFields::Kind.RegistryLock)
                resolver: mutable darray[u8] = []
                return false if not Json::object_string_value(lock, 0, lock_end, "resolver", &resolver) or not ByteText::equal_text(resolver, "elisapkg-registry-v1")
                package_start: usize = Json::root_value_offset(lock, "package")
                package_end: usize = Json::object_end(lock, package_start)
                return false if package_start >= lock.count or package_end <= package_start or not SchemaFields::valid(lock, package_start, package_end, SchemaFields::Kind.RegistryLockPackage)
                locked_name: mutable darray[u8] = []
                locked_version: mutable darray[u8] = []
                return false if not Json::object_string_value(lock, package_start, package_end, "name", &locked_name) or not Json::object_string_value(lock, package_start, package_end, "version", &locked_version)
                return false if not ByteText::equal(locked_name, name) or not ByteText::equal(locked_version, version)
                manifest_digest_bytes: mutable darray[u8] = []
                manifest_digest: mutable darray[u8] = []
                return false if Integrity::sha256(manifest, &manifest_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
                return false if not Lockfile::sha256_field_equals(lock, package_start, package_end, "manifest-digest", manifest_digest)
                source_digest: mutable darray[u8] = []
                return false if not SourceFingerprint::at(start, &source_digest)
                return false if not Lockfile::sha256_field_equals(lock, package_start, package_end, "source-digest", source_digest)
                packages_start: usize = Json::root_value_offset(lock, "packages")
                packages_end: usize = Json::array_end(lock, packages_start)
                return false if packages_start >= lock.count or packages_end <= packages_start
                cursor: mutable usize = packages_start + 1.usize()
                package_count: mutable usize = 0.usize()
                seen: mutable darray[u8] = []
                previous_package: mutable darray[u8] = []
                has_previous_package: mutable bool = false
                while cursor < packages_end:
                    while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                        cursor <- cursor + 1.usize()
                    break if cursor == packages_end
                    return false if lock[cursor] != 123 or package_count >= MAX_DEPENDENCIES
                    record_end: usize = Json::object_end(lock, cursor)
                    return false if record_end <= cursor or record_end >= packages_end or not SchemaFields::valid(lock, cursor, record_end, SchemaFields::Kind.RegistryLockRecord)
                    package: mutable darray[u8] = []
                    version_text: mutable darray[u8] = []
                    return false if not Json::object_string_value(lock, cursor, record_end, "name", &package) or not Json::object_string_value(lock, cursor, record_end, "version", &version_text) or not valid_package_name(package)
                    # Canonical registry locks sort package records by name and never
                    # serialize the root package itself. Enforce both properties before
                    # trusting any receipt-backed record in an offline build.
                    return false if ByteText::equal(package, name)
                    return false if has_previous_package and not ByteText::less(previous_package, package)
                    parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                    return false if not SemVer::parse(version_text, &parsed_version) or parsed_version.prerelease
                    return false if emitted_contains_slice(seen, package, 0, package.count)
                    source_start: mutable usize = 0.usize()
                    source_end: mutable usize = 0.usize()
                    return false if not Json::object_value_span(lock, cursor, record_end, "source", &source_start, &source_end) or not SchemaFields::valid(lock, source_start, source_end, SchemaFields::Kind.RegistryLockSource)
                    source_type: mutable darray[u8] = []
                    registry: mutable darray[u8] = []
                    archive: mutable darray[u8] = []
                    return false if not Json::object_string_value(lock, source_start, source_end, "type", &source_type) or not ByteText::equal_text(source_type, "registry") or not Json::object_string_value(lock, source_start, source_end, "registry", &registry) or not ByteText::equal_text(registry, "primary") or not Json::object_string_value(lock, source_start, source_end, "archive", &archive) or not Archive::is_safe_entry(archive)
                    archive_size: mutable u64 = 0
                    return false if not Json::object_unsigned_value(lock, cursor, record_end, "archive-size", &archive_size) or archive_size > Archive::max_archive_bytes.u64()
                    archive_digest: mutable darray[u8] = []
                    metadata_digest: mutable darray[u8] = []
                    return false if not Json::object_string_value(lock, cursor, record_end, "archive-digest", &archive_digest) or not Json::object_string_value(lock, cursor, record_end, "metadata-digest", &metadata_digest) or not Lockfile::valid_sha256_field(archive_digest) or not Lockfile::valid_sha256_field(metadata_digest)
                    for index in 0..<package.count |seen, package|:
                        seen.push(package[index])
                    seen.push(0)
                    previous_package.resize(0)
                    for index in 0..<package.count |previous_package, package|:
                        previous_package.push(package[index])
                    has_previous_package <- true
                    package_count <- package_count + 1.usize()
                    cursor <- record_end + 1.usize()
                    while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                        cursor <- cursor + 1.usize()
                    if cursor < packages_end:
                        return false if lock[cursor] != 44
                        cursor <- cursor + 1.usize()
                return false if package_count == 0.usize()
                # Direct registry requirements are the minimum graph contract that can be
                # checked without loading signed metadata in offline mode. Transitive
                # edges are authenticated by the cached metadata digest when an online
                # fetch revalidates the lock; offline mode must at least reject omission
                # of any dependency named by the manifest itself.
                for index in 0..<registry_roots.count |registry_roots, seen|:
                    return false if not emitted_contains_slice(seen, registry_roots[index].package, 0, registry_roots[index].package.count)
                return Lockfile::registry_satisfies_roots(lock, packages_start, packages_end, registry_roots)

        def run_why(argc: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                return EXIT_USAGE if argc < 3
                wanted: mutable darray[u8] = []
                ByteText::append_bounded_text(&wanted, slots[2].cast[cstr])
                return EXIT_USAGE if not valid_package_name(wanted)
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_RESOLVE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                root_name: mutable darray[u8] = []
                root_version: mutable darray[u8] = []
                return EXIT_RESOLVE if not validate_manifest_at(raw, start, &root_name, &root_version)
                return EXIT_RESOLVE if not ProjectFiles::cstr_file_exists("elisapkg.lock")
                lock: mutable darray[u8] = []
                lock.resize(1048577)
                return EXIT_RESOLVE if not ProjectFiles::read_cstr_into("elisapkg.lock", &lock)
                return EXIT_RESOLVE if not lock_matches_manifest(raw, lock, root_name, root_version, start)
                # `why` reports the root edge. A lockfile also contains transitive
                # records, so merely finding a name in the lock is insufficient and
                # would misreport `root -> transitive` as a direct dependency.
                return EXIT_RESOLVE if ByteText::equal(wanted, root_name)
                dependency_start: mutable usize = 0.usize()
                dependency_end: mutable usize = 0.usize()
                return EXIT_RESOLVE if not Manifest::find_dependency_span(raw, wanted, &dependency_start, &dependency_end)
                return EXIT_RESOLVE if not Lockfile::contains_package(lock, wanted)
                if options.json:
                    CliOutput::write_ok("{\"schema-version\":1,\"root\":\"")
                    CliOutput::write_bytes(1, &root_name)
                    CliOutput::write_ok("\",\"package\":\"")
                    CliOutput::write_bytes(1, &wanted)
                    CliOutput::write_ok("\"}\n")
                    return EXIT_OK
                CliOutput::write_bytes(1, &root_name)
                CliOutput::write_ok(" -> ")
                CliOutput::write_bytes(1, &wanted)
                CliOutput::write_ok("\n")
                return EXIT_OK

        def run_resolve(start: darray[u8]&, options: Model::CommandOptions, transaction_owned: bool, emit_result: bool) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if not project_manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return EXIT_USAGE
                raw: mutable darray[u8] = []
                # Read up to the manifest policy limit. A smaller buffer would silently
                # validate only a prefix of an attacker-controlled document.
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return EXIT_USAGE if not validate_manifest(raw, &name, &version)
                # Keep output identity in owned buffers. The resolver walks and
                # normalizes graph records; preserving these copies prevents an
                # implementation detail of that traversal from emptying the
                # caller's manifest fields before the success envelope is emitted.
                resolved_name: mutable darray[u8] = []
                resolved_version: mutable darray[u8] = []
                for index in 0..<name.count |resolved_name, name|:
                    resolved_name.push(name[index])
                for index in 0..<version.count |resolved_version, version|:
                    resolved_version.push(version[index])
                resolved_name_storage: mutable darray[u8] = []
                resolved_version_storage: mutable darray[u8] = []
                for index in 0..<resolved_name.count |resolved_name_storage, resolved_name|:
                    resolved_name_storage.push(resolved_name[index])
                for index in 0..<resolved_version.count |resolved_version_storage, resolved_version|:
                    resolved_version_storage.push(resolved_version[index])
                resolved_name_storage.push(0)
                resolved_version_storage.push(0)
                resolved_name_text: cstr = (&resolved_name_storage[0]).cast[cstr] can Unsafe.PointerCast
                resolved_version_text: cstr = (&resolved_version_storage[0]).cast[cstr] can Unsafe.PointerCast
                preferred_lock: mutable darray[u8] = []
                lock_state: i64 = Platform::pkg_package_file_size("elisapkg.lock")
                if lock_state >= 0:
                    preferred_lock.resize(1048577)
                    return EXIT_RESOLVE if not ProjectFiles::read_cstr_into("elisapkg.lock", &preferred_lock)
                elif lock_state != -2:
                    # An existing lock that cannot be opened is not equivalent to an
                    # absent lock. Refusing to replace it preserves the operator's ability
                    # to investigate permissions, corruption, or a hostile filesystem.
                    CliOutput::write_error("error: existing elisapkg.lock is unreadable; refusing to replace it\n")
                    return EXIT_RESOLVE
                # Locked and frozen resolution is a read-only contract. Require the lock
                # before consulting any provider so a missing lock cannot trigger metadata
                # refreshes or trust-state writes. Registry v3 locks are checked against
                # the manifest and their local root source digest only; build/fetch owns
                # the later archive and signature verification step. Legacy local locks
                # are recomputed from the local graph, which never invokes a registry.
                if options.locked or options.frozen:
                    return EXIT_RESOLVE if lock_state == -2
                    if Lockfile::version_is(preferred_lock, 3):
                        return EXIT_RESOLVE if not lock_matches_manifest(raw, preferred_lock, name, version, start)
                        write_resolved_text(resolved_name_text, resolved_version_text, options) if emit_result
                        return EXIT_OK
                    registry_roots: mutable darray[Solver::Constraint] = []
                    has_local_dependency: mutable bool = false
                    return EXIT_RESOLVE if not collect_registry_roots(raw, &registry_roots, &has_local_dependency)
                    return EXIT_RESOLVE if registry_roots.count > 0.usize()
                    local_expected: darray[u8] = canonical_transitive_local_lock(name, version, raw, start)
                    return EXIT_RESOLVE if local_expected.count == 0.usize() or not ByteText::equal(local_expected, preferred_lock)
                    write_resolved_text(resolved_name_text, resolved_version_text, options) if emit_result
                    return EXIT_OK
                # Offline resolution may validate and replay an existing lock, but it must
                # never consult a provider or refresh signed metadata. A registry graph
                # without a lock is therefore unavailable offline; local graphs use the
                # same canonical byte comparison as locked mode.
                if options.offline:
                    offline_registry_roots: mutable darray[Solver::Constraint] = []
                    offline_has_local_dependency: mutable bool = false
                    return EXIT_RESOLVE if not collect_registry_roots(raw, &offline_registry_roots, &offline_has_local_dependency)
                    if offline_registry_roots.count > 0.usize():
                        return EXIT_RESOLVE if lock_state == -2
                        return EXIT_RESOLVE if not lock_matches_manifest(raw, preferred_lock, name, version, start)
                        write_resolved_text(resolved_name_text, resolved_version_text, options) if emit_result
                        return EXIT_OK
                lock: darray[u8] = canonical_lock_for_manifest_with_options(name, version, raw, start, options, preferred_lock)
                if lock.count > 0.usize() and lock[0] > 0 and lock[0] < 32:
                    code: mutable Registry::ResultCode = Registry::ResultCode.TrustStateMalformed
                    # The sentinel stores the enum value plus one so an empty lock remains
                    # reserved for ordinary resolution failure.
                    code <- Registry::ResultCode.NotConfigured if lock[0] == 2
                    code <- Registry::ResultCode.InvalidConfiguration if lock[0] == 3
                    code <- Registry::ResultCode.MissingIndex if lock[0] == 4
                    code <- Registry::ResultCode.NoMatchingVersion if lock[0] == 5
                    code <- Registry::ResultCode.MalformedMetadata if lock[0] == 6
                    code <- Registry::ResultCode.MissingSignature if lock[0] == 7
                    code <- Registry::ResultCode.MissingTrustRoot if lock[0] == 8
                    code <- Registry::ResultCode.InvalidSignature if lock[0] == 9
                    code <- Registry::ResultCode.ExpiredMetadata if lock[0] == 10
                    code <- Registry::ResultCode.RollbackDetected if lock[0] == 11
                    code <- Registry::ResultCode.DigestMismatch if lock[0] == 12
                    code <- Registry::ResultCode.ArchiveMissing if lock[0] == 13
                    code <- Registry::ResultCode.ResourceLimit if lock[0] == 14
                    code <- Registry::ResultCode.TrustStateUnavailable if lock[0] == 15
                    code <- Registry::ResultCode.TrustStateMalformed if lock[0] == 16
                    code <- Registry::ResultCode.ClockRollback if lock[0] == 17
                    code <- Registry::ResultCode.Unsatisfiable if lock[0] == 18
                    code <- Registry::ResultCode.ClockUnavailable if lock[0] == 19
                    code <- Registry::ResultCode.ExpiryHorizon if lock[0] == 20
                    code <- Registry::ResultCode.TrustRootChanged if lock[0] == 21
                    code <- Registry::ResultCode.TufEquivocationDetected if lock[0] == 22
                    CliOutput::write_error("error: ")
                    CliOutput::write_error(Registry::result_message(code))
                    if code == Registry::ResultCode.Unsatisfiable:
                        write_registry_conflict(lock)
                        CliOutput::write_error("\n")
                        return EXIT_RESOLVE
                    if code == Registry::ResultCode.TrustStateUnavailable or code == Registry::ResultCode.TrustStateMalformed or code == Registry::ResultCode.ClockRollback:
                        CliOutput::write_error(" while recording registry trust state\n")
                    else:
                        CliOutput::write_error("\n")
                    return EXIT_SECURITY

                return EXIT_RESOLVE if lock.count == 0.usize()
                if options.locked or options.frozen:
                    return EXIT_RESOLVE if not ProjectFiles::cstr_file_exists("elisapkg.lock")
                    existing: mutable darray[u8] = []
                    existing.resize(1048577)
                    return EXIT_RESOLVE if not ProjectFiles::read_cstr_into("elisapkg.lock", &existing)
                    return EXIT_RESOLVE if not ByteText::equal(existing, lock)
                if not (options.locked or options.frozen):
                    if not transaction_owned:
                        if not ProjectTransaction::begin_with_lock(raw, lock_state, preferred_lock):
                            CliOutput::write_error("error: could not claim the package transaction; another edit may be active or the manifest or lockfile may have changed\n")
                            return EXIT_SECURITY
                    # Record the exact replacement before publishing it. Recovery
                    # can then distinguish our new lock from an unrelated edit if
                    # the process stops between these two writes.
                    if not ProjectFiles::write_cstr_file(".elisapkg/transaction.new-lock", &lock):
                        if not transaction_owned:
                            _ = ProjectTransaction::restore()
                        return EXIT_SECURITY
                    if not ProjectFiles::write_cstr_file("elisapkg.lock", &lock):
                        if not transaction_owned:
                            _ = ProjectTransaction::restore()
                        return EXIT_RESOLVE
                    if not transaction_owned:
                        if not ProjectTransaction::mark_lock():
                            _ = ProjectTransaction::restore()
                            return EXIT_SECURITY
                        return EXIT_SECURITY if not ProjectTransaction::commit()
                write_resolved_text(resolved_name_text, resolved_version_text, options) if emit_result
                return EXIT_OK

        def run_tree(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if not project_manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return EXIT_RESOLVE
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_RESOLVE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return EXIT_RESOLVE if not validate_manifest(raw, &name, &version)
                return EXIT_RESOLVE if not ProjectFiles::cstr_file_exists("elisapkg.lock")
                lock: mutable darray[u8] = []
                lock.resize(1048577)
                return EXIT_RESOLVE if not ProjectFiles::read_cstr_into("elisapkg.lock", &lock)
                return EXIT_RESOLVE if not lock_matches_manifest(raw, lock, name, version, start)
                if options.json:
                    return EXIT_OK if print_lock_packages_json(lock)
                    return EXIT_RESOLVE
                return EXIT_RESOLVE if not print_lock_packages(lock)
                return EXIT_OK

        def run_metadata(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if not project_manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return EXIT_USAGE
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return EXIT_USAGE if not validate_manifest(raw, &name, &version)
                return EXIT_USAGE if not options.json
                CliOutput::write_ok("{\"schema-version\":1,\"package\":{\"name\":\"")
                CliOutput::write_bytes(1, &name)
                CliOutput::write_ok("\",\"version\":\"")
                CliOutput::write_bytes(1, &version)
                CliOutput::write_ok("\"}}\n")
                return EXIT_OK

        def run_doctor() -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok("elisapkg doctor\n")
                CliOutput::write_ok("manifest: JSON schema v1\n")
                CliOutput::write_ok("resolver: deterministic local v1\n")
                CliOutput::write_ok("source integrity: local file verification\n")
                CliOutput::write_ok("metadata signatures: Ed25519 verification requires a fixed trusted local OpenSSL candidate; checked during verification; network transport disabled\n")
                if Sandbox::build_sandbox_available():
                    CliOutput::write_ok("build sandbox: sandbox-exec is present; compiler builds apply a deny-default profile and fail closed if it is rejected\n")
                else:
                    CliOutput::write_ok("build sandbox: sandbox-exec is unavailable; builds fail closed on this platform\n")
                CliOutput::write_ok("child environment: scrubbed; only compiler bootstrap variables are retained\n")
                CliOutput::write_ok("compiler: set ELISAPKG_COMPILER to an audited compiler adapter\n")
                return EXIT_OK

        def run_test(argc: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                selected_name: mutable darray[u8] = []
                selected_kind: mutable darray[u8] = []
                selected_entry: mutable darray[u8] = []
                return EXIT_USAGE if not ManifestTargets::select_target(raw, options.target_name, options.target_kind, &selected_name, &selected_kind, &selected_entry) or not ByteText::equal_text(selected_kind, "test")
                # Reusing the normal build path keeps dependency, lock, and compiler-
                # environment checks identical while multi-target planning is completed.
                status: i64 = run_build(start, options)
                return status if status != EXIT_OK
                return run_program(argc, slots, options, "test")

        def registry_cache_store_metadata(metadata_digest: darray[u8]&, metadata: darray[u8]&, signature: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return false if metadata.count == 0.usize() or metadata.count > Json::max_document_bytes or signature.count != 64.usize()
            return false if not cache_store_verified_bytes(metadata_digest, metadata)
            signature_path: mutable darray[u8] = []
            return false if not Cache::registry_signature_path(metadata_digest, &signature_path)
            signature_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&signature_path, &signature_c)
            signature_name: cstr = (&signature_c[0]).cast[cstr] can Unsafe.PointerCast
            if not ProjectFiles::cstr_file_exists(signature_name):
                status: i64 = write_cstr_file_noclobber_status(signature_name, signature)
                # A concurrent publication is acceptable only if the final
                # detached signature is the same one we intended to store.
                return false if status != 0 and status != -17
            existing: mutable darray[u8] = []
            return false if not Cache::read_registry_signature(metadata_digest, &existing)
            return ByteText::equal(existing, signature)

        def registry_cache_read_metadata(metadata_digest: darray[u8]&, metadata_out: mutable darray[u8]&, signature_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            metadata_out.resize(0)
            signature_out.resize(0)
            metadata: mutable darray[u8] = []
            return false if not Cache::read_verified_blob(metadata_digest, Json::max_document_bytes, &metadata)
            signature: mutable darray[u8] = []
            return false if not Cache::read_registry_signature(metadata_digest, &signature)
            for index in 0..<metadata.count |metadata_out, metadata|:
                metadata_out.push(metadata[index])
            for index in 0..<signature.count |signature_out, signature|:
                signature_out.push(signature[index])
            return true

        def registry_cache_store_receipt(package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, archive_size: u64, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            path: mutable darray[u8] = []
            return false if not Cache::registry_receipt_path(digest, metadata_digest, &path)
            parent: mutable darray[u8] = []
            return false if not Cache::shard_path(digest, &parent)
            return false if not ProjectFiles::make_directory(&parent)
            receipt: darray[u8] = Cache::encode_registry_receipt(package, version, archive, archive_size, digest, metadata_digest, expires)
            return false if receipt.count == 0.usize()
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            if not ProjectFiles::cstr_file_exists(path_name):
                publication_status: i64 = write_cstr_file_noclobber_status(path_name, receipt)
                return false if publication_status != 0 and publication_status != -17
            existing: mutable darray[u8] = []
            return Cache::read_registry_receipt(digest, metadata_digest, &existing) and ByteText::equal(existing, receipt)

        def registry_offline_graph_closure(manifest: darray[u8]&, lock: darray[u8]&, starts: darray[usize]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            roots: mutable darray[Solver::Constraint] = []
            has_local: mutable bool = false
            return EXIT_RESOLVE if not collect_registry_roots(manifest, &roots, &has_local) or has_local or roots.count == 0.usize()
            queued: mutable darray[bool] = []
            queued.resize(starts.count)
            pending: mutable darray[usize] = []
            for index in 0..<roots.count |lock, starts, roots, queued, pending|:
                matched_record: i64 = Lockfile::matching_registry_record(lock, starts, roots[index])
                return EXIT_SECURITY if matched_record < 0
                record_index: usize = matched_record.usize()
                if not queued[record_index]:
                    queued[record_index] <- true
                    pending.push(record_index)
            processed: mutable usize = 0.usize()
            while processed < pending.count:
                record_start: usize = starts[pending[processed]]
                record_end: usize = Json::object_end(lock, record_start)
                package: mutable darray[u8] = []
                version_text: mutable darray[u8] = []
                return EXIT_SECURITY if not Json::object_string_value(lock, record_start, record_end, "name", &package) or not Json::object_string_value(lock, record_start, record_end, "version", &version_text)
                source_start: mutable usize = 0.usize()
                source_end: mutable usize = 0.usize()
                return EXIT_SECURITY if not Json::object_value_span(lock, record_start, record_end, "source", &source_start, &source_end)
                archive: mutable darray[u8] = []
                encoded_digest: mutable darray[u8] = []
                encoded_metadata_digest: mutable darray[u8] = []
                digest: mutable darray[u8] = []
                metadata_digest: mutable darray[u8] = []
                return EXIT_SECURITY if not Json::object_string_value(lock, source_start, source_end, "archive", &archive) or not Json::object_string_value(lock, record_start, record_end, "archive-digest", &encoded_digest) or not Json::object_string_value(lock, record_start, record_end, "metadata-digest", &encoded_metadata_digest)
                return EXIT_SECURITY if not Lockfile::valid_sha256_field(encoded_digest) or not Lockfile::valid_sha256_field(encoded_metadata_digest)
                for digest_index in 0..<64.usize() |encoded_digest, encoded_metadata_digest, digest, metadata_digest|:
                    digest.push(encoded_digest[7.usize() + digest_index])
                    metadata_digest.push(encoded_metadata_digest[7.usize() + digest_index])
                archive_size: mutable u64 = 0
                return EXIT_SECURITY if not Json::object_unsigned_value(lock, record_start, record_end, "archive-size", &archive_size)
                cached_metadata: mutable darray[u8] = []
                cached_signature: mutable darray[u8] = []
                return EXIT_SECURITY if not registry_cache_read_metadata(metadata_digest, &cached_metadata, &cached_signature)
                resolved_archive: mutable darray[u8] = []
                resolved_digest: mutable darray[u8] = []
                resolved_size: mutable u64 = 0
                expires: mutable u64 = 0
                dependencies: mutable darray[Solver::Constraint] = []
                status: Registry::ResultCode = Registry::verify_metadata_snapshot(package, version_text, metadata_digest, cached_metadata, cached_signature, &resolved_archive, &resolved_digest, &resolved_size, &expires, &dependencies)
                return EXIT_SECURITY if status != Registry::ResultCode.Ok or not ByteText::equal(resolved_archive, archive) or not ByteText::equal(resolved_digest, digest) or resolved_size != archive_size
                for dependency_index in 0..<dependencies.count |lock, starts, dependencies, queued, pending|:
                    matched_record: i64 = Lockfile::matching_registry_record(lock, starts, dependencies[dependency_index])
                    return EXIT_SECURITY if matched_record < 0
                    record_index: usize = matched_record.usize()
                    if not queued[record_index]:
                        queued[record_index] <- true
                        pending.push(record_index)
                processed <- processed + 1.usize()
            # Only distinct authenticated records enter the queue.
            return EXIT_RESOLVE if starts.count != pending.count
            return EXIT_OK

        def fetch_registry_lock_offline(manifest: darray[u8]&, lock: darray[u8]&, root_name: darray[u8]&, root_version: darray[u8]&, start: darray[u8]&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                return EXIT_RESOLVE if not lock_matches_manifest(manifest, lock, root_name, root_version, start)
                packages_start: usize = Json::root_value_offset(lock, "packages")
                packages_end: usize = Json::array_end(lock, packages_start)
                return EXIT_RESOLVE if packages_start >= lock.count or packages_end <= packages_start
                starts: mutable darray[usize] = []
                return EXIT_RESOLVE if not Lockfile::registry_record_starts(lock, packages_start, packages_end, &starts)
                closure_status: i64 = registry_offline_graph_closure(manifest, lock, starts)
                if closure_status != EXIT_OK:
                    CliOutput::write_error("error: offline registry lock does not match its signed dependency graph\n") if closure_status == EXIT_RESOLVE
                    return closure_status
                cursor: mutable usize = packages_start + 1.usize()
                fetched: mutable usize = 0.usize()
                now: i64 = Platform::pkg_wall_clock_seconds()
                return EXIT_SECURITY if now < 0
                while cursor < packages_end:
                    while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                        cursor <- cursor + 1.usize()
                    break if cursor == packages_end
                    return EXIT_RESOLVE if lock[cursor] != 123
                    record_end: usize = Json::object_end(lock, cursor)
                    return EXIT_RESOLVE if record_end <= cursor or record_end >= packages_end or not SchemaFields::valid(lock, cursor, record_end, SchemaFields::Kind.RegistryLockRecord)
                    package: mutable darray[u8] = []
                    version_text: mutable darray[u8] = []
                    return EXIT_RESOLVE if not Json::object_string_value(lock, cursor, record_end, "name", &package) or not Json::object_string_value(lock, cursor, record_end, "version", &version_text) or not valid_package_name(package)
                    parsed_version: mutable Model::Version = Model::Version{major: 0,minor: 0,patch: 0,prerelease:false}
                    return EXIT_RESOLVE if not SemVer::parse(version_text, &parsed_version) or parsed_version.prerelease
                    source_start: mutable usize = 0.usize()
                    source_end: mutable usize = 0.usize()
                    return EXIT_RESOLVE if not Json::object_value_span(lock, cursor, record_end, "source", &source_start, &source_end) or not SchemaFields::valid(lock, source_start, source_end, SchemaFields::Kind.RegistryLockSource)
                    source_type: mutable darray[u8] = []
                    registry: mutable darray[u8] = []
                    archive: mutable darray[u8] = []
                    return EXIT_RESOLVE if not Json::object_string_value(lock, source_start, source_end, "type", &source_type) or not ByteText::equal_text(source_type, "registry") or not Json::object_string_value(lock, source_start, source_end, "registry", &registry) or not ByteText::equal_text(registry, "primary") or not Json::object_string_value(lock, source_start, source_end, "archive", &archive) or not Archive::is_safe_entry(archive)
                    encoded_digest: mutable darray[u8] = []
                    encoded_metadata_digest: mutable darray[u8] = []
                    digest: mutable darray[u8] = []
                    metadata_digest: mutable darray[u8] = []
                    return EXIT_RESOLVE if not Json::object_string_value(lock, cursor, record_end, "archive-digest", &encoded_digest) or not Json::object_string_value(lock, cursor, record_end, "metadata-digest", &encoded_metadata_digest) or not Lockfile::valid_sha256_field(encoded_digest) or not Lockfile::valid_sha256_field(encoded_metadata_digest)
                    for index in 0..<64.usize() |encoded_digest, encoded_metadata_digest, digest, metadata_digest|:
                        digest.push(encoded_digest[7.usize() + index])
                        metadata_digest.push(encoded_metadata_digest[7.usize() + index])
                    archive_size: mutable u64 = 0
                    return EXIT_RESOLVE if not Json::object_unsigned_value(lock, cursor, record_end, "archive-size", &archive_size) or archive_size > Archive::max_archive_bytes.u64()
                    receipt: mutable darray[u8] = []
                    return EXIT_SECURITY if not Cache::read_registry_receipt(digest, metadata_digest, &receipt)
                    expires: mutable u64 = 0
                    return EXIT_SECURITY if not Cache::registry_receipt_matches(receipt, package, version_text, archive, archive_size, digest, metadata_digest, &expires)
                    return EXIT_SECURITY if expires <= now.u64()
                    cached_metadata: mutable darray[u8] = []
                    cached_signature: mutable darray[u8] = []
                    return EXIT_SECURITY if not registry_cache_read_metadata(metadata_digest, &cached_metadata, &cached_signature)
                    resolved_archive: mutable darray[u8] = []
                    resolved_digest: mutable darray[u8] = []
                    resolved_size: mutable u64 = 0
                    metadata_expires: mutable u64 = 0
                    metadata_dependencies: mutable darray[Solver::Constraint] = []
                    metadata_status: Registry::ResultCode = Registry::verify_metadata_snapshot(package, version_text, metadata_digest, cached_metadata, cached_signature, &resolved_archive, &resolved_digest, &resolved_size, &metadata_expires, &metadata_dependencies)
                    return EXIT_SECURITY if metadata_status != Registry::ResultCode.Ok or not ByteText::equal(resolved_archive, archive) or not ByteText::equal(resolved_digest, digest) or resolved_size != archive_size or metadata_expires != expires
                    for dependency_index in 0..<metadata_dependencies.count |lock, starts, metadata_dependencies, dependency_index|:
                        return EXIT_SECURITY if Lockfile::matching_registry_record(lock, starts, metadata_dependencies[dependency_index]) < 0
                    archive_bytes: mutable darray[u8] = []
                    return EXIT_SECURITY if not Cache::read_verified_blob(digest, archive_size.usize(), &archive_bytes) or archive_bytes.count.u64() != archive_size or not Registry::release_archive_matches_metadata(package, version_text, cached_metadata, archive_bytes)
                    # Only authenticated cache content may advance the durable
                    # trust clock. Do this after snapshot, dependency, expiry, and
                    # archive validation so rejected cache data cannot update it.
                    trust_status: Registry::ResultCode = Registry::verify_trusted(package, version_text, digest, metadata_digest, metadata_expires)
                    if trust_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(trust_status))
                        CliOutput::write_error(" while using cached ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return EXIT_SECURITY
                    CliOutput::write_ok("verified cached registry artifact ")
                    CliOutput::write_bytes(1, &package)
                    CliOutput::write_ok(" ")
                    CliOutput::write_bytes(1, &version_text)
                    CliOutput::write_ok(" sha256:")
                    CliOutput::write_bytes(1, &digest)
                    CliOutput::write_ok(" (offline)\n")
                    fetched <- fetched + 1.usize()
                    return EXIT_RESOLVE if fetched > 4096.usize()
                    cursor <- record_end + 1.usize()
                    while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                        cursor <- cursor + 1.usize()
                    if cursor < packages_end:
                        return EXIT_RESOLVE if lock[cursor] != 44
                        cursor <- cursor + 1.usize()
                return EXIT_OK

        def fetch_registry_lock(manifest: darray[u8]&, lock: darray[u8]&, root_name: darray[u8]&, root_version: darray[u8]&, start: darray[u8]&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                return EXIT_RESOLVE if not Json::valid_document(lock) or not Json::unique_object_keys(lock) or not Lockfile::version_is(lock, 3)
                # A lockfile is a graph contract, not merely a list of independently
                # authenticated archives. Recompute the canonical graph from the signed
                # registry metadata and compare bytes before any cache mutation. This
                # rejects duplicate, omitted, reordered, or otherwise hand-edited records
                # that could make fetch operate on a graph different from resolution.
                expected_lock: darray[u8] = canonical_registry_lock_for_existing_lock(root_name, root_version, manifest, start, lock)
                return EXIT_SECURITY if expected_lock.count == 0.usize()
                return EXIT_RESOLVE if not ByteText::equal(expected_lock, lock)
                lock_end: usize = Json::object_end(lock, 0)
                return EXIT_RESOLVE if lock_end >= lock.count or not SchemaFields::valid(lock, 0, lock_end, SchemaFields::Kind.RegistryLock)
                resolver: mutable darray[u8] = []
                return EXIT_RESOLVE if not Json::object_string_value(lock, 0, Json::object_end(lock, 0), "resolver", &resolver) or not ByteText::equal_text(resolver, "elisapkg-registry-v1")
                package_start: usize = Json::root_value_offset(lock, "package")
                package_end: usize = Json::object_end(lock, package_start)
                return EXIT_RESOLVE if package_start >= lock.count or package_end <= package_start
                return EXIT_RESOLVE if not SchemaFields::valid(lock, package_start, package_end, SchemaFields::Kind.RegistryLockPackage)
                locked_name: mutable darray[u8] = []
                locked_version: mutable darray[u8] = []
                return EXIT_RESOLVE if not Json::object_string_value(lock, package_start, package_end, "name", &locked_name) or not Json::object_string_value(lock, package_start, package_end, "version", &locked_version)
                return EXIT_RESOLVE if not ByteText::equal(locked_name, root_name) or not ByteText::equal(locked_version, root_version)
                manifest_digest_bytes: mutable darray[u8] = []
                manifest_digest: mutable darray[u8] = []
                return EXIT_SECURITY if Integrity::sha256(manifest, &manifest_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
                return EXIT_RESOLVE if not Lockfile::sha256_field_equals(lock, package_start, package_end, "manifest-digest", manifest_digest)
                packages_start: usize = Json::root_value_offset(lock, "packages")
                packages_end: usize = Json::array_end(lock, packages_start)
                return EXIT_RESOLVE if packages_start >= lock.count or packages_end <= packages_start
                cursor: mutable usize = packages_start + 1.usize()
                fetched: mutable usize = 0.usize()
                while cursor < packages_end:
                    while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                        cursor <- cursor + 1.usize()
                    break if cursor == packages_end
                    return EXIT_RESOLVE if lock[cursor] != 123
                    record_end: usize = Json::object_end(lock, cursor)
                    return EXIT_RESOLVE if record_end <= cursor or record_end >= packages_end
                    return EXIT_RESOLVE if not SchemaFields::valid(lock, cursor, record_end, SchemaFields::Kind.RegistryLockRecord)
                    package: mutable darray[u8] = []
                    version_text: mutable darray[u8] = []
                    return EXIT_RESOLVE if not Json::object_string_value(lock, cursor, record_end, "name", &package) or not Json::object_string_value(lock, cursor, record_end, "version", &version_text) or not valid_package_name(package)
                    parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                    return EXIT_RESOLVE if not SemVer::parse(version_text, &parsed_version) or parsed_version.prerelease
                    source_start: mutable usize = 0.usize()
                    source_end: mutable usize = 0.usize()
                    return EXIT_RESOLVE if not Json::object_value_span(lock, cursor, record_end, "source", &source_start, &source_end)
                    return EXIT_RESOLVE if not SchemaFields::valid(lock, source_start, source_end, SchemaFields::Kind.RegistryLockSource)
                    source_type: mutable darray[u8] = []
                    registry: mutable darray[u8] = []
                    archive: mutable darray[u8] = []
                    return EXIT_RESOLVE if not Json::object_string_value(lock, source_start, source_end, "type", &source_type) or not ByteText::equal_text(source_type, "registry") or not Json::object_string_value(lock, source_start, source_end, "registry", &registry) or not ByteText::equal_text(registry, "primary") or not Json::object_string_value(lock, source_start, source_end, "archive", &archive) or not Archive::is_safe_entry(archive)
                    encoded_digest: mutable darray[u8] = []
                    encoded_metadata_digest: mutable darray[u8] = []
                    digest: mutable darray[u8] = []
                    metadata_digest: mutable darray[u8] = []
                    return EXIT_RESOLVE if not Json::object_string_value(lock, cursor, record_end, "archive-digest", &encoded_digest) or not Json::object_string_value(lock, cursor, record_end, "metadata-digest", &encoded_metadata_digest)
                    return EXIT_RESOLVE if encoded_digest.count != 71.usize() or encoded_metadata_digest.count != 71.usize()
                    return EXIT_RESOLVE if encoded_digest[0] != 115 or encoded_digest[1] != 104 or encoded_digest[2] != 97 or encoded_digest[3] != 50 or encoded_digest[4] != 53 or encoded_digest[5] != 54 or encoded_digest[6] != 58 or encoded_metadata_digest[0] != 115 or encoded_metadata_digest[1] != 104 or encoded_metadata_digest[2] != 97 or encoded_metadata_digest[3] != 50 or encoded_metadata_digest[4] != 53 or encoded_metadata_digest[5] != 54 or encoded_metadata_digest[6] != 58
                    for digest_index in 0..<64.usize() |encoded_digest, encoded_metadata_digest, digest, metadata_digest|:
                        digest.push(encoded_digest[7.usize() + digest_index])
                        metadata_digest.push(encoded_metadata_digest[7.usize() + digest_index])
                    archive_size: mutable u64 = 0
                    return EXIT_RESOLVE if not Json::object_unsigned_value(lock, cursor, record_end, "archive-size", &archive_size)
                    exact: mutable darray[u8] = []
                    Registry::exact_requirement(parsed_version, &exact)
                    selected: mutable darray[u8] = []
                    resolved_archive: mutable darray[u8] = []
                    resolved_digest: mutable darray[u8] = []
                    metadata: mutable darray[u8] = []
                    resolved_size: mutable u64 = 0
                    selected_index_generation: mutable u64 = 0
                    selected_index_digest: mutable darray[u8] = []
                    selected_index_identity: mutable darray[u8] = []
                    registry_status: Registry::ResultCode = Registry::resolve_with_index_evidence(package, exact, Model::Version{major:0,minor:0,patch:0,prerelease:false}, &selected, &resolved_archive, &resolved_digest, &resolved_size, &metadata, &selected_index_generation, &selected_index_digest, &selected_index_identity)
                    if registry_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(registry_status))
                        CliOutput::write_error(" while verifying locked ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return EXIT_SECURITY if registry_security_status(registry_status)
                        return EXIT_SOURCE
                    if not ByteText::equal(selected, version_text):
                        CliOutput::write_error("error: locked registry version does not match signed metadata\n")
                        return EXIT_SECURITY
                    if not ByteText::equal(resolved_archive, archive):
                        CliOutput::write_error("error: locked registry archive name does not match signed metadata\n")
                        return EXIT_SECURITY
                    if not ByteText::equal(resolved_digest, digest):
                        CliOutput::write_error("error: locked registry archive digest does not match signed metadata\n")
                        return EXIT_SECURITY
                    if resolved_size != archive_size:
                        CliOutput::write_error("error: locked registry archive size does not match signed metadata\n")
                        return EXIT_SECURITY
                    metadata_digest_bytes: mutable darray[u8] = []
                    computed_metadata_digest: mutable darray[u8] = []
                    if Integrity::sha256(metadata, &metadata_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(metadata_digest_bytes, &computed_metadata_digest) or not ByteText::equal(computed_metadata_digest, metadata_digest):
                        CliOutput::write_error("error: locked metadata digest does not match signed metadata\n")
                        return EXIT_SECURITY
                    metadata_expires: mutable u64 = 0
                    return EXIT_SECURITY if not Json::object_unsigned_value(metadata, 0, Json::object_end(metadata, 0), "expires", &metadata_expires)
                    metadata_signature: mutable darray[u8] = []
                    signature_status: Registry::ResultCode = Registry::read_signature(package, selected, &metadata_signature)
                    return EXIT_SECURITY if signature_status != Registry::ResultCode.Ok
                    snapshot_archive: mutable darray[u8] = []
                    snapshot_digest: mutable darray[u8] = []
                    snapshot_size: mutable u64 = 0
                    snapshot_expires: mutable u64 = 0
                    snapshot_dependencies: mutable darray[Solver::Constraint] = []
                    snapshot_status: Registry::ResultCode = Registry::verify_metadata_snapshot(package, selected, metadata_digest, metadata, metadata_signature, &snapshot_archive, &snapshot_digest, &snapshot_size, &snapshot_expires, &snapshot_dependencies)
                    return EXIT_SECURITY if snapshot_status != Registry::ResultCode.Ok or snapshot_expires != metadata_expires or not registry_cache_store_metadata(metadata_digest, metadata, metadata_signature)
                    archive_bytes: mutable darray[u8] = []
                    archive_status: Registry::ResultCode = Registry::read_archive(package, version_text, metadata, archive, digest, archive_size, &archive_bytes)
                    if archive_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(archive_status))
                        CliOutput::write_error(" for locked ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return EXIT_SECURITY if registry_security_status(archive_status)
                        return EXIT_SOURCE
                    trust_status: Registry::ResultCode = Registry::record_trusted_at_index(package, version_text, digest, metadata_digest, snapshot_expires, selected_index_generation, selected_index_digest, selected_index_identity)
                    if trust_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(trust_status))
                        CliOutput::write_error(" while recording locked ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return EXIT_SECURITY
                    return EXIT_SOURCE if not cache_store_verified_blob(digest, archive_bytes)
                    return EXIT_SECURITY if not registry_cache_store_receipt(package, version_text, archive, archive_size, digest, metadata_digest, metadata_expires)
                    CliOutput::write_ok("verified locked registry artifact ")
                    CliOutput::write_bytes(1, &package)
                    CliOutput::write_ok(" ")
                    CliOutput::write_bytes(1, &version_text)
                    CliOutput::write_ok(" sha256:")
                    CliOutput::write_bytes(1, &digest)
                    CliOutput::write_ok(" (cached)\n")
                    fetched <- fetched + 1.usize()
                    return EXIT_RESOLVE if fetched > 4096.usize()
                    cursor <- record_end + 1.usize()
                    while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                        cursor <- cursor + 1.usize()
                    if cursor < packages_end:
                        return EXIT_RESOLVE if lock[cursor] != 44
                        cursor <- cursor + 1.usize()
                return EXIT_OK

        def run_fetch(argc: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                positional_count: mutable i64 = 0
                package: mutable darray[u8] = []
                requirement: mutable darray[u8] = []
                index: mutable i64 = 2
                while index < argc:
                    argument: cstr = slots[index].cast[cstr]
                    if Platform::pkg_cstr_equal(argument, "--"):
                        index <- index + 1
                        return EXIT_USAGE if index < argc
                        break
                    if Platform::pkg_strlen(argument) == 0.usize():
                        CliOutput::write_error("error: fetch does not accept empty arguments\n")
                        return EXIT_USAGE
                    if argument[0].u8() == 45:
                        CliOutput::write_error("error: fetch does not accept command-specific options\n")
                        return EXIT_USAGE
                    if positional_count == 0:
                        ByteText::append_bounded_text(&package, argument)
                    elif positional_count == 1:
                        ByteText::append_bounded_text(&requirement, argument)
                    else:
                        CliOutput::write_error("error: fetch accepts at most PACKAGE REQUIREMENT\n")
                        return EXIT_USAGE
                    positional_count <- positional_count + 1
                    index <- index + 1
                if positional_count > 0:
                    return EXIT_USAGE if positional_count != 2
                    if options.offline or options.frozen:
                        CliOutput::write_error("error: offline fetch requires an existing lockfile; package-specific registry fetch is unavailable\n")
                        return EXIT_RESOLVE
                    if requirement.count == 0:
                        CliOutput::write_error("error: fetch PACKAGE requires an exact SemVer requirement\n")
                        return EXIT_USAGE
                    exact_version: mutable Model::Version = Model::Version{major: 0,minor: 0,patch: 0,prerelease: false}
                    return EXIT_USAGE if not SemVer::parse(requirement, &exact_version) or exact_version.prerelease
                    selected: mutable darray[u8] = []
                    archive: mutable darray[u8] = []
                    digest: mutable darray[u8] = []
                    metadata: mutable darray[u8] = []
                    archive_size: mutable u64 = 0
                    previous_version: Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                    selected_index_generation: mutable u64 = 0
                    selected_index_digest: mutable darray[u8] = []
                    selected_index_identity: mutable darray[u8] = []
                    registry_status: Registry::ResultCode = Registry::resolve_with_index_evidence(package, requirement, previous_version, &selected, &archive, &digest, &archive_size, &metadata, &selected_index_generation, &selected_index_digest, &selected_index_identity)
                    if registry_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(registry_status))
                        CliOutput::write_error("\n")
                        return EXIT_SECURITY if registry_security_status(registry_status)
                        return EXIT_RESOLVE
                    metadata_digest_bytes: mutable darray[u8] = []
                    metadata_digest: mutable darray[u8] = []
                    metadata_expires: mutable u64 = 0
                    return EXIT_SECURITY if Integrity::sha256(metadata, &metadata_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(metadata_digest_bytes, &metadata_digest) or not Json::object_unsigned_value(metadata, 0, Json::object_end(metadata, 0), "expires", &metadata_expires)
                    metadata_signature: mutable darray[u8] = []
                    signature_status: Registry::ResultCode = Registry::read_signature(package, selected, &metadata_signature)
                    return EXIT_SECURITY if signature_status != Registry::ResultCode.Ok
                    snapshot_archive: mutable darray[u8] = []
                    snapshot_digest: mutable darray[u8] = []
                    snapshot_size: mutable u64 = 0
                    snapshot_expires: mutable u64 = 0
                    snapshot_dependencies: mutable darray[Solver::Constraint] = []
                    snapshot_status: Registry::ResultCode = Registry::verify_metadata_snapshot(package, selected, metadata_digest, metadata, metadata_signature, &snapshot_archive, &snapshot_digest, &snapshot_size, &snapshot_expires, &snapshot_dependencies)
                    return EXIT_SECURITY if snapshot_status != Registry::ResultCode.Ok or snapshot_expires != metadata_expires or not ByteText::equal(snapshot_archive, archive) or not ByteText::equal(snapshot_digest, digest) or snapshot_size != archive_size
                    return EXIT_SECURITY if not registry_cache_store_metadata(metadata_digest, metadata, metadata_signature)
                    archive_bytes: mutable darray[u8] = []
                    archive_status: Registry::ResultCode = Registry::read_archive(package, selected, metadata, archive, digest, archive_size, &archive_bytes)
                    if archive_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(archive_status))
                        CliOutput::write_error("\n")
                        return EXIT_SECURITY if registry_security_status(archive_status)
                        return EXIT_SOURCE
                    trust_status: Registry::ResultCode = Registry::record_trusted_at_index(package, selected, digest, metadata_digest, snapshot_expires, selected_index_generation, selected_index_digest, selected_index_identity)
                    if trust_status != Registry::ResultCode.Ok:
                        CliOutput::write_error("error: ")
                        CliOutput::write_error(Registry::result_message(trust_status))
                        CliOutput::write_error(" while recording ")
                        CliOutput::write_bytes(2, &package)
                        CliOutput::write_error("\n")
                        return EXIT_SECURITY
                    return EXIT_SOURCE if not cache_store_verified_blob(digest, archive_bytes)
                    return EXIT_SECURITY if not registry_cache_store_receipt(package, selected, archive, archive_size, digest, metadata_digest, metadata_expires)
                    CliOutput::write_ok("verified registry artifact ")
                    CliOutput::write_bytes(1, &package)
                    CliOutput::write_ok(" ")
                    CliOutput::write_bytes(1, &selected)
                    CliOutput::write_ok(" sha256:")
                    CliOutput::write_bytes(1, &digest)
                    CliOutput::write_ok(" (cached)\n")
                    _ = start
                    _ = options
                    return EXIT_OK
                _ = options
                if not project_manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return EXIT_USAGE
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return EXIT_RESOLVE if not validate_manifest_at(raw, start, &name, &version)
                lock: mutable darray[u8] = []
                lock.resize(1048577)
                return EXIT_RESOLVE if not ProjectFiles::read_cstr_into("elisapkg.lock", &lock)
                if Lockfile::version_is(lock, 3):
                    return fetch_registry_lock_offline(raw, lock, name, version, start) if options.offline or options.frozen else fetch_registry_lock(raw, lock, name, version, start)
                expected: darray[u8] = canonical_lock_for_manifest(name, version, raw, start)
                return EXIT_RESOLVE if expected.count == 0.usize() or not ByteText::equal(expected, lock)
                CliOutput::write_ok("verified local locked sources\n")
                return EXIT_OK

        def run_publish_dry_run(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                # Validate the exact local release inputs without writing an archive
                # or contacting a registry. Publication itself remains trust-gated,
                # but callers still need a useful preflight command.
                if not project_manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return EXIT_USAGE
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                package_name: mutable darray[u8] = []
                package_version: mutable darray[u8] = []
                return EXIT_RESOLVE if not validate_manifest_at(raw, start, &package_name, &package_version)
                lock_options: Model::CommandOptions = Model::CommandOptions{locked: true, offline: true, frozen: true, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                return EXIT_RESOLVE if run_resolve(start, lock_options, false, false) != EXIT_OK
                lock: mutable darray[u8] = []
                lock.resize(1048577)
                return EXIT_SECURITY if not ProjectFiles::read_cstr_into("elisapkg.lock", &lock)
                return EXIT_SECURITY if not lock_matches_manifest(raw, lock, package_name, package_version, start)
                source_digest: mutable darray[u8] = []
                return EXIT_SECURITY if not SourceFingerprint::current(&source_digest)
                entry: mutable darray[u8] = []
                return EXIT_USAGE if not ManifestTargets::default_entry(raw, &entry)
                paths: mutable darray[u8] = []
                return EXIT_USAGE if not collect_package_paths(raw, entry, &paths)
                archive: mutable darray[u8] = []
                return EXIT_SECURITY if not package_archive_bytes(raw, entry, &archive) or not Archive::verify_ustar_archive(archive)
                archive_repeat: mutable darray[u8] = []
                return EXIT_SECURITY if not package_archive_bytes(raw, entry, &archive_repeat) or not Archive::verify_ustar_archive(archive_repeat) or not ByteText::equal(archive_repeat, archive)
                source_digest_after: mutable darray[u8] = []
                return EXIT_SECURITY if not SourceFingerprint::current(&source_digest_after) or not ByteText::equal(source_digest_after, source_digest)
                manifest_after: mutable darray[u8] = []
                manifest_after.resize(1048577)
                lock_after: mutable darray[u8] = []
                lock_after.resize(1048577)
                return EXIT_SECURITY if not ProjectFiles::read_cstr_into("elisapkg.json", &manifest_after) or not ProjectFiles::read_cstr_into("elisapkg.lock", &lock_after)
                return EXIT_SECURITY if not ByteText::equal(manifest_after, raw) or not ByteText::equal(lock_after, lock)
                archive_digest_bytes: mutable darray[u8] = []
                archive_digest: mutable darray[u8] = []
                return EXIT_SECURITY if Integrity::sha256(archive, &archive_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(archive_digest_bytes, &archive_digest)
                if options.json:
                    size_text: mutable darray[u8] = []
                    registry_append_decimal(&size_text, archive.count.u64())
                    CliOutput::write_ok("{\"schema-version\":1,\"command\":\"publish\",\"dry-run\":true,\"valid\":true,\"source-tree-digest\":\"sha256:")
                    CliOutput::write_bytes(1, &source_digest)
                    CliOutput::write_ok("\",\"archive-size\":")
                    CliOutput::write_bytes(1, &size_text)
                    CliOutput::write_ok(",\"archive-digest\":\"sha256:")
                    CliOutput::write_bytes(1, &archive_digest)
                    CliOutput::write_ok("\"}\n")
                    return EXIT_OK
                CliOutput::write_ok("publish dry-run: manifest, lockfile, source tree, and package file selection are valid\n")
                CliOutput::write_error("note: signing and authenticated publication are still required\n")
                return EXIT_OK

        def run_publish() -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error(Security::publish_message())
                return Security::publish_status()

        def release_install_lock(lock_fd: i64) -> bool:
            # The lock file's inode remains in the prefix permanently. Closing this
            # descriptor releases the kernel lock without allowing another process
            # to create a second lock inode by racing an unlink.
            return Platform::pkg_close(lock_fd) == 0

        def local_install_transaction_path(prefix: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            ProjectFiles::path_join_into(prefix, ".elisapkg-install-transaction", out)

        def read_trusted_install_file(path: darray[u8]&, maximum: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            device: mutable u64 = 0.u64()
            inode: mutable u64 = 0.u64()
            return read_trusted_install_file_identity(path, maximum, out, &device, &inode)

        def read_trusted_install_file_identity(path: darray[u8]&, maximum: usize, out: mutable darray[u8]&, out_device: mutable u64&, out_inode: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            out_device <- 0.u64()
            out_inode <- 0.u64()
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            file_size: i64 = Platform::pkg_package_file_size(path_name)
            return false if file_size < 0 or file_size.usize() > maximum
            out.resize(file_size.usize() + 1.usize())
            output: mutable u8& = (&out[0]).cast[mutable u8&] can Unsafe.PointerCast
            read_size: i64 = Platform::pkg_read_trusted_file_identity(path_name, output, out.count, out_device, out_inode)
            if read_size != file_size:
                out.resize(0)
                out_device <- 0.u64()
                out_inode <- 0.u64()
                return false
            out.resize(read_size.usize())
            return true

        def remove_trusted_install_file_identity(path: darray[u8]&, device: u64, inode: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            return Platform::pkg_unlink_file_identity(path_name, device, inode) == 0

        def sync_local_install_entry_parents(destination_name: cstr, receipt_name: cstr) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # A transaction journal may be retired only after both target
            # directories durably record the current install or uninstall state.
            return false if Platform::pkg_fsync_parent(destination_name) != 0
            return Platform::pkg_fsync_parent(receipt_name) == 0

        def publish_local_install_receipt(path: darray[u8]&, receipt: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            path_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            status: i64 = write_cstr_file_noclobber_status(path_name, receipt)
            if status != 0:
                # A hard-link publish may have succeeded even when retiring its
                # temporary name or syncing the directory reported an error. Inspect
                # the destination before deciding whether recovery can continue.
                state: i64 = Platform::pkg_package_file_size(path_name)
                return false if state < 0 or state.usize() > InstallRecords::max_record_bytes
                existing: mutable darray[u8] = []
                return false if not read_trusted_install_file(path, InstallRecords::max_record_bytes, &existing)
                return false if not ByteText::equal(existing, receipt)
            # Even a matching visible receipt is incomplete evidence until its
            # containing directory has been synced. In particular, the publish
            # above can report a failed fsync after the hard link became visible.
            return Platform::pkg_fsync_parent(path_name) == 0

        def recover_local_install_transaction(prefix: darray[u8]&, out_operation: mutable darray[u8]&, out_name: mutable darray[u8]&, out_version: mutable darray[u8]&, out_digest: mutable darray[u8]&, out_install_published: mutable bool&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            out_operation.resize(0)
            out_name.resize(0)
            out_version.resize(0)
            out_digest.resize(0)
            out_install_published <- false
            transaction_path: mutable darray[u8] = []
            local_install_transaction_path(prefix, &transaction_path)
            transaction_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&transaction_path, &transaction_c)
            transaction_name: cstr = (&transaction_c[0]).cast[cstr] can Unsafe.PointerCast
            transaction_state: i64 = Platform::pkg_package_file_size(transaction_name)
            return true if transaction_state == -2
            return false if transaction_state < 0 or transaction_state.usize() > InstallRecords::max_record_bytes
            raw: mutable darray[u8] = []
            return false if not read_trusted_install_file(transaction_path, InstallRecords::max_record_bytes, &raw)
            operation: mutable darray[u8] = []
            name: mutable darray[u8] = []
            version: mutable darray[u8] = []
            expected_digest: mutable darray[u8] = []
            return false if not InstallRecords::parse_journal(raw, &operation, &name, &version, &expected_digest)
            name_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&name, &name_c)
            name_raw: cstr = (&name_c[0]).cast[cstr] can Unsafe.PointerCast
            bin_dir: mutable darray[u8] = []
            receipt_dir: mutable darray[u8] = []
            ProjectFiles::path_join_into(prefix, "bin", &bin_dir)
            ProjectFiles::path_join_into(prefix, "share/elisapkg/receipts", &receipt_dir)
            return false if not InstallPrefix::trusted_directory(bin_dir) or not InstallPrefix::trusted_directory(receipt_dir)
            destination: mutable darray[u8] = []
            receipt_path: mutable darray[u8] = []
            ProjectFiles::path_join_into(bin_dir, name_raw, &destination)
            ProjectFiles::path_join_into(receipt_dir, name_raw, &receipt_path)
            destination_c: mutable darray[u8] = []
            receipt_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&destination, &destination_c)
            ProjectFiles::path_with_nul_into(&receipt_path, &receipt_c)
            destination_name: cstr = (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
            receipt_name: cstr = (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast
            destination_state: i64 = Platform::pkg_package_file_size(destination_name)
            receipt_state: i64 = Platform::pkg_package_file_size(receipt_name)
            return false if destination_state < 0 and destination_state != -2
            return false if receipt_state < 0 and receipt_state != -2
            expected_receipt: mutable darray[u8] = []
            InstallRecords::encode_receipt(name, version, destination, expected_digest, &expected_receipt)
            if ByteText::equal_text(operation, "install"):
                # No target was published: discard the intent and let the caller
                # retry. A receipt without its expected binary is unexplained and
                # must be preserved for manual review.
                if destination_state == -2 and receipt_state == -2:
                    return false if not retire_local_install_transaction(transaction_path)
                else:
                    return false if destination_state == -2
                    artifact: mutable darray[u8] = []
                    return false if not read_trusted_install_file(destination, 67108864.usize(), &artifact)
                    digest_bytes: mutable darray[u8] = []
                    actual_digest: mutable darray[u8] = []
                    return false if Integrity::sha256(artifact, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &actual_digest) or not ByteText::equal(actual_digest, expected_digest)
                    if receipt_state == -2:
                        return false if Platform::pkg_chmod(destination_name, 493.u16()) != 0
                        return false if not publish_local_install_receipt(receipt_path, expected_receipt)
                    else:
                        existing_receipt: mutable darray[u8] = []
                        return false if not read_trusted_install_file(receipt_path, InstallRecords::max_record_bytes, &existing_receipt) or not ByteText::equal(existing_receipt, expected_receipt)
                        return false if Platform::pkg_access(destination_name, 1) != 0
                    # Recovery may observe names published before a previous
                    # process reported a directory-sync failure. Make both names
                    # durable before retiring the only recovery record.
                    return false if not sync_local_install_entry_parents(destination_name, receipt_name)
                    return false if not retire_local_install_transaction(transaction_path)
                    out_install_published <- true
            else:
                # Removal intent is durable before the first unlink. The only
                # reachable partial state is a verified binary with receipt, or
                # its receipt remaining after the binary unlink.
                if destination_state == -2 and receipt_state == -2:
                    return false if not sync_local_install_entry_parents(destination_name, receipt_name)
                    return false if not retire_local_install_transaction(transaction_path)
                else:
                    return false if receipt_state == -2
                    existing_receipt: mutable darray[u8] = []
                    receipt_device: mutable u64 = 0.u64()
                    receipt_inode: mutable u64 = 0.u64()
                    return false if not read_trusted_install_file_identity(receipt_path, InstallRecords::max_record_bytes, &existing_receipt, &receipt_device, &receipt_inode) or not ByteText::equal(existing_receipt, expected_receipt)
                    if destination_state >= 0:
                        artifact: mutable darray[u8] = []
                        artifact_device: mutable u64 = 0.u64()
                        artifact_inode: mutable u64 = 0.u64()
                        return false if not read_trusted_install_file_identity(destination, 67108864.usize(), &artifact, &artifact_device, &artifact_inode)
                        digest_bytes: mutable darray[u8] = []
                        actual_digest: mutable darray[u8] = []
                        return false if Integrity::sha256(artifact, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &actual_digest) or not ByteText::equal(actual_digest, expected_digest)
                        return false if not remove_trusted_install_file_identity(destination, artifact_device, artifact_inode)
                    return false if not remove_trusted_install_file_identity(receipt_path, receipt_device, receipt_inode)
                    return false if not sync_local_install_entry_parents(destination_name, receipt_name)
                    return false if not retire_local_install_transaction(transaction_path)
            for index in 0..<operation.count |out_operation, operation|:
                out_operation.push(operation[index])
            for index in 0..<name.count |out_name, name|:
                out_name.push(name[index])
            for index in 0..<version.count |out_version, version|:
                out_version.push(version[index])
            for index in 0..<expected_digest.count |out_digest, expected_digest|:
                out_digest.push(expected_digest[index])
            return true

        def finish_local_install_error(lock_fd: i64, message: cstr) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if Platform::pkg_strlen(message) > 0.usize():
                    CliOutput::write_error(message)
                if not release_install_lock(lock_fd):
                    CliOutput::write_error("error: could not close the local installation lock descriptor\n")
                return 7

        def run_install_local(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                prefix: mutable darray[u8] = []
                return EXIT_USAGE if not InstallPrefix::read_configured(&prefix)
                if not InstallPrefix::trusted_existing_ancestor(prefix):
                    CliOutput::write_error("error: install prefix directories must be owned by root or the current user, without group or other write permission\n")
                    return 7
                root: mutable darray[u8] = [46]
                resolved: i64 = run_resolve(&root, options, false, false)
                return resolved if resolved != EXIT_OK
                manifest_raw: mutable darray[u8] = []
                manifest_raw.resize(1048577)
                return EXIT_BUILD if not ProjectFiles::read_cstr_into("elisapkg.json", &manifest_raw)
                target_name: mutable darray[u8] = []
                target_kind: mutable darray[u8] = []
                target_entry: mutable darray[u8] = []
                return EXIT_BUILD if not ManifestTargets::select_target(manifest_raw, options.target_name, options.target_kind, &target_name, &target_kind, &target_entry)
                if not ByteText::equal_text(target_kind, "bin"):
                    CliOutput::write_error("error: install --local requires a binary target\n")
                    return 7
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return EXIT_USAGE if not load_package_at(&root, &name, &version)
                if version.count > MAX_INSTALL_VERSION_BYTES:
                    CliOutput::write_error("error: local install package versions exceed the bounded receipt limit\n")
                    return EXIT_USAGE
                use_prebuilt_artifact: bool = InstallFaults::use_test_prebuilt_artifact()
                expected_build_digest: mutable darray[u8] = []
                if not use_prebuilt_artifact:
                    return EXIT_BUILD if run_build_with_digest(start, options, &expected_build_digest) != EXIT_OK
                artifact: mutable darray[u8] = []
                target_name_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&target_name, &target_name_c)
                target_name_raw: cstr = (&target_name_c[0]).cast[cstr] can Unsafe.PointerCast
                build_dir: darray[u8] = Build::output_directory(start, Platform::pkg_cstr_equal(options.profile, "release"))
                ProjectFiles::path_join_into(build_dir, target_name_raw, &artifact)
                artifact_bytes: mutable darray[u8] = []
                return 7 if not read_package_file_into(&artifact, &artifact_bytes)
                digest_bytes: mutable darray[u8] = []
                digest: mutable darray[u8] = []
                return 7 if Integrity::sha256(artifact_bytes, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest)
                if not use_prebuilt_artifact and (expected_build_digest.count != 64.usize() or not ByteText::equal(digest, expected_build_digest)):
                    CliOutput::write_error("error: build output changed after compilation; refusing to install an unverified artifact\n")
                    return EXIT_BUILD
                bin_dir: mutable darray[u8] = []
                receipt_dir: mutable darray[u8] = []
                ProjectFiles::path_join_into(prefix, "bin", &bin_dir)
                ProjectFiles::path_join_into(prefix, "share/elisapkg/receipts", &receipt_dir)
                return 7 if not InstallPrefix::ensure_trusted_directory(bin_dir) or not InstallPrefix::ensure_trusted_directory(receipt_dir)
                if not InstallPrefix::trusted_directory(bin_dir) or not InstallPrefix::trusted_directory(receipt_dir):
                    CliOutput::write_error("error: install directories are not trusted; refusing publication\n")
                    return 7
                name_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&name, &name_c)
                name_raw: cstr = (&name_c[0]).cast[cstr] can Unsafe.PointerCast
                destination: mutable darray[u8] = []
                receipt_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(bin_dir, name_raw, &destination)
                ProjectFiles::path_join_into(receipt_dir, name_raw, &receipt_path)
                destination_snapshot: mutable darray[u8] = []
                receipt_snapshot: mutable darray[u8] = []
                ByteText::append(&destination_snapshot, destination)
                ByteText::append(&receipt_snapshot, receipt_path)
                prefix_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&prefix, &prefix_c)
                prefix_name: cstr = (&prefix_c[0]).cast[cstr] can Unsafe.PointerCast
                lock_fd: i64 = Platform::pkg_acquire_install_lock(prefix_name)
                if lock_fd < 0:
                    CliOutput::write_error("error: could not acquire the local installation lock; check the prefix and any legacy lock path\n")
                    return 7
                recovered_operation: mutable darray[u8] = []
                recovered_name: mutable darray[u8] = []
                recovered_version: mutable darray[u8] = []
                recovered_digest: mutable darray[u8] = []
                recovered_install_published: mutable bool = false
                if not recover_local_install_transaction(prefix, &recovered_operation, &recovered_name, &recovered_version, &recovered_digest, &recovered_install_published):
                    return finish_local_install_error(lock_fd, "error: an interrupted local installation could not be safely recovered; preserve the journal and files for review\n")
                destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                if recovered_install_published and ByteText::equal_text(recovered_operation, "install") and ByteText::equal(recovered_name, name) and ByteText::equal(recovered_version, version) and ByteText::equal(recovered_digest, digest):
                    return finish_local_install_error(lock_fd, "error: could not close the recovered local installation lock descriptor\n") if not release_install_lock(lock_fd)
                    CliOutput::write_ok("already installed ")
                    CliOutput::write_bytes(1, &name)
                    CliOutput::write_ok(" to ")
                    CliOutput::write_bytes(1, &destination)
                    CliOutput::write_ok("\n")
                    return EXIT_OK
                if file_exists(&destination):
                    return finish_local_install_error(lock_fd, "error: install destination or receipt already exists; refusing to overwrite\n")
                receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                if file_exists(&receipt_path):
                    return finish_local_install_error(lock_fd, "error: install destination or receipt already exists; refusing to overwrite\n")
                receipt: mutable darray[u8] = []
                InstallRecords::encode_receipt(name, version, destination_snapshot, digest, &receipt)
                transaction: mutable darray[u8] = []
                InstallRecords::encode_journal("install", name, version, digest, &transaction)
                transaction_path: mutable darray[u8] = []
                local_install_transaction_path(prefix, &transaction_path)
                transaction_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&transaction_path, &transaction_c)
                transaction_name: cstr = (&transaction_c[0]).cast[cstr] can Unsafe.PointerCast
                if not write_cstr_file_noclobber(transaction_name, &transaction):
                    return finish_local_install_error(lock_fd, "error: could not durably record the local installation transaction\n")
                InstallFaults::transaction_boundary("install.journal.durable")
                destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                destination_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&destination, &destination_c)
                destination_name: mutable cstr = (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
                if not write_cstr_file_noclobber(destination_name, &artifact_bytes):
                    return finish_local_install_error(lock_fd, "error: could not publish the local installation binary; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.binary.durable")
                destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                destination_c.resize(0)
                ProjectFiles::path_with_nul_into(&destination, &destination_c)
                destination_name <- (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
                if Platform::pkg_chmod(destination_name, 493.u16()) != 0:
                    return finish_local_install_error(lock_fd, "error: could not set local installation permissions; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.binary.mode.durable")
                receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                if not publish_local_install_receipt(receipt_path, receipt):
                    return finish_local_install_error(lock_fd, "error: could not publish the local installation receipt; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.receipt.durable")
                receipt_sync_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&receipt_path, &receipt_sync_c)
                receipt_sync_name: cstr = (&receipt_sync_c[0]).cast[cstr] can Unsafe.PointerCast
                if not sync_local_install_entry_parents(destination_name, receipt_sync_name):
                    return finish_local_install_error(lock_fd, "error: could not sync local installation directories; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("install.targets.synced")
                return finish_local_install_error(lock_fd, "error: the local installation was published but its transaction journal could not be retired\n") if not retire_local_install_transaction(transaction_path)
                return 7 if not release_install_lock(lock_fd)
                CliOutput::write_ok("installed ")
                CliOutput::write_bytes(1, &name)
                CliOutput::write_ok(" to ")
                CliOutput::write_bytes(1, &destination)
                CliOutput::write_ok("\n")
                return EXIT_OK

        def run_install(argc: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                local_seen: mutable bool = false
                package_seen: mutable bool = false
                index: mutable i64 = 2
                while index < argc |slots, index, local_seen, package_seen|:
                    argument: cstr = slots[index].cast[cstr]
                    if Platform::pkg_cstr_equal(argument, "--local"):
                        return EXIT_USAGE if local_seen
                        local_seen <- true
                    elif Platform::pkg_cstr_equal(argument, "--bin"):
                        return EXIT_USAGE if index + 1 >= argc
                        # The common option parser has already validated and
                        # stored this target name. Consume its value here so it
                        # cannot be mistaken for a remote package argument.
                        index <- index + 1
                    elif not package_seen:
                        package_seen <- true
                    else:
                        return EXIT_USAGE
                    index <- index + 1
                return EXIT_USAGE if local_seen and package_seen
                return EXIT_USAGE if not local_seen and not package_seen
                if local_seen:
                    return run_install_local(start, options)
                CliOutput::write_error(Security::install_message())
                return Security::install_status()

        def run_uninstall_local(name_raw_input: cstr) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                name: mutable darray[u8] = []
                ByteText::append_bounded_text(&name, name_raw_input)
                prefix: mutable darray[u8] = []
                return EXIT_USAGE if not InstallPrefix::read_configured(&prefix)
                bin_dir: mutable darray[u8] = []
                receipt_dir: mutable darray[u8] = []
                ProjectFiles::path_join_into(prefix, "bin", &bin_dir)
                ProjectFiles::path_join_into(prefix, "share/elisapkg/receipts", &receipt_dir)
                if not InstallPrefix::trusted_directory(bin_dir) or not InstallPrefix::trusted_directory(receipt_dir):
                    CliOutput::write_error("error: install directories are not trusted; refusing removal\n")
                    return 7
                name_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&name, &name_c)
                name_raw: cstr = (&name_c[0]).cast[cstr] can Unsafe.PointerCast
                destination: mutable darray[u8] = []
                receipt_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(bin_dir, name_raw, &destination)
                ProjectFiles::path_join_into(receipt_dir, name_raw, &receipt_path)
                destination_snapshot: mutable darray[u8] = []
                receipt_snapshot: mutable darray[u8] = []
                ByteText::append(&destination_snapshot, destination)
                ByteText::append(&receipt_snapshot, receipt_path)
                prefix_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&prefix, &prefix_c)
                prefix_name: cstr = (&prefix_c[0]).cast[cstr] can Unsafe.PointerCast
                lock_fd: i64 = Platform::pkg_acquire_install_lock(prefix_name)
                if lock_fd < 0:
                    CliOutput::write_error("error: could not acquire the local installation lock; check the prefix and any legacy lock path\n")
                    return 7
                recovered_operation: mutable darray[u8] = []
                recovered_name: mutable darray[u8] = []
                recovered_version: mutable darray[u8] = []
                recovered_digest: mutable darray[u8] = []
                recovered_install_published: mutable bool = false
                if not recover_local_install_transaction(prefix, &recovered_operation, &recovered_name, &recovered_version, &recovered_digest, &recovered_install_published):
                    return finish_local_install_error(lock_fd, "error: an interrupted local installation could not be safely recovered; preserve the journal and files for review\n")
                if ByteText::equal_text(recovered_operation, "uninstall") and ByteText::equal(recovered_name, name):
                    return finish_local_install_error(lock_fd, "error: could not close the recovered local installation lock\n") if not release_install_lock(lock_fd)
                    CliOutput::write_ok("uninstalled ")
                    CliOutput::write_bytes(1, &name)
                    CliOutput::write_ok("\n")
                    return EXIT_OK
                destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                destination_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&destination, &destination_c)
                destination_name: cstr = (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
                destination_state: i64 = Platform::pkg_package_file_size(destination_name)
                if destination_state == -2:
                    return finish_local_install_error(lock_fd, "error: no matching local installation receipt is available\n")
                if destination_state < 0:
                    return finish_local_install_error(lock_fd, "error: local installation is not a trusted regular file; refusing removal\n")
                receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                receipt_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&receipt_path, &receipt_c)
                receipt_name: cstr = (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast
                receipt_state: i64 = Platform::pkg_package_file_size(receipt_name)
                if receipt_state == -2:
                    return finish_local_install_error(lock_fd, "error: no matching local installation receipt is available\n")
                if receipt_state < 0:
                    return finish_local_install_error(lock_fd, "error: local installation receipt is not a trusted regular file; refusing removal\n")
                artifact_bytes: mutable darray[u8] = []
                receipt: mutable darray[u8] = []
                artifact_device: mutable u64 = 0.u64()
                artifact_inode: mutable u64 = 0.u64()
                receipt_device: mutable u64 = 0.u64()
                receipt_inode: mutable u64 = 0.u64()
                destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                if not read_trusted_install_file_identity(destination, 67108864.usize(), &artifact_bytes, &artifact_device, &artifact_inode):
                    return finish_local_install_error(lock_fd, "error: could not read the local installation or its receipt\n")
                receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                if not read_trusted_install_file_identity(receipt_path, InstallRecords::max_record_bytes, &receipt, &receipt_device, &receipt_inode):
                    return finish_local_install_error(lock_fd, "error: could not read the local installation or its receipt\n")
                digest_bytes: mutable darray[u8] = []
                digest: mutable darray[u8] = []
                if Integrity::sha256(artifact_bytes, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest):
                    return finish_local_install_error(lock_fd, "error: could not verify the local installation binary\n")
                expected_prefix: mutable darray[u8] = []
                expected_suffix: mutable darray[u8] = []
                ByteText::append_text(&expected_prefix, "elisapkg-install-receipt:1\nname:")
                ByteText::append(&expected_prefix, name)
                ByteText::append_text(&expected_prefix, "\nversion:")
                ByteText::append_text(&expected_suffix, "\npath:")
                ByteText::append(&expected_suffix, destination_snapshot)
                ByteText::append_text(&expected_suffix, "\nartifact-digest:sha256:")
                ByteText::append(&expected_suffix, digest)
                ByteText::append_text(&expected_suffix, "\n")
                version_bytes: mutable darray[u8] = []
                version_end: usize = receipt.count - expected_suffix.count if receipt.count >= expected_suffix.count else 0.usize()
                if not ByteText::starts_with(receipt, expected_prefix) or not ByteText::ends_with(receipt, expected_suffix) or version_end <= expected_prefix.count:
                    return finish_local_install_error(lock_fd, "error: installation receipt does not match the current file; refusing removal\n")
                for index in expected_prefix.count..<version_end |receipt, version_bytes|:
                    version_bytes.push(receipt[index])
                parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                if not parse_version(version_bytes, &parsed_version):
                    return finish_local_install_error(lock_fd, "error: installation receipt does not match the current file; refusing removal\n")
                transaction: mutable darray[u8] = []
                InstallRecords::encode_journal("uninstall", name, version_bytes, digest, &transaction)
                transaction_path: mutable darray[u8] = []
                local_install_transaction_path(prefix, &transaction_path)
                transaction_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&transaction_path, &transaction_c)
                transaction_name: cstr = (&transaction_c[0]).cast[cstr] can Unsafe.PointerCast
                if not write_cstr_file_noclobber(transaction_name, &transaction):
                    return finish_local_install_error(lock_fd, "error: could not durably record the local uninstallation transaction\n")
                InstallFaults::transaction_boundary("uninstall.journal.durable")
                destination.resize(0)
                ByteText::append(&destination, destination_snapshot)
                if not remove_trusted_install_file_identity(destination, artifact_device, artifact_inode):
                    return finish_local_install_error(lock_fd, "error: could not remove the local installation; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("uninstall.binary.removed")
                receipt_path.resize(0)
                ByteText::append(&receipt_path, receipt_snapshot)
                if not remove_trusted_install_file_identity(receipt_path, receipt_device, receipt_inode):
                    return finish_local_install_error(lock_fd, "error: could not remove the local installation receipt; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("uninstall.receipt.removed")
                if not sync_local_install_entry_parents(destination_name, receipt_name):
                    return finish_local_install_error(lock_fd, "error: could not sync local installation directories; recovery will inspect the durable transaction\n")
                InstallFaults::transaction_boundary("uninstall.targets.synced")
                if not retire_local_install_transaction(transaction_path):
                    return finish_local_install_error(lock_fd, "error: the local installation was removed but its transaction journal could not be retired\n")
                return 7 if not release_install_lock(lock_fd)
                CliOutput::write_ok("uninstalled ")
                CliOutput::write_bytes(1, &name)
                CliOutput::write_ok("\n")
                return EXIT_OK

        def run_uninstall(argc: i64, slots: mutable cstr&&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                local_seen: mutable bool = false
                name: mutable cstr = ""
                index: mutable i64 = 2
                while index < argc:
                    argument: cstr = slots[index].cast[cstr]
                    if Platform::pkg_cstr_equal(argument, "--local"):
                        return EXIT_USAGE if local_seen
                        local_seen <- true
                    elif Platform::pkg_cstr_equal(argument, "--") or Platform::pkg_strlen(argument) == 0.usize() or argument[0].u8() == 45 or Platform::pkg_strlen(name) != 0.usize():
                        CliOutput::write_error("error: invalid uninstall arguments\n")
                        return EXIT_USAGE
                    else:
                        name <- argument
                    index <- index + 1
                return EXIT_USAGE if not local_seen or Platform::pkg_strlen(name) == 0.usize()
                name_bytes: mutable darray[u8] = []
                ByteText::append_bounded_text(&name_bytes, name)
                return EXIT_USAGE if not valid_package_name(name_bytes)
                return run_uninstall_local(name)

        def run_remove(argc: i64, slots: mutable cstr&&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return EXIT_SECURITY if not ProjectTransaction::recover()
                return EXIT_USAGE if argc != 3
                alias: mutable darray[u8] = []
                ByteText::append_bounded_text(&alias, slots[2].cast[cstr])
                return EXIT_USAGE if not valid_package_name(alias)
                root: mutable darray[u8] = [46]
                root_name: mutable darray[u8] = []
                root_version: mutable darray[u8] = []
                return EXIT_USAGE if not load_package_at(&root, &root_name, &root_version)
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                return EXIT_USAGE if not validate_manifest_at(raw, &root, &root_name, &root_version)
                updated: darray[u8] = ManifestEdits::remove(raw, alias)
                if updated.count == 0.usize():
                    CliOutput::write_error("error: dependency is not declared; no manifest or lockfile mutation was performed\n")
                    return EXIT_RESOLVE
                return EXIT_SECURITY if not ProjectTransaction::begin(raw)
                if not ProjectTransaction::stage_manifest(updated) or not ProjectFiles::write_cstr_file("elisapkg.json", &updated):
                    _ = ProjectTransaction::restore()
                    return EXIT_SOURCE
                options: Model::CommandOptions = Model::CommandOptions{locked: false, offline: false, frozen: false, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                resolved: i64 = run_resolve(&root, options, true, false)
                if resolved != EXIT_OK:
                    restored: bool = ProjectTransaction::restore()
                    if not restored:
                        CliOutput::write_error("error: dependency removal failed and the original manifest could not be restored\n")
                        return EXIT_SECURITY
                    return resolved
                if not ProjectTransaction::mark_lock():
                    _ = ProjectTransaction::restore()
                    return EXIT_SECURITY
                return EXIT_SECURITY if not ProjectTransaction::commit()
                CliOutput::write_ok("removed dependency ")
                CliOutput::write_bytes(1, &alias)
                CliOutput::write_ok("\n")
                return EXIT_OK

        def run_update(argc: i64, slots: mutable cstr&&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return EXIT_SECURITY if not ProjectTransaction::recover()
                return EXIT_USAGE if argc > 3
                wanted: mutable darray[u8] = []
                if argc == 3:
                    ByteText::append_bounded_text(&wanted, slots[2].cast[cstr])
                    return EXIT_USAGE if not valid_package_name(wanted)
                root: mutable darray[u8] = [46]
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                root_name: mutable darray[u8] = []
                root_version: mutable darray[u8] = []
                return EXIT_USAGE if not validate_manifest_at(raw, &root, &root_name, &root_version)
                return EXIT_USAGE if wanted.count > 0.usize() and ByteText::equal(wanted, root_name)
                return EXIT_SECURITY if not ProjectTransaction::begin(raw)
                options: Model::CommandOptions = Model::CommandOptions{locked: false, offline: false, frozen: false, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                if wanted.count > 0.usize():
                    options.update_name <- slots[2].cast[cstr]
                resolved: i64 = run_resolve(&root, options, true, false)
                if resolved != EXIT_OK:
                    restored: bool = ProjectTransaction::restore()
                    if not restored:
                        CliOutput::write_error("error: update failed and the original manifest or lockfile could not be restored\n")
                        return EXIT_SECURITY
                    return resolved
                if wanted.count > 0.usize():
                    lock: mutable darray[u8] = []
                    lock.resize(1048577)
                    if not ProjectFiles::read_cstr_into("elisapkg.lock", &lock) or not Lockfile::contains_package(lock, wanted):
                        _ = ProjectTransaction::restore()
                        return EXIT_RESOLVE
                if not ProjectTransaction::mark_lock():
                    _ = ProjectTransaction::restore()
                    return EXIT_SECURITY
                return EXIT_SECURITY if not ProjectTransaction::commit()
                CliOutput::write_ok("updated dependency lock\n")
                return EXIT_OK

        def remove_target_outputs(leaves: darray[darray[u8]]&, build_dir: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            for index in 0..<leaves.count |leaves, build_dir|:
                terminated: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(leaves[index], &terminated)
                leaf: cstr = (&terminated[0]).cast[cstr] can Unsafe.PointerCast
                path: mutable darray[u8] = []
                ProjectFiles::path_join_into(build_dir, leaf, &path)
                return false if not remove_known_file(path)
            return true

        def run_clean() -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                root: mutable darray[u8] = [46]
                state: mutable darray[u8] = []
                build_dir: mutable darray[u8] = []
                release_build_dir: mutable darray[u8] = []
                artifact: mutable darray[u8] = []
                library_artifact: mutable darray[u8] = []
                receipt: mutable darray[u8] = []
                package_archive: mutable darray[u8] = []
                package_receipt: mutable darray[u8] = []
                ProjectFiles::path_join_into(root, ".elisapkg", &state)
                return EXIT_BUILD if not ProjectFiles::make_directory(&state)
                build_dir <- Build::output_directory(root, false)
                release_build_dir <- Build::output_directory(root, true)
                ProjectFiles::path_join_into(build_dir, "app", &artifact)
                ProjectFiles::path_join_into(build_dir, "app.o", &library_artifact)
                ProjectFiles::path_join_into(build_dir, "receipt", &receipt)
                ProjectFiles::path_join_into(state, "package.tar", &package_archive)
                ProjectFiles::path_join_into(state, "package.receipt", &package_receipt)
                manifest_raw: mutable darray[u8] = []
                manifest_raw.resize(1048577)
                if ProjectFiles::read_cstr_into("elisapkg.json", &manifest_raw):
                    output_leaves: mutable darray[darray[u8]] = []
                    return EXIT_BUILD if not ManifestTargets::cleanup_output_leaves(manifest_raw, &output_leaves)
                    return EXIT_BUILD if not remove_target_outputs(output_leaves, build_dir)
                    return EXIT_BUILD if not remove_target_outputs(output_leaves, release_build_dir)
                # Remove legacy single-target names left by older receipts as well as the
                # manifest-declared target outputs.
                return EXIT_BUILD if not remove_known_file(&artifact)
                return EXIT_BUILD if not remove_known_file(&library_artifact)
                return EXIT_BUILD if not remove_known_file(&receipt)
                return EXIT_BUILD if not remove_known_file(&package_archive)
                return EXIT_BUILD if not remove_known_file(&package_receipt)
                return EXIT_BUILD if not remove_build_directory_if_empty(&release_build_dir)
                return EXIT_BUILD if not remove_build_directory_if_empty(&build_dir)
                # `.elisapkg` is removed only when it is empty; cache/state files are never
                # traversed or recursively deleted by clean. A retained cache makes this
                # directory intentionally non-empty, which is a successful clean result.
                return EXIT_BUILD if not remove_state_directory(&state)
                CliOutput::write_ok("cleaned known .elisapkg outputs\n")
                return EXIT_OK

        def run_cache_verify(start: darray[u8]&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return EXIT_SECURITY if not validate_manifest_at(raw, start, &name, &version)
                lock: mutable darray[u8] = []
                lock.resize(1048577)
                return EXIT_SECURITY if not ProjectFiles::read_cstr_into("elisapkg.lock", &lock)
                return EXIT_SECURITY if not lock_matches_manifest(raw, lock, name, version, start)
                archive_state: i64 = Platform::pkg_package_file_size(".elisapkg/package.tar")
                receipt_state: i64 = Platform::pkg_package_file_size(".elisapkg/package.receipt")
                return EXIT_SECURITY if archive_state < 0 and archive_state != -2
                return EXIT_SECURITY if receipt_state < 0 and receipt_state != -2
                archive_present: bool = archive_state >= 0
                receipt_present: bool = receipt_state >= 0
                return EXIT_SECURITY if archive_present != receipt_present
                archive_bytes: mutable darray[u8] = []
                receipt: mutable darray[u8] = []
                archive_digest: mutable darray[u8] = []
                if archive_present:
                    manifest_digest_bytes: mutable darray[u8] = []
                    manifest_digest: mutable darray[u8] = []
                    lock_digest_bytes: mutable darray[u8] = []
                    lock_digest: mutable darray[u8] = []
                    return EXIT_SECURITY if Integrity::sha256(raw, &manifest_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
                    return EXIT_SECURITY if Integrity::sha256(lock, &lock_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(lock_digest_bytes, &lock_digest)
                    archive_path: mutable darray[u8] = []
                    ByteText::append_text(&archive_path, ".elisapkg/package.tar")
                    return EXIT_SECURITY if not read_package_file_into(&archive_path, &archive_bytes)
                    return EXIT_SECURITY if not Archive::verify_ustar_archive(archive_bytes)
                    archive_digest_bytes: mutable darray[u8] = []
                    return EXIT_SECURITY if Integrity::sha256(archive_bytes, &archive_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(archive_digest_bytes, &archive_digest)
                    receipt.resize(PackageReceipt::max_encode + 1.usize())
                    return EXIT_SECURITY if not ProjectFiles::read_cstr_into(".elisapkg/package.receipt", &receipt)
                    expected_receipt: darray[u8] = PackageReceipt::encode(name, version, manifest_digest, lock_digest, archive_digest)
                    return EXIT_SECURITY if not ByteText::equal(receipt, expected_receipt)
                manifest_after: mutable darray[u8] = []
                manifest_after.resize(1048577)
                lock_after: mutable darray[u8] = []
                lock_after.resize(1048577)
                return EXIT_SECURITY if not ProjectFiles::read_cstr_into("elisapkg.json", &manifest_after) or not ProjectFiles::read_cstr_into("elisapkg.lock", &lock_after)
                return EXIT_SECURITY if not ByteText::equal(manifest_after, raw) or not ByteText::equal(lock_after, lock)
                archive_state_after: i64 = Platform::pkg_package_file_size(".elisapkg/package.tar")
                receipt_state_after: i64 = Platform::pkg_package_file_size(".elisapkg/package.receipt")
                return EXIT_SECURITY if archive_state_after < 0 and archive_state_after != -2
                return EXIT_SECURITY if receipt_state_after < 0 and receipt_state_after != -2
                return EXIT_SECURITY if archive_present != (archive_state_after >= 0) or receipt_present != (receipt_state_after >= 0)
                if archive_present:
                    archive_path_after: mutable darray[u8] = []
                    ByteText::append_text(&archive_path_after, ".elisapkg/package.tar")
                    # Reuse the first bounded buffer: verify the bytes still at the
                    # pathname without retaining a second full-size archive copy.
                    archive_after_digest_bytes: mutable darray[u8] = []
                    archive_after_digest: mutable darray[u8] = []
                    receipt_after: mutable darray[u8] = []
                    receipt_after.resize(PackageReceipt::max_encode + 1.usize())
                    return EXIT_SECURITY if not read_package_file_into(&archive_path_after, &archive_bytes) or not ProjectFiles::read_cstr_into(".elisapkg/package.receipt", &receipt_after)
                    return EXIT_SECURITY if Integrity::sha256(archive_bytes, &archive_after_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(archive_after_digest_bytes, &archive_after_digest)
                    return EXIT_SECURITY if not ByteText::equal(archive_after_digest, archive_digest) or not ByteText::equal(receipt_after, receipt)
                    return EXIT_SECURITY if not Cache::verify_blob(archive_digest)
                CliOutput::write_ok("cache: local lock and manifest digests verified\n")
                if archive_present:
                    CliOutput::write_ok("cache: deterministic package archive and receipt verified\n")
                CliOutput::write_ok("cache: no shared remote cache configured\n")
                return EXIT_OK

        def run_cache_gc(argc: i64, slots: mutable cstr&&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if argc == 4 and Platform::pkg_cstr_equal(slots[2].cast[cstr], "gc") and Platform::pkg_cstr_equal(slots[3].cast[cstr], "--dry-run"):
                    CliOutput::write_ok("cache: no shared cache configured; nothing would be collected\n")
                    return EXIT_OK
                if argc == 3 and Platform::pkg_cstr_equal(slots[2].cast[cstr], "gc"):
                    CliOutput::write_error("error: cache garbage collection is disabled until a verified cache store is configured; use `cache gc --dry-run`\n")
                    return 7
                return EXIT_USAGE

        def collect_package_paths(raw: darray[u8]&, target: darray[u8]&, out: mutable darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global.Read:
                out.resize(0)
                resolved_root: mutable darray[u8] = []
                resolved_root.resize(4096)
                root_real_name: mutable cstr = ""
                if Platform::pkg_realpath(".", &resolved_root) is canonical_root:
                    root_real_name <- canonical_root
                else:
                    return false
                root_policy_path: mutable darray[u8] = []
                ByteText::append_bounded_text(&root_policy_path, root_real_name)
                root_policy_path.push(0)
                return false if PackagePathPolicy::credential_root_forbidden(root_policy_path)
                buffer: mutable darray[u8] = []
                buffer.resize(8388608)
                buffer_raw: mutable u8& = (&buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
                collected: i64 = Platform::pkg_collect_files(".", buffer_raw, buffer.count)
                return false if collected < 0
                cursor: mutable usize = 0.usize()
                selected: mutable usize = 0.usize()
                target_found: mutable bool = false
                include_start: usize = Json::root_value_offset(raw, "include")
                include_end: usize = Json::array_end(raw, include_start) if include_start < raw.count else raw.count
                exclude_start: usize = Json::root_value_offset(raw, "exclude")
                exclude_end: usize = Json::array_end(raw, exclude_start) if exclude_start < raw.count else raw.count
                return false if not PackageSelection::valid_pattern_range(raw, include_start, include_end)
                return false if not PackageSelection::valid_pattern_range(raw, exclude_start, exclude_end)
                glob_work_remaining: mutable usize = PackageSelection::max_work
                glob_rows_remaining: mutable usize = PackageSelection::max_rows
                glob_budget_exhausted: mutable bool = false
                while cursor < collected.usize():
                    path: mutable darray[u8] = []
                    while cursor < collected.usize() and buffer[cursor] != 0 |buffer, cursor, path|:
                        path.push(buffer[cursor])
                        cursor <- cursor + 1.usize()
                    return false if cursor >= collected.usize()
                    cursor <- cursor + 1.usize()
                    return false if path.count == 0.usize() or PackageSelection::publish_path_forbidden(path)
                    required: bool = ByteText::equal_text(path, "elisapkg.json") or ByteText::equal_text(path, "elisapkg.lock")
                    include_selected: mutable bool = required or PackageSelection::include_allows_path(raw, include_start, include_end, path, &glob_work_remaining, &glob_rows_remaining, &glob_budget_exhausted)
                    if glob_budget_exhausted:
                        CliOutput::write_error("error: package include/exclude patterns exceeded the bounded matching budget\n")
                        return false
                    if include_selected and not required and PackageSelection::exclude_allows_path(raw, exclude_start, exclude_end, path, &glob_work_remaining, &glob_rows_remaining, &glob_budget_exhausted):
                        include_selected <- false
                    if glob_budget_exhausted:
                        CliOutput::write_error("error: package include/exclude patterns exceeded the bounded matching budget\n")
                        return false
                    if include_selected:
                        return false if selected >= PackagePathPolicy::max_package_archive_entries
                        for index in 0..<path.count |out, path|:
                            out.push(path[index])
                        out.push(0)
                        selected <- selected + 1.usize()
                        target_found <- true if ByteText::equal(path, target)
                return selected > 0.usize() and target_found

        def package_archive_bytes(raw: darray[u8]&, target: darray[u8]&, out: mutable darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global.Read:
                out.resize(0)
                paths: mutable darray[u8] = []
                return false if not collect_package_paths(raw, target, &paths)
                return Archive::write_ustar_from_paths(paths, out)

        def run_package(argc: i64, slots: mutable cstr&&, start: darray[u8]&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if not project_manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return EXIT_USAGE
                list_only: mutable bool = false
                for index in 2..<argc |slots, list_only|:
                    list_only <- true if Platform::pkg_cstr_equal(slots[index].cast[cstr], "--list")
                raw: mutable darray[u8] = []
                raw.resize(1048577)
                return EXIT_USAGE if not ProjectFiles::read_cstr_into("elisapkg.json", &raw)
                package_name: mutable darray[u8] = []
                package_version: mutable darray[u8] = []
                return EXIT_USAGE if not validate_manifest_at(raw, start, &package_name, &package_version)
                entry: mutable darray[u8] = []
                return EXIT_USAGE if not ManifestTargets::default_entry(raw, &entry)
                paths: mutable darray[u8] = []
                return EXIT_USAGE if not collect_package_paths(raw, entry, &paths)
                if list_only:
                    CliOutput::write_ok("package files:\n")
                    cursor: mutable usize = 0.usize()
                    while cursor < paths.count:
                        path: mutable darray[u8] = []
                        CliOutput::write_ok("  ")
                        while cursor < paths.count and paths[cursor] != 0 |paths, cursor, path|:
                            path.push(paths[cursor])
                            cursor <- cursor + 1.usize()
                        CliOutput::write_bytes(1, &path)
                        CliOutput::write_ok("\n")
                        cursor <- cursor + 1.usize()
                    CliOutput::write_error("note: signing is required before publish; this command only previews files\n")
                    return EXIT_OK
                lock_options: Model::CommandOptions = Model::CommandOptions{locked: true, offline: true, frozen: true, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                return EXIT_RESOLVE if run_resolve(start, lock_options, false, false) != EXIT_OK
                lock_raw: mutable darray[u8] = []
                lock_raw.resize(1048577)
                return EXIT_SECURITY if not ProjectFiles::read_cstr_into("elisapkg.lock", &lock_raw)
                manifest_digest_bytes: mutable darray[u8] = []
                manifest_digest: mutable darray[u8] = []
                lock_digest_bytes: mutable darray[u8] = []
                lock_digest: mutable darray[u8] = []
                return EXIT_SECURITY if Integrity::sha256(raw, &manifest_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
                return EXIT_SECURITY if Integrity::sha256(lock_raw, &lock_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(lock_digest_bytes, &lock_digest)
                # `run_resolve` validated the lock before returning, but packaging
                # reads the source tree afterwards. Revalidate at this boundary so a
                # source mutation between resolution and archive creation cannot be
                # published under an older lock identity.
                return EXIT_SECURITY if not lock_matches_manifest(raw, lock_raw, package_name, package_version, start)
                package_source_digest: mutable darray[u8] = []
                return EXIT_SECURITY if not SourceFingerprint::current(&package_source_digest)
                state_root: mutable darray[u8] = []
                ByteText::append_text(&state_root, ".elisapkg")
                return 7 if not ProjectFiles::make_directory(&state_root)
                archive: mutable darray[u8] = []
                return 7 if not package_archive_bytes(raw, entry, &archive)
                package_source_digest_after: mutable darray[u8] = []
                return 7 if not SourceFingerprint::current(&package_source_digest_after) or not ByteText::equal(package_source_digest_after, package_source_digest)
                # Manifest and lock bytes are excluded from the source-tree digest
                # because their dedicated receipt fields would otherwise be
                # self-referential. Re-read both inputs after archive creation so a
                # concurrent edit cannot publish a mixed archive under the earlier
                # identity.
                manifest_after: mutable darray[u8] = []
                manifest_after.resize(1048577)
                lock_after: mutable darray[u8] = []
                lock_after.resize(1048577)
                return 7 if not ProjectFiles::read_cstr_into("elisapkg.json", &manifest_after) or not ProjectFiles::read_cstr_into("elisapkg.lock", &lock_after)
                return EXIT_SECURITY if not ByteText::equal(manifest_after, raw) or not ByteText::equal(lock_after, lock_raw)
                return 7 if not Archive::verify_ustar_archive(archive)
                archive_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(start, ".elisapkg/package.tar", &archive_path)
                receipt_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(start, ".elisapkg/package.receipt", &receipt_path)
                archive_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&archive_path, &archive_c)
                archive_name: cstr = (&archive_c[0]).cast[cstr] can Unsafe.PointerCast
                return 7 if not ProjectFiles::write_cstr_file(archive_name, &archive)
                persisted_archive: mutable darray[u8] = []
                return 7 if not read_package_file_into(&archive_path, &persisted_archive)
                # The receipt and cache identify the bytes that remain at the
                # published path. Refuse a pathname replacement between the
                # atomic write and this read unless it still matches the exact tar
                # that passed the in-memory archive verifier.
                return 7 if not ByteText::equal(persisted_archive, archive)
                digest_bytes: mutable darray[u8] = []
                digest: mutable darray[u8] = []
                return 7 if Integrity::sha256(persisted_archive, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest)
                blob_path: mutable darray[u8] = []
                return 7 if not Cache::blob_path(digest, &blob_path)
                cache_parent: mutable darray[u8] = []
                return 7 if not Cache::shard_path(digest, &cache_parent)
                return 7 if not ProjectFiles::make_directory(&cache_parent)
                blob_name_c: mutable darray[u8] = []
                archive_source_c: mutable darray[u8] = []
                quarantine_parent: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&blob_path, &blob_name_c)
                ProjectFiles::path_with_nul_into(&archive_path, &archive_source_c)
                ByteText::append_text(&quarantine_parent, Cache::quarantine_directory)
                blob_name: cstr = (&blob_name_c[0]).cast[cstr] can Unsafe.PointerCast
                archive_source_name: cstr = (&archive_source_c[0]).cast[cstr] can Unsafe.PointerCast
                if ProjectFiles::cstr_file_exists(blob_name):
                    if not Cache::verify_blob(digest):
                        return 7 if not ProjectFiles::make_directory(&quarantine_parent)
                        return 7 if not Cache::quarantine_blob(digest)
                        return 7 if Platform::pkg_link(archive_source_name, blob_name) != 0
                elif Platform::pkg_link(archive_source_name, blob_name) != 0:
                    return 7 if not ProjectFiles::cstr_file_exists(blob_name) or not Cache::verify_blob(digest)
                # Revalidate after every publication path. A concurrent rename can change
                # a pathname after the initial existence check; the receipt is written only
                # once the final cache bytes still match the in-memory archive digest. The
                # parent flush makes the hard-link durable before the receipt can claim it.
                return 7 if Platform::pkg_fsync_parent(blob_name) != 0
                return 7 if not Cache::verify_blob(digest)
                receipt: darray[u8] = PackageReceipt::encode(package_name, package_version, manifest_digest, lock_digest, digest)
                return 7 if receipt.count == 0.usize()
                receipt_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&receipt_path, &receipt_c)
                receipt_name: cstr = (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast
                return 7 if not ProjectFiles::write_cstr_file(receipt_name, receipt)
                CliOutput::write_ok("packaged ")
                CliOutput::write_bytes(1, &package_name)
                CliOutput::write_ok(" ")
                CliOutput::write_bytes(1, &package_version)
                CliOutput::write_ok(" -> ")
                CliOutput::write_bytes(1, &archive_path)
                CliOutput::write_ok(" sha256:")
                CliOutput::write_bytes(1, &digest)
                CliOutput::write_ok("\n")
                return EXIT_OK

        def sandbox_dependency_roots(lock: darray[u8]&, start: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return true if not Lockfile::version_is(lock, 2)
            packages_start: usize = Json::root_value_offset(lock, "packages")
            packages_end: usize = Json::array_end(lock, packages_start)
            return false if packages_start >= lock.count or packages_end <= packages_start or lock[packages_start] != 91
            cursor: mutable usize = packages_start + 1.usize()
            count: mutable usize = 0.usize()
            while cursor < packages_end |lock, cursor, count, out, start|:
                while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                    cursor <- cursor + 1.usize()
                break if cursor >= packages_end or lock[cursor] == 93
                return false if lock[cursor] != 123 or count >= MAX_DEPENDENCIES
                record_end: usize = Json::object_end(lock, cursor)
                return false if record_end <= cursor or record_end >= packages_end
                source_start: mutable usize = 0.usize()
                source_end: mutable usize = 0.usize()
                return false if not Json::object_value_span(lock, cursor, record_end, "source", &source_start, &source_end)
                source_type: mutable darray[u8] = []
                if Json::object_string_value(lock, source_start, source_end, "type", &source_type) and ByteText::equal_text(source_type, "path"):
                    relative: mutable darray[u8] = []
                    return false if not Json::object_string_value(lock, source_start, source_end, "path", &relative) or not Manifest::valid_dependency_path(relative)
                    relative_c: mutable darray[u8] = []
                    ProjectFiles::path_with_nul_into(&relative, &relative_c)
                    relative_name: cstr = (&relative_c[0]).cast[cstr] can Unsafe.PointerCast
                    joined: mutable darray[u8] = []
                    ProjectFiles::path_join_into(start, relative_name, &joined)
                    normalized: mutable darray[u8] = []
                    return false if not normalize_relative_path(joined, &normalized)
                    normalized_c: mutable darray[u8] = []
                    ProjectFiles::path_with_nul_into(&normalized, &normalized_c)
                    normalized_name: cstr = (&normalized_c[0]).cast[cstr] can Unsafe.PointerCast
                    resolved: mutable darray[u8] = []
                    resolved.resize(4096)
                    if Platform::pkg_realpath(normalized_name, &resolved) is canonical:
                        canonical_root: mutable darray[u8] = []
                        length: usize = Platform::pkg_strlen(canonical)
                        return false if length == 0.usize() or length >= 4096.usize()
                        for index in 0..<length |canonical_root, canonical|:
                            canonical_root.push(canonical[index].u8())
                        for root_index in 0..<canonical_root.count |out, canonical_root|:
                            out.push(canonical_root[root_index])
                        out.push(0)
                    else:
                        return false
                cursor <- record_end + 1.usize()
                while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                    cursor <- cursor + 1.usize()
                if cursor < packages_end and lock[cursor] == 44:
                    cursor <- cursor + 1.usize()
                count <- count + 1.usize()
            return true

        def select_unique_library_entry(raw: darray[u8]&, package_root: darray[u8]&, out: mutable darray[u8]&, relative_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            relative_out.resize(0)
            selected_entry: mutable darray[u8] = []
            return false if not ManifestTargets::unique_library_entry(raw, &selected_entry) or not Manifest::is_safe_relative_entry(selected_entry)
            entry_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(&selected_entry, &entry_c)
            entry_name: cstr = (&entry_c[0]).cast[cstr] can Unsafe.PointerCast
            joined: mutable darray[u8] = []
            ProjectFiles::path_join_into(package_root, entry_name, &joined)
            return false if not ProjectFiles::canonical_existing_path(joined, out)
            ByteText::append(relative_out, selected_entry)
            return true

        def build_local_dependency_aggregate[@r](lock: darray[u8]&, start: darray[u8]&, root_entry: cstr, source_byte_budget: usize, aggregate: mutable darray[u8]&, has_dependencies: mutable bool&, packages: mutable darray[LocalBuildGraph::Package]& @r, order: mutable darray[usize]& @r) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            aggregate.resize(0)
            has_dependencies <- false
            packages.resize(0)
            order.resize(0)
            return false if not Lockfile::version_is(lock, 2)
            packages_start: usize = Json::root_value_offset(lock, "packages")
            packages_end: usize = Json::array_end(lock, packages_start)
            return false if packages_start >= lock.count or packages_end <= packages_start or lock[packages_start] != 91
            root_path: mutable darray[u8] = []
            return false if not ProjectFiles::canonical_existing_path(start, &root_path)
            total_graph_edges: mutable usize = 0.usize()
            total_dependency_source_bytes: mutable usize = 0.usize()
            cursor: mutable usize = packages_start + 1.usize()
            while cursor < packages_end:
                while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13):
                    cursor <- cursor + 1.usize()
                break if cursor >= packages_end or lock[cursor] == 93
                return false if lock[cursor] != 123 or packages.count >= MAX_DEPENDENCIES
                record_end: usize = Json::object_end(lock, cursor)
                return false if record_end <= cursor or record_end >= packages_end
                package_name: mutable darray[u8] @r = []
                package_version: mutable darray[u8] = []
                source_start: mutable usize = 0.usize()
                source_end: mutable usize = 0.usize()
                return false if not Json::object_string_value(lock, cursor, record_end, "name", &package_name) or not valid_package_name(package_name)
                return false if not Json::object_string_value(lock, cursor, record_end, "version", &package_version)
                return false if not Json::object_value_span(lock, cursor, record_end, "source", &source_start, &source_end)
                source_type: mutable darray[u8] = []
                relative_path: mutable darray[u8] = []
                return false if not Json::object_string_value(lock, source_start, source_end, "type", &source_type) or not ByteText::equal_text(source_type, "path")
                return false if not Json::object_string_value(lock, source_start, source_end, "path", &relative_path) or not Manifest::valid_dependency_path(relative_path)
                return false if packages.count > 0.usize() and not ByteText::less(packages[packages.count - 1.usize()].name, package_name)
                relative_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&relative_path, &relative_c)
                relative_name: cstr = (&relative_c[0]).cast[cstr] can Unsafe.PointerCast
                joined_root: mutable darray[u8] = []
                ProjectFiles::path_join_into(root_path, relative_name, &joined_root)
                canonical_root: mutable darray[u8] @r = []
                return false if not ProjectFiles::canonical_existing_path(joined_root, &canonical_root)
                manifest_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(canonical_root, "elisapkg.json", &manifest_path)
                package_manifest: mutable darray[u8] = []
                return false if not Platform::pkg_read_bounded_file(manifest_path, Json::max_document_bytes, &package_manifest)
                actual_name: mutable darray[u8] = []
                actual_version: mutable darray[u8] = []
                return false if not validate_manifest_at(package_manifest, canonical_root, &actual_name, &actual_version)
                return false if not ByteText::equal(actual_name, package_name) or not ByteText::equal(actual_version, package_version)
                manifest_digest_bytes: mutable darray[u8] = []
                manifest_digest: mutable darray[u8] = []
                return false if Integrity::sha256(package_manifest, &manifest_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
                return false if not Lockfile::sha256_field_equals(lock, cursor, record_end, "manifest-digest", manifest_digest)
                source_digest: mutable darray[u8] @r = []
                package_source_bytes: mutable usize = 0.usize()
                return false if total_dependency_source_bytes > source_byte_budget or not SourceFingerprint::at_bounded(canonical_root, &source_digest, source_byte_budget - total_dependency_source_bytes, &package_source_bytes)
                total_dependency_source_bytes <- total_dependency_source_bytes + package_source_bytes
                return false if not Lockfile::sha256_field_equals(lock, cursor, record_end, "source-digest", source_digest)
                registry_roots: mutable darray[Solver::Constraint] = []
                has_local_dependency: mutable bool = false
                return false if not collect_registry_roots(package_manifest, &registry_roots, &has_local_dependency) or registry_roots.count != 0.usize()
                library_entry: mutable darray[u8] @r = []
                relative_entry: mutable darray[u8] @r = []
                return false if not select_unique_library_entry(package_manifest, canonical_root, &library_entry, &relative_entry)
                dependency_names: mutable darray[u8] @r = []
                remaining_edges: usize = MAX_BUILD_GRAPH_EDGES - total_graph_edges
                edge_limit: usize = MAX_DEPENDENCIES if MAX_DEPENDENCIES < remaining_edges else remaining_edges
                package_edges: i64 = Manifest::local_dependency_names(package_manifest, edge_limit, &dependency_names)
                return false if package_edges < 0
                total_graph_edges <- total_graph_edges + package_edges.usize()
                snapshot_entry: mutable darray[u8] @r = []
                dependents: mutable darray[usize] @r = []
                packages.push(LocalBuildGraph::Package{name: package_name, root: canonical_root, entry: library_entry, relative_entry: relative_entry, source_digest: source_digest, snapshot_entry: snapshot_entry, dependency_names: dependency_names, dependents: dependents, remaining_dependencies: 0})
                cursor <- record_end + 1.usize()
                while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
                    cursor <- cursor + 1.usize()
                if cursor < packages_end:
                    return false if lock[cursor] != 44
                    cursor <- cursor + 1.usize()
            if packages.count == 0.usize():
                return true
            has_dependencies <- true
            return LocalBuildGraph::write_ordered_includes(packages, order, root_entry, aggregate)

        def run_build(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                artifact_digest: mutable darray[u8] = []
                return run_build_with_digest(start, options, &artifact_digest)

        def run_build_with_digest(start: darray[u8]&, options: Model::CommandOptions, out_artifact_digest: mutable darray[u8]&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                # Allocate the SHA-256 text output before the build scratch region.
                out_artifact_digest.resize(64.usize())
                status: i64 = build_into_digest(start, options, out_artifact_digest)
                if status != EXIT_OK:
                    out_artifact_digest.resize(0.usize())
                return status

        def build_into_digest(start: darray[u8]&, options: Model::CommandOptions, out_artifact_digest: mutable darray[u8]&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                aggregate_source_name: mutable cstr = ""
                source_snapshot_roots: mutable darray[u8] = []
                source_snapshot_root: mutable darray[u8] = []
                root_snapshot_entry: mutable darray[u8] = []
                root_snapshot_root: mutable darray[u8] = []
                compiler_dependency_aggregate: mutable darray[u8] = []
                snapshot_total_bytes: mutable usize = 0.usize()
                if not Sandbox::build_sandbox_available():
                    CliOutput::write_error("error: compiler builds require the macOS Seatbelt sandbox; builds fail closed on this platform\n")
                    return EXIT_BUILD
                return EXIT_USAGE if not Platform::pkg_cstr_equal(options.profile, "debug") and not Platform::pkg_cstr_equal(options.profile, "release")
                return EXIT_BUILD if not load_package(start)
                manifest_raw: mutable darray[u8] = []
                manifest_raw.resize(1048577)
                return EXIT_BUILD if not ProjectFiles::read_cstr_into("elisapkg.json", &manifest_raw)
                root_name: mutable darray[u8] = []
                root_version: mutable darray[u8] = []
                return EXIT_BUILD if not validate_manifest_at(manifest_raw, start, &root_name, &root_version)
                manifest_digest_bytes: mutable darray[u8] = []
                manifest_digest: mutable darray[u8] = []
                return EXIT_BUILD if Integrity::sha256(manifest_raw, &manifest_digest_bytes) != Integrity::DigestCode.Ok
                return EXIT_BUILD if not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
                target_name: mutable darray[u8] = []
                target_kind: mutable darray[u8] = []
                target_entry: mutable darray[u8] = []
                return EXIT_BUILD if not ManifestTargets::select_target(manifest_raw, options.target_name, options.target_kind, &target_name, &target_kind, &target_entry)
                is_library: bool = ByteText::equal_text(target_kind, "lib")
                return EXIT_BUILD if not (is_library or ByteText::equal_text(target_kind, "bin") or ByteText::equal_text(target_kind, "test"))
                target_entry_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&target_entry, &target_entry_c)
                target_resolved_buffer: mutable darray[u8] = []
                target_resolved_buffer.resize(4096)
                target_entry_raw: cstr = (&target_entry_c[0]).cast[cstr] can Unsafe.PointerCast
                target_entry_name: mutable cstr = ""
                if Platform::pkg_realpath(target_entry_raw, &target_resolved_buffer) is resolved_target:
                    target_entry_name <- resolved_target
                else:
                    return EXIT_BUILD
                lock_status: i64 = run_resolve(start, options, false, false)
                return lock_status if lock_status != EXIT_OK
                lock_raw: mutable darray[u8] = []
                lock_raw.resize(1048577)
                return EXIT_BUILD if not ProjectFiles::read_cstr_into("elisapkg.lock", &lock_raw)
                # Resolution reads the manifest again and may replace the lock. Bind
                # both results to the exact manifest snapshot used above to select the
                # target and compute its receipt, before trusting registry evidence or
                # starting the compiler.
                manifest_after_resolve: mutable darray[u8] = []
                manifest_after_resolve.resize(1048577)
                return EXIT_BUILD if not ProjectFiles::read_cstr_into("elisapkg.json", &manifest_after_resolve)
                return EXIT_BUILD if not ByteText::equal(manifest_after_resolve, manifest_raw)
                return EXIT_BUILD if not lock_matches_manifest(manifest_raw, lock_raw, root_name, root_version, start)
                if Lockfile::version_is(lock_raw, 3):
                    CliOutput::write_error("error: builds with registry dependencies are not supported; local dependency builds require a version 2 local lock\n")
                    return EXIT_BUILD
                lock_digest_bytes: mutable darray[u8] = []
                lock_digest: mutable darray[u8] = []
                return EXIT_BUILD if Integrity::sha256(lock_raw, &lock_digest_bytes) != Integrity::DigestCode.Ok
                return EXIT_BUILD if not Integrity::hex_digest(lock_digest_bytes, &lock_digest)
                source_tree_digest: mutable darray[u8] = []
                source_tree_bytes: mutable usize = 0.usize()
                if not SourceFingerprint::current_bounded(&source_tree_digest, SourceFingerprint::maximum_snapshot_bytes, &source_tree_bytes):
                    CliOutput::write_error("error: package source tree is unreadable, unsafe, or exceeds the supported source-size limits; refusing to build\n")
                    return EXIT_BUILD
                dependency_aggregate: mutable darray[u8] = []
                dependency_aggregate_digest: mutable darray[u8] = []
                has_local_build_dependencies: mutable bool = false
                region build_state(67108864):
                    # Retain package records and their nested buffers after the planner
                    # returns by tying allocations to the caller's output region.
                    dependency_packages: mutable darray[LocalBuildGraph::Package] @build_state = []
                    dependency_order: mutable darray[usize] @build_state = []
                    source_snapshot_container_storage: mutable darray[u8] @build_state = []
                    source_snapshot_container_name: mutable cstr = ""
                    if source_tree_bytes > SourceFingerprint::maximum_snapshot_bytes or not build_local_dependency_aggregate(lock_raw, start, target_entry_name, SourceFingerprint::maximum_snapshot_bytes - source_tree_bytes, &dependency_aggregate, &has_local_build_dependencies, dependency_packages, dependency_order):
                        CliOutput::write_error("error: local dependency graph is invalid, unreadable, or exceeds the combined source-size limits; refusing to compile an incomplete graph\n")
                        return EXIT_BUILD
                    if has_local_build_dependencies:
                        dependency_aggregate_digest_bytes: mutable darray[u8] = []
                        if Integrity::sha256(dependency_aggregate, &dependency_aggregate_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(dependency_aggregate_digest_bytes, &dependency_aggregate_digest):
                            CliOutput::write_error("error: unable to fingerprint the verified dependency aggregate\n")
                            return EXIT_BUILD
                    if PackageSelection::publish_path_forbidden(target_entry):
                        CliOutput::write_error("error: selected target entry is not a safe package source path\n")
                        return EXIT_BUILD
                    target_source: mutable darray[u8] = []
                    target_source_size: i64 = Platform::pkg_package_file_size(target_entry_raw)
                    return EXIT_BUILD if target_source_size < 0 or target_source_size > 67108864
                    target_source.resize(target_source_size.usize() + 1.usize())
                    target_source_raw: mutable u8& = (&target_source[0]).cast[mutable u8&] can Unsafe.PointerCast
                    target_source_read: i64 = Platform::pkg_read_package_file(target_entry_raw, target_source_raw, target_source.count)
                    return EXIT_BUILD if target_source_read < 0 or target_source_read != target_source_size
                    target_source.resize(target_source_read.usize())
                    source_digest_bytes: mutable darray[u8] = []
                    source_digest: mutable darray[u8] = []
                    return EXIT_BUILD if Integrity::sha256(target_source, &source_digest_bytes) != Integrity::DigestCode.Ok
                    return EXIT_BUILD if not Integrity::hex_digest(source_digest_bytes, &source_digest)
                    build_dir: mutable darray[u8] = []
                    artifact: mutable darray[u8] = []
                    receipt_path: mutable darray[u8] = []
                    build_dir <- Build::output_directory(start, Platform::pkg_cstr_equal(options.profile, "release"))
                    artifact_label: darray[u8] = ManifestTargets::artifact_leaf(target_name, is_library)
                    artifact_leaf_storage: mutable darray[u8] = []
                    ProjectFiles::path_with_nul_into(artifact_label, &artifact_leaf_storage)
                    artifact_leaf: cstr = (&artifact_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
                    emit_kind: cstr = "obj" if is_library else "exe"
                    artifact_access_mode: i64 = 0 if is_library else 1
                    ProjectFiles::path_join_into(build_dir, artifact_leaf, &artifact)
                    receipt_label: darray[u8] = ManifestTargets::receipt_leaf(target_name)
                    receipt_leaf_storage: mutable darray[u8] = []
                    ProjectFiles::path_with_nul_into(receipt_label, &receipt_leaf_storage)
                    receipt_leaf: cstr = (&receipt_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
                    ProjectFiles::path_join_into(build_dir, receipt_leaf, &receipt_path)
                    return EXIT_BUILD if not ProjectFiles::make_directory(&build_dir)
                    compiler: mutable cstr = "elisac-stage1"
                    if Platform::pkg_getenv("ELISAPKG_COMPILER") is configured:
                        compiler <- configured.cast[cstr]
                    return EXIT_BUILD if not Toolchain::valid_compiler_argument(compiler)
                    resolved_compiler_path: mutable darray[u8] = []
                    if not Toolchain::resolve_build_compiler(compiler, &resolved_compiler_path):
                        CliOutput::write_error("error: selected compiler was not found as an executable on the isolated build PATH\n")
                        return EXIT_BUILD
                    resolved_compiler_storage: mutable darray[u8] = []
                    ProjectFiles::path_with_nul_into(resolved_compiler_path, &resolved_compiler_storage)
                    compiler <- (&resolved_compiler_storage[0]).cast[cstr] can Unsafe.PointerCast
                    # Capture only the compiler settings needed by the wrapper. The child is
                    # started with a scrubbed environment so registry credentials and unrelated
                    # user variables cannot reach compile-time execution.
                    stage1_bin: mutable cstr = ""
                    runtime_obj: mutable cstr = ""
                    allow_stale: mutable cstr = ""
                    clang_tool: mutable cstr = ""
                    if Platform::pkg_getenv("ELISA_STAGE1_BIN") is configured_stage1:
                        stage1_bin <- configured_stage1.cast[cstr]
                    if Platform::pkg_getenv("ELISA_RUNTIME_OBJ") is configured_runtime:
                        runtime_obj <- configured_runtime.cast[cstr]
                    if Platform::pkg_getenv("ELISA_ALLOW_STALE_STAGE1") is configured_stale:
                        allow_stale <- configured_stale.cast[cstr]
                    if Platform::pkg_getenv("ELISA_CLANG") is configured_clang:
                        clang_tool <- configured_clang.cast[cstr]
                    return EXIT_BUILD if not Toolchain::valid_toolchain_value(stage1_bin, 4096.usize()) or not Toolchain::valid_toolchain_value(runtime_obj, 4096.usize()) or not Toolchain::valid_toolchain_value(allow_stale, 64.usize()) or not Toolchain::valid_toolchain_value(clang_tool, 4096.usize())
                    compiler_executable: mutable cstr = compiler
                    compiler_is_stage1_wrapper: bool = Toolchain::stage1_wrapper_pair_matches(compiler, stage1_bin)
                    if compiler_is_stage1_wrapper and stage1_bin[0].u8() != 0:
                        compiler_executable <- stage1_bin
                    home_name: mutable cstr = ""
                    if Platform::pkg_getenv("HOME") is configured_home:
                        home_name <- configured_home.cast[cstr]
                    else:
                        CliOutput::write_error("error: HOME must name an existing directory to construct the build sandbox\n")
                        return EXIT_BUILD
                    dependency_roots: mutable darray[u8] = []
                    return EXIT_BUILD if not sandbox_dependency_roots(lock_raw, start, &dependency_roots)
                    tool_paths: mutable darray[cstr] = []
                    if not compiler_is_stage1_wrapper:
                        tool_paths.push(compiler)
                    tool_paths.push(stage1_bin)
                    tool_paths.push(runtime_obj)
                    executable_paths: mutable darray[cstr] = []
                    if not compiler_is_stage1_wrapper:
                        executable_paths.push(compiler)
                    executable_paths.push(stage1_bin)
                    if clang_tool[0].u8() != 0:
                        tool_paths.push(clang_tool)
                        executable_paths.push(clang_tool)
                    for candidate_index in 0..<3 |tool_paths, executable_paths|:
                        if clang_tool[0].u8() == 0:
                            candidate: mutable cstr = "/opt/homebrew/opt/llvm/bin/clang"
                            if candidate_index == 1:
                                candidate <- "/usr/local/opt/llvm/bin/clang"
                            elif candidate_index == 2:
                                candidate <- "/usr/bin/clang"
                            candidate_real: mutable darray[u8] = []
                            candidate_real.resize(4096)
                            if Platform::pkg_realpath(candidate, &candidate_real) is resolved_candidate:
                                if Platform::pkg_access(resolved_candidate, 1) == 0:
                                    tool_paths.push(candidate)
                                    executable_paths.push(candidate)
                                    clang_tool <- candidate
                    compiler_identity: mutable darray[u8] = []
                    stage1_identity: mutable darray[u8] = []
                    runtime_identity: mutable darray[u8] = []
                    clang_identity: mutable darray[u8] = []
                    compiler_identity_ok: bool = tool_file_identity(compiler, true, true, &compiler_identity)
                    stage1_identity_ok: bool = tool_file_identity(stage1_bin, false, true, &stage1_identity)
                    runtime_identity_ok: bool = tool_file_identity(runtime_obj, false, false, &runtime_identity)
                    clang_identity_ok: bool = tool_file_identity(clang_tool, false, true, &clang_identity)
                    sdk_root: mutable darray[u8] = []
                    developer_dir: mutable darray[u8] = []
                    if not Platform::pkg_macos_toolchain_paths(&sdk_root, &developer_dir):
                        CliOutput::write_error("error: could not locate a supported macOS SDK and developer directory for the compiler sandbox\n")
                        return EXIT_BUILD
                    sdk_settings_path: mutable darray[u8] = []
                    sdk_settings_path_c: mutable darray[u8] = []
                    sdk_settings_name: mutable cstr = ""
                    if sdk_root.count > 0.usize():
                        ByteText::append(&sdk_settings_path, sdk_root)
                        ByteText::append_text(&sdk_settings_path, "/SDKSettings.json")
                        ProjectFiles::path_with_nul_into(sdk_settings_path, &sdk_settings_path_c)
                        sdk_settings_name <- (&sdk_settings_path_c[0]).cast[cstr] can Unsafe.PointerCast
                    sdk_identity: mutable darray[u8] = []
                    sdk_identity_ok: bool = tool_file_identity(sdk_settings_name, sdk_root.count == 0.usize(), false, &sdk_identity)
                    developer_linker_path: mutable darray[u8] = []
                    developer_linker_path_c: mutable darray[u8] = []
                    developer_linker_name: mutable cstr = ""
                    developer_assembler_path: mutable darray[u8] = []
                    developer_assembler_path_c: mutable darray[u8] = []
                    developer_assembler_name: mutable cstr = ""
                    if developer_dir.count > 0.usize():
                        ByteText::append(&developer_linker_path, developer_dir)
                        ByteText::append(&developer_assembler_path, developer_dir)
                        if ByteText::equal_text(developer_dir, "/Library/Developer/CommandLineTools"):
                            ByteText::append_text(&developer_linker_path, "/usr/bin/ld")
                            ByteText::append_text(&developer_assembler_path, "/usr/bin/as")
                        elif ByteText::equal_text(developer_dir, "/Applications/Xcode.app/Contents/Developer"):
                            ByteText::append_text(&developer_linker_path, "/Toolchains/XcodeDefault.xctoolchain/usr/bin/ld")
                            ByteText::append_text(&developer_assembler_path, "/Toolchains/XcodeDefault.xctoolchain/usr/bin/as")
                        else:
