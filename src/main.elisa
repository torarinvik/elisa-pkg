                        return EXIT_BUILD
                    if not BuildSnapshots::remove_aggregate(aggregate_source_name):
                        _ = Platform::pkg_unlink(temp_name)
                        _ = BuildSnapshots::remove_all(source_snapshot_container_name, source_snapshot_roots)
                        CliOutput::write_error("error: unable to remove the private dependency aggregate source\n")
                        return EXIT_BUILD
                    if Platform::pkg_rmdir(sandbox_work_name) != 0:
                        _ = Platform::pkg_unlink(temp_name)
                        _ = BuildSnapshots::remove_all(source_snapshot_container_name, source_snapshot_roots)
                        CliOutput::write_error("error: compiler left files in its private scratch directory; refusing to publish the build result\n")
                        return EXIT_BUILD
                    if not BuildSnapshots::remove_all(source_snapshot_container_name, source_snapshot_roots):
                        _ = Platform::pkg_unlink(temp_name)
