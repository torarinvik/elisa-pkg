                        out_artifact_digest[digest_index] <- artifact_digest[digest_index]
                    _ = options
                    return EXIT_OK

        def set_callback_path_pid(value: mutable darray[u8]&, digits_offset: usize, process_id: i64) -> bool:
            return false if process_id <= 0 or digits_offset + 22.usize() >= value.count
            digits: mutable darray[u8] = []
            remaining: mutable u64 = process_id.u64()
            while remaining > 0.u64() |digits, remaining|:
                digits.push((48.u64() + (remaining % 10.u64())).u8())
                remaining <- remaining / 10.u64()
            return false if digits.count == 0.usize() or digits.count > 20.usize()
            for index in 0..<digits.count |value, digits, digits_offset|:
                value[digits_offset + index] <- digits[digits.count - index - 1.usize()]
            value[digits_offset + digits.count] <- 46
            value[digits_offset + digits.count + 1.usize()] <- 99
            value[digits_offset + digits.count + 2.usize()] <- 0
            return true

        def forward_fd_output(fd: i64, target: i64) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global.Read:
                return false if Platform::pkg_seek_fd(fd, 0, 0) < 0
                total: mutable i64 = 0
                buffer: mutable darray[u8] = []
                buffer.resize(8192)
                while total < 134217728 |total, buffer, fd, target|:
                    raw: mutable u8& = (&buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
                    capacity: mutable usize = 8192.usize()
                    if 134217728 - total < capacity.i64():
                        capacity <- (134217728 - total).usize()
                    amount: i64 = Platform::pkg_read_fd(fd, raw, capacity)
                    return false if amount < 0 or amount > capacity.i64()
                    break if amount == 0
                    buffer.resize(amount.usize())
                    CliOutput::write_bytes(target, &buffer)
                    total <- total + amount
                    buffer.resize(8192)
                return true

        def run_program(argc: i64, slots: mutable cstr&&, options: Model::CommandOptions, expected_kind: cstr) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                manifest_raw: mutable darray[u8] = []
                manifest_raw.resize(1048577)
                return EXIT_BUILD if not ProjectFiles::read_cstr_into("elisapkg.json", &manifest_raw)
                target_name: mutable darray[u8] = []
                target_kind: mutable darray[u8] = []
                target_entry: mutable darray[u8] = []
                return EXIT_BUILD if not ManifestTargets::select_target(manifest_raw, options.target_name, options.target_kind, &target_name, &target_kind, &target_entry)
                if not ByteText::equal_text(target_kind, expected_kind):
                    CliOutput::write_error("error: selected target does not produce an executable\n")
                    return EXIT_BUILD
                artifact_label: darray[u8] = ManifestTargets::artifact_leaf(target_name, false)
                artifact_leaf_storage: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(artifact_label, &artifact_leaf_storage)
                artifact_leaf: cstr = (&artifact_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
                current_directory: darray[u8] = []
                build_root: darray[u8] = Build::output_directory(current_directory, Platform::pkg_cstr_equal(options.profile, "release"))
                artifact_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(build_root, artifact_leaf, &artifact_path)
                artifact_path_c: mutable darray[u8] = []
                ProjectFiles::path_with_nul_into(&artifact_path, &artifact_path_c)
                artifact_name: cstr = (&artifact_path_c[0]).cast[cstr] can Unsafe.PointerCast
                args: mutable darray[cstr] = []
                args.push("/usr/bin/env")
                args.push("-i")
                args.push(Toolchain::isolated_path_environment)
                args.push(artifact_name)
                index: mutable i64 = 2
                while index < argc and not Platform::pkg_cstr_equal(slots[index].cast[cstr], "--") |slots, index|:
                    index <- index + 1
                index <- index + 1 if index < argc and Platform::pkg_cstr_equal(slots[index].cast[cstr], "--")
                while index < argc |args, slots, index|:
                    args.push(slots[index].cast[cstr])
                    index <- index + 1
                args.push(null)
                child_argv: mutable cstr&& = (&args[0]).cast[mutable cstr&&] can Unsafe.PointerCast
                pid: i64 = Platform::pkg_fork()
                if pid == 0:
                    if Platform::pkg_set_process_group() != 0:
                        Platform::pkg_process_exit(126)
                    if Platform::pkg_set_process_limits(2) != 0:
                        Platform::pkg_process_exit(126)
                    # Package code must not inherit file, socket, or credential-agent
                    # descriptors supplied by the invoking process. Preserve only the
                    # standard streams and stop if the close sweep cannot prove cleanup.
                    if Platform::pkg_close_inherited_fds() != 0:
                        Platform::pkg_process_exit(126)
                    _ = Platform::pkg_execvp("/usr/bin/env", child_argv)
                    Platform::pkg_process_exit(127)
                return EXIT_BUILD if pid < 0
                status: mutable i32 = 0
                waited: i64 = Platform::pkg_waitpid_group_timeout(pid, &status, PROGRAM_TIMEOUT_MS)
                return EXIT_CANCEL if waited == Platform::pkg_timeout_error()
                return EXIT_BUILD if waited < 0
                # waitpid returns the platform wait status. Preserve a normal child's exit
                # code for `run`, and map signal termination to the documented cancellation
                # status instead of exposing the platform-specific wait encoding.
                return status.i64() / 256.i64() if status % 256 == 0
                return EXIT_CANCEL

        # ---------- command line --------------------------------------------------------------

        def cli_main(argc: i64, argv: mutable void&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                slots: mutable cstr&& = argv.cast[mutable cstr&&]
                CliOutput::configure(false, false)
                quiet: mutable bool = false
                if argc <= 1:
                    CliOutput::usage()
                    return EXIT_USAGE
                command: cstr = slots[1].cast[cstr]
                if Platform::pkg_cstr_equal(command, "--help") or Platform::pkg_cstr_equal(command, "-h"):
                    CliOutput::usage()
                    return EXIT_OK
                if Platform::pkg_cstr_equal(command, "--version"):
                    CliOutput::write_ok("elisapkg 0.1.0\n")
                    return EXIT_OK
                if Platform::pkg_cstr_equal(command, "init"):
                    init_slots: mutable darray[cstr] = []
                    init_argc: i64 = CliArguments::compact_output_modes(argc, slots, &init_slots, &quiet)
                    CliOutput::configure(quiet, false)
                    return EXIT_USAGE if init_argc < 0
                    return run_init(init_argc, (&init_slots[0]).cast[mutable cstr&&] can Unsafe.PointerCast)
                manifest_path: mutable darray[u8] = []
                has_manifest_path: mutable bool = false
                scan_index: mutable i64 = 2
                while scan_index < argc |slots, manifest_path, has_manifest_path, scan_index|:
                    scan_flag: cstr = slots[scan_index].cast[cstr]
                    break if Platform::pkg_cstr_equal(scan_flag, "--")
                    if Platform::pkg_cstr_equal(scan_flag, "--manifest-path"):
                        return EXIT_USAGE if has_manifest_path or scan_index + 1 >= argc
                        ByteText::append_bounded_text(&manifest_path, slots[scan_index + 1].cast[cstr])
                        return EXIT_USAGE if manifest_path.count == 0.usize() or manifest_path.count > 4096.usize()
                        has_manifest_path <- true
                        scan_index <- scan_index + 2
                    else:
                        scan_index <- scan_index + 1
                if has_manifest_path:
                    return EXIT_USAGE if manifest_path.count == 0.usize() or not change_to_manifest_path(&manifest_path)
                effective_argc: mutable i64 = argc
                effective_slots: mutable cstr&& = slots
                compacted: mutable darray[cstr] = []
                if has_manifest_path:
                    effective_argc <- CliArguments::compact_manifest_args(argc, slots, &compacted, &quiet)
                    CliOutput::configure(quiet, false)
                    return EXIT_USAGE if effective_argc <= 0
                    effective_slots <- (&compacted[0]).cast[mutable cstr&&] can Unsafe.PointerCast
                if Platform::pkg_cstr_equal(command, "add") or Platform::pkg_cstr_equal(command, "remove") or Platform::pkg_cstr_equal(command, "update"):
                    mutation_slots: mutable darray[cstr] = []
                    mutation_argc: i64 = CliArguments::compact_manifest_args(argc, slots, &mutation_slots, &quiet)
                    CliOutput::configure(quiet, false)
                    return EXIT_USAGE if mutation_argc < 0
                    mutation_effective_slots: mutable cstr&& = (&mutation_slots[0]).cast[mutable cstr&&] can Unsafe.PointerCast
                    return run_add(mutation_argc, mutation_effective_slots) if Platform::pkg_cstr_equal(command, "add")
                    return run_remove(mutation_argc, mutation_effective_slots) if Platform::pkg_cstr_equal(command, "remove")
                    return run_update(mutation_argc, mutation_effective_slots)
                return EXIT_SECURITY if not ProjectTransaction::recover()
                # `.` means the process working directory and keeps path operations on a
                # non-empty, well-defined byte buffer.
                start: mutable darray[u8] = [46]
                options: mutable Model::CommandOptions = Model::CommandOptions{locked: false, offline: false, frozen: false, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                publish_dry_run: mutable bool = false
                flags_ok: bool = CliArguments::read_common_flags(effective_argc, effective_slots, command, &options, &quiet, &publish_dry_run)
                CliOutput::configure(quiet, options.json)
                if not flags_ok:
                    CliOutput::write_error("error: unknown option; run `elisapkg --help`\n")
                    return EXIT_USAGE
                parsed_options: mutable darray[cstr] = []
                parsed_argc: i64 = CliArguments::compact_validated_global_options(effective_argc, effective_slots, &parsed_options)
                return EXIT_USAGE if parsed_argc < 0
                effective_argc <- parsed_argc
                dispatch_slots: mutable cstr&& = (&parsed_options[0]).cast[mutable cstr&&] can Unsafe.PointerCast
                CliArguments::read_target_flags(effective_argc, dispatch_slots, command, &options)
                if Platform::pkg_cstr_equal(command, "check-manifest"):
                    return run_check(&start, options)
                if Platform::pkg_cstr_equal(command, "resolve"):
                    return run_resolve(&start, options, false, true)
                if Platform::pkg_cstr_equal(command, "tree"):
                    return run_tree(&start, options)
                if Platform::pkg_cstr_equal(command, "why"):
                    return run_why(effective_argc, dispatch_slots, &start, options)
                if Platform::pkg_cstr_equal(command, "metadata"):
                    return run_metadata(&start, options)
                if Platform::pkg_cstr_equal(command, "doctor"):
                    return run_doctor()
                if Platform::pkg_cstr_equal(command, "fetch"):
                    return run_fetch(effective_argc, dispatch_slots, &start, options)
                if Platform::pkg_cstr_equal(command, "publish"):
                    return run_publish_dry_run(start, options) if publish_dry_run
                    return run_publish()
                if Platform::pkg_cstr_equal(command, "install"):
                    return run_install(effective_argc, dispatch_slots, &start, options)
                if Platform::pkg_cstr_equal(command, "uninstall"):
                    return run_uninstall(effective_argc, dispatch_slots)
                if Platform::pkg_cstr_equal(command, "clean"):
                    return run_clean()
                if Platform::pkg_cstr_equal(command, "cache") and effective_argc == 3 and Platform::pkg_cstr_equal(effective_slots[2].cast[cstr], "verify"):
                    return run_cache_verify(&start)
                if Platform::pkg_cstr_equal(command, "cache"):
                    return run_cache_gc(effective_argc, dispatch_slots)
                if Platform::pkg_cstr_equal(command, "package"):
                    return run_package(effective_argc, dispatch_slots, &start)
                if Platform::pkg_cstr_equal(command, "build") or Platform::pkg_cstr_equal(command, "run") or Platform::pkg_cstr_equal(command, "test"):
                    return run_build(&start, options) if Platform::pkg_cstr_equal(command, "build")
                    if Platform::pkg_cstr_equal(command, "run"):
                        build_status: i64 = run_build(&start, options)
                        return build_status if build_status != EXIT_OK
                        return run_program(effective_argc, dispatch_slots, options, "bin")
                    return run_test(effective_argc, dispatch_slots, &start, options)
                CliOutput::write_error("error: unknown command; run `elisapkg --help`\n")
                return EXIT_USAGE

    public:
        # The only public command surface. Platform, model, and trust-policy
        # implementation details are intentionally absent from this contract.
        def run(argc: i64, argv: mutable void&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return cli_main(argc, argv)

def main(argc: i64, argv: mutable void&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    can Global{Read,Write}:
        status: i64 = Cli::run(argc, argv)
        Platform::pkg_process_exit(status)
        return status
