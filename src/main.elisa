                    developer_assembler_identity: mutable darray[u8] = []
                    developer_linker_identity_ok: bool = tool_file_identity(developer_linker_name, sdk_root.count == 0.usize(), true, &developer_linker_identity)
                    developer_assembler_identity_ok: bool = tool_file_identity(developer_assembler_name, sdk_root.count == 0.usize(), true, &developer_assembler_identity)
                    toolchain_identity_ok: bool = compiler_identity_ok and stage1_identity_ok and runtime_identity_ok and clang_identity_ok and sdk_identity_ok and developer_linker_identity_ok and developer_assembler_identity_ok

