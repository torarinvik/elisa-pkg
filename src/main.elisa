                            return EXIT_BUILD
                        aggregate_source_name <- (&aggregate_source_template[0]).cast[cstr] can Unsafe.PointerCast
                        aggregate_path_length: usize = Platform::pkg_strlen(aggregate_source_name)
                        for index in 0..<aggregate_path_length |aggregate_source_path, aggregate_source_template|:
                            aggregate_source_path.push(aggregate_source_template[index])
                        if not ProjectFiles::write_fd_all(aggregate_fd, compiler_dependency_aggregate):
