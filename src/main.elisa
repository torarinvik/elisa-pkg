                        return EXIT_BUILD
                    if compiler_stderr_fd < 3:
                        raised_stderr_fd: i64 = Platform::pkg_dup_fd_min(compiler_stderr_fd, 3)
                        if raised_stderr_fd < 0:
                            _ = Platform::pkg_close(compiler_stderr_fd)
                            _ = Platform::pkg_close(compiler_stdout_fd)
                            _ = Platform::pkg_unlink((&stderr_template[0]).cast[cstr] can Unsafe.PointerCast)
                            _ = Platform::pkg_unlink(compiler_stdout_name)
                            _ = Platform::pkg_unlink(temp_name)
