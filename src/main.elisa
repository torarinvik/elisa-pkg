                        cached_artifact: mutable darray[u8] = []
                        cached_receipt: mutable darray[u8] = []
                        cached_receipt.resize(4096)
                        if read_package_file_into(&artifact, &cached_artifact) and ProjectFiles::read_cstr_into(receipt_name, &cached_receipt):
