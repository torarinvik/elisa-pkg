        value_end <- value_end + 1.usize()
    parsed: mutable u64 = 0
    return json_unsigned_at(raw, value_start, value_end, &parsed) and parsed == wanted

def valid_direct_field_set(raw: darray[u8]&, object_start: usize, object_end: usize, set_kind: i64) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if object_start >= object_end or raw[object_start] != 123
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    braces: mutable i64 = 1
    brackets: mutable i64 = 0
    for index in (object_start + 1.usize())..<object_end |raw, in_string, escaped, string_start, braces, brackets|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
            elif byte == 123:
                braces <- braces + 1
            elif byte == 125:
                braces <- braces - 1
            elif byte == 91:
                brackets <- brackets + 1
            elif byte == 93:
                brackets <- brackets - 1
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < object_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            if braces == 1 and brackets == 0 and after < object_end and raw[after] == 58:
                key: mutable darray[u8] = []
                for key_index in string_start..<index |key, raw|:
                    key.push(raw[key_index])
                allowed: bool = false
                if set_kind == 1:
                    allowed <- bytes_equal_view(key, "name") or bytes_equal_view(key, "version") or bytes_equal_view(key, "description") or bytes_equal_view(key, "license") or bytes_equal_view(key, "elisa")
                elif set_kind == 2:
                    allowed <- bytes_equal_view(key, "name") or bytes_equal_view(key, "kind") or bytes_equal_view(key, "entry")
                elif set_kind == 3:
                    allowed <- bytes_equal_view(key, "lock-version") or bytes_equal_view(key, "resolver") or bytes_equal_view(key, "package") or bytes_equal_view(key, "packages")
                elif set_kind == 4:
                    allowed <- bytes_equal_view(key, "name") or bytes_equal_view(key, "version") or bytes_equal_view(key, "source") or bytes_equal_view(key, "archive-size") or bytes_equal_view(key, "archive-digest") or bytes_equal_view(key, "metadata-digest")
                elif set_kind == 5:
                    allowed <- bytes_equal_view(key, "type") or bytes_equal_view(key, "registry") or bytes_equal_view(key, "archive")
                elif set_kind == 6:
                    allowed <- bytes_equal_view(key, "name") or bytes_equal_view(key, "version") or bytes_equal_view(key, "manifest-digest") or bytes_equal_view(key, "source-digest")
                elif set_kind == 7:
                    allowed <- bytes_equal_view(key, "path")
                elif set_kind == 8:
                    allowed <- bytes_equal_view(key, "registry") or bytes_equal_view(key, "version")
                return false if not allowed
            in_string <- false
    return true

def bytes_less(left: darray[u8]&, right: darray[u8]&) -> bool:
    limit: usize = left.count if left.count < right.count else right.count
    for index in 0..<limit |left, right|:
        return true if left[index] < right[index]
        return false if left[index] > right[index]
    return left.count < right.count

def slice_equals_array(raw: darray[u8]&, start: usize, end: usize, wanted: darray[u8]&) -> bool:
    return false if end < start or end - start != wanted.count
    for index in 0..<wanted.count |raw, wanted|:
        return false if raw[start + index] != wanted[index]
    return true

def slice_less_slice(raw: darray[u8]&, left_start: usize, left_end: usize, right_start: usize, right_end: usize) -> bool:
    left_count: usize = left_end - left_start
    right_count: usize = right_end - right_start
    limit: usize = left_count if left_count < right_count else right_count
    for index in 0..<limit |raw|:
        return true if raw[left_start + index] < raw[right_start + index]
        return false if raw[left_start + index] > raw[right_start + index]
    return left_count < right_count

def emitted_contains_slice(emitted: darray[u8]&, raw: darray[u8]&, wanted_start: usize, wanted_end: usize) -> bool:
    cursor: mutable usize = 0.usize()
    while cursor < emitted.count:
        end: mutable usize = cursor
        while end < emitted.count and emitted[end] != 0 |emitted, end|:
            end <- end + 1.usize()
        if end - cursor == wanted_end - wanted_start:
            equal: mutable bool = true
            for index in 0..<(wanted_end - wanted_start) |emitted, raw, equal|:
                equal <- false if emitted[cursor + index] != raw[wanted_start + index]
            return true if equal
        cursor <- end + 1.usize()
    return false

def direct_dependency_count(raw: darray[u8]&, dependency_start: usize, dependency_end: usize) -> usize:
    count: mutable usize = 0.usize()
    in_string: mutable bool = false
    escaped: mutable bool = false
    braces: mutable i64 = 1
    brackets: mutable i64 = 0
    for index in (dependency_start + 1.usize())..<dependency_end |raw, count, in_string, escaped, braces, brackets|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
            elif byte == 123:
                braces <- braces + 1
            elif byte == 125:
                braces <- braces - 1
            elif byte == 91:
                brackets <- brackets + 1
            elif byte == 93:
                brackets <- brackets - 1
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            count <- count + 1.usize() if braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58
            in_string <- false
    return count

def queue_append_field(queue: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    for index in 0..<value.count |queue, value|:
        queue.push(value[index])
    queue.push(0)

def queue_append_record(queue: mutable darray[u8]&, path: darray[u8]&, name: darray[u8]&, version: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    queue_append_field(queue, path)
    queue_append_field(queue, name)
    queue_append_field(queue, version)

def queue_field_at(queue: darray[u8]&, record: usize, field: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    out.resize(0)
    cursor: mutable usize = 0.usize()
    current_record: mutable usize = 0.usize()
    while cursor < queue.count |queue, cursor, current_record, out|:
        for current_field in 0..<3 |queue, cursor, current_record, current_field, out|:
            end: mutable usize = cursor
            while end < queue.count and queue[end] != 0 |queue, end|:
                end <- end + 1.usize()
            if current_record == record and current_field == field:
                for index in cursor..<end |queue, out|:
                    out.push(queue[index])
                return true
            cursor <- end + 1.usize()
        current_record <- current_record + 1.usize()
    return false

def queue_name_record(queue: darray[u8]&, total: usize, wanted: darray[u8]&) -> usize can[Memory.Allocate, Abort.Panic]:
    for record in 0..<total |queue, wanted|:
        candidate: mutable darray[u8] = []
        return record if queue_field_at(queue, record, 1, &candidate) and bytes_equal(candidate, wanted)
    return total

def append_local_dependency_records(raw: darray[u8]&, package_root: darray[u8]&, queue: mutable darray[u8]&, parents: mutable darray[usize]&, total: mutable usize&, parent: usize) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    dependency_start: usize = json_key_value_offset(raw, "dependencies")
    return true if dependency_start >= raw.count
    dependency_end: usize = json_object_end(raw, dependency_start)
    return false if dependency_end <= dependency_start or raw[dependency_start] != 123
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    braces: mutable i64 = 1
    brackets: mutable i64 = 0
    for index in (dependency_start + 1.usize())..<dependency_end |raw, package_root, queue, total, in_string, escaped, string_start, braces, brackets|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
            elif byte == 123:
                braces <- braces + 1
            elif byte == 125:
                braces <- braces - 1
            elif byte == 91:
                brackets <- brackets + 1
            elif byte == 93:
                brackets <- brackets - 1
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            if braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58:
                alias: mutable darray[u8] = []
                for key_index in string_start..<index |alias, raw|:
                    alias.push(raw[key_index])
                return false if not valid_package_name(alias)
                object_start: mutable usize = after + 1.usize()
                while object_start < dependency_end and (raw[object_start] == 32 or raw[object_start] == 9 or raw[object_start] == 10 or raw[object_start] == 13) |raw, object_start|:
                    object_start <- object_start + 1.usize()
                object_end: usize = json_object_end(raw, object_start)
                return false if object_start >= dependency_end or object_end <= object_start or raw[object_start] != 123 or object_end > dependency_end
                dep_path: mutable darray[u8] = []
                return false if not object_string_value(raw, object_start, object_end, "path", &dep_path)
                return false if not valid_dependency_path(dep_path)
                parent_root: mutable darray[u8] = []
                if package_root.count > 0.usize() and not (package_root.count == 1.usize() and package_root[0] == 46):
                    for root_index in 0..<package_root.count |parent_root, package_root|:
                        parent_root.push(package_root[root_index])
                dep_path_c: mutable darray[u8] = []
                path_with_nul_into(&dep_path, &dep_path_c)
                dep_path_name: cstr = (&dep_path_c[0]).cast[cstr] can Unsafe.PointerCast
                child_root_raw: mutable darray[u8] = []
                path_join_into(&parent_root, dep_path_name, &child_root_raw)
                child_root: mutable darray[u8] = []
                return false if not normalize_relative_path(&child_root_raw, &child_root)
                child_name: mutable darray[u8] = []
                child_version: mutable darray[u8] = []
                return false if not load_package_at(&child_root, &child_name, &child_version)
                return false if not bytes_equal(alias, child_name)
                ancestor: mutable usize = parent
                while ancestor < total |queue, parents, total, ancestor, child_root|:
                    ancestor_path: mutable darray[u8] = []
                    return false if not queue_field_at(queue, ancestor, 0, &ancestor_path)
                    return false if bytes_equal(ancestor_path, child_root)
                    return false if ancestor >= parents.count
                    ancestor <- parents[ancestor]
                existing: usize = queue_name_record(queue, total, child_name)
                if existing < total:
                    existing_path: mutable darray[u8] = []
                    existing_version: mutable darray[u8] = []
                    return false if not queue_field_at(queue, existing, 0, &existing_path) or not queue_field_at(queue, existing, 2, &existing_version)
                    return false if not bytes_equal(existing_path, child_root) or not bytes_equal(existing_version, child_version)
                    in_string <- false
                    continue
                return false if total >= 4096.usize()
                queue_append_record(queue, &child_root, child_name, child_version)
                parents.push(parent)
                total <- total + 1.usize()
            in_string <- false
    return true

def canonical_transitive_local_lock(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    out: mutable darray[u8] = []
    root_digest_bytes: mutable darray[u8] = []
    root_digest: mutable darray[u8] = []
    return [] if Integrity::sha256(raw, &root_digest_bytes) != Integrity::DigestCode.Ok
    return [] if not Integrity::hex_digest(root_digest_bytes, &root_digest)
    root_entry: mutable darray[u8] = []
    return [] if not first_target_entry(raw, &root_entry)
    root_entry_c: mutable darray[u8] = []
    path_with_nul_into(&root_entry, &root_entry_c)
    root_entry_name: cstr = (&root_entry_c[0]).cast[cstr] can Unsafe.PointerCast
    root_source_path: mutable darray[u8] = []
    path_join_into(root, root_entry_name, &root_source_path)
    root_source: mutable darray[u8] = []
    return [] if not read_package_file_into(&root_source_path, &root_source)
    root_source_digest_bytes: mutable darray[u8] = []
    root_source_digest: mutable darray[u8] = []
    return [] if Integrity::sha256(root_source, &root_source_digest_bytes) != Integrity::DigestCode.Ok
    return [] if not Integrity::hex_digest(root_source_digest_bytes, &root_source_digest)
    bytes_push_view(&out, "{\n  \"lock-version\": 2,\n  \"resolver\": \"elisapkg-v2\",\n  \"package\": {\n    \"name\": \"")
    bytes_push_array(&out, name)
    bytes_push_view(&out, "\",\n    \"version\": \"")
    bytes_push_array(&out, version)
    bytes_push_view(&out, "\",\n    \"manifest-digest\": \"sha256:")
    bytes_push_array(&out, root_digest)
    bytes_push_view(&out, "\",\n    \"source-digest\": \"sha256:")
    bytes_push_array(&out, root_source_digest)
    bytes_push_view(&out, "\"\n  },\n  \"packages\": [")
    queue: mutable darray[u8] = []
    parents: mutable darray[usize] = []
    total: mutable usize = 0.usize()
    return [] if not append_local_dependency_records(raw, root, &queue, &parents, &total, 18446744073709551615.usize())
    if total == 0.usize():
        bytes_push_view(&out, "]\n}\n")
        return out
    processed: mutable usize = 0.usize()
    while processed < total |queue, processed, total, root|:
        package_root: mutable darray[u8] = []
        return [] if not queue_field_at(queue, processed, 0, &package_root)
        manifest_path: mutable darray[u8] = []
        path_join_into(&package_root, "elisapkg.json", &manifest_path)
        child_raw: mutable darray[u8] = []
        return [] if not read_package_file_into(&manifest_path, &child_raw)
        child_name: mutable darray[u8] = []
        child_version: mutable darray[u8] = []
        return [] if not validate_manifest_at(child_raw, &package_root, &child_name, &child_version)
        return [] if bytes_equal(child_name, name)
        queued_name: mutable darray[u8] = []
        queued_version: mutable darray[u8] = []
        return [] if not queue_field_at(queue, processed, 1, &queued_name) or not queue_field_at(queue, processed, 2, &queued_version)
        return [] if not bytes_equal(queued_name, child_name) or not bytes_equal(queued_version, child_version)
        return [] if not append_local_dependency_records(child_raw, &package_root, &queue, &parents, &total, processed)
        processed <- processed + 1.usize()
    emitted: mutable darray[u8] = []
    first: mutable bool = true
    for _step in 0..<total |queue, emitted, out, first|:
        found: mutable bool = false
        selected: mutable usize = total
        selected_name: mutable darray[u8] = []
        for candidate in 0..<total |queue, emitted, found, selected, selected_name|:
            candidate_name: mutable darray[u8] = []
            continue if not queue_field_at(queue, candidate, 1, &candidate_name)
            continue if emitted_contains_slice(emitted, candidate_name, 0, candidate_name.count)
            if not found or bytes_less(candidate_name, selected_name):
                selected <- candidate
                selected_name.resize(0)
                for index in 0..<candidate_name.count |selected_name, candidate_name|:
                    selected_name.push(candidate_name[index])
                found <- true
        break if not found
        selected_path: mutable darray[u8] = []
        selected_version: mutable darray[u8] = []
        return [] if not queue_field_at(queue, selected, 0, &selected_path) or not queue_field_at(queue, selected, 2, &selected_version)
        selected_manifest_path: mutable darray[u8] = []
        path_join_into(&selected_path, "elisapkg.json", &selected_manifest_path)
        selected_manifest: mutable darray[u8] = []
        return [] if not read_package_file_into(&selected_manifest_path, &selected_manifest)
        selected_entry: mutable darray[u8] = []
        return [] if not first_target_entry(selected_manifest, &selected_entry)
        selected_entry_c: mutable darray[u8] = []
        path_with_nul_into(&selected_entry, &selected_entry_c)
        selected_entry_name: cstr = (&selected_entry_c[0]).cast[cstr] can Unsafe.PointerCast
        selected_source_path: mutable darray[u8] = []
        path_join_into(selected_path, selected_entry_name, &selected_source_path)
        selected_source: mutable darray[u8] = []
        return [] if not read_package_file_into(&selected_source_path, &selected_source)
        selected_source_digest_bytes: mutable darray[u8] = []
        selected_source_digest: mutable darray[u8] = []
        return [] if Integrity::sha256(selected_source, &selected_source_digest_bytes) != Integrity::DigestCode.Ok
        return [] if not Integrity::hex_digest(selected_source_digest_bytes, &selected_source_digest)
        selected_digest: mutable darray[u8] = []
        selected_digest_bytes: mutable darray[u8] = []
        return [] if Integrity::sha256(selected_manifest, &selected_digest_bytes) != Integrity::DigestCode.Ok
        return [] if not Integrity::hex_digest(selected_digest_bytes, &selected_digest)
        out.push(44) if not first
        bytes_push_view(&out, "\n    {\"name\":\"")
        bytes_push_array(&out, selected_name)
        bytes_push_view(&out, "\",\"version\":\"")
        bytes_push_array(&out, selected_version)
        bytes_push_view(&out, "\",\"source\":{\"type\":\"path\",\"path\":\"")
        bytes_push_array(&out, selected_path)
        bytes_push_view(&out, "\"},\"manifest-digest\":\"sha256:")
        bytes_push_array(&out, selected_digest)
        bytes_push_view(&out, "\",\"source-digest\":\"sha256:")
        bytes_push_array(&out, selected_source_digest)
        bytes_push_view(&out, "\"}")
        for index in 0..<selected_name.count |emitted, selected_name|:
            emitted.push(selected_name[index])
        emitted.push(0)
        first <- false
    bytes_push_view(&out, "\n  ]\n}\n")
    return out

def collect_registry_roots(raw: darray[u8]&, out: mutable darray[Solver::Constraint]&, has_local: mutable bool&) -> bool can[Memory.Allocate, Abort.Panic]:
    out.resize(0)
    has_local <- false
    dependency_start: usize = json_key_value_offset(raw, "dependencies")
    return true if dependency_start >= raw.count
    dependency_end: usize = json_object_end(raw, dependency_start)
    return false if dependency_end <= dependency_start or raw[dependency_start] != 123
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0
    braces: mutable i64 = 1
    brackets: mutable i64 = 0
    for index in (dependency_start + 1)..<dependency_end |raw, out, has_local, in_string, escaped, string_start, braces, brackets|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1
            elif byte == 123:
                braces <- braces + 1
            elif byte == 125:
                braces <- braces - 1
            elif byte == 91:
                brackets <- brackets + 1
            elif byte == 93:
                brackets <- brackets - 1
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1
            while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1
            if braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58:
                alias: mutable darray[u8] = []
                for item in string_start..<index |raw, alias|:
                    alias.push(raw[item])
                after <- after + 1
                while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                    after <- after + 1
                value_end: usize = json_object_end(raw, after)
                return false if after >= dependency_end or value_end <= after or raw[after] != 123 or value_end > dependency_end
                path_key: mutable darray[u8] = [112, 97, 116, 104]
                if object_has_direct_key(raw, after, value_end, path_key):
                    has_local <- true
                else:
                    registry: mutable darray[u8] = []
                    requirement: mutable darray[u8] = []
                    return false if not object_string_value(raw, after, value_end, "registry", &registry) or not object_string_value(raw, after, value_end, "version", &requirement)
                    return false if not bytes_equal_view(registry, "primary")
                    out.push(Solver::Constraint{package: alias, requirement: requirement})
            in_string <- false
    return true

def registry_queue_append(queue: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    for index in 0..<value.count |queue, value|:
        queue.push(value[index])
    queue.push(0)

def registry_queue_contains(queue: darray[u8]&, wanted: darray[u8]&) -> bool:
    cursor: mutable usize = 0
    while cursor < queue.count:
        finish: mutable usize = cursor
        while finish < queue.count and queue[finish] != 0 |queue, finish|:
            finish <- finish + 1
        return true if finish - cursor == wanted.count and bytes_equal_range(queue, cursor, finish, wanted)
        cursor <- finish + 1
    return false

def registry_queue_field_at(queue: darray[u8]&, record: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    cursor: mutable usize = 0
    current: mutable usize = 0
    while cursor < queue.count |queue, cursor, current, out|:
        finish: mutable usize = cursor
        while finish < queue.count and queue[finish] != 0 |queue, finish|:
            finish <- finish + 1
        if current == record:
            out.resize(0)
            for index in cursor..<finish |queue, out|:
                out.push(queue[index])
            return true
        cursor <- finish + 1
        current <- current + 1
    return false

def registry_append_decimal(out: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
    digits: mutable darray[u8] = []
    number: mutable u64 = value
    if number == 0:
        out.push(48)
        return
    while number > 0 |digits, number|:
        digits.push(48 + (number % 10).u8())
        number <- number / 10
    index: mutable usize = digits.count
    while index > 0 |out, digits, index|:
        index <- index - 1
        out.push(digits[index])

def registry_exact_requirement(version: Model::Version, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    out.resize(0)
    registry_append_decimal(out, version.major)
    out.push(46)
    registry_append_decimal(out, version.minor)
    out.push(46)
    registry_append_decimal(out, version.patch)

def registry_security_status(code: Registry::ResultCode) -> bool:
    return code == Registry::ResultCode.MalformedMetadata or code == Registry::ResultCode.MissingSignature or code == Registry::ResultCode.MissingTrustRoot or code == Registry::ResultCode.InvalidSignature or code == Registry::ResultCode.ExpiredMetadata or code == Registry::ResultCode.RollbackDetected or code == Registry::ResultCode.DigestMismatch or code == Registry::ResultCode.ResourceLimit or code == Registry::ResultCode.TrustStateUnavailable or code == Registry::ResultCode.TrustStateMalformed

def registry_candidate_matches(candidates: darray[Solver::Candidate]&, package: darray[u8]&, version: Model::Version) -> bool:
    for index in 0..<candidates.count |candidates, package, version|:
        return true if bytes_equal(candidates[index].package, package) and SemVer::compare(candidates[index].version, version) == 0
    return false

def registry_constraint_present(constraints: darray[Solver::Constraint]&, package: darray[u8]&) -> bool:
    for index in 0..<constraints.count |constraints, package|:
        return true if bytes_equal(constraints[index].package, package)
    return false

def append_registry_lock_preferences(lock: darray[u8]&, unlock: darray[u8]&, candidates: darray[Solver::Candidate]&, constraints: mutable darray[Solver::Constraint]&) -> void can[Memory.Allocate, Abort.Panic]:
    return if lock.count == 0.usize() or not Json::valid_document(lock) or not Json::unique_object_keys(lock) or not lock_version_is(lock, 3)
    for index in 0..<lock.count |lock, unlock, candidates, constraints|:
        continue if lock[index] != 123
        object_end: usize = json_object_end(lock, index)
        continue if object_end <= index
        package: mutable darray[u8] = []
        version_text: mutable darray[u8] = []
        continue if not object_string_value(lock, index, object_end, "name", &package) or not object_string_value(lock, index, object_end, "version", &version_text)
        continue if unlock.count > 0.usize() and bytes_equal(package, unlock)
        parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
        continue if not SemVer::parse(version_text, &parsed) or parsed.prerelease
        continue if not registry_candidate_matches(candidates, package, parsed) or registry_constraint_present(constraints, package)
        exact: mutable darray[u8] = []
        registry_exact_requirement(parsed, &exact)
        constraints.push(Solver::Constraint{package: package, requirement: exact})

def canonical_registry_lock(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&, roots: darray[Solver::Constraint]&, preferred_lock: darray[u8]&, unlock: darray[u8]&, persist_trust: bool) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    out: mutable darray[u8] = []
    root_digest_bytes: mutable darray[u8] = []
    root_digest: mutable darray[u8] = []
    return [] if Integrity::sha256(raw, &root_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(root_digest_bytes, &root_digest)
    root_entry: mutable darray[u8] = []
    return [] if not first_target_entry(raw, &root_entry)
    root_entry_path: mutable darray[u8] = []
    path_join_into(root, "", &root_entry_path)
    for index in 0..<root_entry.count |root_entry_path, root_entry|:
        root_entry_path.push(root_entry[index])
    root_source: mutable darray[u8] = []
    return [] if not read_package_file_into(&root_entry_path, &root_source)
    root_source_digest_bytes: mutable darray[u8] = []
    root_source_digest: mutable darray[u8] = []
    return [] if Integrity::sha256(root_source, &root_source_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(root_source_digest_bytes, &root_source_digest)

    candidates: mutable darray[Solver::Candidate] = []
    package_queue: mutable darray[u8] = []
    package_total: mutable usize = 0
    for index in 0..<roots.count |roots, package_queue, package_total|:
        return [] if registry_queue_contains(package_queue, roots[index].package)
        registry_queue_append(&package_queue, roots[index].package)
        package_total <- package_total + 1
    processed: mutable usize = 0
    while processed < package_total:
        package: mutable darray[u8] = []
        return [] if not registry_queue_field_at(package_queue, processed, &package)
        index_data: mutable darray[u8] = []
        index_status: Registry::ResultCode = Registry::read_index(package, &index_data)
        if index_status != Registry::ResultCode.Ok and persist_trust and registry_security_status(index_status):
            out.push(index_status.u8() + 1.u8())
            return out
        return [] if index_status != Registry::ResultCode.Ok
        cursor: mutable usize = 0
        while cursor < index_data.count:
            finish: mutable usize = cursor
            while finish < index_data.count and index_data[finish] != 10 |index_data, finish|:
                finish <- finish + 1
            line_end: mutable usize = finish
            line_end <- line_end - 1 if line_end > cursor and index_data[line_end - 1] == 13
            return [] if line_end == cursor or line_end - cursor > 128
            version_text: mutable darray[u8] = []
            for item in cursor..<line_end |index_data, version_text|:
                version_text.push(index_data[item])
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return [] if not SemVer::parse(version_text, &parsed)
            selected_text: mutable darray[u8] = []
            archive: mutable darray[u8] = []
            digest: mutable darray[u8] = []
            metadata: mutable darray[u8] = []
            archive_size: mutable u64 = 0
            exact: mutable darray[u8] = []
            registry_exact_requirement(parsed, &exact)
            candidate_status: Registry::ResultCode = Registry::resolve(package, exact, Model::Version{major:0,minor:0,patch:0,prerelease:false}, &selected_text, &archive, &digest, &archive_size, &metadata)
            if candidate_status != Registry::ResultCode.Ok and persist_trust and registry_security_status(candidate_status):
                out.push(candidate_status.u8() + 1.u8())
                return out
            return [] if candidate_status != Registry::ResultCode.Ok
            dependencies: mutable darray[Solver::Constraint] = []
            dependencies_valid: bool = Registry::read_dependencies(metadata, &dependencies)
            if not dependencies_valid and persist_trust:
                out.push(Registry::ResultCode.MalformedMetadata.u8() + 1.u8())
                return out
            return [] if not dependencies_valid
            candidate_package: mutable darray[u8] = []
            for item in 0..<package.count |candidate_package, package|:
                candidate_package.push(package[item])
            for dependency_index in 0..<dependencies.count |dependencies, package_queue, package_total|:
                if not registry_queue_contains(package_queue, dependencies[dependency_index].package):
                    registry_queue_append(&package_queue, dependencies[dependency_index].package)
                    package_total <- package_total + 1
            candidate: Solver::Candidate = Solver::Candidate{package: candidate_package, version: parsed, dependencies: dependencies, yanked: false}
            candidates.push(candidate)
            return [] if candidates.count > 4096
            cursor <- finish + 1
        processed <- processed + 1
        return [] if processed > 4096

    selected_indexes: mutable darray[usize] = []
    solve_constraints: mutable darray[Solver::Constraint] = []
    for index in 0..<roots.count |roots, solve_constraints|:
        solve_constraints.push(roots[index])
    append_registry_lock_preferences(preferred_lock, unlock, candidates, &solve_constraints)
    solve_status: mutable Solver::SolveCode = Solver::solve(candidates, solve_constraints, &selected_indexes)
    # A stale locked choice must not make an otherwise solvable graph appear
    # unsatisfiable. Retry without preferences when a pinned candidate no
    # longer satisfies the current manifest or its transitive metadata.
    if solve_status == Solver::SolveCode.Unsatisfiable and solve_constraints.count > roots.count:
        selected_indexes.resize(0)
        solve_status <- Solver::solve(candidates, roots, &selected_indexes)
    return [] if solve_status != Solver::SolveCode.Solved
    bytes_push_view(&out, "{\n  \"lock-version\": 3,\n  \"resolver\": \"elisapkg-registry-v1\",\n  \"package\": {\n    \"name\": \"")
    bytes_push_array(&out, name)
    bytes_push_view(&out, "\",\n    \"version\": \"")
    bytes_push_array(&out, version)
    bytes_push_view(&out, "\",\n    \"manifest-digest\": \"sha256:")
    bytes_push_array(&out, root_digest)
    bytes_push_view(&out, "\",\n    \"source-digest\": \"sha256:")
    bytes_push_array(&out, root_source_digest)
    bytes_push_view(&out, "\"\n  },\n  \"packages\": [")
    emitted: mutable darray[u8] = []
    first: mutable bool = true
    for _step in 0..<selected_indexes.count |selected_indexes, candidates, emitted, out, first|:
        found: mutable bool = false
        selected_slot: mutable usize = selected_indexes.count
        selected_name: mutable darray[u8] = []
        for item in 0..<selected_indexes.count |selected_indexes, candidates, emitted, found, selected_slot, selected_name|:
            candidate_index: usize = selected_indexes[item]
            candidate_name: darray[u8] = candidates[candidate_index].package
            continue if emitted_contains_slice(emitted, candidate_name, 0, candidate_name.count)
            if not found or bytes_less(candidate_name, selected_name):
                selected_slot <- item
                selected_name.resize(0)
                for byte_index in 0..<candidate_name.count |selected_name, candidate_name|:
                    selected_name.push(candidate_name[byte_index])
                found <- true
        return [] if not found
        candidate_index: usize = selected_indexes[selected_slot]
        candidate: Solver::Candidate = candidates[candidate_index]
        exact: mutable darray[u8] = []
        registry_exact_requirement(candidate.version, &exact)
        selected_text: mutable darray[u8] = []
        archive: mutable darray[u8] = []
        digest: mutable darray[u8] = []
        metadata: mutable darray[u8] = []
        archive_size: mutable u64 = 0
        final_status: Registry::ResultCode = Registry::resolve(candidate.package, exact, Model::Version{major:0,minor:0,patch:0,prerelease:false}, &selected_text, &archive, &digest, &archive_size, &metadata)
        if final_status != Registry::ResultCode.Ok and persist_trust and registry_security_status(final_status):
            out.push(final_status.u8() + 1.u8())
            return out
        return [] if final_status != Registry::ResultCode.Ok
        if persist_trust:
            trust_status: Registry::ResultCode = Registry::record_trusted(candidate.package, selected_text, digest)
            if trust_status != Registry::ResultCode.Ok:
                out.push(trust_status.u8() + 1.u8())
                return out
        metadata_digest_bytes: mutable darray[u8] = []
        metadata_digest: mutable darray[u8] = []
        return [] if Integrity::sha256(metadata, &metadata_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(metadata_digest_bytes, &metadata_digest)
        out.push(44) if not first
        bytes_push_view(&out, "\n    {\"name\":\"")
        bytes_push_array(&out, selected_name)
        bytes_push_view(&out, "\",\"version\":\"")
        bytes_push_array(&out, selected_text)
        bytes_push_view(&out, "\",\"source\":{\"type\":\"registry\",\"registry\":\"primary\",\"archive\":\"")
        bytes_push_array(&out, archive)
        bytes_push_view(&out, "\"},\"archive-size\":")
        registry_append_decimal(&out, archive_size)
        bytes_push_view(&out, ",\"archive-digest\":\"sha256:")
        bytes_push_array(&out, digest)
        bytes_push_view(&out, "\",\"metadata-digest\":\"sha256:")
        bytes_push_array(&out, metadata_digest)
        bytes_push_view(&out, "\"}")
        for byte_index in 0..<selected_name.count |emitted, selected_name|:
            emitted.push(selected_name[byte_index])
        emitted.push(0)
        first <- false
    bytes_push_view(&out, "\n  ]\n}\n")
    return out

def canonical_lock_for_manifest(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    registry_roots: mutable darray[Solver::Constraint] = []
    has_local_dependency: mutable bool = false
    return [] if not collect_registry_roots(raw, &registry_roots, &has_local_dependency)
    if registry_roots.count > 0.usize():
        return [] if has_local_dependency
        empty_lock: mutable darray[u8] = []
        empty_unlock: mutable darray[u8] = []
        return canonical_registry_lock(name, version, raw, root, registry_roots, empty_lock, empty_unlock, false)
    return canonical_transitive_local_lock(name, version, raw, root)

def canonical_lock_for_manifest_with_options(name: darray[u8]&, version: darray[u8]&, raw: darray[u8]&, root: darray[u8]&, options: Model::CommandOptions, preferred_lock: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    registry_roots: mutable darray[Solver::Constraint] = []
    has_local_dependency: mutable bool = false
    return [] if not collect_registry_roots(raw, &registry_roots, &has_local_dependency)
    if registry_roots.count > 0.usize():
        return [] if has_local_dependency
        unlock: mutable darray[u8] = []
        if Platform::pkg_strlen(options.update_name) > 0.usize():
            bytes_push_cstr(&unlock, options.update_name)
        return canonical_registry_lock(name, version, raw, root, registry_roots, preferred_lock, unlock, true)
    return canonical_transitive_local_lock(name, version, raw, root)

def bytes_push_array(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    for index in 0..<value.count |out, value|:
        out.push(value[index])

def valid_dependency_path(path: darray[u8]&) -> bool:
    return false if path.count == 0.usize() or path.count > 4096.usize()
    return false if path[0] == 47 or path[0] == 92
    for index in 0..<path.count |path|:
        byte: u8 = path[index]
        return false if byte == 0 or byte < 32 or byte == 127 or byte == 34 or byte == 92
    return false if bytes_count(path, "//") > 0.usize()
    return true

def normalize_relative_path(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    out.resize(0)
    segment_start: mutable usize = 0.usize()
    index: mutable usize = 0.usize()
    while index <= path.count |path, out, segment_start, index|:
        at_end: bool = index == path.count
        if at_end or path[index] == 47:
            segment_length: usize = index - segment_start
            if segment_length > 0.usize() and not (segment_length == 1.usize() and path[segment_start] == 46):
                is_parent: bool = segment_length == 2.usize() and path[segment_start] == 46 and path[segment_start + 1.usize()] == 46
                if is_parent:
                    if out.count > 0.usize():
                        last: mutable usize = out.count
                        while last > 0.usize() and out[last - 1.usize()] != 47 |out, last|:
                            last <- last - 1.usize()
                        previous_parent: bool = out.count - last == 2.usize() and out[last] == 46 and out[last + 1.usize()] == 46
                        if previous_parent:
                            out.push(47)
                            out.push(46)
                            out.push(46)
                        else:
                            out.resize(last)
                    else:
                        out.push(46)
                        out.push(46)
                else:
                    if out.count > 0.usize():
                        out.push(47)
                    for part in segment_start..<index |path, out|:
                        out.push(path[part])
            segment_start <- index + 1.usize()
        index <- index + 1.usize()
    return out.count > 0.usize()

def object_has_direct_key(raw: darray[u8]&, object_start: usize, object_end: usize, wanted: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if object_start >= object_end or raw[object_start] != 123
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    braces: mutable i64 = 1
    brackets: mutable i64 = 0
    for index in (object_start + 1.usize())..<object_end |raw, in_string, escaped, string_start, braces, brackets|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
            elif byte == 123:
                braces <- braces + 1
            elif byte == 125:
                braces <- braces - 1
            elif byte == 91:
                brackets <- brackets + 1
            elif byte == 93:
                brackets <- brackets - 1
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < object_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            if braces == 1 and brackets == 0 and after < object_end and raw[after] == 58 and index - string_start == wanted.count:
                matched: mutable bool = true
                for key_index in 0..<wanted.count |raw, wanted, string_start, matched|:
                    matched <- false if raw[string_start + key_index] != wanted[key_index]
                return true if matched
            in_string <- false
    return false

def dependency_alias_seen(seen: darray[u8]&, alias: darray[u8]&) -> bool:
    cursor: mutable usize = 0.usize()
    while cursor < seen.count:
        segment_end: mutable usize = cursor
        while segment_end < seen.count and seen[segment_end] != 0:
            segment_end <- segment_end + 1.usize()
        return true if segment_end - cursor == alias.count and bytes_equal_range(seen, cursor, segment_end, alias)
        cursor <- segment_end + 1.usize()
    return false

def bytes_equal_range(raw: darray[u8]&, start: usize, end: usize, wanted: darray[u8]&) -> bool:
    return false if end - start != wanted.count
    for index in 0..<wanted.count |raw, wanted|:
        return false if raw[start + index] != wanted[index]
    return true

def valid_dependency_object(raw: darray[u8]&, object_start: usize, object_end: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    path_key: mutable darray[u8] = [112, 97, 116, 104]
    registry_key: mutable darray[u8] = [114, 101, 103, 105, 115, 116, 114, 121]
    version_key: mutable darray[u8] = [118, 101, 114, 115, 105, 111, 110]
    git_key: mutable darray[u8] = [103, 105, 116]
    rev_key: mutable darray[u8] = [114, 101, 118]
    has_path: bool = object_has_direct_key(raw, object_start, object_end, path_key)
    has_registry: bool = object_has_direct_key(raw, object_start, object_end, registry_key)
    has_version: bool = object_has_direct_key(raw, object_start, object_end, version_key)
    has_git: bool = object_has_direct_key(raw, object_start, object_end, git_key)
    has_rev: bool = object_has_direct_key(raw, object_start, object_end, rev_key)
    return false if has_path and (has_registry or has_version)
    if has_path:
        return false if not valid_direct_field_set(raw, object_start, object_end, 7)
        path: mutable darray[u8] = []
        return false if not object_string_value(raw, object_start, object_end, "path", &path)
        return valid_dependency_path(path)
    if has_registry or has_version:
        return false if has_git or has_rev or not has_registry or not has_version
        return false if not valid_direct_field_set(raw, object_start, object_end, 8)
        registry: mutable darray[u8] = []
        requirement: mutable darray[u8] = []
        return false if not object_string_value(raw, object_start, object_end, "registry", &registry) or not object_string_value(raw, object_start, object_end, "version", &requirement)
        return false if not bytes_equal_view(registry, "primary")
        parsed_requirement: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
        return SemVer::parse_requirement(requirement, &parsed_requirement)
    return false

def valid_optional_package_strings(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    package_start: usize = json_key_value_offset(raw, "package")
    package_end: usize = json_object_end(raw, package_start)
    return false if package_start >= raw.count or package_end <= package_start
    return false if not valid_direct_field_set(raw, package_start, package_end, 1)
    description_key: mutable darray[u8] = [100, 101, 115, 99, 114, 105, 112, 116, 105, 111, 110]
    license_key: mutable darray[u8] = [108, 105, 99, 101, 110, 115, 101]
    elisa_key: mutable darray[u8] = [101, 108, 105, 115, 97]
    description_value: mutable darray[u8] = []
    return false if object_has_direct_key(raw, package_start, package_end, description_key) and not object_string_value(raw, package_start, package_end, "description", &description_value)
    license_value: mutable darray[u8] = []
    return false if object_has_direct_key(raw, package_start, package_end, license_key) and not object_string_value(raw, package_start, package_end, "license", &license_value)
    elisa_value: mutable darray[u8] = []
    return false if object_has_direct_key(raw, package_start, package_end, elisa_key) and not object_string_value(raw, package_start, package_end, "elisa", &elisa_value)
    return true

def valid_include_array(raw: darray[u8]&) -> bool:
    include_start: usize = json_key_value_offset(raw, "include")
    return true if include_start >= raw.count
    return false if raw[include_start] != 91
    include_end: usize = json_array_end(raw, include_start)
    return false if include_end <= include_start
    cursor: mutable usize = include_start + 1.usize()
    while cursor < include_end:
        while cursor < include_end and (raw[cursor] == 32 or raw[cursor] == 9 or raw[cursor] == 10 or raw[cursor] == 13) |raw, cursor|:
            cursor <- cursor + 1.usize()
        return true if cursor == include_end
        return false if raw[cursor] != 34
        cursor <- cursor + 1.usize()
        while cursor < include_end and raw[cursor] != 34 |raw, cursor|:
            return false if raw[cursor] == 92 or raw[cursor] < 32 or raw[cursor] == 127
            cursor <- cursor + 1.usize()
        return false if cursor >= include_end
        cursor <- cursor + 1.usize()
        while cursor < include_end and (raw[cursor] == 32 or raw[cursor] == 9 or raw[cursor] == 10 or raw[cursor] == 13) |raw, cursor|:
            cursor <- cursor + 1.usize()
        return true if cursor == include_end
        return false if raw[cursor] != 44
        cursor <- cursor + 1.usize()
    return false

def valid_dependency_map(raw: darray[u8]&, wanted: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
    dependency_start: usize = json_key_value_offset(raw, wanted)
    return true if dependency_start >= raw.count
    dependency_end: usize = json_object_end(raw, dependency_start)
    return false if dependency_end <= dependency_start or raw[dependency_start] != 123
    seen: mutable darray[u8] = []
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    braces: mutable i64 = 1
    brackets: mutable i64 = 0
    for index in (dependency_start + 1.usize())..<dependency_end |raw, seen, in_string, escaped, string_start, braces, brackets|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
            elif byte == 123:
                braces <- braces + 1
            elif byte == 125:
                braces <- braces - 1
            elif byte == 91:
                brackets <- brackets + 1
            elif byte == 93:
                brackets <- brackets - 1
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            direct_key: bool = braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58
            if direct_key:
                alias: mutable darray[u8] = []
                for key_index in string_start..<index |alias, raw|:
                    alias.push(raw[key_index])
                return false if not valid_package_name(alias) or dependency_alias_seen(seen, alias)
                seen.push(0) if seen.count > 0.usize()
                for alias_index in 0..<alias.count |seen, alias|:
                    seen.push(alias[alias_index])
                seen.push(0)
                after <- after + 1.usize()
                while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                    after <- after + 1.usize()
                return false if after >= dependency_end or raw[after] != 123
                value_end: usize = json_object_end(raw, after)
                return false if value_end > dependency_end
                return false if not valid_dependency_object(raw, after, value_end)
            in_string <- false
    return true

def append_local_dependency(raw: darray[u8]&, alias: darray[u8]&, path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    out: mutable darray[u8] = []
    dependency_start: usize = json_key_value_offset(raw, "dependencies")
    dependency_end: usize = json_object_end(raw, dependency_start)
    return [] if dependency_start >= raw.count or dependency_end <= dependency_start
    return [] if object_has_direct_key(raw, dependency_start, dependency_end, alias)
    has_existing: mutable bool = false
    if dependency_end > dependency_start + 1.usize():
        for index in (dependency_start + 1.usize())..<dependency_end |raw, has_existing|:
            byte: u8 = raw[index]
            if byte != 32 and byte != 9 and byte != 10 and byte != 13:
                has_existing <- true
                break
    for index in 0..<dependency_end |out, raw|:
        out.push(raw[index])
    if has_existing:
        out.push(44)
        out.push(32)
    out.push(34)
    for alias_index in 0..<alias.count |out, alias|:
        out.push(alias[alias_index])
    bytes_push_view(&out, "\": {\"path\": \"")
    for path_index in 0..<path.count |out, path|:
        out.push(path[path_index])
    bytes_push_view(&out, "\"}")
    for index in dependency_end..<raw.count |out, raw|:
        out.push(raw[index])
    return out

def append_registry_dependency(raw: darray[u8]&, alias: darray[u8]&, requirement: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    out: mutable darray[u8] = []
    dependency_start: usize = json_key_value_offset(raw, "dependencies")
    dependency_end: usize = json_object_end(raw, dependency_start)
    return [] if dependency_start >= raw.count or dependency_end <= dependency_start
    return [] if object_has_direct_key(raw, dependency_start, dependency_end, alias)
    has_existing: mutable bool = false
    if dependency_end > dependency_start + 1.usize():
        for index in (dependency_start + 1.usize())..<dependency_end |raw, has_existing|:
            byte: u8 = raw[index]
            if byte != 32 and byte != 9 and byte != 10 and byte != 13:
                has_existing <- true
                break
    for index in 0..<dependency_end |out, raw|:
        out.push(raw[index])
    if has_existing:
        out.push(44)
        out.push(32)
    out.push(34)
    for alias_index in 0..<alias.count |out, alias|:
        out.push(alias[alias_index])
    bytes_push_view(&out, "\": {\"registry\": \"primary\", \"version\": \"")
    for requirement_index in 0..<requirement.count |out, requirement|:
        out.push(requirement[requirement_index])
    bytes_push_view(&out, "\"}")
    for index in dependency_end..<raw.count |out, raw|:
        out.push(raw[index])
    return out

def find_dependency_span(raw: darray[u8]&, alias: darray[u8]&, start_out: mutable usize&, end_out: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    dependency_start: usize = json_key_value_offset(raw, "dependencies")
    dependency_end: usize = json_object_end(raw, dependency_start)
    return false if dependency_start >= raw.count or dependency_end <= dependency_start
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    braces: mutable i64 = 1
    brackets: mutable i64 = 0
    for index in (dependency_start + 1.usize())..<dependency_end |raw, in_string, escaped, string_start, braces, brackets, start_out, end_out|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
            elif byte == 123:
                braces <- braces + 1
            elif byte == 125:
                braces <- braces - 1
            elif byte == 91:
                brackets <- brackets + 1
            elif byte == 93:
                brackets <- brackets - 1
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            direct: mutable bool = braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58 and index - string_start == alias.count
            if direct:
                matches: mutable bool = true
                for alias_index in 0..<alias.count |raw, alias, string_start, matches|:
                    matches <- false if raw[string_start + alias_index] != alias[alias_index]
                if matches:
                    after <- after + 1.usize()
                    while after < dependency_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                        after <- after + 1.usize()
                    return false if after >= dependency_end or raw[after] != 123
                    value_end: usize = json_object_end(raw, after)
                    return false if value_end >= dependency_end
                    start_out <- string_start - 1.usize()
                    end_out <- value_end + 1.usize()
                    return true
            in_string <- false
    return false

def remove_local_dependency(raw: darray[u8]&, alias: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    dependency_start: usize = json_key_value_offset(raw, "dependencies")
    dependency_end: usize = json_object_end(raw, dependency_start)
    start: mutable usize = 0.usize()
    end: mutable usize = 0.usize()
    return [] if not find_dependency_span(raw, alias, &start, &end)
    probe: mutable usize = end
    while probe < dependency_end and (raw[probe] == 32 or raw[probe] == 9 or raw[probe] == 10 or raw[probe] == 13) |raw, probe|:
        probe <- probe + 1.usize()
    if probe < dependency_end and raw[probe] == 44:
        end <- probe + 1.usize()
    else:
        probe <- start
        while probe > dependency_start + 1.usize() and (raw[probe - 1.usize()] == 32 or raw[probe - 1.usize()] == 9 or raw[probe - 1.usize()] == 10 or raw[probe - 1.usize()] == 13) |raw, probe|:
            probe <- probe - 1.usize()
        start <- probe - 1.usize() if probe > dependency_start and raw[probe - 1.usize()] == 44
    out: mutable darray[u8] = []
    for index in 0..<start |out, raw|:
        out.push(raw[index])
    for index in end..<raw.count |out, raw|:
        out.push(raw[index])
    return out

# ---------- project discovery and commands -------------------------------------------

def project_manifest_exists() -> bool:
    current: bool = cstr_file_exists("elisapkg.json")
    legacy: bool = cstr_file_exists("manifest.json")
    # Two manifests would create an ambiguous authority boundary. Refuse both
    # rather than silently preferring one based on filename order.
    return false if legacy
    return current

def usage() -> void can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    write_ok("elisapkg — Elisa Packaging System\n\nUsage: elisapkg <command> [options]\n\nCommands:\n  init [PATH] [--bin|--lib]    create a package\n  check-manifest              validate elisapkg.json\n  add NAME --path PATH        add a verified local path dependency\n  add NAME --version RANGE --registry primary\n                              add a signed registry dependency\n  remove NAME                 remove a declared dependency\n  update [NAME]               recompute the dependency lock\n  resolve [--locked|--offline]\n                              validate and write elisapkg.lock\n  tree                        show the resolved package graph\n  metadata --json             print normalized package metadata\n  doctor                      report toolchain and trust capabilities\n  build [--bin NAME|--lib NAME|--test NAME]\n                              compile a selected target\n  run [--bin NAME] -- ARGS    build and run a binary target\n  test [--test NAME]          build and run a selected test target\n  clean                       remove known local build/package outputs\n  fetch [PACKAGE REQUIREMENT] verify locked sources or a signed local registry artifact\n  cache verify                inspect cached verification records\n  cache gc --dry-run          preview unreachable cache entries\n  package [--list]            create or preview the deterministic archive\n  install --local             install the current built binary into the user prefix\n  uninstall --local NAME      remove a receipt-owned local binary\n\nModes: --locked  --offline  --frozen  --json  --verbose\n")
    write_ok("  why NAME                    show the root edge for a locked package\n")
    write_ok("remote publish/install/uninstall are trust-gated; use install --local for a receipt-backed local binary\n")

def current_directory_into(out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    out.resize(0)
    buffer: mutable darray[u8] = []
    buffer.resize(4096)
    raw: void& = (&buffer[0]).cast[void&] can Unsafe.PointerCast
    _ = Platform::pkg_getcwd(raw, 4096)
    for index in 0..<buffer.count |out, buffer|:
        break if buffer[index] == 0
        out.push(buffer[index])

def change_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    path_c: mutable darray[u8] = []
    path_with_nul_into(path, &path_c)
    path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    return Platform::pkg_chdir(path_name) == 0

def change_to_manifest_path(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return true if change_directory(path)
    last_separator: mutable usize = path.count
    for index in 0..<path.count |path, last_separator|:
        last_separator <- index if path[index] == 47
    parent: mutable darray[u8] = []
    if last_separator == path.count:
        parent.push(46)
    elif last_separator == 0.usize():
        parent.push(47)
    else:
        for index in 0..<last_separator |parent, path|:
            parent.push(path[index])
    return change_directory(&parent)

def run_init(argc: i64, slots: mutable cstr&&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    root: mutable darray[u8] = [46]
    target_kind: mutable cstr = "bin"
    target_kind_seen: mutable bool = false
    path_seen: mutable bool = false
    for index in 2..<argc |slots, root, target_kind, target_kind_seen, path_seen|:
        argument: cstr = slots[index].cast[cstr]
        if cstr_equal(argument, "--lib"):
            return EXIT_USAGE if target_kind_seen and not cstr_equal(target_kind, "lib")
            target_kind <- "lib"
            target_kind_seen <- true
        elif cstr_equal(argument, "--bin"):
            return EXIT_USAGE if target_kind_seen and not cstr_equal(target_kind, "bin")
            target_kind <- "bin"
            target_kind_seen <- true
        elif cstr_equal(argument, "--help"):
            usage()
            return EXIT_OK
        elif Platform::pkg_strlen(argument) == 0.usize() or argument[0].u8() == 45 or path_seen:
            return EXIT_USAGE
        else:
            root <- []
            bytes_push_cstr(&root, argument)
            path_seen <- true
    return EXIT_USAGE if root.count == 0.usize()
    return EXIT_USAGE if root.count > 4096.usize()
    manifest_path: mutable darray[u8] = []
    path_join_into(root, "elisapkg.json", &manifest_path)
    return EXIT_USAGE if file_exists(&manifest_path)
    return EXIT_SOURCE if not make_directory(&root)
    source: mutable darray[u8] = []
    state: mutable darray[u8] = []
    path_join_into(root, "src", &source)
    path_join_into(root, ".elisapkg", &state)
    return EXIT_SOURCE if not make_directory(&source) or not make_directory(&state)
    manifest: mutable darray[u8] = []
    bytes_push_view(&manifest, "{\n  \"schema-version\": 1,\n  \"package\": {\n    \"name\": \"app\",\n    \"version\": \"0.1.0\",\n    \"description\": \"An Elisa application\",\n    \"license\": \"MIT\",\n    \"elisa\": \">=0.1.0 <1.0.0\"\n  },\n  \"targets\": [{\"name\": \"app\", \"kind\": \"")
    bytes_push_cstr(&manifest, target_kind)
    bytes_push_view(&manifest, "\", \"entry\": \"src/main.elisa\"}],\n  \"dependencies\": {},\n  \"dev-dependencies\": {},\n  \"include\": [\"src/**\", \"elisapkg.json\", \"LICENSE\", \"README.md\"]\n}\n")
    entry: mutable darray[u8] = []
    bytes_push_view(&entry, "def main() -> i64:\n    return 0\n")
    entry_path: mutable darray[u8] = []
    path_join_into(source, "main.elisa", &entry_path)
    return EXIT_USAGE if file_exists(&entry_path)
    return EXIT_SOURCE if not write_file(&manifest_path, &manifest)
    if not write_file(&entry_path, &entry):
        _ = remove_known_file(&manifest_path)
        return EXIT_SOURCE
    write_ok("created package\n")
    return EXIT_OK

def run_add(argc: i64, slots: mutable cstr&&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return EXIT_SECURITY if not transaction_recover()
    local_form: bool = argc == 5 and cstr_equal(slots[3].cast[cstr], "--path")
    registry_form: bool = argc == 7 and cstr_equal(slots[3].cast[cstr], "--version") and cstr_equal(slots[5].cast[cstr], "--registry") and cstr_equal(slots[6].cast[cstr], "primary")
    return EXIT_USAGE if not local_form and not registry_form
    alias: mutable darray[u8] = []
    bytes_push_cstr(&alias, slots[2].cast[cstr])
    return EXIT_USAGE if not valid_package_name(alias)
    root: mutable darray[u8] = [46]
    root_name: mutable darray[u8] = []
    root_version: mutable darray[u8] = []
    return EXIT_USAGE if not load_package_at(&root, &root_name, &root_version)
    dependency_path: mutable darray[u8] = []
    requirement: mutable darray[u8] = []
    if local_form:
        bytes_push_cstr(&dependency_path, slots[4].cast[cstr])
        return EXIT_USAGE if not valid_dependency_path(dependency_path)
        dependency_name: mutable darray[u8] = []
        dependency_version: mutable darray[u8] = []
        return EXIT_RESOLVE if not load_package_at(&dependency_path, &dependency_name, &dependency_version)
        return EXIT_RESOLVE if not bytes_equal(alias, dependency_name) or bytes_equal(alias, root_name)
    else:
        bytes_push_cstr(&requirement, slots[4].cast[cstr])
        parsed_requirement: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
        return EXIT_USAGE if not SemVer::parse_requirement(requirement, &parsed_requirement)
        return EXIT_RESOLVE if bytes_equal(alias, root_name)
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_USAGE if not read_cstr_into("elisapkg.json", &raw)
    return EXIT_USAGE if not validate_manifest_at(raw, &root, &root_name, &root_version)
    updated: darray[u8] = append_local_dependency(raw, alias, dependency_path) if local_form else append_registry_dependency(raw, alias, requirement)
    if updated.count == 0.usize():
        write_error("error: dependency is already declared or the manifest has no dependency object\n")
        return EXIT_RESOLVE
    return EXIT_SECURITY if not transaction_begin(raw)
    if not write_cstr_file("elisapkg.json", &updated) or not transaction_mark_manifest():
        _ = transaction_restore()
        return EXIT_SOURCE
    options: Model::CommandOptions = Model::CommandOptions{locked: false, offline: true, frozen: false, json: false, verbose: false, target_name: "", target_kind: "", update_name: ""}
    resolved: i64 = run_resolve(&root, options)
    if resolved != EXIT_OK:
        restored: bool = transaction_restore()
        if not restored:
            write_error("error: dependency edit failed and the original manifest could not be restored\n")
            return EXIT_SECURITY
        return resolved
    if not transaction_mark_lock():
        _ = transaction_restore()
        return EXIT_SECURITY
    return EXIT_SECURITY if not transaction_commit()
    write_ok("added ")
    write_ok("local " if local_form else "registry ")
    write_ok("dependency ")
    write_bytes(1, &alias)
    if local_form:
        write_ok(" from ")
        write_bytes(1, &dependency_path)
    else:
        write_ok(" with requirement ")
        write_bytes(1, &requirement)
    write_ok("\n")
    return EXIT_OK

def load_package(start: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    exists: bool = project_manifest_exists()
    _ = start
    return false if not exists
    raw: mutable darray[u8] = []
    # One extra byte distinguishes an oversized document from a valid document
    # that happens to end exactly at the policy limit.
    raw.resize(1048577)
    return false if not read_cstr_into("elisapkg.json", &raw)
    return false if raw.count == 0.usize()
    name: mutable darray[u8] = []
    version: mutable darray[u8] = []
    valid: bool = validate_manifest(raw, &name, &version)
    return false if not valid
    return true

def run_check(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    _ = options
    if not load_package(start):
        write_error("error: invalid or missing elisapkg.json (schema-version, package.name, package.version, and targets are required)\n")
        return EXIT_USAGE
    write_ok("manifest valid: ")
    write_ok("elisapkg.json")
    write_ok("\n")
    return EXIT_OK

def print_lock_packages(raw: darray[u8]&) -> bool can[Console.Write, Memory.Allocate, Abort.Panic]:
    found: mutable usize = 0.usize()
    for index in 0..<raw.count |raw, found|:
        continue if raw[index] != 123
        object_end: usize = json_object_end(raw, index)
        continue if object_end <= index
        package_name: mutable darray[u8] = []
        package_version: mutable darray[u8] = []
        if object_string_value(raw, index, object_end, "name", &package_name) and object_string_value(raw, index, object_end, "version", &package_version):
            write_bytes(1, &package_name)
            write_ok(" ")
            write_bytes(1, &package_version)
            write_ok("\n")
            found <- found + 1.usize()
    return found > 0.usize()

def lock_contains_package(raw: darray[u8]&, wanted: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    for index in 0..<raw.count |raw, wanted|:
        continue if raw[index] != 123
        object_end: usize = json_object_end(raw, index)
        continue if object_end <= index
        package_name: mutable darray[u8] = []
        return true if object_string_value(raw, index, object_end, "name", &package_name) and bytes_equal(package_name, wanted)
    return false

def run_why(argc: i64, slots: mutable cstr&&, start: darray[u8]&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return EXIT_USAGE if argc < 3
    wanted: mutable darray[u8] = []
    bytes_push_cstr(&wanted, slots[2].cast[cstr])
    return EXIT_USAGE if not valid_package_name(wanted)
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_RESOLVE if not read_cstr_into("elisapkg.json", &raw)
    root_name: mutable darray[u8] = []
    root_version: mutable darray[u8] = []
    return EXIT_RESOLVE if not validate_manifest_at(raw, start, &root_name, &root_version)
    return EXIT_RESOLVE if not cstr_file_exists("elisapkg.lock")
    lock: mutable darray[u8] = []
    lock.resize(1048577)
    return EXIT_RESOLVE if not read_cstr_into("elisapkg.lock", &lock)
    expected: darray[u8] = canonical_lock_for_manifest(root_name, root_version, raw, start)
    return EXIT_RESOLVE if expected.count == 0.usize() or not bytes_equal(expected, lock)
    return EXIT_RESOLVE if not lock_contains_package(lock, wanted)
    write_bytes(1, &root_name)
    write_ok(" -> ")
    write_bytes(1, &wanted)
    write_ok("\n")
    return EXIT_OK

def run_resolve(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    if not project_manifest_exists():
        write_error("error: could not find elisapkg.json in the current directory\n")
        return EXIT_USAGE
    raw: mutable darray[u8] = []
    # Read up to the manifest policy limit. A smaller buffer would silently
    # validate only a prefix of an attacker-controlled document.
    raw.resize(1048577)
    return EXIT_USAGE if not read_cstr_into("elisapkg.json", &raw)
    name: mutable darray[u8] = []
    version: mutable darray[u8] = []
    return EXIT_USAGE if not validate_manifest(raw, &name, &version)
    preferred_lock: mutable darray[u8] = []
    lock_state: i64 = Platform::pkg_package_file_size("elisapkg.lock")
    if lock_state >= 0:
        preferred_lock.resize(1048577)
        return EXIT_RESOLVE if not read_cstr_into("elisapkg.lock", &preferred_lock)
    elif lock_state != -2:
        # An existing lock that cannot be opened is not equivalent to an
        # absent lock. Refusing to replace it preserves the operator's ability
        # to investigate permissions, corruption, or a hostile filesystem.
        write_error("error: existing elisapkg.lock is unreadable; refusing to replace it\n")
        return EXIT_RESOLVE
    lock: darray[u8] = canonical_lock_for_manifest_with_options(name, version, raw, start, options, preferred_lock)
    if lock.count == 1.usize() and lock[0] > 0 and lock[0] < 32:
        code: mutable Registry::ResultCode = Registry::ResultCode.TrustStateMalformed
        # The sentinel stores the enum value plus one so an empty lock remains
        # reserved for ordinary resolution failure.
        code <- Registry::ResultCode.NotConfigured if lock[0] == 2
        code <- Registry::ResultCode.InvalidConfiguration if lock[0] == 3
        code <- Registry::ResultCode.MissingIndex if lock[0] == 4
        code <- Registry::ResultCode.NoMatchingVersion if lock[0] == 5
        code <- Registry::ResultCode.MalformedMetadata if lock[0] == 6
        code <- Registry::ResultCode.MissingSignature if lock[0] == 7
        code <- Registry::ResultCode.MissingTrustRoot if lock[0] == 8
        code <- Registry::ResultCode.InvalidSignature if lock[0] == 9
        code <- Registry::ResultCode.ExpiredMetadata if lock[0] == 10
        code <- Registry::ResultCode.RollbackDetected if lock[0] == 11
        code <- Registry::ResultCode.DigestMismatch if lock[0] == 12
        code <- Registry::ResultCode.ArchiveMissing if lock[0] == 13
        code <- Registry::ResultCode.ResourceLimit if lock[0] == 14
        code <- Registry::ResultCode.TrustStateUnavailable if lock[0] == 15
        code <- Registry::ResultCode.TrustStateMalformed if lock[0] == 16
        write_error("error: ")
        write_error(Registry::result_message(code))
        write_error(" while recording registry trust state\n")
        return EXIT_SECURITY

    return EXIT_RESOLVE if lock.count == 0.usize()
    if options.locked or options.frozen:
        return EXIT_RESOLVE if not cstr_file_exists("elisapkg.lock")
        existing: mutable darray[u8] = []
        existing.resize(1048577)
        return EXIT_RESOLVE if not read_cstr_into("elisapkg.lock", &existing)
        return EXIT_RESOLVE if not bytes_equal(existing, lock)
    return EXIT_RESOLVE if not (options.locked or options.frozen) and not write_cstr_file("elisapkg.lock", &lock)
    write_ok("resolved ")
    write_bytes(1, &name)
    write_ok(" ")
    write_bytes(1, &version)
    write_ok("\n")
    return EXIT_OK

def run_tree(start: darray[u8]&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    if not project_manifest_exists():
        write_error("error: could not find elisapkg.json in the current directory\n")
        return EXIT_RESOLVE
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_RESOLVE if not read_cstr_into("elisapkg.json", &raw)
    name: mutable darray[u8] = []
    version: mutable darray[u8] = []
    return EXIT_RESOLVE if not validate_manifest(raw, &name, &version)
    return EXIT_RESOLVE if not cstr_file_exists("elisapkg.lock")
    lock: mutable darray[u8] = []
    lock.resize(1048577)
    return EXIT_RESOLVE if not read_cstr_into("elisapkg.lock", &lock)
    expected: darray[u8] = canonical_lock_for_manifest(name, version, raw, start)
    return EXIT_RESOLVE if expected.count == 0.usize() or not bytes_equal(expected, lock)
    return EXIT_RESOLVE if not print_lock_packages(lock)
    return EXIT_OK

def run_metadata(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    if not project_manifest_exists():
        write_error("error: could not find elisapkg.json in the current directory\n")
        return EXIT_USAGE
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_USAGE if not read_cstr_into("elisapkg.json", &raw)
    name: mutable darray[u8] = []
    version: mutable darray[u8] = []
    return EXIT_USAGE if not validate_manifest(raw, &name, &version)
    return EXIT_USAGE if not options.json
    write_ok("{\"schema-version\":1,\"package\":{\"name\":\"")
    write_bytes(1, &name)
    write_ok("\",\"version\":\"")
    write_bytes(1, &version)
    write_ok("\"}}\n")
    return EXIT_OK

def run_doctor() -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    write_ok("elisapkg doctor\n")
    write_ok("manifest: JSON schema v1\n")
    write_ok("resolver: deterministic local v1\n")
    write_ok("source integrity: local file verification\n")
    write_ok("metadata signatures: local Ed25519 provider available; network transport disabled\n")
    write_ok("build sandbox: not enabled; dependency builds are trusted-source execution\n")
    write_ok("child environment: scrubbed; only compiler bootstrap variables are retained\n")
    write_ok("compiler: set ELISAPKG_COMPILER to an audited compiler adapter\n")
    return EXIT_OK

def run_test(argc: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_USAGE if not read_cstr_into("elisapkg.json", &raw)
    selected_name: mutable darray[u8] = []
    selected_kind: mutable darray[u8] = []
    selected_entry: mutable darray[u8] = []
    return EXIT_USAGE if not select_target(raw, options, &selected_name, &selected_kind, &selected_entry) or not bytes_equal_view(selected_kind, "test")
    # Reusing the normal build path keeps dependency, lock, and compiler-
    # environment checks identical while multi-target planning is completed.
    status: i64 = run_build(start, options)
    return status if status != EXIT_OK
    return run_program(argc, slots, options, "test")

def object_sha256_equals(raw: darray[u8]&, object_start: usize, object_end: usize, field: cstr, expected: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    encoded: mutable darray[u8] = []
    return false if not object_string_value(raw, object_start, object_end, field, &encoded)
    return false if encoded.count != 71.usize() or encoded[0] != 115 or encoded[1] != 104 or encoded[2] != 97 or encoded[3] != 50 or encoded[4] != 53 or encoded[5] != 54 or encoded[6] != 58 or expected.count != 64.usize()
    for index in 0..<expected.count |encoded, expected|:
        byte: u8 = encoded[7.usize() + index]
        return false if (byte < 48 or byte > 57) and (byte < 97 or byte > 102) or byte != expected[index]
    return true

def fetch_registry_lock(manifest: darray[u8]&, lock: darray[u8]&, root_name: darray[u8]&, root_version: darray[u8]&, start: darray[u8]&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return EXIT_RESOLVE if not Json::valid_document(lock) or not Json::unique_object_keys(lock) or not lock_version_is(lock, 3)
    # A lockfile is a graph contract, not merely a list of independently
    # authenticated archives. Recompute the canonical graph from the signed
    # registry metadata and compare bytes before any cache mutation. This
    # rejects duplicate, omitted, reordered, or otherwise hand-edited records
    # that could make fetch operate on a graph different from resolution.
    expected_lock: darray[u8] = canonical_lock_for_manifest(root_name, root_version, manifest, start)
    return EXIT_SECURITY if expected_lock.count == 0.usize()
    return EXIT_RESOLVE if not bytes_equal(expected_lock, lock)
    lock_end: usize = json_object_end(lock, 0)
    return EXIT_RESOLVE if lock_end >= lock.count or not valid_direct_field_set(lock, 0, lock_end, 3)
    resolver: mutable darray[u8] = []
    return EXIT_RESOLVE if not object_string_value(lock, 0, json_object_end(lock, 0), "resolver", &resolver) or not bytes_equal_view(resolver, "elisapkg-registry-v1")
    package_start: usize = json_key_value_offset(lock, "package")
    package_end: usize = json_object_end(lock, package_start)
    return EXIT_RESOLVE if package_start >= lock.count or package_end <= package_start
    return EXIT_RESOLVE if not valid_direct_field_set(lock, package_start, package_end, 6)
    locked_name: mutable darray[u8] = []
    locked_version: mutable darray[u8] = []
    return EXIT_RESOLVE if not object_string_value(lock, package_start, package_end, "name", &locked_name) or not object_string_value(lock, package_start, package_end, "version", &locked_version)
    return EXIT_RESOLVE if not bytes_equal(locked_name, root_name) or not bytes_equal(locked_version, root_version)
    manifest_digest_bytes: mutable darray[u8] = []
    manifest_digest: mutable darray[u8] = []
    return EXIT_SECURITY if Integrity::sha256(manifest, &manifest_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
    return EXIT_RESOLVE if not object_sha256_equals(lock, package_start, package_end, "manifest-digest", manifest_digest)
    packages_start: usize = json_key_value_offset(lock, "packages")
    packages_end: usize = json_array_end(lock, packages_start)
    return EXIT_RESOLVE if packages_start >= lock.count or packages_end <= packages_start
    cursor: mutable usize = packages_start + 1.usize()
    fetched: mutable usize = 0.usize()
    while cursor < packages_end:
        while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
            cursor <- cursor + 1.usize()
        break if cursor == packages_end
        return EXIT_RESOLVE if lock[cursor] != 123
        record_end: usize = json_object_end(lock, cursor)
        return EXIT_RESOLVE if record_end <= cursor or record_end >= packages_end
        return EXIT_RESOLVE if not valid_direct_field_set(lock, cursor, record_end, 4)
        package: mutable darray[u8] = []
        version_text: mutable darray[u8] = []
        return EXIT_RESOLVE if not object_string_value(lock, cursor, record_end, "name", &package) or not object_string_value(lock, cursor, record_end, "version", &version_text) or not valid_package_name(package)
        parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
        return EXIT_RESOLVE if not SemVer::parse(version_text, &parsed_version)
        source_start: mutable usize = 0.usize()
        source_end: mutable usize = 0.usize()
        return EXIT_RESOLVE if not object_object_value_span(lock, cursor, record_end, "source", &source_start, &source_end)
        return EXIT_RESOLVE if not valid_direct_field_set(lock, source_start, source_end, 5)
        registry: mutable darray[u8] = []
        archive: mutable darray[u8] = []
        return EXIT_RESOLVE if not object_string_value(lock, source_start, source_end, "registry", &registry) or not bytes_equal_view(registry, "primary") or not object_string_value(lock, source_start, source_end, "archive", &archive) or not Archive::is_safe_entry(archive)
        encoded_digest: mutable darray[u8] = []
        encoded_metadata_digest: mutable darray[u8] = []
        digest: mutable darray[u8] = []
        metadata_digest: mutable darray[u8] = []
        return EXIT_RESOLVE if not object_string_value(lock, cursor, record_end, "archive-digest", &encoded_digest) or not object_string_value(lock, cursor, record_end, "metadata-digest", &encoded_metadata_digest)
        return EXIT_RESOLVE if encoded_digest.count != 71.usize() or encoded_metadata_digest.count != 71.usize()
        return EXIT_RESOLVE if encoded_digest[0] != 115 or encoded_digest[1] != 104 or encoded_digest[2] != 97 or encoded_digest[3] != 50 or encoded_digest[4] != 53 or encoded_digest[5] != 54 or encoded_digest[6] != 58 or encoded_metadata_digest[0] != 115 or encoded_metadata_digest[1] != 104 or encoded_metadata_digest[2] != 97 or encoded_metadata_digest[3] != 50 or encoded_metadata_digest[4] != 53 or encoded_metadata_digest[5] != 54 or encoded_metadata_digest[6] != 58
        for digest_index in 0..<64.usize() |encoded_digest, encoded_metadata_digest, digest, metadata_digest|:
            digest.push(encoded_digest[7.usize() + digest_index])
            metadata_digest.push(encoded_metadata_digest[7.usize() + digest_index])
        archive_size: mutable u64 = 0
        return EXIT_RESOLVE if not object_unsigned_value(lock, cursor, record_end, "archive-size", &archive_size)
        exact: mutable darray[u8] = []
        registry_exact_requirement(parsed_version, &exact)
        selected: mutable darray[u8] = []
        resolved_archive: mutable darray[u8] = []
        resolved_digest: mutable darray[u8] = []
        metadata: mutable darray[u8] = []
        resolved_size: mutable u64 = 0
        registry_status: Registry::ResultCode = Registry::resolve(package, exact, Model::Version{major:0,minor:0,patch:0,prerelease:false}, &selected, &resolved_archive, &resolved_digest, &resolved_size, &metadata)
        if registry_status != Registry::ResultCode.Ok:
            write_error("error: ")
            write_error(Registry::result_message(registry_status))
            write_error(" while verifying locked ")
            write_bytes(2, &package)
            write_error("\n")
            return EXIT_SECURITY if registry_security_status(registry_status)
            return EXIT_SOURCE
        if not bytes_equal(selected, version_text):
            write_error("error: locked registry version does not match signed metadata\n")
            return EXIT_SECURITY
        if not bytes_equal(resolved_archive, archive):
            write_error("error: locked registry archive name does not match signed metadata\n")
            return EXIT_SECURITY
        if not bytes_equal(resolved_digest, digest):
            write_error("error: locked registry archive digest does not match signed metadata\n")
            return EXIT_SECURITY
        if resolved_size != archive_size:
            write_error("error: locked registry archive size does not match signed metadata\n")
            return EXIT_SECURITY
        metadata_digest_bytes: mutable darray[u8] = []
        computed_metadata_digest: mutable darray[u8] = []
        if Integrity::sha256(metadata, &metadata_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(metadata_digest_bytes, &computed_metadata_digest) or not bytes_equal(computed_metadata_digest, metadata_digest):
            write_error("error: locked metadata digest does not match signed metadata\n")
            return EXIT_SECURITY
        archive_bytes: mutable darray[u8] = []
        archive_status: Registry::ResultCode = Registry::read_archive(package, version_text, archive, digest, archive_size, &archive_bytes)
        if archive_status != Registry::ResultCode.Ok:
            write_error("error: ")
            write_error(Registry::result_message(archive_status))
            write_error(" for locked ")
            write_bytes(2, &package)
            write_error("\n")
            return EXIT_SECURITY if registry_security_status(archive_status)
            return EXIT_SOURCE
        trust_status: Registry::ResultCode = Registry::record_trusted(package, version_text, digest)
        if trust_status != Registry::ResultCode.Ok:
            write_error("error: ")
            write_error(Registry::result_message(trust_status))
            write_error(" while recording locked ")
            write_bytes(2, &package)
            write_error("\n")
            return EXIT_SECURITY
        return EXIT_SOURCE if not cache_store_verified_blob(digest, archive_bytes)
        write_ok("verified locked registry artifact ")
        write_bytes(1, &package)
        write_ok(" ")
        write_bytes(1, &version_text)
        write_ok(" sha256:")
        write_bytes(1, &digest)
        write_ok(" (cached)\n")
        fetched <- fetched + 1.usize()
        return EXIT_RESOLVE if fetched > 4096.usize()
        cursor <- record_end + 1.usize()
        while cursor < packages_end and (lock[cursor] == 32 or lock[cursor] == 9 or lock[cursor] == 10 or lock[cursor] == 13) |lock, cursor|:
            cursor <- cursor + 1.usize()
        if cursor < packages_end:
            return EXIT_RESOLVE if lock[cursor] != 44
            cursor <- cursor + 1.usize()
    return EXIT_OK

def run_fetch(argc: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    positional_count: mutable i64 = 0
    package: mutable darray[u8] = []
    requirement: mutable darray[u8] = []
    index: mutable i64 = 2
    while index < argc:
        argument: cstr = slots[index].cast[cstr]
        if cstr_equal(argument, "--"):
            index <- index + 1
            return EXIT_USAGE if index < argc
            break
        if cstr_equal(argument, "--manifest-path"):
            index <- index + 2
            continue
        if Platform::pkg_strlen(argument) == 0.usize():
            write_error("error: fetch does not accept empty arguments\n")
            return EXIT_USAGE
        if argument[0].u8() == 45:
            index <- index + 1
            continue
        if positional_count == 0:
            bytes_push_cstr(&package, argument)
        elif positional_count == 1:
            bytes_push_cstr(&requirement, argument)
        else:
            write_error("error: fetch accepts at most PACKAGE REQUIREMENT\n")
            return EXIT_USAGE
        positional_count <- positional_count + 1
        index <- index + 1
    if positional_count > 0:
        return EXIT_USAGE if positional_count != 2
        if requirement.count == 0:
            write_error("error: fetch PACKAGE requires an exact SemVer requirement\n")
            return EXIT_USAGE
        exact_version: mutable Model::Version = Model::Version{major: 0,minor: 0,patch: 0,prerelease: false}
        return EXIT_USAGE if not SemVer::parse(requirement, &exact_version)
        selected: mutable darray[u8] = []
        archive: mutable darray[u8] = []
        digest: mutable darray[u8] = []
        metadata: mutable darray[u8] = []
        archive_size: mutable u64 = 0
        previous_version: Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
        registry_status: Registry::ResultCode = Registry::resolve(package, requirement, previous_version, &selected, &archive, &digest, &archive_size, &metadata)
        if registry_status != Registry::ResultCode.Ok:
            write_error("error: ")
            write_error(Registry::result_message(registry_status))
            write_error("\n")
            return EXIT_SECURITY if registry_security_status(registry_status)
            return EXIT_RESOLVE
        archive_bytes: mutable darray[u8] = []
        archive_status: Registry::ResultCode = Registry::read_archive(package, selected, archive, digest, archive_size, &archive_bytes)
        if archive_status != Registry::ResultCode.Ok:
            write_error("error: ")
            write_error(Registry::result_message(archive_status))
            write_error("\n")
            return EXIT_SECURITY if registry_security_status(archive_status)
            return EXIT_SOURCE
        trust_status: Registry::ResultCode = Registry::record_trusted(package, selected, digest)
        if trust_status != Registry::ResultCode.Ok:
            write_error("error: ")
            write_error(Registry::result_message(trust_status))
            write_error(" while recording ")
            write_bytes(2, &package)
            write_error("\n")
            return EXIT_SECURITY
        return EXIT_SOURCE if not cache_store_verified_blob(digest, archive_bytes)
        write_ok("verified registry artifact ")
        write_bytes(1, &package)
        write_ok(" ")
        write_bytes(1, &selected)
        write_ok(" sha256:")
        write_bytes(1, &digest)
        write_ok(" (cached)\n")
        _ = start
        _ = options
        return EXIT_OK
    _ = options
    if not project_manifest_exists():
        write_error("error: could not find elisapkg.json in the current directory\n")
        return EXIT_USAGE
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_USAGE if not read_cstr_into("elisapkg.json", &raw)
    name: mutable darray[u8] = []
    version: mutable darray[u8] = []
    return EXIT_RESOLVE if not validate_manifest_at(raw, start, &name, &version)
    lock: mutable darray[u8] = []
    lock.resize(1048577)
    return EXIT_RESOLVE if not read_cstr_into("elisapkg.lock", &lock)
    if lock_version_is(lock, 3):
        return fetch_registry_lock(raw, lock, name, version, start)
    expected: darray[u8] = canonical_lock_for_manifest(name, version, raw, start)
    return EXIT_RESOLVE if expected.count == 0.usize() or not bytes_equal(expected, lock)
    write_ok("verified local locked sources\n")
    return EXIT_OK

def run_publish() -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    write_error(Security::publish_message())
    return Security::publish_status()

def valid_install_prefix(path: darray[u8]&) -> bool:
    # The longest derived path is the receipt path plus a 64-byte package name
    # (`/share/elisapkg/receipts/<name>`), so reserve that suffix before any
    # native path operation sees the prefix.
    return false if path.count == 0.usize() or path.count > 4007.usize() or path[0] != 47
    for index in 0..<path.count |path|:
        return false if path[index] < 32 or path[index] == 127 or path[index] == 0
        return false if index > 0.usize() and path[index - 1.usize()] == 47 and path[index] == 47
    segment_start: mutable usize = 1.usize()
    index: mutable usize = 1.usize()
    while index <= path.count |path, segment_start, index|:
        if index == path.count or path[index] == 47:
            segment_length: usize = index - segment_start
            return false if segment_length == 2.usize() and path[segment_start] == 46 and path[segment_start + 1.usize()] == 46
            segment_start <- index + 1.usize()
        index <- index + 1.usize()
    return true

def local_install_prefix(out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    out.resize(0)
    configured_prefix: u8&? = Platform::pkg_getenv("ELISAPKG_INSTALL_PREFIX")
    if configured_prefix is prefix_value:
        prefix_name: cstr = prefix_value.cast[cstr]
        length: usize = Platform::pkg_strlen(prefix_name)
        return false if length == 0.usize() or length > 4007.usize()
        for index in 0..<length |out, prefix_name|:
            out.push(prefix_name[index].u8())
    else:
        configured_home: u8&? = Platform::pkg_getenv("HOME")
        if configured_home is home_value:
            home_name: cstr = home_value.cast[cstr]
            length: usize = Platform::pkg_strlen(home_name)
            return false if length == 0.usize() or length > 4000.usize()
            for index in 0..<length |out, home_name|:
                out.push(home_name[index].u8())
            out.push(47)
            out.push(46)
            out.push(108)
            out.push(111)
            out.push(99)
            out.push(97)
            out.push(108)
    return valid_install_prefix(out)

def run_install_local(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    prefix: mutable darray[u8] = []
    return EXIT_USAGE if not local_install_prefix(&prefix)
    root: mutable darray[u8] = [46]
    resolved: i64 = run_resolve(&root, options)
    return resolved if resolved != EXIT_OK
    manifest_raw: mutable darray[u8] = []
    manifest_raw.resize(1048577)
    return EXIT_BUILD if not read_cstr_into("elisapkg.json", &manifest_raw)
    target_name: mutable darray[u8] = []
    target_kind: mutable darray[u8] = []
    target_entry: mutable darray[u8] = []
    return EXIT_BUILD if not select_target(manifest_raw, options, &target_name, &target_kind, &target_entry)
    if not bytes_equal_view(target_kind, "bin"):
        write_error("error: install --local requires a binary target\n")
        return 7
    name: mutable darray[u8] = []
    version: mutable darray[u8] = []
    return EXIT_USAGE if not load_package_at(&root, &name, &version)
    return EXIT_BUILD if run_build(start, options) != EXIT_OK
    artifact: mutable darray[u8] = []
    target_name_c: mutable darray[u8] = []
    path_with_nul_into(&target_name, &target_name_c)
    target_name_raw: cstr = (&target_name_c[0]).cast[cstr] can Unsafe.PointerCast
    build_dir: mutable darray[u8] = []
    path_join_into(start, ".elisapkg/build", &build_dir)
    path_join_into(build_dir, target_name_raw, &artifact)
    artifact_bytes: mutable darray[u8] = []
    return 7 if not read_package_file_into(&artifact, &artifact_bytes)
    digest_bytes: mutable darray[u8] = []
    digest: mutable darray[u8] = []
    return 7 if Integrity::sha256(artifact_bytes, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest)
    bin_dir: mutable darray[u8] = []
    receipt_dir: mutable darray[u8] = []
    path_join_into(prefix, "bin", &bin_dir)
    path_join_into(prefix, "share/elisapkg/receipts", &receipt_dir)
    return 7 if not make_directory(&bin_dir) or not make_directory(&receipt_dir)
    name_c: mutable darray[u8] = []
    path_with_nul_into(&name, &name_c)
    name_raw: cstr = (&name_c[0]).cast[cstr] can Unsafe.PointerCast
    destination: mutable darray[u8] = []
    receipt_path: mutable darray[u8] = []
    path_join_into(bin_dir, name_raw, &destination)
    path_join_into(receipt_dir, name_raw, &receipt_path)
    destination_c: mutable darray[u8] = []
    receipt_c: mutable darray[u8] = []
    path_with_nul_into(&destination, &destination_c)
    path_with_nul_into(&receipt_path, &receipt_c)
    destination_name: cstr = (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
    receipt_name: cstr = (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast
    lock_path: mutable darray[u8] = []
    path_join_into(prefix, ".elisapkg-install.lock", &lock_path)
    lock_c: mutable darray[u8] = []
    path_with_nul_into(&lock_path, &lock_c)
    lock_name: cstr = (&lock_c[0]).cast[cstr] can Unsafe.PointerCast
    return 7 if Platform::pkg_mkdir(lock_name, 448.u16()) != 0
    if file_exists(&destination) or file_exists(&receipt_path):
        _ = Platform::pkg_rmdir(lock_name)
        write_error("error: install destination or receipt already exists; refusing to overwrite\n")
        return 7
    if not write_cstr_file_noclobber(destination_name, &artifact_bytes):
        _ = Platform::pkg_rmdir(lock_name)
        return 7
    if Platform::pkg_chmod(destination_name, 493.u16()) != 0:
        _ = remove_known_file(&destination)
        _ = Platform::pkg_rmdir(lock_name)
        return 7
    receipt: mutable darray[u8] = []
    bytes_push_view(&receipt, "elisapkg-install-receipt:1\nname:")
    bytes_push_array(&receipt, name)
    bytes_push_view(&receipt, "\nversion:")
    bytes_push_array(&receipt, version)
    bytes_push_view(&receipt, "\npath:")
    bytes_push_array(&receipt, destination)
    bytes_push_view(&receipt, "\nartifact-digest:sha256:")
    bytes_push_array(&receipt, digest)
    bytes_push_view(&receipt, "\n")
    if not write_cstr_file_noclobber(receipt_name, &receipt):
        _ = remove_known_file(&destination)
        _ = Platform::pkg_rmdir(lock_name)
        return 7
    _ = Platform::pkg_rmdir(lock_name)
    write_ok("installed ")
    write_bytes(1, &name)
    write_ok(" to ")
    write_bytes(1, &destination)
    write_ok("\n")
    return EXIT_OK

def run_install(argc: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    local_seen: mutable bool = false
    index: mutable i64 = 2
    while index < argc |slots, index, local_seen|:
        argument: cstr = slots[index].cast[cstr]
        if cstr_equal(argument, "--local"):
            return EXIT_USAGE if local_seen
            local_seen <- true
        elif cstr_equal(argument, "--bin"):
            return EXIT_USAGE if index + 1 >= argc
            index <- index + 1
        else:
            return EXIT_USAGE
        index <- index + 1
    if local_seen:
        return run_install_local(start, options)
    write_error(Security::install_message())
    return Security::install_status()

def run_uninstall_local(name_raw_input: cstr) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    name: mutable darray[u8] = []
    bytes_push_cstr(&name, name_raw_input)
    prefix: mutable darray[u8] = []
    return EXIT_USAGE if not local_install_prefix(&prefix)
    bin_dir: mutable darray[u8] = []
    receipt_dir: mutable darray[u8] = []
    path_join_into(prefix, "bin", &bin_dir)
    path_join_into(prefix, "share/elisapkg/receipts", &receipt_dir)
    name_c: mutable darray[u8] = []
    path_with_nul_into(&name, &name_c)
    name_raw: cstr = (&name_c[0]).cast[cstr] can Unsafe.PointerCast
    destination: mutable darray[u8] = []
    receipt_path: mutable darray[u8] = []
    path_join_into(bin_dir, name_raw, &destination)
    path_join_into(receipt_dir, name_raw, &receipt_path)
    destination_c: mutable darray[u8] = []
    receipt_c: mutable darray[u8] = []
    path_with_nul_into(&destination, &destination_c)
    path_with_nul_into(&receipt_path, &receipt_c)
    destination_name: cstr = (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
    receipt_name: cstr = (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast
    lock_path: mutable darray[u8] = []
    path_join_into(prefix, ".elisapkg-install.lock", &lock_path)
    lock_c: mutable darray[u8] = []
    path_with_nul_into(&lock_path, &lock_c)
    lock_name: cstr = (&lock_c[0]).cast[cstr] can Unsafe.PointerCast
    return 7 if Platform::pkg_mkdir(lock_name, 448.u16()) != 0
    if not file_exists(&destination) or not file_exists(&receipt_path):
        _ = Platform::pkg_rmdir(lock_name)
        write_error("error: no matching local installation receipt is available\n")
        return 7
    artifact_bytes: mutable darray[u8] = []
    receipt: mutable darray[u8] = []
    receipt.resize(4096)
    if not read_file_into(&destination, &artifact_bytes) or not read_cstr_into(receipt_name, &receipt):
        _ = Platform::pkg_rmdir(lock_name)
        return 7
    digest_bytes: mutable darray[u8] = []
    digest: mutable darray[u8] = []
    if Integrity::sha256(artifact_bytes, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest):
        _ = Platform::pkg_rmdir(lock_name)
        return 7
    expected_prefix: mutable darray[u8] = []
    expected_suffix: mutable darray[u8] = []
    bytes_push_view(&expected_prefix, "elisapkg-install-receipt:1\nname:")
    bytes_push_array(&expected_prefix, name)
    bytes_push_view(&expected_prefix, "\nversion:")
    bytes_push_view(&expected_suffix, "\npath:")
    bytes_push_array(&expected_suffix, destination)
    bytes_push_view(&expected_suffix, "\nartifact-digest:sha256:")
    bytes_push_array(&expected_suffix, digest)
    bytes_push_view(&expected_suffix, "\n")
    version_bytes: mutable darray[u8] = []
    version_end: usize = receipt.count - expected_suffix.count if receipt.count >= expected_suffix.count else 0.usize()
    if not bytes_starts_with(receipt, expected_prefix) or not bytes_ends_with(receipt, expected_suffix) or version_end <= expected_prefix.count:
        _ = Platform::pkg_rmdir(lock_name)
        write_error("error: installation receipt does not match the current file; refusing removal\n")
        return 7
    for index in expected_prefix.count..<version_end |receipt, version_bytes|:
        version_bytes.push(receipt[index])
    parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
    if not parse_version(version_bytes, &parsed_version):
        _ = Platform::pkg_rmdir(lock_name)
        write_error("error: installation receipt does not match the current file; refusing removal\n")
        return 7
    if not remove_known_file(&destination) or not remove_known_file(&receipt_path):
        _ = Platform::pkg_rmdir(lock_name)
        return 7
    _ = Platform::pkg_rmdir(lock_name)
    write_ok("uninstalled ")
    write_bytes(1, &name)
    write_ok("\n")
    return EXIT_OK

def run_uninstall(argc: i64, slots: mutable cstr&&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    local_seen: mutable bool = false
    name: mutable cstr = ""
    index: mutable i64 = 2
    while index < argc:
        argument: cstr = slots[index].cast[cstr]
        if cstr_equal(argument, "--local"):
            return EXIT_USAGE if local_seen
            local_seen <- true
        elif cstr_equal(argument, "--") or Platform::pkg_strlen(argument) == 0.usize() or argument[0].u8() == 45 or Platform::pkg_strlen(name) != 0.usize():
            write_error("error: invalid uninstall arguments\n")
            return EXIT_USAGE
        else:
            name <- argument
        index <- index + 1
    return EXIT_USAGE if not local_seen or Platform::pkg_strlen(name) == 0.usize()
    name_bytes: mutable darray[u8] = []
    bytes_push_cstr(&name_bytes, name)
    return EXIT_USAGE if not valid_package_name(name_bytes)
    return run_uninstall_local(name)

def run_remove(argc: i64, slots: mutable cstr&&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return EXIT_SECURITY if not transaction_recover()
    return EXIT_USAGE if argc != 3
    alias: mutable darray[u8] = []
    bytes_push_cstr(&alias, slots[2].cast[cstr])
    return EXIT_USAGE if not valid_package_name(alias)
    root: mutable darray[u8] = [46]
    root_name: mutable darray[u8] = []
    root_version: mutable darray[u8] = []
    return EXIT_USAGE if not load_package_at(&root, &root_name, &root_version)
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_USAGE if not read_cstr_into("elisapkg.json", &raw)
    return EXIT_USAGE if not validate_manifest_at(raw, &root, &root_name, &root_version)
    updated: darray[u8] = remove_local_dependency(raw, alias)
    if updated.count == 0.usize():
        write_error("error: dependency is not declared; no manifest or lockfile mutation was performed\n")
        return EXIT_RESOLVE
    return EXIT_SECURITY if not transaction_begin(raw)
    if not write_cstr_file("elisapkg.json", &updated) or not transaction_mark_manifest():
        _ = transaction_restore()
        return EXIT_SOURCE
    options: Model::CommandOptions = Model::CommandOptions{locked: false, offline: true, frozen: false, json: false, verbose: false, target_name: "", target_kind: "", update_name: ""}
    resolved: i64 = run_resolve(&root, options)
    if resolved != EXIT_OK:
        restored: bool = transaction_restore()
        if not restored:
            write_error("error: dependency removal failed and the original manifest could not be restored\n")
            return EXIT_SECURITY
        return resolved
    if not transaction_mark_lock():
        _ = transaction_restore()
        return EXIT_SECURITY
    return EXIT_SECURITY if not transaction_commit()
    write_ok("removed dependency ")
    write_bytes(1, &alias)
    write_ok("\n")
    return EXIT_OK

def run_update(argc: i64, slots: mutable cstr&&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return EXIT_SECURITY if not transaction_recover()
    return EXIT_USAGE if argc > 3
    wanted: mutable darray[u8] = []
    if argc == 3:
        bytes_push_cstr(&wanted, slots[2].cast[cstr])
        return EXIT_USAGE if not valid_package_name(wanted)
    root: mutable darray[u8] = [46]
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_USAGE if not read_cstr_into("elisapkg.json", &raw)
    root_name: mutable darray[u8] = []
    root_version: mutable darray[u8] = []
    return EXIT_USAGE if not validate_manifest_at(raw, &root, &root_name, &root_version)
    return EXIT_SECURITY if not transaction_begin(raw)
    options: Model::CommandOptions = Model::CommandOptions{locked: false, offline: true, frozen: false, json: false, verbose: false, target_name: "", target_kind: "", update_name: ""}
    if wanted.count > 0.usize():
        options.update_name <- slots[2].cast[cstr]
    resolved: i64 = run_resolve(&root, options)
    if resolved != EXIT_OK:
        restored: bool = transaction_restore()
        if not restored:
            write_error("error: update failed and the original manifest or lockfile could not be restored\n")
            return EXIT_SECURITY
        return resolved
    if wanted.count > 0.usize():
        lock: mutable darray[u8] = []
        lock.resize(1048577)
        if not read_cstr_into("elisapkg.lock", &lock) or not lock_contains_package(lock, wanted):
            _ = transaction_restore()
            return EXIT_RESOLVE
    if not transaction_mark_lock():
        _ = transaction_restore()
        return EXIT_SECURITY
    return EXIT_SECURITY if not transaction_commit()
    write_ok("updated dependency lock\n")
    return EXIT_OK

def remove_target_outputs(raw: darray[u8]&, build_dir: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    targets_start: usize = json_key_value_offset(raw, "targets")
    return false if targets_start >= raw.count or raw[targets_start] != 91
    targets_end: usize = json_array_end(raw, targets_start)
    return false if targets_end <= targets_start
    cursor: mutable usize = targets_start + 1.usize()
    while cursor < targets_end:
        while cursor < targets_end and (raw[cursor] == 32 or raw[cursor] == 9 or raw[cursor] == 10 or raw[cursor] == 13 or raw[cursor] == 44):
            cursor <- cursor + 1.usize()
        break if cursor >= targets_end
        return false if raw[cursor] != 123
        object_end: usize = json_object_end(raw, cursor)
        return false if object_end <= cursor or object_end >= targets_end
        target_name: mutable darray[u8] = []
        target_kind: mutable darray[u8] = []
        return false if not object_string_value(raw, cursor, object_end, "name", &target_name) or not object_string_value(raw, cursor, object_end, "kind", &target_kind)
        return false if not valid_package_name(target_name)
        return false if not bytes_equal_view(target_kind, "bin") and not bytes_equal_view(target_kind, "lib") and not bytes_equal_view(target_kind, "test")
        artifact_leaf_storage: mutable darray[u8] = []
        for index in 0..<target_name.count |artifact_leaf_storage, target_name|:
            artifact_leaf_storage.push(target_name[index])
        if bytes_equal_view(target_kind, "lib"):
            bytes_push_view(&artifact_leaf_storage, ".o")
        artifact_leaf_storage.push(0)
        artifact_leaf: cstr = (&artifact_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
        artifact: mutable darray[u8] = []
        path_join_into(build_dir, artifact_leaf, &artifact)
        return false if not remove_known_file(&artifact)
        receipt_leaf_storage: mutable darray[u8] = []
        for index in 0..<target_name.count |receipt_leaf_storage, target_name|:
            receipt_leaf_storage.push(target_name[index])
        bytes_push_view(&receipt_leaf_storage, ".receipt")
        receipt_leaf_storage.push(0)
        receipt_leaf: cstr = (&receipt_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
        receipt: mutable darray[u8] = []
        path_join_into(build_dir, receipt_leaf, &receipt)
        return false if not remove_known_file(&receipt)
        cursor <- object_end + 1.usize()
    return true

def run_clean() -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    root: mutable darray[u8] = [46]
    state: mutable darray[u8] = []
    build_dir: mutable darray[u8] = []
    artifact: mutable darray[u8] = []
    library_artifact: mutable darray[u8] = []
    receipt: mutable darray[u8] = []
    package_archive: mutable darray[u8] = []
    package_receipt: mutable darray[u8] = []
    path_join_into(root, ".elisapkg", &state)
    return EXIT_BUILD if not make_directory(&state)
    path_join_into(state, "build", &build_dir)
    path_join_into(build_dir, "app", &artifact)
    path_join_into(build_dir, "app.o", &library_artifact)
    path_join_into(build_dir, "receipt", &receipt)
    path_join_into(state, "package.tar", &package_archive)
    path_join_into(state, "package.receipt", &package_receipt)
    manifest_raw: mutable darray[u8] = []
    manifest_raw.resize(1048577)
    if read_cstr_into("elisapkg.json", &manifest_raw):
        return EXIT_BUILD if not remove_target_outputs(manifest_raw, &build_dir)
    # Remove legacy single-target names left by older receipts as well as the
    # manifest-declared target outputs.
    return EXIT_BUILD if not remove_known_file(&artifact)
    return EXIT_BUILD if not remove_known_file(&library_artifact)
    return EXIT_BUILD if not remove_known_file(&receipt)
    return EXIT_BUILD if not remove_known_file(&package_archive)
    return EXIT_BUILD if not remove_known_file(&package_receipt)
    return EXIT_BUILD if not remove_empty_directory(&build_dir)
    # `.elisapkg` is removed only when it is empty; cache/state files are never
    # traversed or recursively deleted by clean. A retained cache makes this
    # directory intentionally non-empty, which is a successful clean result.
    _ = remove_empty_directory(&state)
    write_ok("cleaned known .elisapkg outputs\n")
    return EXIT_OK

def run_cache_verify(start: darray[u8]&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_USAGE if not read_cstr_into("elisapkg.json", &raw)
    name: mutable darray[u8] = []
    version: mutable darray[u8] = []
    return EXIT_SECURITY if not validate_manifest_at(raw, start, &name, &version)
    lock: mutable darray[u8] = []
    lock.resize(1048577)
    return EXIT_SECURITY if not read_cstr_into("elisapkg.lock", &lock)
    expected: darray[u8] = canonical_lock_for_manifest(name, version, raw, start)
    return EXIT_SECURITY if expected.count == 0.usize() or not bytes_equal(expected, lock)
    archive_present: bool = cstr_file_exists(".elisapkg/package.tar")
    receipt_present: bool = cstr_file_exists(".elisapkg/package.receipt")
    return EXIT_SECURITY if archive_present != receipt_present
    if archive_present:
        manifest_digest_bytes: mutable darray[u8] = []
        manifest_digest: mutable darray[u8] = []
        lock_digest_bytes: mutable darray[u8] = []
        lock_digest: mutable darray[u8] = []
        return EXIT_SECURITY if Integrity::sha256(raw, &manifest_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
        return EXIT_SECURITY if Integrity::sha256(lock, &lock_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(lock_digest_bytes, &lock_digest)
        archive_path: mutable darray[u8] = []
        bytes_push_view(&archive_path, ".elisapkg/package.tar")
        archive_bytes: mutable darray[u8] = []
        return EXIT_SECURITY if not read_package_file_into(&archive_path, &archive_bytes)
        archive_digest_bytes: mutable darray[u8] = []
        archive_digest: mutable darray[u8] = []
        return EXIT_SECURITY if Integrity::sha256(archive_bytes, &archive_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(archive_digest_bytes, &archive_digest)
        receipt: mutable darray[u8] = []
        receipt.resize(8193)
        return EXIT_SECURITY if not read_cstr_into(".elisapkg/package.receipt", &receipt)
        expected_receipt: darray[u8] = Archive::package_receipt_bytes(name, version, manifest_digest, lock_digest, archive_digest)
        return EXIT_SECURITY if not bytes_equal(receipt, expected_receipt)
        return EXIT_SECURITY if not Cache::verify_blob(archive_digest)
    write_ok("cache: local lock and manifest digests verified\n")
    if archive_present:
        write_ok("cache: deterministic package archive and receipt verified\n")
    write_ok("cache: no shared remote cache configured\n")
    return EXIT_OK

def run_cache_gc(argc: i64, slots: mutable cstr&&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    if argc == 4 and cstr_equal(slots[2].cast[cstr], "gc") and cstr_equal(slots[3].cast[cstr], "--dry-run"):
        write_ok("cache: no shared cache configured; nothing would be collected\n")
        return EXIT_OK
    if argc == 3 and cstr_equal(slots[2].cast[cstr], "gc"):
        write_error("error: cache garbage collection is disabled until a verified cache store is configured; use `cache gc --dry-run`\n")
        return 7
    return EXIT_USAGE

def archive_glob_matches(pattern: darray[u8]&, path: darray[u8]&) -> bool:
    pattern_index: mutable usize = 0.usize()
    path_index: mutable usize = 0.usize()
    star_index: mutable usize = 18446744073709551615.usize()
    star_path: mutable usize = 0.usize()
    while path_index < path.count:
        if pattern_index < pattern.count and pattern[pattern_index] == path[path_index]:
            pattern_index <- pattern_index + 1.usize()
            path_index <- path_index + 1.usize()
        elif pattern_index < pattern.count and pattern[pattern_index] == 42:
            star_index <- pattern_index
            pattern_index <- pattern_index + 1.usize()
            star_path <- path_index
        elif star_index != 18446744073709551615.usize():
            pattern_index <- star_index + 1.usize()
            star_path <- star_path + 1.usize()
            path_index <- star_path
        else:
            return false
    while pattern_index < pattern.count and pattern[pattern_index] == 42:
        pattern_index <- pattern_index + 1.usize()
    return pattern_index == pattern.count

def valid_publish_pattern(pattern: darray[u8]&) -> bool:
    return false if pattern.count == 0.usize() or pattern.count > 4096.usize() or pattern[0] == 47 or pattern[0] == 92
    for index in 0..<pattern.count |pattern|:
        return false if pattern[index] == 0 or pattern[index] < 32 or pattern[index] == 127 or pattern[index] == 92
        return false if pattern[index] == 46 and index + 1.usize() < pattern.count and pattern[index + 1.usize()] == 46
        return false if index > 0.usize() and pattern[index - 1.usize()] == 47 and pattern[index] == 47
    return true

def include_allows_path(raw: darray[u8]&, path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    include_start: usize = json_key_value_offset(raw, "include")
    return true if include_start >= raw.count
    include_end: usize = json_array_end(raw, include_start)
    return false if include_end <= include_start or raw[include_start] != 91
    cursor: mutable usize = include_start + 1.usize()
    while cursor < include_end:
        while cursor < include_end and (raw[cursor] == 32 or raw[cursor] == 9 or raw[cursor] == 10 or raw[cursor] == 13) |raw, cursor|:
            cursor <- cursor + 1.usize()
        return false if cursor >= include_end or raw[cursor] != 34
        cursor <- cursor + 1.usize()
        pattern: mutable darray[u8] = []
        while cursor < include_end and raw[cursor] != 34 |raw, cursor, pattern|:
            return false if raw[cursor] == 92 or raw[cursor] < 32 or raw[cursor] == 127
            pattern.push(raw[cursor])
            cursor <- cursor + 1.usize()
        return false if cursor >= include_end or not valid_publish_pattern(pattern)
        return true if archive_glob_matches(pattern, path)
        cursor <- cursor + 1.usize()
        while cursor < include_end and (raw[cursor] == 32 or raw[cursor] == 9 or raw[cursor] == 10 or raw[cursor] == 13) |raw, cursor|:
            cursor <- cursor + 1.usize()
        return false if cursor >= include_end or raw[cursor] != 44
        cursor <- cursor + 1.usize()
    return false

def publish_path_forbidden(path: darray[u8]&) -> bool:
    return true if path.count == 0.usize() or not Archive::is_safe_entry(path)
    return true if bytes_equal_view(path, "IMPLEMENTATION_PLAN.md") or bytes_equal_view(path, ".git") or bytes_equal_view(path, ".hg") or bytes_equal_view(path, ".svn") or bytes_equal_view(path, ".netrc")
    return true if bytes_equal_view(path, "credentials") or bytes_equal_view(path, "credentials.json")
    return true if bytes_count(path, ".git/") > 0.usize() or bytes_count(path, ".hg/") > 0.usize() or bytes_count(path, ".svn/") > 0.usize() or bytes_count(path, ".elisapkg/") > 0.usize() or bytes_count(path, "build/") > 0.usize() or bytes_count(path, "target/") > 0.usize()
    leaf_start: mutable usize = 0.usize()
    for index in 0..<path.count |path, leaf_start|:
        leaf_start <- index + 1.usize() if path[index] == 47
    leaf: mutable darray[u8] = []
    for index in leaf_start..<path.count |path, leaf|:
        leaf.push(path[index])
    return true if bytes_equal_view(leaf, ".git") or bytes_equal_view(leaf, ".hg") or bytes_equal_view(leaf, ".svn") or bytes_equal_view(leaf, "id_rsa") or bytes_equal_view(leaf, "id_ed25519") or bytes_equal_view(leaf, ".env")
    return true if leaf.count >= 4.usize() and leaf[0] == 46 and leaf[1] == 101 and leaf[2] == 110 and leaf[3] == 118
    return true if bytes_count(leaf, ".pem") > 0.usize() or bytes_count(leaf, ".key") > 0.usize()
    return false

def source_tree_digest_into(out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    # Build inputs are the complete sanitized source tree, not only the
    # selected entry file. The native walker returns a deterministic,
    # NUL-separated list and excludes build state, VCS data, and credential
    # names before any file is opened. Hash each path with its content digest
    # so a source rename, addition, deletion, or mutation cannot leave a stale
    # artifact looking reusable.
    out.resize(0)
    buffer: mutable darray[u8] = []
    buffer.resize(16777216)
    buffer_raw: mutable u8& = (&buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
    collected: i64 = Platform::pkg_collect_files(".", buffer_raw, buffer.count)
    return false if collected < 0
    fingerprint: mutable darray[u8] = []
    cursor: mutable usize = 0.usize()
    while cursor < collected.usize():
        path: mutable darray[u8] = []
        while cursor < collected.usize() and buffer[cursor] != 0 |buffer, cursor, path|:
            path.push(buffer[cursor])
            cursor <- cursor + 1.usize()
        return false if cursor >= collected.usize() or path.count == 0.usize()
        cursor <- cursor + 1.usize()
        content: mutable darray[u8] = []
        return false if not read_package_file_into(&path, &content)
        digest_bytes: mutable darray[u8] = []
        return false if Integrity::sha256(content, &digest_bytes) != Integrity::DigestCode.Ok
        for index in 0..<path.count |fingerprint, path|:
            fingerprint.push(path[index])
        fingerprint.push(0)
        for index in 0..<digest_bytes.count |fingerprint, digest_bytes|:
            fingerprint.push(digest_bytes[index])
        fingerprint.push(0)
    digest_bytes: mutable darray[u8] = []
    return false if Integrity::sha256(fingerprint, &digest_bytes) != Integrity::DigestCode.Ok
    digest_hex: mutable darray[u8] = []
    return false if not Integrity::hex_digest(digest_bytes, &digest_hex)
    for index in 0..<digest_hex.count |out, digest_hex|:
        out.push(digest_hex[index])
    return true

def collect_package_paths(raw: darray[u8]&, target: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    out.resize(0)
    buffer: mutable darray[u8] = []
    buffer.resize(8388608)
    buffer_raw: mutable u8& = (&buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
    collected: i64 = Platform::pkg_collect_files(".", buffer_raw, buffer.count)
    return false if collected < 0
    cursor: mutable usize = 0.usize()
    selected: mutable usize = 0.usize()
    target_found: mutable bool = false
    while cursor < collected.usize():
        path: mutable darray[u8] = []
        while cursor < collected.usize() and buffer[cursor] != 0 |buffer, cursor, path|:
            path.push(buffer[cursor])
            cursor <- cursor + 1.usize()
        return false if cursor >= collected.usize()
        cursor <- cursor + 1.usize()
        return false if path.count == 0.usize() or publish_path_forbidden(path)
        required: bool = bytes_equal_view(path, "elisapkg.json") or bytes_equal_view(path, "elisapkg.lock")
        if required or include_allows_path(raw, path):
            for index in 0..<path.count |out, path|:
                out.push(path[index])
            out.push(0)
            selected <- selected + 1.usize()
            target_found <- true if bytes_equal(path, target)
    return selected > 0.usize() and target_found

def package_archive_bytes(raw: darray[u8]&, target: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    out.resize(0)
    paths: mutable darray[u8] = []
    return false if not collect_package_paths(raw, target, &paths)
    cursor: mutable usize = 0.usize()
    while cursor < paths.count:
        entry: mutable darray[u8] = []
        while cursor < paths.count and paths[cursor] != 0 |paths, cursor, entry|:
            entry.push(paths[cursor])
            cursor <- cursor + 1.usize()
        return false if cursor >= paths.count
        cursor <- cursor + 1.usize()
        content: mutable darray[u8] = []
        entry_c: mutable darray[u8] = []
        path_with_nul_into(entry, &entry_c)
        entry_name: cstr = (&entry_c[0]).cast[cstr] can Unsafe.PointerCast
        entry_size: i64 = Platform::pkg_package_file_size(entry_name)
        return false if entry_size < 0 or entry_size > 67108864
        content.resize(entry_size.usize() + 1.usize())
        content_raw: mutable u8& = (&content[0]).cast[mutable u8&] can Unsafe.PointerCast
        read_size: i64 = Platform::pkg_read_package_file(entry_name, content_raw, content.count)
        return false if read_size < 0 or read_size != entry_size
        content.resize(read_size.usize())
        return false if content.count > 67108864.usize() - 1024.usize() - 512.usize() - 511.usize()
        return false if out.count > 67108864.usize() - 1024.usize() - 512.usize() - 511.usize() - content.count
        header: darray[u8] = Archive::tar_file_header(entry, content.count)
        return false if header.count != 512.usize()
        header_start: usize = out.count
        out.resize(out.count + 512.usize())
        for header_index in 0..<512.usize() |out, header, header_start, header_index|:
            out[header_start + header_index] <- header[header_index]
        for content_index in 0..<content.count |out, content|:
            out.push(content[content_index])
        padding: usize = (512.usize() - (content.count % 512.usize())) % 512.usize()
        out.resize(out.count + padding)
    out.resize(out.count + 1024.usize())
    return out.count <= 67108864.usize()

def run_package(argc: i64, slots: mutable cstr&&, start: darray[u8]&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    if not project_manifest_exists():
        write_error("error: could not find elisapkg.json in the current directory\n")
        return EXIT_USAGE
    list_only: mutable bool = false
    for index in 2..<argc |slots, list_only|:
        list_only <- true if cstr_equal(slots[index].cast[cstr], "--list")
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return EXIT_USAGE if not read_cstr_into("elisapkg.json", &raw)
    package_name: mutable darray[u8] = []
    package_version: mutable darray[u8] = []
    return EXIT_USAGE if not validate_manifest_at(raw, start, &package_name, &package_version)
    entry: mutable darray[u8] = []
    return EXIT_USAGE if not first_target_entry(raw, &entry)
    paths: mutable darray[u8] = []
    return EXIT_USAGE if not collect_package_paths(raw, entry, &paths)
    if list_only:
        write_ok("package files:\n")
        cursor: mutable usize = 0.usize()
        while cursor < paths.count:
            path: mutable darray[u8] = []
            write_ok("  ")
            while cursor < paths.count and paths[cursor] != 0 |paths, cursor, path|:
                path.push(paths[cursor])
                cursor <- cursor + 1.usize()
            write_bytes(1, &path)
            write_ok("\n")
            cursor <- cursor + 1.usize()
        write_error("note: signing is required before publish; this command only previews files\n")
        return EXIT_OK
    lock_options: Model::CommandOptions = Model::CommandOptions{locked: true, offline: true, frozen: true, json: false, verbose: false, target_name: "", target_kind: "", update_name: ""}
    return EXIT_RESOLVE if run_resolve(start, lock_options) != EXIT_OK
    lock_raw: mutable darray[u8] = []
    lock_raw.resize(1048577)
    return EXIT_SECURITY if not read_cstr_into("elisapkg.lock", &lock_raw)
    manifest_digest_bytes: mutable darray[u8] = []
    manifest_digest: mutable darray[u8] = []
    lock_digest_bytes: mutable darray[u8] = []
    lock_digest: mutable darray[u8] = []
    return EXIT_SECURITY if Integrity::sha256(raw, &manifest_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
    return EXIT_SECURITY if Integrity::sha256(lock_raw, &lock_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(lock_digest_bytes, &lock_digest)
    state_root: mutable darray[u8] = []
    bytes_push_view(&state_root, ".elisapkg")
    return 7 if not make_directory(&state_root)
    archive: mutable darray[u8] = []
    return 7 if not package_archive_bytes(raw, entry, &archive)
    return 7 if not Archive::verify_ustar_archive(archive)
    archive_path: mutable darray[u8] = []
    path_join_into(start, ".elisapkg/package.tar", &archive_path)
    receipt_path: mutable darray[u8] = []
    path_join_into(start, ".elisapkg/package.receipt", &receipt_path)
    archive_c: mutable darray[u8] = []
    path_with_nul_into(&archive_path, &archive_c)
    archive_name: cstr = (&archive_c[0]).cast[cstr] can Unsafe.PointerCast
    return 7 if not write_cstr_file(archive_name, &archive)
    persisted_archive: mutable darray[u8] = []
    return 7 if not read_package_file_into(&archive_path, &persisted_archive)
    digest_bytes: mutable darray[u8] = []
    digest: mutable darray[u8] = []
    return 7 if Integrity::sha256(persisted_archive, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest)
    blob_path: mutable darray[u8] = []
    return 7 if not Cache::blob_path(digest, &blob_path)
    cache_parent: mutable darray[u8] = []
    bytes_push_view(&cache_parent, ".elisapkg/cache/sha256/")
    cache_parent.push(digest[0])
    cache_parent.push(digest[1])
    return 7 if not make_directory(&cache_parent)
    blob_name_c: mutable darray[u8] = []
    archive_source_c: mutable darray[u8] = []
    quarantine_parent: mutable darray[u8] = []
    quarantine_path: mutable darray[u8] = []
    path_with_nul_into(&blob_path, &blob_name_c)
    path_with_nul_into(&archive_path, &archive_source_c)
    bytes_push_view(&quarantine_parent, ".elisapkg/cache/quarantine")
    bytes_push_view(&quarantine_path, ".elisapkg/cache/quarantine/")
    bytes_push_array(&quarantine_path, digest)
    bytes_push_view(&quarantine_path, ".invalid")
    blob_name: cstr = (&blob_name_c[0]).cast[cstr] can Unsafe.PointerCast
    archive_source_name: cstr = (&archive_source_c[0]).cast[cstr] can Unsafe.PointerCast
    if cstr_file_exists(blob_name):
        if not Cache::verify_blob(digest):
            return 7 if not make_directory(&quarantine_parent)
            quarantine_c: mutable darray[u8] = []
            path_with_nul_into(&quarantine_path, &quarantine_c)
            quarantine_name: cstr = (&quarantine_c[0]).cast[cstr] can Unsafe.PointerCast
            return 7 if Platform::pkg_rename(blob_name, quarantine_name) != 0
            return 7 if Platform::pkg_link(archive_source_name, blob_name) != 0
    elif Platform::pkg_link(archive_source_name, blob_name) != 0:
        return 7 if not cstr_file_exists(blob_name) or not Cache::verify_blob(digest)
    # Revalidate after every publication path. A concurrent rename can change
    # a pathname after the initial existence check; the receipt is written only
    # once the final cache bytes still match the in-memory archive digest.
    return 7 if not Cache::verify_blob(digest)
    receipt: darray[u8] = Archive::package_receipt_bytes(package_name, package_version, manifest_digest, lock_digest, digest)
    return 7 if receipt.count == 0.usize()
    receipt_c: mutable darray[u8] = []
    path_with_nul_into(&receipt_path, &receipt_c)
    receipt_name: cstr = (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast
    return 7 if not write_cstr_file(receipt_name, receipt)
    write_ok("packaged ")
    write_bytes(1, &package_name)
    write_ok(" ")
    write_bytes(1, &package_version)
    write_ok(" -> ")
    write_bytes(1, &archive_path)
    write_ok(" sha256:")
    write_bytes(1, &digest)
    write_ok("\n")
    return EXIT_OK

def run_build(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return EXIT_BUILD if not load_package(start)
    manifest_raw: mutable darray[u8] = []
    manifest_raw.resize(1048577)
    return EXIT_BUILD if not read_cstr_into("elisapkg.json", &manifest_raw)
    root_name: mutable darray[u8] = []
    root_version: mutable darray[u8] = []
    return EXIT_BUILD if not validate_manifest_at(manifest_raw, start, &root_name, &root_version)
    manifest_digest_bytes: mutable darray[u8] = []
    manifest_digest: mutable darray[u8] = []
    return EXIT_BUILD if Integrity::sha256(manifest_raw, &manifest_digest_bytes) != Integrity::DigestCode.Ok
    return EXIT_BUILD if not Integrity::hex_digest(manifest_digest_bytes, &manifest_digest)
    target_name: mutable darray[u8] = []
    target_kind: mutable darray[u8] = []
    target_entry: mutable darray[u8] = []
    return EXIT_BUILD if not select_target(manifest_raw, options, &target_name, &target_kind, &target_entry)
    is_library: bool = bytes_equal_view(target_kind, "lib")
    return EXIT_BUILD if not (is_library or bytes_equal_view(target_kind, "bin") or bytes_equal_view(target_kind, "test"))
    target_entry_c: mutable darray[u8] = []
    path_with_nul_into(&target_entry, &target_entry_c)
    target_resolved_buffer: mutable darray[u8] = []
    target_resolved_buffer.resize(4096)
    target_entry_raw: cstr = (&target_entry_c[0]).cast[cstr] can Unsafe.PointerCast
    target_entry_name: mutable cstr = ""
    if Platform::pkg_realpath(target_entry_raw, &target_resolved_buffer) is resolved_target:
        target_entry_name <- resolved_target
    else:
        return EXIT_BUILD
    lock_status: i64 = run_resolve(start, options)
    return lock_status if lock_status != EXIT_OK
    lock_raw: mutable darray[u8] = []
    lock_raw.resize(1048577)
    return EXIT_BUILD if not read_cstr_into("elisapkg.lock", &lock_raw)
    if lock_version_is(lock_raw, 3):
        fetch_status: i64 = fetch_registry_lock(manifest_raw, lock_raw, root_name, root_version, start)
        return fetch_status if fetch_status != EXIT_OK
    lock_digest_bytes: mutable darray[u8] = []
    lock_digest: mutable darray[u8] = []
    return EXIT_BUILD if Integrity::sha256(lock_raw, &lock_digest_bytes) != Integrity::DigestCode.Ok
    return EXIT_BUILD if not Integrity::hex_digest(lock_digest_bytes, &lock_digest)
    source_tree_digest: mutable darray[u8] = []
    return EXIT_BUILD if not source_tree_digest_into(&source_tree_digest)
    target_source: mutable darray[u8] = []
    target_source_size: i64 = Platform::pkg_package_file_size(target_entry_raw)
    return EXIT_BUILD if target_source_size < 0 or target_source_size > 67108864
    target_source.resize(target_source_size.usize() + 1.usize())
    target_source_raw: mutable u8& = (&target_source[0]).cast[mutable u8&] can Unsafe.PointerCast
    target_source_read: i64 = Platform::pkg_read_package_file(target_entry_raw, target_source_raw, target_source.count)
    return EXIT_BUILD if target_source_read < 0 or target_source_read != target_source_size
    target_source.resize(target_source_read.usize())
    source_digest_bytes: mutable darray[u8] = []
    source_digest: mutable darray[u8] = []
    return EXIT_BUILD if Integrity::sha256(target_source, &source_digest_bytes) != Integrity::DigestCode.Ok
    return EXIT_BUILD if not Integrity::hex_digest(source_digest_bytes, &source_digest)
    build_dir: mutable darray[u8] = []
    artifact: mutable darray[u8] = []
    receipt_path: mutable darray[u8] = []
    path_join_into(start, ".elisapkg/build", &build_dir)
    artifact_leaf_storage: mutable darray[u8] = []
    for index in 0..<target_name.count |artifact_leaf_storage, target_name|:
        artifact_leaf_storage.push(target_name[index])
    artifact_leaf_storage.push(0)
    artifact_leaf: mutable cstr = (&artifact_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
    emit_kind: mutable cstr = "exe"
    artifact_access_mode: mutable i64 = 1
    if is_library:
        artifact_leaf_storage.resize(artifact_leaf_storage.count - 1.usize())
        artifact_leaf_storage.push(46)
        artifact_leaf_storage.push(111)
        artifact_leaf_storage.push(0)
        artifact_leaf <- (&artifact_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
        emit_kind <- "obj"
        artifact_access_mode <- 0
    artifact_label: mutable darray[u8] = []
    bytes_push_cstr(&artifact_label, artifact_leaf)
    path_join_into(build_dir, artifact_leaf, &artifact)
    receipt_leaf_storage: mutable darray[u8] = []
    for index in 0..<target_name.count |receipt_leaf_storage, target_name|:
        receipt_leaf_storage.push(target_name[index])
    bytes_push_view(&receipt_leaf_storage, ".receipt")
    receipt_leaf_storage.push(0)
    receipt_leaf: cstr = (&receipt_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
    path_join_into(build_dir, receipt_leaf, &receipt_path)
    return EXIT_BUILD if not make_directory(&build_dir)
    compiler: mutable cstr = "elisac-stage1"
    if Platform::pkg_getenv("ELISAPKG_COMPILER") is configured:
        compiler <- configured.cast[cstr]
    return EXIT_BUILD if not valid_compiler_argument(compiler)
    # Capture only the compiler settings needed by the wrapper. The child is
    # started with a scrubbed environment so registry credentials and unrelated
    # user variables cannot reach compile-time execution.
    stage1_bin: mutable cstr = ""
    runtime_obj: mutable cstr = ""
    allow_stale: mutable cstr = ""
    if Platform::pkg_getenv("ELISA_STAGE1_BIN") is configured_stage1:
        stage1_bin <- configured_stage1.cast[cstr]
    if Platform::pkg_getenv("ELISA_RUNTIME_OBJ") is configured_runtime:
        runtime_obj <- configured_runtime.cast[cstr]
    if Platform::pkg_getenv("ELISA_ALLOW_STALE_STAGE1") is configured_stale:
        allow_stale <- configured_stale.cast[cstr]
    return EXIT_BUILD if not valid_toolchain_value(stage1_bin, 4096.usize()) or not valid_toolchain_value(runtime_obj, 4096.usize()) or not valid_toolchain_value(allow_stale, 64.usize())
    compiler_identity: mutable darray[u8] = []
    stage1_identity: mutable darray[u8] = []
    runtime_identity: mutable darray[u8] = []
    compiler_identity_ok: mutable bool = true
    if compiler[0].u8() == 0:
        bytes_push_view(&compiler_identity, "none")
    else:
        compiler_content: mutable darray[u8] = []
        compiler_path: mutable darray[u8] = []
        bytes_push_cstr(&compiler_path, compiler)
        if not read_package_file_into(&compiler_path, &compiler_content):
            bytes_push_view(&compiler_identity, "unavailable")
            compiler_identity_ok <- false
        else:
            compiler_digest_bytes: mutable darray[u8] = []
            compiler_digest: mutable darray[u8] = []
            if Integrity::sha256(compiler_content, &compiler_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(compiler_digest_bytes, &compiler_digest):
                bytes_push_view(&compiler_identity, "unavailable")
                compiler_identity_ok <- false
            else:
                bytes_push_view(&compiler_identity, "sha256:")
                bytes_push_array(&compiler_identity, compiler_digest)
    stage1_identity_ok: mutable bool = true
    if stage1_bin[0].u8() == 0:
        bytes_push_view(&stage1_identity, "none")
    else:
        stage1_content: mutable darray[u8] = []
        stage1_path: mutable darray[u8] = []
        bytes_push_cstr(&stage1_path, stage1_bin)
        if not read_package_file_into(&stage1_path, &stage1_content):
            bytes_push_view(&stage1_identity, "unavailable")
            stage1_identity_ok <- false
        else:
            stage1_digest_bytes: mutable darray[u8] = []
            stage1_digest: mutable darray[u8] = []
            if Integrity::sha256(stage1_content, &stage1_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(stage1_digest_bytes, &stage1_digest):
                bytes_push_view(&stage1_identity, "unavailable")
                stage1_identity_ok <- false
            else:
                bytes_push_view(&stage1_identity, "sha256:")
                bytes_push_array(&stage1_identity, stage1_digest)
    runtime_identity_ok: mutable bool = true
    if runtime_obj[0].u8() == 0:
        bytes_push_view(&runtime_identity, "none")
    else:
        runtime_content: mutable darray[u8] = []
        runtime_path: mutable darray[u8] = []
        bytes_push_cstr(&runtime_path, runtime_obj)
        if not read_package_file_into(&runtime_path, &runtime_content):
            bytes_push_view(&runtime_identity, "unavailable")
            runtime_identity_ok <- false
        else:
            runtime_digest_bytes: mutable darray[u8] = []
            runtime_digest: mutable darray[u8] = []
            if Integrity::sha256(runtime_content, &runtime_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(runtime_digest_bytes, &runtime_digest):
                bytes_push_view(&runtime_identity, "unavailable")
                runtime_identity_ok <- false
            else:
                bytes_push_view(&runtime_identity, "sha256:")
                bytes_push_array(&runtime_identity, runtime_digest)
    toolchain_identity_ok: bool = compiler_identity_ok and stage1_identity_ok and runtime_identity_ok
    receipt: mutable darray[u8] = []
    bytes_push_view(&receipt, "elisapkg-build-receipt:6\nentry:")
    bytes_push_array(&receipt, target_entry)
    bytes_push_view(&receipt, "\ntarget-kind:")
    bytes_push_array(&receipt, target_kind)
    bytes_push_view(&receipt, "\nartifact:")
    bytes_push_cstr(&receipt, artifact_leaf)
    bytes_push_view(&receipt, "\nsource-tree-digest:sha256:")
    bytes_push_array(&receipt, source_tree_digest)
    bytes_push_view(&receipt, "\nsource-digest:sha256:")
    bytes_push_array(&receipt, source_digest)
    bytes_push_view(&receipt, "\nmanifest-digest:sha256:")
    bytes_push_array(&receipt, manifest_digest)
    bytes_push_view(&receipt, "\nlock-digest:sha256:")
    bytes_push_array(&receipt, lock_digest)
    bytes_push_view(&receipt, "\ncompiler:")
    bytes_push_cstr(&receipt, compiler)
    bytes_push_view(&receipt, "\nstage1-bin:")
    bytes_push_cstr(&receipt, stage1_bin)
    bytes_push_view(&receipt, "\nruntime-object:")
    bytes_push_cstr(&receipt, runtime_obj)
    bytes_push_view(&receipt, "\ncompiler-identity:")
    bytes_push_array(&receipt, compiler_identity)
    bytes_push_view(&receipt, "\nstage1-identity:")
    bytes_push_array(&receipt, stage1_identity)
    bytes_push_view(&receipt, "\nruntime-identity:")
    bytes_push_array(&receipt, runtime_identity)
    bytes_push_view(&receipt, "\nallow-stale:")
    bytes_push_cstr(&receipt, allow_stale)
    bytes_push_view(&receipt, "\nsemantic-gate:1")
    artifact_c: mutable darray[u8] = []
    receipt_c: mutable darray[u8] = []
    path_with_nul_into(&artifact, &artifact_c)
    path_with_nul_into(&receipt_path, &receipt_c)
    artifact_name: cstr = (&artifact_c[0]).cast[cstr] can Unsafe.PointerCast
    receipt_name: cstr = (&receipt_c[0]).cast[cstr] can Unsafe.PointerCast
    if toolchain_identity_ok and cstr_file_exists(artifact_name) and cstr_file_exists(receipt_name) and Platform::pkg_access(artifact_name, artifact_access_mode) == 0:
        cached_artifact: mutable darray[u8] = []
        cached_receipt: mutable darray[u8] = []
        cached_receipt.resize(4096)
        if read_package_file_into(&artifact, &cached_artifact) and read_cstr_into(receipt_name, &cached_receipt):
            cached_digest_bytes: mutable darray[u8] = []
            cached_digest: mutable darray[u8] = []
            if Integrity::sha256(cached_artifact, &cached_digest_bytes) == Integrity::DigestCode.Ok and Integrity::hex_digest(cached_digest_bytes, &cached_digest):
                expected_receipt: mutable darray[u8] = []
                bytes_push_array(&expected_receipt, receipt)
                bytes_push_view(&expected_receipt, "\nartifact-digest:sha256:")
                bytes_push_array(&expected_receipt, cached_digest)
                bytes_push_view(&expected_receipt, "\n")
                if bytes_equal(cached_receipt, expected_receipt):
                    write_ok("built .elisapkg/build/")
                    write_bytes(1, &artifact_label)
                    write_ok(" (cached)\n")
                    _ = options
                    return EXIT_OK
    # The lock digest includes every resolved local dependency identity and
    # source digest. Recompile whenever that graph changes instead of reusing a
    # root-only artifact.
    # mkstemp keeps the compiler output path exclusive for the whole child
    # process, preventing a predictable temporary symlink from redirecting the
    # output. The final rename is the only point at which app becomes visible.
    temp_template: mutable darray[u8] = []
    for index in 0..<build_dir.count |temp_template, build_dir|:
        temp_template.push(build_dir[index])
    if temp_template.count == 0.usize() or temp_template[temp_template.count - 1.usize()] != 47:
        temp_template.push(47)
    bytes_push_cstr(&temp_template, artifact_leaf)
    bytes_push_view(&temp_template, ".tmp.XXXXXX")
    temp_template.push(0)
    temp_fd: i64 = Platform::pkg_mkstemp(&temp_template)
    return EXIT_BUILD if temp_fd < 0
    _ = Platform::pkg_close(temp_fd)
    temp_name: cstr = (&temp_template[0]).cast[cstr] can Unsafe.PointerCast
    # An explicit compiler is required for reproducible builds. PATH lookup is
    # delegated to execvp only after the user has selected the executable.
    stage1_env: mutable darray[u8] = []
    runtime_env: mutable darray[u8] = []
    stale_env: mutable darray[u8] = []
    args: mutable darray[cstr] = []
    args.push("/usr/bin/env")
    args.push("-i")
    args.push("PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin")
    args.push("ELISA_STAGE1_SEMANTIC_GATE=1")
    if not cstr_equal(stage1_bin, ""):
        bytes_push_view(&stage1_env, "ELISA_STAGE1_BIN=")
        bytes_push_cstr(&stage1_env, stage1_bin)
        stage1_env.push(0)
        args.push((&stage1_env[0]).cast[cstr] can Unsafe.PointerCast)
    if not cstr_equal(runtime_obj, ""):
        bytes_push_view(&runtime_env, "ELISA_RUNTIME_OBJ=")
        bytes_push_cstr(&runtime_env, runtime_obj)
        runtime_env.push(0)
        args.push((&runtime_env[0]).cast[cstr] can Unsafe.PointerCast)
    if not cstr_equal(allow_stale, ""):
        bytes_push_view(&stale_env, "ELISA_ALLOW_STALE_STAGE1=")
        bytes_push_cstr(&stale_env, allow_stale)
        stale_env.push(0)
        args.push((&stale_env[0]).cast[cstr] can Unsafe.PointerCast)
    args.push(compiler)
    args.push("-emit")
    args.push(emit_kind)
    args.push("-o")
    args.push(temp_name)
    args.push(target_entry_name)
    args.push(null)
    child_argv: mutable cstr&& = (&args[0]).cast[mutable cstr&&] can Unsafe.PointerCast
    pid: i64 = Platform::pkg_fork()
    if pid == 0:
        _ = Platform::pkg_set_process_group()
        if Platform::pkg_set_process_limits(1) != 0:
            Platform::pkg_process_exit(126)
        _ = Platform::pkg_execvp("/usr/bin/env", child_argv)
        Platform::pkg_process_exit(127)
    if pid < 0:
        _ = Platform::pkg_unlink(temp_name)
        return EXIT_BUILD
    status: mutable i64 = 0
    waited: i64 = Platform::pkg_waitpid_timeout(pid, &status, BUILD_TIMEOUT_MS)
    if waited == Platform::pkg_timeout_error():
        _ = Platform::pkg_unlink(temp_name)
        write_error("error: compiler exceeded the 10-minute execution limit\n")
        return EXIT_CANCEL
    if waited < 0 or status != 0:
        _ = Platform::pkg_unlink(temp_name)
        return EXIT_BUILD
    temporary_size: i64 = Platform::pkg_package_file_size(temp_name)
    if temporary_size <= 0:
        _ = Platform::pkg_unlink(temp_name)
        return EXIT_BUILD
    if Platform::pkg_access(temp_name, artifact_access_mode) != 0:
        _ = Platform::pkg_unlink(temp_name)
        return EXIT_BUILD
    temporary_path: mutable darray[u8] = []
    bytes_push_cstr(&temporary_path, temp_name)
    artifact_content: mutable darray[u8] = []
    artifact_digest_bytes: mutable darray[u8] = []
    artifact_digest: mutable darray[u8] = []
    if not read_package_file_into(&temporary_path, &artifact_content):
        _ = Platform::pkg_unlink(temp_name)
        return EXIT_BUILD
    if Integrity::sha256(artifact_content, &artifact_digest_bytes) != Integrity::DigestCode.Ok:
        _ = Platform::pkg_unlink(temp_name)
        return EXIT_BUILD
    if not Integrity::hex_digest(artifact_digest_bytes, &artifact_digest):
        _ = Platform::pkg_unlink(temp_name)
        return EXIT_BUILD
    if Platform::pkg_rename(temp_name, artifact_name) != 0:
        _ = Platform::pkg_unlink(temp_name)
        return EXIT_BUILD
    bytes_push_view(&receipt, "\nartifact-digest:sha256:")
    bytes_push_array(&receipt, artifact_digest)
    bytes_push_view(&receipt, "\n")
    if not write_cstr_file(receipt_name, &receipt):
        _ = Platform::pkg_unlink(artifact_name)
        return EXIT_BUILD
    write_ok("built .elisapkg/build/")
    write_bytes(1, &artifact_label)
    write_ok("\n")
    _ = options
    return EXIT_OK

def run_program(argc: i64, slots: mutable cstr&&, options: Model::CommandOptions, expected_kind: cstr) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    manifest_raw: mutable darray[u8] = []
    manifest_raw.resize(1048577)
    return EXIT_BUILD if not read_cstr_into("elisapkg.json", &manifest_raw)
    target_name: mutable darray[u8] = []
    target_kind: mutable darray[u8] = []
    target_entry: mutable darray[u8] = []
    return EXIT_BUILD if not select_target(manifest_raw, options, &target_name, &target_kind, &target_entry)
    if not bytes_equal_view(target_kind, expected_kind):
        write_error("error: selected target does not produce an executable\n")
        return EXIT_BUILD
    artifact_leaf_storage: mutable darray[u8] = []
    for item in 0..<target_name.count |artifact_leaf_storage, target_name|:
        artifact_leaf_storage.push(target_name[item])
    artifact_leaf_storage.push(0)
    artifact_leaf: cstr = (&artifact_leaf_storage[0]).cast[cstr] can Unsafe.PointerCast
    build_root: mutable darray[u8] = []
    bytes_push_view(&build_root, ".elisapkg/build")
    artifact_path: mutable darray[u8] = []
    path_join_into(build_root, artifact_leaf, &artifact_path)
    artifact_path_c: mutable darray[u8] = []
    path_with_nul_into(&artifact_path, &artifact_path_c)
    artifact_name: cstr = (&artifact_path_c[0]).cast[cstr] can Unsafe.PointerCast
    args: mutable darray[cstr] = []
    args.push("/usr/bin/env")
    args.push("-i")
    args.push("PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin")
    args.push(artifact_name)
    index: mutable i64 = 2
    while index < argc and not cstr_equal(slots[index].cast[cstr], "--") |slots, index|:
        index <- index + 1
    index <- index + 1 if index < argc and cstr_equal(slots[index].cast[cstr], "--")
    while index < argc |args, slots, index|:
        args.push(slots[index].cast[cstr])
        index <- index + 1
    args.push(null)
    child_argv: mutable cstr&& = (&args[0]).cast[mutable cstr&&] can Unsafe.PointerCast
    pid: i64 = Platform::pkg_fork()
    if pid == 0:
        _ = Platform::pkg_set_process_group()
        if Platform::pkg_set_process_limits(2) != 0:
            Platform::pkg_process_exit(126)
        _ = Platform::pkg_execvp("/usr/bin/env", child_argv)
        Platform::pkg_process_exit(127)
    return EXIT_BUILD if pid < 0
    status: mutable i64 = 0
    waited: i64 = Platform::pkg_waitpid_timeout(pid, &status, PROGRAM_TIMEOUT_MS)
    return EXIT_CANCEL if waited == Platform::pkg_timeout_error()
    return EXIT_BUILD if waited < 0
    # waitpid returns the platform wait status. Preserve a normal child's exit
    # code for `run`, and map signal termination to the documented cancellation
    # status instead of exposing the platform-specific wait encoding.
    return status / 256 if status % 256 == 0
    return EXIT_CANCEL

def compact_manifest_args(argc: i64, slots: mutable cstr&&, out: mutable darray[cstr]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    out.resize(0)
    return 0 if argc < 2
    out.push(slots[0].cast[cstr])
    out.push(slots[1].cast[cstr])
    index: mutable i64 = 2
    separator_seen: mutable bool = false
    while index < argc |slots, out, index, separator_seen|:
        if cstr_equal(slots[index].cast[cstr], "--"):
            separator_seen <- true
            out.push(slots[index].cast[cstr])
            index <- index + 1
            continue
        if not separator_seen and cstr_equal(slots[index].cast[cstr], "--manifest-path"):
            index <- index + 2
            continue
        out.push(slots[index].cast[cstr])
        index <- index + 1
    out.push(null)
    return out.count.i64() - 1

# ---------- command line --------------------------------------------------------------

module Cli:
    public:
        # The only public command surface. Platform, model, and trust-policy
        # implementation details are intentionally absent from this contract.
        def run(argc: i64, argv: mutable void&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return cli_main(argc, argv)
    private:
        const command_contract_version: i64 = 1

def cli_main(argc: i64, argv: mutable void&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    if argc <= 1:
        usage()
        return EXIT_USAGE
    command: cstr = slots[1].cast[cstr]
    if cstr_equal(command, "--help") or cstr_equal(command, "-h"):
        usage()
        return EXIT_OK
    if cstr_equal(command, "--version"):
        write_ok("elisapkg 0.1.0\n")
        return EXIT_OK
    if cstr_equal(command, "init"):
        return run_init(argc, slots)
    manifest_path: mutable darray[u8] = []
    has_manifest_path: mutable bool = false
    scan_index: mutable i64 = 2
    while scan_index < argc |slots, manifest_path, has_manifest_path, scan_index|:
        scan_flag: cstr = slots[scan_index].cast[cstr]
        break if cstr_equal(scan_flag, "--")
        if cstr_equal(scan_flag, "--manifest-path"):
            return EXIT_USAGE if has_manifest_path or scan_index + 1 >= argc
            bytes_push_cstr(&manifest_path, slots[scan_index + 1].cast[cstr])
            return EXIT_USAGE if manifest_path.count == 0.usize() or manifest_path.count > 4096.usize()
            has_manifest_path <- true
            scan_index <- scan_index + 2
        else:
            scan_index <- scan_index + 1
    if has_manifest_path:
        return EXIT_USAGE if manifest_path.count == 0.usize() or not change_to_manifest_path(&manifest_path)
    effective_argc: mutable i64 = argc
    effective_slots: mutable cstr&& = slots
    compacted: mutable darray[cstr] = []
    if has_manifest_path:
        effective_argc <- compact_manifest_args(argc, slots, &compacted)
        return EXIT_USAGE if effective_argc == 0
        effective_slots <- (&compacted[0]).cast[mutable cstr&&] can Unsafe.PointerCast
    if cstr_equal(command, "add") or cstr_equal(command, "remove") or cstr_equal(command, "update"):
        return run_add(effective_argc, effective_slots) if cstr_equal(command, "add")
        return run_remove(effective_argc, effective_slots) if cstr_equal(command, "remove")
        return run_update(effective_argc, effective_slots)
    return EXIT_SECURITY if not transaction_recover()
    # `.` means the process working directory and keeps path operations on a
    # non-empty, well-defined byte buffer.
    start: mutable darray[u8] = [46]
    options: mutable Model::CommandOptions = Model::CommandOptions{locked: false, offline: false, frozen: false, json: false, verbose: false, target_name: "", target_kind: "", update_name: ""}
    flags_ok: mutable bool = true
    positional_count: mutable i64 = 0
    separator_seen: mutable bool = false
    index: mutable i64 = 2
    while index < effective_argc |effective_slots, options, flags_ok, positional_count, separator_seen, index|:
        flag: cstr = effective_slots[index].cast[cstr]
        if cstr_equal(flag, "--"):
            separator_seen <- true
            flags_ok <- false if not (cstr_equal(command, "run") or cstr_equal(command, "test"))
            index <- index + 1
            continue
        if separator_seen:
            index <- index + 1
            continue
        if cstr_equal(flag, "--bin") or cstr_equal(flag, "--lib") or cstr_equal(flag, "--test"):
            target_allowed: bool = (cstr_equal(command, "build") and (cstr_equal(flag, "--bin") or cstr_equal(flag, "--lib") or cstr_equal(flag, "--test"))) or (cstr_equal(command, "run") and cstr_equal(flag, "--bin")) or (cstr_equal(command, "test") and cstr_equal(flag, "--test")) or (cstr_equal(command, "install") and cstr_equal(flag, "--bin"))
            flags_ok <- false if not target_allowed or index + 1 >= effective_argc
            if flags_ok:
                target_value: cstr = effective_slots[index + 1].cast[cstr]
                target_length: usize = Platform::pkg_strlen(target_value)
                flags_ok <- false if target_length == 0.usize() or target_length > 64.usize() or target_value[0].u8() == 45 or Platform::pkg_strlen(options.target_name) != 0.usize()
                if flags_ok:
                    options.target_name <- target_value
                    options.target_kind <- "bin" if cstr_equal(flag, "--bin")
                    options.target_kind <- "lib" if cstr_equal(flag, "--lib")
                    options.target_kind <- "test" if cstr_equal(flag, "--test")
            index <- index + 2
            continue
        options.locked <- true if cstr_equal(flag, "--locked")
        options.offline <- true if cstr_equal(flag, "--offline")
        options.frozen <- true if cstr_equal(flag, "--frozen")
        options.json <- true if cstr_equal(flag, "--json")
        options.verbose <- true if cstr_equal(flag, "--verbose")
        flag_length: usize = Platform::pkg_strlen(flag)
        is_positional: bool = flag_length > 0.usize() and flag[0].u8() != 45
        positional_allowed: bool = (cstr_equal(command, "why") and positional_count == 0) or (cstr_equal(command, "install") and positional_count == 0) or (cstr_equal(command, "uninstall") and positional_count == 0) or (cstr_equal(command, "cache") and positional_count == 0) or (cstr_equal(command, "fetch") and positional_count < 2)
        recognized: bool = is_positional and positional_allowed
        recognized <- true if not is_positional and (cstr_equal(flag, "--locked") or cstr_equal(flag, "--offline") or cstr_equal(flag, "--frozen") or cstr_equal(flag, "--json") or cstr_equal(flag, "--verbose") or (cstr_equal(flag, "--list") and cstr_equal(command, "package")) or (cstr_equal(flag, "--dry-run") and cstr_equal(command, "cache")) or (cstr_equal(command, "install") and cstr_equal(flag, "--local")) or (cstr_equal(command, "uninstall") and cstr_equal(flag, "--local")))
        flags_ok <- false if not recognized
        positional_count <- positional_count + 1 if recognized and is_positional
        index <- index + 1
    if cstr_equal(command, "run") and Platform::pkg_strlen(options.target_kind) == 0.usize():
        options.target_kind <- "bin"
    if cstr_equal(command, "test") and Platform::pkg_strlen(options.target_kind) == 0.usize():
        options.target_kind <- "test"
    if not flags_ok:
        write_error("error: unknown option; run `elisapkg --help`\n")
        return EXIT_USAGE
    if cstr_equal(command, "check-manifest"):
        return run_check(&start, options)
    if cstr_equal(command, "resolve"):
        return run_resolve(&start, options)
    if cstr_equal(command, "tree"):
        return run_tree(&start)
    if cstr_equal(command, "why"):
        return run_why(effective_argc, effective_slots, &start)
    if cstr_equal(command, "metadata"):
        return run_metadata(&start, options)
    if cstr_equal(command, "doctor"):
        return run_doctor()
    if cstr_equal(command, "fetch"):
        return run_fetch(effective_argc, effective_slots, &start, options)
    if cstr_equal(command, "publish"):
        return run_publish()
    if cstr_equal(command, "install"):
        return run_install(effective_argc, effective_slots, &start, options)
    if cstr_equal(command, "uninstall"):
        return run_uninstall(effective_argc, effective_slots)
    if cstr_equal(command, "clean"):
        return run_clean()
    if cstr_equal(command, "cache") and effective_argc == 3 and cstr_equal(effective_slots[2].cast[cstr], "verify"):
        return run_cache_verify(&start)
    if cstr_equal(command, "cache"):
        return run_cache_gc(effective_argc, effective_slots)
    if cstr_equal(command, "package"):
        return run_package(effective_argc, effective_slots, &start)
    if cstr_equal(command, "build") or cstr_equal(command, "run") or cstr_equal(command, "test"):
        return run_build(&start, options) if cstr_equal(command, "build")
        if cstr_equal(command, "run"):
            build_status: i64 = run_build(&start, options)
            return build_status if build_status != EXIT_OK
            return run_program(effective_argc, effective_slots, options, "bin")
        return run_test(effective_argc, effective_slots, &start, options)
    write_error("error: unknown command; run `elisapkg --help`\n")
    return EXIT_USAGE

def main(argc: i64, argv: mutable void&) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    status: i64 = Cli::run(argc, argv)
    Platform::pkg_process_exit(status)
    return status
