# Elisa Packaging System (`elisapkg`).
#
# The package manager keeps policy and algorithms in Elisa. Platform seams are
# small libc bindings with `pkg_` names so they cannot collide with the compiler
# runtime's declarations. Remote transport, archive extraction, and signing are
# separate capabilities and are refused until their trust configuration is
# present; no command silently falls back to an insecure mode.

include "./platform.elisa"
include "./cli/status.elisa"
include "./install_faults.elisa"
include "./package/install_prefix.elisa"
include "./sandbox.elisa"
include "./package/model.elisa"
include "./security.elisa"
include "./archive.elisa"
include "./package/manifest_edits.elisa"
include "./package/targets.elisa"
include "./package/selection.elisa"
include "./package/assembly.elisa"
include "./resolution/semver.elisa"
include "./integrity.elisa"
include "./build.elisa"
include "./text/bytes.elisa"
include "./cli/arguments.elisa"
include "./cli/output.elisa"
include "./cli/build_command.elisa"
include "./cli/maintenance.elisa"
include "./cli/program.elisa"
include "./cli/fetch.elisa"
include "./cli/resolution.elisa"
include "./cli/project_context.elisa"
include "./cli/local_install.elisa"
include "./source/fingerprint.elisa"
include "./project/transaction.elisa"
include "./project/lock_validation.elisa"
include "./project/files.elisa"
include "./project/manifest.elisa"

module Cli:
    private:
        # Package version identities share the SemVer parser's bounded length.
        # Install metadata then adds only bounded paths, names, and fixed fields.
        const MAX_INSTALL_VERSION_BYTES: usize = SemVer::maximum_version_bytes

        # ---------- path and file primitives --------------------------------------------------

        def read_package_file_into(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return Platform::read_bounded_file(path, Integrity::maximum_input, out)

        # ---------- semantic versions ---------------------------------------------------------

        def version_compare(left: Model::Version, right: Model::Version) -> i64:
            return SemVer::compare(left, right)

        # ---------- project discovery and commands -------------------------------------------

        def run_initialize(argument_count: i64, slots: mutable cstr&&) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                root: mutable darray[u8] = [46]
                target_kind: mutable cstr = "bin"
                target_kind_seen: mutable bool = false
                region path_seen_scope:
                    path_seen: mutable bool = false
                    for index in 2..<argument_count |slots, root, target_kind, target_kind_seen, path_seen|:
                        argument: cstr = slots[index].cast[cstr]
                        if Platform::c_string_equal(argument, "--lib"):
                            return CliStatus::usage if target_kind_seen and not Platform::c_string_equal(target_kind, "lib")
                            target_kind <- "lib"
                            target_kind_seen <- true
                        elif Platform::c_string_equal(argument, "--bin"):
                            return CliStatus::usage if target_kind_seen and not Platform::c_string_equal(target_kind, "bin")
                            target_kind <- "bin"
                            target_kind_seen <- true
                        elif Platform::c_string_equal(argument, "--help"):
                            CliOutput::usage()
                            return CliStatus::success
                        elif Platform::c_string_length(argument) == 0.usize() or argument[0].u8() == 45 or path_seen:
                            return CliStatus::usage
                        else:
                            root <- []
                            ByteText::append_bounded_text(&root, argument)
                            path_seen <- true
                return CliStatus::usage if:
                    root.count == 0.usize()
                    root.count > 4096.usize()
                manifest_path: mutable darray[u8] = []
                region legacy_manifest_path_scope:
                    legacy_manifest_path: mutable darray[u8] = []
                    ProjectFiles::path_join_into(root, "elisapkg.json", &manifest_path)
                    ProjectFiles::path_join_into(root, "manifest.json", &legacy_manifest_path)
                    # Keep init consistent with normal project discovery: an existing
                    # compiler manifest and package manifest cannot share one root.
                    return CliStatus::usage if:
                        ProjectFiles::path_occupied(&manifest_path)
                        ProjectFiles::path_occupied(&legacy_manifest_path)
                source: mutable darray[u8] = []
                state: mutable darray[u8] = []
                entry_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(root, "src", &source)
                ProjectFiles::path_join_into(root, ".elisapkg", &state)
                ProjectFiles::path_join_into(source, "main.elisa", &entry_path)
                # Refuse an existing source file before creating any scaffold
                # directories, so a failed init leaves the destination untouched.
                return CliStatus::usage if ProjectFiles::path_occupied(&entry_path)
                return CliStatus::source_failed if:
                    not ProjectFiles::make_directory(&root)
                    not ProjectFiles::make_directory(&source) or not ProjectFiles::make_directory(&state)
                manifest: darray[u8] = ManifestEdits::initial_document(Platform::c_string_equal(target_kind, "lib"))
                region entry_scope:
                    entry: mutable darray[u8] = []
                    ByteText::append_text(&entry, "def main() -> i64:\n    return 0\n")
                    return CliStatus::usage if ProjectFiles::path_occupied(&entry_path)
                    return CliStatus::source_failed if ProjectFiles::publish_file_exclusively(manifest_path, &manifest) != 0
                    if ProjectFiles::publish_file_exclusively(entry_path, &entry) != 0:
                        # The manifest was published exclusively. Keep it when the second
                        # scaffold file fails: removing by pathname could delete a file that
                        # another actor installed after the first publication.
                        return CliStatus::source_failed
                CliOutput::write_ok("created package\n")
                return CliStatus::success

        def run_check(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if not ProjectContext::load_package(start):
                    CliOutput::write_error("error: invalid or missing elisapkg.json (schema-version, package.name, package.version, and targets are required)\n")
                    return CliStatus::usage
                if options.json:
                    CliOutput::write_ok("{\"schema-version\":1,\"valid\":true,\"manifest\":\"elisapkg.json\"}\n")
                    return CliStatus::success
                CliOutput::write_ok("manifest valid: ")
                CliOutput::write_ok("elisapkg.json")
                CliOutput::write_ok("\n")
                return CliStatus::success

        def run_metadata(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if not ProjectContext::manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return CliStatus::usage
                raw: mutable darray[u8] = []
                raw <- raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::usage if not ProjectFiles::read_c_string_into("elisapkg.json", &raw)
                name: mutable darray[u8] = []
                region version_scope:
                    version: mutable darray[u8] = []
                    return CliStatus::usage if:
                        not ProjectManifest::validate(raw, &name, &version)
                        not options.json
                    CliOutput::write_ok("{\"schema-version\":1,\"package\":{\"name\":\"")
                    CliOutput::write_bytes(1, &name)
                    CliOutput::write_ok("\",\"version\":\"")
                    CliOutput::write_bytes(1, &version)
                CliOutput::write_ok("\"}}\n")
                return CliStatus::success

        def run_doctor() -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok("elisapkg doctor\n")
                CliOutput::write_ok("manifest: JSON schema v1\n")
                CliOutput::write_ok("resolver: deterministic local v1\n")
                CliOutput::write_ok("source integrity: local file verification\n")
                CliOutput::write_ok("metadata signatures: Ed25519 verification requires a fixed trusted local OpenSSL candidate; checked during verification; network transport disabled\n")
                if Sandbox::build_sandbox_available():
                    CliOutput::write_ok("build sandbox: sandbox-exec is present; compiler builds apply a deny-default profile and fail closed if it is rejected\n")
                else:
                    CliOutput::write_ok("build sandbox: sandbox-exec is unavailable; builds fail closed on this platform\n")
                CliOutput::write_ok("child environment: scrubbed; only compiler bootstrap variables are retained\n")
                CliOutput::write_ok("compiler: set ELISAPKG_COMPILER to an audited compiler adapter\n")
                return CliStatus::success

        def run_test(argument_count: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                raw: mutable darray[u8] = []
                raw <- raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::usage if not ProjectFiles::read_c_string_into("elisapkg.json", &raw)
                selected_name: mutable darray[u8] = []
                selected_kind: mutable darray[u8] = []
                region selected_entry_scope:
                    selected_entry: mutable darray[u8] = []
                    return CliStatus::usage if not ManifestTargets::select_target(raw, options.target_name, options.target_kind, &selected_name, &selected_kind, &selected_entry) or not ByteText::equal_text(selected_kind, "test")
                # Reusing the normal build path keeps dependency, lock, and compiler-
                # environment checks identical while multi-target planning is completed.
                region status_scope:
                    status: i64 = BuildCommand::run(start, options)
                    return status if status != CliStatus::success
                return ProgramCommand::run(argument_count, slots, options, "test")

        def run_publish_dry_run(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                # Validate the exact local release inputs without writing an archive
                # or contacting a registry. Publication itself remains trust-gated,
                # but callers still need a useful preflight command.
                if not ProjectContext::manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return CliStatus::usage
                raw: mutable darray[u8] = []
                raw <- raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::usage if not ProjectFiles::read_c_string_into("elisapkg.json", &raw)
                package_name: mutable darray[u8] = []
                package_version: mutable darray[u8] = []
                return CliStatus::resolution_failed if not ProjectManifest::validate_at(raw, start, &package_name, &package_version)
                region lock_options_scope:
                    lock_options: Model::CommandOptions = Model::CommandOptions{locked: true, offline: true, frozen: true, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                    return CliStatus::resolution_failed if ResolutionCommand::resolve(start, lock_options, false, false) != CliStatus::success
                lock: mutable darray[u8] = []
                lock <- lock.resize(ProjectFiles::project_document_limit)
                return CliStatus::security_failed if:
                    not ProjectFiles::read_c_string_into("elisapkg.lock", &lock)
                    not LockValidation::matches_manifest(raw, lock, package_name, package_version, start)
                source_digest: mutable darray[u8] = []
                return CliStatus::security_failed if not SourceFingerprint::current(&source_digest)
                entry: mutable darray[u8] = []
                return CliStatus::usage if not ManifestTargets::default_entry(raw, &entry)
                region paths_scope:
                    paths: mutable darray[u8] = []
                    return CliStatus::usage if not PackageAssembly::collect_paths(raw, entry, &paths)
                archive: mutable darray[u8] = []
                return CliStatus::security_failed if not PackageAssembly::archive_bytes(raw, entry, &archive) or not Archive::verify_ustar_archive(archive)
                region archive_repeat_scope:
                    archive_repeat: mutable darray[u8] = []
                    return CliStatus::security_failed if not PackageAssembly::archive_bytes(raw, entry, &archive_repeat) or not Archive::verify_ustar_archive(archive_repeat) or not ByteText::equal(archive_repeat, archive)
                region source_digest_after_scope:
                    source_digest_after: mutable darray[u8] = []
                    return CliStatus::security_failed if not SourceFingerprint::current(&source_digest_after) or not ByteText::equal(source_digest_after, source_digest)
                manifest_after: mutable darray[u8] = []
                manifest_after <- manifest_after.resize(ProjectFiles::project_document_limit)
                region lock_after_scope:
                    lock_after: mutable darray[u8] = []
                    lock_after <- lock_after.resize(ProjectFiles::project_document_limit)
                    return CliStatus::security_failed if:
                        not ProjectFiles::read_c_string_into("elisapkg.json", &manifest_after) or not ProjectFiles::read_c_string_into("elisapkg.lock", &lock_after)
                        not ByteText::equal(manifest_after, raw) or not ByteText::equal(lock_after, lock)
                archive_digest: mutable darray[u8] = []
                return CliStatus::security_failed if not Integrity::sha256_hex(archive, &archive_digest)
                if options.json:
                    region size_text_scope:
                        size_text: mutable darray[u8] = []
                        ByteText::append_decimal(&size_text, archive.count.u64())
                        CliOutput::write_ok("{\"schema-version\":1,\"command\":\"publish\",\"dry-run\":true,\"valid\":true,\"source-tree-digest\":\"sha256:")
                        CliOutput::write_bytes(1, &source_digest)
                        CliOutput::write_ok("\",\"archive-size\":")
                        CliOutput::write_bytes(1, &size_text)
                    CliOutput::write_ok(",\"archive-digest\":\"sha256:")
                    CliOutput::write_bytes(1, &archive_digest)
                    CliOutput::write_ok("\"}\n")
                    return CliStatus::success
                CliOutput::write_ok("publish dry-run: manifest, lockfile, source tree, and package file selection are valid\n")
                CliOutput::write_error("note: signing and authenticated publication are still required\n")
                return CliStatus::success

        def run_publish() -> i64 can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error(Security::publish_message())
                return Security::publish_status()

        def run_install_local(start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                prefix: mutable darray[u8] = []
                return CliStatus::usage if not InstallPrefix::read_configured(&prefix)
                if not InstallPrefix::trusted_existing_ancestor(prefix):
                    CliOutput::write_error("error: install prefix directories must be owned by root or the current user, without group or other write permission\n")
                    return CliStatus::operation_failed
                root: mutable darray[u8] = [46]
                region resolved_scope:
                    resolved: i64 = ResolutionCommand::resolve(&root, options, false, false)
                    return resolved if resolved != CliStatus::success
                manifest_raw: mutable darray[u8] = []
                manifest_raw <- manifest_raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::build_failed if not ProjectFiles::read_c_string_into("elisapkg.json", &manifest_raw)
                target_name: mutable darray[u8] = []
                target_kind: mutable darray[u8] = []
                region target_entry_scope:
                    target_entry: mutable darray[u8] = []
                    return CliStatus::build_failed if not ManifestTargets::select_target(manifest_raw, options.target_name, options.target_kind, &target_name, &target_kind, &target_entry)
                if not ByteText::equal_text(target_kind, "bin"):
                    CliOutput::write_error("error: install --local requires a binary target\n")
                    return CliStatus::operation_failed
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return CliStatus::usage if not ProjectManifest::load_at(&root, &name, &version)
                if version.count > MAX_INSTALL_VERSION_BYTES:
                    CliOutput::write_error("error: local install package versions exceed the bounded receipt limit\n")
                    return CliStatus::usage
                use_prebuilt_artifact: bool = InstallFaults::use_test_prebuilt_artifact()
                expected_build_digest: mutable darray[u8] = []
                if not use_prebuilt_artifact:
                    return CliStatus::build_failed if BuildCommand::run_with_digest(start, options, &expected_build_digest) != CliStatus::success
                artifact: mutable darray[u8] = []
                region build_directory_scope:
                    build_directory: darray[u8] = Build::output_directory(start, Platform::c_string_equal(options.profile, "release"))
                    ProjectFiles::path_join_bytes_into(build_directory, target_name, &artifact)
                artifact_bytes: mutable darray[u8] = []
                return CliStatus::operation_failed if not read_package_file_into(&artifact, &artifact_bytes)
                digest_bytes: mutable darray[u8] = []
                digest: mutable darray[u8] = []
                return CliStatus::operation_failed if Integrity::sha256(artifact_bytes, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest)
                if not use_prebuilt_artifact and (expected_build_digest.count != 64.usize() or not ByteText::equal(digest, expected_build_digest)):
                    CliOutput::write_error("error: build output changed after compilation; refusing to install an unverified artifact\n")
                    return CliStatus::build_failed
                return LocalInstallCommand::publish_verified(prefix, name, version, artifact_bytes, digest)

        def run_install(argument_count: i64, slots: mutable cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                local_seen: mutable bool = false
                package_seen: mutable bool = false
                index: mutable i64 = 2
                while index < argument_count |slots, index, local_seen, package_seen|:
                    region argument_scope:
                        argument: cstr = slots[index].cast[cstr]
                        if Platform::c_string_equal(argument, "--local"):
                            return CliStatus::usage if local_seen
                            local_seen <- true
                        elif Platform::c_string_equal(argument, "--bin"):
                            return CliStatus::usage if index + 1 >= argument_count
                            # The common option parser has already validated and
                            # stored this target name. Consume its value here so it
                            # cannot be mistaken for a remote package argument.
                            index <- index + 1
                        elif not package_seen:
                            package_seen <- true
                        else:
                            return CliStatus::usage
                    index <- index + 1
                return CliStatus::usage if:
                    local_seen and package_seen
                    not local_seen and not package_seen
                if local_seen:
                    return run_install_local(start, options)
                CliOutput::write_error(Security::install_message())
                return Security::install_status()

        def run_package(argument_count: i64, slots: mutable cstr&&, start: darray[u8]&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if not ProjectContext::manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return CliStatus::usage
                list_only: mutable bool = false
                for index in 2..<argument_count |slots, list_only|:
                    list_only <- true if Platform::c_string_equal(slots[index].cast[cstr], "--list")
                raw: mutable darray[u8] = []
                raw <- raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::usage if not ProjectFiles::read_c_string_into("elisapkg.json", &raw)
                package_name: mutable darray[u8] = []
                package_version: mutable darray[u8] = []
                return CliStatus::usage if not ProjectManifest::validate_at(raw, start, &package_name, &package_version)
                entry: mutable darray[u8] = []
                return CliStatus::usage if not ManifestTargets::default_entry(raw, &entry)
                paths: mutable darray[u8] = []
                return CliStatus::usage if not PackageAssembly::collect_paths(raw, entry, &paths)
                if list_only:
                    CliOutput::write_ok("package files:\n")
                    while cursor < paths.count |cursor: usize = 0.usize()|:
                        region path_scope:
                            path: mutable darray[u8] = []
                            CliOutput::write_ok("  ")
                            while cursor < paths.count and paths[cursor] != 0 |paths, cursor, path|:
                                path <- path.push(paths[cursor])
                                cursor <- cursor + 1.usize()
                            CliOutput::write_bytes(1, &path)
                        CliOutput::write_ok("\n")
                        cursor <- cursor + 1.usize()
                    CliOutput::write_error("note: signing is required before publish; this command only previews files\n")
                    return CliStatus::success
                region lock_options_scope:
                    lock_options: Model::CommandOptions = Model::CommandOptions{locked: true, offline: true, frozen: true, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                    return CliStatus::resolution_failed if ResolutionCommand::resolve(start, lock_options, false, false) != CliStatus::success
                lock_raw: mutable darray[u8] = []
                lock_raw <- lock_raw.resize(ProjectFiles::project_document_limit)
                return CliStatus::security_failed if not ProjectFiles::read_c_string_into("elisapkg.lock", &lock_raw)
                manifest_digest: mutable darray[u8] = []
                lock_digest: mutable darray[u8] = []
                return CliStatus::security_failed if:
                    not Integrity::sha256_hex(raw, &manifest_digest)
                    not Integrity::sha256_hex(lock_raw, &lock_digest)
                # `run_resolve` validated the lock before returning, but packaging
                # reads the source tree afterwards. Revalidate at this boundary so a
                # source mutation between resolution and archive creation cannot be
                # published under an older lock identity.
                return CliStatus::security_failed if not LockValidation::matches_manifest(raw, lock_raw, package_name, package_version, start)
                return match PackageAssembly::write_outputs(start, raw, lock_raw, entry, package_name, package_version, manifest_digest, lock_digest):
                    PackageAssembly::Code.Ok: CliStatus::success
                    PackageAssembly::Code.SecurityFailure: CliStatus::security_failed
                    PackageAssembly::Code.OutputFailure: CliStatus::operation_failed

        # ---------- command line --------------------------------------------------------------

        def cli_main(argument_count: i64, argument_vector: mutable void&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                slots: mutable cstr&& = argument_vector.cast[mutable cstr&&]
                CliOutput::configure(false, false)
                quiet: mutable bool = false
                if argument_count <= 1:
                    CliOutput::usage()
                    return CliStatus::usage
                command: cstr = slots[1].cast[cstr]
                if Platform::c_string_equal(command, "--help") or Platform::c_string_equal(command, "-h"):
                    CliOutput::usage()
                    return CliStatus::success
                if Platform::c_string_equal(command, "--version"):
                    CliOutput::write_ok("elisapkg 0.1.0\n")
                    return CliStatus::success
                if Platform::c_string_equal(command, "init"):
                    initialize_slots: mutable darray[cstr] = []
                    initialize_argument_count: i64 = CliArguments::compact_output_modes(argument_count, slots, &initialize_slots, &quiet)
                    CliOutput::configure(quiet, false)
                    return CliStatus::usage if initialize_argument_count < 0
                    return run_initialize(initialize_argument_count, (&initialize_slots[0]).cast[mutable cstr&&] can Unsafe.PointerCast)
                manifest_path: mutable darray[u8] = []
                has_manifest_path: mutable bool = false
                region scan_index_scope:
                    scan_index: mutable i64 = 2
                    while scan_index < argument_count |slots, manifest_path, has_manifest_path, scan_index|:
                        scan_flag: cstr = slots[scan_index].cast[cstr]
                        break if Platform::c_string_equal(scan_flag, "--")
                        if Platform::c_string_equal(scan_flag, "--manifest-path"):
                            return CliStatus::usage if has_manifest_path or scan_index + 1 >= argument_count
                            ByteText::append_bounded_text(&manifest_path, slots[scan_index + 1].cast[cstr])
                            return CliStatus::usage if:
                                manifest_path.count == 0.usize() or manifest_path.count > 4096.usize()
                                manifest_path.count >= 2.usize() and manifest_path[0] == 45 and manifest_path[1] == 45
                            has_manifest_path <- true
                            scan_index <- scan_index + 2
                        else:
                            scan_index <- scan_index + 1
                effective_argument_count: mutable i64 = argument_count
                effective_slots: mutable cstr&& = slots
                compacted: mutable darray[cstr] = []
                region dependency_edit_scope:
                    dependency_edit: bool = Platform::c_string_equal(command, "add") or Platform::c_string_equal(command, "remove") or Platform::c_string_equal(command, "update")
                    if has_manifest_path or dependency_edit:
                        effective_argument_count <- CliArguments::compact_manifest_arguments(argument_count, slots, &compacted, &quiet)
                        CliOutput::configure(quiet, false)
                        return CliStatus::usage if effective_argument_count <= 0
                        effective_slots <- (&compacted[0]).cast[mutable cstr&&] can Unsafe.PointerCast
                    if dependency_edit:
                        return CliStatus::usage if has_manifest_path and not ProjectContext::change_to_manifest_path(manifest_path)
                        return ResolutionCommand::add(effective_argument_count, effective_slots) if Platform::c_string_equal(command, "add")
                        return ResolutionCommand::remove(effective_argument_count, effective_slots) if Platform::c_string_equal(command, "remove")
                        return ResolutionCommand::update(effective_argument_count, effective_slots)
                # `.` means the process working directory and keeps path operations on a
                # non-empty, well-defined byte buffer.
                start: mutable darray[u8] = [46]
                options: mutable Model::CommandOptions = Model::CommandOptions{locked: false, offline: false, frozen: false, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                publish_dry_run: mutable bool = false
                region flags_ok_scope:
                    flags_ok: bool = CliArguments::read_common_flags(effective_argument_count, effective_slots, command, &options, &quiet, &publish_dry_run)
                    CliOutput::configure(quiet, options.json)
                    if not flags_ok:
                        CliOutput::write_error("error: unknown option; run `elisapkg --help`\n")
                        return CliStatus::usage
                parsed_options: mutable darray[cstr] = []
                parsed_argument_count: i64 = CliArguments::compact_validated_global_options(effective_argument_count, effective_slots, &parsed_options)
                return CliStatus::usage if parsed_argument_count < 0
                effective_argument_count <- parsed_argument_count
                dispatch_slots: mutable cstr&& = (&parsed_options[0]).cast[mutable cstr&&] can Unsafe.PointerCast
                CliArguments::read_target_flags(effective_argument_count, dispatch_slots, command, &options)
                return CliStatus::usage if has_manifest_path and not ProjectContext::change_to_manifest_path(manifest_path)
                return run_doctor() if Platform::c_string_equal(command, "doctor")
                if Platform::c_string_equal(command, "uninstall"):
                    return LocalInstallCommand::uninstall(effective_argument_count, dispatch_slots)
                if Platform::c_string_equal(command, "fetch"):
                    return FetchCommand::run(effective_argument_count, dispatch_slots, &start, options)
                return CliStatus::security_failed if not ProjectTransaction::recover()
                if Platform::c_string_equal(command, "check-manifest"):
                    return run_check(&start, options)
                if Platform::c_string_equal(command, "resolve"):
                    return ResolutionCommand::resolve(&start, options, false, true)
                if Platform::c_string_equal(command, "tree"):
                    return ResolutionCommand::tree(&start, options)
                if Platform::c_string_equal(command, "why"):
                    return ResolutionCommand::why(effective_argument_count, dispatch_slots, &start, options)
                if Platform::c_string_equal(command, "metadata"):
                    return run_metadata(&start, options)
                if Platform::c_string_equal(command, "publish"):
                    return run_publish_dry_run(start, options) if publish_dry_run
                    return run_publish()
                if Platform::c_string_equal(command, "install"):
                    return run_install(effective_argument_count, dispatch_slots, &start, options)
                if Platform::c_string_equal(command, "clean"):
                    return MaintenanceCommand::clean()
                if Platform::c_string_equal(command, "cache"):
                    return MaintenanceCommand::run_cache(effective_argument_count, dispatch_slots, start)
                if Platform::c_string_equal(command, "package"):
                    return run_package(effective_argument_count, dispatch_slots, &start)
                if Platform::c_string_equal(command, "build") or Platform::c_string_equal(command, "run") or Platform::c_string_equal(command, "test"):
                    return BuildCommand::run(&start, options) if Platform::c_string_equal(command, "build")
                    if Platform::c_string_equal(command, "run"):
                        region build_status_scope:
                            build_status: i64 = BuildCommand::run(&start, options)
                            return build_status if build_status != CliStatus::success
                        return ProgramCommand::run(effective_argument_count, dispatch_slots, options, "bin")
                    return run_test(effective_argument_count, dispatch_slots, &start, options)
                CliOutput::write_error("error: unknown command; run `elisapkg --help`\n")
                return CliStatus::usage

    public:
        # The only public command surface. Platform, model, and trust-policy
        # implementation details are intentionally absent from this contract.
        def run(argument_count: i64, argument_vector: mutable void&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return cli_main(argument_count, argument_vector)

def main(argument_count: i64, argument_vector: mutable void&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    can Global{Read,Write}:
        status: i64 = Cli::run(argument_count, argument_vector)
        Platform::exit_process(status)
        return status
