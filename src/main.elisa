def validate_manifest_at(raw: darray[u8]&, root: darray[u8]&, name_out: mutable darray[u8]&, version_out: mutable darray[u8]&) -> bool:
    return false if raw.count == 0.usize() or raw.count > 1048576.usize()
    return false if not Json::valid_utf8(raw)
    return false if not Json::valid_document(raw)
    return false if not Json::unique_object_keys(raw)
    return false if not allowed_manifest_keys(raw)
    for index in 0..<raw.count |raw|:
        return false if raw[index] == 0
    first: mutable usize = 0.usize()
    last: mutable usize = raw.count
    while first < raw.count and (raw[first] == 32 or raw[first] == 9 or raw[first] == 10 or raw[first] == 13) |raw, first|:
        first <- first + 1.usize()
    while last > first and (raw[last - 1.usize()] == 32 or raw[last - 1.usize()] == 9 or raw[last - 1.usize()] == 10 or raw[last - 1.usize()] == 13) |raw, last, first|:
        last <- last - 1.usize()
    return false if first >= last or raw[first] != 123 or raw[last - 1.usize()] != 125
    return false if json_object_end(raw, first) != last - 1.usize()
    return false if json_top_key_count(raw, "schema-version") != 1.usize()
    return false if not json_key_value_is_one(raw, "schema-version")
    return false if json_top_key_count(raw, "package") != 1.usize()
    return false if not valid_optional_package_strings(raw)
    return false if not valid_include_array(raw)
    return false if json_key_count(raw, "name") < 1.usize()
    return false if json_top_key_count(raw, "targets") != 1.usize()
    return false if json_key_count(raw, "entry") < 1.usize()
    return false if not valid_target_entries(raw, root)
    return false if not valid_target_kinds(raw)
    return false if not valid_target_objects(raw)
    return false if json_top_key_count(raw, "dependencies") > 1.usize()
    return false if json_top_key_count(raw, "dev-dependencies") > 1.usize()
    return false if not valid_dependency_map(raw, "dependencies")
    return false if not valid_dependency_map(raw, "dev-dependencies")
    name: mutable darray[u8] = []
    version: mutable darray[u8] = []
    return false if not key_value(raw, "name", &name) or not key_value(raw, "version", &version)
    return false if not valid_package_name(name)
    parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
    return false if not parse_version(version, &parsed)
    for index in 0..<name.count |name_out, name|:
        name_out.push(name[index])
    for index in 0..<version.count |version_out, version|:
        version_out.push(version[index])
    return true

def validate_manifest(raw: darray[u8]&, name_out: mutable darray[u8]&, version_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    root: mutable darray[u8] = [46]
    return validate_manifest_at(raw, &root, name_out, version_out)

def load_package_at(root: darray[u8]&, name_out: mutable darray[u8]&, version_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    manifest_path: mutable darray[u8] = []
    path_join_into(root, "elisapkg.json", &manifest_path)
    path_c: mutable darray[u8] = []
    path_with_nul_into(manifest_path, &path_c)
    path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    return false if not cstr_file_exists(path_name)
    raw: mutable darray[u8] = []
    raw.resize(1048577)
    return false if not read_cstr_into(path_name, &raw)
    return false if not validate_manifest_at(raw, root, name_out, version_out)
    return true

