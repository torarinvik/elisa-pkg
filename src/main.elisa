# Elisa Packaging System (`elisapkg`).
#
# The package manager keeps policy and algorithms in Elisa. Platform seams are
# small libc bindings with `pkg_` names so they cannot collide with the compiler
# runtime's declarations. Remote transport, archive extraction, and signing are
# separate capabilities and are refused until their trust configuration is
# present; no command silently falls back to an insecure mode.

include "./platform.elisa"
include "./cli/status.elisa"
include "./install_faults.elisa"
include "./package/install_prefix.elisa"
include "./sandbox.elisa"
include "./package/model.elisa"
include "./security.elisa"
include "./archive.elisa"
include "./package/manifest_edits.elisa"
include "./package/targets.elisa"
include "./package/selection.elisa"
include "./package/assembly.elisa"
include "./resolution/semver.elisa"
include "./integrity.elisa"
include "./build.elisa"
include "./text/bytes.elisa"
include "./cli/arguments.elisa"
include "./cli/output.elisa"
include "./cli/build_command.elisa"
include "./cli/maintenance.elisa"
include "./cli/program.elisa"
include "./cli/fetch.elisa"
include "./cli/resolution.elisa"
include "./cli/project_context.elisa"
include "./cli/local_install.elisa"
include "./cli/commands/init_command.elisa"
include "./cli/commands/install_command.elisa"
include "./cli/commands/package_command.elisa"
include "./source/fingerprint.elisa"
include "./project/transaction.elisa"
include "./project/lock_validation.elisa"
include "./project/files.elisa"
include "./project/manifest.elisa"

module Cli:
    private:
        def run_check(start: darray[u8]&, options: Model::CommandOptions) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if not ProjectContext::load_package(start):
                    CliOutput::write_error("error: invalid or missing elisapkg.json (schema-version, package.name, package.version, and targets are required)\n")
                    return CliStatus::usage
                if options.json:
                    CliOutput::write_ok("{\"schema-version\":1,\"valid\":true,\"manifest\":\"elisapkg.json\"}\n")
                    return CliStatus::success
                CliOutput::write_ok("manifest valid: ")
                CliOutput::write_ok("elisapkg.json")
                CliOutput::write_ok("\n")
                return CliStatus::success

        def run_metadata(start: darray[u8]&, options: Model::CommandOptions) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                if not ProjectContext::manifest_exists():
                    CliOutput::write_error("error: could not find elisapkg.json in the current directory\n")
                    return CliStatus::usage
                raw: mutable darray[u8] = []
                name: mutable darray[u8] = []
                version: mutable darray[u8] = []
                return CliStatus::usage if not ProjectFiles::read_project_document("elisapkg.json", &raw) or not ProjectManifest::validate(raw, &name, &version) or not options.json else report_metadata(name, version)

        def report_metadata(name: darray[u8]&, version: darray[u8]&) -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok("{\"schema-version\":1,\"package\":{\"name\":\"")
                CliOutput::write_bytes(1, name)
                CliOutput::write_ok("\",\"version\":\"")
                CliOutput::write_bytes(1, version)
                CliOutput::write_ok("\"}}\n")
                return CliStatus::success

        def run_doctor() -> CliStatus::ExitStatus can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok("elisapkg doctor\n")
                CliOutput::write_ok("manifest: JSON schema v1\n")
                CliOutput::write_ok("resolver: deterministic local v1\n")
                CliOutput::write_ok("source integrity: local file verification\n")
                CliOutput::write_ok("metadata signatures: Ed25519 verification requires a fixed trusted local OpenSSL candidate; checked during verification; network transport disabled\n")
                if Sandbox::build_sandbox_available():
                    CliOutput::write_ok("build sandbox: sandbox-exec is present; compiler builds apply a deny-default profile and fail closed if it is rejected\n")
                else:
                    CliOutput::write_ok("build sandbox: sandbox-exec is unavailable; builds fail closed on this platform\n")
                CliOutput::write_ok("child environment: scrubbed; only compiler bootstrap variables are retained\n")
                CliOutput::write_ok("compiler: set ELISAPKG_COMPILER to an audited compiler adapter\n")
                return CliStatus::success

        def run_test(argument_count: i64, slots: cstr&&, start: darray[u8]&, options: Model::CommandOptions) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                raw: mutable darray[u8] = []
                # Reusing the normal build path keeps dependency, lock, and compiler-
                # environment checks identical while multi-target planning is completed.
                return CliStatus::usage if not ProjectFiles::read_project_document("elisapkg.json", &raw) or not selects_test_target(raw, options) else build_and_run(argument_count, slots, start, options, "test")

        # Whether the target `options` names is a test target.
        def selects_test_target(raw: darray[u8]&, options: Model::CommandOptions) -> bool can[Memory.Allocate, Abort.Panic]:
            selected_name: mutable darray[u8] = []
            selected_kind: mutable darray[u8] = []
            selected_entry: mutable darray[u8] = []
            return ManifestTargets::select_target(raw, options.target_name, options.target_kind, &selected_name, &selected_kind, &selected_entry) and ByteText::equal_text(selected_kind, "test")

        # Build the project, then run the built program of `target_kind`.
        def build_and_run(argument_count: i64, slots: cstr&&, start: darray[u8]&, options: Model::CommandOptions, target_kind: cstr) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                build_status: i64 = BuildCommand::run(start, options)
                return build_status if build_status != CliStatus::success else ProgramCommand::run(argument_count, slots, options, target_kind)

        # ---------- command line --------------------------------------------------------------

        # The optional `--manifest-path PATH`, and whether it was given.
        struct ManifestPathOption:
            path: mutable darray[u8]
            present: mutable bool

        # Read the optional `--manifest-path PATH` before `--`. Returns false
        # for a repeated, missing, empty, oversized, or flag-like path.
        def read_manifest_path(argument_count: i64, slots: cstr&&, manifest_path: mutable darray[u8]&, has_manifest_path: mutable bool&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            while scan_index < argument_count |scan_index: i64 = 2|:
                scan_flag: cstr = slots[scan_index].cast[cstr]
                break if Platform::c_string_equal(scan_flag, "--")
                if Platform::c_string_equal(scan_flag, "--manifest-path"):
                    return false if has_manifest_path or scan_index + 1 >= argument_count
                    ByteText::append_bounded_text(manifest_path, slots[scan_index + 1].cast[cstr])
                    return false if:
                        manifest_path.count == 0.usize() or manifest_path.count > 4096.usize()
                        manifest_path.count >= 2.usize() and manifest_path[0] == 45 and manifest_path[1] == 45
                    has_manifest_path <- true
                    scan_index <- scan_index + 2
                else:
                    scan_index <- scan_index + 1
            return true

        # Run a command that needs a recovered project transaction.
        def dispatch_project_command(command: cstr, argument_count: i64, slots: cstr&&, start: mutable darray[u8]&, options: Model::CommandOptions, publish_dry_run: bool) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if Platform::c_string_equal(command, "check-manifest"):
                    return run_check(start, options)
                if Platform::c_string_equal(command, "resolve"):
                    return ResolutionCommand::resolve(start, options, false, true)
                if Platform::c_string_equal(command, "tree"):
                    return ResolutionCommand::tree(start, options)
                if Platform::c_string_equal(command, "why"):
                    return ResolutionCommand::why(argument_count, slots, start, options)
                if Platform::c_string_equal(command, "metadata"):
                    return run_metadata(start, options)
                if Platform::c_string_equal(command, "publish"):
                    return PackageCommand::publish_dry_run(start, options) if publish_dry_run else PackageCommand::publish()
                if Platform::c_string_equal(command, "install"):
                    return InstallCommand::run(argument_count, slots, start, options)
                if Platform::c_string_equal(command, "clean"):
                    return MaintenanceCommand::clean()
                if Platform::c_string_equal(command, "cache"):
                    return MaintenanceCommand::run_cache(argument_count, slots, start)
                if Platform::c_string_equal(command, "package"):
                    return PackageCommand::run(argument_count, slots, start)
                if Platform::c_string_equal(command, "build"):
                    return BuildCommand::run(start, options)
                if Platform::c_string_equal(command, "run"):
                    return build_and_run(argument_count, slots, start, options, "bin")
                if Platform::c_string_equal(command, "test"):
                    return run_test(argument_count, slots, start, options)
                CliOutput::write_error("error: unknown command; run `elisapkg --help`\n")
                return CliStatus::usage

        # Help, version, and init run without a project. Returns their status,
        # or null for every other command.
        def run_project_free_command(argument_count: i64, slots: cstr&&, command: cstr, quiet: mutable bool&) -> i64? can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                if Platform::c_string_equal(command, "--help") or Platform::c_string_equal(command, "-h"):
                    CliOutput::usage()
                    return CliStatus::success
                if Platform::c_string_equal(command, "--version"):
                    CliOutput::write_ok("elisapkg 0.1.0\n")
                    return CliStatus::success
                if Platform::c_string_equal(command, "init"):
                    initialize_slots: mutable darray[cstr] = []
                    initialize_argument_count: i64 = CliArguments::compact_output_modes(argument_count, slots, &initialize_slots, quiet)
                    CliOutput::configure(quiet, false)
                    return CliStatus::usage if initialize_argument_count < 0
                    return InitCommand::run(initialize_argument_count, (&initialize_slots[0]).cast[cstr&&] can Unsafe.PointerCast)
                return null

        def cli_main(argument_count: i64, argument_vector: mutable void&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                slots: cstr&& = argument_vector.cast[cstr&&]
                CliOutput::configure(false, false)
                if argument_count <= 1:
                    CliOutput::usage()
                    return CliStatus::usage
                command: cstr = slots[1].cast[cstr]
                quiet: mutable bool = false
                if run_project_free_command(argument_count, slots, command, &quiet) is project_free_status:
                    return project_free_status
                manifest: mutable ManifestPathOption = ManifestPathOption{path: [], present: false}
                return CliStatus::usage if not read_manifest_path(argument_count, slots, &manifest.path, &manifest.present) else run_with_manifest_path(argument_count, slots, command, manifest, &quiet)

        # Remove `--manifest-path` and the output modes from the arguments when
        # needed, then run a dependency edit or any other project command.
        def run_with_manifest_path(argument_count: i64, slots: cstr&&, command: cstr, manifest: ManifestPathOption&, quiet: mutable bool&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                dependency_edit: bool = Platform::c_string_equal(command, "add") or Platform::c_string_equal(command, "remove") or Platform::c_string_equal(command, "update")
                if not manifest.present and not dependency_edit:
                    return run_parsed(argument_count, slots, command, manifest, quiet)
                compacted: mutable darray[cstr] = []
                compacted_count: i64 = CliArguments::compact_manifest_arguments(argument_count, slots, &compacted, quiet)
                CliOutput::configure(quiet, false)
                return CliStatus::usage if compacted_count <= 0
                compacted_slots: cstr&& = (&compacted[0]).cast[cstr&&] can Unsafe.PointerCast
                return run_dependency_edit(compacted_count, compacted_slots, command, manifest) if dependency_edit else run_parsed(compacted_count, compacted_slots, command, manifest, quiet)

        def run_dependency_edit(argument_count: i64, slots: cstr&&, command: cstr, manifest: ManifestPathOption&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return CliStatus::usage if manifest.present and not ProjectContext::change_to_manifest_path(manifest.path) else ResolutionCommand::add(argument_count, slots) if Platform::c_string_equal(command, "add") else ResolutionCommand::remove(argument_count, slots) if Platform::c_string_equal(command, "remove") else ResolutionCommand::update(argument_count, slots)

        # Read the common flags and remove the validated global options.
        def run_parsed(argument_count: i64, slots: cstr&&, command: cstr, manifest: ManifestPathOption&, quiet: mutable bool&) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                options: mutable Model::CommandOptions = Model::CommandOptions{locked: false, offline: false, frozen: false, json: false, verbose: false, profile: "debug", target_name: "", target_kind: "", update_name: ""}
                publish_dry_run: mutable bool = false
                if not read_flags(argument_count, slots, command, &options, quiet, &publish_dry_run):
                    return CliStatus::usage
                parsed_options: mutable darray[cstr] = []
                parsed_argument_count: i64 = CliArguments::compact_validated_global_options(argument_count, slots, &parsed_options)
                return CliStatus::usage if parsed_argument_count < 0
                dispatch_slots: cstr&& = (&parsed_options[0]).cast[cstr&&] can Unsafe.PointerCast
                return run_dispatch(parsed_argument_count, dispatch_slots, command, manifest, options, publish_dry_run)

        # Read the common flags and configure output, reporting an unknown option.
        def read_flags(argument_count: i64, slots: cstr&&, command: cstr, options: mutable Model::CommandOptions&, quiet: mutable bool&, publish_dry_run: mutable bool&) -> bool can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                flags_ok: bool = CliArguments::read_common_flags(argument_count, slots, command, options, quiet, publish_dry_run)
                CliOutput::configure(quiet, options.json)
                return flags_ok or report_unknown_option()

        def report_unknown_option() -> bool can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_error("error: unknown option; run `elisapkg --help`\n")
                return false

        def run_dispatch(argument_count: i64, slots: cstr&&, command: cstr, manifest: ManifestPathOption&, common_options: Model::CommandOptions, publish_dry_run: bool) -> CliStatus::ExitStatus can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                options: mutable Model::CommandOptions = common_options
                CliArguments::read_target_flags(argument_count, slots, command, &options)
                # `.` means the process working directory and keeps path operations on a
                # non-empty, well-defined byte buffer.
                start: mutable darray[u8] = [46]
                return CliStatus::usage if manifest.present and not ProjectContext::change_to_manifest_path(manifest.path)
                return run_doctor() if Platform::c_string_equal(command, "doctor")
                if Platform::c_string_equal(command, "uninstall"):
                    return LocalInstallCommand::uninstall(argument_count, slots)
                if Platform::c_string_equal(command, "fetch"):
                    return FetchCommand::run(argument_count, slots, &start, options)
                return CliStatus::security_failed if not ProjectTransaction::recover()
                return dispatch_project_command(command, argument_count, slots, &start, options, publish_dry_run)

    public:
        # The only public command surface. Platform, model, and trust-policy
        # implementation details are intentionally absent from this contract.
        def run(argument_count: i64, argument_vector: mutable void&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global{Read,Write}:
                return cli_main(argument_count, argument_vector)

def main(argument_count: i64, argument_vector: mutable void&) -> i64 can[Global{Read,Write}, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    can Global{Read,Write}:
        status: i64 = Cli::run(argument_count, argument_vector)
        Platform::exit_process(status)
        return status
