# Elisa Packaging System (`elisapkg`).
#
# The package manager keeps policy and algorithms in Elisa. Platform seams are
# small libc bindings with `pkg_` names so they cannot collide with the compiler
# runtime's declarations. Remote transport, archive extraction, and signing are
# separate capabilities and are refused until their trust configuration is
# present; no command silently falls back to an insecure mode.

include "./platform.elisa"
include "./model.elisa"
include "./trust.elisa"
include "./security.elisa"
include "./manifest.elisa"
include "./semver.elisa"
include "./integrity.elisa"
include "./json.elisa"
include "./cache.elisa"
include "./resolve.elisa"
include "./solver.elisa"
include "./registry.elisa"

const EXIT_OK: i64 = 0
const EXIT_USAGE: i64 = 2
const EXIT_RESOLVE: i64 = 3
const EXIT_SOURCE: i64 = 4
const EXIT_SECURITY: i64 = 5
const EXIT_BUILD: i64 = 6
const EXIT_CANCEL: i64 = 130
const BUILD_TIMEOUT_MS: i64 = 600000
const PROGRAM_TIMEOUT_MS: i64 = 120000

const O_READ: cstr = "rb"
const O_WRITE: cstr = "wb"
const O_CREATE_EXCLUSIVE: cstr = "wxb"

# ---------- byte and output helpers ---------------------------------------------------

def bytes_push_view(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
    length: usize = Platform::pkg_strlen(value)
    for index in 0..<length |out, value|:
        byte: u8 = value[index].u8()
        out.push(byte)

def bytes_push_cstr(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
    index: mutable usize = 0.usize()
    while index < 1048576.usize() |out, value, index|:
        byte: u8 = value[index].u8()
        break if byte == 0
        out.push(byte)
        index <- index + 1.usize()

def bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
    false return if left.count != right.count
    for index in 0..<left.count |left, right|:
        false return if left[index] != right[index]
    return true

def bytes_copy(value: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    out: mutable darray[u8] = []
    for index in 0..<value.count |out, value|:
        out.push(value[index])
    return out

def bytes_equal_view(left: darray[u8]&, right: cstr) -> bool:
    length: usize = Platform::pkg_strlen(right)
    false return if left.count != length
    for index in 0..<left.count |left, right|:
        right_byte: u8 = right[index].u8()
        false return if left[index] != right_byte
    return true

def cstr_equal(left: cstr, right: cstr) -> bool:
    left_length: usize = Platform::pkg_strlen(left)
    right_length: usize = Platform::pkg_strlen(right)
    return false if left_length != right_length
    for index in 0..<left_length |left, right|:
        return false if left[index].u8() != right[index].u8()
    return true

def valid_compiler_argument(value: cstr) -> bool:
    length: usize = Platform::pkg_strlen(value)
    # The compiler is the first utility argument after `env -i`. Reject forms
    # that the env utility would interpret as an option or NAME=VALUE prefix;
    # a malformed override must fail before child process construction.
    return false if length == 0.usize() or length > 4096.usize() or value[0].u8() == 45 or value[0].u8() == 61
    for index in 0..<length |value|:
        byte: u8 = value[index].u8()
        return false if byte == 61 or byte < 32 or byte == 127
    return true

def valid_toolchain_value(value: cstr, maximum: usize) -> bool:
    length: usize = Platform::pkg_strlen(value)
    return false if length > maximum
    for index in 0..<length |value|:
        byte: u8 = value[index].u8()
        return false if byte < 32 or byte == 127
    return true

def bytes_count(haystack: darray[u8]&, needle: cstr) -> usize:
    needle_length: usize = Platform::pkg_strlen(needle)
    total: mutable usize = 0.usize()
    return total if needle_length == 0.usize() or needle_length > haystack.count
    start: mutable usize = 0.usize()
    while start + needle_length <= haystack.count |haystack, needle, total, start, needle_length|:
        matched: mutable bool = true
        for offset in 0..<needle_length |haystack, needle, start, matched|:
            needle_byte: u8 = needle[offset].u8()
            if haystack[start + offset] != needle_byte:
                matched <- false
                break
        if matched:
            total <- total + 1.usize()
            start <- start + needle_length
        else:
            start <- start + 1.usize()
    return total

def bytes_starts_with(value: darray[u8]&, prefix: darray[u8]&) -> bool:
    return false if prefix.count > value.count
    for index in 0..<prefix.count |value, prefix|:
        return false if value[index] != prefix[index]
    return true

def bytes_ends_with(value: darray[u8]&, suffix: darray[u8]&) -> bool:
    return false if suffix.count > value.count
    offset: usize = value.count - suffix.count
    for index in 0..<suffix.count |value, suffix, offset|:
        return false if value[offset + index] != suffix[index]
    return true

def write_bytes(fd: i64, value: darray[u8]&) -> void can[Console.Write, Unsafe.PointerCast]:
    offset: mutable usize = 0.usize()
    while offset < value.count |value, offset|:
        raw: void& = (&value[offset]).cast[void&] can Unsafe.PointerCast
        wrote: i64 = Platform::pkg_write(fd, raw, value.count - offset) can Console.Write
        return if wrote <= 0
        offset <- offset + wrote.usize()

def write_text(fd: i64, value: cstr) -> void can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    buffer: mutable darray[u8] = []
    bytes_push_view(&buffer, value)
    write_bytes(fd, &buffer)

def write_error(value: cstr) -> void can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    write_text(2, value)

def write_ok(value: cstr) -> void can[Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    write_text(1, value)

# ---------- path and file primitives --------------------------------------------------

def path_join_into(left: darray[u8]&, right: cstr, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    out.resize(0)
    if left.count > 0.usize():
        for index in 0..<left.count |out, left|:
            out.push(left[index])
    if out.count > 0.usize() and out[out.count - 1.usize()] != 47:
        out.push(47)
    length: usize = Platform::pkg_strlen(right)
    for index in 0..<length |out, right|:
        byte: u8 = right[index].u8()
        out.push(byte)
def path_with_nul_into(path: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    out.resize(0)
    for index in 0..<path.count |out, path|:
        out.push(path[index])
    out.push(0)

def make_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return true if path.count == 0.usize()
    work: mutable darray[u8] = []
    path_with_nul_into(path, &work)
    for index in 1..<work.count |work, path|:
        continue if work[index] != 47
        work[index] <- 0
        prefix: cstr = (&work[0]).cast[cstr] can Unsafe.PointerCast
        created: i64 = Platform::pkg_mkdir(prefix, 493.u16())
        valid: bool = created == 0 or Platform::pkg_is_directory(prefix) == 1
        work[index] <- 47
        return false if not valid
    final_path: cstr = (&work[0]).cast[cstr] can Unsafe.PointerCast
    created: i64 = Platform::pkg_mkdir(final_path, 493.u16())
    return false if created != 0 and Platform::pkg_is_directory(final_path) != 1
    return Platform::pkg_is_directory(final_path) == 1

def read_file_into(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    out.resize(0)
    path_c: mutable darray[u8] = []
    path_with_nul_into(path, &path_c)
    path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    stream: mutable heap void&? = Platform::pkg_fopen(path_name, O_READ)
    if stream is open_stream:
        chunk: mutable darray[u8] = []
        chunk.resize(8192)
        rounds: mutable usize = 0.usize()
        oversized: mutable bool = false
        while rounds < 8192.usize() |out, chunk, stream, rounds|:
            chunk_raw: mutable void& = (&chunk[0]).cast[mutable void&] can Unsafe.PointerCast
            got: usize = Platform::pkg_fread(chunk_raw, 1, 8192, open_stream)
            break if got == 0.usize()
            if got > chunk.count:
                _ = Platform::pkg_fclose(open_stream)
                return false
            for index in 0..<got |out, chunk|:
                out.push(chunk[index])
            rounds <- rounds + 1.usize()
        if rounds == 8192.usize():
            chunk.resize(1)
            probe_raw: mutable void& = (&chunk[0]).cast[mutable void&] can Unsafe.PointerCast
            oversized <- Platform::pkg_fread(probe_raw, 1, 1, open_stream) > 0.usize()
        failed: bool = Platform::pkg_ferror(open_stream) != 0
        _ = Platform::pkg_fclose(open_stream)
        return false if oversized or failed
        return true
    return false

def read_package_file_into(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    out.resize(0)
    path_c: mutable darray[u8] = []
    path_with_nul_into(path, &path_c)
    path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    file_size: i64 = Platform::pkg_package_file_size(path_name)
    return false if file_size < 0 or file_size > 67108864
    out.resize(file_size.usize() + 1.usize())
    out_raw: mutable u8& = (&out[0]).cast[mutable u8&] can Unsafe.PointerCast
    read_size: i64 = Platform::pkg_read_package_file(path_name, out_raw, out.count)
    return false if read_size < 0 or read_size != file_size
    out.resize(read_size.usize())
    return true

def read_cstr_into(path_name: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return false if out.count == 0.usize()
    stream: mutable heap void&? = Platform::pkg_fopen(path_name, O_READ)
    if stream is open_stream:
        out_raw: mutable void& = (&out[0]).cast[mutable void&] can Unsafe.PointerCast
        got: usize = Platform::pkg_fread(out_raw, 1, out.count, open_stream)
        if got > out.count:
            _ = Platform::pkg_fclose(open_stream)
            return false
        oversized: mutable bool = false
        if got == out.count:
            probe: mutable darray[u8] = []
            probe.resize(1)
            probe_raw: mutable void& = (&probe[0]).cast[mutable void&] can Unsafe.PointerCast
            oversized <- Platform::pkg_fread(probe_raw, 1, 1, open_stream) > 0.usize()
        failed: bool = Platform::pkg_ferror(open_stream) != 0
        out.resize(got)
        _ = Platform::pkg_fclose(open_stream)
        return not failed and not oversized
    return false

def write_fd_all(fd: i64, value: darray[u8]&) -> bool can[Unsafe.PointerCast, Console.Write]:
    offset: mutable usize = 0.usize()
    while offset < value.count |value, offset|:
        value_raw: void& = (&value[offset]).cast[void&] can Unsafe.PointerCast
        wrote: i64 = Platform::pkg_write(fd, value_raw, value.count - offset) can Console.Write
        return false if wrote <= 0
        offset <- offset + wrote.usize()
    return true

def write_cstr_file(path_name: cstr, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    # mkstemp provides an exclusive 0600 temporary file; fsync and rename make
    # the lockfile transition atomic and prevent readers from seeing a prefix.
    template: mutable darray[u8] = []
    bytes_push_cstr(&template, path_name)
    bytes_push_view(&template, ".tmp.XXXXXX")
    template.push(0)
    fd: i64 = Platform::pkg_mkstemp(&template)
    return false if fd < 0
    temp_name: cstr = (&template[0]).cast[cstr] can Unsafe.PointerCast
    if not write_fd_all(fd, value):
        _ = Platform::pkg_close(fd)
        _ = Platform::pkg_unlink(temp_name)
        return false
    if Platform::pkg_fsync(fd) != 0:
        _ = Platform::pkg_close(fd)
        _ = Platform::pkg_unlink(temp_name)
        return false
    _ = Platform::pkg_close(fd)
    if Platform::pkg_rename(temp_name, path_name) != 0:
        _ = Platform::pkg_unlink(temp_name)
        return false
    return Platform::pkg_fsync_parent(path_name) == 0

def write_cstr_file_noclobber(path_name: cstr, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    # Link the fsynced temporary into place so an existing destination can
    # never be replaced by a rename race. The temporary is removed after the
    # link, leaving one durable directory entry for the caller to own.
    template: mutable darray[u8] = []
    bytes_push_cstr(&template, path_name)
    bytes_push_view(&template, ".tmp.XXXXXX")
    template.push(0)
    fd: i64 = Platform::pkg_mkstemp(&template)
    return false if fd < 0
    temp_name: cstr = (&template[0]).cast[cstr] can Unsafe.PointerCast
    if not write_fd_all(fd, value) or Platform::pkg_fsync(fd) != 0:
        _ = Platform::pkg_close(fd)
        _ = Platform::pkg_unlink(temp_name)
        return false
    _ = Platform::pkg_close(fd)
    linked: bool = Platform::pkg_link(temp_name, path_name) == 0
    _ = Platform::pkg_unlink(temp_name)
    return linked and Platform::pkg_fsync_parent(path_name) == 0

def cache_store_verified_blob(digest: darray[u8]&, content: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    # Cache publication is content-addressed and immutable. Verify the bytes
    # before creating any cache entry, then revalidate the final pathname after
    # the exclusive link so a concurrent writer or replacement cannot turn a
    # successful fetch into an unverified cache hit.
    return false if not Archive::verify_ustar_archive(content)
    digest_bytes: mutable darray[u8] = []
    actual: mutable darray[u8] = []
    return false if Integrity::sha256(content, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &actual) or not bytes_equal(actual, digest)
    blob_path: mutable darray[u8] = []
    return false if not Cache::blob_path(digest, &blob_path)
    cache_parent: mutable darray[u8] = []
    bytes_push_view(&cache_parent, ".elisapkg/cache/sha256/")
    cache_parent.push(digest[0])
    cache_parent.push(digest[1])
    return false if not make_directory(&cache_parent)
    blob_name: mutable darray[u8] = []
    path_with_nul_into(&blob_path, &blob_name)
    blob_c: cstr = (&blob_name[0]).cast[cstr] can Unsafe.PointerCast
    if cstr_file_exists(blob_c):
        return true if Cache::verify_blob(digest)
        quarantine_parent: mutable darray[u8] = []
        quarantine_path: mutable darray[u8] = []
        bytes_push_view(&quarantine_parent, ".elisapkg/cache/quarantine")
        bytes_push_view(&quarantine_path, ".elisapkg/cache/quarantine/")
        bytes_push_array(&quarantine_path, digest)
        bytes_push_view(&quarantine_path, ".invalid")
        return false if not make_directory(&quarantine_parent)
        quarantine_name: mutable darray[u8] = []
        path_with_nul_into(&quarantine_path, &quarantine_name)
        quarantine_c: cstr = (&quarantine_name[0]).cast[cstr] can Unsafe.PointerCast
        return false if Platform::pkg_rename(blob_c, quarantine_c) != 0
    return true if write_cstr_file_noclobber(blob_c, content) and Cache::verify_blob(digest)
    return Cache::verify_blob(digest)

def cache_read_verified_blob(digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    out.resize(0)
    return false if not Cache::verify_blob(digest)
    path: mutable darray[u8] = []
    return false if not Cache::blob_path(digest, &path)
    loaded: mutable darray[u8] = []
    return false if not read_package_file_into(&path, &loaded)
    for index in 0..<loaded.count |out, loaded|:
        out.push(loaded[index])
    return true

def cstr_file_exists(path_name: cstr) -> bool:
    return Platform::pkg_access(path_name, 0) == 0

def write_file(path: darray[u8]&, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    path_c: mutable darray[u8] = []
    path_with_nul_into(path, &path_c)
    path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    # Initialization files use the same durable atomic replacement primitive as
    # manifests and lockfiles. This keeps a crash from exposing a truncated
    # scaffold and avoids leaving a partially written file after an I/O error.
    return write_cstr_file(path_name, value)

def file_exists(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    path_c: mutable darray[u8] = []
    path_with_nul_into(path, &path_c)
    path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    stream: mutable heap void&? = Platform::pkg_fopen(path_name, O_READ)
    if stream is open_stream:
        _ = Platform::pkg_fclose(open_stream)
        return true
    return false

def canonical_entry_within_root(root: darray[u8]&, entry: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    root_path: mutable darray[u8] = []
    entry_path: mutable darray[u8] = []
    for index in 0..<root.count |root, root_path|:
        root_path.push(root[index])
    if root_path.count == 0.usize() or root_path[root_path.count - 1.usize()] != 47:
        root_path.push(47)
    for index in 0..<entry.count |entry, entry_path|:
        entry_path.push(entry[index])
    root_c: mutable darray[u8] = []
    entry_c: mutable darray[u8] = []
    path_with_nul_into(&root_path, &root_c)
    path_with_nul_into(&entry_path, &entry_c)
    root_resolved: mutable darray[u8] = []
    entry_resolved: mutable darray[u8] = []
    root_resolved.resize(4096)
    entry_resolved.resize(4096)
    root_name: cstr = (&root_c[0]).cast[cstr] can Unsafe.PointerCast
    entry_name: cstr = (&entry_c[0]).cast[cstr] can Unsafe.PointerCast
    root_real: mutable cstr = ""
    entry_real: mutable cstr = ""
    if Platform::pkg_realpath(root_name, &root_resolved) is resolved_root:
        root_real <- resolved_root
    else:
        return false
    if Platform::pkg_realpath(entry_name, &entry_resolved) is resolved_entry:
        entry_real <- resolved_entry
    else:
        return false
    root_length: usize = Platform::pkg_strlen(root_real)
    entry_length: usize = Platform::pkg_strlen(entry_real)
    return false if entry_length <= root_length
    for index in 0..<root_length |root_real, entry_real|:
        return false if root_real[index].u8() != entry_real[index].u8()
    return entry_real[root_length].u8() == 47

def remove_known_file(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    path_c: mutable darray[u8] = []
    path_with_nul_into(path, &path_c)
    path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    state: i64 = Platform::pkg_package_file_size(path_name)
    return true if state == -2
    return false if state < 0
    return Platform::pkg_unlink(path_name) == 0

def remove_empty_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    path_c: mutable darray[u8] = []
    path_with_nul_into(path, &path_c)
    path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    result: i64 = Platform::pkg_rmdir(path_name)
    return true if result == 0 or result == -2
    return false

def remove_cstr_file(path_name: cstr) -> bool:
    state: i64 = Platform::pkg_package_file_size(path_name)
    return true if state == -2
    return false if state < 0
    return Platform::pkg_unlink(path_name) == 0

def transaction_cleanup() -> bool:
    return false if not remove_cstr_file(".elisapkg/transaction.manifest")
    return false if not remove_cstr_file(".elisapkg/transaction.lock")
    return false if not remove_cstr_file(".elisapkg/transaction.new-manifest")
    return false if not remove_cstr_file(".elisapkg/transaction.new-lock")
    return false if not remove_cstr_file(".elisapkg/transaction.new-lock-missing")
    return false if not remove_cstr_file(".elisapkg/transaction.state")
    guard: mutable darray[u8] = []
    bytes_push_view(&guard, ".elisapkg/transaction.guard")
    return false if not remove_empty_directory(&guard)
    return true

def transaction_begin(original_manifest: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    state_root: mutable darray[u8] = []
    bytes_push_view(&state_root, ".elisapkg")
    return false if not make_directory(&state_root)
    guard: mutable darray[u8] = []
    bytes_push_view(&guard, ".elisapkg/transaction.guard")
    guard_c: mutable darray[u8] = []
    path_with_nul_into(&guard, &guard_c)
    guard_name: cstr = (&guard_c[0]).cast[cstr] can Unsafe.PointerCast
    return false if Platform::pkg_mkdir(guard_name, 448.u16()) != 0
    transaction_state: i64 = Platform::pkg_package_file_size(".elisapkg/transaction.state")
    if transaction_state >= 0:
        _ = remove_empty_directory(&guard)
        return false
    if transaction_state != -2:
        _ = remove_empty_directory(&guard)
        return false
    if not write_cstr_file(".elisapkg/transaction.manifest", original_manifest):
        _ = transaction_cleanup()
        return false
    state: mutable darray[u8] = []
    lock_state: i64 = Platform::pkg_package_file_size("elisapkg.lock")
    if lock_state >= 0:
        original_lock: mutable darray[u8] = []
        original_lock.resize(1048577)
        if not read_cstr_into("elisapkg.lock", &original_lock) or not write_cstr_file(".elisapkg/transaction.lock", &original_lock):
            _ = transaction_cleanup()
            return false
        bytes_push_view(&state, "prepared-lock\n")
    elif lock_state == -2:
        bytes_push_view(&state, "prepared-no-lock\n")
    else:
        _ = transaction_cleanup()
        return false
    if not write_cstr_file(".elisapkg/transaction.state", &state):
        _ = transaction_cleanup()
        return false
    return true

def transaction_mark_manifest() -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    new_manifest: mutable darray[u8] = []
    new_manifest.resize(1048577)
    return false if not read_cstr_into("elisapkg.json", &new_manifest)
    return false if not write_cstr_file(".elisapkg/transaction.new-manifest", &new_manifest)
    state: mutable darray[u8] = []
    bytes_push_view(&state, "manifest-replaced\n")
    return write_cstr_file(".elisapkg/transaction.state", &state)

def transaction_mark_lock() -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    if cstr_file_exists("elisapkg.lock"):
        new_lock: mutable darray[u8] = []
        new_lock.resize(1048577)
        return false if not read_cstr_into("elisapkg.lock", &new_lock)
        return write_cstr_file(".elisapkg/transaction.new-lock", &new_lock)
    missing: mutable darray[u8] = []
    bytes_push_view(&missing, "missing\n")
    return write_cstr_file(".elisapkg/transaction.new-lock-missing", &missing)

def transaction_restore() -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    state: mutable darray[u8] = []
    state.resize(128)
    return false if not read_cstr_into(".elisapkg/transaction.state", &state)
    recognized: bool = bytes_equal_view(state, "prepared-lock\n") or bytes_equal_view(state, "prepared-no-lock\n") or bytes_equal_view(state, "manifest-replaced\n")
    return false if not recognized
    original_manifest: mutable darray[u8] = []
    original_manifest.resize(1048577)
    return false if not read_cstr_into(".elisapkg/transaction.manifest", &original_manifest)
    current_manifest: mutable darray[u8] = []
    current_manifest.resize(1048577)
    return false if not read_cstr_into("elisapkg.json", &current_manifest)
    if bytes_equal_view(state, "manifest-replaced\n"):
        new_manifest: mutable darray[u8] = []
        new_manifest.resize(1048577)
        return false if not read_cstr_into(".elisapkg/transaction.new-manifest", &new_manifest)
        if not bytes_equal(current_manifest, new_manifest):
            write_error("error: transaction recovery found an external manifest edit; recovery files were retained\n")
            return false
    elif not bytes_equal(current_manifest, original_manifest):
        write_error("error: transaction recovery found an external manifest edit; recovery files were retained\n")
        return false
    original_lock_state: i64 = Platform::pkg_package_file_size(".elisapkg/transaction.lock")
    return false if original_lock_state < 0 and original_lock_state != -2
    original_lock_present: bool = original_lock_state >= 0
    original_lock: mutable darray[u8] = []
    if original_lock_present:
        original_lock.resize(1048577)
        return false if not read_cstr_into(".elisapkg/transaction.lock", &original_lock)
    current_lock_state: i64 = Platform::pkg_package_file_size("elisapkg.lock")
    return false if current_lock_state < 0 and current_lock_state != -2
    current_lock_present: bool = current_lock_state >= 0
    new_lock_state: i64 = Platform::pkg_package_file_size(".elisapkg/transaction.new-lock")
    return false if new_lock_state < 0 and new_lock_state != -2
    if current_lock_present:
        current_lock: mutable darray[u8] = []
        current_lock.resize(1048577)
        return false if not read_cstr_into("elisapkg.lock", &current_lock)
        if new_lock_state >= 0:
            new_lock: mutable darray[u8] = []
            new_lock.resize(1048577)
            return false if not read_cstr_into(".elisapkg/transaction.new-lock", &new_lock)
            if not bytes_equal(current_lock, new_lock) and (not original_lock_present or not bytes_equal(current_lock, original_lock)):
                write_error("error: transaction recovery found an external lockfile edit; recovery files were retained\n")
                return false
        elif not original_lock_present:
            write_error("error: transaction recovery found an unexpected lockfile; recovery files were retained\n")
            return false
    elif original_lock_present or new_lock_state >= 0:
        write_error("error: transaction recovery found an external lockfile edit; recovery files were retained\n")
        return false
    return false if not write_cstr_file("elisapkg.json", &original_manifest)
    if bytes_equal_view(state, "prepared-lock\n") or (bytes_equal_view(state, "manifest-replaced\n") and original_lock_present):
        return false if not write_cstr_file("elisapkg.lock", &original_lock)
    else:
        return false if not remove_cstr_file("elisapkg.lock")
    return transaction_cleanup()

def transaction_recover() -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    transaction_state: i64 = Platform::pkg_package_file_size(".elisapkg/transaction.state")
    if transaction_state == -2:
        guard: mutable darray[u8] = []
        bytes_push_view(&guard, ".elisapkg/transaction.guard")
        guard_c: mutable darray[u8] = []
        path_with_nul_into(&guard, &guard_c)
        guard_name: cstr = (&guard_c[0]).cast[cstr] can Unsafe.PointerCast
        guard_state: i64 = Platform::pkg_package_file_size(guard_name)
        return true if guard_state == -2
        return false
    return false if transaction_state < 0
    state: mutable darray[u8] = []
    state.resize(128)
    return false if not read_cstr_into(".elisapkg/transaction.state", &state)
    if bytes_equal_view(state, "complete\n"):
        return transaction_cleanup()
    return false if not (bytes_equal_view(state, "prepared-lock\n") or bytes_equal_view(state, "prepared-no-lock\n") or bytes_equal_view(state, "manifest-replaced\n"))
    return transaction_restore()

def transaction_commit() -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    state: mutable darray[u8] = []
    bytes_push_view(&state, "complete\n")
    return false if not write_cstr_file(".elisapkg/transaction.state", &state)
    return transaction_cleanup()

def safe_relative_entry(entry: darray[u8]&) -> bool:
    return Manifest::is_safe_relative_entry(entry)

def valid_target_entries(raw: darray[u8]&, root: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    found: mutable usize = 0.usize()
    for index in 0..<raw.count |raw, in_string, escaped, string_start, found|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            matched: mutable bool = after < raw.count and raw[after] == 58 and index - string_start == 5.usize()
            if matched:
                for key_index in 0..<5.usize() |raw, string_start, matched|:
                    matched <- false if raw[string_start + key_index] != "entry"[key_index].u8()
            if matched:
                after <- after + 1.usize()
                while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                    after <- after + 1.usize()
                return false if after >= raw.count or raw[after] != 34
                after <- after + 1.usize()
                entry: mutable darray[u8] = []
                while after < raw.count and raw[after] != 34 |raw, after, entry|:
                    return false if raw[after] == 92
                    entry.push(raw[after])
                    after <- after + 1.usize()
                return false if not safe_relative_entry(entry)
                entry_path: mutable darray[u8] = []
                for root_index in 0..<root.count |entry_path, root|:
                    entry_path.push(root[root_index])
                if entry_path.count == 0.usize() or entry_path[entry_path.count - 1.usize()] != 47:
                    entry_path.push(47)
                for entry_index in 0..<entry.count |entry_path, entry|:
                    entry_path.push(entry[entry_index])
                return false if not canonical_entry_within_root(root, &entry_path)
                entry_path_c: mutable darray[u8] = []
                path_with_nul_into(&entry_path, &entry_path_c)
                entry_path_name: cstr = (&entry_path_c[0]).cast[cstr] can Unsafe.PointerCast
                return false if Platform::pkg_package_file_size(entry_path_name) < 0
                found <- found + 1.usize()
            in_string <- false
    return found > 0.usize()

def first_target_entry(raw: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    out.resize(0)
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    for index in 0..<raw.count |raw, in_string, escaped, string_start, out|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            matched: mutable bool = after < raw.count and raw[after] == 58 and index - string_start == 5.usize()
            if matched:
                for key_index in 0..<5.usize() |raw, string_start, matched|:
                    matched <- false if raw[string_start + key_index] != "entry"[key_index].u8()
            if matched:
                after <- after + 1.usize()
                while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                    after <- after + 1.usize()
                return false if after >= raw.count or raw[after] != 34
                after <- after + 1.usize()
                while after < raw.count and raw[after] != 34 |raw, after, out|:
                    return false if raw[after] == 92
                    out.push(raw[after])
                    after <- after + 1.usize()
                return safe_relative_entry(out)
            in_string <- false
    return false

def select_target(raw: darray[u8]&, options: Model::CommandOptions, name_out: mutable darray[u8]&, kind_out: mutable darray[u8]&, entry_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    name_out.resize(0)
    kind_out.resize(0)
    entry_out.resize(0)
    targets_start: usize = json_key_value_offset(raw, "targets")
    return false if targets_start >= raw.count or raw[targets_start] != 91
    targets_end: usize = json_array_end(raw, targets_start)
    return false if targets_end <= targets_start
    cursor: mutable usize = targets_start + 1.usize()
    while cursor < targets_end:
        while cursor < targets_end and ((raw[cursor] == 32) or (raw[cursor] == 9) or (raw[cursor] == 10) or (raw[cursor] == 13) or (raw[cursor] == 44)):
            cursor <- cursor + 1.usize()
        break if cursor >= targets_end
        return false if raw[cursor] != 123
        object_end: usize = json_object_end(raw, cursor)
        return false if object_end <= cursor or object_end >= targets_end
        candidate_name: mutable darray[u8] = []
        candidate_kind: mutable darray[u8] = []
        candidate_entry: mutable darray[u8] = []
        return false if not object_string_value(raw, cursor, object_end, "name", &candidate_name) or not object_string_value(raw, cursor, object_end, "kind", &candidate_kind) or not object_string_value(raw, cursor, object_end, "entry", &candidate_entry)
        name_requested: bool = Platform::pkg_strlen(options.target_name) != 0.usize()
        kind_requested: bool = Platform::pkg_strlen(options.target_kind) != 0.usize()
        name_matches: bool = not name_requested or bytes_equal_view(candidate_name, options.target_name)
        kind_matches: bool = not kind_requested or bytes_equal_view(candidate_kind, options.target_kind)
        if name_matches and kind_matches:
            for index in 0..<candidate_name.count |name_out, candidate_name|:
                name_out.push(candidate_name[index])
            for index in 0..<candidate_kind.count |kind_out, candidate_kind|:
                kind_out.push(candidate_kind[index])
            for index in 0..<candidate_entry.count |entry_out, candidate_entry|:
                entry_out.push(candidate_entry[index])
            return true
        cursor <- object_end + 1.usize()
    return false

def first_target_kind(raw: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    out.resize(0)
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    for index in 0..<raw.count |raw, in_string, escaped, string_start, out|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            matched: mutable bool = after < raw.count and raw[after] == 58 and index - string_start == 4.usize()
            if matched:
                for key_index in 0..<4.usize() |raw, string_start, matched|:
                    matched <- false if raw[string_start + key_index] != "kind"[key_index].u8()
            if matched:
                after <- after + 1.usize()
                while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                    after <- after + 1.usize()
                return false if after >= raw.count or raw[after] != 34
                after <- after + 1.usize()
                while after < raw.count and raw[after] != 34 |raw, after, out|:
                    return false if raw[after] == 92
                    out.push(raw[after])
                    after <- after + 1.usize()
                return after < raw.count
            in_string <- false
    return false

def valid_target_kinds(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    found: mutable usize = 0.usize()
    for index in 0..<raw.count |raw, in_string, escaped, string_start, found|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            matched: mutable bool = after < raw.count and raw[after] == 58 and index - string_start == 4.usize()
            if matched:
                for key_index in 0..<4.usize() |raw, string_start, matched|:
                    matched <- false if raw[string_start + key_index] != "kind"[key_index].u8()
            if matched:
                after <- after + 1.usize()
                while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                    after <- after + 1.usize()
                return false if after >= raw.count or raw[after] != 34
                after <- after + 1.usize()
                value: mutable darray[u8] = []
                while after < raw.count and raw[after] != 34 |raw, after, value|:
                    return false if raw[after] == 92
                    value.push(raw[after])
                    after <- after + 1.usize()
                return false if not (bytes_equal_view(value, "bin") or bytes_equal_view(value, "lib") or bytes_equal_view(value, "test"))
                found <- found + 1.usize()
            in_string <- false
    return found > 0.usize()

def valid_target_objects(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    targets_start: usize = json_key_value_offset(raw, "targets")
    return false if targets_start >= raw.count or raw[targets_start] != 91
    targets_end: usize = json_array_end(raw, targets_start)
    return false if targets_end <= targets_start
    seen: mutable darray[u8] = []
    found: mutable usize = 0.usize()
    index: mutable usize = targets_start + 1.usize()
    while index < targets_end |raw, seen, found, index|:
        if raw[index] == 123:
            object_end: usize = json_object_end(raw, index)
            return false if object_end <= index or object_end > targets_end
            return false if not valid_direct_field_set(raw, index, object_end, 2)
            target_name: mutable darray[u8] = []
            return false if not object_string_value(raw, index, object_end, "name", &target_name)
            return false if not valid_package_name(target_name)
            target_kind: mutable darray[u8] = []
            return false if not object_string_value(raw, index, object_end, "kind", &target_kind)
            return false if not (bytes_equal_view(target_kind, "bin") or bytes_equal_view(target_kind, "lib") or bytes_equal_view(target_kind, "test"))
            target_entry: mutable darray[u8] = []
            return false if not object_string_value(raw, index, object_end, "entry", &target_entry)
            return false if not safe_relative_entry(target_entry)
            return false if dependency_alias_seen(seen, target_name)
            seen.push(0) if seen.count > 0.usize()
            for name_index in 0..<target_name.count |seen, target_name|:
                seen.push(target_name[name_index])
            seen.push(0)
            found <- found + 1.usize()
            index <- object_end
        index <- index + 1.usize()
    return found > 0.usize()

# ---------- semantic versions ---------------------------------------------------------

def parse_version(value: darray[u8]&, out: mutable Model::Version&) -> bool:
    parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
    return false if not SemVer::parse(value, &parsed)
    out.major <- parsed.major
    out.minor <- parsed.minor
    out.patch <- parsed.patch
    out.prerelease <- parsed.prerelease
    return true

def version_compare(left: Model::Version, right: Model::Version) -> i64:
    return SemVer::compare(left, right)

# ---------- manifest and lock ---------------------------------------------------------

def json_key_value_offset(raw: darray[u8]&, wanted: cstr) -> usize can[Memory.Allocate, Abort.Panic]:
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    braces: mutable i64 = 0
    brackets: mutable i64 = 0
    wanted_length: usize = Platform::pkg_strlen(wanted)
    for index in 0..<raw.count |raw, in_string, escaped, string_start, braces, brackets|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
            elif byte == 123:
                braces <- braces + 1
            elif byte == 125:
                braces <- braces - 1
            elif byte == 91:
                brackets <- brackets + 1
            elif byte == 93:
                brackets <- brackets - 1
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            matched: mutable bool = after < raw.count and raw[after] == 58 and braces == 1 and brackets == 0 and index - string_start == wanted_length
            if matched:
                for key_index in 0..<wanted_length |raw, wanted, string_start, matched|:
                    matched <- false if raw[string_start + key_index] != wanted[key_index].u8()
            if matched:
                after <- after + 1.usize()
                while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                    after <- after + 1.usize()
                return after
            in_string <- false
    return raw.count

def json_object_end(raw: darray[u8]&, object_start: usize) -> usize:
    return raw.count if object_start >= raw.count or raw[object_start] != 123
    depth: mutable i64 = 0
    in_string: mutable bool = false
    escaped: mutable bool = false
    for index in object_start..<raw.count |raw, depth, in_string, escaped|:
        byte: u8 = raw[index]
        if in_string:
            if escaped:
                escaped <- false
            elif byte == 92:
                escaped <- true
            elif byte == 34:
                in_string <- false
        elif byte == 34:
            in_string <- true
        elif byte == 123:
            depth <- depth + 1
        elif byte == 125:
            depth <- depth - 1
            return index if depth == 0
            return raw.count if depth < 0
    return raw.count

def json_array_end(raw: darray[u8]&, array_start: usize) -> usize:
    return raw.count if array_start >= raw.count or raw[array_start] != 91
    depth: mutable i64 = 0
    in_string: mutable bool = false
    escaped: mutable bool = false
    for index in array_start..<raw.count |raw, depth, in_string, escaped|:
        byte: u8 = raw[index]
        if in_string:
            if escaped:
                escaped <- false
            elif byte == 92:
                escaped <- true
            elif byte == 34:
                in_string <- false
        elif byte == 34:
            in_string <- true
        elif byte == 91:
            depth <- depth + 1
        elif byte == 93:
            depth <- depth - 1
            return index if depth == 0
            return raw.count if depth < 0
    return raw.count

def key_value(raw: darray[u8]&, key: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    out.resize(0)
    # Restrict package identity fields to the actual `package` object. A target
    # named `name` that appears earlier in the document cannot change the package
    # identity used in the lockfile.
    package_start: usize = json_key_value_offset(raw, "package")
    package_end: usize = json_object_end(raw, package_start)
    return false if package_start >= raw.count or package_end <= package_start
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    key_length: usize = Platform::pkg_strlen(key)
    for index in (package_start + 1.usize())..<package_end |raw, in_string, escaped, string_start|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
        elif escaped:
            escaped <- false
        elif byte == 92:
            escaped <- true
        elif byte == 34:
            after: mutable usize = index + 1.usize()
            while after < package_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                after <- after + 1.usize()
            matched: mutable bool = after < package_end and raw[after] == 58 and index - string_start == key_length
            if matched:
                for key_index in 0..<key_length |raw, key, string_start, matched|:
                    matched <- false if raw[string_start + key_index] != key[key_index].u8()
            if matched:
                after <- after + 1.usize()
                while after < package_end and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                    after <- after + 1.usize()
                return false if after >= package_end or raw[after] != 34
                after <- after + 1.usize()
                while after < package_end and raw[after] != 34 |raw, after, out|:
                    return false if raw[after] == 92
                    out.push(raw[after])
                    after <- after + 1.usize()
                return after < package_end
            in_string <- false
    return false

def valid_package_name(name: darray[u8]&) -> bool:
    return false if name.count == 0.usize() or name.count > 64.usize()
    return false if name[0] < 97 or name[0] > 122
    previous_hyphen: mutable bool = false
    for index in 0..<name.count |name, previous_hyphen|:
        byte: u8 = name[index]
        if byte == 45:
            return false if index == 0.usize() or index + 1.usize() == name.count or previous_hyphen
            previous_hyphen <- true
        else:
            return false if (byte < 97 or byte > 122) and (byte < 48 or byte > 57)
            previous_hyphen <- false
    return true

def allowed_manifest_keys(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    # Scan only string tokens immediately followed by a colon. This keeps JSON
    # text inside descriptions from being mistaken for fields while rejecting
    # extension keys that the validator would otherwise silently ignore.
    in_string: mutable bool = false
    escaped: mutable bool = false
    string_start: mutable usize = 0.usize()
    braces: mutable i64 = 0
    brackets: mutable i64 = 0
    dependency_depth: mutable i64 = 0
    pending_dependency_object: mutable bool = false
    for index in 0..<raw.count |raw, in_string, escaped, string_start, braces, brackets, dependency_depth, pending_dependency_object|:
        byte: u8 = raw[index]
        if not in_string:
            if byte == 34:
                in_string <- true
                string_start <- index + 1.usize()
            elif byte == 123:
                braces <- braces + 1
                dependency_depth <- braces if pending_dependency_object
                pending_dependency_object <- false
            elif byte == 125:
                dependency_depth <- 0 if dependency_depth == braces
                braces <- braces - 1
            elif byte == 91:
                brackets <- brackets + 1
