# Local content-addressed cache policy.
# Registry cache publication is implemented in cache/registry.elisa.

include "./platform.elisa"
include "./integrity.elisa"
include "./text/bytes.elisa"

module Cache:
    public:
        const max_registry_receipt_bytes: usize = 2048.usize()

        def shard_path(digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if not Integrity::valid_sha256_hex(digest)
            append_literal(out, ".elisapkg/cache/sha256/")
            out.push(digest[0])
            out.push(digest[1])
            return true

        def blob_path(digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not shard_path(digest, out)
            out.push(47)
            for index in 0..<digest.count |out, digest|:
                out.push(digest[index])
            return true

        const quarantine_directory: cstr = ".elisapkg/cache/quarantine"

        def quarantine_blob(digest: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            active: mutable darray[u8] = []
            evidence: mutable darray[u8] = []
            return false if not blob_path(digest, &active) or not quarantine_path(digest, &evidence)
            active <- active.push(0)
            evidence <- evidence.push(0)
            blob_name: cstr = (&active[0]).cast[cstr] can Unsafe.PointerCast
            quarantine_name: cstr = (&evidence[0]).cast[cstr] can Unsafe.PointerCast
            # Preserve forensic evidence: link() publishes the quarantine entry with
            # no-clobber semantics, so an existing record cannot be replaced by a
            # later failure. Remove the active name only after the link succeeds.
            return false if:
                Platform::pkg_link(blob_name, quarantine_name) != 0
                Platform::pkg_fsync_parent(quarantine_name) != 0
                Platform::pkg_unlink(blob_name) != 0
                Platform::pkg_fsync_parent(blob_name) != 0
            return true

        def registry_receipt_path(archive_digest: darray[u8]&, metadata_digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if:
                not Integrity::valid_sha256_hex(metadata_digest)
                not blob_path(archive_digest, out)
            out.push(46)
            for index in 0..<metadata_digest.count |out, metadata_digest|:
                out.push(metadata_digest[index])
            append_literal(out, ".receipt")
            return true

        def registry_signature_path(metadata_digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not blob_path(metadata_digest, out)
            append_literal(out, ".sig")
            return true

        def verify_blob(digest: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            ignored_content: mutable darray[u8] = []
            return read_verified_blob(digest, Integrity::max_input, &ignored_content)

        def read_verified_blob(digest: darray[u8]&, maximum_bytes: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            path: mutable darray[u8] = []
            return false if:
                not blob_path(digest, &path)
                maximum_bytes > Integrity::max_input
                not Platform::pkg_read_bounded_file(path, maximum_bytes, out)
            actual: mutable darray[u8] = []
            if not Integrity::sha256_hex(out, &actual) or not ByteText::equal(actual, digest):
                out.resize(0)
                return false
            return true

        def read_registry_receipt(archive_digest: darray[u8]&, metadata_digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            path: mutable darray[u8] = []
            return false if not registry_receipt_path(archive_digest, metadata_digest, &path)
            return Platform::pkg_read_bounded_file(path, max_registry_receipt_bytes, out) and out.count != 0.usize()

        def read_registry_signature(digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            path: mutable darray[u8] = []
            return false if not registry_signature_path(digest, &path)
            if not Platform::pkg_read_bounded_file(path, 64.usize(), out) or out.count != 64.usize():
                out.resize(0)
                return false
            return true

        def encode_registry_receipt(package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, archive_size: u64, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            receipt: mutable darray[u8] = []
            append_registry_receipt_prefix(package, version, archive, archive_size, digest, metadata_digest, &receipt)
            registry_append_decimal(&receipt, expires)
            receipt <- receipt.push(10)
            return [] if receipt.count > max_registry_receipt_bytes
            return receipt

        def registry_receipt_matches(receipt: darray[u8]&, package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, archive_size: u64, digest: darray[u8]&, metadata_digest: darray[u8]&, expires_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            expires_out <- 0
            return false if receipt.count == 0.usize() or receipt.count > max_registry_receipt_bytes
            prefix: mutable darray[u8] = []
            append_registry_receipt_prefix(package, version, archive, archive_size, digest, metadata_digest, &prefix)
            return false if not bytes_starts_with(receipt, prefix)
            # The writer emits one to twenty decimal digits and one LF.
            return false if receipt.count - prefix.count < 2.usize() or receipt[receipt.count - 1.usize()] != 10
            finish: usize = receipt.count - 1.usize()
            digit_count: usize = finish - prefix.count
            return false if digit_count > 20.usize() or (digit_count > 1.usize() and receipt[prefix.count] == 48)
            expires: mutable u64 = 0
            for index in prefix.count..<finish |receipt, expires|:
                byte: u8 = receipt[index]
                return false if byte < 48 or byte > 57
                digit: u64 = (byte - 48).u64()
                return false if expires > (18446744073709551615.u64() - digit) / 10.u64()
                expires <- expires * 10.u64() + digit
            expires_out <- expires
            return true

    private:
        def append_registry_receipt_prefix(package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, archive_size: u64, digest: darray[u8]&, metadata_digest: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            append_literal(out, "elisapkg-registry-cache:1\nregistry:primary\nname:")
            bytes_push_array(out, package)
            append_literal(out, "\nversion:")
            bytes_push_array(out, version)
            append_literal(out, "\narchive:")
            bytes_push_array(out, archive)
            append_literal(out, "\narchive-size:")
            registry_append_decimal(out, archive_size)
            append_literal(out, "\narchive-digest:sha256:")
            bytes_push_array(out, digest)
            append_literal(out, "\nmetadata-digest:sha256:")
            bytes_push_array(out, metadata_digest)
            append_literal(out, "\nexpires:")

        def bytes_push_array(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out.push(value[index])

        def bytes_starts_with(value: darray[u8]&, prefix: darray[u8]&) -> bool:
            return false if prefix.count > value.count
            for index in 0..<prefix.count |value, prefix|:
                return false if value[index] != prefix[index]
            return true

        def registry_append_decimal(out: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            start: usize = out.count
            out.resize(start + 20.usize())
            number: mutable u64 = value
            cursor: mutable usize = start
            if number == 0:
                out[cursor] <- 48
                cursor <- cursor + 1.usize()
            else:
                while number > 0 |out, number, cursor|:
                    out[cursor] <- 48 + (number % 10).u8()
                    cursor <- cursor + 1.usize()
                    number <- number / 10
                left: mutable usize = start
                right: mutable usize = cursor
                while left < right and right - left > 1.usize() |out, left, right|:
                    right <- right - 1.usize()
                    temporary: u8 = out[left]
                    out[left] <- out[right]
                    out[right] <- temporary
                    left <- left + 1.usize()
            out.resize(cursor)

        def quarantine_path(digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if not Integrity::valid_sha256_hex(digest)
            append_literal(out, quarantine_directory)
            out.push(47)
            for index in 0..<digest.count |out, digest|:
                out.push(digest[index])
            append_literal(out, ".invalid")
            return true

        def append_literal(out: mutable darray[u8]&, suffix: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            length: usize = Platform::pkg_strlen(suffix)
            for index in 0..<length |out, suffix|:
                out.push(suffix[index].u8())
