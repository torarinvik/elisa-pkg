# Content integrity primitives.
#
# This module is deliberately self-contained and exposes only a digest API. It
# does not decide whether a digest is trusted; Trust owns that policy. Remote
# acquisition remains disabled until signed metadata and an audited provider
# are configured.

module Integrity:
    public:
        const enum DigestCode of u8:
            Ok
            InputTooLarge
            OutputFailure

        const maximum_input: usize = 67108864

        # Compute the FIPS 180-4 SHA-256 digest. The output is exactly 32 bytes.
        def sha256(value: darray[u8]&, out: mutable darray[u8]&) -> DigestCode can[Memory.Allocate, Abort.Panic]:
            # Clear first so a rejected oversized input cannot leave a prior
            # successful digest looking like the result of this call.
            out.resize(0)
            return DigestCode.InputTooLarge if value.count > maximum_input
            out <-
                state: darray[u32] =
                    padded: darray[u8] = padded_message(value)
                    # Build these once per digest rather than once per compression round.
                    round_constants: darray[u32] = sha256_round_constants()
                    # The message schedule is scratch storage for one compression
                    # block, reused across blocks instead of allocated per 64 bytes.
                    while block < padded.count |block: usize = 0.usize(), words: darray[u32] = [0.u32() for slot in 0..<64], state: darray[u32] = initial_state()| -> state:
                        words <- load_schedule(padded, block, words)
                        state <- compress_block(words, round_constants, state)
                        block <- block + 64.usize()
                # Each state word becomes four big-endian digest bytes.
                [(state[index / 4.usize()] >> ((3.usize() - index % 4.usize()) * 8.usize()).u32()).u8() for index in 0..<32]
            DigestCode.Ok

        # Canonical SHA-256 text used in receipts, cache paths, and metadata.
        def valid_sha256_hex(value: darray[u8]&) -> bool:
            valid_sha256_hex_range(value, 0.usize(), value.count)

        def valid_sha256_hex_range(value: darray[u8]&, start: usize, finish: usize) -> bool:
            return false if finish > value.count or start > finish or finish - start != 64.usize()
            for index in start..<finish |valid: bool = true| -> valid:
                byte: u8 = value[index]
                break false if (byte < 48 or byte > 57) and (byte < 97 or byte > 102)

        # Encode a bounded SHA-256 digest in the canonical receipt format.
        def sha256_hex(value: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            digest: mutable darray[u8] = []
            false if sha256(value, &digest) != DigestCode.Ok else hex_digest(digest, out)

        def hex_digest(digest: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            # Invalid digest widths must not preserve a stale encoded value.
            out.resize(0)
            return false if digest.count != 32.usize()
            for index in 0..<digest.count |digest, out|:
                out.push(hex_digit((digest[index].u32() >> 4) & 15.u32()))
                out.push(hex_digit(digest[index].u32() & 15.u32()))
            true

    private:
        def initial_state() -> darray[u32] can[Memory.Allocate, Abort.Panic]:
            [
                0x6a09e667.u32(), 0xbb67ae85.u32(), 0x3c6ef372.u32(), 0xa54ff53a.u32(),
                0x510e527f.u32(), 0x9b05688c.u32(), 0x1f83d9ab.u32(), 0x5be0cd19.u32()
            ]

        # Append the 0x80 marker, zero fill, and the big-endian bit length so
        # the message is a whole number of 64-byte blocks.
        def padded_message(value: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            padded_size: usize = ((value.count + 9.usize() + 63.usize()) / 64.usize()) * 64.usize()
            bit_length: u64 = value.count.u64() * 8.u64()
            [value[index] if index < value.count else 128.u8() if index == value.count else (bit_length >> ((padded_size - 1.usize() - index) * 8.usize()).u64()).u8() if index >= padded_size - 8.usize() else 0.u8() for index in 0..<padded_size]

        def sha256_round_constants() -> darray[u32] can[Memory.Allocate, Abort.Panic]:
            [
                0x428a2f98.u32(), 0x71374491.u32(), 0xb5c0fbcf.u32(), 0xe9b5dba5.u32(),
                0x3956c25b.u32(), 0x59f111f1.u32(), 0x923f82a4.u32(), 0xab1c5ed5.u32(),
                0xd807aa98.u32(), 0x12835b01.u32(), 0x243185be.u32(), 0x550c7dc3.u32(),
                0x72be5d74.u32(), 0x80deb1fe.u32(), 0x9bdc06a7.u32(), 0xc19bf174.u32(),
                0xe49b69c1.u32(), 0xefbe4786.u32(), 0x0fc19dc6.u32(), 0x240ca1cc.u32(),
                0x2de92c6f.u32(), 0x4a7484aa.u32(), 0x5cb0a9dc.u32(), 0x76f988da.u32(),
                0x983e5152.u32(), 0xa831c66d.u32(), 0xb00327c8.u32(), 0xbf597fc7.u32(),
                0xc6e00bf3.u32(), 0xd5a79147.u32(), 0x06ca6351.u32(), 0x14292967.u32(),
                0x27b70a85.u32(), 0x2e1b2138.u32(), 0x4d2c6dfc.u32(), 0x53380d13.u32(),
                0x650a7354.u32(), 0x766a0abb.u32(), 0x81c2c92e.u32(), 0x92722c85.u32(),
                0xa2bfe8a1.u32(), 0xa81a664b.u32(), 0xc24b8b70.u32(), 0xc76c51a3.u32(),
                0xd192e819.u32(), 0xd6990624.u32(), 0xf40e3585.u32(), 0x106aa070.u32(),
                0x19a4c116.u32(), 0x1e376c08.u32(), 0x2748774c.u32(), 0x34b0bcb5.u32(),
                0x391c0cb3.u32(), 0x4ed8aa4a.u32(), 0x5b9cca4f.u32(), 0x682e6ff3.u32(),
                0x748f82ee.u32(), 0x78a5636f.u32(), 0x84c87814.u32(), 0x8cc70208.u32(),
                0x90befffa.u32(), 0xa4506ceb.u32(), 0xbef9a3f7.u32(), 0xc67178f2.u32()
            ]

        # Expand one 64-byte block into the 64-word message schedule.
        def load_schedule(padded: darray[u8]&, block: usize, words: mutable darray[u32]) -> darray[u32] can[Abort.Panic]:
            requires words.count == 64 and block + 64 <= padded.count
            for index in 0..<16 |words, padded, block|:
                offset: usize = block + index * 4.usize()
                words[index] <- (padded[offset].u32() << 24) | (padded[offset + 1.usize()].u32() << 16) | (padded[offset + 2.usize()].u32() << 8) | padded[offset + 3.usize()].u32()
            for index in 16..<64 |words|:
                words[index] <- small_sigma1(words[index - 2.usize()]) + words[index - 7.usize()] + small_sigma0(words[index - 15.usize()]) + words[index - 16.usize()]
            words

        # Run the 64 compression rounds and return `state` with the result added.
        def compress_block(words: darray[u32]&, round_constants: darray[u32]&, state: darray[u32]) -> darray[u32] can[Memory.Allocate, Abort.Panic]:
            requires words.count == 64 and round_constants.count == 64 and state.count == 8
            for index in 0..<64 |a: u32 = state[0], b: u32 = state[1], c: u32 = state[2], d: u32 = state[3], e: u32 = state[4], f: u32 = state[5], g: u32 = state[6], h: u32 = state[7]| -> [state[0] + a, state[1] + b, state[2] + c, state[3] + d, state[4] + e, state[5] + f, state[6] + g, state[7] + h]:
                first_sum: u32 = h + big_sigma1(e) + choose(e, f, g) + round_constants[index] + words[index]
                second_sum: u32 = big_sigma0(a) + majority(a, b, c)
                h <- g
                g <- f
                f <- e
                e <- d + first_sum
                d <- c
                c <- b
                b <- a
                a <- first_sum + second_sum

        def rotate_right(value: u32, amount: u32) -> u32:
            (value >> amount) | (value << (32.u32() - amount))

        def choose(x: u32, y: u32, z: u32) -> u32:
            (x & y) ^ ((~x) & z)

        def majority(x: u32, y: u32, z: u32) -> u32:
            (x & y) ^ (x & z) ^ (y & z)

        def big_sigma0(value: u32) -> u32:
            rotate_right(value, 2) ^ rotate_right(value, 13) ^ rotate_right(value, 22)

        def big_sigma1(value: u32) -> u32:
            rotate_right(value, 6) ^ rotate_right(value, 11) ^ rotate_right(value, 25)

        def small_sigma0(value: u32) -> u32:
            rotate_right(value, 7) ^ rotate_right(value, 18) ^ (value >> 3)

        def small_sigma1(value: u32) -> u32:
            rotate_right(value, 17) ^ rotate_right(value, 19) ^ (value >> 10)

        def hex_digit(value: u32) -> u8:
            (48.u32() + value).u8() if value < 10.u32() else (87.u32() + value).u8()
