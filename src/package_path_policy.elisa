# Shared denylist for credential-bearing paths in source collection and
# publication. Kept independent of PlatformNative so both layers use one policy.
module PackagePathPolicy:
    public:
        # Duplicate-path validation is intentionally a simple flat scan in the
        # archive verifier and extractor. Keep the bound low enough that a
        # maximum-length common-prefix archive has predictable validation cost.
        const max_package_archive_entries: usize = 512

        # Reserved source-manager paths are compared with ASCII case folding
        # because supported macOS volumes are commonly case-insensitive. The
        # package-state directories are excluded only at the package root;
        # nested source directories with these names are ordinary inputs.
        def reserved_source_path_forbidden(path: darray[u8]&) -> bool:
            length: mutable usize = path.count
            if length > 0.usize() and path[length - 1.usize()] == 0:
                length <- length - 1.usize()
            return true if length == 0.usize()

            root_finish: mutable usize = 0.usize()
            while root_finish < length and path[root_finish] != 47:
                root_finish <- root_finish + 1.usize()
            return true if range_equals(path, 0.usize(), root_finish, ".elisapkg") or range_equals(path, 0.usize(), root_finish, "build") or range_equals(path, 0.usize(), root_finish, "target")

            start: mutable usize = 0.usize()
            while start < length |path, length, start|:
                finish: mutable usize = start
                while finish < length and path[finish] != 47 |path, length, start, finish|:
                    finish <- finish + 1.usize()
                return true if range_equals(path, start, finish, ".git") or range_equals(path, start, finish, ".hg") or range_equals(path, start, finish, ".svn") or range_equals(path, start, finish, "implementation_plan.md")
                start <- finish + 1.usize()
            return false

        def credential_path_forbidden(path: darray[u8]&) -> bool:
            length: mutable usize = path.count
            if length > 0.usize() and path[length - 1.usize()] == 0:
                length <- length - 1.usize()
            return true if length == 0.usize()
            start: mutable usize = 0.usize()
            previous_is_config: mutable bool = false
            while start < length |path, length, start, previous_is_config|:
                finish: mutable usize = start
                while finish < length and path[finish] != 47 |path, length, start, finish|:
                    finish <- finish + 1.usize()
                return true if:
                    credential_directory(path, start, finish)
                    previous_is_config and config_provider(path, start, finish)
                    sensitive_component(path, start, finish)
                previous_is_config <- range_equals(path, start, finish, ".config")
                start <- finish + 1.usize()
            return false

        # Apply filename rules to every component, not just the leaf. This
        # prevents a directory such as credentials/ or .env.production/ from
        # exposing all of its otherwise innocently named children.
        def sensitive_component(path: darray[u8]&, start: usize, finish: usize) -> bool:
            return true if:
                range_equals(path, start, finish, ".netrc")
                range_equals(path, start, finish, ".npmrc")
                range_equals(path, start, finish, ".pypirc")
                range_equals(path, start, finish, ".git-credentials")
                range_equals(path, start, finish, "id_rsa")
                range_equals(path, start, finish, "id_ed25519")
                range_equals(path, start, finish, "id_ecdsa")
                range_equals(path, start, finish, "id_dsa")
                begins_with(path, start, finish, ".env")
                ends_with(path, start, finish, ".env")
                begins_with(path, start, finish, "credentials")
                contains(path, start, finish, ".pem")
                contains(path, start, finish, ".key")
                ends_with(path, start, finish, ".p12")
                ends_with(path, start, finish, ".pfx")
                ends_with(path, start, finish, ".p8")
                ends_with(path, start, finish, ".jks")
                ends_with(path, start, finish, ".keystore")
            return false

        # A package may itself be rooted at a credential-store directory. Its
        # files then have ordinary relative names, so reject that root before
        # collection. Only inspect the final root component (or final .config
        # provider pair), never an arbitrary ancestor outside the package.
        def credential_root_forbidden(path: darray[u8]&) -> bool:
            length: mutable usize = path.count
            if length > 0.usize() and path[length - 1.usize()] == 0:
                length <- length - 1.usize()
            # Directory arguments may include one or more trailing separators.
            # Ignore those before checking the final component, while keeping
            # the filesystem root itself intact.
            while length > 1.usize() and path[length - 1.usize()] == 47 |path, length|:
                length <- length - 1.usize()
            return true if length == 0.usize()
            leaf_start: mutable usize = 0.usize()
            previous_start: mutable usize = 0.usize()
            for index in 0..<length |path, leaf_start, previous_start|:
                if path[index] == 47:
                    previous_start <- leaf_start
                    leaf_start <- index + 1.usize()
            return true if:
                sensitive_component(path, leaf_start, length)
                range_equals(path, leaf_start, length, ".config")
                credential_directory(path, leaf_start, length)
            return leaf_start > 0.usize() and range_equals(path, previous_start, leaf_start - 1.usize(), ".config") and config_provider(path, leaf_start, length)

    private:
        def credential_directory(path: darray[u8]&, start: usize, finish: usize) -> bool:
            return true if:
                range_equals(path, start, finish, ".ssh")
                range_equals(path, start, finish, ".aws")
                range_equals(path, start, finish, ".gnupg")
                range_equals(path, start, finish, ".kube")
                range_equals(path, start, finish, ".docker")
                range_equals(path, start, finish, ".azure")
                range_equals(path, start, finish, ".terraform")
                range_equals(path, start, finish, ".terraform.d")
            return false

        def config_provider(path: darray[u8]&, start: usize, finish: usize) -> bool:
            return true if:
                range_equals(path, start, finish, "gcloud")
                range_equals(path, start, finish, "gh")
                range_equals(path, start, finish, "rclone")
            return false

        def range_equals(path: darray[u8]&, start: usize, finish: usize, wanted: cstr) -> bool:
            wanted_length: mutable usize = 0.usize()
            while wanted[wanted_length].u8() != 0:
                wanted_length <- wanted_length + 1.usize()
            return false if finish < start or finish - start != wanted_length
            for index in 0..<wanted_length |path, start, wanted|:
                return false if ascii_lower(path[start + index]) != wanted[index].u8()
            return true

        def begins_with(path: darray[u8]&, start: usize, finish: usize, wanted: cstr) -> bool:
            wanted_length: mutable usize = 0.usize()
            while wanted[wanted_length].u8() != 0:
                wanted_length <- wanted_length + 1.usize()
            return false if finish < start or finish - start < wanted_length
            for index in 0..<wanted_length |path, start, wanted|:
                return false if ascii_lower(path[start + index]) != wanted[index].u8()
            return true

        def ends_with(path: darray[u8]&, start: usize, finish: usize, wanted: cstr) -> bool:
            wanted_length: mutable usize = 0.usize()
            while wanted[wanted_length].u8() != 0:
                wanted_length <- wanted_length + 1.usize()
            return false if finish < start or finish - start < wanted_length
            suffix_start: usize = finish - wanted_length
            for index in 0..<wanted_length |path, suffix_start, wanted|:
                return false if ascii_lower(path[suffix_start + index]) != wanted[index].u8()
            return true

        def contains(path: darray[u8]&, start: usize, finish: usize, wanted: cstr) -> bool:
            wanted_length: mutable usize = 0.usize()
            while wanted[wanted_length].u8() != 0:
                wanted_length <- wanted_length + 1.usize()
            return false if finish < start or finish - start < wanted_length
            candidate: mutable usize = start
            while candidate + wanted_length <= finish |path, start, finish, wanted, wanted_length, candidate|:
                return true if range_equals(path, candidate, candidate + wanted_length, wanted)
                candidate <- candidate + 1.usize()
            return false

        def ascii_lower(value: u8) -> u8:
            return value + 32.u8() if value >= 65 and value <= 90
            return value
