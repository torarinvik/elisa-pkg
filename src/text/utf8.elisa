# Validate UTF-8 scalar encodings without allocating or decoding strings.
module Utf8:
    public:
        def valid(raw: darray[u8]&) -> bool:
            index: mutable usize = 0.usize()
            while index < raw.count:
                first: u8 = raw[index]
                if first <= 127:
                    index <- index + 1.usize()
                    continue
                if first >= 194 and first <= 223:
                    return false if index + 1.usize() >= raw.count or not is_continuation(raw[index + 1.usize()])
                    index <- index + 2.usize()
                    continue
                if first >= 224 and first <= 239:
                    return false if index + 2.usize() >= raw.count
                    region second_scope:
                        second: u8 = raw[index + 1.usize()]
                        return false if:
                            not is_continuation(second) or not is_continuation(raw[index + 2.usize()])
                            first == 224 and second < 160
                            first == 237 and second >= 160
                    index <- index + 3.usize()
                    continue
                if first >= 240 and first <= 244:
                    return false if index + 3.usize() >= raw.count
                    region second_scope:
                        second: u8 = raw[index + 1.usize()]
                        return false if:
                            not is_continuation(second) or not is_continuation(raw[index + 2.usize()]) or not is_continuation(raw[index + 3.usize()])
                            first == 240 and second < 144
                            first == 244 and second > 143
                    index <- index + 4.usize()
                    continue
                return false
            return true

    private:
        def is_continuation(byte: u8) -> bool:
            return byte >= 128 and byte <= 191
