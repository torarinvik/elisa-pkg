# Validate UTF-8 scalar encodings without allocating or decoding strings.
module Utf8:
    public:
        def valid(raw: darray[u8]&) -> bool:
            while index < raw.count |index: usize = 0.usize()|:
                length: usize = sequence_length(raw, index)
                return false if length == 0.usize()
                index <- index + length
            return true

    private:
        def is_continuation(byte: u8) -> bool:
            return byte >= 128 and byte <= 191

        # The byte length of the well-formed UTF-8 sequence starting at
        # `index`, or 0 when it is malformed or truncated.
        def sequence_length(raw: darray[u8]&, index: usize) -> usize:
            requires index < raw.count
            first: u8 = raw[index]
            return 1.usize() if first <= 127
            if first >= 194 and first <= 223:
                return 0.usize() if index + 1.usize() >= raw.count or not is_continuation(raw[index + 1.usize()])
                return 2.usize()
            if first >= 224 and first <= 239:
                return 0.usize() if index + 2.usize() >= raw.count
                second: u8 = raw[index + 1.usize()]
                return 0.usize() if:
                    not is_continuation(second) or not is_continuation(raw[index + 2.usize()])
                    first == 224 and second < 160
                    first == 237 and second >= 160
                return 3.usize()
            return 0.usize() if first < 240 or first > 244 or index + 3.usize() >= raw.count
            second: u8 = raw[index + 1.usize()]
            return 0.usize() if:
                not is_continuation(second) or not is_continuation(raw[index + 2.usize()]) or not is_continuation(raw[index + 3.usize()])
                first == 240 and second < 144
                first == 244 and second > 143
            return 4.usize()
