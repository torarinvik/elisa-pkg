# Byte-array comparisons and text encoding used by the CLI and registry.
module ByteText:
    public:
        def equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true

        def equal_text(value: darray[u8]&, expected: cstr) -> bool:
            return range_equals_text(value, 0.usize(), value.count, expected)

        def range_equals_text(value: darray[u8]&, start: usize, finish: usize, expected: cstr) -> bool:
            return false if start > finish or finish > value.count
            for index in start..<finish |value, start, expected|:
                byte: u8 = expected[index - start].u8()
                return false if byte == 0 or value[index] != byte
            return expected[finish - start].u8() == 0

        # Return the offset after the literal, or -1 on a mismatch.
        def match_text_end(raw: darray[u8]&, start: usize, literal: cstr) -> i64:
            finish: usize =
                length: usize = text_length(literal)
                return -1 if start > raw.count or length > raw.count - start
                start + length
            return finish.i64() if range_equals_text(raw, start, finish, literal) else -1

        def append_text(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            length: usize = text_length(value)
            for index in 0..<length |out, value|:
                out.push(value[index].u8())

        def append(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out.push(value[index])

        # Append the bytes of `value` and then a NUL terminator.
        def append_terminated(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            append(out, value)
            out.push(0)

        # `out` followed by the bytes of `value`.
        def with_text(out: mutable darray[u8], value: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            for index in 0..<text_length(value) |out, value|:
                out <- out.push(value[index].u8())
            return out

        # `out` followed by `value`.
        def with_bytes(out: mutable darray[u8], value: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out <- out.push(value[index])
            return out

        # `out` followed by the canonical decimal digits of `value`.
        def with_decimal(out: mutable darray[u8], value: u64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            while place > 0 |out, place: u64 = highest_decimal_place(value)|:
                out <- out.push(48 + ((value / place) % 10).u8())
                place <- place / 10
            return out

        # Make `out` an exact copy of `value`.
        def replace(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            append(out, value)

        def starts_with_text(value: darray[u8]&, expected: cstr) -> bool:
            length: usize = text_length(expected)
            return value.count >= length and range_equals_text(value, 0.usize(), length, expected)

        def append_range(out: mutable darray[u8]&, source: darray[u8]&, start: usize, finish: usize) -> void can[Memory.Allocate, Abort.Panic]:
            requires start <= finish and finish <= source.count
            for index in start..<finish |out, source|:
                out.push(source[index])

        # Scan digits without consuming the delimiter. Publish results only on success.
        def scan_unsigned_decimal(raw: darray[u8]&, start: usize, finish: usize, end_out: mutable usize&, value_out: mutable u64&) -> bool:
            return false if start >= finish or finish > raw.count
            end, value =
                while end < finish and raw[end] >= 48 and raw[end] <= 57 |end: usize = start, value: u64 = 0| -> (end, value):
                    digit: u64 = (raw[end] - 48).u64()
                    return false if value > (18446744073709551615.u64() - digit) / 10.u64()
                    end <- end + 1.usize()
                    value <- value * 10.u64() + digit
            return end != start and published_scan(end, value, end_out, value_out)

        # Require every byte in the span to be a decimal digit.
        def parse_unsigned_decimal(raw: darray[u8]&, start: usize, finish: usize, out: mutable u64&) -> bool:
            value: mutable u64 = 0.u64()
            parsed: bool = |value|
                end: mutable usize = start
                scan_unsigned_decimal(raw, start, finish, &end, &value) and end == finish
            return published(parsed, value, out)

        # Scan a canonical decimal prefix without consuming its delimiter.
        def scan_canonical_unsigned_decimal(raw: darray[u8]&, start: usize, finish: usize, end_out: mutable usize&, value_out: mutable u64&) -> bool:
            return false if start >= finish or finish > raw.count
            if raw[start] == 48:
                next: usize = start + 1.usize()
                return not (next < finish and raw[next] >= 48 and raw[next] <= 57) and published_scan(next, 0.u64(), end_out, value_out)
            # Include one extra byte to distinguish a delimiter from another digit.
            scan_end: usize =
                scan_bytes: usize = maximum_unsigned_decimal_digits + 1.usize()
                start + scan_bytes if finish - start > scan_bytes else finish
            return scan_unsigned_decimal(raw, start, scan_end, end_out, value_out)

        # Parse the decimal representation emitted by append_decimal.
        def parse_canonical_unsigned_decimal(raw: darray[u8]&, start: usize, finish: usize, out: mutable u64&) -> bool:
            value: mutable u64 = 0.u64()
            parsed: bool = |value|
                end: mutable usize = start
                scan_canonical_unsigned_decimal(raw, start, finish, &end, &value) and end == finish
            return published(parsed, value, out)

        def append_decimal(out: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            digit_count: usize = decimal_digit_count(value)
            start: usize = out.count
            out.resize(start + digit_count)
            # Write the digits from the last one back to the first.
            while index < digit_count |out, index: usize = 0.usize(), number: u64 = value|:
                out[start + digit_count - 1.usize() - index] <- 48 + (number % 10).u8()
                number <- number / 10
                index <- index + 1.usize()

        def append_signed_decimal(out: mutable darray[u8]&, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if value < 0:
                out.push(45)
                append_decimal(out, 0.u64() - value.u64())
            else:
                append_decimal(out, value.u64())

        # `out` followed by the bytes of `value`, stopping after 1 MiB.
        def with_bounded_text(out: mutable darray[u8], value: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            for index in 0..<1048576.usize() |out, value|:
                byte: u8 = value[index].u8()
                break if byte == 0
                out <- out.push(byte)
            return out

        def append_bounded_text(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<1048576.usize() |out, value|:
                byte: u8 = value[index].u8()
                break if byte == 0
                out.push(byte)

        def count_text(haystack: darray[u8]&, needle: cstr) -> usize:
            needle_length: usize = text_length(needle)
            return 0.usize() if needle_length == 0.usize() or needle_length > haystack.count
            last_start: usize = haystack.count - needle_length
            return while start <= last_start |start: usize = 0, total: usize = 0| -> total:
                if range_equals_text(haystack, start, start + needle_length, needle):
                    total <- total + 1.usize()
                    start <- start + needle_length
                else:
                    start <- start + 1.usize()

        def starts_with(value: darray[u8]&, prefix: darray[u8]&) -> bool:
            return false if prefix.count > value.count
            for index in 0..<prefix.count |value, prefix|:
                return false if value[index] != prefix[index]
            return true

        def ends_with(value: darray[u8]&, suffix: darray[u8]&) -> bool:
            return suffix.count <= value.count and range_equals(value, value.count - suffix.count, value.count, suffix)

        def less(left: darray[u8]&, right: darray[u8]&) -> bool:
            limit: usize = left.count if left.count < right.count else right.count
            index: usize = while index < limit and left[index] == right[index] |index: usize = 0.usize()| -> index:
                index <- index + 1.usize()
            return left[index] < right[index] if index < limit else left.count < right.count

        def contains_null_terminator_field(queue: darray[u8]&, wanted: darray[u8]&) -> bool:
            while cursor < queue.count |cursor: usize = 0|:
                finish: usize =
                    while finish < queue.count and queue[finish] != 0 |finish: usize = cursor| -> finish:
                        finish <- finish + 1.usize()
                return true if range_equals(queue, cursor, finish, wanted)
                cursor <- finish + 1
            return false

        def range_equals(raw: darray[u8]&, start: usize, end: usize, wanted: darray[u8]&) -> bool:
            return false if end < start or end > raw.count or end - start != wanted.count
            for index in 0..<wanted.count |raw, wanted|:
                return false if raw[start + index] != wanted[index]
            return true

        # Count the bytes before the terminator of a C string.
        def text_length(value: cstr) -> usize:
            return while value[length].u8() != 0 |length: usize = 0| -> length:
                length <- length + 1.usize()

    private:
        const maximum_unsigned_decimal_digits: usize = 20.usize()

        # The place value of the leading decimal digit of `value`.
        def highest_decimal_place(value: u64) -> u64:
            return while value / place >= 10 |place: u64 = 1| -> place:
                place <- place * 10

        # The number of decimal digits in `value`, which is 1 for zero.
        def decimal_digit_count(value: u64) -> usize:
            return while number >= 10 |number: u64 = value, count: usize = 1.usize()| -> count:
                number <- number / 10
                count <- count + 1.usize()

        # Store a scanned span end and value, and report success.
        def published_scan(end: usize, value: u64, end_out: mutable usize&, value_out: mutable u64&) -> bool:
            end_out <- end
            value_out <- value
            return true

        # Store `value` in `out` when `parsed`, otherwise zero, and return `parsed`.
        def published(parsed: bool, value: u64, out: mutable u64&) -> bool:
            out <- value if parsed else 0.u64()
            return parsed
