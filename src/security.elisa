# Trust policy boundary.
#
# Remote operations deliberately have no provider in this release. The public API
# exposes only stable decisions and messages; key material, verifier state, and
# provider implementation details stay private until the selected TUF profile
# and audited crypto provider are implemented and reviewed.

module Security:
    public:
        def remote_fetch_status() -> i64:
            return 5

        def remote_fetch_message() -> cstr:
            return "error: no remote source provider is configured; refusing unsigned network fetch\n"

        def publish_status() -> i64:
            return 5

        def publish_message() -> cstr:
            return "error: publish is disabled until signed registry metadata and publisher authorization are configured\n"

        def install_status() -> i64:
            return 5

        def install_message() -> cstr:
            return "error: install is disabled until the source passes signature, revocation, and archive checks\n"

    private:
        const protocol_required: cstr = "TUF v1.0.33 metadata roles with package-scoped delegation"
