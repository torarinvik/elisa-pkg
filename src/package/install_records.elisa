# On-disk records for local binary installation and transaction recovery.

include "./package_identity.elisa"
include "../integrity.elisa"

module InstallRecords:
    private:
        def bytes_push_view(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            index: mutable usize = 0.usize()
            while value[index].u8() != 0 |out, value, index|:
                out.push(value[index].u8())
                index <- index + 1.usize()

        def bytes_push_array(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out.push(value[index])

        const journal_prefix: cstr = "elisapkg-install-transaction:1\noperation:"
        const name_label: cstr = "\nname:"
        const version_label: cstr = "\nversion:"
        const digest_label: cstr = "\nartifact-digest:sha256:"

        # Return the offset after the literal, or -1 on a mismatch.
        def match_literal(raw: darray[u8]&, start: usize, literal: cstr) -> i64:
            position: mutable usize = start
            index: mutable usize = 0.usize()
            while literal[index].u8() != 0 |raw, literal, position, index|:
                return -1 if position >= raw.count or raw[position] != literal[index].u8()
                position <- position + 1.usize()
                index <- index + 1.usize()
            return position.i64()

    public:
        const max_record_bytes: usize = 8192.usize()

        def encode_receipt(name: darray[u8]&, version: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            bytes_push_view(out, "elisapkg-install-receipt:1\nname:")
            bytes_push_array(out, name)
            bytes_push_view(out, "\nversion:")
            bytes_push_array(out, version)
            bytes_push_view(out, "\npath:")
            bytes_push_array(out, destination)
            bytes_push_view(out, "\nartifact-digest:sha256:")
            bytes_push_array(out, digest)
            bytes_push_view(out, "\n")

        def encode_journal(operation: cstr, name: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            bytes_push_view(out, journal_prefix)
            bytes_push_view(out, operation)
            bytes_push_view(out, name_label)
            bytes_push_array(out, name)
            bytes_push_view(out, version_label)
            bytes_push_array(out, version)
            bytes_push_view(out, digest_label)
            bytes_push_array(out, digest)
            bytes_push_view(out, "\n")

        def parse_journal(raw: darray[u8]&, out_operation: mutable darray[u8]&, out_name: mutable darray[u8]&, out_version: mutable darray[u8]&, out_digest: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out_operation.resize(0)
            out_name.resize(0)
            out_version.resize(0)
            out_digest.resize(0)
            return false if raw.count > max_record_bytes
            journal_operation: mutable darray[u8] = []
            journal_name: mutable darray[u8] = []
            journal_version: mutable darray[u8] = []
            journal_digest: mutable darray[u8] = []
            operation_start: i64 = match_literal(raw, 0.usize(), journal_prefix)
            return false if operation_start < 0
            name_offset: mutable i64 = -1
            for operation in ["install", "uninstall"]:
                operation_end: i64 = match_literal(raw, operation_start.usize(), operation)
                continue if operation_end < 0
                name_offset <- match_literal(raw, operation_end.usize(), name_label)
                if name_offset >= 0:
                    bytes_push_view(&journal_operation, operation)
                    break
            return false if name_offset < 0
            name_start: usize = name_offset.usize()
            name_end: mutable usize = name_start
            while name_end < raw.count and raw[name_end] != 10:
                name_end <- name_end + 1.usize()
            return false if name_end == name_start or name_end >= raw.count or name_end - name_start > PackageIdentity::max_name_bytes
            for index in name_start..<name_end |raw, journal_name|:
                journal_name.push(raw[index])
            return false if not PackageIdentity::valid_name(journal_name)
            version_offset: i64 = match_literal(raw, name_end, version_label)
            return false if version_offset < 0
            version_start: usize = version_offset.usize()
            version_end: mutable usize = version_start
            while version_end < raw.count and raw[version_end] != 10:
                version_end <- version_end + 1
            return false if version_end == version_start or version_end >= raw.count or version_end - version_start > SemVer::max_version_bytes
            for index in version_start..<version_end |raw, journal_version|:
                journal_version.push(raw[index])
            parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return false if not PackageIdentity::parse_version(journal_version, &parsed_version)
            digest_offset: i64 = match_literal(raw, version_end, digest_label)
            return false if digest_offset < 0
            digest_start: usize = digest_offset.usize()
            return false if raw.count - digest_start != 65.usize()
            for index in 0..<64 |raw, journal_digest, digest_start|:
                journal_digest.push(raw[digest_start + index])
            return false if raw[raw.count - 1.usize()] != 10 or not Integrity::valid_sha256_hex(journal_digest)
            out_operation <- journal_operation
            out_name <- journal_name
            out_version <- journal_version
            out_digest <- journal_digest
            return true
