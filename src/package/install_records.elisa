# On-disk records for local binary installation and transaction recovery.

include "./package_identity.elisa"
include "../integrity.elisa"
include "../text/bytes.elisa"

module InstallRecords:
    private:
        const journal_prefix: cstr = "elisapkg-install-transaction:1\noperation:"
        const name_label: cstr = "\nname:"
        const version_label: cstr = "\nversion:"
        const digest_label: cstr = "\nartifact-digest:sha256:"

    public:
        const maximum_record_bytes: usize = 8192.usize()

        def encode_receipt(name: darray[u8]&, version: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            ByteText::append_text(out, "elisapkg-install-receipt:1\nname:")
            ByteText::append(out, name)
            ByteText::append_text(out, "\nversion:")
            ByteText::append(out, version)
            ByteText::append_text(out, "\npath:")
            ByteText::append(out, destination)
            ByteText::append_text(out, "\nartifact-digest:sha256:")
            ByteText::append(out, digest)
            ByteText::append_text(out, "\n")

        def encode_journal(operation: cstr, name: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            ByteText::append_text(out, journal_prefix)
            ByteText::append_text(out, operation)
            ByteText::append_text(out, name_label)
            ByteText::append(out, name)
            ByteText::append_text(out, version_label)
            ByteText::append(out, version)
            ByteText::append_text(out, digest_label)
            ByteText::append(out, digest)
            ByteText::append_text(out, "\n")

        def parse_journal(raw: darray[u8]&, out_operation: mutable darray[u8]&, out_name: mutable darray[u8]&, out_version: mutable darray[u8]&, out_digest: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out_operation.resize(0)
            out_name.resize(0)
            out_version.resize(0)
            out_digest.resize(0)
            return false if raw.count > maximum_record_bytes
            journal_operation: mutable darray[u8] = []
            operation_start: i64 = ByteText::match_text_end(raw, 0.usize(), journal_prefix)
            return false if operation_start < 0
            name_offset: mutable i64 = -1
            for operation_index in 0..<2:
                operation: cstr = "install" if operation_index == 0 else "uninstall"
                operation_end: i64 = ByteText::match_text_end(raw, operation_start.usize(), operation)
                continue if operation_end < 0
                name_offset <- ByteText::match_text_end(raw, operation_end.usize(), name_label)
                if name_offset >= 0:
                    ByteText::append_text(&journal_operation, operation)
                    break
            return false if name_offset < 0
            name_start: usize = name_offset.usize()
            name_end: usize =
                while end < raw.count and end - name_start < PackageIdentity::maximum_name_bytes and raw[end] != 10 |end: usize = name_start| -> end:
                    end <- end + 1.usize()
            return false if:
                name_end >= raw.count or raw[name_end] != 10
                not PackageIdentity::valid_name_segment(raw, name_start, name_end)
            version_offset: i64 = ByteText::match_text_end(raw, name_end, version_label)
            return false if version_offset < 0
            version_start: usize = version_offset.usize()
            version_end: usize =
                while end < raw.count and end - version_start < SemVer::maximum_version_bytes and raw[end] != 10 |end: usize = version_start| -> end:
                    end <- end + 1.usize()
            region parsed_version_scope:
                parsed_version: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                return false if:
                    version_end >= raw.count or raw[version_end] != 10
                    not SemVer::parse_range(raw, version_start, version_end, &parsed_version)
            digest_offset: i64 = ByteText::match_text_end(raw, version_end, digest_label)
            return false if digest_offset < 0
            digest_start: usize = digest_offset.usize()
            return false if raw.count - digest_start != 65.usize()
            region digest_end_scope:
                digest_end: usize = raw.count - 1.usize()
                return false if:
                    raw[digest_end] != 10
                    not Integrity::valid_sha256_hex_range(raw, digest_start, digest_end)
                ByteText::append(out_operation, journal_operation)
                ByteText::append_range(out_name, raw, name_start, name_end)
                ByteText::append_range(out_version, raw, version_start, version_end)
                ByteText::append_range(out_digest, raw, digest_start, digest_end)
            return true
