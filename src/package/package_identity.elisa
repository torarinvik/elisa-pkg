# Canonical package identity validation shared by CLI and serialization code.
# This module depends only on semantic-version parsing and carries no I/O state.

include "./model.elisa"
include "../resolution/semver.elisa"

module PackageIdentity:
    public:
        const maximum_name_bytes: usize = 64.usize()

        def valid_name(name: darray[u8]&) -> bool:
            return valid_name_segment(name, 0.usize(), name.count)

        # Validate one package-name component inside a larger identity path.
        # Keeping the range form here lets namespace validation reuse exactly
        # the package character and length policy without allocating a copy.
        def valid_name_segment(value: darray[u8]&, start: usize, finish: usize) -> bool:
            return false if:
                finish > value.count or start >= finish or finish - start > maximum_name_bytes
                value[start] < 97 or value[start] > 122
            for index in start..<finish |value, start, finish, previous_hyphen: bool = false|:
                byte: u8 = value[index]
                if byte == 45:
                    return false if index == start or index + 1.usize() == finish or previous_hyphen
                    previous_hyphen <- true
                else:
                    return false if (byte < 97 or byte > 122) and (byte < 48 or byte > 57)
                    previous_hyphen <- false
            return true

        def valid_version(version: darray[u8]&) -> bool:
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return parse_version(version, &parsed)

        def parse_version(value: darray[u8]&, out: mutable Model::Version&) -> bool:
            out <- Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return false if value.count == 0.usize() or value.count > SemVer::maximum_version_bytes
            return SemVer::parse(value, out)

    private:
