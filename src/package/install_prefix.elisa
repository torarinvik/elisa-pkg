# Resolve and validate the configured local installation prefix.

include "../platform.elisa"

module InstallPrefix:
    private:
        const max_prefix_bytes: usize = 4006.usize()

        def valid_install_prefix(path: darray[u8]&) -> bool:
            # Reserve the 89-byte receipt path suffix so even the longest package
            # name remains below PATH_MAX including its terminating NUL.
            return false if path.count == 0.usize() or path.count > max_prefix_bytes or path[0] != 47
            for index in 0..<path.count |path|:
                return false if path[index] < 32 or path[index] == 127 or path[index] == 0
                return false if index > 0.usize() and path[index - 1.usize()] == 47 and path[index] == 47
            segment_start: mutable usize = 1.usize()
            index: mutable usize = 1.usize()
            while index <= path.count |path, segment_start, index|:
                if index == path.count or path[index] == 47:
                    segment_length: usize = index - segment_start
                    return false if segment_length == 1.usize() and path[segment_start] == 46
                    return false if segment_length == 2.usize() and path[segment_start] == 46 and path[segment_start + 1.usize()] == 46
                    segment_start <- index + 1.usize()
                index <- index + 1.usize()
            return true

        def copy_environment_path(value: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            length: usize = Platform::pkg_strlen(value)
            return [] if length == 0.usize() or length > max_prefix_bytes
            path: mutable darray[u8] = []
            for index in 0..<length |path, value|:
                path.push(value[index].u8())
            return path

    public:
        def read_configured(out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            prefix: mutable darray[u8] = []
            configured_prefix: u8&? = Platform::pkg_getenv("ELISAPKG_INSTALL_PREFIX")
            if configured_prefix is prefix_value:
                prefix <- copy_environment_path(prefix_value.cast[cstr])
            else:
                configured_home: u8&? = Platform::pkg_getenv("HOME")
                if configured_home is home_value:
                    prefix <- copy_environment_path(home_value.cast[cstr])
                    return false if prefix.count == 0.usize()
                    if prefix[prefix.count - 1.usize()] != 47:
                        prefix.push(47)
                    suffix: cstr = ".local"
                    for index in 0..<6 |prefix, suffix|:
                        prefix.push(suffix[index].u8())
            return false if not valid_install_prefix(prefix)
            out <- prefix
            return true
