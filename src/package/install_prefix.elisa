# Resolve and validate the configured local installation prefix.

include "../platform.elisa"

module InstallPrefix:
    private:
        const maximum_prefix_bytes: usize = 4006.usize()

        def valid_install_prefix(path: darray[u8]&) -> bool:
            # Reserve the 89-byte receipt path suffix so even the longest package
            # name remains below PATH_MAX including its terminating NUL.
            return false if path.count == 0.usize() or path.count > maximum_prefix_bytes or path[0] != 47
            for index in 0..<path.count |path|:
                return false if:
                    path[index] < 32 or path[index] == 127 or path[index] == 0
                    index > 0.usize() and path[index - 1.usize()] == 47 and path[index] == 47
            while index <= path.count |path, segment_start: usize = 1.usize(), index: usize = 1.usize()|:
                if index == path.count or path[index] == 47:
                    region segment_length_scope:
                        segment_length: usize = index - segment_start
                        return false if:
                            segment_length == 1.usize() and path[segment_start] == 46
                            segment_length == 2.usize() and path[segment_start] == 46 and path[segment_start + 1.usize()] == 46
                    segment_start <- index + 1.usize()
                index <- index + 1.usize()
            return true

        def copy_environment_path(value: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            path: mutable darray[u8] =
                length: usize = Platform::c_string_length(value)
                return [] if length == 0.usize() or length > maximum_prefix_bytes
                [value[index].u8() for index in 0..<length]
            return path

        def terminated_path(path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            terminated: mutable darray[u8] = []
            for index in 0..<path.count |path, terminated|:
                return [] if path[index] == 0
                terminated <- terminated.push(path[index])
            terminated <- terminated.push(0)
            return terminated

    public:
        def read_configured(out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            region prefix_scope:
                prefix: darray[u8] = environment_install_prefix()
                return false if not valid_install_prefix(prefix)
                ByteText::append(out, prefix)
            return true

        # `ELISAPKG_INSTALL_PREFIX`, else `$HOME/.local`, else empty.
        def environment_install_prefix() -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if Platform::environment_variable("ELISAPKG_INSTALL_PREFIX") is prefix_value:
                return copy_environment_path(prefix_value.cast[cstr])
            if Platform::environment_variable("HOME") is home_value:
                prefix: mutable darray[u8] = copy_environment_path(home_value.cast[cstr])
                return [] if prefix.count == 0.usize()
                if prefix[prefix.count - 1.usize()] != 47:
                    prefix <- prefix.push(47)
                return ByteText::with_text(prefix, ".local")
            return []

        def trusted_existing_ancestor(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if not valid_install_prefix(path)
            status: i64 =
                path_c: mutable darray[u8] = terminated_path(path)
                path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
                Platform::trusted_directory_status(path_name)
            return status == 0 or status == -2

        def trusted_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = terminated_path(path)
            return false if path.count == 0.usize() or path_c.count == 0.usize()
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            return Platform::is_trusted_directory(path_name) == 1

        def ensure_trusted_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = terminated_path(path)
            return false if path.count == 0.usize() or path_c.count == 0.usize()
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            return Platform::ensure_trusted_directory(path_name) == 0
