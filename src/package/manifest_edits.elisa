# Formatting-preserving edits of validated manifest dependency objects.
include "./manifest.elisa"

module ManifestEdits:
    public:
        def initial_document(library: bool) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            document: dstr =
                target_kind: sview = sview("lib", 0, 3) if library else sview("bin", 0, 3)
                f"{{\n  \"schema-version\": 1,\n  \"package\": {{\n    \"name\": \"app\",\n    \"version\": \"0.1.0\",\n    \"description\": \"An Elisa application\",\n    \"license\": \"MIT\",\n    \"elisa\": \">=0.1.0 <1.0.0\"\n  }},\n  \"targets\": [{{\"name\": \"app\", \"kind\": \"{target_kind}\", \"entry\": \"src/main.elisa\"}}],\n  \"dependencies\": {{}},\n  \"dev-dependencies\": {{}},\n  \"include\": [\"src/**\", \"elisapkg.json\", \"LICENSE\", \"README.md\"]\n}}\n"
            with_text([], document)

        def append_path(raw: darray[u8]&, alias: darray[u8]&, path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return [] if:
                not PackageIdentity::valid_name(alias)
                not Manifest::valid_dependency_path(path)
            entry: dstr =
                name: sview = sview((&alias[0]).cast[cstr], 0, alias.count)
                location: sview = sview((&path[0]).cast[cstr], 0, path.count)
                f"\"{name}\": {{\"path\": \"{location}\"}}"
            append_entry(raw, alias, entry)

        def append_registry(raw: darray[u8]&, alias: darray[u8]&, requirement: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return [] if not PackageIdentity::valid_name(alias) or not valid_string_value(requirement)
            entry: dstr =
                name: sview = sview((&alias[0]).cast[cstr], 0, alias.count)
                version: sview = sview((&requirement[0]).cast[cstr], 0, requirement.count)
                f"\"{name}\": {{\"registry\": \"primary\", \"version\": \"{version}\"}}"
            append_entry(raw, alias, entry)

        def remove(raw: darray[u8]&, alias: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            start: mutable usize = 0.usize()
            end: mutable usize = 0.usize()
            if not Manifest::find_dependency_span(raw, alias, &start, &end):
                []
            else:
                dependency_start: usize = Json::root_value_offset(raw, "dependencies")
                dependency_end: usize = Json::object_end(raw, dependency_start)
                following: usize = Json::skip_whitespace(raw, end, dependency_end)
                if following < dependency_end and raw[following] == 44:
                    # Drop the entry together with the comma that follows it.
                    kept: mutable darray[u8] = [raw[item] for item in 0..<start]
                    ByteText::with_range(kept, raw, following + 1.usize(), raw.count)
                else:
                    # The last entry: drop the comma before it, if any.
                    kept: mutable darray[u8] =
                        removal_start: usize =
                            preceding: usize = while probe > dependency_start + 1.usize() and Json::is_whitespace(raw[probe - 1.usize()]) |probe: usize = start| -> probe:
                                probe <- probe - 1.usize()
                            preceding - 1.usize() if preceding > dependency_start and raw[preceding - 1.usize()] == 44 else start
                        [raw[item] for item in 0..<removal_start]
                    ByteText::with_range(kept, raw, end, raw.count)

    private:
        # `out` followed by the bytes of `text`.
        def with_text(out: mutable darray[u8], text: dstr&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            for index in 0..<text.count |out, text|:
                out <- out.push(text[index].u8())
            out

        def valid_string_value(value: darray[u8]&) -> bool:
            if value.count == 0.usize() or value.count > Json::maximum_document_bytes or not Json::valid_utf8(value):
                false
            else:
                for index in 0..<value.count |valid: bool = true| -> valid:
                    byte: u8 = value[index]
                    break false if byte < 32 or byte == 34 or byte == 92

        def append_entry(raw: darray[u8]&, alias: darray[u8]&, entry: dstr&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            dependency_start: usize = Json::root_value_offset(raw, "dependencies")
            if dependency_start >= raw.count:
                append_object_member(raw, Json::root_start(raw), entry, true)
            else:
                previous_start: mutable usize = 0.usize()
                previous_end: mutable usize = 0.usize()
                if Manifest::find_dependency_span(raw, alias, &previous_start, &previous_end):
                    []
                else:
                    out: darray[u8] = append_object_member(raw, dependency_start, entry, false)
                    [] if not Manifest::valid_dependency_map(out, "dependencies") else out

        def append_object_member(raw: darray[u8]&, object_start: usize, entry: dstr&, create_dependencies: bool) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            # Insert after the last non-whitespace byte before the closing brace.
            insertion: usize =
                object_end: usize = Json::object_end(raw, object_start)
                if object_start >= object_end or object_end >= raw.count:
                    return []
                else:
                    while probe > object_start + 1.usize() and Json::is_whitespace(raw[probe - 1.usize()]) |probe: usize = object_end| -> probe:
                        probe <- probe - 1.usize()
            has_existing: bool = insertion > object_start + 1.usize()
            # A `, ` separator and the `"dependencies": {` ... `}` wrapper.
            framing_bytes: usize = (2.usize() if has_existing else 0.usize()) + (18.usize() if create_dependencies else 0.usize())
            if raw.count > Json::maximum_document_bytes or framing_bytes > Json::maximum_document_bytes - raw.count or entry.count > Json::maximum_document_bytes - raw.count - framing_bytes:
                []
            else:
                out: mutable darray[u8] = [raw[item] for item in 0..<insertion]
                if has_existing:
                    ByteText::append_text(&out, ", ")
                if create_dependencies:
                    ByteText::append_text(&out, "\"dependencies\": {")
                out <- with_text(out, entry)
                if create_dependencies:
                    out <- out.push(125)
                ByteText::with_range(out, raw, insertion, raw.count)
