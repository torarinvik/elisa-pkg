# Formatting-preserving edits of validated manifest dependency objects.
include "./manifest.elisa"

module ManifestEdits:
    public:
        def initial_document(library: bool) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            target_kind: sview = sview("lib", 0, 3) if library else sview("bin", 0, 3)
            document: dstr = f"{{\n  \"schema-version\": 1,\n  \"package\": {{\n    \"name\": \"app\",\n    \"version\": \"0.1.0\",\n    \"description\": \"An Elisa application\",\n    \"license\": \"MIT\",\n    \"elisa\": \">=0.1.0 <1.0.0\"\n  }},\n  \"targets\": [{{\"name\": \"app\", \"kind\": \"{target_kind}\", \"entry\": \"src/main.elisa\"}}],\n  \"dependencies\": {{}},\n  \"dev-dependencies\": {{}},\n  \"include\": [\"src/**\", \"elisapkg.json\", \"LICENSE\", \"README.md\"]\n}}\n"
            bytes: mutable darray[u8] = []
            append_text(&bytes, document)
            return bytes

        def append_path(raw: darray[u8]&, alias: darray[u8]&, path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return [] if:
                not PackageIdentity::valid_name(alias)
                not Manifest::valid_dependency_path(path)
            name: sview = sview((&alias[0]).cast[cstr], 0, alias.count)
            location: sview = sview((&path[0]).cast[cstr], 0, path.count)
            entry: dstr = f"\"{name}\": {{\"path\": \"{location}\"}}"
            return append_entry(raw, alias, entry)

        def append_registry(raw: darray[u8]&, alias: darray[u8]&, requirement: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return [] if not PackageIdentity::valid_name(alias) or not valid_string_value(requirement)
            name: sview = sview((&alias[0]).cast[cstr], 0, alias.count)
            version: sview = sview((&requirement[0]).cast[cstr], 0, requirement.count)
            entry: dstr = f"\"{name}\": {{\"registry\": \"primary\", \"version\": \"{version}\"}}"
            return append_entry(raw, alias, entry)

        def remove(raw: darray[u8]&, alias: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            dependency_start: usize = Json::root_value_offset(raw, "dependencies")
            dependency_end: usize = Json::object_end(raw, dependency_start)
            start: mutable usize = 0.usize()
            end: mutable usize = 0.usize()
            return [] if not Manifest::find_dependency_span(raw, alias, &start, &end)
            probe: mutable usize = end
            while probe < dependency_end and (raw[probe] == 32 or raw[probe] == 9 or raw[probe] == 10 or raw[probe] == 13) |raw, probe|:
                probe <- probe + 1.usize()
            if probe < dependency_end and raw[probe] == 44:
                end <- probe + 1.usize()
            else:
                probe <- start
                while probe > dependency_start + 1.usize() and (raw[probe - 1.usize()] == 32 or raw[probe - 1.usize()] == 9 or raw[probe - 1.usize()] == 10 or raw[probe - 1.usize()] == 13) |raw, probe|:
                    probe <- probe - 1.usize()
                start <- probe - 1.usize() if probe > dependency_start and raw[probe - 1.usize()] == 44
            out: mutable darray[u8] = []
            for index in 0..<start |out, raw|:
                out.push(raw[index])
            for index in end..<raw.count |out, raw|:
                out.push(raw[index])
            return out

    private:
        def append_text(out: mutable darray[u8]&, text: dstr&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<text.count |out, text|:
                out.push(text[index].u8())

        def valid_string_value(value: darray[u8]&) -> bool:
            return false if:
                value.count == 0.usize() or value.count > Json::max_document_bytes
                not Json::valid_utf8(value)
            for index in 0..<value.count |value|:
                byte: u8 = value[index]
                return false if byte < 32 or byte == 34 or byte == 92
            return true

        def append_entry(raw: darray[u8]&, alias: darray[u8]&, entry: dstr&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            dependency_start: usize = Json::root_value_offset(raw, "dependencies")
            dependency_end: usize = Json::object_end(raw, dependency_start)
            return [] if dependency_start >= dependency_end or dependency_end >= raw.count
            previous_start: mutable usize = 0.usize()
            previous_end: mutable usize = 0.usize()
            return [] if Manifest::find_dependency_span(raw, alias, &previous_start, &previous_end)
            has_existing: mutable bool = false
            for index in (dependency_start + 1.usize())..<dependency_end |raw, has_existing|:
                byte: u8 = raw[index]
                if byte != 32 and byte != 9 and byte != 10 and byte != 13:
                    has_existing <- true
                    break
            separator_bytes: usize = 2.usize() if has_existing else 0.usize()
            return [] if raw.count > Json::max_document_bytes
            remaining: usize = Json::max_document_bytes - raw.count
            return [] if separator_bytes > remaining or entry.count > remaining - separator_bytes
            out: mutable darray[u8] = []
            for index in 0..<dependency_end |out, raw|:
                out.push(raw[index])
            if has_existing:
                ByteText::append_text(&out, ", ")
            append_text(&out, entry)
            for index in dependency_end..<raw.count |out, raw|:
                out.push(raw[index])
            return out
