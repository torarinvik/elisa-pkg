# Locate a dependency name and its object value without copying either.
include "../json.elisa"
include "./package_identity.elisa"

module DependencyEntry:
    public:
        struct Span:
            name_start: mutable usize
            name_end: mutable usize
            object_start: mutable usize
            object_end: mutable usize

        def read(raw: darray[u8]&, start: usize, finish: usize, span: mutable Span&) -> bool:
            requires start < finish and finish <= raw.count
            return false if raw[start] != 34
            name_start: usize = start + 1.usize()
            name_end: usize =
                while end < finish and end - name_start < PackageIdentity::max_name_bytes and raw[end] != 34 |end: usize = name_start| -> end:
                    end <- end + 1.usize()
            return false if:
                name_end >= finish or raw[name_end] != 34
                not PackageIdentity::valid_name_segment(raw, name_start, name_end)
            separator: usize = Json::skip_whitespace(raw, name_end + 1.usize(), finish)
            return false if separator >= finish or raw[separator] != 58
            object_start: usize = Json::skip_whitespace(raw, separator + 1.usize(), finish)
            return false if object_start >= finish or raw[object_start] != 123
            object_end: usize = Json::object_end(raw, object_start)
            return false if object_end <= object_start or object_end >= finish
            span <- Span{name_start: name_start, name_end: name_end, object_start: object_start, object_end: object_end}
            return true

        # Return finish after the final entry, or raw.count for an invalid separator.
        def next_start(raw: darray[u8]&, object_end: usize, finish: usize) -> usize:
            requires object_end < finish and finish < raw.count
            separator: usize = Json::skip_whitespace(raw, object_end + 1.usize(), finish)
            return finish if separator == finish
            return raw.count if raw[separator] != 44
            next: usize = Json::skip_whitespace(raw, separator + 1.usize(), finish)
            return raw.count if next == finish
            return next
