# Canonical receipt for a locally built source archive.

include "./model.elisa"
include "./package_identity.elisa"
include "../integrity.elisa"
include "../text/bytes.elisa"

module PackageReceipt:
    public:
        # Maximum package name, version, three SHA-256 digests, and receipt
        # labels occupy 493 bytes. Keep a small explicit margin for disk reads.
        const maximum_encode: usize = 512.usize()

        def encode(name: darray[u8]&, version: darray[u8]&, manifest_digest: darray[u8]&, lock_digest: darray[u8]&, archive_digest: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if:
                not PackageIdentity::valid_name(name) or not valid_version(version)
                not Integrity::valid_sha256_hex(manifest_digest) or not Integrity::valid_sha256_hex(lock_digest) or not Integrity::valid_sha256_hex(archive_digest)
            receipt: mutable darray[u8] = []
            ByteText::append_bounded_text(&receipt, "elisapkg-package-receipt:1\nname:")
            ByteText::append(&receipt, name)
            ByteText::append_bounded_text(&receipt, "\nversion:")
            ByteText::append(&receipt, version)
            ByteText::append_bounded_text(&receipt, "\nmanifest-digest:sha256:")
            ByteText::append(&receipt, manifest_digest)
            ByteText::append_bounded_text(&receipt, "\nlock-digest:sha256:")
            ByteText::append(&receipt, lock_digest)
            ByteText::append_bounded_text(&receipt, "\narchive-digest:sha256:")
            ByteText::append(&receipt, archive_digest)
            ByteText::append_bounded_text(&receipt, "\n")
            return [] if receipt.count > maximum_encode
            return receipt

    private:
        def valid_version(value: darray[u8]&) -> bool:
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return PackageIdentity::parse_version(value, &parsed)
