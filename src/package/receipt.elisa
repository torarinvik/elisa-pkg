# Canonical receipt for a locally built source archive.

include "./model.elisa"
include "./package_identity.elisa"
include "../integrity.elisa"

module PackageReceipt:
    public:
        # Maximum package name, version, three SHA-256 digests, and receipt
        # labels occupy 493 bytes. Keep a small explicit margin for disk reads.
        const max_encode: usize = 512.usize()

        def encode(name: darray[u8]&, version: darray[u8]&, manifest_digest: darray[u8]&, lock_digest: darray[u8]&, archive_digest: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not PackageIdentity::valid_name(name) or not valid_version(version)
            return [] if not Integrity::valid_sha256_hex(manifest_digest) or not Integrity::valid_sha256_hex(lock_digest) or not Integrity::valid_sha256_hex(archive_digest)
            receipt: mutable darray[u8] = []
            append_text(&receipt, "elisapkg-package-receipt:1\nname:")
            append_bytes(&receipt, name)
            append_text(&receipt, "\nversion:")
            append_bytes(&receipt, version)
            append_text(&receipt, "\nmanifest-digest:sha256:")
            append_bytes(&receipt, manifest_digest)
            append_text(&receipt, "\nlock-digest:sha256:")
            append_bytes(&receipt, lock_digest)
            append_text(&receipt, "\narchive-digest:sha256:")
            append_bytes(&receipt, archive_digest)
            append_text(&receipt, "\n")
            return [] if receipt.count > max_encode
            return receipt

    private:
        def valid_version(value: darray[u8]&) -> bool:
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return PackageIdentity::parse_version(value, &parsed)

        def append_text(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            index: mutable usize = 0.usize()
            while index < 1048576.usize() |out, value, index|:
                byte: u8 = value[index].u8()
                return if byte == 0
                out.push(byte)
                index <- index + 1.usize()

        def append_bytes(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out.push(value[index])
