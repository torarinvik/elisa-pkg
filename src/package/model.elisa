# Public data contracts shared by command modules.
#
# These are intentionally small value types. They contain no filesystem handles,
# credentials, or unverified source bytes, which keeps trust-sensitive state out of
# the command-line layer.

module Model:
    public:
        struct Version:
            major: mutable u64
            minor: mutable u64
            patch: mutable u64
            prerelease: mutable bool

        struct CommandOptions:
            locked: mutable bool
            offline: mutable bool
            frozen: mutable bool
            json: mutable bool
            verbose: mutable bool
            profile: mutable cstr
            target_name: mutable cstr
            target_kind: mutable cstr
            update_name: mutable cstr

    private:
        # Reserved for future normalized dependency/source records. Keeping this
        # section explicit makes accidental public exposure of trust metadata harder.
        const schema_version: i64 = 1
