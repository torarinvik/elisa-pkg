# Target selection from the manifest's direct targets array.

include "../json.elisa"
include "./package_identity.elisa"
include "../text/bytes.elisa"

module ManifestTargets:
    private:
        def skip_target_separators(raw: darray[u8]&, start: usize, finish: usize) -> usize:
            requires start <= finish and finish <= raw.count
            ensure result >= start and result <= finish
            return while cursor < finish and (Json::is_whitespace(raw[cursor]) or raw[cursor] == 44) |cursor: usize = start| -> cursor:
                cursor <- cursor + 1.usize()

        def leaf_with_suffix(name: darray[u8]&, suffix: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            leaf: mutable darray[u8] = [name[item] for item in 0..<name.count]
            ByteText::append_text(&leaf, suffix)
            leaf

    public:
        def artifact_leaf(name: darray[u8]&, is_library: bool) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            leaf_with_suffix(name, ".o" if is_library else "")

        def receipt_leaf(name: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            leaf_with_suffix(name, ".receipt")

        const maximum_targets: usize = 4096.usize()

        def valid_kind(kind: darray[u8]&) -> bool:
            ByteText::equal_text(kind, "bin") or ByteText::equal_text(kind, "lib") or ByteText::equal_text(kind, "test")

        def select_target(raw: darray[u8]&, requested_name: cstr, requested_kind: cstr, name_out: mutable darray[u8]&, kind_out: mutable darray[u8]&, entry_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            name_out.resize(0)
            kind_out.resize(0)
            entry_out.resize(0)
            targets_start: usize = Json::root_value_offset(raw, "targets")
            return false if targets_start >= raw.count or raw[targets_start] != 91
            targets_end: usize = Json::array_end(raw, targets_start)
            return false if targets_end <= targets_start or targets_end >= raw.count
            kind_requested: bool = requested_kind[0].u8() != 0
            cursor: mutable usize = targets_start + 1.usize()
            while cursor < targets_end |name_requested: bool = requested_name[0].u8() != 0|:
                cursor <- skip_target_separators(raw, cursor, targets_end)
                break if cursor >= targets_end
                return false if raw[cursor] != 123
                object_end: usize = Json::object_end(raw, cursor)
                return false if object_end <= cursor or object_end >= targets_end
                name_start: mutable usize = 0
                name_end: mutable usize = 0
                kind_start: mutable usize = 0
                kind_end: mutable usize = 0
                entry_start: mutable usize = 0
                entry_end: mutable usize = 0
                return false if not:
                    Json::object_string_span(raw, cursor, object_end, "name", &name_start, &name_end)
                    Json::object_string_span(raw, cursor, object_end, "kind", &kind_start, &kind_end)
                    Json::object_string_span(raw, cursor, object_end, "entry", &entry_start, &entry_end)
                name_matches: bool = not name_requested or ByteText::range_equals_text(raw, name_start, name_end, requested_name)
                region kind_matches_scope:
                    kind_matches: bool = not kind_requested or ByteText::range_equals_text(raw, kind_start, kind_end, requested_kind)
                    if name_matches and kind_matches:
                        ByteText::append_range(name_out, raw, name_start, name_end)
                        ByteText::append_range(kind_out, raw, kind_start, kind_end)
                        ByteText::append_range(entry_out, raw, entry_start, entry_end)
                        return true
                cursor <- object_end + 1.usize()
            false

        # Path dependencies require exactly one library target.
        def unique_library_entry(raw: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            targets_start: usize = Json::root_value_offset(raw, "targets")
            return false if targets_start >= raw.count or raw[targets_start] != 91
            targets_end: usize = Json::array_end(raw, targets_start)
            return false if targets_end <= targets_start or targets_end >= raw.count
            found_library: mutable bool = false
            entry_start: mutable usize = 0
            entry_end: mutable usize = 0
            while cursor < targets_end |cursor: usize = targets_start + 1.usize()|:
                cursor <- skip_target_separators(raw, cursor, targets_end)
                break if cursor >= targets_end or raw[cursor] == 93
                return false if raw[cursor] != 123
                object_end: usize = Json::object_end(raw, cursor)
                return false if object_end <= cursor or object_end >= targets_end
                kind_start: mutable usize = 0
                region kind_end_scope:
                    kind_end: mutable usize = 0
                    return false if not Json::object_string_span(raw, cursor, object_end, "kind", &kind_start, &kind_end)
                    if ByteText::range_equals_text(raw, kind_start, kind_end, "lib"):
                        return false if found_library
                        found_library <- true
                        return false if not Json::object_string_span(raw, cursor, object_end, "entry", &entry_start, &entry_end)
                cursor <- object_end + 1.usize()
            return false if not found_library
            ByteText::append_range(out, raw, entry_start, entry_end)
            true

        def default_entry(raw: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            name: mutable darray[u8] = []
            kind: mutable darray[u8] = []
            select_target(raw, "", "", &name, &kind, out)

        # Plan cleanup without requiring target source files to still exist.
        def cleanup_output_leaves[@r](raw: darray[u8]&, out: mutable darray[darray[u8]]& @r) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if not Json::valid_document(raw) or not Json::unique_object_keys(raw)
            outputs: mutable darray[darray[u8]] @r = []
            targets_start: usize = Json::root_value_offset(raw, "targets")
            return false if targets_start >= raw.count or raw[targets_start] != 91
            targets_end: usize = Json::array_end(raw, targets_start)
            return false if targets_end <= targets_start or targets_end >= raw.count
            while cursor < targets_end |cursor: usize = targets_start + 1.usize()|:
                cursor <- skip_target_separators(raw, cursor, targets_end)
                break if cursor >= targets_end
                return false if raw[cursor] != 123 or outputs.count >= 2.usize() * maximum_targets
                object_end: usize = Json::object_end(raw, cursor)
                return false if object_end <= cursor or object_end >= targets_end
                target_name: mutable darray[u8] = []
                target_kind: mutable darray[u8] = []
                return false if not:
                    Json::object_string_value(raw, cursor, object_end, "name", &target_name)
                    Json::object_string_value(raw, cursor, object_end, "kind", &target_kind)
                    PackageIdentity::valid_name(target_name)
                    valid_kind(target_kind)
                outputs <- outputs.push(artifact_leaf(target_name, ByteText::equal_text(target_kind, "lib")))
                outputs <- outputs.push(receipt_leaf(target_name))
                cursor <- object_end + 1.usize()
            return false if outputs.count == 0.usize()
            out <- outputs
            true
