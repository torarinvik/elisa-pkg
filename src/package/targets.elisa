# Target selection from the manifest's direct targets array.

include "../json.elisa"
include "./package_identity.elisa"
include "../text/bytes.elisa"

module ManifestTargets:
    private:
        def leaf_with_suffix(name: darray[u8]&, suffix: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            leaf: mutable darray[u8] = []
            ByteText::append(&leaf, name)
            ByteText::append_text(&leaf, suffix)
            return leaf

    public:
        def artifact_leaf(name: darray[u8]&, is_library: bool) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return leaf_with_suffix(name, ".o" if is_library else "")

        def receipt_leaf(name: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return leaf_with_suffix(name, ".receipt")

        const max_targets: usize = 4096.usize()

        def select_target(raw: darray[u8]&, requested_name: cstr, requested_kind: cstr, name_out: mutable darray[u8]&, kind_out: mutable darray[u8]&, entry_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            name_out.resize(0)
            kind_out.resize(0)
            entry_out.resize(0)
            targets_start: usize = Json::root_value_offset(raw, "targets")
            return false if targets_start >= raw.count or raw[targets_start] != 91
            targets_end: usize = Json::array_end(raw, targets_start)
            return false if targets_end <= targets_start or targets_end >= raw.count
            name_requested: bool = requested_name[0].u8() != 0
            kind_requested: bool = requested_kind[0].u8() != 0
            cursor: mutable usize = targets_start + 1.usize()
            while cursor < targets_end:
                while cursor < targets_end and ((raw[cursor] == 32) or (raw[cursor] == 9) or (raw[cursor] == 10) or (raw[cursor] == 13) or (raw[cursor] == 44)):
                    cursor <- cursor + 1.usize()
                break if cursor >= targets_end
                return false if raw[cursor] != 123
                object_end: usize = Json::object_end(raw, cursor)
                return false if object_end <= cursor or object_end >= targets_end
                candidate_name: mutable darray[u8] = []
                candidate_kind: mutable darray[u8] = []
                candidate_entry: mutable darray[u8] = []
                return false if not Json::object_string_value(raw, cursor, object_end, "name", &candidate_name) or not Json::object_string_value(raw, cursor, object_end, "kind", &candidate_kind) or not Json::object_string_value(raw, cursor, object_end, "entry", &candidate_entry)
                name_matches: bool = not name_requested or ByteText::equal_text(candidate_name, requested_name)
                kind_matches: bool = not kind_requested or ByteText::equal_text(candidate_kind, requested_kind)
                if name_matches and kind_matches:
                    ByteText::append(name_out, candidate_name)
                    ByteText::append(kind_out, candidate_kind)
                    ByteText::append(entry_out, candidate_entry)
                    return true
                cursor <- object_end + 1.usize()
            return false

        # Path dependencies require exactly one library target.
        def unique_library_entry(raw: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            targets_start: usize = Json::root_value_offset(raw, "targets")
            return false if targets_start >= raw.count or raw[targets_start] != 91
            targets_end: usize = Json::array_end(raw, targets_start)
            return false if targets_end <= targets_start or targets_end >= raw.count
            cursor: mutable usize = targets_start + 1.usize()
            found_library: mutable bool = false
            selected_entry: mutable darray[u8] = []
            while cursor < targets_end:
                while cursor < targets_end and (Json::is_whitespace(raw[cursor]) or raw[cursor] == 44):
                    cursor <- cursor + 1.usize()
                break if cursor >= targets_end or raw[cursor] == 93
                return false if raw[cursor] != 123
                object_end: usize = Json::object_end(raw, cursor)
                return false if object_end <= cursor or object_end >= targets_end
                kind: mutable darray[u8] = []
                if not Json::object_string_value(raw, cursor, object_end, "kind", &kind):
                    return false
                if ByteText::equal_text(kind, "lib"):
                    return false if found_library
                    found_library <- true
                    return false if not Json::object_string_value(raw, cursor, object_end, "entry", &selected_entry)
                cursor <- object_end + 1.usize()
            return false if not found_library
            ByteText::append(out, selected_entry)
            return true

        def default_entry(raw: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            name: mutable darray[u8] = []
            kind: mutable darray[u8] = []
            return select_target(raw, "", "", &name, &kind, out)

        # Plan cleanup without requiring target source files to still exist.
        def cleanup_output_leaves(raw: darray[u8]&, out: mutable darray[darray[u8]]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if not Json::valid_document(raw) or not Json::unique_object_keys(raw)
            outputs: mutable darray[darray[u8]] = []
            targets_start: usize = Json::root_value_offset(raw, "targets")
            return false if targets_start >= raw.count or raw[targets_start] != 91
            targets_end: usize = Json::array_end(raw, targets_start)
            return false if targets_end <= targets_start or targets_end >= raw.count
            cursor: mutable usize = targets_start + 1.usize()
            while cursor < targets_end:
                while cursor < targets_end and (Json::is_whitespace(raw[cursor]) or raw[cursor] == 44):
                    cursor <- cursor + 1.usize()
                break if cursor >= targets_end
                return false if raw[cursor] != 123 or outputs.count >= 2.usize() * max_targets
                object_end: usize = Json::object_end(raw, cursor)
                return false if object_end <= cursor or object_end >= targets_end
                target_name: mutable darray[u8] = []
                target_kind: mutable darray[u8] = []
                return false if not:
                    Json::object_string_value(raw, cursor, object_end, "name", &target_name)
                    Json::object_string_value(raw, cursor, object_end, "kind", &target_kind)
                    PackageIdentity::valid_name(target_name)
                    ByteText::equal_text(target_kind, "bin") or ByteText::equal_text(target_kind, "lib") or ByteText::equal_text(target_kind, "test")
                outputs.push(artifact_leaf(target_name, ByteText::equal_text(target_kind, "lib")))
                outputs.push(receipt_leaf(target_name))
                cursor <- object_end + 1.usize()
            return false if outputs.count == 0.usize()
            for output_index in 0..<outputs.count |out, outputs|:
                out.push([])
                for byte_index in 0..<outputs[output_index].count |out, outputs, output_index|:
                    out[output_index].push(outputs[output_index][byte_index])
            return true
