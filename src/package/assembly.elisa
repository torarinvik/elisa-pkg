# Select and package files from the current project directory.
include "../archive.elisa"
include "../cache.elisa"
include "../cli/output.elisa"
include "../integrity.elisa"
include "../json.elisa"
include "../package_path_policy.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../source/fingerprint.elisa"
include "../text/bytes.elisa"
include "./receipt.elisa"
include "./selection.elisa"

module PackageAssembly:
    public:
        const enum Code of u8:
            Ok
            SecurityFailure
            OutputFailure

        def collect_paths(raw: darray[u8]&, target: darray[u8]&, out: mutable darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global.Read:
                out.resize(0)
                if not select_paths(raw, target, out):
                    out.resize(0)
                    return false
                return true

        def archive_bytes(raw: darray[u8]&, target: darray[u8]&, out: mutable darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global.Read:
                out.resize(0)
                paths: mutable darray[u8] = []
                return false if not collect_paths(raw, target, &paths)
                return Archive::write_ustar_from_paths(paths, out)

        # Call after the CLI validates that the lock matches the manifest and tree.
        def write_outputs(start: darray[u8]&, raw: darray[u8]&, lock_raw: darray[u8]&, entry: darray[u8]&, package_name: darray[u8]&, package_version: darray[u8]&, manifest_digest: darray[u8]&, lock_digest: darray[u8]&) -> Code can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                package_source_digest: mutable darray[u8] = []
                return Code.SecurityFailure if not SourceFingerprint::current(&package_source_digest)
                region state_root_scope:
                    state_root: mutable darray[u8] = []
                    ByteText::append_text(&state_root, ".elisapkg")
                    return Code.OutputFailure if not ProjectFiles::make_directory(&state_root)
                archive: mutable darray[u8] = []
                region build_status_scope:
                    build_status: Code = build_verified_archive(raw, lock_raw, entry, package_source_digest, &archive)
                    return build_status if build_status != Code.Ok
                archive_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(start, ".elisapkg/package.tar", &archive_path)
                receipt_path: mutable darray[u8] = []
                ProjectFiles::path_join_into(start, ".elisapkg/package.receipt", &receipt_path)
                return Code.OutputFailure if not ProjectFiles::replace_file(archive_path, &archive)
                persisted_archive: mutable darray[u8] = []
                return Code.OutputFailure if not Platform::read_bounded_file(archive_path, Integrity::maximum_input, &persisted_archive)
                # The receipt and cache identify the bytes that remain at the
                # published path. Refuse a pathname replacement between the
                # atomic write and this read unless it still matches the exact tar
                # that passed the in-memory archive verifier.
                return Code.OutputFailure if not ByteText::equal(persisted_archive, archive)
                digest: mutable darray[u8] = []
                return Code.OutputFailure if not Integrity::sha256_hex(persisted_archive, &digest)
                return Code.OutputFailure if not publish_to_cache(archive_path, digest)
                region receipt_scope:
                    receipt: darray[u8] = PackageReceipt::encode(package_name, package_version, manifest_digest, lock_digest, digest)
                    return Code.OutputFailure if receipt.count == 0.usize()
                    return Code.OutputFailure if not ProjectFiles::replace_file(receipt_path, receipt)
                report_packaged(package_name, package_version, archive_path, digest)
                return Code.Ok

    private:
        # Build the package archive, then confirm the source tree, manifest,
        # and lock did not change while it was built. Manifest and lock bytes
        # are excluded from the source-tree digest because their dedicated
        # receipt fields would otherwise be self-referential, so both are
        # re-read to keep a concurrent edit from publishing a mixed archive
        # under the earlier identity.
        def build_verified_archive(raw: darray[u8]&, lock_raw: darray[u8]&, entry: darray[u8]&, package_source_digest: darray[u8]&, archive: mutable darray[u8]&) -> Code can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                return Code.OutputFailure if not archive_bytes(raw, entry, archive)
                region package_source_digest_after_scope:
                    package_source_digest_after: mutable darray[u8] = []
                    return Code.OutputFailure if not SourceFingerprint::current(&package_source_digest_after) or not ByteText::equal(package_source_digest_after, package_source_digest)
                # Manifest and lock bytes are excluded from the source-tree digest
                # because their dedicated receipt fields would otherwise be
                # self-referential. Re-read both inputs after archive creation so a
                # concurrent edit cannot publish a mixed archive under the earlier
                # identity.
                manifest_after: mutable darray[u8] = []
                manifest_after <- manifest_after.resize(ProjectFiles::project_document_limit)
                region lock_after_scope:
                    lock_after: mutable darray[u8] = []
                    lock_after <- lock_after.resize(ProjectFiles::project_document_limit)
                    return Code.OutputFailure if not ProjectFiles::read_c_string_into("elisapkg.json", &manifest_after) or not ProjectFiles::read_c_string_into("elisapkg.lock", &lock_after)
                    return Code.SecurityFailure if not ByteText::equal(manifest_after, raw) or not ByteText::equal(lock_after, lock_raw)
                return Code.OutputFailure if not Archive::verify_ustar_archive(archive)
                return Code.Ok

        # Link the published archive into the content-addressed cache,
        # quarantining a corrupt existing blob, and make the link durable.
        def publish_to_cache(archive_path: darray[u8]&, digest: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            blob_path: mutable darray[u8] = []
            return false if not Cache::blob_path(digest, &blob_path)
            region cache_parent_scope:
                cache_parent: mutable darray[u8] = []
                return false if:
                    not Cache::shard_path(digest, &cache_parent)
                    not ProjectFiles::make_directory(&cache_parent)
            blob_name_c: mutable darray[u8] = []
            archive_source_c: mutable darray[u8] = []
            quarantine_parent: mutable darray[u8] = []
            blob_name_c <- ProjectFiles::with_null_terminator(&blob_path)
            archive_source_c <- ProjectFiles::with_null_terminator(archive_path)
            ByteText::append_text(&quarantine_parent, Cache::quarantine_directory)
            blob_name: cstr = (&blob_name_c[0]).cast[cstr] can Unsafe.PointerCast
            region archive_source_name_scope:
                archive_source_name: cstr = (&archive_source_c[0]).cast[cstr] can Unsafe.PointerCast
                if ProjectFiles::c_string_file_exists(blob_name):
                    if not Cache::verify_blob(digest):
                        return false if:
                            not ProjectFiles::make_directory(&quarantine_parent)
                            not Cache::quarantine_blob(digest)
                            Platform::create_hard_link(archive_source_name, blob_name) != 0
                elif Platform::create_hard_link(archive_source_name, blob_name) != 0:
                    return false if not ProjectFiles::c_string_file_exists(blob_name) or not Cache::verify_blob(digest)
            # Revalidate after every publication path. A concurrent rename can change
            # a pathname after the initial existence check; the receipt is written only
            # once the final cache bytes still match the in-memory archive digest. The
            # parent flush makes the hard-link durable before the receipt can claim it.
            return Platform::synchronize_parent_directory(blob_name) == 0 and Cache::verify_blob(digest)

        def report_packaged(package_name: darray[u8]&, package_version: darray[u8]&, archive_path: darray[u8]&, digest: darray[u8]&) -> void can[Global.Read, Console.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            can Global.Read:
                CliOutput::write_ok("packaged ")
                CliOutput::write_bytes(1, package_name)
                CliOutput::write_ok(" ")
                CliOutput::write_bytes(1, package_version)
                CliOutput::write_ok(" -> ")
                CliOutput::write_bytes(1, archive_path)
                CliOutput::write_ok(" sha256:")
                CliOutput::write_bytes(1, digest)
                CliOutput::write_ok("\n")

        def select_paths(raw: darray[u8]&, target: darray[u8]&, out: mutable darray[u8]&) -> bool can[Global.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            can Global.Read:
                resolved_root: mutable darray[u8] = []
                resolved_root <- resolved_root.resize(4096)
                root_real_name: mutable cstr = ""
                if Platform::resolve_real_path(".", &resolved_root) is canonical_root:
                    root_real_name <- canonical_root
                else:
                    return false
                region root_policy_path_scope:
                    root_policy_path: mutable darray[u8] = []
                    ByteText::append_bounded_text(&root_policy_path, root_real_name)
                    root_policy_path <- root_policy_path.push(0)
                    return false if PackagePathPolicy::credential_root_forbidden(root_policy_path)
                buffer: mutable darray[u8] = []
                buffer <- buffer.resize(8388608)
                collected: i64 =
                    buffer_raw: mutable u8& = (&buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
                    Platform::collect_files(".", buffer_raw, buffer.count)
                return false if collected < 0
                selected: mutable usize = 0.usize()
                target_found: mutable bool = false
                include_start: usize = Json::root_value_offset(raw, "include")
                include_end: usize = Json::array_end(raw, include_start) if include_start < raw.count else raw.count
                exclude_start: usize = Json::root_value_offset(raw, "exclude")
                exclude_end: usize = Json::array_end(raw, exclude_start) if exclude_start < raw.count else raw.count
                return false if not:
                    PackageSelection::valid_pattern_range(raw, include_start, include_end)
                    PackageSelection::valid_pattern_range(raw, exclude_start, exclude_end)
                glob_work_remaining: mutable usize = PackageSelection::maximum_work
                glob_rows_remaining: mutable usize = PackageSelection::maximum_rows
                glob_budget_exhausted: mutable bool = false
                while cursor < collected.usize() |cursor: usize = 0.usize()|:
                    path: mutable darray[u8] = []
                    while cursor < collected.usize() and buffer[cursor] != 0 |buffer, cursor, path|:
                        path <- path.push(buffer[cursor])
                        cursor <- cursor + 1.usize()
                    return false if cursor >= collected.usize()
                    cursor <- cursor + 1.usize()
                    return false if path.count == 0.usize() or PackageSelection::publish_path_forbidden(path)
                    required: bool = ByteText::equal_text(path, "elisapkg.json") or ByteText::equal_text(path, "elisapkg.lock")
                    include_selected: mutable bool = required or PackageSelection::include_allows_path(raw, include_start, include_end, path, &glob_work_remaining, &glob_rows_remaining, &glob_budget_exhausted)
                    if glob_budget_exhausted:
                        CliOutput::write_error("error: package include/exclude patterns exceeded the bounded matching budget\n")
                        return false
                    if include_selected and not required and PackageSelection::exclude_allows_path(raw, exclude_start, exclude_end, path, &glob_work_remaining, &glob_rows_remaining, &glob_budget_exhausted):
                        include_selected <- false
                    if glob_budget_exhausted:
                        CliOutput::write_error("error: package include/exclude patterns exceeded the bounded matching budget\n")
                        return false
                    if include_selected:
                        return false if selected >= PackagePathPolicy::maximum_package_archive_entries
                        for index in 0..<path.count |out, path|:
                            out.push(path[index])
                        out.push(0)
                        selected <- selected + 1.usize()
                        target_found <- true if ByteText::equal(path, target)
                return selected > 0.usize() and target_found
