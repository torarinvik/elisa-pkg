# Byte-level ustar encoding and validation.

module UstarFields:
    private:
        const block_size: usize = 512.usize()
        const mode_offset: usize = 100.usize()
        const owner_offset: usize = 108.usize()
        const group_offset: usize = 116.usize()
        const size_offset: usize = 124.usize()
        const modified_time_offset: usize = 136.usize()
        const checksum_offset: usize = 148.usize()
        const type_offset: usize = 156.usize()
        const magic_offset: usize = 257.usize()

        law WithinBlock(self: usize) = self < 512.usize()

        def archive_header_shape(archive: darray[u8]&, offset: usize) -> bool:
            return false if offset > archive.count or archive.count - offset < block_size
            return archive[offset + magic_offset] == 117 and archive[offset + magic_offset + 1.usize()] == 115 and archive[offset + magic_offset + 2.usize()] == 116 and archive[offset + magic_offset + 3.usize()] == 97 and archive[offset + magic_offset + 4.usize()] == 114 and archive[offset + magic_offset + 5.usize()] == 0 and archive[offset + magic_offset + 6.usize()] == 48 and archive[offset + magic_offset + 7.usize()] == 48 and archive[offset + type_offset] == 48

        def archive_metadata_zero(archive: darray[u8]&, offset: usize, name_length: usize) -> bool:
            return false if:
                offset > archive.count or archive.count - offset < block_size or name_length >= 100.usize()
                not archive_range_zero(archive, offset + name_length + 1.usize(), 100.usize() - name_length - 1.usize())
                not archive_range_zero(archive, offset + 157.usize(), 100.usize())
                not archive_range_zero(archive, offset + 265.usize(), 80.usize())
                not archive_range_zero(archive, offset + 345.usize(), 155.usize())
            return archive_range_zero(archive, offset + 500.usize(), 12.usize())

        def parse_octal_raw(value: darray[u8]&, offset: usize, width: usize, out: mutable usize&) -> bool:
            out <- 0.usize()
            return false if width < 2.usize() or offset > value.count or width > value.count - offset
            finish: usize = offset + width
            cursor, parsed =
                while cursor < finish and value[cursor] >= 48 and value[cursor] <= 55 |cursor: usize = offset, parsed: usize = 0| -> (cursor, parsed):
                    digit: usize = (value[cursor] - 48).usize()
                    return false if parsed > (18446744073709551615.usize() - digit) / 8.usize()
                    parsed <- parsed * 8.usize() + digit
                    cursor <- cursor + 1.usize()
            return false if cursor == offset or cursor >= finish
            for padding_index in cursor..<finish:
                return false if value[padding_index] != 0 and value[padding_index] != 32
            out <- parsed
            return true

        def archive_range_zero(archive: darray[u8]&, offset: usize, length: usize) -> bool:
            return false if offset > archive.count or length > archive.count - offset
            for index in 0..<length |archive, offset|:
                return false if archive[offset + index] != 0
            return true

        # Callers provide one complete header.
        def header_checksum(archive: darray[u8]&, offset: usize) -> usize:
            return for index in 0..<block_size |checksum: usize = 0| -> checksum:
                checksum <- checksum + (32.usize() if index >= checksum_offset and index < type_offset else archive[offset + index].usize())

        def write_octal(header: mutable darray[u8]&, offset: usize, value: usize, width: usize) -> void:
            return if width == 0.usize()
            divisor: mutable usize = 1.usize()
            for _step in 1..<(width - 1.usize()) |divisor|:
                divisor <- divisor * 8.usize()
            for step in 0..<(width - 1.usize()) |header, offset, width, value, divisor, step|:
                header[offset + step] <- 48 + ((value / divisor) % 8.usize()).u8()
                divisor <- divisor / 8.usize() if divisor > 1.usize()
            header[offset + width - 1.usize()] <- 0

    public:
        const max_archive_bytes: usize = 67108864.usize()
        # Reserve one entry header and both end-of-archive blocks.
        const max_payload_bytes: usize = max_archive_bytes - 3.usize() * block_size

        # ustar's name field is intentionally bounded. Long-name/PAX/GNU
        # extensions are rejected until their canonical semantics have a
        # dedicated parser and test corpus.
        def tar_file_header(entry: darray[u8]&, size: usize) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not safe_relative_path(entry) or entry.count >= 100.usize() or size > max_payload_bytes
            header: darray[u8] =
                header: mutable darray[u8] = []
                header <- header.resize(block_size)
                for index in 0..<entry.count |header, entry|:
                    header[index] <- entry[index]
                write_octal(&header, mode_offset, 420, 8)
                write_octal(&header, owner_offset, 0, 8)
                write_octal(&header, group_offset, 0, 8)
                write_octal(&header, size_offset, size, 12)
                write_octal(&header, modified_time_offset, 0, 12)
                header[type_offset] <- 48
                header[magic_offset] <- 117
                header[magic_offset + 1.usize()] <- 115
                header[magic_offset + 2.usize()] <- 116
                header[magic_offset + 3.usize()] <- 97
                header[magic_offset + 4.usize()] <- 114
                header[magic_offset + 5.usize()] <- 0
                header[magic_offset + 6.usize()] <- 48
                header[magic_offset + 7.usize()] <- 48
                checksum: usize = header_checksum(header, 0.usize())
                write_octal(&header, checksum_offset, checksum, 7)
                header[154] <- 0
                header[155] <- 32
                header
            return header

        def padding_bytes(payload_size: usize) -> usize is WithinBlock:
            ensure (payload_size % block_size + result) % block_size == 0.usize()
            return (block_size - payload_size % block_size) % block_size

        def archive_block_zero(archive: darray[u8]&, offset: usize) -> bool:
            return archive_range_zero(archive, offset, block_size)

        # Return the normalized header's payload size, or -1 on rejection.
        def normalized_payload_size(archive: darray[u8]&, offset: usize, name_length: usize) -> i64:
            return -1 if:
                not archive_header_shape(archive, offset)
                not archive_metadata_zero(archive, offset, name_length)
            mode: mutable usize = 0.usize()
            uid: mutable usize = 0.usize()
            gid: mutable usize = 0.usize()
            size: mutable usize = 0.usize()
            mtime: mutable usize = 0.usize()
            stored_checksum: mutable usize = 0.usize()
            return -1 if:
                not parse_octal_raw(archive, offset + mode_offset, 8.usize(), &mode)
                not parse_octal_raw(archive, offset + owner_offset, 8.usize(), &uid)
                not parse_octal_raw(archive, offset + group_offset, 8.usize(), &gid)
                not parse_octal_raw(archive, offset + size_offset, 12.usize(), &size)
                not parse_octal_raw(archive, offset + modified_time_offset, 12.usize(), &mtime)
                not parse_octal_raw(archive, offset + checksum_offset, 8.usize(), &stored_checksum)
            return -1 if mode != 420.usize() or uid != 0.usize() or gid != 0.usize() or mtime != 0.usize() or size > max_payload_bytes
            return size.i64() if header_checksum(archive, offset) == stored_checksum else -1

        # Return zero if the payload is truncated or its alignment padding
        # is invalid. A valid entry always advances by at least one block.
        def next_entry_offset(archive: darray[u8]&, header_offset: usize, payload_size: usize) -> usize:
            return 0.usize() if header_offset > archive.count or archive.count - header_offset < block_size
            payload_start: usize = header_offset + block_size
            return 0.usize() if payload_size > archive.count - payload_start
            payload_end: usize = payload_start + payload_size
            padding: usize = padding_bytes(payload_size)
            return 0.usize() if not archive_range_zero(archive, payload_end, padding)
            return payload_end + padding

        def safe_relative_path(name: darray[u8]&) -> bool:
            return false if name.count == 0.usize() or name.count > 4096.usize()
            segment_start: mutable usize = 0.usize()
            for index in 0..=name.count |name, segment_start|:
                if index < name.count and name[index] != 47:
                    return false if name[index] < 32 or name[index] >= 127 or name[index] == 92 or name[index] == 58
                    continue
                segment_length: usize = index - segment_start
                return false if segment_length == 0.usize() or segment_length == 1.usize() and name[segment_start] == 46 or segment_length == 2.usize() and name[segment_start] == 46 and name[segment_start + 1.usize()] == 46
                segment_start <- index + 1.usize()
            return true

        def archive_name_seen(seen: darray[u8]&, wanted: darray[u8]&) -> bool:
            cursor: mutable usize = 0.usize()
            while cursor < seen.count:
                end: usize =
                    while end < seen.count and seen[end] != 0 |end: usize = cursor| -> end:
                        end <- end + 1.usize()
                common: usize = end - cursor if end - cursor < wanted.count else wanted.count
                matches: mutable bool = true
                for index in 0..<common |seen, wanted, cursor, matches|:
                    left: mutable u8 = seen[cursor + index]
                    right: mutable u8 = wanted[index]
                    left <- left + 32 if left >= 65 and left <= 90
                    right <- right + 32 if right >= 65 and right <= 90
                    matches <- false if left != right
                if matches:
                    return true if end - cursor == wanted.count or common < wanted.count and wanted[common] == 47 or common < end - cursor and seen[cursor + common] == 47
                cursor <- end + 1.usize()
            return false
