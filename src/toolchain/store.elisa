# The per-user toolchain store in `lang/elisac` of the elisapkg home.
#
# Each toolchain has its own directory, `lang/elisac/NAME`, holding a record
# file `toolchain` that names the compiler wrapper, Stage1 executable, and
# runtime object a build uses. `lang/settings.json` names the toolchain builds
# select when no compiler is configured through the environment. Files are
# published atomically and read only through trusted, no-follow walks.
include "../json.elisa"
include "../platform.elisa"
include "../platform/path_order.elisa"
include "../project/files.elisa"
include "../registry/files.elisa"
include "../state/user_data.elisa"
include "../text/bytes.elisa"

module ToolchainStore:
    public:
        # The files one toolchain provides to a build, as absolute paths.
        struct Record:
            kind: darray[u8]
            compiler: darray[u8]
            stage1: darray[u8]
            runtime: darray[u8]

        const maximum_record_bytes: usize = 16384.usize()
        const maximum_path_bytes: usize = 4000.usize()
        const maximum_toolchains: usize = 256.usize()

        # The store directory when it exists and is trusted.
        def existing_directory(out: mutable darray[u8]&) -> UserData::DirectoryState can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            UserData::existing("lang/elisac", out)

        # The store directory, created with every missing parent, or empty
        # when any directory on the way is missing or untrusted.
        def prepared_directory() -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            UserData::prepare("lang/elisac")

        # A toolchain name: 1 to 64 bytes of lowercase ASCII letters, digits,
        # `.`, `_`, and `-`, starting with a letter or digit.
        def valid_name(name: darray[u8]&) -> bool:
            return false if name.count == 0.usize() or name.count > 64.usize()
            for index in 0..<name.count |valid: bool = true| -> valid:
                byte: u8 = name[index]
                letter_or_digit: bool = byte >= 97 and byte <= 122 or byte >= 48 and byte <= 57
                break false if not letter_or_digit and (index == 0.usize() or byte != 46 and byte != 95 and byte != 45)

        # The record of a linked compiler checkout at the canonical `root`.
        def linked_checkout(root: darray[u8]&) -> Record can[Memory.Allocate, Abort.Panic]:
            requires root.count > 0
            Record{kind: ByteText::with_text([], "link"),
                   compiler: ProjectFiles::path_join(root, "scripts/elisac_stage1.sh"),
                   stage1: ProjectFiles::path_join(root, "bin/elisac-stage1"),
                   runtime: ProjectFiles::path_join(root, "build/runtime/elisacore_runtime.o")}

        def encode(record: Record&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            ByteText::with_text(ByteText::with_bytes(ByteText::with_text(ByteText::with_bytes(ByteText::with_text(ByteText::with_bytes(ByteText::with_text(
                ByteText::with_bytes(ByteText::with_text([], "elisapkg-toolchain=1\nkind="), record.kind),
                "\ncompiler="), record.compiler), "\nstage1="), record.stage1), "\nruntime="), record.runtime), "\n")

        # Parse a record written by `encode`. Every field must be present in
        # order, and every path must be absolute and free of control bytes.
        def decode(raw: darray[u8]&, out: mutable Record&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if raw.count <= header_bytes or raw.count > maximum_record_bytes or not ByteText::range_equals_text(raw, 0.usize(), header_bytes, "elisapkg-toolchain=1\n")
            runtime_end: usize = read_field(raw, read_field(raw, read_field(raw, read_field(raw, header_bytes, "kind=", &out.kind) + 1.usize(), "compiler=", &out.compiler) + 1.usize(), "stage1=", &out.stage1) + 1.usize(), "runtime=", &out.runtime)
            runtime_end + 1.usize() == raw.count and ByteText::equal_text(out.kind, "link") and valid_path(out.compiler) and valid_path(out.stage1) and valid_path(out.runtime)

        # Read the record of `name`. Returns 0, -2 when it does not exist, or
        # another negative status for an unreadable or malformed record.
        def read(directory: darray[u8]&, name: darray[u8]&, out: mutable Record&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            requires directory.count > 0
            return -22 if not valid_name(name)
            raw: mutable darray[u8] = []
            loaded: i64 = RegistryFiles::read_trusted_file(record_path(directory, name), maximum_record_bytes, &raw)
            loaded if loaded < 0 else 0 if decode(raw, out) else -74

        # Create the directory of `name` and publish its record. Returns 0,
        # -17 when `name` already exists, or another negative status.
        def publish_new(directory: darray[u8]&, name: darray[u8]&, record: Record&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            requires directory.count > 0
            return -22 if not valid_name(name)
            toolchain_path: darray[u8] = ProjectFiles::path_join_bytes(directory, name)
            created: i64 =
                toolchain_c: darray[u8] = ProjectFiles::with_null_terminator(toolchain_path)
                toolchain_name: cstr = (&toolchain_c[0]).cast[cstr] can Unsafe.PointerCast
                made: i64 = Platform::make_directory(toolchain_name, 448.u16())
                made if made != 0 else Platform::synchronize_parent_directory(toolchain_name)
            if created != 0:
                created
            else:
                published: i64 = ProjectFiles::publish_file_exclusively(record_path(directory, name), encode(record))
                # Never leave an empty toolchain directory behind a failed publish.
                _ = ProjectFiles::remove_empty_directory(toolchain_path) if published != 0 else true
                published

        # Whether any directory entry, readable or not, has the name `name`.
        def exists(directory: darray[u8]&, name: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            requires directory.count > 0
            valid_name(name) and ProjectFiles::path_occupied(ProjectFiles::path_join_bytes(directory, name))

        # Remove the record of `name` and then its directory, which must be
        # empty. Any other entry with that name, such as a symlink, is
        # removed itself and never followed.
        def remove(directory: darray[u8]&, name: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            requires directory.count > 0
            return false if not valid_name(name)
            toolchain_path: darray[u8] = ProjectFiles::path_join_bytes(directory, name)
            toolchain_c: darray[u8] = ProjectFiles::with_null_terminator(toolchain_path)
            toolchain_name: cstr = (&toolchain_c[0]).cast[cstr] can Unsafe.PointerCast
            if Platform::trusted_directory_status(toolchain_name) == 0:
                ProjectFiles::remove_known_file(record_path(directory, name)) and ProjectFiles::remove_empty_directory(toolchain_path)
            else:
                Platform::unlink_path(toolchain_name) == 0

        # Read the `default-toolchain` setting. Returns 0, -2 when no default
        # is set, or another negative status for unreadable settings.
        def read_default(directory: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            requires directory.count > 0
            out.resize(0)
            raw: mutable darray[u8] = []
            loaded: i64 = RegistryFiles::read_trusted_file(settings_path(directory), maximum_settings_bytes, &raw)
            valid: bool = loaded >= 0 and Json::valid_document(raw) and Json::unique_object_keys(raw)
            object_start: usize = Json::root_start(raw)
            object_finish: usize = Json::root_object_end(raw, object_start) if valid else raw.count
            if loaded < 0:
                loaded
            elif not valid or object_finish == raw.count or raw[object_start] != 123:
                -74
            elif not Json::object_has_key(raw, object_start, object_finish, "default-toolchain"):
                -2
            else:
                0 if Json::object_string_value(raw, object_start, object_finish, "default-toolchain", out) and valid_name(out) else -74

        # Make `name` the `default-toolchain` setting. The settings file holds
        # no other setting yet, so it is rewritten whole.
        def write_default(directory: darray[u8]&, name: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            requires directory.count > 0
            valid_name(name) and ProjectFiles::replace_file(settings_path(directory), ByteText::with_text(ByteText::with_bytes(ByteText::with_text([], "{\n  \"default-toolchain\": \""), name), "\"\n}\n"))

        def clear_default(directory: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            requires directory.count > 0
            ProjectFiles::remove_known_file(settings_path(directory))

        # The toolchain names in `directory`, in byte order. Entries
        # that are not valid names are skipped. Clears `readable` for an
        # unreadable directory or more than `maximum_toolchains` entries.
        def names(directory: darray[u8]&, readable: mutable bool&) -> darray[darray[u8]] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            requires directory.count > 0
            listing: mutable darray[u8] = []
            listing <- listing.resize(262144)
            collected: i64 =
                directory_c: darray[u8] = ProjectFiles::with_null_terminator(directory)
                listing_raw: mutable u8& = (&listing[0]).cast[mutable u8&] can Unsafe.PointerCast
                Platform::list_entry_names(((&directory_c[0]).cast[cstr] can Unsafe.PointerCast), listing_raw, listing.count)
            if collected < 0:
                readable <- false
                []
            else:
                listed: darray[darray[u8]] = while cursor < collected.usize() |listing, cursor: usize = 0.usize(), entry_start: usize = 0.usize(), found: darray[darray[u8]] = []| -> found:
                    entry_start <- cursor
                    while cursor < collected.usize() and listing[cursor] != 0 |listing, cursor|:
                        cursor <- cursor + 1.usize()
                    cursor <- cursor + 1.usize()
                    name: darray[u8] = ByteText::with_range([], listing, entry_start, cursor - 1.usize())
                    found <- found.push(name) if valid_name(name)
                readable <- listed.count <= maximum_toolchains
                ordered: mutable darray[usize] = [index for index in 0..<listed.count]
                CollectedPathOrder::sort_indices(&ordered, listed)
                [listed[ordered[index]].clone() for index in 0..<ordered.count]

    private:
        const maximum_settings_bytes: usize = 65536.usize()

        # "DIRECTORY/NAME/toolchain".
        def record_path(directory: darray[u8]&, name: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            ProjectFiles::path_join(ProjectFiles::path_join_bytes(directory, name), "toolchain")

        # "settings.json" beside the store directory, in `lang`.
        def settings_path(directory: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            parent_end: usize = for index in 0..<directory.count |parent_end: usize = 0.usize()| -> parent_end:
                parent_end <- index if directory[index] == 47
            ProjectFiles::path_join(ByteText::with_range([], directory, 0.usize(), parent_end), "settings.json")

        const header_bytes: usize = 21.usize()

        # Read the value of the `key=value` line starting at `start` into
        # `value`. Returns the offset of the line's newline, or the record
        # length when the line is missing, has another key, or is unterminated.
        def read_field(raw: darray[u8]&, start: usize, key: cstr, value: mutable darray[u8]&) -> usize can[Memory.Allocate, Abort.Panic]:
            value.resize(0)
            value_start: usize = start + Platform::c_string_length(key)
            if value_start > raw.count or not ByteText::range_equals_text(raw, start, value_start, key):
                raw.count
            else:
                line_end: usize = for index in value_start..<raw.count |found: usize = raw.count| -> found:
                    break index if raw[index] == 10
                ByteText::append_range(value, raw, value_start, line_end)
                line_end

        def valid_path(path: darray[u8]&) -> bool:
            return false if path.count < 2.usize() or path.count > maximum_path_bytes or path[0] != 47
            for index in 0..<path.count |valid: bool = true| -> valid:
                break false if path[index] < 32 or path[index] == 127
