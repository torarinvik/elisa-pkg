# Canonical package identity validation shared by CLI and serialization code.
# This module depends only on semantic-version parsing and carries no I/O state.

include "./model.elisa"
include "./semver.elisa"

module PackageIdentity:
    public:
        def valid_name(name: darray[u8]&) -> bool:
            return false if name.count == 0.usize() or name.count > 64.usize()
            return false if name[0] < 97 or name[0] > 122
            previous_hyphen: mutable bool = false
            for index in 0..<name.count |name, previous_hyphen|:
                byte: u8 = name[index]
                if byte == 45:
                    return false if index == 0.usize() or index + 1.usize() == name.count or previous_hyphen
                    previous_hyphen <- true
                else:
                    return false if (byte < 97 or byte > 122) and (byte < 48 or byte > 57)
                    previous_hyphen <- false
            return true

        def parse_version(value: darray[u8]&, out: mutable Model::Version&) -> bool:
            return false if value.count == 0.usize() or value.count > max_version_bytes
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return false if not SemVer::parse(value, &parsed)
            out.major <- parsed.major
            out.minor <- parsed.minor
            out.patch <- parsed.patch
            out.prerelease <- parsed.prerelease
            return true

    private:
        const max_version_bytes: usize = 1048576
