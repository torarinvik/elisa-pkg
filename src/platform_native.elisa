# Private operating-system implementation for elisapkg.
#
# This module contains policy-aware filesystem code in Elisa. The only native
# boundary is the small set of libc/POSIX primitives declared below; no package
# manager policy is implemented in C.

include "./package_path_policy.elisa"

# The constants and packed libc layouts below are reviewed only for these
# targets. An unsupported target must stop at compilation instead of silently
# inheriting an ABI from a different operating system or architecture.
static assert (ELISA_TARGET_OS_MACOS and ELISA_TARGET_ARCH_ARM64) or (ELISA_TARGET_OS_LINUX and (ELISA_TARGET_ARCH_X86_64 or ELISA_TARGET_ARCH_ARM64)), "elisapkg FFI supports macOS arm64, Linux x86_64, and Linux arm64 only"

@link_name("open")
extern native_open(path: cstr, flags: i64, ...) -> i32
@link_name("openat")
extern native_openat(directory: i64, path: cstr, flags: i64, ...) -> i32
@link_name("mkdirat")
extern native_mkdirat(directory: i64, path: cstr, mode: i64) -> i32
@link_name("unlinkat")
extern native_unlinkat(directory: i64, path: cstr, flags: i64) -> i32
@link_name("renameat")
extern native_renameat(old_directory: i64, old_path: cstr, new_directory: i64, new_path: cstr) -> i32
@link_name("linkat")
extern native_linkat(old_directory: i64, old_path: cstr, new_directory: i64, new_path: cstr, flags: i64) -> i32
@link_name("read")
extern native_read(fd: i64, buffer: mutable void&, count: usize) -> i64
@link_name("write")
extern native_write(fd: i64, buffer: void&, count: usize) -> i64
@link_name("close")
extern native_close(fd: i64) -> i32
@link_name("getdtablesize")
extern native_getdtablesize() -> i32
@link_name("syscall")
extern native_syscall(number: i64, ...) -> i64
@link_name("dup")
extern native_dup(fd: i64) -> i32
@link_name("dup2")
extern native_dup2(fd: i64, target: i64) -> i32
@link_name("fcntl")
extern native_fcntl(fd: i64, command: i64, ...) -> i32
@link_name("fsync")
extern native_fsync(fd: i64) -> i32
@link_name("flock")
extern native_flock(fd: i64, operation: i64) -> i32
@link_name("fchmod")
extern native_fchmod(fd: i64, mode: i64) -> i32
@link_name("fchdir")
extern native_fchdir(fd: i64) -> i32
@link_name("fstat")
extern native_fstat(fd: i64, stat: mutable void&) -> i32
@link_name("fstatat")
extern native_fstatat(directory: i64, path: cstr, stat: mutable void&, flags: i64) -> i32
@link_name("faccessat")
extern native_faccessat(directory: i32, path: cstr, mode: i32, flags: i32) -> i32
@link_name("lseek")
extern native_lseek(fd: i64, offset: i64, whence: i64) -> i64
@link_name("strlen")
extern native_strlen(value: cstr) -> usize
@link_name("getenv")
extern native_getenv(name: cstr) -> u8&?
@link_name("geteuid")
extern native_geteuid() -> u32
@link_name("realpath")
extern native_realpath(path: cstr, resolved: void&?) -> u8&?
@link_name("free")
extern native_free(value: void&)
@link_name("arc4random_buf")
extern native_arc4random_buf(buffer: mutable void&, length: usize)
static if ELISA_TARGET_OS_LINUX:
    @link_name("__errno_location")
    extern native_errno() -> mutable i32&
static elif ELISA_TARGET_OS_FREEBSD:
    @link_name("__error")
    extern native_errno() -> mutable i32&
static else:
    @link_name("__error")
    extern native_errno() -> mutable i32&
static if ELISA_TARGET_OS_MACOS:
    @link_name("getgrnam")
    extern native_getgrnam(name: cstr) -> u8&?
    @link_name("acl_get_fd_np")
    extern native_acl_get_fd_np(fd: i32, kind: i32) -> u8&?
    @link_name("acl_get_entry")
    extern native_acl_get_entry(acl: u8&, entry_id: i32, entry_out: mutable void&) -> i32
    @link_name("acl_get_tag_type")
    extern native_acl_get_tag_type(entry: u8&, tag: mutable i32&) -> i32
    @link_name("acl_free")
    extern native_acl_free(value: void&) -> i32
static if ELISA_TARGET_OS_LINUX:
    @link_name("fgetxattr")
    extern native_fgetxattr(fd: i32, name: cstr, value: mutable void&, size: usize) -> i64
@link_name("fdopen")
extern native_fdopen(fd: i64, mode: cstr) -> mutable heap void&?
