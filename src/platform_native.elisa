# Private operating-system implementation for elisapkg.
#
# This module contains policy-aware filesystem code in Elisa. The only native
# boundary is the set of libc/POSIX declarations in platform/libc.elisa.

include "./package_path_policy.elisa"

include "./platform/libc.elisa"
include "./platform/errors.elisa"
include "./platform/process.elisa"

include "./platform/abi.elisa"
include "./platform/stat.elisa"
include "./platform/process_values.elisa"
include "./platform/linux_access_acl.elisa"
include "./platform/path_order.elisa"

module PlatformNative:
    public:
        # Raw libc calls are kept behind this module's named wrappers. The
        # public `Platform` module delegates here without spelling foreign
        # symbols, keeping the FFI vocabulary confined to one reviewed unit.
        def strlen(value: cstr) -> usize:
            return native_strlen(value)
        def cstr_equal(left: cstr, right: cstr) -> bool:
            left_length: usize = native_strlen(left)
            right_length: usize = native_strlen(right)
            return false if left_length != right_length
            for index in 0..<left_length |left, right|:
                return false if left[index].u8() != right[index].u8()
            return true
        def getenv(name: cstr) -> u8&?:
            return native_getenv(name)
        def write(fd: i64, buffer: void&, count: usize) -> i64 can[Console.Write]:
            while true |fd, buffer, count|:
                result: i64 = native_write(fd, buffer, count) can Console.Write
                continue if result < 0 and NativeErrors::current_errno() == 4
                return result
            return -5
        def read_fd(fd: i64, buffer: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return -22 if fd < 0
            raw: mutable void& = buffer.cast[mutable void&] can Unsafe.PointerCast
            while true |fd, raw, capacity|:
                result: i64 = native_read(fd, raw, capacity)
                continue if result < 0 and NativeErrors::current_errno() == 4
                return result if result >= 0
                return NativeErrors::negative_errno()
            return -5
        def seek_fd(fd: i64, offset: i64, origin: i64) -> i64:
            return native_lseek(fd, offset, origin)
        def duplicate_fd(fd: i64, target: i64) -> i64:
            return native_dup2(fd, target)
        def duplicate_fd_min(fd: i64, minimum: i64) -> i64:
            return native_fcntl(fd, 0, minimum)
        def open_null() -> i64:
            return native_open("/dev/null", 0)
        def close(fd: i64) -> i64:
            return native_close(fd)
        # Run only in a post-fork child. The current soft descriptor limit
        # does not bound descriptors that were inherited above that limit.
        def close_inherited_fds() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            static if ELISA_TARGET_OS_LINUX:
                while true:
                    close_status: i64 = native_syscall(linux_close_range_syscall, 3, 4294967295, 0)
                    return 0 if close_status == 0
                    errno_value: i64 = NativeErrors::current_errno()
                    continue if errno_value == 4
                    return NativeErrors::negative_value(errno_value)
                return -5
            static else:
                return close_macos_inherited_descriptors()

        def fsync(fd: i64) -> i64:
            return native_fsync(fd)
        def read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return -22 if capacity == 0.usize()
            fd: i64 = open_package_file(path)
            return fd if fd < 0
            return close_error(fd, -21) if not regular_fd(fd)
            return close_result(fd, read_regular_descriptor(fd, output, capacity))

        # Size and read the opened inode. A pathname replacement between those
        # operations cannot redirect the read to a different file.
        def read_bounded_regular_file(path: cstr, maximum_bytes: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return false if maximum_bytes > 67108864.usize()
            descriptor: i64 = open_package_file(path)
            return false if descriptor < 0
            size: i64 = native_lseek(descriptor, 0, 2) if regular_fd(descriptor) else -1
            if size < 0 or size.usize() > maximum_bytes or native_lseek(descriptor, 0, 0) != 0:
                _ = native_close(descriptor)
                return false
            out.resize(size.usize() + 1.usize())
            read_size: i64 =
                output: mutable u8& = (&out[0]).cast[mutable u8&] can Unsafe.PointerCast
                read_regular_descriptor(descriptor, output, out.count)
            close_status: i32 = native_close(descriptor)
            if read_size != size or close_status != 0:
                out.resize(0)
                return false
            out.resize(size.usize())
            return true

        # Trust roots and persisted anti-rollback state are read from one
        # descriptor. Every traversed directory and the final regular file
        # must be owned by root or the effective user and must not be writable
        # by group/other. This prevents a co-user from swapping trust material
        # through a shared directory between path validation and file reads.
        def read_trusted_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            device: mutable u64 = 0.u64()
            inode: mutable u64 = 0.u64()
            return read_trusted_file_identity(path, output, capacity, &device, &inode)

        # Return the identity of the same open descriptor used for the read.
        # Callers that later remove receipt-owned artifacts can bind that
        # removal to the file they actually verified, instead of re-resolving
        # its pathname after hashing. Identity outputs stay zero on every
        # failure path and are committed only after the bounded read succeeds.
        def read_trusted_file_identity(path: cstr, output: mutable u8&, capacity: usize, out_device: mutable u64&, out_inode: mutable u64&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out_device <- 0.u64()
            out_inode <- 0.u64()
            return -22 if capacity == 0.usize()
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot.push(leaf[index])
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            trusted_uid: u64 = native_geteuid().u64()
            directory: i64 = open_trusted_directory(parent_name, trusted_uid)
            return directory if directory < 0
            leaf_c: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                leaf_c.push(leaf_snapshot[index])
            leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = open_regular_file_at(directory, leaf_name)
            return close_error(directory, fd) if fd < 0
            return close_two_error(directory, fd, -13) if not trusted_regular_fd(fd, trusted_uid)
            stat: mutable darray[u8] = []
            stat.resize(stat_buffer_bytes)
            raw_stat: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstat(fd, raw_stat) != 0:
                errno_value: i64 = NativeErrors::current_errno()
                return close_two_error(directory, fd, NativeErrors::negative_value(errno_value))
            file_device: u64 = NativeStat::device(stat)
            file_inode: u64 = NativeStat::inode(stat)
            read_size: i64 = read_regular_descriptor(fd, output, capacity)
            result: i64 = close_two_result(directory, fd, read_size)
            return result if result < 0
            out_device <- file_device
            out_inode <- file_inode
            return result

        def is_trusted_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return 1 if trusted_directory_status(path) == 0 else 0

        # Preserve the failure from the no-follow walk. ENOENT means the
        # existing prefix of the path has already passed the trust policy.
        def trusted_directory_status(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            directory: i64 = open_trusted_directory(path, native_geteuid().u64())
            return directory if directory < 0
            return 0 if native_close(directory) == 0 else -5

        def ensure_trusted_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            directory: i64 = walk_trusted_directory(path, native_geteuid().u64(), true)
            return directory if directory < 0
            return 0 if native_close(directory) == 0 else -5

        def package_file_size(path: cstr) -> i64:
            fd: i64 = open_package_file(path)
            return fd if fd < 0
            return close_error(fd, -21) if not regular_fd(fd)
            size: i64 = native_lseek(fd, 0, 2)
            close_status: i64 = native_close(fd)
            return -5 if close_status != 0
            return -5 if size < 0
            return size

        # Resolve a crypto provider only after every pathname component and
        # the final executable have passed the same ownership, mode, and ACL
        # checks used for trusted state. This is public within the native
        # platform module so its filesystem trust policy can be regression
        # tested directly; application code should use verify_ed25519.
        def is_trusted_crypto_executable(path: cstr, expected_uid: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return trusted_crypto_executable_path(path, expected_uid)

        def is_directory(path: cstr) -> i64:
            fd: i64 = open_directory_path(path)
            return 0 if fd < 0
            return 0 if native_close(fd) != 0
            return 1

        def mkdir(path: cstr, mode: u16) -> i64:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot.push(leaf[index])
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            directory: i64 = open_directory_path(parent_name)
            return directory if directory < 0
            leaf_c: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                leaf_c.push(leaf_snapshot[index])
            leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            result: i64 = native_mkdirat(directory, leaf_name, mode.i64())
            errno_value: i64 = NativeErrors::current_errno()
            if result == 0:
                sync_status: i64 = native_fsync(directory)
                sync_errno: i64 = NativeErrors::current_errno()
                return close_result(directory, 0) if sync_status == 0
                return close_error(directory, NativeErrors::negative_value(sync_errno))
            return close_error(directory, NativeErrors::negative_value(errno_value))

        # Flushing the containing directory completes the durability contract
        # for an atomic file replacement. The caller never receives the raw
        # directory descriptor.
        def fsync_parent(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            directory: i64 = open_directory_path(parent_name)
            return directory if directory < 0
            result: i64 = native_fsync(directory)
            errno_value: i64 = NativeErrors::current_errno()
            return close_result(directory, 0) if result == 0
            return close_error(directory, NativeErrors::negative_value(errno_value))

        def access(path: cstr, mode: i64) -> i64:
            return -22 if mode != 0 and mode != 1
            if mode == 1:
                parent: mutable darray[u8] = []
                leaf: mutable darray[u8] = []
                return -22 if not split_parent_leaf(path, &parent, &leaf)
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                directory: i64 = open_executable_directory_path(parent_name)
                return directory if directory < 0
                leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
                fd: i64 = open_regular_file_at(directory, leaf_name)
                return close_error(directory, fd) if fd < 0

                access_status: i64 = effective_execute_at(directory, leaf_name, fd)
                return close_two_error(directory, fd, access_status) if access_status != 0
                return close_two_result(directory, fd, 0)

            fd: i64 = open_package_file(path)
            return fd if fd < 0
            return close_error(fd, -21) if not regular_fd(fd)
            return close_result(fd, 0)

        def chmod(path: cstr, mode: u16) -> i64:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot.push(leaf[index])
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            directory: i64 = open_package_directory_path(parent_name)
            return directory if directory < 0
            leaf_c: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                leaf_c.push(leaf_snapshot[index])
            leaf_c.push(0)
            leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = open_regular_file_at(directory, leaf_name)
            if fd < 0:
                return close_error(directory, fd)
            return close_two_error(directory, fd, -21) if not regular_fd(fd)
            result: i64 = native_fchmod(fd, mode.i64())
            errno_value: i64 = NativeErrors::current_errno()
            return close_two_error(fd, directory, NativeErrors::negative_value(errno_value)) if result != 0
            sync_status: i64 = native_fsync(fd)
            sync_errno: i64 = NativeErrors::current_errno()
            return close_two_result(fd, directory, 0) if sync_status == 0
            return close_two_error(fd, directory, NativeErrors::negative_value(sync_errno))

        def acquire_install_lock(prefix: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # Use one persistent inode for every installer process. Never unlink
            # this file: doing so could split advisory locks across old and new
            # inodes while another process still holds the previous one.
            expected_uid: u64 = native_geteuid().u64()
            directory: i64 = open_trusted_directory(prefix, expected_uid)
            return directory if directory < 0
            flags: i64 = flag_read_write + flag_create + flag_no_follow + flag_close_on_exec + flag_nonblock
            fd: i64 = native_openat(directory, ".elisapkg-install.lock", flags, 384)
            open_errno: i64 = NativeErrors::current_errno()
            directory_close: i64 = native_close(directory)
            if fd < 0:
                return NativeErrors::negative_value(open_errno)
            return close_error(fd, -5) if directory_close != 0
            return close_error(fd, -13) if not trusted_regular_fd(fd, expected_uid)
            if native_flock(fd, lock_operation_exclusive + lock_operation_nonblocking) != 0:
                lock_errno: i64 = NativeErrors::current_errno()
                return close_error(fd, NativeErrors::negative_value(lock_errno))
            return fd

        # Hold a persistent project-local advisory lock across the complete
        # manifest/lock transaction. Unlike the guard directory, flock is
        # released by the kernel when a process exits, so recovery can safely
        # distinguish an active writer from a guard left by a crash.
        def acquire_project_transaction_lock(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            expected_uid: u64 = native_geteuid().u64()
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot.push(leaf[index])
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            directory: i64 = open_package_directory_path(parent_name)
            return directory if directory < 0
            leaf_buffer: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_buffer, leaf_snapshot|:
                leaf_buffer.push(leaf_snapshot[index])
            leaf_name: cstr = (&leaf_buffer[0]).cast[cstr] can Unsafe.PointerCast
            flags: i64 = flag_read_write + flag_create + flag_no_follow + flag_close_on_exec + flag_nonblock
            fd: i64 = native_openat(directory, leaf_name, flags, 384)
            open_errno: i64 = NativeErrors::current_errno()
            directory_close: i64 = native_close(directory)
            if fd < 0:
                return NativeErrors::negative_value(open_errno)
            return close_error(fd, -5) if directory_close != 0
            return close_error(fd, -13) if not trusted_regular_fd(fd, expected_uid)
            if native_flock(fd, lock_operation_exclusive + lock_operation_nonblocking) != 0:
                lock_errno: i64 = NativeErrors::current_errno()
                return close_error(fd, NativeErrors::negative_value(lock_errno))
            return fd

        def acquire_trust_state_lock(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # Trust-state locks use a persistent regular-file inode just like
            # install locks. The kernel releases flock ownership after process
            # death, while retaining the inode prevents stale directory locks
            # and lock splitting across concurrent readers and writers.
            expected_uid: u64 = native_geteuid().u64()
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot.push(leaf[index])
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            directory: i64 = open_trusted_directory(parent_name, expected_uid)
            return directory if directory < 0
            leaf_buffer: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_buffer, leaf_snapshot|:
                leaf_buffer.push(leaf_snapshot[index])
            leaf_name: cstr = (&leaf_buffer[0]).cast[cstr] can Unsafe.PointerCast
            flags: i64 = flag_read_write + flag_create + flag_no_follow + flag_close_on_exec + flag_nonblock
            fd: i64 = native_openat(directory, leaf_name, flags, 384)
            open_errno: i64 = NativeErrors::current_errno()
            directory_close: i64 = native_close(directory)
            if fd < 0:
                return NativeErrors::negative_value(open_errno)
            return close_error(fd, -5) if directory_close != 0
            return close_error(fd, -13) if not trusted_regular_fd(fd, expected_uid)
            if native_flock(fd, lock_operation_exclusive + lock_operation_nonblocking) != 0:
                lock_errno: i64 = NativeErrors::current_errno()
                return close_error(fd, NativeErrors::negative_value(lock_errno))
            return fd

        def unlink(path: cstr) -> i64:
            return unlink_kind(path, 0)

        def unlink_file_identity(path: cstr, device: u64, inode: u64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return unlink_verified_identity(path, device, inode)

        def rmdir(path: cstr) -> i64:
            return rmdir_secure(path)

        def open_directory_for_process(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return open_directory_path(path)

        def link(old_path: cstr, new_path: cstr) -> i64:
            return link_or_rename(old_path, new_path, false)

        def rename(old_path: cstr, new_path: cstr) -> i64:
            return rename_secure(old_path, new_path)

        def chdir(path: cstr) -> i64:
            directory: i64 = open_directory_path(path)
            return directory if directory < 0
            result: i64 = native_fchdir(directory)
            errno_value: i64 = NativeErrors::current_errno()
            return close_result(directory, 0) if result == 0
            return close_error(directory, NativeErrors::negative_value(errno_value))

        def fchdir(fd: i64) -> i64:
            result: i64 = native_fchdir(fd)
            return 0 if result == 0
            return -NativeErrors::error_code()

        def realpath(path: cstr, resolved: mutable darray[u8]&) -> cstr? can[Unsafe.PointerCast]:
            resolved[0] <- 0 if resolved.count > 0.usize()
            return null if resolved.count == 0 or resolved.count > 4096.usize()
            return null if native_strlen(path) > 4096.usize()
            found: u8&? = native_realpath(path, null)
            if found is canonical:
                length: usize = native_strlen(canonical.cast[cstr] can Unsafe.PointerCast)
                if length + 1.usize() <= resolved.count:
                    source: cstr = canonical.cast[cstr] can Unsafe.PointerCast
                    for index in 0..<length |resolved, source|:
                        resolved[index] <- source[index].u8()
                    resolved[length] <- 0
                    native_free(canonical.cast[void&] can Unsafe.PointerCast)
                    return (&resolved[0]).cast[cstr] can Unsafe.PointerCast
                native_free(canonical.cast[void&] can Unsafe.PointerCast)
            return null

        def collect_files(root: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Unsafe.PointerCast]:
            return -22 if native_strlen(root) == 0.usize() or native_strlen(root) > 4096.usize() or capacity == 0.usize()
            paths: mutable darray[u8] = []
            visited_nodes: mutable usize = 1.usize()
            if not collect_directory(root, root, &paths, 0.usize(), &visited_nodes):
                return -75 if visited_nodes > max_collect_traversal_nodes
                return -5
            rows: mutable darray[darray[u8]] = []
            cursor: mutable usize = 0.usize()
            while cursor < paths.count:
                row: mutable darray[u8] = []
                while cursor < paths.count and paths[cursor] != 0:
                    row.push(paths[cursor])
                    cursor <- cursor + 1.usize()
                return -5 if row.count == 0.usize() or cursor >= paths.count
                rows.push(row)
                return -75 if rows.count > 4096.usize()
                cursor <- cursor + 1.usize()
            ordered_rows: mutable darray[usize] = []
            for row_index in 0..<rows.count |ordered_rows|:
                ordered_rows.push(row_index)
            CollectedPathOrder::sort_indices(&ordered_rows, rows)
            used: mutable usize = 0.usize()
            for sorted_index in 0..<ordered_rows.count |rows, ordered_rows, output, used, capacity|:
                row_index: usize = ordered_rows[sorted_index]
                return -7 if used + rows[row_index].count + 1.usize() > capacity
                for index in 0..<rows[row_index].count |output, rows, row_index, used|:
                    output[used + index] <- rows[row_index][index]
                used <- used + rows[row_index].count
                output[used] <- 0
                used <- used + 1.usize()
            return used.i64()

        def mkstemp(template_path: mutable darray[u8]&) -> i64 can[Memory.Allocate, Unsafe.PointerCast]:
            return -22 if template_path.count == 0 or template_path.count > 4096.usize() or template_path[template_path.count - 1.usize()] != 0
            path_length: usize = native_strlen((&template_path[0]).cast[cstr] can Unsafe.PointerCast)
            path: cstr = (&template_path[0]).cast[cstr] can Unsafe.PointerCast
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            return -22 if leaf.count < 7.usize()
            suffix: usize = leaf.count - 7.usize()
            for index in 0..<6 |leaf|:
                return -22 if leaf[suffix + index] != 88
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            directory: i64 = open_directory_path(parent_name)
            return directory if directory < 0
            alphabet: cstr = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            entropy: mutable darray[u8] = []
            entropy.resize(6)
            entropy_raw: mutable void& = (&entropy[0]).cast[mutable void&] can Unsafe.PointerCast
            for attempt in 0..<256 |leaf, alphabet, directory, template_path, path_length, entropy_raw|:
                native_arc4random_buf(entropy_raw, 6)
                for index in 0..<6 |leaf, alphabet, entropy, attempt|:
                    leaf[suffix + index] <- alphabet[((entropy[index].u64() + attempt.u64() * 17.u64() + index.u64()) % 62.u64()).usize()].u8()
                leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
                fd: i64 = native_openat(directory, leaf_name, flags_read_write_create_exclusive(), 384)
                if fd >= 0:
                    start: usize = path_length - leaf.count + 1.usize()
                    for index in 0..<leaf.count |template_path, leaf, start|:
                        template_path[start + index] <- leaf[index]
                    if native_close(directory) != 0:
                        _ = native_close(fd)
                        # The descriptor close failure means the caller must
                        # treat creation as failed. Remove the newly-created
                        # name so an unreported temporary cannot accumulate
                        # in the package cache.
                        cleanup_path: mutable darray[u8] = []
                        for index in 0..<template_path.count |cleanup_path, template_path|:
