                return opened

        def package_source_directory_fd(fd: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stat: mutable darray[u8] = []
            stat.resize(144)
            raw: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
