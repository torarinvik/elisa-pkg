                break if amount == 0
                if amount > buffer.count.i64() or amount.usize() > snapshot_max_total_bytes - total_bytes:
                    failed <- -75
                    break
                written: mutable usize = 0.usize()
                while written < amount.usize() |buffer_raw, destination_file, written, amount|:
                    raw: void& = (&buffer[written]).cast[void&] can Unsafe.PointerCast
                    wrote: i64 = native_write(destination_file, raw, amount.usize() - written)
                    if wrote < 0:
                        errno_value: i64 = current_errno()
                        continue if errno_value == 4
                        failed <- negative_value(errno_value)
                        break
                    if wrote == 0 or wrote > amount - written.i64():
                        failed <- -5
                        break
                    written <- written + wrote.usize()
                break if failed != 0
                total_bytes <- total_bytes + amount.usize()

            if failed == 0 and native_fsync(destination_file) != 0:
                failed <- negative_errno()
            source_close: i32 = native_close(source_file)
            destination_close: i32 = native_close(destination_file)
            if failed == 0 and (source_close != 0 or destination_close != 0):
                failed <- -5
            if failed == 0 and native_fsync(destination_parent) != 0:
                failed <- negative_errno()
            source_parent_close: i32 = native_close(source_parent)
            destination_parent_close: i32 = native_close(destination_parent)
            if source_parent_close != 0 or destination_parent_close != 0:
                failed <- -5 if failed == 0
            return failed

        def snapshot_copy_failure(source_root: i64, destination_root: i64, copied_paths: darray[u8]&, created_directories: darray[u8]&, original_error: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            cleanup_status: mutable i64 = 0
            if destination_root >= 0:
                cleanup_ok: mutable bool = cleanup_archive_files(destination_root, copied_paths)
                cleanup_ok <- cleanup_archive_directories(destination_root, created_directories) and cleanup_ok
                cleanup_ok <- native_fsync(destination_root) == 0 and cleanup_ok
                cleanup_status <- -5 if not cleanup_ok
            source_close: i32 = native_close(source_root) if source_root >= 0 else 0
            destination_close: i32 = native_close(destination_root) if destination_root >= 0 else 0
            return -5 if cleanup_status != 0 or source_close != 0 or destination_close != 0
            return original_error if original_error != 0 else -5

        def cleanup_package_snapshot_contents(destination: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(destination)
            return -22 if not SnapshotPaths::absolute_path_safe(destination, length)
            root: i64 = open_directory_path(destination)
            return root if root < 0
            if not private_staging_directory_fd(root, native_geteuid().u64()):
                return close_error(root, -13)
            names: mutable darray[u8] = []
            names.resize(snapshot_collection_entries * (SnapshotPaths::maximum_path_bytes + 1.usize()))
            names_raw: mutable u8& = (&names[0]).cast[mutable u8&] can Unsafe.PointerCast
            collected: i64 = collect_files(destination, names_raw, names.count)
            return close_error(root, collected) if collected < 0
            copied_paths: mutable darray[u8] = []
            cursor: mutable usize = 0.usize()
            entry_count: mutable usize = 0.usize()
            while cursor < collected.usize() |names, destination, length, copied_paths, cursor, entry_count|:
                path_start: usize = cursor
                while cursor < collected.usize() and names[cursor] != 0:
                    cursor <- cursor + 1.usize()
                return close_error(root, -22) if cursor == path_start or cursor >= collected.usize()
                path_length: usize = cursor - path_start
                cursor <- cursor + 1.usize()
                return close_error(root, -22) if path_length <= length + 1.usize()
                for index in 0..<length |names, destination, path_start|:
                    return close_error(root, -22) if names[path_start + index] != destination[index].u8()
                return close_error(root, -22) if names[path_start + length] != 47
                relative: mutable darray[u8] = []
                for index in length + 1.usize()..<path_length |relative, names, path_start|:
                    relative.push(names[path_start + index])
                return close_error(root, -22) if not SnapshotPaths::relative_path_safe(relative)
                entry_count <- entry_count + 1.usize()
                return close_error(root, -75) if entry_count > snapshot_max_entries
                for index in 0..<relative.count |copied_paths, relative|:
                    copied_paths.push(relative[index])
                copied_paths.push(0)

            return close_error(root, -5) if not cleanup_archive_files(root, copied_paths)
            directory_depth: mutable usize = 64.usize()
            while directory_depth > 0.usize() |names, copied_paths, root, directory_depth|:
                directories: mutable darray[u8] = []
                file_cursor: mutable usize = 0.usize()
                while file_cursor < copied_paths.count |copied_paths, directories, file_cursor, directory_depth|:
                    file_end: mutable usize = file_cursor
                    while file_end < copied_paths.count and copied_paths[file_end] != 0:
                        file_end <- file_end + 1.usize()
                    return close_error(root, -22) if file_end == file_cursor or file_end >= copied_paths.count
                    component_depth: mutable usize = 0.usize()
                    for index in file_cursor..<file_end |copied_paths, directories, component_depth, file_end, directory_depth|:
                        if copied_paths[index] == 47:
                            component_depth <- component_depth + 1.usize()
                            if component_depth == directory_depth:
                                for prefix_index in file_cursor..<index |directories, copied_paths|:
                                    directories.push(copied_paths[prefix_index])
                                directories.push(0)
                    file_cursor <- file_end + 1.usize()
                return close_error(root, -5) if directories.count > 0.usize() and not cleanup_archive_directories(root, directories)
                directory_depth <- directory_depth - 1.usize()
            return close_error(root, -5) if not directory_empty(root)
            if native_fsync(root) != 0:
                return close_error(root, negative_errno())
            return close_result(root, 0)

        def snapshot_open_parent(root: i64, relative: darray[u8]&, path_out: mutable darray[u8]&, leaf_offset: mutable usize&, create_missing: bool, created_directories: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_out.resize(0)
            leaf_offset <- 0.usize()
            return -22 if not SnapshotPaths::relative_path_safe(relative)
            for index in 0..<relative.count |path_out, relative|:
                path_out.push(relative[index])
            path_out.push(0)
            slash: mutable usize = 0.usize()
            for index in 0..<relative.count |path_out, slash|:
                slash <- index + 1.usize() if path_out[index] == 47
            leaf_offset <- slash
            return -22 if leaf_offset >= relative.count
            directory: mutable i64 = native_dup(root)
            return negative_errno() if directory < 0
            start: mutable usize = 0.usize()
            while start < leaf_offset:
                finish: mutable usize = start
                while finish < leaf_offset and path_out[finish] != 47:
                    finish <- finish + 1.usize()
                path_out[finish] <- 0
                component: cstr = (&path_out[start]).cast[cstr] can Unsafe.PointerCast
                return close_error(directory, -22) if not package_leaf_component_safe(component)
                created: mutable bool = false
                if create_missing:
                    mkdir_status: i32 = native_mkdirat(directory, component, 448)
                    mkdir_errno: i64 = current_errno()
                    if mkdir_status == 0:
                        created <- true
                        for path_index in 0..<finish |created_directories, relative|:
                            created_directories.push(relative[path_index])
                        created_directories.push(0)
                    elif mkdir_errno != 17:
                        return close_error(directory, -mkdir_errno)
                next: i64 = open_package_directory_component(directory, component)
                if next < 0:
                    open_errno: i64 = next
                    cleanup_status: i32 = native_unlinkat(directory, component, at_remove_directory) if created else 0
                    close_status: i32 = native_close(directory)
                    return -5 if cleanup_status != 0 or close_status != 0
                    return open_errno
                if created and native_fsync(directory) != 0:
                    return close_two_error(directory, next, negative_errno())
                return close_error(next, -5) if native_close(directory) != 0
                directory <- next
                start <- finish + 1.usize()
            return directory

        def collect_directory(root: cstr, path: cstr, out: mutable darray[u8]&, depth: usize, visited_nodes: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if depth > 64.usize()
            # Resolve the directory through the descriptor-relative no-follow
            # walker before enumeration. Opening `path` with `opendir` here
            # would re-follow a swapped symlink after the caller's probe.
            directory_fd: i64 = open_package_directory_path(path)
            return false if directory_fd < 0
            duplicate: i64 = native_dup(directory_fd)
            if duplicate < 0:
                _ = native_close(directory_fd)
                return false
            directory: mutable heap void&? = native_fdopendir(duplicate)
            directory_close_status: i64 = native_close(directory_fd)
            if directory_close_status != 0:
                if directory is stream:
                    _ = native_closedir(stream)
                else:
                    _ = native_close(duplicate)
                return false
            if directory is stream:
                while true |stream, out, path, depth, visited_nodes|:
                    native_errno()[0] <- 0
                    entry: mutable heap void&? = native_readdir(stream)
                    if entry is record:
                        raw: mutable u8& = record.cast[mutable u8&] can Unsafe.PointerCast
                        name_length: usize = dirent_name_length(raw)
                        return directory_failure(stream) if name_length == 0 or name_length > 255.usize()
                        continue if name_is_dot(raw, dirent_name_offset, name_length)
                        visited_nodes <- visited_nodes + 1.usize()
                        return directory_failure(stream) if visited_nodes > max_collect_traversal_nodes
                        # Some filesystems report DT_UNKNOWN. Credential
                        # exclusions must therefore not depend on d_type.
                        child: mutable darray[u8] = []
                        if not cstr_equal(path, "."):
                            parent_length: usize = path_length(path)
                            for index in 0..<parent_length |child, path|:
                                child.push(path[index].u8())
                            child.push(47) if parent_length == 0 or path[parent_length - 1.usize()].u8() != 47
                        for index in 0..<name_length |child, raw|:
                            child.push(raw[dirent_name_offset + index])
                        child.push(0)
                        child_name: cstr = (&child[0]).cast[cstr] can Unsafe.PointerCast
                        child_length: usize = path_length(child_name)
                        return directory_failure(stream) if child_length == 0 or child_length > 4096.usize()
                        relative_policy_path: mutable darray[u8] = []
                        return directory_failure(stream) if not relative_path_under(root, child_name, &relative_policy_path)
                        continue if PackagePathPolicy::credential_path_forbidden(relative_policy_path)
                        continue if PackagePathPolicy::reserved_source_path_forbidden(relative_policy_path)
                        directory_probe: i64 = open_package_directory_path(child_name)
                        if directory_probe >= 0:
                            return directory_failure(stream) if native_close(directory_probe) != 0
                            return directory_failure(stream) if not collect_directory(root, child_name, out, depth + 1.usize(), visited_nodes)
                        else:
                            file_probe: i64 = open_package_file(child_name)
                            if file_probe < 0:
                                # The directory probe already ruled out a
                                # stable directory. Any failed file open means
                                # the entry changed or was unsafe; skipping it
                                # would produce an incomplete source digest.
                                return directory_failure(stream)
                            regular: bool = regular_fd(file_probe)
                            close_status: i64 = native_close(file_probe)
                            return directory_failure(stream) if not regular or close_status != 0
                            return directory_failure(stream) if out.count + child_length + 1.usize() > 16777216.usize()
                            for index in 0..<child_length |out, child_name|:
                                out.push(child_name[index].u8())
                            out.push(0)
                    else:
                        return directory_failure(stream) if current_errno() != 0
                        break
                return native_closedir(stream) == 0
            _ = native_close(duplicate)
            return false

        def directory_failure(stream: heap void&) -> bool:
            _ = native_closedir(stream)
            return false

        def path_length(path: cstr) -> usize:
            return native_strlen(path)

        def relative_path_under(root: cstr, path: cstr, out: mutable darray[u8]&) -> bool:
            out.resize(0)
            root_length: usize = native_strlen(root)
            path_length_value: usize = native_strlen(path)
            if cstr_equal(root, "."):
                return false if path_length_value == 0 or path_length_value > 4096
                for index in 0..<path_length_value |out, path|:
                    out.push(path[index].u8())
                return true
            return false if root_length == 0 or path_length_value <= root_length or path_length_value > 4096
            for index in 0..<root_length |root, path|:
                return false if root[index].u8() != path[index].u8()
            relative_start: mutable usize = root_length
            if root[root_length - 1].u8() != 47:
                return false if path[root_length].u8() != 47
                relative_start <- root_length + 1.usize()
            for index in relative_start..<path_length_value |out, path|:
                out.push(path[index].u8())
            return out.count > 0.usize()

        def name_is_dot(raw: mutable u8&, offset: usize, length: usize) -> bool:
            return length == 1 and raw[offset] == 46 or length == 2 and raw[offset] == 46 and raw[offset + 1] == 46
