                    return 0
                if waited < 0:
                    continue if native_errno() == 4
                    return negative_errno()
                now: i64 = monotonic_milliseconds()
                return -5 if now < 0
                if now >= deadline:
                    _ = native_kill(-pid, 9)
                    _ = native_kill(pid, 9)
