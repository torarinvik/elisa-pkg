                return -7 if best == rows.count or used + rows[best].count + 1.usize() > capacity
                for index in 0..<rows[best].count |output, rows, best, used|:
                    output[used + index] <- rows[best][index]
                used <- used + rows[best].count
                output[used] <- 0
                used <- used + 1.usize()
                used_rows[best] <- true
            return used.i64()

