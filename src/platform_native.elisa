                return -symlink_error if before_mode == symlink_mode
                return -20
            next: i64 = native_openat(directory, component, flags_directory() + flag_no_follow)
            return NativeErrors::negative_errno() if next < 0
            after: mutable darray[u8] = []
            after.resize(stat_buffer_bytes)
            after_raw: mutable void& = (&after[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstat(next, after_raw) != 0:
                errno_value: i64 = NativeErrors::negative_errno()
                return close_error(next, errno_value)
            if (NativeStat::file_type(after)) != directory_mode or not NativeStat::same_identity(before, after) or not package_source_directory_fd(next):
                return close_error(next, -13)
            return next

    private:
    public:
        def open_package_directory_path(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
