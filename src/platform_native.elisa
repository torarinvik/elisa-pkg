        const regular_mode: u64 = 32768
        const directory_mode: u64 = 16384
        const symlink_mode: u64 = 40960

        def flags_directory() -> i64:
            return flag_read_only + flag_directory + flag_close_on_exec

        def flags_read_no_follow() -> i64:
            return flag_read_only + flag_no_follow + flag_close_on_exec + flag_nonblock

        def flags_file_read() -> i64:
            return flag_read_only + flag_no_follow + flag_close_on_exec + flag_nonblock

        def open_regular_file_at_pinned(directory: i64, leaf_name: cstr, before: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            pin_flags: i64 = linux_open_path + flag_no_follow + flag_close_on_exec
            pinned: i64 = native_openat(directory, leaf_name, pin_flags)
            return negative_errno() if pinned < 0
