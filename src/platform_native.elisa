                    return close_error(directory, next) if next < 0
                    return close_error(next, -5) if native_close(directory) != 0
                    directory <- next
                start <- finish + 1.usize()
                while start < length and path_copy[start] == 47 |path_copy, start|:
                    start <- start + 1.usize()
            return directory

    private:
        def open_package_file(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096
            path_copy: mutable darray[u8] = []
            for index in 0..<length |path_copy, path|:
                path_copy.push(path[index].u8())
            path_copy.push(0)
            absolute: bool = path_copy[0] == 47
            directory: mutable i64 = native_open("/" if absolute else ".", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            return close_error(directory, -13) if not package_source_directory_fd(directory)
            start: mutable usize = 0.usize()
            while start < length and path_copy[start] == 47 |path_copy, start|:
                start <- start + 1.usize()
            while start < length:
                finish: mutable usize = start
                while finish < length and path_copy[finish] != 47 |path_copy, finish|:
                    finish <- finish + 1.usize()
                had_slash: bool = finish < length
                path_copy[finish] <- 0
                part: cstr = (&path_copy[start]).cast[cstr] can Unsafe.PointerCast
                return close_error(directory, -22) if cstr_equal(part, "")
                if had_slash:
                    if not cstr_equal(part, "."):
                        next: i64 = open_package_directory_component(directory, part)
                        return close_error(directory, next) if next < 0
                        return close_error(next, -5) if native_close(directory) != 0
                        directory <- next
                else:
                    return close_result(directory, -21) if cstr_equal(part, ".")
                    result: i64 = open_regular_file_at(directory, part)
                    return close_error(directory, result) if result < 0
                    close_status: i32 = native_close(directory)
                    if close_status != 0:
                        _ = native_close(result)
                        return -5
                    return result
                start <- finish + 1.usize()
                while start < length and path_copy[start] == 47 |path_copy, start|:
                    start <- start + 1.usize()
            _ = native_close(directory)
            return -22

    public:
        def close_error(fd: i64, errno_value: i64) -> i64:
            return -5 if native_close(fd) != 0
            return errno_value

    private:
    public:
        def close_result(fd: i64, result: i64) -> i64:
            return -5 if native_close(fd) != 0
            return result

    private:
        # Remove only the regular-file inode previously returned by
        # read_trusted_file_identity. The parent descriptor stays open across
        # the final identity check and unlink, so callers never re-resolve the
        # directory after validating the receipt-owned file.
        def unlink_verified_identity(path: cstr, expected_device: u64, expected_inode: u64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot.push(leaf[index])
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            expected_uid: u64 = native_geteuid().u64()
            directory: i64 = open_trusted_directory(parent_name, expected_uid)
            return directory if directory < 0
            leaf_c: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                leaf_c.push(leaf_snapshot[index])
            leaf_c.push(0)
            leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = open_regular_file_at(directory, leaf_name)
            return close_error(directory, fd) if fd < 0
            return close_two_error(directory, fd, -13) if not trusted_regular_fd(fd, expected_uid)
            fd_stat: mutable darray[u8] = []
            fd_stat.resize(stat_buffer_bytes)
            fd_stat_raw: mutable void& = (&fd_stat[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstat(fd, fd_stat_raw) != 0:
                errno_value: i64 = NativeErrors::current_errno()
                return close_two_error(directory, fd, NativeErrors::negative_value(errno_value))
            fd_device: u64 = NativeStat::device(fd_stat)
            fd_inode: u64 = NativeStat::inode(fd_stat)
            return close_two_error(directory, fd, -13) if fd_device != expected_device or fd_inode != expected_inode
            path_stat: mutable darray[u8] = []
            path_stat.resize(stat_buffer_bytes)
            path_stat_raw: mutable void& = (&path_stat[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstatat(directory, leaf_name, path_stat_raw, at_no_follow) != 0:
                errno_value: i64 = NativeErrors::current_errno()
                return close_two_error(directory, fd, NativeErrors::negative_value(errno_value))
            return close_two_error(directory, fd, -13) if NativeStat::file_type(path_stat) != regular_mode
            return close_two_error(directory, fd, -13) if not NativeStat::same_identity(path_stat, fd_stat)
            # POSIX has no unlink-if-inode primitive: this is the narrowest
            # descriptor-relative check available, but a same-UID actor can
            # still replace the leaf between fstatat and unlinkat.
            removed: i64 = native_unlinkat(directory, leaf_name, 0)
            remove_errno: i64 = NativeErrors::current_errno()
            return close_two_error(directory, fd, NativeErrors::negative_value(remove_errno)) if removed != 0
            sync_status: i64 = native_fsync(directory)
            sync_errno: i64 = NativeErrors::current_errno()
            if sync_status != 0:
                return close_two_error(directory, fd, NativeErrors::negative_value(sync_errno))
            directory_close: i64 = native_close(directory)
            fd_close: i64 = native_close(fd)
            return -5 if directory_close != 0 or fd_close != 0
            return 0

        def unlink_kind(path: cstr, flags: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot.push(leaf[index])
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            directory: i64 = open_directory_path(parent_name)
            return directory if directory < 0
            leaf_c: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                leaf_c.push(leaf_snapshot[index])
            leaf_c.push(0)
            leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            result: i64 = native_unlinkat(directory, leaf_name, flags)
            errno_value: i64 = NativeErrors::error_code()
            if result == 0:
                sync_status: i64 = native_fsync(directory)
                sync_errno: i64 = NativeErrors::error_code()
                return close_result(directory, 0) if sync_status == 0
                return close_error(directory, NativeErrors::negative_value(sync_errno))
            return close_error(directory, NativeErrors::negative_value(errno_value))

        def stat_mode(directory: i64, path: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(stat_buffer_bytes)
            raw: mutable void& = (&out[0]).cast[mutable void&] can Unsafe.PointerCast
            result: i64 = native_fstatat(directory, path, raw, at_no_follow)
            return 0 if result == 0
            return -NativeErrors::error_code()

        def link_or_rename(old_path: cstr, new_path: cstr, is_move: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            old_parent: mutable darray[u8] = []
            old_leaf: mutable darray[u8] = []
            new_parent: mutable darray[u8] = []
            new_leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(old_path, &old_parent, &old_leaf) or not split_parent_leaf(new_path, &new_parent, &new_leaf)
            old_leaf_snapshot: mutable darray[u8] = []
            new_parent_snapshot: mutable darray[u8] = []
            new_leaf_snapshot: mutable darray[u8] = []
            for index in 0..<old_leaf.count |old_leaf_snapshot, old_leaf|:
                old_leaf_snapshot.push(old_leaf[index])
            for index in 0..<new_parent.count |new_parent_snapshot, new_parent|:
                new_parent_snapshot.push(new_parent[index])
            for index in 0..<new_leaf.count |new_leaf_snapshot, new_leaf|:
                new_leaf_snapshot.push(new_leaf[index])
            old_name: cstr = (&old_parent[0]).cast[cstr] can Unsafe.PointerCast
            old_directory: i64 = open_directory_path(old_name)
            return old_directory if old_directory < 0
            new_parent_c: mutable darray[u8] = []
            for index in 0..<new_parent_snapshot.count |new_parent_c, new_parent_snapshot|:
                new_parent_c.push(new_parent_snapshot[index])
            new_name: cstr = (&new_parent_c[0]).cast[cstr] can Unsafe.PointerCast
            new_directory: i64 = open_directory_path(new_name)
            return close_error(old_directory, new_directory) if new_directory < 0
            expected_uid: u64 = native_geteuid().u64()
            # Keep name-based linkat/renameat operations inside directories
            # that other users cannot mutate after the source inode check.
            return close_two_error(old_directory, new_directory, -13) if not trusted_directory_fd(old_directory, expected_uid) or not trusted_directory_fd(new_directory, expected_uid)
            old_leaf_c: mutable darray[u8] = []
            for index in 0..<old_leaf_snapshot.count |old_leaf_c, old_leaf_snapshot|:
                old_leaf_c.push(old_leaf_snapshot[index])
            old_leaf_name: cstr = (&old_leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            source_fd: i64 = open_regular_file_at(old_directory, old_leaf_name)
            return close_two_error(old_directory, new_directory, -21 if source_fd == -unsupported_file_type_error else source_fd) if source_fd < 0
            source_regular: bool = trusted_regular_fd(source_fd, expected_uid)
            source_close_status: i64 = native_close(source_fd)
            return close_two_error(old_directory, new_directory, -5) if source_close_status != 0
            return close_two_error(old_directory, new_directory, -21) if not source_regular
            new_leaf_c: mutable darray[u8] = []
            for index in 0..<new_leaf_snapshot.count |new_leaf_c, new_leaf_snapshot|:
                new_leaf_c.push(new_leaf_snapshot[index])
            new_leaf_name: cstr = (&new_leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            new_stat: mutable darray[u8] = []
            new_stat.resize(stat_buffer_bytes)
            new_stat_raw: mutable void& = (&new_stat[0]).cast[mutable void&] can Unsafe.PointerCast
            new_result: i64 = native_fstatat(new_directory, new_leaf_name, new_stat_raw, at_no_follow)
            new_errno: i64 = NativeErrors::error_code()
            result: mutable i64 = 0
            if is_move:
                if new_result == 0:
                    new_mode: u64 = NativeStat::mode(new_stat)
                    return close_two_error(old_directory, new_directory, -40) if (new_mode & NativeStat::file_type_mask) == symlink_mode
                    return close_two_error(old_directory, new_directory, -21) if (new_mode & NativeStat::file_type_mask) != regular_mode
                if new_result != 0 and new_errno != 2:
                    return close_two_error(old_directory, new_directory, -new_errno)
                old_move_leaf: mutable darray[u8] = []
                new_move_leaf: mutable darray[u8] = []
                for index in 0..<old_leaf_snapshot.count |old_move_leaf, old_leaf_snapshot|:
                    old_move_leaf.push(old_leaf_snapshot[index])
                for index in 0..<new_leaf_snapshot.count |new_move_leaf, new_leaf_snapshot|:
                    new_move_leaf.push(new_leaf_snapshot[index])
                old_move_name: cstr = (&old_move_leaf[0]).cast[cstr] can Unsafe.PointerCast
                new_move_name: cstr = (&new_move_leaf[0]).cast[cstr] can Unsafe.PointerCast
                result <- native_renameat(old_directory, old_move_name, new_directory, new_move_name)
            else:
                return close_two_error(old_directory, new_directory, -17) if new_result == 0
                return close_two_error(old_directory, new_directory, -new_errno) if new_result != 0 and new_errno != 2
                old_link_leaf: mutable darray[u8] = []
                new_link_leaf: mutable darray[u8] = []
                for index in 0..<old_leaf_snapshot.count |old_link_leaf, old_leaf_snapshot|:
                    old_link_leaf.push(old_leaf_snapshot[index])
                for index in 0..<new_leaf_snapshot.count |new_link_leaf, new_leaf_snapshot|:
                    new_link_leaf.push(new_leaf_snapshot[index])
                old_link_name: cstr = (&old_link_leaf[0]).cast[cstr] can Unsafe.PointerCast
                new_link_name: cstr = (&new_link_leaf[0]).cast[cstr] can Unsafe.PointerCast
                result <- native_linkat(old_directory, old_link_name, new_directory, new_link_name, 0)
            errno_value: i64 = NativeErrors::error_code()
            return close_two_result(old_directory, new_directory, 0) if result == 0
            return close_two_error(old_directory, new_directory, NativeErrors::negative_value(errno_value))

    public:
        def close_two_error(left: i64, right: i64, errno_value: i64) -> i64:
            left_status: i64 = native_close(left)
            right_status: i64 = native_close(right)
            return -5 if left_status != 0 or right_status != 0
            return errno_value

    private:
    public:
        def close_three_error(first: i64, second: i64, third: i64, errno_value: i64) -> i64:
            first_status: i32 = native_close(first)
            second_status: i32 = native_close(second)
            third_status: i32 = native_close(third)
            return -5 if first_status != 0 or second_status != 0 or third_status != 0
            return errno_value

    private:
        def close_two_result(left: i64, right: i64, result: i64) -> i64:
            left_status: i64 = native_close(left)
            right_status: i64 = native_close(right)
            return -5 if left_status != 0 or right_status != 0
            return result

        def trusted_fd(fd: i64, expected_uid: u64, expected_kind: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stat: mutable darray[u8] = []
            stat.resize(stat_buffer_bytes)
            raw: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            return false if native_fstat(fd, raw) != 0
            mode: u64 = NativeStat::mode(stat)
            owner: u64 = NativeStat::owner(stat)
            return false if (mode & NativeStat::file_type_mask) != expected_kind or (owner != 0.u64() and owner != expected_uid)
            return (mode & NativeStat::group_or_other_write_mask) == 0.u64()

        def trusted_crypto_executable_path(path: cstr, expected_uid: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return false if not split_parent_leaf(path, &parent, &leaf)
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            directory: i64 = open_crypto_trusted_directory(parent_name, expected_uid)
            return false if directory < 0
            leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = open_regular_file_at(directory, leaf_name)
            if fd < 0:
                _ = native_close(directory)
                return false
            trusted: mutable bool = trusted_regular_fd(fd, expected_uid)
            if trusted:
                trusted <- effective_execute_at(directory, leaf_name, fd) == 0
            file_close_status: i32 = native_close(fd)
            directory_close_status: i32 = native_close(directory)
            return false if file_close_status != 0 or directory_close_status != 0
            return trusted

        # libc applies effective-credential and ACL rules that cannot be
        # reproduced by inspecting mode bits. The parent descriptor is held
        # by the caller, O_NOFOLLOW was used to open the leaf, and the final
        # no-follow stat confirms the access check still refers to that inode.
        def effective_execute_at(directory: i64, leaf_name: cstr, fd: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            fd_stat: mutable darray[u8] = []
            fd_stat.resize(stat_buffer_bytes)
            fd_stat_raw: mutable void& = (&fd_stat[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstat(fd, fd_stat_raw) != 0:
                return NativeErrors::negative_errno()
            return -21 if (NativeStat::file_type(fd_stat)) != regular_mode
            access_status: i32 = native_faccessat(directory.i32(), leaf_name, 1, access_effective_ids + access_no_follow)
            return NativeErrors::negative_errno() if access_status != 0
            path_stat: mutable darray[u8] = []
            path_stat.resize(stat_buffer_bytes)
            path_stat_raw: mutable void& = (&path_stat[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstatat(directory, leaf_name, path_stat_raw, at_no_follow) != 0:
                return NativeErrors::negative_errno()
            return -21 if (NativeStat::file_type(path_stat)) != regular_mode
            return -13 if not NativeStat::same_identity(path_stat, fd_stat)
            return 0

        def trusted_regular_fd(fd: i64, expected_uid: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return trusted_fd(fd, expected_uid, regular_mode) and trusted_acl_fd(fd, false)

        def trusted_directory_fd(fd: i64, expected_uid: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return trusted_fd(fd, expected_uid, directory_mode) and trusted_acl_fd(fd, true)

    public:
        def private_staging_directory_fd(fd: i64, expected_uid: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stat: mutable darray[u8] = []
            stat.resize(stat_buffer_bytes)
            raw: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            return false if native_fstat(fd, raw) != 0
            mode: u64 = NativeStat::mode(stat)
            owner: u64 = NativeStat::owner(stat)
            # mkdtemp creates staging roots as euid-owned 0700 directories.
            # Reject special bits and every group/other permission as well.
            return false if (mode & NativeStat::file_type_mask) != directory_mode or owner != expected_uid or (mode & 4095.u64()) != 448.u64()
            return trusted_acl_fd(fd, true)

    private:
        def trusted_acl_fd(fd: i64, is_directory: bool) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            static if ELISA_TARGET_OS_MACOS:
                native_errno()[0] <- 0
                if native_acl_get_fd_np(fd.i32(), 256) is acl:
                    entry_slot: mutable darray[u8&?] = [null]
                    entry_out: mutable void& = (&entry_slot[0]).cast[mutable void&] can Unsafe.PointerCast
                    entry_id: mutable i32 = 0
                    safe: mutable bool = true
                    while safe:
                        native_errno()[0] <- 0
                        entry_status: i32 = native_acl_get_entry(acl, entry_id, entry_out)
                        if entry_status == 0:
                            entry_id <- -1
                            if entry_slot[0] is entry:
                                tag: mutable i32 = 0
                                if native_acl_get_tag_type(entry, &tag) != 0 or tag != 2:
                                    # ACL_EXTENDED_DENY is the only extended
                                    # ACE accepted. Any allow or unknown tag
                                    # could grant mutation outside mode bits.
                                    safe <- false
                            else:
                                safe <- false
                        else:
                            end_errno: i64 = NativeErrors::current_errno()
                            if entry_id == -1 and end_errno == 22:
                                break
                            safe <- false
                    acl_value: void& = acl.cast[void&] can Unsafe.PointerCast
                    return native_acl_free(acl_value) == 0 and safe
                return NativeErrors::current_errno() == 2
            static elif ELISA_TARGET_OS_LINUX:
                return trusted_linux_acl_fd(fd, is_directory)
            static else:
                return true

        # Linux stores POSIX access/default ACLs in xattrs. Inspect the already
        # opened inode so pathname replacement cannot change the policy being
        # checked. Any named user/group entry is rejected, even when read-only;
        # base ACL permissions must also remain non-writable outside the owner
        # class. A default ACL can affect future children, so trusted
        # directories carrying one fail closed.
        static if ELISA_TARGET_OS_LINUX:
            def trusted_linux_acl_fd(fd: i64, is_directory: bool) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
                access_acl: mutable darray[u8] = []
                access_status: i64 = read_linux_acl_xattr(fd, "system.posix_acl_access", &access_acl)
                return false if access_status < 0
                return false if access_status == 1 and not LinuxAccessAcl::is_safe(access_acl)
                if is_directory:
                    default_acl: mutable darray[u8] = []
                    default_status: i64 = read_linux_acl_xattr(fd, "system.posix_acl_default", &default_acl)
                    return false if default_status < 0 or default_status == 1
                return true

            # Return 0 for an absent/unsupported POSIX ACL attribute, 1 for a
            # bounded value, and -1 for every other read or format failure.
            # ENOTSUP means this filesystem cannot store the ACL class being
            # queried; inability to read an existing attribute is not treated
            # as absence.
            def read_linux_acl_xattr(fd: i64, name: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
                out.resize(0)
                out.resize(LinuxAccessAcl::read_capacity)
                loaded: i64 =
                    raw: mutable void& = (&out[0]).cast[mutable void&] can Unsafe.PointerCast
                    native_errno()[0] <- 0
                    native_fgetxattr(fd.i32(), name, raw, out.count)
                if loaded < 0:
                    errno_value: i64 = NativeErrors::current_errno()
                    out.resize(0)
                    return 0 if errno_value == 61 or errno_value == 95
                    return -1
                if loaded < 4 or loaded > LinuxAccessAcl::read_capacity.i64() or (loaded - 4) % 8 != 0:
                    out.resize(0)
                    return -1
                out.resize(loaded.usize())
                return 1

        def open_trusted_directory(path: cstr, expected_uid: u64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return walk_trusted_directory(path, expected_uid, false)

        def walk_trusted_directory(path: cstr, expected_uid: u64, create_missing: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096 or path[0].u8() != 47
            path_copy: mutable darray[u8] = []
            for index in 0..<length |path_copy, path|:
                path_copy.push(path[index].u8())
            path_copy.push(0)
            effective_length: mutable usize = length
            while effective_length > 1.usize() and path_copy[effective_length - 1.usize()] == 47:
                effective_length <- effective_length - 1.usize()
            directory: mutable i64 = native_open("/", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            if not trusted_directory_fd(directory, expected_uid):
                return close_error(directory, -13)
            start: mutable usize = 1.usize()
            while start < effective_length:
                finish: mutable usize = start
                while finish < effective_length and path_copy[finish] != 47 |path_copy, finish|:
                    finish <- finish + 1.usize()
                return close_error(directory, -22) if finish == start
                part_storage: mutable darray[u8] = []
                for index in start..<finish |part_storage, path_copy|:
                    part_storage.push(path_copy[index])
                part_storage.push(0)
                part: cstr = (&part_storage[0]).cast[cstr] can Unsafe.PointerCast
                return close_error(directory, -22) if cstr_equal(part, ".") or cstr_equal(part, "..")
                next: mutable i64 = native_openat(directory, part, flags_directory() + flag_no_follow)
                needs_parent_sync: bool = next < 0 and create_missing and NativeErrors::current_errno() == 2
                if needs_parent_sync:
                    created: i32 = native_mkdirat(directory, part, 493)
                    return close_error(directory, NativeErrors::negative_errno()) if created != 0 and NativeErrors::current_errno() != 17
                    next <- native_openat(directory, part, flags_directory() + flag_no_follow)
                return close_error(directory, NativeErrors::negative_errno()) if next < 0
                if not trusted_directory_fd(next, expected_uid):
                    return close_two_error(directory, next, -13)
                # An EEXIST result may come from another installer that
                # created the directory but has not synced the parent yet.
                if needs_parent_sync and native_fsync(directory) != 0:
                    return close_two_error(directory, next, NativeErrors::negative_errno())
                return close_error(next, -5) if native_close(directory) != 0
                directory <- next
                break if finish == effective_length
                start <- finish + 1.usize()
                return close_error(directory, -22) if start == effective_length or path_copy[start] == 47
            return directory

        # Crypto providers may live below a Homebrew prefix whose euid-owned
        # Cellar directories are group-writable (for example 0775). Permit
        # that only for a non-root caller, and only when the owner is exactly
        # that caller and the directory is not writable by other users. Root-
        # owned ancestors retain the strict trusted-directory policy; root
        # execution therefore never trusts a user-owned Homebrew tree.
        def crypto_trusted_directory_fd(fd: i64, expected_uid: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stat: mutable darray[u8] = []
            stat.resize(stat_buffer_bytes)
            raw: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            return false if native_fstat(fd, raw) != 0
            mode: u64 = NativeStat::mode(stat)
            owner: u64 = NativeStat::owner(stat)
            return false if (mode & NativeStat::file_type_mask) != directory_mode
            if owner == 0.u64():
                return false if (mode & NativeStat::group_or_other_write_mask) != 0.u64()
            else:
                return false if expected_uid == 0.u64() or owner != expected_uid
                return false if (mode & 2.u64()) != 0.u64()
                if (mode & 16.u64()) != 0.u64():
                    # Homebrew's default Apple Silicon Cellar may be group-
                    # writable by macOS administrators. Accept that boundary
                    # only for the well-known `admin` group; members can
                    # already obtain root, while ordinary local accounts
                    # cannot replace the provider through this directory.
                    static if ELISA_TARGET_OS_MACOS:
                        return false if NativeStat::group(stat) != macos_admin_gid()
                    static else:
                        return false
            return trusted_acl_fd(fd, true)

        def macos_admin_gid() -> u64:
            static if ELISA_TARGET_OS_MACOS:
                group_name: cstr = "admin"
                if native_getgrnam(group_name) is group:
                    raw: mutable u8& = group.cast[mutable u8&] can Unsafe.PointerCast
                    return raw[16].u64() + raw[17].u64() * 256.u64() + raw[18].u64() * 65536.u64() + raw[19].u64() * 16777216.u64()
            return 18446744073709551615

        def open_crypto_trusted_directory(path: cstr, expected_uid: u64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096 or path[0].u8() != 47
            path_copy: mutable darray[u8] = []
            for index in 0..<length |path_copy, path|:
                path_copy.push(path[index].u8())
            path_copy.push(0)
            effective_length: mutable usize = length
            while effective_length > 1.usize() and path_copy[effective_length - 1.usize()] == 47:
                effective_length <- effective_length - 1.usize()
            directory: mutable i64 = native_open("/", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            if not crypto_trusted_directory_fd(directory, expected_uid):
                return close_error(directory, -13)
            start: mutable usize = 1.usize()
            while start < effective_length:
                finish: mutable usize = start
                while finish < effective_length and path_copy[finish] != 47 |path_copy, finish|:
                    finish <- finish + 1.usize()
                return close_error(directory, -22) if finish == start
                part_storage: mutable darray[u8] = []
                for index in start..<finish |part_storage, path_copy|:
                    part_storage.push(path_copy[index])
                part_storage.push(0)
                part: cstr = (&part_storage[0]).cast[cstr] can Unsafe.PointerCast
                return close_error(directory, -22) if cstr_equal(part, ".") or cstr_equal(part, "..")
                next: i64 = native_openat(directory, part, flags_directory() + flag_no_follow)
                return close_error(directory, -NativeErrors::error_code()) if next < 0
                if not crypto_trusted_directory_fd(next, expected_uid):
                    return close_two_error(directory, next, -13)
                return close_error(directory, -5) if native_close(directory) != 0
                directory <- next
                break if finish == effective_length
                start <- finish + 1.usize()
                return close_error(directory, -22) if start == effective_length or path_copy[start] == 47
            return directory

    public:
        def regular_fd(fd: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stat: mutable darray[u8] = []
            stat.resize(stat_buffer_bytes)
            raw: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            return native_fstat(fd, raw) == 0 and (NativeStat::file_type(stat)) == regular_mode

    private:
        def collect_directory(root: cstr, path: cstr, out: mutable darray[u8]&, depth: usize, visited_nodes: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if depth > 64.usize()
            # Resolve the directory through the descriptor-relative no-follow
            # walker before enumeration. Opening `path` with `opendir` here
            # would re-follow a swapped symlink after the caller's probe.
            directory_fd: i64 = open_package_directory_path(path)
            return false if directory_fd < 0
            duplicate: i64 = native_dup(directory_fd)
            if duplicate < 0:
                _ = native_close(directory_fd)
                return false
            directory: mutable heap void&? = native_fdopendir(duplicate)
            directory_close_status: i64 = native_close(directory_fd)
            if directory_close_status != 0:
                if directory is stream:
                    _ = native_closedir(stream)
                else:
                    _ = native_close(duplicate)
                return false
            if directory is stream:
                while true |stream, out, path, depth, visited_nodes|:
                    native_errno()[0] <- 0
                    entry: mutable heap void&? = native_readdir(stream)
                    if entry is record:
                        raw: mutable u8& = record.cast[mutable u8&] can Unsafe.PointerCast
                        name_length: usize = dirent_name_length(raw)
                        return directory_failure(stream) if name_length == 0 or name_length > 255.usize()
                        continue if name_is_dot(raw, dirent_name_offset, name_length)
                        visited_nodes <- visited_nodes + 1.usize()
                        return directory_failure(stream) if visited_nodes > max_collect_traversal_nodes
                        # Some filesystems report DT_UNKNOWN. Credential
                        # exclusions must therefore not depend on d_type.
                        child: mutable darray[u8] = []
                        if not cstr_equal(path, "."):
                            parent_length: usize = path_length(path)
                            for index in 0..<parent_length |child, path|:
                                child.push(path[index].u8())
                            child.push(47) if parent_length == 0 or path[parent_length - 1.usize()].u8() != 47
                        for index in 0..<name_length |child, raw|:
                            child.push(raw[dirent_name_offset + index])
                        child.push(0)
                        child_name: cstr = (&child[0]).cast[cstr] can Unsafe.PointerCast
                        child_length: usize = path_length(child_name)
                        return directory_failure(stream) if child_length == 0 or child_length > 4096.usize()
                        relative_policy_path: mutable darray[u8] = []
                        return directory_failure(stream) if not relative_path_under(root, child_name, &relative_policy_path)
                        continue if PackagePathPolicy::credential_path_forbidden(relative_policy_path)
                        continue if PackagePathPolicy::reserved_source_path_forbidden(relative_policy_path)
                        directory_probe: i64 = open_package_directory_path(child_name)
                        if directory_probe >= 0:
                            return directory_failure(stream) if native_close(directory_probe) != 0
                            return directory_failure(stream) if not collect_directory(root, child_name, out, depth + 1.usize(), visited_nodes)
                        else:
                            file_probe: i64 = open_package_file(child_name)
                            if file_probe < 0:
                                # The directory probe already ruled out a
                                # stable directory. Any failed file open means
                                # the entry changed or was unsafe; skipping it
                                # would produce an incomplete source digest.
                                return directory_failure(stream)
                            regular: bool = regular_fd(file_probe)
                            close_status: i64 = native_close(file_probe)
                            return directory_failure(stream) if not regular or close_status != 0
                            return directory_failure(stream) if out.count + child_length + 1.usize() > 16777216.usize()
                            for index in 0..<child_length |out, child_name|:
                                out.push(child_name[index].u8())
                            out.push(0)
                    else:
                        return directory_failure(stream) if NativeErrors::current_errno() != 0
                        break
                return native_closedir(stream) == 0
            _ = native_close(duplicate)
            return false

        def directory_failure(stream: heap void&) -> bool:
            _ = native_closedir(stream)
            return false

        def path_length(path: cstr) -> usize:
            return native_strlen(path)

        def relative_path_under(root: cstr, path: cstr, out: mutable darray[u8]&) -> bool:
            out.resize(0)
            root_length: usize = native_strlen(root)
            path_length_value: usize = native_strlen(path)
            if cstr_equal(root, "."):
                return false if path_length_value == 0 or path_length_value > 4096
                for index in 0..<path_length_value |out, path|:
                    out.push(path[index].u8())
                return true
            return false if root_length == 0 or path_length_value <= root_length or path_length_value > 4096
            for index in 0..<root_length |root, path|:
                return false if root[index].u8() != path[index].u8()
            relative_start: mutable usize = root_length
            if root[root_length - 1].u8() != 47:
                return false if path[root_length].u8() != 47
                relative_start <- root_length + 1.usize()
            for index in relative_start..<path_length_value |out, path|:
                out.push(path[index].u8())
            return out.count > 0.usize()

        def name_is_dot(raw: mutable u8&, offset: usize, length: usize) -> bool:
            return length == 1 and raw[offset] == 46 or length == 2 and raw[offset] == 46 and raw[offset + 1] == 46
