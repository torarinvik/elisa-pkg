                    right: mutable u8 = wanted[index]
                    left <- left + 32 if left >= 65 and left <= 90
                    right <- right + 32 if right >= 65 and right <= 90
                    matches <- false if left != right
                if matches:
                    return true if end - cursor == wanted.count or common < wanted.count and wanted[common] == 47 or common < end - cursor and seen[cursor + common] == 47
                cursor <- end + 1.usize()
            return false

        def archive_open_parent(root: i64, name: darray[u8]&, copy_out: mutable darray[u8]&, leaf_offset: mutable usize&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            for index in 0..<name.count |copy_out, name|:
                copy_out.push(name[index])
            copy_out.push(0)
            slash: mutable usize = 0.usize()
            for index in 0..<name.count |copy_out, slash|:
                slash <- index + 1.usize() if copy_out[index] == 47
            leaf_offset <- slash
            return -22 if leaf_offset >= name.count
            directory: mutable i64 = native_dup(root)
            return negative_errno() if directory < 0
            start: mutable usize = 0.usize()
            while start < leaf_offset:
                finish: mutable usize = start
                while finish < leaf_offset and copy_out[finish] != 47:
                    finish <- finish + 1.usize()
                copy_out[finish] <- 0
                part: cstr = (&copy_out[start]).cast[cstr] can Unsafe.PointerCast
                next: mutable i64 = native_openat(directory, part, flags_directory() + flag_no_follow)
                if next < 0 and native_errno() == 2:
                    if native_mkdirat(directory, part, 493) != 0 and native_errno() != 17:
                        return close_error(directory, negative_errno())
                    next <- native_openat(directory, part, flags_directory() + flag_no_follow)
                return close_error(directory, negative_errno()) if next < 0
                _ = native_close(directory)
                directory <- next
                start <- finish + 1.usize()
            return directory

        def extraction_failure(root: i64, seen: darray[u8]&, errno_value: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            cleanup_archive_files(root, seen)
            _ = native_close(root)
            return errno_value

        def cleanup_archive_files(root: i64, seen: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            cursor: mutable usize = 0.usize()
            while cursor < seen.count:
                end: mutable usize = cursor
                while end < seen.count and seen[end] != 0:
                    end <- end + 1.usize()
                name: mutable darray[u8] = []
                for index in cursor..<end |name, seen|:
                    name.push(seen[index])
                copy: mutable darray[u8] = []
                leaf_offset: mutable usize = 0.usize()
                parent: i64 = archive_open_parent(root, name, &copy, &leaf_offset)
                if parent >= 0:
                    leaf: cstr = (&copy[leaf_offset]).cast[cstr] can Unsafe.PointerCast
                    _ = native_unlinkat(parent, leaf, 0)
                    _ = native_close(parent)
                cursor <- end + 1.usize()

        const flag_read_only: i64 = 0
        const flag_write_only: i64 = 1
        const flag_read_write: i64 = 2
        const flag_nonblock: i64 = 4
        const flag_no_follow: i64 = 256
        const flag_create: i64 = 512
        const flag_exclusive: i64 = 2048
        const flag_directory: i64 = 1048576
        const flag_close_on_exec: i64 = 16777216
        const at_remove_directory: i64 = 2
        const at_no_follow: i64 = 32
        const regular_mode: u64 = 32768
        const directory_mode: u64 = 16384
        const symlink_mode: u64 = 40960

        def flags_directory() -> i64:
            return flag_read_only + flag_directory + flag_close_on_exec

        def flags_read_no_follow() -> i64:
            return flag_read_only + flag_no_follow + flag_close_on_exec

        def flags_file_read() -> i64:
            return flag_read_only + flag_no_follow + flag_close_on_exec + flag_nonblock

        def flags_read_write_create_exclusive() -> i64:
            return flag_read_write + flag_create + flag_exclusive + flag_no_follow + flag_close_on_exec

        def flags_write_create_exclusive() -> i64:
            return flag_write_only + flag_create + flag_exclusive + flag_no_follow + flag_close_on_exec

        def error_code() -> i64:
            value: i64 = native_errno()
            return value if value > 0 else 5

        def negative_errno() -> i64:
            value: i64 = native_errno()
            return -value if value > 0 else -5

        def cstr_equal(left: cstr, right: cstr) -> bool:
            left_length: usize = native_strlen(left)
            right_length: usize = native_strlen(right)
            return false if left_length != right_length
            for index in 0..<left_length |left, right|:
                return false if left[index].u8() != right[index].u8()
            return true

        def split_parent_leaf(path: cstr, parent: mutable darray[u8]&, leaf: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return false if length == 0 or length > 4096
            slash: mutable usize = length
            while slash > 0 and path[slash - 1].u8() != 47:
                slash <- slash - 1.usize()
            leaf_start: usize = slash
            return false if leaf_start == length
            for index in leaf_start..<length |path, leaf|:
                leaf.push(path[index].u8())
            leaf.push(0)
            leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
            return false if leaf.count <= 1.usize() or cstr_equal(leaf_name, ".") or cstr_equal(leaf_name, "..")
            if slash == 0:
                parent.push(46)
            elif slash == 1 and path[0].u8() == 47:
                parent.push(47)
            else:
                for index in 0..<slash |path, parent|:
                    parent.push(path[index].u8())
            parent.push(0)
            return true

        def open_directory_path(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096
            path_copy: mutable darray[u8] = []
            for index in 0..<length |path_copy, path|:
                path_copy.push(path[index].u8())
            path_copy.push(0)
            absolute: bool = path_copy[0] == 47
            directory: mutable i64 = native_open("/" if absolute else ".", flags_directory())
            return -error_code() if directory < 0
            start: mutable usize = 0.usize()
            while start < length and path_copy[start] == 47 |path_copy, start|:
                start <- start + 1.usize()
            while start < length:
                finish: mutable usize = start
                while finish < length and path_copy[finish] != 47 |path_copy, finish|:
                    finish <- finish + 1.usize()
                path_copy[finish] <- 0
                part: cstr = (&path_copy[start]).cast[cstr] can Unsafe.PointerCast
                if not cstr_equal(part, "."):
                    return close_error(directory, -22) if cstr_equal(part, "..")
                    next: i64 = native_openat(directory, part, flags_directory() + flag_no_follow)
                    return close_error(directory, -error_code()) if next < 0
                    _ = native_close(directory)
                    directory <- next
                start <- finish + 1.usize()
            while start < length and path_copy[start] == 47 |path_copy, start|:
                    start <- start + 1.usize()
            return directory

        def open_package_file(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096
            path_copy: mutable darray[u8] = []
            for index in 0..<length |path_copy, path|:
                path_copy.push(path[index].u8())
            path_copy.push(0)
            absolute: bool = path_copy[0] == 47
            directory: mutable i64 = native_open("/" if absolute else ".", flags_directory())
            return -error_code() if directory < 0
            start: mutable usize = 0.usize()
            while start < length and path_copy[start] == 47 |path_copy, start|:
                start <- start + 1.usize()
            while start < length:
                finish: mutable usize = start
                while finish < length and path_copy[finish] != 47 |path_copy, finish|:
                    finish <- finish + 1.usize()
                had_slash: bool = finish < length
                path_copy[finish] <- 0
                part: cstr = (&path_copy[start]).cast[cstr] can Unsafe.PointerCast
                return close_error(directory, -22) if cstr_equal(part, "") or cstr_equal(part, "..")
                flags: i64 = flags_file_read() + (flag_directory if had_slash else 0)
                next: i64 = native_openat(directory, part, flags)
                return close_error(directory, -error_code()) if next < 0
                _ = native_close(directory)
                directory <- next
                return directory if not had_slash
                start <- finish + 1.usize()
                while start < length and path_copy[start] == 47 |path_copy, start|:
                    start <- start + 1.usize()
            _ = native_close(directory)
            return -22

        def close_error(fd: i64, errno_value: i64) -> i64:
            _ = native_close(fd)
            return errno_value

        def unlink_kind(path: cstr, flags: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
            directory: i64 = open_directory_path(parent_name)
            return directory if directory < 0
            result: i64 = native_unlinkat(directory, leaf_name, flags)
            errno_value: i64 = error_code()
            _ = native_close(directory)
            return 0 if result == 0 else -errno_value

        def stat_mode(directory: i64, path: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(144)
            raw: mutable void& = (&out[0]).cast[mutable void&] can Unsafe.PointerCast
            result: i64 = native_fstatat(directory, path, raw, at_no_follow)
            return 0 if result == 0
            return -error_code()

        def link_or_rename(old_path: cstr, new_path: cstr, is_move: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            old_parent: mutable darray[u8] = []
            old_leaf: mutable darray[u8] = []
            new_parent: mutable darray[u8] = []
            new_leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(old_path, &old_parent, &old_leaf) or not split_parent_leaf(new_path, &new_parent, &new_leaf)
            old_name: cstr = (&old_parent[0]).cast[cstr] can Unsafe.PointerCast
            old_leaf_name: cstr = (&old_leaf[0]).cast[cstr] can Unsafe.PointerCast
            new_name: cstr = (&new_parent[0]).cast[cstr] can Unsafe.PointerCast
            new_leaf_name: cstr = (&new_leaf[0]).cast[cstr] can Unsafe.PointerCast
            old_directory: i64 = open_directory_path(old_name)
            return old_directory if old_directory < 0
            new_directory: i64 = open_directory_path(new_name)
            return close_two_error(old_directory, new_directory, new_directory) if new_directory < 0
            old_stat: mutable darray[u8] = []
            return close_two_error(old_directory, new_directory, -5) if stat_mode(old_directory, old_leaf_name, &old_stat) != 0
            old_mode: u64 = read_u16(old_stat, 4)
            return close_two_error(old_directory, new_directory, -22) if (old_mode & 61440.u64()) != regular_mode
            new_stat: mutable darray[u8] = []
            new_result: i64 = stat_mode(new_directory, new_leaf_name, &new_stat)
            result: mutable i64 = 0
            if is_move:
                if new_result == 0:
                    new_mode: u64 = read_u16(new_stat, 4)
                    return close_two_error(old_directory, new_directory, -40) if (new_mode & 61440.u64()) == symlink_mode
                    return close_two_error(old_directory, new_directory, -21) if (new_mode & 61440.u64()) != regular_mode
                elif new_result != -2:
                    return close_two_error(old_directory, new_directory, new_result)
                result <- native_renameat(old_directory, old_leaf_name, new_directory, new_leaf_name)
            else:
                return close_two_error(old_directory, new_directory, -17) if new_result == 0
                return close_two_error(old_directory, new_directory, new_result) if new_result != -2
                result <- native_linkat(old_directory, old_leaf_name, new_directory, new_leaf_name, 0)
            errno_value: i64 = error_code()
            _ = native_close(old_directory)
            _ = native_close(new_directory)
            return 0 if result == 0 else -errno_value

        def close_two_error(left: i64, right: i64, errno_value: i64) -> i64:
            _ = native_close(left)
            _ = native_close(right)
            return errno_value

        def read_u16(value: darray[u8]&, offset: usize) -> u64:
            return value[offset].u64() + value[offset + 1.usize()].u64() * 256.u64()

        def regular_fd(fd: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stat: mutable darray[u8] = []
            stat.resize(144)
            raw: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            return native_fstat(fd, raw) == 0 and (read_u16(stat, 4) & 61440.u64()) == regular_mode

        def limit_bytes(value: i64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            out: mutable darray[u8] = []
            out.resize(16)
            unsigned: mutable u64 = value.u64()
            for index in 0..<8 |out, unsigned|:
                out[index] <- (unsigned & 255.u64()).u8()
                unsigned <- unsigned / 256.u64()
            for index in 8..<16 |out|:
                out[index] <- out[index - 8.usize()]
            return out

        def timespec_bytes(seconds: i64, nanoseconds: i64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            out: mutable darray[u8] = []
            out.resize(16)
            values: darray[i64] = [seconds, nanoseconds]
            for word in 0..<2 |out, values, word|:
                value: mutable u64 = values[word].u64()
                for byte in 0..<8 |out, value, word, byte|:
                    out[word * 8.usize() + byte] <- (value & 255.u64()).u8()
                    value <- value / 256.u64()
            return out

        def monotonic_milliseconds() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stamp: mutable darray[u8] = []
            stamp.resize(16)
            raw: mutable void& = (&stamp[0]).cast[mutable void&] can Unsafe.PointerCast
            return -1 if native_clock_gettime(6, raw) != 0
            seconds: i64 = read_i64(stamp, 0)
            nanos: i64 = read_i64(stamp, 8)
            return 9223372036854775807 if seconds > 9223372036854775
            return seconds * 1000 + nanos / 1000000

        def read_i64(value: darray[u8]&, offset: usize) -> i64:
            out: mutable u64 = 0
            for index in 0..<8 |value, offset, out, index|:
                out <- out + (value[offset + index].u64() << (index * 8.usize()))
            return out.i64()

        def collect_directory(path: cstr, out: mutable darray[u8]&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if depth > 64.usize()
            directory: mutable heap void&? = native_opendir(path)
            if directory is stream:
                while true |stream, out, path, depth|:
                    entry: mutable heap void&? = native_readdir(stream)
                    if entry is record:
                        raw: mutable u8& = record.cast[mutable u8&] can Unsafe.PointerCast
                        name_length: usize = raw[18].usize() + raw[19].usize() * 256.usize()
                        continue if name_length == 0 or name_length > 255.usize()
                        continue if (raw[20] == 4) or (raw[20] == 8 and forbidden_file_name(raw, 21, name_length))
                        continue if name_is_dot(raw, 21, name_length)
                        child: mutable darray[u8] = []
                        if not cstr_equal(path, "."):
                            for index in 0..<path_length(path) |child, path|:
                                child.push(path[index].u8())
                            child.push(47)
                        for index in 0..<name_length |child, raw|:
                            child.push(raw[21 + index])
                        child.push(0)
                        child_name: cstr = (&child[0]).cast[cstr] can Unsafe.PointerCast
                        child_length: usize = path_length(child_name)
                        return false if child_length == 0 or child_length > 4096.usize()
                        if raw[20] == 4:
                            continue if skip_directory(child_name)
                            continue if not collect_directory(child_name, out, depth + 1.usize())
                        elif raw[20] == 8:
                            continue if skip_file(child_name)
                            return false if out.count + child_length + 1.usize() > 16777216.usize()
                            for index in 0..<child_length |out, child_name|:
                                out.push(child_name[index].u8())
                            out.push(0)
                        else:
                            break
                    else:
                        break
                _ = native_closedir(stream)
                return true
            return false

        def path_length(path: cstr) -> usize:
            return native_strlen(path)

        def path_less(left: darray[u8]&, right: darray[u8]&) -> bool:
            limit: usize = left.count if left.count < right.count else right.count
            for index in 0..<limit |left, right|:
                return true if left[index] < right[index]
                return false if left[index] > right[index]
            return left.count < right.count

        def name_is_dot(raw: mutable u8&, offset: usize, length: usize) -> bool:
            return length == 1 and raw[offset] == 46 or length == 2 and raw[offset] == 46 and raw[offset + 1] == 46

        def forbidden_file_name(raw: mutable u8&, offset: usize, length: usize) -> bool:
            return false if length == 0
            return raw[offset] == 46 and length >= 4 and raw[offset + 1] == 101 and raw[offset + 2] == 110 and raw[offset + 3] == 118

        def skip_directory(path: cstr) -> bool:
            return path_has_component(path, ".git") or path_has_component(path, ".hg") or path_has_component(path, ".svn") or path_has_component(path, ".elisapkg") or path_has_component(path, "build") or path_has_component(path, "target")

        def skip_file(path: cstr) -> bool:
            length: usize = native_strlen(path)
            leaf_start: mutable usize = length
            while leaf_start > 0 and path[leaf_start - 1].u8() != 47:
                leaf_start <- leaf_start - 1.usize()
            leaf: cstr = (&path[leaf_start]).cast[cstr] can Unsafe.PointerCast
            return cstr_equal(leaf, "IMPLEMENTATION_PLAN.md") or cstr_equal(leaf, ".netrc") or cstr_equal(leaf, "credentials") or cstr_equal(leaf, "credentials.json") or cstr_equal(leaf, "id_rsa") or cstr_equal(leaf, "id_ed25519") or suffix_equal(leaf, ".pem") or suffix_equal(leaf, ".key")

        def suffix_equal(value: cstr, suffix: cstr) -> bool:
            length: usize = native_strlen(value)
            suffix_length: usize = native_strlen(suffix)
            return false if length < suffix_length
            suffix_start: cstr = (&value[length - suffix_length]).cast[cstr] can Unsafe.PointerCast
            return cstr_equal(suffix_start, suffix)

        def path_has_component(path: cstr, wanted: cstr) -> bool:
            wanted_length: usize = native_strlen(wanted)
            length: usize = native_strlen(path)
            start: mutable usize = 0
            while start < length:
                while start < length and path[start].u8() == 47:
                    start <- start + 1.usize()
                finish: mutable usize = start
                while finish < length and path[finish].u8() != 47:
                    finish <- finish + 1.usize()
                segment: cstr = (&path[start]).cast[cstr] can Unsafe.PointerCast
                return true if finish - start == wanted_length and cstr_equal(segment, wanted)
                start <- finish + 1.usize()
            return false
