                    after.resize(144)
                    after_raw: mutable void& = (&after[0]).cast[mutable void&] can Unsafe.PointerCast
                    if native_fstat(opened, after_raw) != 0:
                        errno_value: i64 = negative_errno()
                        return close_error(opened, errno_value)
                    if (read_u16(after, stat_mode_offset) & 61440.u64()) != regular_mode or read_stat_device(before) != read_stat_device(after) or read_u64(before, 8.usize()) != read_u64(after, 8.usize()):
                        return close_error(opened, -13)
