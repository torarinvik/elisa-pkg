@link_name("fork")
extern native_fork() -> i32
@link_name("execvp")
# C receives `char **` as one pointer-sized argument. Keep its pointer depth
# typed in the Elisa wrapper and erase it only at this private native boundary.
extern native_execvp(path: cstr, argv: void&) -> i32
@link_name("_exit")
extern native_exit(code: i64)
@link_name("setpgid")
extern native_setpgid(pid: i64, group: i64) -> i32
@link_name("getpid")
extern native_getpid() -> i32
@link_name("waitpid")
extern native_waitpid(pid: i64, status: mutable i32&, options: i64) -> i32
@link_name("kill")
extern native_kill(pid: i64, signal: i64) -> i32
@link_name("clock_gettime")
extern native_clock_gettime(clock: i64, timespec: mutable void&) -> i32
@link_name("nanosleep")
extern native_nanosleep(request: void&, remaining: mutable void&) -> i32
@link_name("setrlimit")
extern native_setrlimit(resource: i64, limits: void&) -> i32
static if ELISA_TARGET_OS_LINUX and ELISA_TARGET_ARCH_ARM64:
    # glibc places st_mode at offset 16 on Linux arm64.
    const stat_mode_offset: usize = 16
    const stat_uid_offset: usize = 24
    const stat_gid_offset: usize = 28
static elif ELISA_TARGET_OS_LINUX:
    # glibc places st_mode at offset 24 on Linux x86_64.
    const stat_mode_offset: usize = 24
    const stat_uid_offset: usize = 28
    const stat_gid_offset: usize = 32
static else:
    const stat_mode_offset: usize = 4
    const stat_uid_offset: usize = 16
    const stat_gid_offset: usize = 20

static if ELISA_TARGET_OS_LINUX and ELISA_TARGET_ARCH_ARM64:
    # Linux arm64 defines architecture-specific values for these open flags.
    const flag_no_follow: i64 = 32768
    const flag_directory: i64 = 16384
    static assert (flag_no_follow == 32768 and flag_directory == 16384), "Linux arm64 open flags must match its UAPI"
static elif ELISA_TARGET_OS_LINUX:
    # Linux x86_64 has architecture-specific values for these two flags.
    const flag_no_follow: i64 = 131072
    const flag_directory: i64 = 65536
    static assert (flag_no_follow == 131072 and flag_directory == 65536), "Linux x86_64 open flags must match its ABI"
static else:
    const flag_no_follow: i64 = 256
    const flag_directory: i64 = 1048576

static if ELISA_TARGET_OS_LINUX:
    # Keep operating-system constants in Elisa so the FFI declarations stay
    # ABI-neutral while each supported architecture gets its actual ABI values.
    const flag_read_only: i64 = 0
    const flag_write_only: i64 = 1
    const flag_read_write: i64 = 2
    const flag_nonblock: i64 = 2048
    const flag_create: i64 = 64
    const flag_exclusive: i64 = 128
    const flag_close_on_exec: i64 = 524288
    const dirent_type_offset: usize = 18
    const dirent_name_offset: usize = 19
    const monotonic_clock_id: i64 = 1
    const directory_not_empty_error: i64 = 39
    const symlink_error: i64 = 40
    const unsupported_file_type_error: i64 = 95
    const at_remove_directory: i64 = 512
    const at_no_follow: i64 = 256
    const access_effective_ids: i32 = 512
    const access_no_follow: i32 = 256
    const crypto_key_template: cstr = "/tmp/elisapkg-key.XXXXXX"
    const crypto_message_template: cstr = "/tmp/elisapkg-message.XXXXXX"
    const crypto_signature_template: cstr = "/tmp/elisapkg-signature.XXXXXX"
static else:
    const flag_read_only: i64 = 0
    const flag_write_only: i64 = 1
    const flag_read_write: i64 = 2
    const flag_nonblock: i64 = 4
    const flag_create: i64 = 512
    const flag_exclusive: i64 = 2048
    const flag_close_on_exec: i64 = 16777216
    const stat_mode_offset: usize = 4
    const dirent_type_offset: usize = 20
    const dirent_name_offset: usize = 21
    const monotonic_clock_id: i64 = 6
    const directory_not_empty_error: i64 = 66
    const symlink_error: i64 = 62
    const unsupported_file_type_error: i64 = 45
    const at_remove_directory: i64 = 128
    const at_no_follow: i64 = 32
    const access_effective_ids: i32 = 16
    const access_no_follow: i32 = 32
    const crypto_key_template: cstr = "/private/tmp/elisapkg-key.XXXXXX"
    const crypto_message_template: cstr = "/private/tmp/elisapkg-message.XXXXXX"
    const crypto_signature_template: cstr = "/private/tmp/elisapkg-signature.XXXXXX"

# Linux-only values are kept named even on macOS because the private FFI
# implementation shares one runtime-guarded open path across supported hosts.
static if ELISA_TARGET_OS_LINUX:
    const platform_is_linux: bool = true
    # Linux POSIX ACL xattrs have a four-byte version header followed by at
    # most 32 eight-byte entries (the kernel's ACL_MAX_ENTRIES limit).
    const linux_acl_xattr_capacity: usize = 260
    const linux_acl_xattr_version: u64 = 2
    const linux_acl_tag_user_object: u64 = 1
    const linux_acl_tag_user: u64 = 2
    const linux_acl_tag_group_object: u64 = 4
    const linux_acl_tag_group: u64 = 8
    const linux_acl_tag_mask: u64 = 16
    const linux_acl_tag_other: u64 = 32
    const linux_acl_undefined_id: u64 = 4294967295.u64()
static else:
    const platform_is_linux: bool = false
const linux_open_path: i64 = 2097152
const linux_openat2_syscall: i64 = 437
const linux_openat2_regular: u64 = 4294967296.u64()

# flock operation bits have the same values on the supported macOS and Linux
# targets. Keep their meaning named at the FFI boundary instead of embedding a
# platform magic number at the call site.
const lock_operation_exclusive: i64 = 2
const lock_operation_nonblocking: i64 = 4

static if ELISA_TARGET_OS_LINUX:
    def dirent_name_length(raw: mutable u8&) -> usize:
        record_length: usize = raw[16].usize() + raw[17].usize() * 256.usize()
        return 0 if record_length <= dirent_name_offset
        available: usize = record_length - dirent_name_offset
        scan_limit: usize = available if available < 256.usize() else 256.usize()
        index: mutable usize = 0.usize()
        while index < scan_limit |raw, index|:
            return index if raw[dirent_name_offset + index] == 0
            index <- index + 1.usize()
        return 0

    def dirent_type(raw: mutable u8&) -> u8:
        return raw[dirent_type_offset]
static else:
    def dirent_name_length(raw: mutable u8&) -> usize:
        length: usize = raw[18].usize() + raw[19].usize() * 256.usize()
        return 0 if length > 255.usize()
        return length

    def dirent_type(raw: mutable u8&) -> u8:
        return raw[dirent_type_offset]

module PlatformNative:
    public:
        # Raw libc calls are kept behind this module's named wrappers. The
        # public `Platform` module delegates here without spelling foreign
        # symbols, keeping the FFI vocabulary confined to one reviewed unit.
        def strlen(value: cstr) -> usize:
            return native_strlen(value)
        def cstr_equal(left: cstr, right: cstr) -> bool:
            left_length: usize = native_strlen(left)
            right_length: usize = native_strlen(right)
            return false if left_length != right_length
            for index in 0..<left_length |left, right|:
                return false if left[index].u8() != right[index].u8()
            return true
        def getenv(name: cstr) -> u8&?:
            return native_getenv(name)
        def write(fd: i64, buffer: void&, count: usize) -> i64 can[Console.Write]:
            while true |fd, buffer, count|:
                result: i64 = native_write(fd, buffer, count) can Console.Write
                continue if result < 0 and current_errno() == 4
                return result
            return -5
        def read_fd(fd: i64, buffer: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return -22 if fd < 0
            raw: mutable void& = buffer.cast[mutable void&] can Unsafe.PointerCast
            while true |fd, raw, capacity|:
                result: i64 = native_read(fd, raw, capacity)
                continue if result < 0 and current_errno() == 4
                return result if result >= 0
                return negative_errno()
            return -5
        def seek_fd(fd: i64, offset: i64, origin: i64) -> i64:
            return native_lseek(fd, offset, origin)
        def duplicate_fd(fd: i64, target: i64) -> i64:
            return native_dup2(fd, target)
        def duplicate_fd_min(fd: i64, minimum: i64) -> i64:
            return native_fcntl(fd, 0, minimum)
        def open_null() -> i64:
            return native_open("/dev/null", 0)
        def close(fd: i64) -> i64:
            return native_close(fd)
        # Run only in a post-fork child. Linux uses close_range; older kernels
        # fall back to the descriptor-table limit. macOS uses that same checked
        # fallback. Any close error other than EBADF aborts the child before
        # exec, so unknown handles cannot
        # cross the compiler boundary silently.
        def close_inherited_fds() -> i64:
            static if ELISA_TARGET_OS_LINUX:
                while true:
                    close_range_status: i64 = native_syscall(436, 3, 4294967295, 0)
                    return 0 if close_range_status == 0
                    errno_value: i64 = current_errno()
                    continue if errno_value == 4
                    break if errno_value == 38
                    return negative_value(errno_value)
            descriptor_limit: i64 = native_getdtablesize().i64()
            return -5 if descriptor_limit < 3
            fd: mutable i64 = 3
            while fd < descriptor_limit |fd, descriptor_limit|:
                close_status: i64 = native_close(fd)
                if close_status != 0:
                    errno_value: i64 = current_errno()
                    return negative_value(errno_value) if errno_value != 9
                fd <- fd + 1
            return 0
        def fsync(fd: i64) -> i64:
            return native_fsync(fd)
        def waitpid(pid: i64, status: mutable i32&, options: i64) -> i64:
            return native_waitpid(pid, status, options)
        def read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return -22 if capacity == 0.usize()
            fd: i64 = open_package_file(path)
            return fd if fd < 0
            return close_error(fd, -21) if not regular_fd(fd)
            used: mutable usize = 0.usize()
            while used < capacity |output, used, capacity, fd|:
                raw: mutable void& = (&output[used]).cast[mutable void&] can Unsafe.PointerCast
                amount: i64 = native_read(fd, raw, capacity - used)
                if amount < 0:
                    errno_value: i64 = current_errno()
                    continue if errno_value == 4
                    _ = native_close(fd)
                    return negative_value(errno_value)
                break if amount == 0
                if amount > (capacity - used).i64():
                    _ = native_close(fd)
                    return -75
                used <- used + amount.usize()
            close_status: i64 = native_close(fd)
            return -5 if close_status != 0
            return -27 if used == capacity
            return used.i64()

        # Trust roots and persisted anti-rollback state are read from one
        # descriptor. Every traversed directory and the final regular file
        # must be owned by root or the effective user and must not be writable
        # by group/other. This prevents a co-user from swapping trust material
        # through a shared directory between path validation and file reads.
        def read_trusted_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            device: mutable u64 = 0.u64()
            inode: mutable u64 = 0.u64()
            return read_trusted_file_identity(path, output, capacity, &device, &inode)

        # Return the identity of the same open descriptor used for the read.
        # Callers that later remove receipt-owned artifacts can bind that
        # removal to the file they actually verified, instead of re-resolving
        # its pathname after hashing.
        def read_trusted_file_identity(path: cstr, output: mutable u8&, capacity: usize, out_device: mutable u64&, out_inode: mutable u64&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out_device <- 0.u64()
            out_inode <- 0.u64()
            return -22 if capacity == 0.usize()
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot.push(leaf[index])
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            trusted_uid: u64 = native_geteuid().u64()
            directory: i64 = open_trusted_directory(parent_name, trusted_uid)
            return directory if directory < 0
            leaf_c: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                leaf_c.push(leaf_snapshot[index])
            leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = open_regular_file_at(directory, leaf_name)
            return close_error(directory, fd) if fd < 0
            return close_two_error(directory, fd, -13) if not trusted_regular_fd(fd, trusted_uid)
            stat: mutable darray[u8] = []
            stat.resize(144)
            raw_stat: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstat(fd, raw_stat) != 0:
                errno_value: i64 = current_errno()
                return close_two_error(directory, fd, negative_value(errno_value))
            out_device <- read_stat_device(stat)
            out_inode <- read_u64(stat, 8.usize())
            used: mutable usize = 0.usize()
            while used < capacity |output, used, capacity, fd|:
                raw: mutable void& = (&output[used]).cast[mutable void&] can Unsafe.PointerCast
                amount: i64 = native_read(fd, raw, capacity - used)
                if amount < 0:
                    errno_value: i64 = current_errno()
                    continue if errno_value == 4
                    return close_two_error(directory, fd, negative_value(errno_value))
                break if amount == 0
                if amount > (capacity - used).i64():
                    return close_two_error(directory, fd, -75)
                used <- used + amount.usize()
            close_status: i64 = native_close(fd)
            directory_close: i64 = native_close(directory)
            return -5 if close_status != 0 or directory_close != 0
            return -27 if used == capacity
            return used.i64()

        def is_trusted_directory(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            trusted_uid: u64 = native_geteuid().u64()
            directory: i64 = open_trusted_directory(path, trusted_uid)
            return 0 if directory < 0
            return 0 if native_close(directory) != 0
            return 1

        def package_file_size(path: cstr) -> i64:
            fd: i64 = open_package_file(path)
            return fd if fd < 0
            return close_error(fd, -21) if not regular_fd(fd)
            size: i64 = native_lseek(fd, 0, 2)
            close_status: i64 = native_close(fd)
            return -5 if close_status != 0
            return -5 if size < 0
            return size

        # Resolve a crypto provider only after every pathname component and
        # the final executable have passed the same ownership, mode, and ACL
        # checks used for trusted state. This is public within the native
        # platform module so its filesystem trust policy can be regression
        # tested directly; application code should use verify_ed25519.
        def is_trusted_crypto_executable(path: cstr, expected_uid: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return trusted_crypto_executable_path(path, expected_uid)

        def is_directory(path: cstr) -> i64:
            fd: i64 = open_directory_path(path)
            return 0 if fd < 0
            return 0 if native_close(fd) != 0
            return 1

        def extract_ustar(archive: darray[u8]&, destination: darray[u8]&) -> i64:
            return -22 if archive.count < 1024.usize() or archive.count > 67108864.usize() or archive.count % 512.usize() != 0.usize() or destination.count == 0.usize() or destination.count > 4096.usize()
            for index in 0..<destination.count |destination|:
                # The native filesystem API receives a NUL-terminated C path.
                # Reject embedded NUL so the byte path cannot be truncated to a
                # different staging directory at this FFI boundary.
                return -22 if destination[index] == 0
            destination_c: mutable darray[u8] = []
            for index in 0..<destination.count |destination_c, destination|:
                destination_c.push(destination[index])
            destination_c.push(0)
            destination_name: cstr = (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
            root: i64 = open_directory_path(destination_name)
            return root if root < 0
            # Extraction writes incrementally, so the opened root must be an
            # owner-only staging directory. Check the descriptor (not the
            # caller's path) before inspecting or creating any entries.
            return close_error(root, -13) if not private_staging_directory_fd(root, native_geteuid().u64())
            return close_error(root, -directory_not_empty_error) if not directory_empty(root)
            seen: mutable darray[u8] = []
            created_directories: mutable darray[u8] = []
            extracted_nodes: mutable usize = 0.usize()
            cursor: mutable usize = 0.usize()
            entries: mutable usize = 0.usize()
            result: mutable i64 = -22
            while cursor + 512.usize() <= archive.count |archive, cursor, entries, seen, root, result|:
                if archive_block_zero(archive, cursor):
                    if cursor + 1024.usize() == archive.count and entries > 0.usize() and archive_block_zero(archive, cursor + 512.usize()):
                        result <- 0
                    break
                return extraction_failure(root, seen, created_directories, -22) if entries >= PackagePathPolicy::max_package_archive_entries
                return extraction_failure(root, seen, created_directories, -22) if cursor + 1024.usize() > archive.count
                return extraction_failure(root, seen, created_directories, -22) if not archive_header_shape(archive, cursor)
                name: mutable darray[u8] = []
                for index in 0..<100 |archive, cursor, name|:
                    break if archive[cursor + index] == 0
                    name.push(archive[cursor + index])
                return extraction_failure(root, seen, created_directories, -22) if name.count == 0 or name.count >= 100 or not archive_entry_safe(name) or archive_name_seen(seen, name)
                return extraction_failure(root, seen, created_directories, -22) if not archive_metadata_zero(archive, cursor, name.count)
                mode: mutable usize = 0.usize()
                uid: mutable usize = 0.usize()
                gid: mutable usize = 0.usize()
                size: mutable usize = 0.usize()
                mtime: mutable usize = 0.usize()
                stored_checksum: mutable usize = 0.usize()
                return extraction_failure(root, seen, created_directories, -22) if not parse_octal_raw(archive, cursor + 100.usize(), 8.usize(), &mode) or not parse_octal_raw(archive, cursor + 108.usize(), 8.usize(), &uid) or not parse_octal_raw(archive, cursor + 116.usize(), 8.usize(), &gid) or not parse_octal_raw(archive, cursor + 124.usize(), 12.usize(), &size) or not parse_octal_raw(archive, cursor + 136.usize(), 12.usize(), &mtime) or not parse_octal_raw(archive, cursor + 148.usize(), 8.usize(), &stored_checksum)
                return extraction_failure(root, seen, created_directories, -22) if mode != 420.usize() or uid != 0.usize() or gid != 0.usize() or mtime != 0.usize() or size > 67108864.usize() - 1024.usize()
                checksum: mutable usize = 0.usize()
                for index in 0..<512 |archive, cursor, checksum|:
                    checksum <- checksum + (32.usize() if index >= 148.usize() and index < 156.usize() else archive[cursor + index].usize())
                return extraction_failure(root, seen, created_directories, -22) if checksum != stored_checksum
                data_start: usize = cursor + 512.usize()
