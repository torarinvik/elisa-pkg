# Private operating-system implementation for elisapkg.
#
# This module contains policy-aware filesystem code in Elisa. The only native
# boundary is the set of libc/POSIX declarations in platform/libc.elisa.

include "./platform/libc.elisa"
include "./platform/errors.elisa"
include "./platform/process.elisa"

include "./platform/abi.elisa"
include "./platform/stat.elisa"
include "./platform/process_values.elisa"
include "./platform/trusted_acl.elisa"

module PlatformNative:
    public:
        # Raw libc calls are kept behind this module's named wrappers. The
        # public `Platform` module delegates here without spelling foreign
        # symbols, keeping the FFI vocabulary confined to one reviewed unit.
        def strlen(value: cstr) -> usize:
            return native_strlen(value)
        def cstr_equal(left: cstr, right: cstr) -> bool:
            left_length: usize = native_strlen(left)
            right_length: usize = native_strlen(right)
            return false if left_length != right_length
            for index in 0..<left_length |left, right|:
                return false if left[index].u8() != right[index].u8()
            return true
        def getenv(name: cstr) -> u8&?:
            return native_getenv(name)
        def write(fd: i64, buffer: void&, count: usize) -> i64 can[Console.Write]:
            while true |fd, buffer, count|:
                result: i64 = native_write(fd, buffer, count) can Console.Write
                continue if result < 0 and NativeErrors::current_errno() == 4
                return result
            return -5
        def read_fd(fd: i64, buffer: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return -22 if fd < 0
            raw: mutable void& = buffer.cast[mutable void&] can Unsafe.PointerCast
            while true |fd, raw, capacity|:
                result: i64 = native_read(fd, raw, capacity)
                continue if result < 0 and NativeErrors::current_errno() == 4
                return result if result >= 0
                return NativeErrors::negative_errno()
            return -5
        def seek_fd(fd: i64, offset: i64, origin: i64) -> i64:
            return native_lseek(fd, offset, origin)
        def duplicate_fd(fd: i64, target: i64) -> i64:
            return native_dup2(fd, target)
        def duplicate_fd_min(fd: i64, minimum: i64) -> i64:
            return native_fcntl(fd, 0, minimum)
        def open_null() -> i64:
            return native_open("/dev/null", 0)
        def close(fd: i64) -> i64:
            return native_close(fd)
        # Run only in a post-fork child. The current soft descriptor limit
        # does not bound descriptors that were inherited above that limit.
        def close_inherited_fds() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            static if ELISA_TARGET_OS_LINUX:
                while true:
                    close_status: i64 = native_syscall(linux_close_range_syscall, 3, 4294967295, 0)
                    return 0 if close_status == 0
                    errno_value: i64 = NativeErrors::current_errno()
                    continue if errno_value == 4
                    return NativeErrors::negative_value(errno_value)
                return -5
            static else:
                return close_macos_inherited_descriptors()

        def fsync(fd: i64) -> i64:
            return native_fsync(fd)
        def read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return -22 if capacity == 0.usize()
            fd: i64 = open_package_file(path)
            return fd if fd < 0
            return close_error(fd, -21) if not regular_fd(fd)
            return close_result(fd, read_regular_descriptor(fd, output, capacity))

        # Size and read the opened inode. A pathname replacement between those
        # operations cannot redirect the read to a different file.
        def read_bounded_regular_file(path: cstr, maximum_bytes: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return false if maximum_bytes > 67108864.usize()
            descriptor: i64 = open_package_file(path)
            return false if descriptor < 0
            size: i64 = native_lseek(descriptor, 0, 2) if regular_fd(descriptor) else -1
            if size < 0 or size.usize() > maximum_bytes or native_lseek(descriptor, 0, 0) != 0:
                _ = native_close(descriptor)
                return false
            out.resize(size.usize() + 1.usize())
            read_size: i64 =
                output: mutable u8& = (&out[0]).cast[mutable u8&] can Unsafe.PointerCast
                read_regular_descriptor(descriptor, output, out.count)
            close_status: i32 = native_close(descriptor)
            if read_size != size or close_status != 0:
                out.resize(0)
                return false
            out.resize(size.usize())
            return true

        # Trust roots and persisted anti-rollback state are read from one
        # descriptor. Every traversed directory and the final regular file
        # must be owned by root or the effective user and must not be writable
        # by group/other. This prevents a co-user from swapping trust material
        # through a shared directory between path validation and file reads.
        def package_file_size(path: cstr) -> i64:
            fd: i64 = open_package_file(path)
            return fd if fd < 0
            return close_error(fd, -21) if not regular_fd(fd)
            size: i64 = native_lseek(fd, 0, 2)
            close_status: i64 = native_close(fd)
            return -5 if close_status != 0
            return -5 if size < 0
            return size

        # Resolve a crypto provider only after every pathname component and
        # the final executable have passed the same ownership, mode, and ACL
        # checks used for trusted state. This is public within the native
        # platform module so its filesystem trust policy can be regression
        # tested directly; application code should use verify_ed25519.
        def is_directory(path: cstr) -> i64:
            fd: i64 = open_directory_path(path)
            return 0 if fd < 0
            return 0 if native_close(fd) != 0
            return 1

        def open_directory_for_process(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return open_directory_path(path)

        def chdir(path: cstr) -> i64:
            directory: i64 = open_directory_path(path)
            return directory if directory < 0
            result: i64 = native_fchdir(directory)
            errno_value: i64 = NativeErrors::current_errno()
            return close_result(directory, 0) if result == 0
            return close_error(directory, NativeErrors::negative_value(errno_value))

        def fchdir(fd: i64) -> i64:
            result: i64 = native_fchdir(fd)
            return 0 if result == 0
            return -NativeErrors::error_code()

        def realpath(path: cstr, resolved: mutable darray[u8]&) -> cstr? can[Unsafe.PointerCast]:
            resolved[0] <- 0 if resolved.count > 0.usize()
            return null if:
                resolved.count == 0 or resolved.count > 4096.usize()
                native_strlen(path) > 4096.usize()
            found: u8&? = native_realpath(path, null)
            if found is canonical:
                length: usize = native_strlen(canonical.cast[cstr] can Unsafe.PointerCast)
                if length + 1.usize() <= resolved.count:
                    source: cstr = canonical.cast[cstr] can Unsafe.PointerCast
                    for index in 0..<length |resolved, source|:
                        resolved[index] <- source[index].u8()
                    resolved[length] <- 0
                    native_free(canonical.cast[void&] can Unsafe.PointerCast)
                    return (&resolved[0]).cast[cstr] can Unsafe.PointerCast
                native_free(canonical.cast[void&] can Unsafe.PointerCast)
            return null

    private:
        static if ELISA_TARGET_OS_MACOS:
            def close_macos_inherited_descriptors() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
                descriptor_list_flavor: i32 = process_descriptor_list_flavor
                entry_bytes: usize = process_descriptor_record_bytes
                process: i32 = native_getpid()
                capacity: i32 = native_proc_pidinfo(process, descriptor_list_flavor, 0.u64(), null, 0)
                return -5 if capacity <= 0 or capacity > 8388608 or capacity % 8 != 0
                entries: mutable darray[u8] = []
                entries.resize(capacity.usize())
                buffer: mutable void& = (&entries[0]).cast[mutable void&] can Unsafe.PointerCast
                native_errno()[0] <- 0
                received: i32 = native_proc_pidinfo(process, descriptor_list_flavor, 0.u64(), buffer, capacity)
                return -5 if received < 0 or received >= capacity or received % 8 != 0
                return NativeErrors::negative_errno() if received == 0 and NativeErrors::current_errno() != 0
                for index in 0..<(received.usize() / entry_bytes) |entries, entry_bytes|:
                    offset: usize = index * entry_bytes
                    descriptor: i64 = NativeProcessValues::descriptor_number(entries, offset)
                    return -5 if descriptor < 0
                    if descriptor >= 3 and native_close(descriptor) != 0:
                        return NativeErrors::negative_errno()
                return 0

    public:
        def read_regular_descriptor(fd: i64, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            used: mutable usize = 0.usize()
            while used < capacity |output, used, capacity, fd|:
                raw: mutable void& = (&output[used]).cast[mutable void&] can Unsafe.PointerCast
                amount: i64 = native_read(fd, raw, capacity - used)
                if amount < 0:
                    errno_value: i64 = NativeErrors::current_errno()
                    continue if errno_value == 4
                    return NativeErrors::negative_value(errno_value)
                break if amount == 0
                if amount > (capacity - used).i64():
                    return -75
                used <- used + amount.usize()
            return -27 if used == capacity
            return used.i64()


    public:
        def directory_not_empty_error_code() -> i64:
            return directory_not_empty_error

    public:
        def directory_empty(directory: i64) -> bool can[Unsafe.PointerCast]:
            # dup() shares the directory stream offset with the caller's file
            # description. Reopen "." relative to the descriptor so readdir
            # cannot change the caller's offset as a side effect.
            independent: i64 = native_openat(directory, ".", flags_directory())
            return false if independent < 0
            stream: mutable heap void&? = native_fdopendir(independent)
            if stream is opened:
                failed: mutable bool = false
                while true |opened, failed|:
                    native_errno()[0] <- 0
                    entry: mutable heap void&? = native_readdir(opened)
                    if entry is record:
                        raw: mutable u8& = record.cast[mutable u8&] can Unsafe.PointerCast
                        name_length: usize = dirent_name_length(raw)
                        if name_length == 0.usize():
                            _ = native_closedir(opened)
                            return false
                        continue if name_is_dot(raw, dirent_name_offset, name_length)
                        _ = native_closedir(opened)
                        return false
                    failed <- NativeErrors::current_errno() != 0
                    break
                close_status: i32 = native_closedir(opened)
                return not failed and close_status == 0
            _ = native_close(independent)
            return false


    public:
        def flags_directory() -> i64:
            return flag_read_only + flag_directory + flag_close_on_exec

    private:
        def flags_read_no_follow() -> i64:
            return flag_read_only + flag_no_follow + flag_close_on_exec + flag_nonblock

        def flags_file_read() -> i64:
            return flag_read_only + flag_no_follow + flag_close_on_exec + flag_nonblock

        def open_regular_file_at_pinned(directory: i64, leaf_name: cstr, before: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if not package_leaf_component_safe(leaf_name)
            pin_flags: i64 = linux_open_path + flag_no_follow + flag_close_on_exec
            pinned: i64 = native_openat(directory, leaf_name, pin_flags)
            return NativeErrors::negative_errno() if pinned < 0
            pinned_stat: mutable darray[u8] = []
            pinned_stat.resize(stat_buffer_bytes)
            pinned_raw: mutable void& = (&pinned_stat[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstat(pinned, pinned_raw) != 0:
                errno_value: i64 = NativeErrors::negative_errno()
                return close_error(pinned, errno_value)
            pinned_mode: u64 = NativeStat::file_type(pinned_stat)
            if pinned_mode != NativeStat::regular_mode:
                return close_error(pinned, package_nonregular_file_error(pinned_mode))
            if not NativeStat::same_identity(before, pinned_stat):
                return close_error(pinned, -13)

            descriptor_path: mutable darray[u8] = []
            for byte in [47, 112, 114, 111, 99, 47, 115, 101, 108, 102, 47, 102, 100, 47]:
                descriptor_path.push(byte.u8())
            digits: mutable darray[u8] = []
            remaining: mutable u64 = pinned.u64()
            if remaining == 0.u64():
                digits.push(48.u8())
            while remaining > 0.u64() |digits, remaining|:
                digits.push(48 + (remaining % 10.u64()).u8())
                remaining <- remaining / 10.u64()
            for index in 0..<digits.count |descriptor_path, digits|:
                descriptor_path.push(digits[digits.count - 1.usize() - index])
            descriptor_path.push(0)
            descriptor_name: cstr = (&descriptor_path[0]).cast[cstr] can Unsafe.PointerCast
            reopened: i64 = native_open(descriptor_name, flag_read_only + flag_nonblock + flag_close_on_exec)
            reopen_errno: i64 = NativeErrors::current_errno()
            if reopened < 0:
                close_status: i32 = native_close(pinned)
                return -5 if close_status != 0
                return NativeErrors::negative_value(reopen_errno)
            reopened_stat: mutable darray[u8] = []
            reopened_stat.resize(stat_buffer_bytes)
            reopened_raw: mutable void& = (&reopened_stat[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstat(reopened, reopened_raw) != 0:
                errno_value: i64 = NativeErrors::negative_errno()
                return close_two_error(pinned, reopened, errno_value)
            same: bool = (NativeStat::file_type(reopened_stat)) == NativeStat::regular_mode and NativeStat::same_identity(pinned_stat, reopened_stat)
            close_status: i32 = native_close(pinned)
            if not same or close_status != 0:
                _ = native_close(reopened)
                return -5 if close_status != 0 else -13
            return reopened

        # openat treats slash-containing names as paths and `O_NOFOLLOW` only
        # protects the final component. Keep these helpers limited to one
        # ordinary component so callers cannot smuggle traversal through a
        # supposedly descriptor-relative leaf.
    public:
        def package_leaf_component_safe(name: cstr) -> bool:
            length: usize = native_strlen(name)
            return false if length == 0 or length > 4096 or cstr_equal(name, ".") or cstr_equal(name, "..")
            for index in 0..<length |name|:
                return false if name[index].u8() == 47
            return true

    private:
        # Pin a candidate without invoking a device driver's open operation.
        # Linux uses openat2 with beneath/no-symlink resolution and falls back
        # to O_PATH plus procfs when the syscall or resolve flags are unavailable.
        # macOS has no O_PATH equivalent, so its protected-parent policy combines
        # pre-stat, O_NOFOLLOW, and a post-open inode comparison.
    public:
        def open_regular_file_at(directory: i64, leaf_name: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if not package_leaf_component_safe(leaf_name)
            before: mutable darray[u8] = []
            before.resize(stat_buffer_bytes)
            before_raw: mutable void& = (&before[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstatat(directory, leaf_name, before_raw, at_no_follow) != 0:
                return NativeErrors::negative_errno()
            before_mode: u64 = NativeStat::file_type(before)
            return package_nonregular_file_error(before_mode) if before_mode != NativeStat::regular_mode
            if platform_is_linux:
                how: mutable darray[u8] = []
                how.resize(24)
                for index in 0..<how.count |how|:
                    how[index] <- 0
                write_u64_le(&how, 0.usize(), flags_file_read().u64())
                write_u64_le(&how, 16.usize(), linux_resolve_no_symlinks + linux_resolve_beneath)
                how_raw: mutable void& = (&how[0]).cast[mutable void&] can Unsafe.PointerCast
                opened: i64 = native_syscall(linux_openat2_syscall, directory, leaf_name, how_raw, 24)
                if opened >= 0:
                    after: mutable darray[u8] = []
                    after.resize(stat_buffer_bytes)
                    after_raw: mutable void& = (&after[0]).cast[mutable void&] can Unsafe.PointerCast
                    if native_fstat(opened, after_raw) != 0:
                        errno_value: i64 = NativeErrors::negative_errno()
                        return close_error(opened, errno_value)
                    if (NativeStat::file_type(after)) != NativeStat::regular_mode or not NativeStat::same_identity(before, after):
                        return close_error(opened, -13)
                    return opened
                open_errno: i64 = NativeErrors::current_errno()
                if open_errno != 38 and open_errno != 22:
                    return NativeErrors::negative_value(open_errno)
                return open_regular_file_at_pinned(directory, leaf_name, before)
            else:
                opened: i64 = native_openat(directory, leaf_name, flags_file_read())
                return NativeErrors::negative_errno() if opened < 0
                after: mutable darray[u8] = []
                after.resize(stat_buffer_bytes)
                after_raw: mutable void& = (&after[0]).cast[mutable void&] can Unsafe.PointerCast
                if native_fstat(opened, after_raw) != 0:
                    errno_value: i64 = NativeErrors::negative_errno()
                    return close_error(opened, errno_value)
                after_mode: u64 = NativeStat::file_type(after)
                if after_mode != NativeStat::regular_mode:
                    return close_error(opened, package_nonregular_file_error(after_mode))
                if not NativeStat::same_identity(before, after):
                    return close_error(opened, -13)
                return opened

    public:
        def package_source_directory_fd(fd: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stat: mutable darray[u8] = []
            stat.resize(stat_buffer_bytes)
            raw: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            return false if native_fstat(fd, raw) != 0
            mode: u64 = NativeStat::mode(stat)
            owner: u64 = NativeStat::owner(stat)
            return false if (mode & NativeStat::file_type_mask) != NativeStat::directory_mode
            if (mode & NativeStat::group_or_other_write_mask) != 0.u64():
                # The only writable shared directory accepted for source
                # traversal is a root-owned sticky directory (for example,
                # /tmp). The sticky bit limits replacement to the owner of
                # each entry; O_NOFOLLOW/nonblocking checks handle symlinks
                # and FIFOs at the leaf.
                return false if owner != 0.u64() or (mode & 512.u64()) == 0.u64()
            return NativeTrustedAcl::trusted_acl_fd(fd, true)

    private:
        def package_nonregular_file_error(mode: u64) -> i64:
            return -21 if mode == NativeStat::directory_mode
            return -symlink_error if mode == NativeStat::symlink_mode
            return -unsupported_file_type_error

        def write_u64_le(value: mutable darray[u8]&, offset: usize, number: u64):
            remaining: mutable u64 = number
            for index in 0..<8 |value, offset, remaining|:
                value[offset + index] <- (remaining % 256.u64()).u8()
                remaining <- remaining / 256.u64()

    public:
        def flags_write_create_exclusive() -> i64:
            return flag_write_only + flag_create + flag_exclusive + flag_no_follow + flag_close_on_exec

    public:
        def split_parent_leaf(path: cstr, parent: mutable darray[u8]&, leaf: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent.resize(0)
            leaf.resize(0)
            length: usize = native_strlen(path)
            return false if length == 0 or length > 4096
            slash: mutable usize = length
            while slash > 0 and path[slash - 1].u8() != 47:
                slash <- slash - 1.usize()
            leaf_start: usize = slash
            return false if leaf_start == length
            for index in leaf_start..<length |path, leaf|:
                leaf.push(path[index].u8())
            leaf.push(0)
            leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
            return false if leaf.count <= 1.usize() or cstr_equal(leaf_name, ".") or cstr_equal(leaf_name, "..")
            if slash == 0:
                parent.push(46)
            elif slash == 1 and path[0].u8() == 47:
                parent.push(47)
            else:
                for index in 0..<slash |path, parent|:
                    parent.push(path[index].u8())
            parent.push(0)
            return true

    public:
        def open_directory_path(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096
            path_copy: mutable darray[u8] = []
            for index in 0..<length |path_copy, path|:
                path_copy.push(path[index].u8())
            path_copy.push(0)
            absolute: bool = path_copy[0] == 47
            directory: mutable i64 = native_open("/" if absolute else ".", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            start: mutable usize = 0.usize()
            while start < length and path_copy[start] == 47 |path_copy, start|:
                start <- start + 1.usize()
            while start < length:
                finish: mutable usize = start
                while finish < length and path_copy[finish] != 47 |path_copy, finish|:
                    finish <- finish + 1.usize()
                path_copy[finish] <- 0
                part: cstr = (&path_copy[start]).cast[cstr] can Unsafe.PointerCast
                if not cstr_equal(part, "."):
                    return close_error(directory, -22) if cstr_equal(part, "..")
                    next: i64 = native_openat(directory, part, flags_directory() + flag_no_follow)
                    return close_error(directory, -NativeErrors::error_code()) if next < 0
                    return close_error(next, -5) if native_close(directory) != 0
                    directory <- next
                start <- finish + 1.usize()
                while start < length and path_copy[start] == 47 |path_copy, start|:
                    start <- start + 1.usize()
            return directory

    public:
        def open_package_directory_component(directory: i64, component: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if not package_leaf_component_safe(component)
            before: mutable darray[u8] = []
            before.resize(stat_buffer_bytes)
            before_raw: mutable void& = (&before[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstatat(directory, component, before_raw, at_no_follow) != 0:
                return NativeErrors::negative_errno()
            before_mode: u64 = NativeStat::file_type(before)
            if before_mode != NativeStat::directory_mode:
                return -symlink_error if before_mode == NativeStat::symlink_mode
                return -20
            next: i64 = native_openat(directory, component, flags_directory() + flag_no_follow)
            return NativeErrors::negative_errno() if next < 0
            after: mutable darray[u8] = []
            after.resize(stat_buffer_bytes)
            after_raw: mutable void& = (&after[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstat(next, after_raw) != 0:
                errno_value: i64 = NativeErrors::negative_errno()
                return close_error(next, errno_value)
            if (NativeStat::file_type(after)) != NativeStat::directory_mode or not NativeStat::same_identity(before, after) or not package_source_directory_fd(next):
                return close_error(next, -13)
            return next

    public:
        def open_package_directory_path(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096
            path_copy: mutable darray[u8] = []
            for index in 0..<length |path_copy, path|:
                path_copy.push(path[index].u8())
            path_copy.push(0)
            absolute: bool = path_copy[0] == 47
            directory: mutable i64 = native_open("/" if absolute else ".", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            return close_error(directory, -13) if not package_source_directory_fd(directory)
            start: mutable usize = 0.usize()
            while start < length and path_copy[start] == 47 |path_copy, start|:
                start <- start + 1.usize()
            while start < length:
                finish: mutable usize = start
                while finish < length and path_copy[finish] != 47 |path_copy, start, finish|:
                    finish <- finish + 1.usize()
                path_copy[finish] <- 0
                component: cstr = (&path_copy[start]).cast[cstr] can Unsafe.PointerCast
                if not cstr_equal(component, "."):
                    next: i64 = open_package_directory_component(directory, component)
                    return close_error(directory, next) if next < 0
                    return close_error(next, -5) if native_close(directory) != 0
                    directory <- next
                start <- finish + 1.usize()
                while start < length and path_copy[start] == 47 |path_copy, start|:
                    start <- start + 1.usize()
            return directory

    public:
        def open_package_file(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096
            path_copy: mutable darray[u8] = []
            for index in 0..<length |path_copy, path|:
                path_copy.push(path[index].u8())
            path_copy.push(0)
            absolute: bool = path_copy[0] == 47
            directory: mutable i64 = native_open("/" if absolute else ".", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            return close_error(directory, -13) if not package_source_directory_fd(directory)
            start: mutable usize = 0.usize()
            while start < length and path_copy[start] == 47 |path_copy, start|:
                start <- start + 1.usize()
            while start < length:
                finish: mutable usize = start
                while finish < length and path_copy[finish] != 47 |path_copy, finish|:
                    finish <- finish + 1.usize()
                had_slash: bool = finish < length
                path_copy[finish] <- 0
                part: cstr = (&path_copy[start]).cast[cstr] can Unsafe.PointerCast
                return close_error(directory, -22) if cstr_equal(part, "")
                if had_slash:
                    if not cstr_equal(part, "."):
                        next: i64 = open_package_directory_component(directory, part)
                        return close_error(directory, next) if next < 0
                        return close_error(next, -5) if native_close(directory) != 0
                        directory <- next
                else:
                    return close_result(directory, -21) if cstr_equal(part, ".")
                    result: i64 = open_regular_file_at(directory, part)
                    return close_error(directory, result) if result < 0
                    close_status: i32 = native_close(directory)
                    if close_status != 0:
                        _ = native_close(result)
                        return -5
                    return result
                start <- finish + 1.usize()
                while start < length and path_copy[start] == 47 |path_copy, start|:
                    start <- start + 1.usize()
            _ = native_close(directory)
            return -22

    public:
        def close_error(fd: i64, errno_value: i64) -> i64:
            return -5 if native_close(fd) != 0
            return errno_value

    public:
        def close_result(fd: i64, result: i64) -> i64:
            return -5 if native_close(fd) != 0
            return result

    private:
        # Remove only the regular-file inode previously returned by
        # read_trusted_file_identity. The parent descriptor stays open across
        # the final identity check and unlink, so callers never re-resolve the
        # directory after validating the receipt-owned file.
    public:
        def close_two_error(left: i64, right: i64, errno_value: i64) -> i64:
            left_status: i64 = native_close(left)
            right_status: i64 = native_close(right)
            return -5 if left_status != 0 or right_status != 0
            return errno_value

    public:
        def close_three_error(first: i64, second: i64, third: i64, errno_value: i64) -> i64:
            first_status: i32 = native_close(first)
            second_status: i32 = native_close(second)
            third_status: i32 = native_close(third)
            return -5 if first_status != 0 or second_status != 0 or third_status != 0
            return errno_value

    public:
        def close_two_result(left: i64, right: i64, result: i64) -> i64:
            left_status: i64 = native_close(left)
            right_status: i64 = native_close(right)
            return -5 if left_status != 0 or right_status != 0
            return result

    public:
        def regular_fd(fd: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stat: mutable darray[u8] = []
            stat.resize(stat_buffer_bytes)
            raw: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            return native_fstat(fd, raw) == 0 and (NativeStat::file_type(stat)) == NativeStat::regular_mode

    public:
        def name_is_dot(raw: mutable u8&, offset: usize, length: usize) -> bool:
            return length == 1 and raw[offset] == 46 or length == 2 and raw[offset] == 46 and raw[offset + 1] == 46
