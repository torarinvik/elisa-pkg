    public:
        def directory_empty(directory: i64) -> bool can[Unsafe.PointerCast]:
            # dup() shares the directory stream offset with the caller's file
            # description. Reopen "." relative to the descriptor so readdir
            # cannot change the caller's offset as a side effect.
            independent: i64 = native_openat(directory, ".", flags_directory())
            return false if independent < 0
            stream: mutable heap void&? = native_fdopendir(independent)
            if stream is opened:
                failed: mutable bool = false
                while true |opened, failed|:
                    native_errno()[0] <- 0
                    entry: mutable heap void&? = native_readdir(opened)
                    if entry is record:
                        raw: mutable u8& = record.cast[mutable u8&] can Unsafe.PointerCast
                        name_length: usize = dirent_name_length(raw)
                        if name_length == 0.usize():
                            _ = native_closedir(opened)
                            return false
                        continue if name_is_dot(raw, dirent_name_offset, name_length)
                        _ = native_closedir(opened)
                        return false
                    failed <- NativeErrors::current_errno() != 0
                    break
                close_status: i32 = native_closedir(opened)
                return not failed and close_status == 0
            _ = native_close(independent)
            return false

    private:
        const regular_mode: u64 = 32768
        const directory_mode: u64 = 16384
        const symlink_mode: u64 = 40960

    public:
        def flags_directory() -> i64:
            return flag_read_only + flag_directory + flag_close_on_exec

    private:
        def flags_read_no_follow() -> i64:
            return flag_read_only + flag_no_follow + flag_close_on_exec + flag_nonblock

        def flags_file_read() -> i64:
            return flag_read_only + flag_no_follow + flag_close_on_exec + flag_nonblock

        def open_regular_file_at_pinned(directory: i64, leaf_name: cstr, before: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if not package_leaf_component_safe(leaf_name)
            pin_flags: i64 = linux_open_path + flag_no_follow + flag_close_on_exec
            pinned: i64 = native_openat(directory, leaf_name, pin_flags)
            return NativeErrors::negative_errno() if pinned < 0
            pinned_stat: mutable darray[u8] = []
            pinned_stat.resize(stat_buffer_bytes)
            pinned_raw: mutable void& = (&pinned_stat[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstat(pinned, pinned_raw) != 0:
                errno_value: i64 = NativeErrors::negative_errno()
                return close_error(pinned, errno_value)
