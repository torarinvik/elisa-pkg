        def waitpid_timeout(pid: i64, status: mutable i64&, timeout_ms: i64) -> i64 can[Memory.Allocate, Unsafe.PointerCast]:
            return -22 if pid <= 0 or timeout_ms <= 0
            started: i64 = monotonic_milliseconds()
            return -5 if started < 0
