        def read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return -22 if capacity == 0.usize()
            fd: i64 = open_package_file(path)
            return fd if fd < 0
            return close_error(fd, -21) if not regular_fd(fd)
            used: mutable usize = 0.usize()
            while used < capacity |output, used, capacity, fd|:
                raw: mutable void& = (&output[used]).cast[mutable void&] can Unsafe.PointerCast
                amount: i64 = native_read(fd, raw, capacity - used)
                if amount < 0:
                    _ = native_close(fd)
                    return negative_errno()
                break if amount == 0
                used <- used + amount.usize()
            _ = native_close(fd)
            return -27 if used == capacity
            return used.i64()

