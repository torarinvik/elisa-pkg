        def package_nonregular_file_error(mode: u64) -> i64:
            return -21 if mode == directory_mode
            return -symlink_error if mode == symlink_mode
            return -unsupported_file_type_error

        def write_u64_le(value: mutable darray[u8]&, offset: usize, number: u64):
            remaining: mutable u64 = number
            for index in 0..<8 |value, offset, remaining|:
                value[offset + index] <- (remaining % 256.u64()).u8()
                remaining <- remaining / 256.u64()

        def flags_read_write_create_exclusive() -> i64:
            return flag_read_write + flag_create + flag_exclusive + flag_no_follow + flag_close_on_exec

    public:
        def flags_write_create_exclusive() -> i64:
            return flag_write_only + flag_create + flag_exclusive + flag_no_follow + flag_close_on_exec

    private:
        def split_parent_leaf(path: cstr, parent: mutable darray[u8]&, leaf: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent.resize(0)
            leaf.resize(0)
            length: usize = native_strlen(path)
            return false if length == 0 or length > 4096
            slash: mutable usize = length
            while slash > 0 and path[slash - 1].u8() != 47:
                slash <- slash - 1.usize()
            leaf_start: usize = slash
            return false if leaf_start == length
            for index in leaf_start..<length |path, leaf|:
                leaf.push(path[index].u8())
            leaf.push(0)
            leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
            return false if leaf.count <= 1.usize() or cstr_equal(leaf_name, ".") or cstr_equal(leaf_name, "..")
            if slash == 0:
                parent.push(46)
            elif slash == 1 and path[0].u8() == 47:
                parent.push(47)
            else:
                for index in 0..<slash |path, parent|:
                    parent.push(path[index].u8())
            parent.push(0)
            return true

    public:
        def open_directory_path(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096
            path_copy: mutable darray[u8] = []
            for index in 0..<length |path_copy, path|:
                path_copy.push(path[index].u8())
            path_copy.push(0)
            absolute: bool = path_copy[0] == 47
            directory: mutable i64 = native_open("/" if absolute else ".", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            start: mutable usize = 0.usize()
            while start < length and path_copy[start] == 47 |path_copy, start|:
                start <- start + 1.usize()
            while start < length:
                finish: mutable usize = start
                while finish < length and path_copy[finish] != 47 |path_copy, finish|:
                    finish <- finish + 1.usize()
                path_copy[finish] <- 0
                part: cstr = (&path_copy[start]).cast[cstr] can Unsafe.PointerCast
                if not cstr_equal(part, "."):
                    return close_error(directory, -22) if cstr_equal(part, "..")
                    next: i64 = native_openat(directory, part, flags_directory() + flag_no_follow)
                    return close_error(directory, -NativeErrors::error_code()) if next < 0
                    return close_error(next, -5) if native_close(directory) != 0
                    directory <- next
                start <- finish + 1.usize()
                while start < length and path_copy[start] == 47 |path_copy, start|:
                    start <- start + 1.usize()
            return directory

    private:
    public:
        def open_package_directory_component(directory: i64, component: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if not package_leaf_component_safe(component)
            before: mutable darray[u8] = []
            before.resize(stat_buffer_bytes)
            before_raw: mutable void& = (&before[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstatat(directory, component, before_raw, at_no_follow) != 0:
                return NativeErrors::negative_errno()
            before_mode: u64 = NativeStat::file_type(before)
