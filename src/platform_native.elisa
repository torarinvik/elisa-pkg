# Private operating-system implementation for elisapkg.
#
# This module contains policy-aware filesystem code in Elisa. The only native
# boundary is the set of libc/POSIX declarations in platform/libc.elisa.

include "./platform/libc.elisa"
include "./platform/errors.elisa"
include "./platform/process.elisa"

include "./platform/abi.elisa"
include "./platform/stat.elisa"
include "./platform/process_values.elisa"
include "./platform/package_paths.elisa"

module PlatformNative:
    public:
        # Raw libc calls are kept behind this module's named wrappers. The
        # public `Platform` module delegates here without spelling foreign
        # symbols, keeping the FFI vocabulary confined to one reviewed unit.
        def strlen(value: cstr) -> usize:
            native_strlen(value)
        def c_string_equal(left: cstr, right: cstr) -> bool:
            left_length: usize = native_strlen(left)
            if left_length != native_strlen(right):
                false
            else:
                for index in 0..<left_length |equal: bool = true| -> equal:
                    break false if left[index].u8() != right[index].u8()
        def getenv(name: cstr) -> u8&?:
            native_getenv(name)
        def write(file_descriptor: i64, buffer: void&, count: usize) -> i64 can[Console.Write]:
            while true |file_descriptor, buffer, count|:
                result: i64 = native_write(file_descriptor, buffer, count) can Console.Write
                continue if result < 0 and NativeErrors::current_errno() == 4
                return result
        def read_file_descriptor(file_descriptor: i64, buffer: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return -22 if file_descriptor < 0
            raw: mutable void& = buffer.cast[mutable void&] can Unsafe.PointerCast
            while true |file_descriptor, raw, capacity|:
                result: i64 = native_read(file_descriptor, raw, capacity)
                continue if result < 0 and NativeErrors::current_errno() == 4
                return result if result >= 0 else NativeErrors::negative_errno()
        def seek_file_descriptor(file_descriptor: i64, offset: i64, origin: i64) -> i64:
            native_lseek(file_descriptor, offset, origin)
        def duplicate_file_descriptor(file_descriptor: i64, target: i64) -> i64:
            native_dup2(file_descriptor, target)
        def duplicate_file_descriptor_minimum(file_descriptor: i64, minimum: i64) -> i64:
            native_fcntl(file_descriptor, 0, minimum)
        def open_null() -> i64:
            native_open("/dev/null", 0)
        def close(file_descriptor: i64) -> i64:
            native_close(file_descriptor)
        # Run only in a post-fork child. The current soft descriptor limit
        # does not bound descriptors that were inherited above that limit.
        def close_inherited_file_descriptors() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            static if ELISA_TARGET_OS_LINUX:
                while true:
                    close_status: i64 = native_syscall(linux_close_range_syscall, 3, 4294967295, 0)
                    errno_value: i64 = NativeErrors::current_errno()
                    continue if close_status != 0 and errno_value == 4
                    return 0 if close_status == 0 else NativeErrors::negative_value(errno_value)
            static else:
                return close_macos_inherited_descriptors()

        def fsync(file_descriptor: i64) -> i64:
            native_fsync(file_descriptor)
        def read_package_file(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            return -22 if capacity == 0.usize()
            file_descriptor: i64 = open_package_file(path)
            file_descriptor if file_descriptor < 0 else close_error(file_descriptor, -21) if not regular_file_descriptor(file_descriptor) else close_result(file_descriptor, read_regular_descriptor(file_descriptor, output, capacity))

        # Size and read the opened inode. A pathname replacement between those
        # operations cannot redirect the read to a different file.
        def read_bounded_regular_file(path: cstr, maximum_bytes: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return false if maximum_bytes > 67108864.usize()
            descriptor: i64 = open_package_file(path)
            return false if descriptor < 0
            size: i64 = native_lseek(descriptor, 0, 2) if regular_file_descriptor(descriptor) else -1
            if size < 0 or size.usize() > maximum_bytes or native_lseek(descriptor, 0, 0) != 0:
                _ = native_close(descriptor)
                return false
            out.resize(size.usize() + 1.usize())
            read_size: i64 =
                output: mutable u8& = (&out[0]).cast[mutable u8&] can Unsafe.PointerCast
                read_regular_descriptor(descriptor, output, out.count)
            if native_close(descriptor) != 0 or read_size != size:
                out.resize(0)
                false
            else:
                out.resize(size.usize())
                true

        # Trust roots and persisted anti-rollback state are read from one
        # descriptor. Every traversed directory and the final regular file
        # must be owned by root or the effective user and must not be writable
        # by group/other. This prevents a co-user from swapping trust material
        # through a shared directory between path validation and file reads.
        def package_file_size(path: cstr) -> i64:
            file_descriptor: i64 = open_package_file(path)
            return file_descriptor if file_descriptor < 0
            return close_error(file_descriptor, -21) if not regular_file_descriptor(file_descriptor)
            size: i64 = native_lseek(file_descriptor, 0, 2)
            # Close first so the descriptor is closed whatever the size was.
            -5 if native_close(file_descriptor) != 0 or size < 0 else size

        # Resolve a crypto provider only after every pathname component and
        # the final executable have passed the same ownership, mode, and ACL
        # checks used for trusted state. This is public within the native
        # platform module so its filesystem trust policy can be regression
        # tested directly; application code should use verify_ed25519.
        def is_directory(path: cstr) -> i64:
            file_descriptor: i64 = open_directory_path(path)
            0 if file_descriptor < 0 or native_close(file_descriptor) != 0 else 1

        def open_directory_for_process(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            open_directory_path(path)

        def chdir(path: cstr) -> i64:
            directory: i64 = open_directory_path(path)
            return directory if directory < 0
            result: i64 = native_fchdir(directory)
            errno_value: i64 = NativeErrors::current_errno()
            close_result(directory, 0) if result == 0 else close_error(directory, NativeErrors::negative_value(errno_value))

        def fchdir(file_descriptor: i64) -> i64:
            0 if native_fchdir(file_descriptor) == 0 else -NativeErrors::error_code()

        def realpath(path: cstr, resolved: mutable darray[u8]&) -> cstr? can[Unsafe.PointerCast]:
            resolved[0] <- 0 if resolved.count > 0.usize()
            return null if:
                resolved.count == 0 or resolved.count > 4096.usize()
                native_strlen(path) > 4096.usize()
            found: u8&? = native_realpath(path, null)
            if found is canonical:
                length: usize = native_strlen(canonical.cast[cstr] can Unsafe.PointerCast)
                if length + 1.usize() <= resolved.count:
                    region source_scope:
                        source: cstr = canonical.cast[cstr] can Unsafe.PointerCast
                        for index in 0..<length |resolved, source|:
                            resolved[index] <- source[index].u8()
                    resolved[length] <- 0
                    native_free(canonical.cast[void&] can Unsafe.PointerCast)
                    (&resolved[0]).cast[cstr] can Unsafe.PointerCast
                else:
                    native_free(canonical.cast[void&] can Unsafe.PointerCast)
                    null
            else:
                null

    private:
        static if ELISA_TARGET_OS_MACOS:
            def close_macos_inherited_descriptors() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
                capacity: i32 = native_proc_pidinfo(native_getpid(), process_descriptor_list_flavor, 0.u64(), null, 0)
                return -5 if capacity <= 0 or capacity > 8388608 or capacity % 8 != 0
                entries: mutable darray[u8] = []
                entries <- entries.resize(capacity.usize())
                native_errno()[0] <- 0
                received: i32 = native_proc_pidinfo(native_getpid(), process_descriptor_list_flavor, 0.u64(), ((&entries[0]).cast[mutable void&] can Unsafe.PointerCast), capacity)
                if received < 0 or received >= capacity or received % 8 != 0:
                    -5
                elif received == 0 and NativeErrors::current_errno() != 0:
                    NativeErrors::negative_errno()
                else:
                    # Close every listed descriptor above the standard streams.
                    for index in 0..<(received.usize() / process_descriptor_record_bytes) |entries, outcome: i64 = 0| -> outcome:
                        outcome <-
                            descriptor: i64 = NativeProcessValues::descriptor_number(entries, index * process_descriptor_record_bytes)
                            -5 if descriptor < 0 else NativeErrors::negative_errno() if descriptor >= 3 and native_close(descriptor) != 0 else 0
                        break outcome if outcome != 0

    public:
        def read_regular_descriptor(file_descriptor: i64, output: mutable u8&, capacity: usize) -> i64 can[Unsafe.PointerCast]:
            used: mutable usize = 0.usize()
            while used < capacity |output, used, capacity, file_descriptor|:
                amount: i64 =
                    raw: mutable void& = (&output[used]).cast[mutable void&] can Unsafe.PointerCast
                    native_read(file_descriptor, raw, capacity - used)
                if amount < 0:
                    errno_value: i64 = NativeErrors::current_errno()
                    continue if errno_value == 4
                    return NativeErrors::negative_value(errno_value)
                break if amount == 0
                if amount > (capacity - used).i64():
                    return -75
                used <- used + amount.usize()
            -27 if used == capacity else used.i64()


    public:
        def directory_not_empty_error_code() -> i64:
            directory_not_empty_error

    public:
        def directory_empty(directory: i64) -> bool can[Unsafe.PointerCast]:
            # dup() shares the directory stream offset with the caller's file
            # description. Reopen "." relative to the descriptor so readdir
            # cannot change the caller's offset as a side effect.
            independent: i64 = native_openat(directory, ".", flags_directory())
            return false if independent < 0
            stream: mutable heap void&? = native_fdopendir(independent)
            if stream is opened:
                # Whether readdir failed after listing only "." and "..".
                failed: bool = while true |read_failed: bool = false| -> read_failed:
                    native_errno()[0] <- 0
                    entry: mutable heap void&? = native_readdir(opened)
                    if entry is record:
                        raw: mutable u8& = record.cast[mutable u8&] can Unsafe.PointerCast
                        name_length: usize = dirent_name_length(raw)
                        if name_length == 0.usize() or not name_is_dot(raw, dirent_name_offset, name_length):
                            _ = native_closedir(opened)
                            return false
                    else:
                        break NativeErrors::current_errno() != 0
                # Close first so the stream is closed whatever readdir reported.
                native_closedir(opened) == 0 and not failed
            else:
                _ = native_close(independent)
                false


    public:
        def close_error(file_descriptor: i64, errno_value: i64) -> i64:
            -5 if native_close(file_descriptor) != 0 else errno_value

    public:
        def close_result(file_descriptor: i64, result: i64) -> i64:
            -5 if native_close(file_descriptor) != 0 else result

    public:
        # Close `first`, then `second`; whether both closes succeeded.
        def close_both(first: i64, second: i64) -> bool:
            first_status: i32 = native_close(first)
            native_close(second) == 0 and first_status == 0

        # Like `close_both`, but a negative descriptor is skipped as already closed.
        def close_open_pair(first: i64, second: i64) -> bool:
            first_status: i32 = native_close(first) if first >= 0 else 0
            (native_close(second) if second >= 0 else 0) == 0 and first_status == 0

        def close_two_error(left: i64, right: i64, errno_value: i64) -> i64:
            errno_value if close_both(left, right) else -5

        def close_three_error(first: i64, second: i64, third: i64, errno_value: i64) -> i64:
            first_status: i32 = native_close(first)
            errno_value if close_both(second, third) and first_status == 0 else -5

        def close_two_result(left: i64, right: i64, result: i64) -> i64:
            result if close_both(left, right) else -5

    public:
        def regular_file_descriptor(file_descriptor: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            stat: mutable darray[u8] = []
            stat <- stat.resize(status_buffer_bytes)
            raw: mutable void& = (&stat[0]).cast[mutable void&] can Unsafe.PointerCast
            native_fstat(file_descriptor, raw) == 0 and (NativeStat::file_type(stat)) == NativeStat::regular_mode

    public:
        def name_is_dot(raw: mutable u8&, offset: usize, length: usize) -> bool:
            length == 1 and raw[offset] == 46 or length == 2 and raw[offset] == 46 and raw[offset + 1] == 46
