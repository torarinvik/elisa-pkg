        # so its protected-parent policy combines pre-stat, O_NOFOLLOW, and a
        # post-open inode comparison.
        def open_regular_file_at(directory: i64, leaf_name: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            before: mutable darray[u8] = []
            before.resize(144)
            before_raw: mutable void& = (&before[0]).cast[mutable void&] can Unsafe.PointerCast
            if native_fstatat(directory, leaf_name, before_raw, at_no_follow) != 0:
                return negative_errno()
            before_mode: u64 = read_u16(before, stat_mode_offset) & 61440.u64()
            return package_nonregular_file_error(before_mode) if before_mode != regular_mode
            if platform_is_linux:
                how: mutable darray[u8] = []
                how.resize(24)
                for index in 0..<how.count |how|:
                    how[index] <- 0
                how_flags: u64 = linux_openat2_regular + flags_file_read().u64()
                write_u64_le(&how, 0.usize(), how_flags)
                how_raw: mutable void& = (&how[0]).cast[mutable void&] can Unsafe.PointerCast
                opened: i64 = native_syscall(linux_openat2_syscall, directory, leaf_name, how_raw, 24)
