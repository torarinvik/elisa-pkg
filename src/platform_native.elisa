            expected_uid: u64 = native_geteuid().u64()
            directory: mutable i64 = native_open("/" if absolute else ".", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            return close_error(directory, -13) if not executable_source_directory_fd(directory, expected_uid)
