                    errno_value: i64 = negative_errno()
                    return close_error(opened, errno_value)
                after_mode: u64 = read_u16(after, stat_mode_offset) & 61440.u64()
                if after_mode != regular_mode:
                    return close_error(opened, package_nonregular_file_error(after_mode))
                if read_stat_device(before) != read_stat_device(after) or read_u64(before, 8.usize()) != read_u64(after, 8.usize()):
