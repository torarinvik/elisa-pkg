# Deterministic ordering for collected package paths.
module CollectedPathOrder:
    public:
        # Sort row indices in O(n log n) without moving owned darray values.
        # The collector remains bounded at 4096 emitted files; heap sort avoids
        # making a large source tree quadratic in filename comparisons.
        def sort_indices(order: mutable darray[usize]&, rows: darray[darray[u8]]&) -> void:
            region start_scope:
                start: mutable usize = order.count / 2.usize()
                while start > 0.usize() |order, rows, start|:
                    start <- start - 1.usize()
                    sift_heap(order, rows, order.count, start)
            heap_size: mutable usize = order.count
            while heap_size > 1.usize() |order, rows, heap_size|:
                heap_size <- heap_size - 1.usize()
                root_value: usize = order[0]
                order[0] <- order[heap_size]
                order[heap_size] <- root_value
                sift_heap(order, rows, heap_size, 0.usize())

    private:
        def path_less(left: darray[u8]&, right: darray[u8]&) -> bool:
            region limit_scope:
                limit: usize = left.count if left.count < right.count else right.count
                for index in 0..<limit |left, right|:
                    return true if left[index] < right[index]
                    return false if left[index] > right[index]
            return left.count < right.count

        def sift_heap(order: mutable darray[usize]&, rows: darray[darray[u8]]&, heap_size: usize, start: usize) -> void:
            root: mutable usize = start
            while true |order, rows, heap_size, root|:
                child: mutable usize = root * 2.usize() + 1.usize()
                break if child >= heap_size
                if child + 1.usize() < heap_size and path_less(rows[order[child]], rows[order[child + 1.usize()]]):
                    child <- child + 1.usize()
                break if not path_less(rows[order[root]], rows[order[child]])
                root_value: usize = order[root]
                order[root] <- order[child]
                order[child] <- root_value
                root <- child
