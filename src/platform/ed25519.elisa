# OpenSSL-backed Ed25519 verification through the native platform boundary.
include "../platform_native.elisa"
include "./trusted_paths.elisa"
include "./file_mutation.elisa"
include "./abi.elisa"
include "./errors.elisa"
include "./libc.elisa"
include "./process.elisa"

module NativeEd25519:
    public:
        def verify_ed25519(public_key: darray[u8]&, message: darray[u8]&, signature: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if public_key.count != 32.usize() or signature.count != 64.usize() or message.count > 1048576.usize()
            openssl: mutable cstr = ""
            # Homebrew's stable `opt` paths are symlinks. Resolve the fixed
            # candidates before the no-follow executable check so the secure
            # filesystem wrapper does not accidentally select LibreSSL.
            resolved_openssl: mutable darray[u8] = []
            resolved_openssl <- resolved_openssl.resize(4096)
            if PlatformNative::realpath("/opt/homebrew/opt/openssl@3/bin/openssl", &resolved_openssl) is canonical and NativeTrustedPaths::is_trusted_crypto_executable(canonical, native_geteuid().u64()):
                openssl <- canonical
            elif PlatformNative::realpath("/opt/homebrew/opt/openssl/bin/openssl", &resolved_openssl) is canonical and NativeTrustedPaths::is_trusted_crypto_executable(canonical, native_geteuid().u64()):
                openssl <- canonical
            elif PlatformNative::realpath("/usr/bin/openssl", &resolved_openssl) is canonical and NativeTrustedPaths::is_trusted_crypto_executable(canonical, native_geteuid().u64()):
                openssl <- canonical
            else:
                return -38
            encoded_key: mutable darray[u8] = [48, 42, 48, 5, 6, 3, 43, 101, 112, 3, 33, 0]
            for index in 0..<public_key.count |encoded_key, public_key|:
                encoded_key <- encoded_key.push(public_key[index])
            # OpenSSL reopens the inputs by name. Keep those names inside a
            # private directory while the child is running.
            staging: mutable darray[u8] =
                empty_directory: darray[u8] = []
                crypto_input_path(empty_directory, crypto_directory_template)
            return -38 if NativeFileMutation::mkdtemp(&staging) != 0
            staging_name: cstr = (&staging[0]).cast[cstr] can Unsafe.PointerCast
            public_path: mutable darray[u8] = crypto_input_path(staging, "/key.XXXXXX")
            message_path: mutable darray[u8] = crypto_input_path(staging, "/message.XXXXXX")
            signature_path: mutable darray[u8] = crypto_input_path(staging, "/signature.XXXXXX")
            key_status: i64 = write_temporary_blob(encoded_key, &public_path)
            message_status: i64 = write_temporary_blob(message, &message_path) if key_status == 0 else -38
            signature_status: i64 = write_temporary_blob(signature, &signature_path) if message_status == 0 else -38
            if signature_status != 0:
                if key_status != 0:
                    message_path <- message_path.resize(0)
                if message_status != 0:
                    signature_path <- signature_path.resize(0)
                cleanup: i64 = cleanup_crypto_inputs(staging_name, public_path, message_path, signature_path)
                return -38 if cleanup == 0 else -5
            public_name: cstr = (&public_path[0]).cast[cstr] can Unsafe.PointerCast
            message_name: cstr = (&message_path[0]).cast[cstr] can Unsafe.PointerCast
            signature_name: cstr = (&signature_path[0]).cast[cstr] can Unsafe.PointerCast
            arguments: mutable darray[cstr] = [
                openssl, "pkeyutl", "-verify", "-pubin", "-inkey", public_name,
                "-keyform", "DER", "-rawin", "-in", message_name, "-sigfile", signature_name
            ]
            arguments <- arguments.push(null)
            child_argument_vector: mutable cstr&& = (&arguments[0]).cast[mutable cstr&&] can Unsafe.PointerCast
            empty_environment: mutable darray[cstr] = [null]
            child_environment: mutable cstr&& = (&empty_environment[0]).cast[mutable cstr&&] can Unsafe.PointerCast
            raw_child_argument_vector: void& = child_argument_vector.cast[void&] can Unsafe.PointerCast
            raw_child_environment: void& = child_environment.cast[void&] can Unsafe.PointerCast
            child_process_identifier: i64 = native_fork()
            result: mutable i64 = NativeErrors::negative_errno() if child_process_identifier < 0 else -1
            if child_process_identifier == 0:
                if NativeProcess::set_process_group() != 0:
                    native_exit(126)
                if NativeProcess::set_process_limits(2) != 0:
                    native_exit(126)
                # OpenSSL writes a success sentence to stdout and diagnostics
                # to stderr. Keep helper output from corrupting CLI JSON or
                # exposing provider details; callers receive only this status.
                null_file_descriptor: i64 = native_open("/dev/null", flag_read_write)
                if null_file_descriptor < 0 or PlatformNative::duplicate_file_descriptor(null_file_descriptor, 0) != 0 or PlatformNative::duplicate_file_descriptor(null_file_descriptor, 1) != 1 or PlatformNative::duplicate_file_descriptor(null_file_descriptor, 2) != 2:
                    native_exit(126)
                if PlatformNative::close_inherited_file_descriptors() != 0:
                    native_exit(126)
                _ = native_execve(openssl, raw_child_argument_vector, raw_child_environment)
                native_exit(127)
            elif child_process_identifier > 0:
                status: mutable i32 = 0
                waited: i64 = NativeProcess::waitpid_group_timeout(child_process_identifier, &status, 10000)
                result <- waited if waited < 0
                result <- 0 if waited == 0 and status == 0
                result <- -38 if waited == 0 and (status == 126 * 256 or status == 127 * 256)
            return -5 if cleanup_crypto_inputs(staging_name, public_path, message_path, signature_path) != 0
            return result

    private:
        def crypto_input_path(directory: darray[u8]&, suffix: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            path: mutable darray[u8] = []
            if directory.count > 0:
                for index in 0..<(directory.count - 1.usize()) |path, directory|:
                    path <- path.push(directory[index])
            for index in 0..<native_strlen(suffix) |path, suffix|:
                path <- path.push(suffix[index].u8())
            path <- path.push(0)
            return path

        def write_temporary_blob(value: darray[u8]&, path: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            file_descriptor: i64 = NativeFileMutation::mkstemp(path)
            if file_descriptor < 0:
                path.resize(0)
                return file_descriptor
            written: mutable usize = 0.usize()
            failed: mutable bool = false
            while written < value.count |value, written, file_descriptor, failed|:
                raw: void& = (&value[written]).cast[void&] can Unsafe.PointerCast
                amount: i64 = native_write(file_descriptor, raw, value.count - written)
                continue if amount < 0 and NativeErrors::current_errno() == 4
                if amount <= 0:
                    failed <- true
                    break
                if amount > (value.count - written).i64():
                    failed <- true
                    break
                written <- written + amount.usize()
            close_status: i64 = native_close(file_descriptor)
            return -5 if failed or close_status != 0
            return 0

        def cleanup_crypto_inputs(directory: cstr, key: darray[u8]&, message: darray[u8]&, signature: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            key_status: i64 = remove_temporary_blob(key)
            message_status: i64 = remove_temporary_blob(message)
            signature_status: i64 = remove_temporary_blob(signature)
            directory_status: i64 = NativeFileMutation::rmdir(directory)
            return -5 if key_status != 0 or message_status != 0 or signature_status != 0 or directory_status != 0
            return 0

        def remove_temporary_blob(path: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return 0 if path.count == 0
            path_name: cstr = (&path[0]).cast[cstr] can Unsafe.PointerCast
            return NativeFileMutation::unlink(path_name)
