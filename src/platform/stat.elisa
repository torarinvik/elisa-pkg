# Decode stat buffers returned by libc on the supported target ABI.

include "./abi.elisa"

module NativeStat:
    private:
        const invalid_identity_field: u64 = 18446744073709551615.u64()

        def complete_buffer(value: darray[u8]&) -> bool:
            return value.count >= stat_buffer_bytes

        def read_u16(value: darray[u8]&, offset: usize) -> u64:
            return value[offset].u64() + value[offset + 1.usize()].u64() * 256.u64()

        def read_u32(value: darray[u8]&, offset: usize) -> u64:
            return value[offset].u64() + value[offset + 1.usize()].u64() * 256.u64() + value[offset + 2.usize()].u64() * 65536.u64() + value[offset + 3.usize()].u64() * 16777216.u64()

        def read_u64(value: darray[u8]&, offset: usize) -> u64:
            return read_u32(value, offset) + read_u32(value, offset + 4.usize()) * 4294967296.u64()

    public:
        const file_type_mask: u64 = 61440.u64()
        const group_or_other_write_mask: u64 = 18.u64()

        def mode(value: darray[u8]&) -> u64:
            return 0.u64() if not complete_buffer(value)
            return read_u16(value, stat_mode_offset)

        def file_type(value: darray[u8]&) -> u64:
            return mode(value) & file_type_mask

        def owner(value: darray[u8]&) -> u64:
            return invalid_identity_field if not complete_buffer(value)
            return read_u32(value, stat_uid_offset)

        def group(value: darray[u8]&) -> u64:
            return invalid_identity_field if not complete_buffer(value)
            return read_u32(value, stat_gid_offset)

        def inode(value: darray[u8]&) -> u64:
            return invalid_identity_field if not complete_buffer(value)
            return read_u64(value, stat_inode_offset)

        def device(value: darray[u8]&) -> u64:
            return invalid_identity_field if not complete_buffer(value)
            static if ELISA_TARGET_OS_MACOS:
                return read_u32(value, 0.usize())
            static else:
                return read_u64(value, 0.usize())

        def same_identity(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if not complete_buffer(left) or not complete_buffer(right)
            return device(left) == device(right) and inode(left) == inode(right)
