# Decode stat buffers returned by libc on the supported target ABI.

include "./abi.elisa"

module NativeStat:
    private:
        const invalid_identity_field: u64 = 18446744073709551615.u64()

        def complete_buffer(value: darray[u8]&) -> bool:
            value.count >= status_buffer_bytes

        def read_u16(value: darray[u8]&, offset: usize) -> u64:
            value[offset].u64() + value[offset + 1.usize()].u64() * 256.u64()

        def read_u32(value: darray[u8]&, offset: usize) -> u64:
            value[offset].u64() + value[offset + 1.usize()].u64() * 256.u64() + value[offset + 2.usize()].u64() * 65536.u64() + value[offset + 3.usize()].u64() * 16777216.u64()

        def read_u64(value: darray[u8]&, offset: usize) -> u64:
            read_u32(value, offset) + read_u32(value, offset + 4.usize()) * 4294967296.u64()

    public:
        const symlink_mode: u64 = 40960
        const directory_mode: u64 = 16384
        const regular_mode: u64 = 32768
        const file_type_mask: u64 = 61440.u64()
        const group_or_other_write_mask: u64 = 18.u64()

        def mode(value: darray[u8]&) -> u64:
            0.u64() if not complete_buffer(value) else read_u16(value, status_mode_offset)

        def file_type(value: darray[u8]&) -> u64:
            mode(value) & file_type_mask

        def owner(value: darray[u8]&) -> u64:
            invalid_identity_field if not complete_buffer(value) else read_u32(value, status_user_identifier_offset)

        def group(value: darray[u8]&) -> u64:
            invalid_identity_field if not complete_buffer(value) else read_u32(value, status_group_identifier_offset)

        def inode(value: darray[u8]&) -> u64:
            invalid_identity_field if not complete_buffer(value) else read_u64(value, status_inode_offset)

        def device(value: darray[u8]&) -> u64:
            return invalid_identity_field if not complete_buffer(value)
            static if ELISA_TARGET_OS_MACOS:
                return read_u32(value, 0.usize())
            static else:
                return read_u64(value, 0.usize())

        def same_identity(left: darray[u8]&, right: darray[u8]&) -> bool:
            false if not complete_buffer(left) or not complete_buffer(right) else device(left) == device(right) and inode(left) == inode(right)
