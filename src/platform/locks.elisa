# Persistent advisory locks for install, project, and trust transactions.
include "../platform_native.elisa"
include "./trusted_paths.elisa"
include "./abi.elisa"
include "./errors.elisa"
include "./libc.elisa"

module NativeLocks:
    public:
        def acquire_install_lock(prefix: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # Use one persistent inode for every installer process. Never unlink
            # this file: doing so could split advisory locks across old and new
            # inodes while another process still holds the previous one.
            expected_user_identifier: u64 = native_geteuid().u64()
            directory: i64 = NativeTrustedPaths::open_trusted_directory(prefix, expected_user_identifier)
            directory if directory < 0 else acquire_at(directory, ".elisapkg-install.lock", expected_user_identifier)

        # Project recovery uses this lock to distinguish a live writer from a
        # stale transaction guard. The kernel releases the lock on process exit.
        def acquire_project_transaction_lock(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            acquire_named_lock(path, false)

        def acquire_trust_state_lock(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            acquire_named_lock(path, true)

    private:
        def acquire_named_lock(path: cstr, require_trusted_parent: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            expected_user_identifier: u64 = native_geteuid().u64()
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot <- leaf_snapshot.push(leaf[index])
            directory: i64 =
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                NativeTrustedPaths::open_trusted_directory(parent_name, expected_user_identifier) if require_trusted_parent else PlatformNative::open_package_directory_path(parent_name)
            return directory if directory < 0
            leaf_buffer: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_buffer, leaf_snapshot|:
                leaf_buffer <- leaf_buffer.push(leaf_snapshot[index])
            leaf_name: cstr = (&leaf_buffer[0]).cast[cstr] can Unsafe.PointerCast
            acquire_at(directory, leaf_name, expected_user_identifier)

        # Consume the directory descriptor and return the held lock descriptor.
        def acquire_at(directory: i64, leaf_name: cstr, expected_user_identifier: u64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            file_descriptor: i64 =
                flags: i64 = flag_read_write + flag_create + flag_no_follow + flag_close_on_exec + flag_nonblock
                native_openat(directory, leaf_name, flags, 384)
            if file_descriptor < 0:
                open_errno: i64 = NativeErrors::current_errno()
                _ = native_close(directory)
                return NativeErrors::negative_value(open_errno)
            return PlatformNative::close_error(file_descriptor, -5) if native_close(directory) != 0
            return PlatformNative::close_error(file_descriptor, -13) if not NativeTrustedPaths::trusted_regular_file_descriptor(file_descriptor, expected_user_identifier)
            if native_flock(file_descriptor, lock_operation_exclusive + lock_operation_nonblocking) != 0:
                lock_errno: i64 = NativeErrors::current_errno()
                return PlatformNative::close_error(file_descriptor, NativeErrors::negative_value(lock_errno))
            file_descriptor
