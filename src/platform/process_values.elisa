# Native timespec and resource-limit layouts on the supported 64-bit targets.

module NativeProcessValues:
    private:
        const maximum_milliseconds: i64 = 9223372036854775807
        const milliseconds_per_second: i64 = 1000
        const maximum_whole_seconds: i64 = maximum_milliseconds / milliseconds_per_second
        const maximum_fractional_milliseconds: i64 = maximum_milliseconds % milliseconds_per_second

        def read_unsigned(value: darray[u8]&, offset: usize, width: usize) -> u64:
            out: mutable u64 = 0
            for index in 0..<width |value, offset, out|:
                out <- out + (value[offset + index].u64() << (index * 8.usize()))
            return out

    public:
        const record_bytes: usize = 16.usize()

        def limit_bytes(value: i64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return timespec_bytes(value, value)

        def timespec_bytes(seconds: i64, nanoseconds: i64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            out: mutable darray[u8] = []
            out <- out.resize(record_bytes)
            for word in 0..<2 |out, word|:
                value: mutable u64 = (seconds if word == 0 else nanoseconds).u64()
                for byte in 0..<8 |out, value, word, byte|:
                    out[word * 8.usize() + byte] <- (value & 255.u64()).u8()
                    value <- value / 256.u64()
            return out

        def descriptor_number(records: darray[u8]&, offset: usize) -> i64:
            return -1 if offset > records.count or records.count - offset < 4.usize()
            number: u64 = read_unsigned(records, offset, 4.usize())
            return number.i64() if number <= 2147483647.u64() else -1

        def seconds(stamp: darray[u8]&) -> i64:
            return -1 if stamp.count < record_bytes
            return read_unsigned(stamp, 0.usize(), 8.usize()).i64()

        def milliseconds(stamp: darray[u8]&) -> i64:
            return -1 if stamp.count < record_bytes
            seconds: i64 = read_unsigned(stamp, 0.usize(), 8.usize()).i64()
            fractional_milliseconds: i64 =
                nanoseconds: i64 = read_unsigned(stamp, 8.usize(), 8.usize()).i64()
                return -1 if seconds < 0 or nanoseconds < 0 or nanoseconds >= 1000000000
                nanoseconds / 1000000
            # Saturate a valid timespec whose conversion would overflow i64.
            return maximum_milliseconds if:
                seconds > maximum_whole_seconds
                seconds == maximum_whole_seconds and fractional_milliseconds > maximum_fractional_milliseconds
            return seconds * milliseconds_per_second + fractional_milliseconds
