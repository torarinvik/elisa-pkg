# The pinned compiler requires FFI declarations at compilation-unit scope.
# Keep their names `native_*`; policy callers use the PlatformNative wrappers.
# Reject targets whose libc ABI the native implementation does not support.
static assert (ELISA_TARGET_OS_MACOS and ELISA_TARGET_ARCH_ARM64) or (ELISA_TARGET_OS_LINUX and (ELISA_TARGET_ARCH_X86_64 or ELISA_TARGET_ARCH_ARM64)), "elisapkg FFI supports macOS arm64, Linux x86_64, and Linux arm64 only"

@link_name("open")
extern native_open(path: cstr, flags: i64, ...) -> i32
@link_name("openat")
extern native_openat(directory: i64, path: cstr, flags: i64, ...) -> i32
@link_name("mkdirat")
extern native_mkdirat(directory: i64, path: cstr, mode: i64) -> i32
@link_name("unlinkat")
extern native_unlinkat(directory: i64, path: cstr, flags: i64) -> i32
@link_name("renameat")
extern native_renameat(old_directory: i64, old_path: cstr, new_directory: i64, new_path: cstr) -> i32
@link_name("linkat")
extern native_linkat(old_directory: i64, old_path: cstr, new_directory: i64, new_path: cstr, flags: i64) -> i32
@link_name("read")
extern native_read(file_descriptor: i64, buffer: mutable void&, count: usize) -> i64
@link_name("write")
extern native_write(file_descriptor: i64, buffer: void&, count: usize) -> i64
@link_name("close")
extern native_close(file_descriptor: i64) -> i32
@link_name("syscall")
extern native_syscall(number: i64, ...) -> i64
@link_name("dup")
extern native_dup(file_descriptor: i64) -> i32
@link_name("dup2")
extern native_dup2(file_descriptor: i64, target: i64) -> i32
@link_name("fcntl")
extern native_fcntl(file_descriptor: i64, command: i64, ...) -> i32
@link_name("fsync")
extern native_fsync(file_descriptor: i64) -> i32
@link_name("flock")
extern native_flock(file_descriptor: i64, operation: i64) -> i32
@link_name("fchmod")
extern native_fchmod(file_descriptor: i64, mode: i64) -> i32
@link_name("fchdir")
extern native_fchdir(file_descriptor: i64) -> i32
@link_name("fstat")
extern native_fstat(file_descriptor: i64, stat: mutable void&) -> i32
@link_name("fstatat")
extern native_fstatat(directory: i64, path: cstr, stat: mutable void&, flags: i64) -> i32
@link_name("faccessat")
extern native_faccessat(directory: i32, path: cstr, mode: i32, flags: i32) -> i32
@link_name("lseek")
extern native_lseek(file_descriptor: i64, offset: i64, whence: i64) -> i64
@link_name("strlen")
extern native_strlen(value: cstr) -> usize
@link_name("getenv")
extern native_getenv(name: cstr) -> u8&?
@link_name("geteuid")
extern native_geteuid() -> u32
@link_name("realpath")
extern native_realpath(path: cstr, resolved: void&?) -> u8&?
@link_name("free")
extern native_free(value: void&)
@link_name("arc4random_buf")
extern native_arc4random_buf(buffer: mutable void&, length: usize)
static if ELISA_TARGET_OS_LINUX:
    @link_name("__errno_location")
    extern native_errno() -> mutable i32&
static elif ELISA_TARGET_OS_FREEBSD:
    @link_name("__error")
    extern native_errno() -> mutable i32&
static else:
    @link_name("__error")
    extern native_errno() -> mutable i32&
static if ELISA_TARGET_OS_MACOS:
    @link_name("proc_pidinfo")
    extern native_proc_pidinfo(child_process_identifier: i32, flavor: i32, argument: u64, buffer: mutable void&?, buffer_size: i32) -> i32
    @link_name("getgrnam")
    extern native_getgrnam(name: cstr) -> u8&?
    @link_name("acl_get_fd_np")
    extern native_acl_get_fd_np(file_descriptor: i32, kind: i32) -> u8&?
    @link_name("acl_get_entry")
    extern native_acl_get_entry(acl: u8&, entry_identifier: i32, entry_out: mutable void&) -> i32
    @link_name("acl_get_tag_type")
    extern native_acl_get_tag_type(entry: u8&, tag: mutable i32&) -> i32
    @link_name("acl_free")
    extern native_acl_free(value: void&) -> i32
static if ELISA_TARGET_OS_LINUX:
    @link_name("fgetxattr")
    extern native_fgetxattr(file_descriptor: i32, name: cstr, value: mutable void&, size: usize) -> i64
@link_name("fdopendir")
extern native_fdopendir(file_descriptor: i64) -> mutable heap void&?
@link_name("readdir")
extern native_readdir(directory: heap void&) -> mutable heap void&?
@link_name("closedir")
extern native_closedir(directory: heap void&) -> i32
@link_name("fork")
extern native_fork() -> i32
@link_name("execvp")
# C receives `char **` as one pointer-sized argument. Keep its pointer depth
# typed in the Elisa wrapper and erase it only at this private native boundary.
extern native_execvp(path: cstr, argument_vector: void&) -> i32
@link_name("execve")
extern native_execve(path: cstr, argument_vector: void&, environment: void&) -> i32
@link_name("_exit")
extern native_exit(code: i32)
@link_name("setpgid")
extern native_setpgid(child_process_identifier: i32, group: i32) -> i32
@link_name("getpid")
extern native_getpid() -> i32
@link_name("waitpid")
extern native_waitpid(child_process_identifier: i32, status: mutable i32&, options: i32) -> i32
@link_name("kill")
extern native_kill(child_process_identifier: i32, signal: i32) -> i32
@link_name("clock_gettime")
extern native_clock_gettime(clock: i64, timespec: mutable void&) -> i32
@link_name("nanosleep")
extern native_nanosleep(request: void&, remaining: mutable void&) -> i32
@link_name("setrlimit")
extern native_setrlimit(resource: i32, limits: void&) -> i32
