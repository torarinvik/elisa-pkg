# Deterministic discovery of files eligible for package snapshots.
include "../package_path_policy.elisa"
include "../platform_native.elisa"
include "./abi.elisa"
include "./errors.elisa"
include "./libc.elisa"
include "./path_order.elisa"

module NativeFileCollection:
    public:
        def collect_files(root: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Unsafe.PointerCast]:
            return -22 if native_strlen(root) == 0.usize() or native_strlen(root) > 4096.usize() or capacity == 0.usize()
            used: mutable usize = 0.usize()
            region output_scope:
                # The collected NUL-terminated paths, one row each.
                rows: darray[darray[u8]] =
                    paths: mutable darray[u8] = []
                    region visited_nodes_scope:
                        visited_nodes: mutable usize = 1.usize()
                        if not collect_directory(root, root, &paths, 0.usize(), &visited_nodes):
                            return -75 if visited_nodes > maximum_collect_traversal_nodes
                            return -5
                    while cursor < paths.count |cursor: usize = 0.usize(), split_rows: darray[darray[u8]] = []| -> split_rows:
                        row: darray[u8] =
                            while cursor < paths.count and paths[cursor] != 0 |cursor, path_row: darray[u8] = []| -> path_row:
                                path_row <- path_row.push(paths[cursor])
                                cursor <- cursor + 1.usize()
                        return -5 if row.count == 0.usize() or cursor >= paths.count
                        cursor <- cursor + 1.usize()
                        return -75 if split_rows.count >= 4096.usize()
                        split_rows <- split_rows.push(row)
                ordered_rows: mutable darray[usize] = [row_index for row_index in 0..<rows.count]
                CollectedPathOrder::sort_indices(&ordered_rows, rows)
                for sorted_index in 0..<ordered_rows.count |rows, ordered_rows, output, used, capacity|:
                    row_index: usize = ordered_rows[sorted_index]
                    return -7 if used + rows[row_index].count + 1.usize() > capacity
                    for index in 0..<rows[row_index].count |output, rows, row_index, used|:
                        output[used + index] <- rows[row_index][index]
                    output[used + rows[row_index].count] <- 0
                    used <- used + rows[row_index].count + 1.usize()
            used.i64()

        # The names directly inside the directory `path`, except "." and
        # "..", as NUL-terminated rows in directory order, with no package
        # path policy applied. The directory is opened through the no-follow
        # walker. Returns the bytes written or a negative status.
        def list_entry_names(path: cstr, output: mutable u8&, capacity: usize) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if native_strlen(path) == 0.usize() or native_strlen(path) > 4096.usize() or capacity == 0.usize()
            directory_file_descriptor: i64 = PlatformNative::open_package_directory_path(path)
            return directory_file_descriptor if directory_file_descriptor < 0
            directory: mutable heap void&? = native_fdopendir(directory_file_descriptor)
            if directory is stream:
                used: mutable usize = 0.usize()
                failed: mutable bool = false
                while true |stream, output, used, failed|:
                    native_errno()[0] <- 0
                    entry: mutable heap void&? = native_readdir(stream)
                    if entry is record:
                        raw: mutable u8& = record.cast[mutable u8&] can Unsafe.PointerCast
                        name_length: usize = dirent_name_length(raw)
                        if name_length == 0 or name_length > 255.usize() or used + name_length + 1.usize() > capacity:
                            failed <- true
                            break
                        elif not PlatformNative::name_is_dot(raw, dirent_name_offset, name_length):
                            for index in 0..<name_length |output, used|:
                                output[used + index] <- raw[dirent_name_offset + index]
                            output[used + name_length] <- 0
                            used <- used + name_length + 1.usize()
                    else:
                        failed <- NativeErrors::current_errno() != 0
                        break
                closed: bool = native_closedir(stream) == 0
                -5 if failed or not closed else used.i64()
            else:
                _ = native_close(directory_file_descriptor)
                -5

    private:
        const maximum_collect_traversal_nodes: usize = 16384.usize()

        def collect_directory(root: cstr, path: cstr, out: mutable darray[u8]&, depth: usize, visited_nodes: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if depth > 64.usize()
            # Resolve the directory through the descriptor-relative no-follow
            # walker before enumeration. Opening `path` with `opendir` here
            # would re-follow a swapped symlink after the caller's probe.
            directory_file_descriptor: i64 = PlatformNative::open_package_directory_path(path)
            return false if directory_file_descriptor < 0
            duplicate: i64 = native_dup(directory_file_descriptor)
            if duplicate < 0:
                _ = native_close(directory_file_descriptor)
                return false
            directory: mutable heap void&? = native_fdopendir(duplicate)
            if native_close(directory_file_descriptor) != 0:
                if directory is stream:
                    _ = native_closedir(stream)
                else:
                    _ = native_close(duplicate)
                false
            elif directory is stream:
                while true |stream, out, path, depth, visited_nodes|:
                    native_errno()[0] <- 0
                    entry: mutable heap void&? = native_readdir(stream)
                    if entry is record:
                        raw: mutable u8& = record.cast[mutable u8&] can Unsafe.PointerCast
                        name_length: usize = dirent_name_length(raw)
                        if name_length == 0 or name_length > 255.usize():
                            return directory_failure(stream)
                        elif not PlatformNative::name_is_dot(raw, dirent_name_offset, name_length):
                            visited_nodes <- visited_nodes + 1.usize()
                            return directory_failure(stream) if visited_nodes > maximum_collect_traversal_nodes
                            # Some filesystems report DT_UNKNOWN. Credential
                            # exclusions must therefore not depend on d_type.
                            child: darray[u8] = child_path(path, raw, name_length)
                            child_name: cstr = (&child[0]).cast[cstr] can Unsafe.PointerCast
                            return directory_failure(stream) if not collect_entry(root, child_name, out, depth, visited_nodes)
                    else:
                        return directory_failure(stream) if NativeErrors::current_errno() != 0
                        break
                native_closedir(stream) == 0
            else:
                _ = native_close(duplicate)
                false

        # "PATH/NAME" as a terminated string, or "NAME" below ".".
        def child_path(path: cstr, raw: u8&, name_length: usize) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            child: mutable darray[u8] = []
            if not PlatformNative::c_string_equal(path, "."):
                parent_length: usize = native_strlen(path)
                for index in 0..<parent_length |child, path|:
                    child <- child.push(path[index].u8())
                child <- child.push(47) if parent_length == 0 or path[parent_length - 1.usize()].u8() != 47
            for index in 0..<name_length |child, raw|:
                child <- child.push(raw[dirent_name_offset + index])
            child <- child.push(0)
            child

        # Collect one directory entry: skip policy-excluded paths, recurse into
        # directories, and record regular files. Returns false when the entry
        # is unsafe, changed while probed, or exceeds a bound.
        def collect_entry(root: cstr, child_name: cstr, out: mutable darray[u8]&, depth: usize, visited_nodes: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            child_length: usize = native_strlen(child_name)
            return false if child_length == 0 or child_length > 4096.usize()
            region relative_policy_path_scope:
                relative_policy_path: mutable darray[u8] = []
                return false if not relative_path_under(root, child_name, &relative_policy_path)
                return true if PackagePathPolicy::credential_path_forbidden(relative_policy_path)
                return true if PackagePathPolicy::reserved_source_path_forbidden(relative_policy_path)
            region directory_probe_scope:
                directory_probe: i64 = PlatformNative::open_package_directory_path(child_name)
                if directory_probe >= 0:
                    return native_close(directory_probe) == 0 and collect_directory(root, child_name, out, depth + 1.usize(), visited_nodes)
            # The directory probe already ruled out a stable directory. Any
            # failed file open means the entry changed or was unsafe; skipping
            # it would produce an incomplete source digest.
            file_probe: i64 = PlatformNative::open_package_file(child_name)
            return false if file_probe < 0
            regular: bool = PlatformNative::regular_file_descriptor(file_probe)
            # Close first so the probe is closed whatever else fails.
            if native_close(file_probe) != 0 or not regular or out.count + child_length + 1.usize() > 16777216.usize():
                false
            else:
                for index in 0..<child_length |child_name|:
                    out.push(child_name[index].u8())
                out.push(0)
                true

        def directory_failure(stream: heap void&) -> bool:
            _ = native_closedir(stream)
            false

        def relative_path_under(root: cstr, path: cstr, out: mutable darray[u8]&) -> bool:
            out.resize(0)
            root_length: usize = native_strlen(root)
            path_length_value: usize = native_strlen(path)
            if PlatformNative::c_string_equal(root, "."):
                if path_length_value == 0 or path_length_value > 4096:
                    false
                else:
                    for index in 0..<path_length_value |out, path|:
                        out.push(path[index].u8())
                    true
            elif root_length == 0 or path_length_value <= root_length or path_length_value > 4096:
                false
            else:
                prefix_matches: bool = for index in 0..<root_length |matches: bool = true| -> matches:
                    break false if root[index].u8() != path[index].u8()
                # A root without a trailing slash must be followed by one.
                relative_start: usize = root_length if root[root_length - 1].u8() == 47 else root_length + 1.usize()
                if not prefix_matches or (relative_start > root_length and path[root_length].u8() != 47):
                    false
                else:
                    for index in relative_start..<path_length_value |out, path|:
                        out.push(path[index].u8())
                    out.count > 0.usize()
