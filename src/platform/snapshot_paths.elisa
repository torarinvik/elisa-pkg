# Path checks shared by snapshot creation and cleanup.
module SnapshotPaths:
    public:
        const maximum_path_bytes: usize = 4096.usize()

        def relative_path_safe(path: darray[u8]&) -> bool:
            return false if path.count == 0.usize() or path.count > maximum_path_bytes or path[0] == 47 or path[path.count - 1.usize()] == 47
            for index in 0..=path.count |segment_start: usize = 0.usize()|:
                if index < path.count and path[index] != 47:
                    return false if path[index] < 32 or path[index] >= 127 or path[index] == 92 or path[index] == 58
                    continue
                region segment_length_scope:
                    segment_length: usize = index - segment_start
                    return false if:
                        segment_length == 0.usize() or segment_length > 255.usize()
                        segment_length == 1.usize() and path[segment_start] == 46
                        segment_length == 2.usize() and path[segment_start] == 46 and path[segment_start + 1.usize()] == 46
                segment_start <- index + 1.usize()
            return true

        def absolute_path_safe(path: cstr, length: usize) -> bool:
            return false if length < 2.usize() or length > maximum_path_bytes or path[0].u8() != 47 or path[length - 1.usize()].u8() == 47
            # The end of the path closes the final segment like a separator.
            for index in 1..=length |segment_start: usize = 1.usize()|:
                if index < length and path[index].u8() != 47:
                    return false if path[index].u8() < 32 or path[index].u8() == 127
                    continue
                region segment_length_scope:
                    segment_length: usize = index - segment_start
                    return false if:
                        segment_length == 0.usize() or segment_length > 255.usize()
                        segment_length == 1.usize() and path[segment_start].u8() == 46
                        segment_length == 2.usize() and path[segment_start].u8() == 46 and path[segment_start + 1.usize()].u8() == 46
                segment_start <- index + 1.usize()
            return true

        def terminated_path_leaf(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if path.count == 0.usize()
            region end_scope:
                end: usize = path.count - 1.usize()
                return false if path[end] != 0
                start: usize =
                    while start > 0.usize() and path[start - 1.usize()] != 47 |start: usize = end| -> start:
                        start <- start - 1.usize()
                return false if start >= end
                ByteText::append_range(out, path, start, end)
            return true

        def root_control_file(path: darray[u8]&) -> bool:
            return path_equals(path, "elisapkg.json") or path_equals(path, "elisapkg.lock")

        def path_is_descendant(root: darray[u8]&, candidate: darray[u8]&) -> bool:
            return false if candidate.count <= root.count
            for index in 0..<root.count |root, candidate|:
                left: mutable u8 = root[index]
                right: mutable u8 = candidate[index]
                left <- left + 32.u8() if left >= 65 and left <= 90
                right <- right + 32.u8() if right >= 65 and right <= 90
                return false if left != right
            return candidate[root.count] == 47

    private:
        def path_equals(path: darray[u8]&, wanted: cstr) -> bool:
            for index in 0..<path.count |path, wanted|:
                expected: u8 = wanted[index].u8()
                return false if expected == 0 or path[index] != expected
            return wanted[path.count].u8() == 0
