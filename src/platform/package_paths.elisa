# Open package directories and regular files with descriptor-relative checks.
include "./abi.elisa"
include "./errors.elisa"
include "./libc.elisa"
include "./stat.elisa"
include "./trusted_acl.elisa"

extend PlatformNative:
    public:
        def flags_directory() -> i64:
            flag_read_only + flag_directory + flag_close_on_exec

    private:
        def regular_file_read_flags() -> i64:
            flag_read_only + flag_no_follow + flag_close_on_exec + flag_nonblock

        # "/proc/self/fd/N" with a terminator, for descriptor `descriptor`.
        def proc_descriptor_path(descriptor: u64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            path: mutable darray[u8] =
                # The decimal digits of `descriptor`, least significant first.
                digits: darray[u8] =
                    reversed_digits: mutable darray[u8] = [48] if descriptor == 0.u64() else []
                    while remaining > 0.u64() |reversed_digits, remaining: u64 = descriptor|:
                        reversed_digits <- reversed_digits.push(48 + (remaining % 10.u64()).u8())
                        remaining <- remaining / 10.u64()
                    reversed_digits
                for index in 0..<digits.count |prefix: darray[u8] = [47, 112, 114, 111, 99, 47, 115, 101, 108, 102, 47, 102, 100, 47]| -> prefix:
                    prefix <- prefix.push(digits[digits.count - 1.usize() - index])
            path <- path.push(0)
            path

        # The freshly opened descriptor is still the regular file `before`
        # described. `report_kind` reports a non-regular file by its kind
        # instead of as a permission failure. Closes `opened` on failure.
        def verify_opened_regular_file(opened: i64, before: darray[u8]&, report_kind: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            requires opened >= 0
            after: mutable darray[u8] = []
            after <- after.resize(status_buffer_bytes)
            return close_error(opened, NativeErrors::negative_errno()) if native_fstat(opened, ((&after[0]).cast[mutable void&] can Unsafe.PointerCast)) != 0
            after_mode: u64 = NativeStat::file_type(after)
            if report_kind and after_mode != NativeStat::regular_mode:
                close_error(opened, package_nonregular_file_error(after_mode))
            elif after_mode != NativeStat::regular_mode or not NativeStat::same_identity(before, after):
                close_error(opened, -13)
            else:
                opened

        def open_regular_file_at_pinned(directory: i64, leaf_name: cstr, before: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if not package_leaf_component_safe(leaf_name)
            pinned: i64 =
                pin_flags: i64 = linux_open_path + flag_no_follow + flag_close_on_exec
                native_openat(directory, leaf_name, pin_flags)
            return NativeErrors::negative_errno() if pinned < 0
            pinned_status: mutable darray[u8] = []
            pinned_status <- pinned_status.resize(status_buffer_bytes)
            return close_error(pinned, NativeErrors::negative_errno()) if native_fstat(pinned, ((&pinned_status[0]).cast[mutable void&] can Unsafe.PointerCast)) != 0
            region pinned_mode_scope:
                pinned_mode: u64 = NativeStat::file_type(pinned_status)
                return close_error(pinned, package_nonregular_file_error(pinned_mode)) if pinned_mode != NativeStat::regular_mode
            return close_error(pinned, -13) if not NativeStat::same_identity(before, pinned_status)

            reopened: i64 =
                descriptor_path: darray[u8] = proc_descriptor_path(pinned.u64())
                descriptor_name: cstr = (&descriptor_path[0]).cast[cstr] can Unsafe.PointerCast
                native_open(descriptor_name, flag_read_only + flag_nonblock + flag_close_on_exec)
            if reopened < 0:
                # Read errno before closing the pinned descriptor can change it.
                reopen_errno: i64 = NativeErrors::current_errno()
                -5 if native_close(pinned) != 0 else NativeErrors::negative_value(reopen_errno)
            else:
                same: bool =
                    reopened_status: mutable darray[u8] = []
                    reopened_status <- reopened_status.resize(status_buffer_bytes)
                    return close_two_error(pinned, reopened, NativeErrors::negative_errno()) if native_fstat(reopened, ((&reopened_status[0]).cast[mutable void&] can Unsafe.PointerCast)) != 0
                    (NativeStat::file_type(reopened_status)) == NativeStat::regular_mode and NativeStat::same_identity(pinned_status, reopened_status)
                if native_close(pinned) != 0:
                    _ = native_close(reopened)
                    -5
                elif not same:
                    _ = native_close(reopened)
                    -13
                else:
                    reopened

    public:
        # openat treats slash-containing names as paths and `O_NOFOLLOW` only
        # protects the final component. Keep these helpers limited to one
        # ordinary component so callers cannot smuggle traversal through a
        # supposedly descriptor-relative leaf.
        def package_leaf_component_safe(name: cstr) -> bool:
            region length_scope:
                length: usize = native_strlen(name)
                return false if length == 0 or length > 4096 or c_string_equal(name, ".") or c_string_equal(name, "..")
                for index in 0..<length |name|:
                    return false if name[index].u8() == 47
            true

        # Pin a candidate without invoking a device driver's open operation.
        # Linux uses openat2 with beneath/no-symlink resolution and falls back
        # to O_PATH plus procfs when the syscall or resolve flags are unavailable.
        # macOS has no O_PATH equivalent, so its protected-parent policy combines
        # pre-stat, O_NOFOLLOW, and a post-open inode comparison.
        def open_regular_file_at(directory: i64, leaf_name: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if not package_leaf_component_safe(leaf_name)
            before: mutable darray[u8] = []
            before <- before.resize(status_buffer_bytes)
            return NativeErrors::negative_errno() if native_fstatat(directory, leaf_name, ((&before[0]).cast[mutable void&] can Unsafe.PointerCast), at_no_follow) != 0
            region before_mode_scope:
                before_mode: u64 = NativeStat::file_type(before)
                return package_nonregular_file_error(before_mode) if before_mode != NativeStat::regular_mode
            if platform_is_linux:
                region opened_scope:
                    opened: i64 =
                        how: mutable darray[u8] = []
                        how <- how.resize(24)
                        for index in 0..<how.count |how|:
                            how[index] <- 0
                        write_u64_le(&how, 0.usize(), regular_file_read_flags().u64())
                        write_u64_le(&how, 16.usize(), linux_resolve_no_symlinks + linux_resolve_beneath)
                        how_raw: mutable void& = (&how[0]).cast[mutable void&] can Unsafe.PointerCast
                        native_syscall(linux_openat2_syscall, directory, leaf_name, how_raw, 24)
                    return verify_opened_regular_file(opened, before, false) if opened >= 0
                region open_errno_scope:
                    open_errno: i64 = NativeErrors::current_errno()
                    if open_errno != 38 and open_errno != 22:
                        return NativeErrors::negative_value(open_errno)
                return open_regular_file_at_pinned(directory, leaf_name, before)
            else:
                opened: i64 = native_openat(directory, leaf_name, regular_file_read_flags())
                return NativeErrors::negative_errno() if opened < 0
                return verify_opened_regular_file(opened, before, true)

    public:
        def package_source_directory_file_descriptor(file_descriptor: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            directory_mode_trusted: bool =
                status: mutable darray[u8] = []
                status <- status.resize(status_buffer_bytes)
                return false if native_fstat(file_descriptor, ((&status[0]).cast[mutable void&] can Unsafe.PointerCast)) != 0
                mode: u64 = NativeStat::mode(status)
                # The only writable shared directory accepted for source
                # traversal is a root-owned sticky directory (for example,
                # /tmp). The sticky bit limits replacement to the owner of
                # each entry; O_NOFOLLOW/nonblocking checks handle symlinks
                # and FIFOs at the leaf.
                (mode & NativeStat::file_type_mask) == NativeStat::directory_mode and ((mode & NativeStat::group_or_other_write_mask) == 0.u64() or (NativeStat::owner(status) == 0.u64() and (mode & 512.u64()) != 0.u64()))
            directory_mode_trusted and NativeTrustedAcl::trusted_acl_file_descriptor(file_descriptor, true)

    private:
        def package_nonregular_file_error(mode: u64) -> i64:
            -21 if mode == NativeStat::directory_mode else -symlink_error if mode == NativeStat::symlink_mode else -unsupported_file_type_error

        def write_u64_le(value: mutable darray[u8]&, offset: usize, number: u64):
            remaining: mutable u64 = number
            for index in 0..<8 |value, offset, remaining|:
                value[offset + index] <- (remaining % 256.u64()).u8()
                remaining <- remaining / 256.u64()

    public:
        def flags_write_create_exclusive() -> i64:
            flag_write_only + flag_create + flag_exclusive + flag_no_follow + flag_close_on_exec

    public:
        def split_parent_leaf(path: cstr, parent: mutable darray[u8]&, leaf: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent.resize(0)
            leaf.resize(0)
            length: usize = native_strlen(path)
            return false if length == 0 or length > 4096
            # The position after the last slash, which starts the leaf.
            slash: usize =
                while position > 0 and path[position - 1].u8() != 47 |position: usize = length| -> position:
                    position <- position - 1.usize()
            if slash == length:
                false
            else:
                for index in slash..<length |path, leaf|:
                    leaf.push(path[index].u8())
                leaf.push(0)
                leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
                if leaf.count <= 1.usize() or c_string_equal(leaf_name, ".") or c_string_equal(leaf_name, ".."):
                    false
                else:
                    if slash == 0:
                        parent.push(46)
                    elif slash == 1 and path[0].u8() == 47:
                        parent.push(47)
                    else:
                        for index in 0..<slash |path, parent|:
                            parent.push(path[index].u8())
                    parent.push(0)
                    true

    public:
        def open_directory_path(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            walk_directory_path(path, false)

    public:
        def open_package_directory_component(directory: i64, component: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if not package_leaf_component_safe(component)
            before: mutable darray[u8] = []
            before <- before.resize(status_buffer_bytes)
            return NativeErrors::negative_errno() if native_fstatat(directory, component, ((&before[0]).cast[mutable void&] can Unsafe.PointerCast), at_no_follow) != 0
            region before_mode_scope:
                before_mode: u64 = NativeStat::file_type(before)
                if before_mode != NativeStat::directory_mode:
                    return -symlink_error if before_mode == NativeStat::symlink_mode
                    return -20
            next: i64 = native_openat(directory, component, flags_directory() + flag_no_follow)
            return NativeErrors::negative_errno() if next < 0
            after: mutable darray[u8] = []
            after <- after.resize(status_buffer_bytes)
            return close_error(next, NativeErrors::negative_errno()) if native_fstat(next, ((&after[0]).cast[mutable void&] can Unsafe.PointerCast)) != 0
            if (NativeStat::file_type(after)) != NativeStat::directory_mode or not NativeStat::same_identity(before, after) or not package_source_directory_file_descriptor(next):
                close_error(next, -13)
            else:
                next

    public:
        def open_package_directory_path(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            walk_directory_path(path, true)

    private:
        # Open `path` one no-follow component at a time from `/` or the
        # current directory. `package_policy` applies the package source
        # ownership checks to every directory on the way.
        def walk_directory_path(path: cstr, package_policy: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096
            path_copy: mutable darray[u8] = [path[index].u8() for index in 0..<length]
            path_copy <- path_copy.push(0)
            directory: mutable i64 = native_open("/" if path_copy[0] == 47 else ".", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            return close_error(directory, -13) if package_policy and not package_source_directory_file_descriptor(directory)
            start: mutable usize = while position < length and path_copy[position] == 47 |path_copy, position: usize = 0.usize()| -> position:
                position <- position + 1.usize()
            # Each pass opens one component; the walk ends after the last one.
            while true:
                return directory if start >= length
                finish: usize = while position < length and path_copy[position] != 47 |path_copy, position: usize = start| -> position:
                    position <- position + 1.usize()
                path_copy[finish] <- 0
                region component_scope:
                    component: cstr = (&path_copy[start]).cast[cstr] can Unsafe.PointerCast
                    if not c_string_equal(component, "."):
                        next: i64 = open_package_directory_component(directory, component) if package_policy else open_plain_directory_component(directory, component)
                        return close_error(directory, next) if next < 0
                        return close_error(next, -5) if native_close(directory) != 0
                        directory <- next
                # The next component starts after the slashes that end this one.
                start <- while position < length and path_copy[position] == 47 |path_copy, position: usize = finish + 1.usize()| -> position:
                    position <- position + 1.usize()

        def open_plain_directory_component(directory: i64, component: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if c_string_equal(component, "..")
            next: i64 = native_openat(directory, component, flags_directory() + flag_no_follow)
            -NativeErrors::error_code() if next < 0 else next

    public:
        def open_package_file(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            length: usize = native_strlen(path)
            return -22 if length == 0 or length > 4096
            path_copy: mutable darray[u8] = [path[index].u8() for index in 0..<length]
            path_copy <- path_copy.push(0)
            directory: mutable i64 =
                absolute: bool = path_copy[0] == 47
                native_open("/" if absolute else ".", flags_directory())
            return -NativeErrors::error_code() if directory < 0
            return close_error(directory, -13) if not package_source_directory_file_descriptor(directory)
            start: mutable usize = while position < length and path_copy[position] == 47 |path_copy, position: usize = 0.usize()| -> position:
                position <- position + 1.usize()
            # Each pass opens one component; a path ending in a slash names no file.
            while true:
                if start >= length:
                    _ = native_close(directory)
                    return -22
                finish: usize = while position < length and path_copy[position] != 47 |path_copy, position: usize = start| -> position:
                    position <- position + 1.usize()
                path_copy[finish] <- 0
                part: cstr = (&path_copy[start]).cast[cstr] can Unsafe.PointerCast
                # The next component starts after the slashes that end this one.
                start <- while position < length and path_copy[position] == 47 |path_copy, position: usize = finish + 1.usize()| -> position:
                    position <- position + 1.usize()
                return close_error(directory, -22) if c_string_equal(part, "")
                # A slash after the component makes it a directory on the way.
                if finish < length:
                    if not c_string_equal(part, "."):
                        next: i64 = open_package_directory_component(directory, part)
                        return close_error(directory, next) if next < 0
                        return close_error(next, -5) if native_close(directory) != 0
                        directory <- next
                else:
                    return close_result(directory, -21) if c_string_equal(part, ".")
                    result: i64 = open_regular_file_at(directory, part)
                    return close_error(directory, result) if result < 0
                    if native_close(directory) != 0:
                        _ = native_close(result)
                        return -5
                    return result
