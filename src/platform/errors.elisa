# Translate libc errno values into elisapkg status codes.
include "./libc.elisa"

module NativeErrors:
    public:
        def error_code() -> i64:
            value: i64 = current_errno()
            return value if value > 0 else 5

        def negative_errno() -> i64:
            value: i64 = current_errno()
            return -value if value > 0 else -5

        def negative_value(value: i64) -> i64:
            return -value if value > 0 else -5

        def current_errno() -> i64:
            return native_errno()[0].i64()
