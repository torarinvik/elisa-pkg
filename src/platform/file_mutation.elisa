# Descriptor-relative filesystem mutations for package and trust transactions.
include "../platform_native.elisa"
include "./trusted_paths.elisa"
include "./abi.elisa"
include "./errors.elisa"
include "./libc.elisa"
include "./stat.elisa"

module NativeFileMutation:
    public:
        def mkdir(path: cstr, mode: u16) -> i64:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot <- leaf_snapshot.push(leaf[index])
            directory: i64 =
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(parent_name)
            return directory if directory < 0
            result: i64 =
                leaf_c: mutable darray[u8] = []
                for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                    leaf_c <- leaf_c.push(leaf_snapshot[index])
                leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
                native_mkdirat(directory, leaf_name, mode.i64())
            errno_value: i64 = NativeErrors::current_errno()
            if result == 0:
                sync_status: i64 = native_fsync(directory)
                sync_errno: i64 = NativeErrors::current_errno()
                return PlatformNative::close_result(directory, 0) if sync_status == 0
                return PlatformNative::close_error(directory, NativeErrors::negative_value(sync_errno))
            return PlatformNative::close_error(directory, NativeErrors::negative_value(errno_value))

        # Flushing the containing directory completes the durability contract
        # for an atomic file replacement. The caller never receives the raw
        # directory descriptor.
        def fsync_parent(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            directory: i64 =
                parent: mutable darray[u8] = []
                region leaf_scope:
                    leaf: mutable darray[u8] = []
                    return -22 if not PlatformNative::split_parent_leaf(path, &parent, &leaf)
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(parent_name)
            return directory if directory < 0
            result: i64 = native_fsync(directory)
            errno_value: i64 = NativeErrors::current_errno()
            return PlatformNative::close_result(directory, 0) if result == 0
            return PlatformNative::close_error(directory, NativeErrors::negative_value(errno_value))

        def chmod(path: cstr, mode: u16) -> i64:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot <- leaf_snapshot.push(leaf[index])
            directory: i64 =
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_package_directory_path(parent_name)
            return directory if directory < 0
            file_descriptor: i64 =
                leaf_c: mutable darray[u8] = []
                for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                    leaf_c <- leaf_c.push(leaf_snapshot[index])
                leaf_c <- leaf_c.push(0)
                leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_regular_file_at(directory, leaf_name)
            if file_descriptor < 0:
                return PlatformNative::close_error(directory, file_descriptor)
            return PlatformNative::close_two_error(directory, file_descriptor, -21) if not PlatformNative::regular_file_descriptor(file_descriptor)
            result: i64 = native_fchmod(file_descriptor, mode.i64())
            region errno_value_scope:
                errno_value: i64 = NativeErrors::current_errno()
                return PlatformNative::close_two_error(file_descriptor, directory, NativeErrors::negative_value(errno_value)) if result != 0
            sync_status: i64 = native_fsync(file_descriptor)
            sync_errno: i64 = NativeErrors::current_errno()
            return PlatformNative::close_two_result(file_descriptor, directory, 0) if sync_status == 0
            return PlatformNative::close_two_error(file_descriptor, directory, NativeErrors::negative_value(sync_errno))

        def unlink(path: cstr) -> i64:
            return unlink_kind(path, 0)

        def unlink_file_identity(path: cstr, device: u64, inode: u64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return unlink_verified_identity(path, device, inode)

        def rmdir(path: cstr) -> i64:
            return rmdir_secure(path)

        def link(old_path: cstr, new_path: cstr) -> i64:
            return link_or_rename(old_path, new_path, false)

        def rename(old_path: cstr, new_path: cstr) -> i64:
            return rename_secure(old_path, new_path)

        def mkstemp(template_path: mutable darray[u8]&) -> i64 can[Memory.Allocate, Unsafe.PointerCast]:
            return -22 if template_path.count == 0 or template_path.count > 4096.usize() or template_path[template_path.count - 1.usize()] != 0
            path_length: usize = native_strlen((&template_path[0]).cast[cstr] can Unsafe.PointerCast)
            path: cstr = (&template_path[0]).cast[cstr] can Unsafe.PointerCast
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(path, &parent, &leaf)
            return -22 if leaf.count < 7.usize()
            suffix: usize = leaf.count - 7.usize()
            for index in 0..<6 |leaf|:
                return -22 if leaf[suffix + index] != 88
            directory: i64 =
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(parent_name)
            return directory if directory < 0
            alphabet: cstr = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            entropy: mutable darray[u8] = []
            entropy <- entropy.resize(6)
            entropy_raw: mutable void& = (&entropy[0]).cast[mutable void&] can Unsafe.PointerCast
            for attempt in 0..<256 |leaf, alphabet, directory, template_path, path_length, entropy_raw|:
                native_arc4random_buf(entropy_raw, 6)
                for index in 0..<6 |leaf, alphabet, entropy, attempt|:
                    leaf[suffix + index] <- alphabet[((entropy[index].u64() + attempt.u64() * 17.u64() + index.u64()) % 62.u64()).usize()].u8()
                file_descriptor: i64 =
                    leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
                    native_openat(directory, leaf_name, flags_read_write_create_exclusive(), 384)
                if file_descriptor >= 0:
                    region start_scope:
                        start: usize = path_length - leaf.count + 1.usize()
                        for index in 0..<leaf.count |template_path, leaf, start|:
                            template_path[start + index] <- leaf[index]
                    if native_close(directory) != 0:
                        _ = native_close(file_descriptor)
                        # The descriptor close failure means the caller must
                        # treat creation as failed. Remove the newly-created
                        # name so an unreported temporary cannot accumulate
                        # in the package cache.
                        _ =
                            cleanup_path: mutable darray[u8] = []
                            for index in 0..<template_path.count |cleanup_path, template_path|:
                                cleanup_path <- cleanup_path.push(template_path[index])
                            cleanup_name: cstr = (&cleanup_path[0]).cast[cstr] can Unsafe.PointerCast
                            unlink_kind(cleanup_name, 0)
                        return -5
                    return file_descriptor
                return PlatformNative::close_error(directory, NativeErrors::negative_errno()) if NativeErrors::current_errno() != 17
            return PlatformNative::close_error(directory, -17)

        # Reserve a caller-selected name without following a pre-planted symlink.
        # This is used only for the legacy stage1 callback filename, which is
        # fixed to /tmp/<compiler-child_process_identifier> by the external compiler.
        def create_exclusive_file(path: cstr) -> i64:
            region file_descriptor_scope:
                file_descriptor: i64 = native_open(path, PlatformNative::flags_write_create_exclusive(), 384)
                return file_descriptor if file_descriptor < 0
                return -5 if native_close(file_descriptor) != 0
            return 0

        # Create a private per-build directory under an already trusted parent.
        # All path traversal uses openat with O_NOFOLLOW; the random leaf is
        # reserved atomically with mkdirat rather than checked before creation.
        def mkdtemp(template_path: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -22 if template_path.count == 0 or template_path.count > 4096.usize() or template_path[template_path.count - 1.usize()] != 0
            path_length: usize = native_strlen((&template_path[0]).cast[cstr] can Unsafe.PointerCast)
            path: cstr = (&template_path[0]).cast[cstr] can Unsafe.PointerCast
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(path, &parent, &leaf) or leaf.count < 7.usize()
            suffix: usize = leaf.count - 7.usize()
            for index in 0..<6 |leaf|:
                return -22 if leaf[suffix + index] != 88
            directory: i64 =
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(parent_name)
            return directory if directory < 0
            alphabet: cstr = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            entropy: mutable darray[u8] = []
            entropy <- entropy.resize(6)
            entropy_raw: mutable void& = (&entropy[0]).cast[mutable void&] can Unsafe.PointerCast
            for attempt in 0..<256 |leaf, alphabet, entropy, entropy_raw, directory, template_path, path_length|:
                native_arc4random_buf(entropy_raw, 6)
                for index in 0..<6 |leaf, alphabet, entropy, attempt|:
                    leaf[suffix + index] <- alphabet[((entropy[index].u64() + attempt.u64() * 17.u64() + index.u64()) % 62.u64()).usize()].u8()
                result: i64 =
                    leaf_name: cstr = (&leaf[0]).cast[cstr] can Unsafe.PointerCast
                    native_mkdirat(directory, leaf_name, 448)
                if result == 0:
                    region start_scope:
                        start: usize = path_length - leaf.count + 1.usize()
                        for index in 0..<leaf.count |template_path, leaf, start|:
                            template_path[start + index] <- leaf[index]
                    if native_close(directory) != 0:
                        _ =
                            cleanup_path: mutable darray[u8] = []
                            for index in 0..<template_path.count |cleanup_path, template_path|:
                                cleanup_path <- cleanup_path.push(template_path[index])
                            cleanup_name: cstr = (&cleanup_path[0]).cast[cstr] can Unsafe.PointerCast
                            unlink_kind(cleanup_name, at_remove_directory)
                        return -5
                    return 0
                return PlatformNative::close_error(directory, NativeErrors::negative_value(NativeErrors::current_errno())) if NativeErrors::current_errno() != 17
            return PlatformNative::close_error(directory, -17)

    private:
        def rmdir_secure(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot <- leaf_snapshot.push(leaf[index])
            parent_directory: i64 =
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(parent_name)
            return parent_directory if parent_directory < 0
            removed: i64 =
                leaf_c: mutable darray[u8] = []
                for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                    leaf_c <- leaf_c.push(leaf_snapshot[index])
                leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
                native_unlinkat(parent_directory, leaf_name, at_remove_directory)
            errno_value: i64 = NativeErrors::error_code()
            if removed == 0:
                sync_status: i64 = native_fsync(parent_directory)
                sync_errno: i64 = NativeErrors::error_code()
                return PlatformNative::close_result(parent_directory, 0) if sync_status == 0
                return PlatformNative::close_error(parent_directory, NativeErrors::negative_value(sync_errno))
            return PlatformNative::close_error(parent_directory, NativeErrors::negative_value(errno_value))

        def rename_secure(old_path: cstr, new_path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            old_parent: mutable darray[u8] = []
            old_leaf: mutable darray[u8] = []
            new_parent: mutable darray[u8] = []
            new_leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(old_path, &old_parent, &old_leaf) or not PlatformNative::split_parent_leaf(new_path, &new_parent, &new_leaf)
            old_leaf_snapshot: darray[u8] = byte_copy(old_leaf)
            new_parent_snapshot: darray[u8] = byte_copy(new_parent)
            new_leaf_snapshot: darray[u8] = byte_copy(new_leaf)
            old_directory: i64 =
                old_name: cstr = (&old_parent[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(old_name)
            return old_directory if old_directory < 0
            new_directory: i64 =
                new_parent_c: darray[u8] = byte_copy(new_parent_snapshot)
                new_name: cstr = (&new_parent_c[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(new_name)
            return PlatformNative::close_error(old_directory, new_directory) if new_directory < 0
            # The source is checked by descriptor and then acted on by name.
            # Both already-open parents must exclude writes by other users, so
            # an untrusted directory cannot swap that name between validation
            # and rename.
            region source_status_scope:
                source_status: i64 = check_trusted_source(old_directory, new_directory, old_leaf_snapshot)
                return PlatformNative::close_two_error(old_directory, new_directory, source_status) if source_status != 0
            region destination_status_scope:
                destination_status: i64 = check_replaceable_destination(new_directory, new_leaf_snapshot)
                return PlatformNative::close_two_error(old_directory, new_directory, destination_status) if destination_status != 0
            result: i64 =
                old_rename_leaf: darray[u8] = byte_copy(old_leaf_snapshot)
                new_rename_leaf: darray[u8] = byte_copy(new_leaf_snapshot)
                old_rename_name: cstr = (&old_rename_leaf[0]).cast[cstr] can Unsafe.PointerCast
                new_rename_name: cstr = (&new_rename_leaf[0]).cast[cstr] can Unsafe.PointerCast
                native_renameat(old_directory, old_rename_name, new_directory, new_rename_name)
            result_errno: i64 = NativeErrors::error_code()
            return PlatformNative::close_two_result(old_directory, new_directory, 0) if result == 0
            return PlatformNative::close_two_error(old_directory, new_directory, -result_errno)

        # The destination name is absent or a trusted regular file. Returns 0
        # or a negative errno.
        def check_replaceable_destination(new_directory: i64, new_leaf: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            destination_file_descriptor: i64 =
                new_leaf_c: darray[u8] = byte_copy(new_leaf)
                new_leaf_name: cstr = (&new_leaf_c[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_regular_file_at(new_directory, new_leaf_name)
            return -21 if destination_file_descriptor == -unsupported_file_type_error
            return 0 if destination_file_descriptor == -2
            return destination_file_descriptor if destination_file_descriptor < 0
            region destination_regular_scope:
                destination_regular: bool = NativeTrustedPaths::trusted_regular_file_descriptor(destination_file_descriptor, native_geteuid().u64())
                return -5 if native_close(destination_file_descriptor) != 0
                return -21 if not destination_regular
            return 0

        def unlink_verified_identity(path: cstr, expected_device: u64, expected_inode: u64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot <- leaf_snapshot.push(leaf[index])
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            expected_user_identifier: u64 = native_geteuid().u64()
            directory: i64 = NativeTrustedPaths::open_trusted_directory(parent_name, expected_user_identifier)
            return directory if directory < 0
            leaf_c: mutable darray[u8] = []
            for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                leaf_c <- leaf_c.push(leaf_snapshot[index])
            leaf_c <- leaf_c.push(0)
            leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            file_descriptor: i64 = PlatformNative::open_regular_file_at(directory, leaf_name)
            return PlatformNative::close_error(directory, file_descriptor) if file_descriptor < 0
            return PlatformNative::close_two_error(directory, file_descriptor, -13) if not NativeTrustedPaths::trusted_regular_file_descriptor(file_descriptor, expected_user_identifier)
            file_descriptor_status: mutable darray[u8] = []
            file_descriptor_status <- file_descriptor_status.resize(status_buffer_bytes)
            region file_descriptor_status_raw_scope:
                file_descriptor_status_raw: mutable void& = (&file_descriptor_status[0]).cast[mutable void&] can Unsafe.PointerCast
                if native_fstat(file_descriptor, file_descriptor_status_raw) != 0:
                    errno_value: i64 = NativeErrors::current_errno()
                    return PlatformNative::close_two_error(directory, file_descriptor, NativeErrors::negative_value(errno_value))
            file_descriptor_device: u64 = NativeStat::device(file_descriptor_status)
            region file_descriptor_inode_scope:
                file_descriptor_inode: u64 = NativeStat::inode(file_descriptor_status)
                return PlatformNative::close_two_error(directory, file_descriptor, -13) if file_descriptor_device != expected_device or file_descriptor_inode != expected_inode
            path_status: mutable darray[u8] = []
            path_status <- path_status.resize(status_buffer_bytes)
            region path_status_raw_scope:
                path_status_raw: mutable void& = (&path_status[0]).cast[mutable void&] can Unsafe.PointerCast
                if native_fstatat(directory, leaf_name, path_status_raw, at_no_follow) != 0:
                    errno_value: i64 = NativeErrors::current_errno()
                    return PlatformNative::close_two_error(directory, file_descriptor, NativeErrors::negative_value(errno_value))
            return PlatformNative::close_two_error(directory, file_descriptor, -13) if NativeStat::file_type(path_status) != NativeStat::regular_mode
            return PlatformNative::close_two_error(directory, file_descriptor, -13) if not NativeStat::same_identity(path_status, file_descriptor_status)
            # POSIX has no unlink-if-inode primitive: this is the narrowest
            # descriptor-relative check available, but a same-UID actor can
            # still replace the leaf between fstatat and unlinkat.
            removed: i64 = native_unlinkat(directory, leaf_name, 0)
            region remove_errno_scope:
                remove_errno: i64 = NativeErrors::current_errno()
                return PlatformNative::close_two_error(directory, file_descriptor, NativeErrors::negative_value(remove_errno)) if removed != 0
            sync_status: i64 = native_fsync(directory)
            region sync_errno_scope:
                sync_errno: i64 = NativeErrors::current_errno()
                if sync_status != 0:
                    return PlatformNative::close_two_error(directory, file_descriptor, NativeErrors::negative_value(sync_errno))
            directory_close: i64 = native_close(directory)
            region file_descriptor_close_scope:
                file_descriptor_close: i64 = native_close(file_descriptor)
                return -5 if directory_close != 0 or file_descriptor_close != 0
            return 0

        def unlink_kind(path: cstr, flags: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            parent: mutable darray[u8] = []
            leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(path, &parent, &leaf)
            leaf_snapshot: mutable darray[u8] = []
            for index in 0..<leaf.count |leaf_snapshot, leaf|:
                leaf_snapshot <- leaf_snapshot.push(leaf[index])
            directory: i64 =
                parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(parent_name)
            return directory if directory < 0
            result: i64 =
                leaf_c: mutable darray[u8] = []
                for index in 0..<leaf_snapshot.count |leaf_c, leaf_snapshot|:
                    leaf_c <- leaf_c.push(leaf_snapshot[index])
                leaf_c <- leaf_c.push(0)
                leaf_name: cstr = (&leaf_c[0]).cast[cstr] can Unsafe.PointerCast
                native_unlinkat(directory, leaf_name, flags)
            errno_value: i64 = NativeErrors::error_code()
            if result == 0:
                sync_status: i64 = native_fsync(directory)
                sync_errno: i64 = NativeErrors::error_code()
                return PlatformNative::close_result(directory, 0) if sync_status == 0
                return PlatformNative::close_error(directory, NativeErrors::negative_value(sync_errno))
            return PlatformNative::close_error(directory, NativeErrors::negative_value(errno_value))

        def link_or_rename(old_path: cstr, new_path: cstr, is_move: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            old_parent: mutable darray[u8] = []
            old_leaf: mutable darray[u8] = []
            new_parent: mutable darray[u8] = []
            new_leaf: mutable darray[u8] = []
            return -22 if not PlatformNative::split_parent_leaf(old_path, &old_parent, &old_leaf) or not PlatformNative::split_parent_leaf(new_path, &new_parent, &new_leaf)
            # Native calls may invalidate caller-owned array headers, so each
            # call below receives a fresh copy of the name it needs.
            old_leaf_snapshot: darray[u8] = byte_copy(old_leaf)
            new_parent_snapshot: darray[u8] = byte_copy(new_parent)
            new_leaf_snapshot: darray[u8] = byte_copy(new_leaf)
            old_directory: i64 =
                old_name: cstr = (&old_parent[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(old_name)
            return old_directory if old_directory < 0
            new_directory: i64 =
                new_parent_c: darray[u8] = byte_copy(new_parent_snapshot)
                new_name: cstr = (&new_parent_c[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_directory_path(new_name)
            return PlatformNative::close_error(old_directory, new_directory) if new_directory < 0
            region source_status_scope:
                source_status: i64 = check_trusted_source(old_directory, new_directory, old_leaf_snapshot)
                return PlatformNative::close_two_error(old_directory, new_directory, source_status) if source_status != 0
            region destination_status_scope:
                destination_status: i64 = check_destination(new_directory, new_leaf_snapshot, is_move)
                return PlatformNative::close_two_error(old_directory, new_directory, destination_status) if destination_status != 0
            result: i64 =
                old_leaf_c: darray[u8] = byte_copy(old_leaf_snapshot)
                new_leaf_c: darray[u8] = byte_copy(new_leaf_snapshot)
                old_leaf_name: cstr = (&old_leaf_c[0]).cast[cstr] can Unsafe.PointerCast
                new_leaf_name: cstr = (&new_leaf_c[0]).cast[cstr] can Unsafe.PointerCast
                native_renameat(old_directory, old_leaf_name, new_directory, new_leaf_name) if is_move else native_linkat(old_directory, old_leaf_name, new_directory, new_leaf_name, 0)
            errno_value: i64 = NativeErrors::error_code()
            return PlatformNative::close_two_result(old_directory, new_directory, 0) if result == 0
            return PlatformNative::close_two_error(old_directory, new_directory, NativeErrors::negative_value(errno_value))

        def byte_copy(bytes: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [bytes[index] for index in 0..<bytes.count]

        # Keep name-based linkat/renameat operations inside directories that
        # other users cannot mutate, and require the source to be a trusted
        # regular file. Returns 0 or a negative errno.
        def check_trusted_source(old_directory: i64, new_directory: i64, old_leaf: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            expected_user_identifier: u64 = native_geteuid().u64()
            return -13 if not NativeTrustedPaths::trusted_directory_file_descriptor(old_directory, expected_user_identifier) or not NativeTrustedPaths::trusted_directory_file_descriptor(new_directory, expected_user_identifier)
            source_file_descriptor: i64 =
                old_leaf_c: darray[u8] = byte_copy(old_leaf)
                old_leaf_name: cstr = (&old_leaf_c[0]).cast[cstr] can Unsafe.PointerCast
                PlatformNative::open_regular_file_at(old_directory, old_leaf_name)
            return -21 if source_file_descriptor == -unsupported_file_type_error
            return source_file_descriptor if source_file_descriptor < 0
            region source_regular_scope:
                source_regular: bool = NativeTrustedPaths::trusted_regular_file_descriptor(source_file_descriptor, expected_user_identifier)
                return -5 if native_close(source_file_descriptor) != 0
                return -21 if not source_regular
            return 0

        # A move may replace an existing regular file but never a symlink or
        # another kind of entry; a link requires the name to be absent.
        # Returns 0 or a negative errno.
        def check_destination(new_directory: i64, new_leaf: darray[u8]&, is_move: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            new_leaf_c: darray[u8] = byte_copy(new_leaf)
            new_leaf_name: cstr = (&new_leaf_c[0]).cast[cstr] can Unsafe.PointerCast
            new_mode: u64 =
                new_status: mutable darray[u8] = []
                new_status <- new_status.resize(status_buffer_bytes)
                new_result: i64 =
                    new_status_raw: mutable void& = (&new_status[0]).cast[mutable void&] can Unsafe.PointerCast
                    native_fstatat(new_directory, new_leaf_name, new_status_raw, at_no_follow)
                region new_errno_scope:
                    new_errno: i64 = NativeErrors::error_code()
                    return -new_errno if new_result != 0 and new_errno != 2
                return 0 if new_result != 0
                return -17 if not is_move
                NativeStat::mode(new_status)
            return -40 if (new_mode & NativeStat::file_type_mask) == NativeStat::symlink_mode
            return -21 if (new_mode & NativeStat::file_type_mask) != NativeStat::regular_mode
            return 0

        def flags_read_write_create_exclusive() -> i64:
            return flag_read_write + flag_create + flag_exclusive + flag_no_follow + flag_close_on_exec
