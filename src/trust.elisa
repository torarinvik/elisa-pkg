# Signed-metadata and publisher-verification contracts.
#
# This module owns the trust decision independently of transport. The default
# policy keeps network acquisition disabled; configured local registries still
# require the same detached-signature and binding checks.

include "./platform.elisa"
include "./package/package_identity.elisa"

module Trust:
    public:
        const enum VerificationCode of u8:
            Valid
            MissingMetadata
            InvalidSignature
            UnauthorizedNamespace
            UnknownAlgorithm
            ExpiredMetadata
            RollbackDetected
            DigestMismatch
            WrongRegistry
            WrongPackage
            WrongVersion
            ArchiveSizeMismatch
            MissingPublisherAttestation
            ThresholdInsufficient
            RevokedKey
            ClockRollback
            MalformedKey
            MalformedSignature

        struct VerificationPolicy:
            remote_enabled: mutable bool
            require_signed_metadata: mutable bool
            require_publisher_attestation: mutable bool

        def production_policy() -> VerificationPolicy:
            return VerificationPolicy{remote_enabled: false, require_signed_metadata: true, require_publisher_attestation: true}

        def is_hard_failure(code: VerificationCode) -> bool:
            return code != VerificationCode.Valid

        # These preflight checks reject policy-invalid metadata before the
        # provider consumes it. They do not replace cryptographic verification.
        def precheck_metadata(previous_version: u64, candidate_version: u64, now: u64, expires: u64) -> VerificationCode:
            return VerificationCode.MissingMetadata if candidate_version == 0
            return VerificationCode.RollbackDetected if candidate_version < previous_version
            return VerificationCode.ExpiredMetadata if expires <= now
            return VerificationCode.Valid

        def precheck_algorithm(algorithm: cstr) -> VerificationCode:
            return VerificationCode.Valid if Platform::pkg_cstr_equal(algorithm, "ed25519")
            return VerificationCode.UnknownAlgorithm

        # Shape checks run before the provider and reject ambiguous key material.
        def precheck_key_material(algorithm: cstr, public_key: darray[u8]&, signature: darray[u8]&) -> VerificationCode:
            algorithm_status: VerificationCode = precheck_algorithm(algorithm)
            return algorithm_status if algorithm_status != VerificationCode.Valid
            return VerificationCode.MalformedKey if public_key.count != 32.usize()
            return VerificationCode.MalformedSignature if signature.count != 64.usize()
            return VerificationCode.Valid

        # Verify the exact metadata bytes supplied by the registry. The FFI
        # provider receives no parsed fields and no private material, so a
        # caller cannot accidentally verify one representation and consume
        # another. Every non-zero provider result is a hard invalid-signature
        # decision; provider unavailability never becomes an allow decision.
        def verify_detached(algorithm: cstr, public_key: darray[u8]&, message: darray[u8]&, signature: darray[u8]&) -> VerificationCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            shape: VerificationCode = precheck_key_material(algorithm, public_key, signature)
            return shape if shape != VerificationCode.Valid
            # Signed registry metadata is capped at the JSON boundary. Keep
            # this public verification API bounded as well so future callers
            # cannot route an arbitrarily large message into the FFI temp-file
            # provider.
            return VerificationCode.InvalidSignature if message.count > 1048576.usize()
            return VerificationCode.Valid if Platform::pkg_verify_ed25519(public_key, message, signature) == 0
            return VerificationCode.InvalidSignature

        def precheck_namespace(package: darray[u8]&, namespace: darray[u8]&) -> VerificationCode:
            return VerificationCode.UnauthorizedNamespace if not trust_valid_namespace_path(package) or not trust_valid_namespace_path(namespace)
            return VerificationCode.Valid if:
                trust_slice_equal(package, namespace)
                package.count > namespace.count and package[namespace.count] == 47 and trust_slice_prefix(package, namespace)
            return VerificationCode.UnauthorizedNamespace

        # These binding checks run before a future signature provider accepts an
        # envelope. A valid signature over the wrong identity is still a hard
        # failure; callers must compare every field that the resolver will use.
        def precheck_binding(registry: darray[u8]&, expected_registry: darray[u8]&, package: darray[u8]&, expected_package: darray[u8]&, version: darray[u8]&, expected_version: darray[u8]&, archive_digest: darray[u8]&, expected_digest: darray[u8]&, archive_size: u64, expected_size: u64) -> VerificationCode:
            return VerificationCode.WrongRegistry if not trust_slice_equal(registry, expected_registry)
            return VerificationCode.WrongPackage if not trust_slice_equal(package, expected_package)
            return VerificationCode.WrongVersion if not trust_slice_equal(version, expected_version)
            return VerificationCode.DigestMismatch if not trust_slice_equal(archive_digest, expected_digest)
            return VerificationCode.ArchiveSizeMismatch if archive_size != expected_size
            return VerificationCode.Valid

        def precheck_publisher_attestation(attested: bool) -> VerificationCode:
            return VerificationCode.Valid if attested else VerificationCode.MissingPublisherAttestation

        def precheck_threshold(valid_signatures: u64, required_signatures: u64) -> VerificationCode:
            return VerificationCode.Valid if required_signatures > 0 and valid_signatures >= required_signatures else VerificationCode.ThresholdInsufficient

        def precheck_revocation(revoked: bool) -> VerificationCode:
            return VerificationCode.RevokedKey if revoked else VerificationCode.Valid

        def precheck_clock(previous_observation: u64, current_observation: u64) -> VerificationCode:
            return VerificationCode.ClockRollback if current_observation < previous_observation else VerificationCode.Valid

        def code_message(code: VerificationCode) -> cstr:
            return "valid" if code == VerificationCode.Valid
            return "signed metadata is missing" if code == VerificationCode.MissingMetadata
            return "metadata signature is invalid" if code == VerificationCode.InvalidSignature
            return "publisher is not authorized for this namespace" if code == VerificationCode.UnauthorizedNamespace
            return "signature algorithm is not allowed" if code == VerificationCode.UnknownAlgorithm
            return "signed metadata is expired" if code == VerificationCode.ExpiredMetadata
            return "signed metadata rollback detected" if code == VerificationCode.RollbackDetected
            return "authenticated archive digest does not match" if code == VerificationCode.DigestMismatch
            return "authenticated registry identity does not match" if code == VerificationCode.WrongRegistry
            return "authenticated package identity does not match" if code == VerificationCode.WrongPackage
            return "authenticated version does not match" if code == VerificationCode.WrongVersion
            return "authenticated archive size does not match" if code == VerificationCode.ArchiveSizeMismatch
            return "publisher attestation is missing" if code == VerificationCode.MissingPublisherAttestation
            return "signature threshold is insufficient" if code == VerificationCode.ThresholdInsufficient
            return "signing key is revoked" if code == VerificationCode.RevokedKey
            return "trusted clock observation moved backwards" if code == VerificationCode.ClockRollback
            return "signing public key has an invalid length" if code == VerificationCode.MalformedKey
            return "signature has an invalid length" if code == VerificationCode.MalformedSignature
            return "unknown trust verification result"

    private:
        # This identifies only the local test fixture. Production TUF v1.0.36
        # is selected in D-013, but its conformant verifier is not implemented.
        const protocol_selection: cstr = "local detached-Ed25519 registry fixture; production TUF pending"

        def trust_valid_namespace_path(value: darray[u8]&) -> bool:
            return false if value.count == 0.usize() or value.count > 256.usize()
            segment_start: mutable usize = 0.usize()
            for index in 0..<value.count |value, segment_start|:
                if value[index] == 47:
                    return false if not PackageIdentity::valid_name_segment(value, segment_start, index)
                    segment_start <- index + 1.usize()
            return PackageIdentity::valid_name_segment(value, segment_start, value.count)

        def trust_slice_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true

        def trust_slice_prefix(value: darray[u8]&, prefix: darray[u8]&) -> bool:
            return false if value.count < prefix.count
            for index in 0..<prefix.count |value, prefix|:
                return false if value[index] != prefix[index]
            return true
