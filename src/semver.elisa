# Semantic-version policy. Parsing and matching are pure and carry no filesystem,
# network, or trust state across the module boundary.

module SemVer:
    public:
        # A comparison outside -1/0/1 means the available value did not carry
        # enough information to establish SemVer precedence.
        const COMPARE_INCOMPARABLE: i64 = 2

        struct Requirement:
            lower: mutable Model::Version
            upper: mutable Model::Version
            has_lower: mutable bool
            has_upper: mutable bool
            include_lower: mutable bool
            include_upper: mutable bool

        # Compares the precedence representable by Model::Version. That model
        # stores only whether a version has a prerelease, not its identifiers,
        # so same-core prereleases cannot safely be ordered or declared equal.
        # Use compare_text when full SemVer values are available.
        def compare(left: Model::Version, right: Model::Version) -> i64:
            return -1 if left.major < right.major
            return 1 if left.major > right.major
            return -1 if left.minor < right.minor
            return 1 if left.minor > right.minor
            return -1 if left.patch < right.patch
            return 1 if left.patch > right.patch
            return COMPARE_INCOMPARABLE if left.prerelease and right.prerelease
            return -1 if left.prerelease and not right.prerelease
            return 1 if right.prerelease and not left.prerelease
            return 0

        def compare_text(left: darray[u8]&, right: darray[u8]&) -> i64:
            left_parts: mutable ParsedToken = ParsedToken{major: 0, minor: 0, patch: 0, pre_start: 0, pre_end: 0, has_pre: false}
            right_parts: mutable ParsedToken = ParsedToken{major: 0, minor: 0, patch: 0, pre_start: 0, pre_end: 0, has_pre: false}
            return COMPARE_INCOMPARABLE if not parse_token_parts(left, &left_parts) or not parse_token_parts(right, &right_parts)
            return compare_parts(left_parts, right_parts, left, right)

        def parse(value: darray[u8]&, out: mutable Model::Version&) -> bool:
            out <- Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            parts: mutable ParsedToken = ParsedToken{major: 0, minor: 0, patch: 0, pre_start: 0, pre_end: 0, has_pre: false}
            return false if not parse_token_parts(value, &parts)
            out <- Model::Version{major: parts.major, minor: parts.minor, patch: parts.patch, prerelease: parts.has_pre}
            return true

        # v1 requirement grammar: exact versions, ^, ~, and one comparison.
        # The resolver will reject a range it cannot parse; it never guesses.
        def parse_requirement(value: darray[u8]&, out: mutable Requirement&) -> bool:
            empty: Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            out <- Requirement{lower: empty, upper: empty, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
            candidate: mutable Requirement = Requirement{lower: empty, upper: empty, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
            start: mutable usize = 0.usize()
            finish: mutable usize = value.count
            while start < finish and is_space(value[start]):
                start <- start + 1.usize()
            while finish > start and is_space(value[finish - 1.usize()]):
                finish <- finish - 1.usize()
            return false if start >= finish

            operator: mutable u8 = 0
            operator_length: mutable usize = 0.usize()
            if value[start] == 94 or value[start] == 126:
                operator <- value[start]
                operator_length <- 1.usize()
            elif value[start] == 60 or value[start] == 62:
                operator <- value[start]
                operator_length <- 1.usize()
                if start + 1.usize() < finish and value[start + 1.usize()] == 61:
                    operator_length <- 2.usize()

            version_start: mutable usize = start + operator_length
            while version_start < finish and is_space(value[version_start]):
                version_start <- version_start + 1.usize()
            version_end: mutable usize = version_start
            while version_end < finish and not is_space(value[version_end]):
                version_end <- version_end + 1.usize()
            return false if version_start >= version_end
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return false if not parse_version_token(value, version_start, version_end, &parsed)
            return false if parsed.prerelease

            has_second: bool = version_end < finish
            if has_second:
                return false if operator != 60 and operator != 62
                cursor: mutable usize = version_end
                while cursor < finish and is_space(value[cursor]):
                    cursor <- cursor + 1.usize()
                return false if cursor >= finish or (value[cursor] != 60 and value[cursor] != 62)
                second_operator: u8 = value[cursor]
                return false if second_operator == operator
                second_length: mutable usize = 1.usize()
                if cursor + 1.usize() < finish and value[cursor + 1.usize()] == 61:
                    second_length <- 2.usize()
                second_start: mutable usize = cursor + second_length
                while second_start < finish and is_space(value[second_start]):
                    second_start <- second_start + 1.usize()
                second_end: mutable usize = second_start
                while second_end < finish and not is_space(value[second_end]):
                    second_end <- second_end + 1.usize()
                return false if second_start >= second_end or second_end != finish
                second: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                return false if not parse_version_token(value, second_start, second_end, &second)
                return false if second.prerelease
                candidate.lower <- parsed if operator == 62 else second
                candidate.upper <- parsed if operator == 60 else second
                candidate.has_lower <- true
                candidate.has_upper <- true
                candidate.include_lower <- operator_length == 2.usize() if operator == 62 else second_length == 2.usize()
                candidate.include_upper <- operator_length == 2.usize() if operator == 60 else second_length == 2.usize()
                return false if compare(candidate.lower, candidate.upper) > 0
                return false if compare(candidate.lower, candidate.upper) == 0 and (not candidate.include_lower or not candidate.include_upper)
                out <- candidate
                return true
            return false if version_end != finish

            candidate.lower <- parsed
            candidate.upper <- parsed
            candidate.has_lower <- true
            candidate.has_upper <- true
            candidate.include_lower <- true
            candidate.include_upper <- true
            if operator == 94:
                return false if parsed.major == 18446744073709551615 or (parsed.major == 0 and parsed.minor == 18446744073709551615) or (parsed.major == 0 and parsed.minor == 0 and parsed.patch == 18446744073709551615)
                candidate.upper <- caret_upper(parsed)
                candidate.include_upper <- false
            elif operator == 126:
                return false if parsed.minor == 18446744073709551615
                candidate.upper <- Model::Version{major: parsed.major, minor: parsed.minor + 1, patch: 0, prerelease: false}
                candidate.include_upper <- false
            elif operator == 60:
                candidate.has_lower <- false
                candidate.include_upper <- operator_length == 2.usize()
            elif operator == 62:
                candidate.has_upper <- false
                candidate.include_lower <- operator_length == 2.usize()
            out <- candidate
            return true

        def matches(requirement: Requirement, candidate: Model::Version) -> bool:
            return false if candidate.prerelease
            lower_cmp: i64 = compare(candidate, requirement.lower)
            return false if requirement.has_lower and (lower_cmp < 0 or (lower_cmp == 0 and not requirement.include_lower))
            upper_cmp: i64 = compare(candidate, requirement.upper)
            return false if requirement.has_upper and (upper_cmp > 0 or (upper_cmp == 0 and not requirement.include_upper))
            return true

    private:
        const precedence_contract: cstr = "SemVer 2.0 precedence; build metadata excluded from ordering"

        struct ParsedToken:
            major: mutable u64
            minor: mutable u64
            patch: mutable u64
            pre_start: mutable usize
            pre_end: mutable usize
            has_pre: mutable bool

        def compare_parts(left: ParsedToken, right: ParsedToken, left_raw: darray[u8]&, right_raw: darray[u8]&) -> i64:
            return -1 if left.major < right.major
            return 1 if left.major > right.major
            return -1 if left.minor < right.minor
            return 1 if left.minor > right.minor
            return -1 if left.patch < right.patch
            return 1 if left.patch > right.patch
            if left.has_pre != right.has_pre:
                return -1 if left.has_pre else 1
            return 0 if not left.has_pre
            left_cursor: mutable usize = left.pre_start
            right_cursor: mutable usize = right.pre_start
            while left_cursor < left.pre_end or right_cursor < right.pre_end |left_raw, right_raw, left_cursor, right_cursor|:
                return -1 if left_cursor >= left.pre_end
                return 1 if right_cursor >= right.pre_end
                left_end: mutable usize = left_cursor
                right_end: mutable usize = right_cursor
                while left_end < left.pre_end and left_raw[left_end] != 46 |left_raw, left_end|:
                    left_end <- left_end + 1.usize()
                while right_end < right.pre_end and right_raw[right_end] != 46 |right_raw, right_end|:
                    right_end <- right_end + 1.usize()
                left_numeric: mutable bool = true
                right_numeric: mutable bool = true
                index: mutable usize = left_cursor
                while index < left_end |left_raw, left_numeric, index|:
                    left_numeric <- false if left_raw[index] < 48 or left_raw[index] > 57
                    index <- index + 1.usize()
                index <- right_cursor
                while index < right_end |right_raw, right_numeric, index|:
                    right_numeric <- false if right_raw[index] < 48 or right_raw[index] > 57
                    index <- index + 1.usize()
                if left_numeric != right_numeric:
                    return -1 if left_numeric else 1
                if left_numeric:
                    left_length: usize = left_end - left_cursor
                    right_length: usize = right_end - right_cursor
                    return -1 if left_length < right_length
                    return 1 if left_length > right_length
                    for digit_index in 0..<left_length |left_raw, right_raw, left_cursor, right_cursor|:
                        return -1 if left_raw[left_cursor + digit_index] < right_raw[right_cursor + digit_index]
                        return 1 if left_raw[left_cursor + digit_index] > right_raw[right_cursor + digit_index]
                else:
                    limit: usize = left_end - left_cursor if left_end - left_cursor < right_end - right_cursor else right_end - right_cursor
                    index <- 0
                    while index < limit |left_raw, right_raw, left_cursor, right_cursor, index|:
                        return -1 if left_raw[left_cursor + index] < right_raw[right_cursor + index]
                        return 1 if left_raw[left_cursor + index] > right_raw[right_cursor + index]
                        index <- index + 1.usize()
                    return -1 if left_end - left_cursor < right_end - right_cursor
                    return 1 if left_end - left_cursor > right_end - right_cursor
                left_cursor <- left_end + 1.usize()
                right_cursor <- right_end + 1.usize()
            return 0

        def parse_token_parts(value: darray[u8]&, out: mutable ParsedToken&) -> bool:
            dot1: mutable usize = value.count
            dot2: mutable usize = value.count
            for index in 0..<value.count |value, dot1, dot2|:
                break if value[index] == 45
                if value[index] == 46:
                    if dot1 == value.count:
                        dot1 <- index
                    elif dot2 == value.count:
                        dot2 <- index
                    else:
                        return false
            return false if dot1 == value.count or dot2 == value.count or dot1 == 0.usize() or dot2 == dot1 + 1.usize()
            pre_start: mutable usize = value.count
            for index in (dot2 + 1.usize())..<value.count |value, pre_start|:
                if value[index] == 45:
                    pre_start <- index
                    break
            patch_end: usize = pre_start
            return false if patch_end == dot2 + 1.usize()
            return false if not parse_u64(value, 0, dot1, &out.major) or not parse_u64(value, dot1 + 1.usize(), dot2, &out.minor) or not parse_u64(value, dot2 + 1.usize(), patch_end, &out.patch)
            return false if dot1 > 1.usize() and value[0] == 48
            return false if dot2 - dot1 > 2.usize() and value[dot1 + 1.usize()] == 48
            return false if patch_end - dot2 > 2.usize() and value[dot2 + 1.usize()] == 48
            return false if pre_start < value.count and pre_start + 1.usize() >= value.count
            out.has_pre <- pre_start < value.count
            out.pre_start <- pre_start + 1.usize() if out.has_pre else value.count
            out.pre_end <- value.count
            for index in 0..<value.count |value|:
                return false if value[index] == 43
            if out.has_pre:
                segment_start: mutable usize = out.pre_start
                numeric: mutable bool = true
                index: mutable usize = out.pre_start
                while index <= out.pre_end:
                    at_end: bool = index == out.pre_end
                    if at_end or value[index] == 46:
                        return false if index == segment_start
                        return false if numeric and index - segment_start > 1.usize() and value[segment_start] == 48
                        segment_start <- index + 1.usize()
                        numeric <- true
                    else:
                        byte: u8 = value[index]
                        return false if not ((byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 45)
                        numeric <- false if byte < 48 or byte > 57
                    index <- index + 1.usize()
            return true

        def is_space(byte: u8) -> bool:
            return byte == 32 or byte == 9 or byte == 10 or byte == 13

        def parse_u64(value: darray[u8]&, start: usize, end: usize, out: mutable u64&) -> bool:
            return false if start >= end
            number: mutable u64 = 0
            for index in start..<end |value, number|:
                return false if value[index] < 48 or value[index] > 57
                digit: u64 = (value[index] - 48).u64()
                return false if number > 1844674407370955161 or (number == 1844674407370955161 and digit > 5)
                number <- number * 10 + digit
            out <- number
            return true

        def parse_version_token(value: darray[u8]&, start: usize, end: usize, out: mutable Model::Version&) -> bool:
            first_dot: mutable usize = end
            second_dot: mutable usize = end
            for index in start..<end |value, first_dot, second_dot|:
                if value[index] == 46:
                    if first_dot == end:
                        first_dot <- index
                    elif second_dot == end:
                        second_dot <- index
                    else:
                        return false
            return false if first_dot == end or second_dot == end or first_dot == start or second_dot == first_dot + 1.usize() or second_dot + 1.usize() >= end
            return false if first_dot - start > 1.usize() and value[start] == 48
            return false if second_dot - first_dot > 2.usize() and value[first_dot + 1.usize()] == 48
            major: mutable u64 = 0
            minor: mutable u64 = 0
            patch: mutable u64 = 0
            return false if not parse_u64(value, start, first_dot, &major)
            return false if not parse_u64(value, first_dot + 1.usize(), second_dot, &minor)
            prerelease_start: usize = second_dot + 1.usize()
            prerelease_end: mutable usize = end
            for index in prerelease_start..<end |value, prerelease_end|:
                if value[index] == 45:
                    prerelease_end <- index
                    break
            return false if prerelease_end - prerelease_start > 1.usize() and value[prerelease_start] == 48
            return false if not parse_u64(value, prerelease_start, prerelease_end, &patch)
            if prerelease_end < end:
                pre_start: mutable usize = prerelease_end + 1.usize()
                return false if pre_start >= end
                segment_start: mutable usize = pre_start
                segment_digits: mutable bool = true
                while pre_start < end:
                    byte: u8 = value[pre_start]
                    if byte == 46:
                        return false if pre_start == segment_start
                        return false if segment_digits and pre_start - segment_start > 1.usize() and value[segment_start] == 48
                        segment_start <- pre_start + 1.usize()
                        segment_digits <- true
                    else:
                        return false if not ((byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 45)
                        segment_digits <- false if byte < 48 or byte > 57
                    pre_start <- pre_start + 1.usize()
                return false if pre_start == segment_start
                return false if segment_digits and pre_start - segment_start > 1.usize() and value[segment_start] == 48
            out <- Model::Version{major: major, minor: minor, patch: patch, prerelease: prerelease_end < end}
            return true

        def caret_upper(value: Model::Version) -> Model::Version:
            return Model::Version{major: value.major + 1, minor: 0, patch: 0, prerelease: false} if value.major > 0
            return Model::Version{major: 0, minor: value.minor + 1, patch: 0, prerelease: false} if value.minor > 0
            return Model::Version{major: 0, minor: 0, patch: value.patch + 1, prerelease: false}
