# Authenticated, deterministic registry provider.
#
# The provider is intentionally file-backed for the first vertical slice. A
# future HTTP transport may feed the same metadata bytes into this module, but
# it must preserve the exact verification and path rules below. Network code,
# credentials, and archive extraction stay outside this namespace.

include "./platform.elisa"
include "./archive.elisa"
include "./package/manifest.elisa"
include "./integrity.elisa"
include "./json.elisa"
include "./package/model.elisa"
include "./package/package_identity.elisa"
include "./resolution/resolve.elisa"
include "./resolution/semver.elisa"
include "./resolution/solver.elisa"
include "./trust.elisa"
include "./tuf.elisa"
include "./registry/index_snapshot.elisa"
include "./registry/release_metadata.elisa"
include "./registry/checkpoint_store.elisa"
include "./registry/trust_storage.elisa"
include "./registry/trust_identity.elisa"
include "./registry/trust_paths.elisa"
include "./registry/rollback_records.elisa"
include "./registry/files.elisa"
include "./project/files.elisa"

module Registry:
    public:
        const enum ResultCode of u8:
            Ok
            NotConfigured
            InvalidConfiguration
            MissingIndex
            NoMatchingVersion
            MalformedMetadata
            MissingSignature
            MissingTrustRoot
            InvalidSignature
            ExpiredMetadata
            RollbackDetected
            DigestMismatch
            ArchiveMissing
            ResourceLimit
            TrustStateUnavailable
            TrustStateMalformed
            ClockRollback
            Unsatisfiable
            ClockUnavailable
            ExpiryHorizon
            TrustRootChanged
            TufEquivocationDetected

        # Render a selected stable version as the exact solver requirement used
        # when replaying registry lock preferences. Keeping this formatter in
        # the provider namespace prevents cache paths or CLI-only formatting
        # helpers from leaking into resolver constraints.
        def exact_requirement(version: Model::Version, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            ByteText::append_decimal(out, version.major)
            out.push(46)
            ByteText::append_decimal(out, version.minor)
            out.push(46)
            ByteText::append_decimal(out, version.patch)

        # Decode dependency constraints from already authenticated metadata.
        # The output is kept separate from metadata records because the current
        # stage1 compiler cannot safely move recursive darray fields nested in a
        # public record; keeping this buffer at the call boundary preserves
        # ownership and makes the limitation explicit.
        def read_dependencies(metadata: darray[u8]&, out: mutable darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return ReleaseMetadata::dependencies(metadata, out)

        # Return the authenticated registry's bounded version index. Its exact
        # bytes are bound to a signed, expiring per-package snapshot, whose
        # generation is recorded in the same rollback-protected user state as
        # selected release identities.
        def read_index(package: darray[u8]&, out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            yanked_flags: mutable darray[u8] = []
            return read_index_with_yanked(package, out, &yanked_flags, generation_out, snapshot_digest_out, identity_out)

        # Return the exact signed yanked set beside the authenticated version
        # list. Yank state is index policy and cannot be inferred from release
        # metadata; security revocation requires a separate authenticated rule.
        # The output is a 0/1 byte bitmap aligned with newline-delimited versions.
        def read_index_with_yanked(package: darray[u8]&, out: mutable darray[u8]&, yanked_flags_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            key_fingerprint: mutable darray[u8] = []
            return read_index_with_key_fingerprint(package, out, yanked_flags_out, generation_out, snapshot_digest_out, identity_out, &key_fingerprint)

    private:
        def read_index_with_key_fingerprint(package: darray[u8]&, out: mutable darray[u8]&, yanked_flags_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, key_fingerprint_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            yanked_flags_out.resize(0)
            generation_out <- 0
            snapshot_digest_out.resize(0)
            identity_out.resize(0)
            key_fingerprint_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package)
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not RegistryRoot::valid(root)
            key_path: mutable darray[u8] = []
            trust_root_status: ResultCode = configured_trust_root(root, &key_path)
            return trust_root_status if trust_root_status != ResultCode.Ok
            return read_verified_index(root, package, key_path, out, yanked_flags_out, generation_out, snapshot_digest_out, identity_out, key_fingerprint_out)

    public:

        # Read one archive selected by authenticated metadata. The caller must
        # supply the exact version, archive leaf, digest, and size returned by
        # `resolve`; this boundary never follows a URL or accepts an arbitrary
        # path. The bytes are checked again immediately before they are handed
        # to cache or extraction code so a mutable fixture cannot race the
        # metadata verification step unnoticed.
        def read_archive(package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&, expected_digest: darray[u8]&, expected_size: u64, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version) or not Archive::is_safe_entry(archive) or not Integrity::valid_sha256_hex(expected_digest) or expected_size > Archive::max_archive_bytes.u64()
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not RegistryRoot::valid(root)
            return ResultCode.MalformedMetadata if metadata.count == 0.usize() or metadata.count > Json::max_document_bytes or not Json::valid_document(metadata) or not Json::unique_object_keys(metadata) or not ReleaseMetadata::has_root_object(metadata) or not ReleaseMetadata::allowed_fields(metadata)
            metadata_archive: mutable darray[u8] = []
            metadata_digest: mutable darray[u8] = []
            metadata_size: mutable u64 = 0
            return ResultCode.MalformedMetadata if not ReleaseMetadata::match_identity_fields(metadata, root, package, version, &metadata_archive, &metadata_digest, &metadata_size)
            return ResultCode.MalformedMetadata if not ByteText::equal(metadata_archive, archive)
            return ResultCode.DigestMismatch if not ByteText::equal(metadata_digest, expected_digest) or metadata_size != expected_size
            path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not RegistryFiles::join_path_version(root, package, version, &path)
            path.push(47)
            for index in 0..<archive.count |path, archive|:
                path.push(archive[index])
            verified_archive: mutable darray[u8] = []
            return ResultCode.ArchiveMissing if not RegistryFiles::read_file(path, Archive::max_archive_bytes, &verified_archive)
            return ResultCode.DigestMismatch if verified_archive.count.u64() != expected_size
            digest_bytes: mutable darray[u8] = []
            digest: mutable darray[u8] = []
            return ResultCode.DigestMismatch if Integrity::sha256(verified_archive, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest) or not ByteText::equal(digest, expected_digest)
            return ResultCode.MalformedMetadata if not release_archive_matches_metadata(package, version, metadata, verified_archive)
            for index in 0..<verified_archive.count |verified_archive, out|:
                out.push(verified_archive[index])
            return ResultCode.Ok

        # Bind the package shipped in an authenticated release archive to the
        # same identity and dependency graph that the signed registry metadata
        # authorized. Callers must authenticate metadata before using this
        # check; the function itself treats both inputs as untrusted bytes.
        def release_archive_matches_metadata(package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version)
            manifest_name: mutable darray[u8] = [101, 108, 105, 115, 97, 112, 107, 103, 46, 106, 115, 111, 110]
            manifest: mutable darray[u8] = []
            return false if not Archive::read_ustar_entry(archive, manifest_name, &manifest)
            return false if manifest.count == 0 or manifest.count > 1048576 or not Json::valid_utf8(manifest) or not Json::valid_document(manifest) or not Json::unique_object_keys(manifest) or not Manifest::allowed_keys(manifest) or not ReleaseMetadata::has_root_object(manifest)
            for index in 0..<manifest.count |manifest|:
                return false if manifest[index] == 0
            schema: mutable u64 = 0
            return false if not ReleaseMetadata::unsigned_field(manifest, "schema-version", &schema) or schema != 1
            package_start: usize = Json::root_value_offset(manifest, "package")
            package_end: usize = Json::object_end(manifest, package_start)
            return false if package_start >= manifest.count or manifest[package_start] != 123 or package_end <= package_start or package_end >= manifest.count
            manifest_package: mutable darray[u8] = []
            manifest_version: mutable darray[u8] = []
            return false if not Json::object_string_value(manifest, package_start, package_end, "name", &manifest_package) or not Json::object_string_value(manifest, package_start, package_end, "version", &manifest_version)
            return false if not ByteText::equal(manifest_package, package) or not ByteText::equal(manifest_version, version)
            return false if not ReleaseMetadata::optional_object_empty(manifest, "dev-dependencies")
            signed_dependencies: mutable darray[Solver::Constraint] = []
            manifest_dependencies: mutable darray[Solver::Constraint] = []
            return false if not ReleaseMetadata::dependencies(metadata, &signed_dependencies) or not ReleaseMetadata::dependencies(manifest, &manifest_dependencies)
            return false if not ReleaseMetadata::dependency_sets_equal(signed_dependencies, manifest_dependencies)
            return true

        # Record the authenticated immutable package identity in user-owned
        # trust state. This is separate from the project lockfile so deleting
        # or restoring a project cannot reset rollback protection.
        def record_trusted(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return ResultCode.ClockUnavailable if now < 0
            expiry_status: ResultCode = metadata_expiry_status(expires, now.u64())
            return expiry_status if expiry_status != ResultCode.Ok
            versions: mutable darray[u8] = []
            yanked_flags: mutable darray[u8] = []
            generation: mutable u64 = 0
            index_digest: mutable darray[u8] = []
            index_identity: mutable darray[u8] = []
            key_fingerprint: mutable darray[u8] = []
            index_status: ResultCode = read_index_with_key_fingerprint(package, &versions, &yanked_flags, &generation, &index_digest, &index_identity, &key_fingerprint)
            return index_status if index_status != ResultCode.Ok
            return ResultCode.NoMatchingVersion if not registry_index_contains_version(versions, version)
            return trust_state_record_at_index(package, version, digest, metadata_digest, expires, generation, index_digest, index_identity, key_fingerprint)

        # Commit a selected release only while the exact authenticated index
        # snapshot that authorized it is still the highest snapshot recorded
        # for this registry/package. The check and package-history update share
        # one trust-state lock acquisition, closing the gap between index read
        # and package trust publication.
        def record_trusted_at_index(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64, generation: u64, index_digest: darray[u8]&, index_identity: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or generation == 0 or not Integrity::valid_sha256_hex(index_digest)
            return ResultCode.InvalidConfiguration if not Integrity::valid_sha256_hex(metadata_digest) or not Integrity::valid_sha256_hex(digest)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return ResultCode.ClockUnavailable if now < 0
            expiry_status: ResultCode = metadata_expiry_status(expires, now.u64())
            return expiry_status if expiry_status != ResultCode.Ok
            versions: mutable darray[u8] = []
            yanked_flags: mutable darray[u8] = []
            current_generation: mutable u64 = 0
            current_digest: mutable darray[u8] = []
            current_identity: mutable darray[u8] = []
            key_fingerprint: mutable darray[u8] = []
            index_status: ResultCode = read_index_with_key_fingerprint(package, &versions, &yanked_flags, &current_generation, &current_digest, &current_identity, &key_fingerprint)
            return index_status if index_status != ResultCode.Ok
            return ResultCode.RollbackDetected if current_generation != generation or not ByteText::equal(current_digest, index_digest) or not ByteText::equal(current_identity, index_identity)
            return ResultCode.NoMatchingVersion if not registry_index_contains_version(versions, version)
            return trust_state_record_at_index(package, version, digest, metadata_digest, expires, generation, index_digest, index_identity, key_fingerprint)

        # Check an identity against persisted signed metadata evidence and
        # advance the state-bound wall-clock floor while holding the same lock
        # used by writers. Offline callers invoke this only after authenticating
        # the cached metadata and archive bytes.
        def verify_trusted(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package)
            return trust_state_verify(package, version, digest, metadata_digest, expires)

        # Read the durable floors for one stable TUF registry identity. The
        # result uses the same canonical batch format accepted by the commit
        # API; an empty result means this identity has no saved checkpoints.
        # Commit rechecks these floors under its own lock, so a caller must
        # still handle concurrent refreshes through the commit result.
        def read_tuf_checkpoint_batch(registry_identity: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            out.resize(0)
            return ResultCode.InvalidConfiguration if not Tuf::valid_registry_identity_bytes(registry_identity)
            identity_copy: mutable darray[u8] = []
            for index in 0..<registry_identity.count |identity_copy, registry_identity|:
                identity_copy.push(registry_identity[index])
            return checkpoint_store_result(CheckpointStore::read(identity_copy, out))

        # Atomically persist the complete set of already-authenticated TUF
        # role checkpoints for one stable registry identity. The caller must
        # finish root rotation, signature thresholds, delegations, expiry,
        # snapshot/timestamp binding, and target authorization before calling.
        # The canonical sorted batch is rechecked against durable floors under
        # the same lock that publishes the replacement state file.
        def commit_authenticated_tuf_checkpoint_batch(registry_identity: darray[u8]&, batch: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not Tuf::valid_registry_identity_bytes(registry_identity)
            # Bound the copy at the public boundary; the private persistence
            # routine owns the complete batch grammar check so future internal
            # callers cannot bypass it.
            return ResultCode.ResourceLimit if batch.count > Tuf::max_metadata_file_bytes
            identity_copy: mutable darray[u8] = []
            batch_copy: mutable darray[u8] = []
            for index in 0..<registry_identity.count |identity_copy, registry_identity|:
                identity_copy.push(registry_identity[index])
            for index in 0..<batch.count |batch_copy, batch|:
                batch_copy.push(batch[index])
            return checkpoint_store_result(CheckpointStore::commit_authenticated(identity_copy, batch_copy))

        # Resolve one package and verify its detached metadata. The regular
        # entry also verifies the selected archive before exposing success.
        def resolve(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            generation: mutable u64 = 0
            snapshot_digest: mutable darray[u8] = []
            index_identity: mutable darray[u8] = []
            return resolve_internal(package, requirement, previous_version, version_out, archive_out, digest_out, archive_size_out, metadata_out, true, &generation, &snapshot_digest, &index_identity)

        # Resolution variant for callers that persist a selected artifact. The
        # returned evidence is from the same verified index bytes whose version
        # list was used to select the result.
        def resolve_with_index_evidence(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return resolve_internal(package, requirement, previous_version, version_out, archive_out, digest_out, archive_size_out, metadata_out, true, generation_out, snapshot_digest_out, identity_out)

        # Verify one exact version already selected by the authenticated graph
        # solver. This entry permits the solver's exact locked-yank exception;
        # it does not choose a version and must not replace solver policy.
        def resolve_selected_with_index_evidence(package: darray[u8]&, version: darray[u8]&, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            version_out.resize(0)
            archive_out.resize(0)
            digest_out.resize(0)
            metadata_out.resize(0)
            archive_size_out <- 0
            generation_out <- 0
            snapshot_digest_out.resize(0)
            identity_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version)
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return ResultCode.InvalidConfiguration if not SemVer::parse(version, &parsed) or parsed.prerelease
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not RegistryRoot::valid(root)
            key_path: mutable darray[u8] = []
            trust_root_status: ResultCode = configured_trust_root(root, &key_path)
            return trust_root_status if trust_root_status != ResultCode.Ok
            index: mutable darray[u8] = []
            yanked_flags: mutable darray[u8] = []
            key_fingerprint: mutable darray[u8] = []
            index_status: ResultCode = read_verified_index(root, package, key_path, &index, &yanked_flags, generation_out, snapshot_digest_out, identity_out, &key_fingerprint)
            return index_status if index_status != ResultCode.Ok
            return ResultCode.NoMatchingVersion if not registry_index_contains_version(index, version)
            return resolve_selected_internal(root, key_path, package, version, Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, version_out, archive_out, digest_out, archive_size_out, metadata_out, true)

        # Candidate enumeration authenticates metadata without reading every
        # archive. This keeps a large signed index from forcing unbounded
        # archive I/O before the solver knows which versions are selected.
        def resolve_metadata(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            generation: mutable u64 = 0
            snapshot_digest: mutable darray[u8] = []
            index_identity: mutable darray[u8] = []
            return resolve_internal(package, requirement, previous_version, version_out, archive_out, digest_out, archive_size_out, metadata_out, false, &generation, &snapshot_digest, &index_identity)

        # Resolve one candidate selected from the exact version-list bytes
        # returned by `read_index`. The caller verifies that snapshot once
        # before iterating its candidates; this entry authenticates the
        # selected release metadata independently. Callers without a verified
        # index must use `resolve_metadata` instead.
        def resolve_candidate_metadata(package: darray[u8]&, version: darray[u8]&, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            version_out.resize(0)
            archive_out.resize(0)
            digest_out.resize(0)
            archive_size_out <- 0
            metadata_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version)
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not RegistryRoot::valid(root)
            key_path: mutable darray[u8] = []
            trust_root_status: ResultCode = configured_trust_root(root, &key_path)
            return trust_root_status if trust_root_status != ResultCode.Ok
            return resolve_selected_internal(root, key_path, package, version, Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, version_out, archive_out, digest_out, archive_size_out, metadata_out, false)

        # Read the detached signature that authenticated one immutable metadata
        # record. This is used only after an online fetch has verified the record,
        # so the signature can be carried into the content-addressed offline cache.
        def read_signature(package: darray[u8]&, version: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version)
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not RegistryRoot::valid(root)
            metadata_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not RegistryFiles::join_path_version(root, package, version, &metadata_path)
            metadata_path.push(47)
            metadata_path.push(109)
            metadata_path.push(101)
            metadata_path.push(116)
            metadata_path.push(97)
            metadata_path.push(100)
            metadata_path.push(97)
            metadata_path.push(116)
            metadata_path.push(97)
            metadata_path.push(46)
            metadata_path.push(115)
            metadata_path.push(105)
            metadata_path.push(103)
            return ResultCode.MissingSignature if not RegistryFiles::read_file(metadata_path, 64.usize(), out)
            return ResultCode.MissingSignature if out.count != 64.usize()
            return ResultCode.Ok

        # Verify a metadata snapshot restored from the offline cache. The cache
        # supplies exact bytes and the detached signature; this function repeats
        # the same identity, digest, trust-root, expiry, and dependency checks as
        # the live provider before exposing any fields to lock validation.
        def verify_metadata_snapshot(package: darray[u8]&, version: darray[u8]&, expected_metadata_digest: darray[u8]&, metadata: darray[u8]&, signature: darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, expires_out: mutable u64&, dependencies_out: mutable darray[Solver::Constraint]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            archive_out.resize(0)
            digest_out.resize(0)
            archive_size_out <- 0
            expires_out <- 0
            dependencies_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version) or not Integrity::valid_sha256_hex(expected_metadata_digest)
            return ResultCode.MalformedMetadata if metadata.count == 0.usize() or metadata.count > 1048576.usize() or not Json::valid_document(metadata) or not Json::unique_object_keys(metadata) or not ReleaseMetadata::has_root_object(metadata) or not ReleaseMetadata::allowed_fields(metadata)
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not RegistryRoot::valid(root)
            verified_archive: mutable darray[u8] = []
            verified_digest: mutable darray[u8] = []
            verified_archive_size: mutable u64 = 0
            return ResultCode.MalformedMetadata if not ReleaseMetadata::match_identity_fields(metadata, root, package, version, &verified_archive, &verified_digest, &verified_archive_size)
            metadata_digest_bytes: mutable darray[u8] = []
            metadata_digest: mutable darray[u8] = []
            return ResultCode.DigestMismatch if Integrity::sha256(metadata, &metadata_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(metadata_digest_bytes, &metadata_digest) or not ByteText::equal(metadata_digest, expected_metadata_digest)
            key_path: mutable darray[u8] = []
            trust_root_status: ResultCode = configured_trust_root(root, &key_path)
            return trust_root_status if trust_root_status != ResultCode.Ok
            public_key: mutable darray[u8] = []
            return ResultCode.MissingTrustRoot if RegistryFiles::read_trusted_file(key_path, 32.usize(), &public_key) != 32
            trust_status: Trust::VerificationCode = Trust::verify_detached("ed25519", public_key, metadata, signature)
            return ResultCode.InvalidSignature if trust_status != Trust::VerificationCode.Valid
            verified_expires: mutable u64 = 0
            return ResultCode.MalformedMetadata if not ReleaseMetadata::unsigned_field(metadata, "expires", &verified_expires)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return ResultCode.ClockUnavailable if now < 0
            expiry_status: ResultCode = metadata_expiry_status(verified_expires, now.u64())
            return expiry_status if expiry_status != ResultCode.Ok
            return ResultCode.MalformedMetadata if not ReleaseMetadata::dependencies(metadata, dependencies_out)
            for index in 0..<verified_archive.count |archive_out, verified_archive|:
                archive_out.push(verified_archive[index])
            for index in 0..<verified_digest.count |digest_out, verified_digest|:
                digest_out.push(verified_digest[index])
            archive_size_out <- verified_archive_size
            expires_out <- verified_expires
            return ResultCode.Ok

    private:
        def resolve_internal(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&, verify_archive: bool, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            version_out.resize(0)
            archive_out.resize(0)
            digest_out.resize(0)
            metadata_out.resize(0)
            archive_size_out <- 0
            generation_out <- 0
            snapshot_digest_out.resize(0)
            identity_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package)
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not RegistryRoot::valid(root)
            key_path: mutable darray[u8] = []
            trust_root_status: ResultCode = configured_trust_root(root, &key_path)
            return trust_root_status if trust_root_status != ResultCode.Ok
            index: mutable darray[u8] = []
            index_key_fingerprint: mutable darray[u8] = []
            index_yanked_flags: mutable darray[u8] = []
            index_status: ResultCode = read_verified_index(root, package, key_path, &index, &index_yanked_flags, generation_out, snapshot_digest_out, identity_out, &index_key_fingerprint)
            return index_status if index_status != ResultCode.Ok
            eligible_index: mutable darray[u8] = []
            return ResultCode.MalformedMetadata if not filter_yanked_versions(index, index_yanked_flags, &eligible_index)
            selected: mutable darray[u8] = []
            return ResultCode.NoMatchingVersion if not Resolve::select_highest_version(eligible_index, requirement, &selected)
            return resolve_selected_internal(root, key_path, package, selected, previous_version, version_out, archive_out, digest_out, archive_size_out, metadata_out, verify_archive)

        # The signed index parser returns one byte per version line. Keep the
        # direct resolver fail-closed if those authenticated views ever stop
        # matching, and never offer a yanked release as a new unpinned choice.
        def filter_yanked_versions(index: darray[u8]&, yanked_flags: darray[u8]&, eligible_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            eligible_out.resize(0)
            cursor: mutable usize = 0.usize()
            ordinal: mutable usize = 0.usize()
            while cursor < index.count:
                finish: mutable usize = cursor
                while finish < index.count and index[finish] != 10 |index, finish|:
                    finish <- finish + 1.usize()
                return false if finish == index.count or finish == cursor or ordinal >= yanked_flags.count or yanked_flags[ordinal] > 1
                if yanked_flags[ordinal] == 0:
                    for item in cursor..<(finish + 1.usize()) |eligible_out, index|:
                        eligible_out.push(index[item])
                ordinal <- ordinal + 1.usize()
                cursor <- finish + 1.usize()
            return ordinal == yanked_flags.count

        def resolve_selected_internal(root: darray[u8]&, key_path: darray[u8]&, package: darray[u8]&, selected: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&, verify_archive: bool) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            version_out.resize(0)
            archive_out.resize(0)
            digest_out.resize(0)
            metadata_out.resize(0)
            archive_size_out <- 0
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(selected)
            metadata_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not RegistryFiles::join_path_version(root, package, selected, &metadata_path)
            metadata_path.push(47)
            metadata_path.push(109)
            metadata_path.push(101)
            metadata_path.push(116)
            metadata_path.push(97)
            metadata_path.push(100)
            metadata_path.push(97)
            metadata_path.push(116)
            metadata_path.push(97)
            metadata_path.push(46)
            metadata_path.push(106)
            metadata_path.push(115)
            metadata_path.push(111)
            metadata_path.push(110)
            metadata: mutable darray[u8] = []
            return ResultCode.MalformedMetadata if not RegistryFiles::read_file(metadata_path, Json::max_document_bytes, &metadata)
            return ResultCode.MalformedMetadata if not Json::valid_document(metadata) or not Json::unique_object_keys(metadata) or not ReleaseMetadata::has_root_object(metadata)
            return ResultCode.MalformedMetadata if not ReleaseMetadata::allowed_fields(metadata)
            selected_archive: mutable darray[u8] = []
            selected_digest: mutable darray[u8] = []
            selected_archive_size: mutable u64 = 0
            return ResultCode.MalformedMetadata if not ReleaseMetadata::match_identity_fields(metadata, root, package, selected, &selected_archive, &selected_digest, &selected_archive_size)
            return ResultCode.RollbackDetected if selected_version_below(selected, previous_version)
            signature_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not RegistryFiles::sibling_path(metadata_path, "metadata.sig", &signature_path)
            signature: mutable darray[u8] = []
            return ResultCode.MissingSignature if not RegistryFiles::read_file(signature_path, 64.usize(), &signature)
            public_key: mutable darray[u8] = []
            return ResultCode.MissingTrustRoot if RegistryFiles::read_trusted_file(key_path, 32.usize(), &public_key) != 32
            trust_status: Trust::VerificationCode = Trust::verify_detached("ed25519", public_key, metadata, signature)
            return ResultCode.InvalidSignature if trust_status != Trust::VerificationCode.Valid
            expires: mutable u64 = 0
            return ResultCode.MalformedMetadata if not ReleaseMetadata::unsigned_field(metadata, "expires", &expires)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return ResultCode.ClockUnavailable if now < 0
            expiry_status: ResultCode = metadata_expiry_status(expires, now.u64())
            return expiry_status if expiry_status != ResultCode.Ok
            if not verify_archive:
                for index in 0..<selected.count |version_out, selected|:
                    version_out.push(selected[index])
                for index in 0..<metadata.count |metadata_out, metadata|:
                    metadata_out.push(metadata[index])
                for index in 0..<selected_archive.count |archive_out, selected_archive|:
                    archive_out.push(selected_archive[index])
                for index in 0..<selected_digest.count |digest_out, selected_digest|:
                    digest_out.push(selected_digest[index])
                archive_size_out <- selected_archive_size
                return ResultCode.Ok
            archive_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not RegistryFiles::join_path_version(root, package, selected, &archive_path)
            archive_path.push(47)
            for index in 0..<selected_archive.count |archive_path, selected_archive|:
                archive_path.push(selected_archive[index])
            archive_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(archive_path, &archive_c)
            archive_name: cstr = (&archive_c[0]).cast[cstr] can Unsafe.PointerCast
            actual_size: i64 = Platform::pkg_package_file_size(archive_name)
            return ResultCode.ArchiveMissing if actual_size < 0
            return ResultCode.DigestMismatch if actual_size.u64() != selected_archive_size
            archive_bytes: mutable darray[u8] = []
            return ResultCode.ArchiveMissing if not RegistryFiles::read_file(archive_path, Archive::max_archive_bytes, &archive_bytes)
            return ResultCode.DigestMismatch if archive_bytes.count.u64() != selected_archive_size
            actual_digest_bytes: mutable darray[u8] = []
            actual_digest: mutable darray[u8] = []
            return ResultCode.DigestMismatch if Integrity::sha256(archive_bytes, &actual_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(actual_digest_bytes, &actual_digest) or not ByteText::equal(actual_digest, selected_digest)
            return ResultCode.MalformedMetadata if not release_archive_matches_metadata(package, selected, metadata, archive_bytes)
            for index in 0..<selected.count |version_out, selected|:
                version_out.push(selected[index])
            for index in 0..<metadata.count |metadata_out, metadata|:
                metadata_out.push(metadata[index])
            for index in 0..<selected_archive.count |archive_out, selected_archive|:
                archive_out.push(selected_archive[index])
            for index in 0..<selected_digest.count |digest_out, selected_digest|:
                digest_out.push(selected_digest[index])
            archive_size_out <- selected_archive_size
            return ResultCode.Ok

    public:
        def result_message(code: ResultCode) -> cstr:
            return "ok" if code == ResultCode.Ok
            return "registry is not configured" if code == ResultCode.NotConfigured
            return "registry configuration is invalid" if code == ResultCode.InvalidConfiguration
            return "registry index is missing or unreadable" if code == ResultCode.MissingIndex
            return "no registry version satisfies the requirement" if code == ResultCode.NoMatchingVersion
            return "registry metadata or index snapshot is malformed" if code == ResultCode.MalformedMetadata
            return "registry signature is missing" if code == ResultCode.MissingSignature
            return "registry trust root is missing" if code == ResultCode.MissingTrustRoot
            return "registry signature is invalid" if code == ResultCode.InvalidSignature
            return "registry metadata or index snapshot is expired" if code == ResultCode.ExpiredMetadata
            return "registry metadata rollback detected" if code == ResultCode.RollbackDetected
            return "registry archive digest does not match metadata" if code == ResultCode.DigestMismatch
            return "registry archive is missing or unreadable" if code == ResultCode.ArchiveMissing
            return "registry metadata exceeds the configured resource limit" if code == ResultCode.ResourceLimit
            return "registry trust state is unavailable" if code == ResultCode.TrustStateUnavailable
            return "registry trust state is malformed" if code == ResultCode.TrustStateMalformed
            return "registry trust root changed without an authenticated rotation" if code == ResultCode.TrustRootChanged
            return "registry trust clock moved backwards" if code == ResultCode.ClockRollback
            return "registry dependency graph is unsatisfiable" if code == ResultCode.Unsatisfiable
            return "host wall clock is unavailable" if code == ResultCode.ClockUnavailable
            return "registry metadata or index snapshot expiry exceeds the 30-day policy horizon" if code == ResultCode.ExpiryHorizon
            return "TUF metadata equivocation detected" if code == ResultCode.TufEquivocationDetected
            return "unknown registry result"

    private:

        def trust_state_has_override() -> bool:
            override: u8&? = Platform::pkg_getenv("ELISAPKG_TRUST_STATE")
            return true if override is configured
            return false

        def configured_root(out: mutable darray[u8]&) -> bool:
            out.resize(0)
            value_ref: u8&? = Platform::pkg_getenv("ELISAPKG_REGISTRY_DIR")
            if value_ref is configured:
                value: cstr = configured.cast[cstr]
                length: usize = Platform::pkg_strlen(value)
                return false if length == 0 or length > 4096
                for index in 0..<length |out, value|:
                    out.push(value[index].u8())
                return true
            return false

        def configured_trust_root(registry_root: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # Trust material is configured out of band. Keeping the key next
            # to mutable registry metadata would let a registry replacement
            # replace its own verification root as well.
            out.resize(0)
            value_ref: u8&? = Platform::pkg_getenv("ELISAPKG_REGISTRY_TRUST_ROOT")
            if value_ref is configured:
                value: cstr = configured.cast[cstr]
                length: usize = Platform::pkg_strlen(value)
                return ResultCode.InvalidConfiguration if length == 0 or length > 4096 or value[0].u8() != 47
                for index in 0..<length |out, value|:
                    byte: u8 = value[index].u8()
                    return ResultCode.InvalidConfiguration if byte == 0 or byte < 32 or byte == 127 or byte == 92
                    out.push(byte)
                return ResultCode.InvalidConfiguration if out[out.count - 1.usize()] == 47
                segment_start: mutable usize = 1.usize()
                for index in 1..<(length + 1.usize()) |value, segment_start|:
                    if index == length or value[index].u8() == 47:
                        segment_length: usize = index - segment_start
                        return ResultCode.InvalidConfiguration if segment_length == 0.usize() or segment_length == 1.usize() and value[segment_start].u8() == 46 or segment_length == 2.usize() and value[segment_start].u8() == 46 and value[segment_start + 1.usize()].u8() == 46
                        segment_start <- index + 1.usize()
                return ResultCode.InvalidConfiguration if RegistryFiles::path_is_same_or_beneath(out, registry_root)
                canonical_registry: mutable darray[u8] = []
                canonical_trust: mutable darray[u8] = []
                return ResultCode.InvalidConfiguration if not RegistryFiles::canonical_path(registry_root, &canonical_registry)
                return ResultCode.MissingTrustRoot if not RegistryFiles::canonical_path(out, &canonical_trust)
                return ResultCode.InvalidConfiguration if RegistryFiles::path_is_same_or_beneath(canonical_trust, canonical_registry)
                return ResultCode.Ok
            return ResultCode.MissingTrustRoot

        def read_verified_index(root: darray[u8]&, package: darray[u8]&, key_path: darray[u8]&, out: mutable darray[u8]&, yanked_flags_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, key_fingerprint_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            out.resize(0)
            yanked_flags_out.resize(0)
            generation_out <- 0
            snapshot_digest_out.resize(0)
            identity_out.resize(0)
            key_fingerprint_out.resize(0)
            index_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not RegistryFiles::join_path_leaf(root, package, "index", &index_path)
            snapshot: mutable darray[u8] = []
            loaded: i64 = RegistryFiles::read_trusted_file(index_path, 1048576.usize(), &snapshot)
            return ResultCode.MissingIndex if loaded == -2
            return ResultCode.ResourceLimit if loaded == -27
            return ResultCode.InvalidConfiguration if loaded < 0
            return ResultCode.MalformedMetadata if loaded == 0 or snapshot.count > 1048576

            signature_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not RegistryFiles::join_path_leaf(root, package, "index.sig", &signature_path)
            signature: mutable darray[u8] = []
            signature_size: i64 = RegistryFiles::read_trusted_file(signature_path, 64.usize(), &signature)
            return ResultCode.MissingSignature if signature_size < 0 or signature_size != 64
            public_key: mutable darray[u8] = []
            return ResultCode.MissingTrustRoot if RegistryFiles::read_trusted_file(key_path, 32.usize(), &public_key) != 32
            key_fingerprint_bytes: mutable darray[u8] = []
            sha_status: Integrity::DigestCode = Integrity::sha256(public_key, &key_fingerprint_bytes)
            return ResultCode.TrustStateUnavailable if sha_status != Integrity::DigestCode.Ok
            key_fingerprint_hex: mutable darray[u8] = []
            return ResultCode.TrustStateUnavailable if not Integrity::hex_digest(key_fingerprint_bytes, &key_fingerprint_hex)
            trust_status: Trust::VerificationCode = Trust::verify_detached("ed25519", public_key, snapshot, signature)
            return ResultCode.InvalidSignature if trust_status != Trust::VerificationCode.Valid

            versions: mutable darray[u8] = []
            yanked_flags: mutable darray[u8] = []
            snapshot_root: mutable darray[u8] = []
            snapshot_package: mutable darray[u8] = []
            generation: mutable u64 = 0
            expires: mutable u64 = 0
            return ResultCode.MalformedMetadata if not RegistryIndexSnapshot::parse(snapshot, &snapshot_root, &snapshot_package, &generation, &expires, &versions, &yanked_flags)
            return ResultCode.InvalidSignature if not ByteText::equal(snapshot_root, root) or not ByteText::equal(snapshot_package, package)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return ResultCode.ClockUnavailable if now < 0
            expiry_status: ResultCode = metadata_expiry_status(expires, now.u64())
            return expiry_status if expiry_status != ResultCode.Ok

            snapshot_digest_bytes: mutable darray[u8] = []
            snapshot_digest: mutable darray[u8] = []
            return ResultCode.TrustStateUnavailable if Integrity::sha256(snapshot, &snapshot_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(snapshot_digest_bytes, &snapshot_digest)
            index_identity: mutable darray[u8] = []
            return ResultCode.TrustStateUnavailable if not TrustIdentity::index(root, package, &index_identity)
            state_status: ResultCode = record_index_generation(index_identity, generation, snapshot_digest, expires, key_fingerprint_hex)
            return state_status if state_status != ResultCode.Ok
            for index in 0..<versions.count |out, versions|:
                out.push(versions[index])
            for index in 0..<yanked_flags.count |yanked_flags_out, yanked_flags|:
                yanked_flags_out.push(yanked_flags[index])
            generation_out <- generation
            for index in 0..<snapshot_digest.count |snapshot_digest_out, snapshot_digest|:
                snapshot_digest_out.push(snapshot_digest[index])
            for index in 0..<index_identity.count |identity_out, index_identity|:
                identity_out.push(index_identity[index])
            for index in 0..<key_fingerprint_hex.count |key_fingerprint_out, key_fingerprint_hex|:
                key_fingerprint_out.push(key_fingerprint_hex[index])
            return ResultCode.Ok

        def configured_trust_key_fingerprint(registry_root: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            key_path: mutable darray[u8] = []
            root_status: ResultCode = configured_trust_root(registry_root, &key_path)
            return root_status if root_status != ResultCode.Ok
            public_key: mutable darray[u8] = []
            return ResultCode.MissingTrustRoot if RegistryFiles::read_trusted_file(key_path, 32.usize(), &public_key) != 32
            fingerprint_bytes: mutable darray[u8] = []
            return ResultCode.TrustStateUnavailable if Integrity::sha256(public_key, &fingerprint_bytes) != Integrity::DigestCode.Ok
            fingerprint_hex: mutable darray[u8] = []
            return ResultCode.TrustStateUnavailable if not Integrity::hex_digest(fingerprint_bytes, &fingerprint_hex)
            for index in 0..<fingerprint_hex.count |out, fingerprint_hex|:
                out.push(fingerprint_hex[index])
            return ResultCode.Ok

        def registry_index_contains_version(versions: darray[u8]&, version: darray[u8]&) -> bool:
            cursor: mutable usize = 0
            while cursor < versions.count |versions, version, cursor|:
                finish: mutable usize = cursor
                while finish < versions.count and versions[finish] != 10 |versions, finish|:
                    finish <- finish + 1
                return false if finish == versions.count
                return true if finish - cursor == version.count and bytes_equal_at(versions, cursor, finish, version)
                cursor <- finish + 1
            return false

        def bytes_equal_at(raw: darray[u8]&, start: usize, finish: usize, expected: darray[u8]&) -> bool:
            return false if finish < start or finish - start != expected.count
            for offset in 0..<expected.count |raw, start, expected|:
                return false if raw[start + offset] != expected[offset]
            return true

        def record_index_generation(identity: darray[u8]&, generation: u64, snapshot_digest: darray[u8]&, expires: u64, key_fingerprint: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            generation_version: mutable darray[u8] = []
            ByteText::append_text(&generation_version, "0.0.")
            ByteText::append_decimal(&generation_version, generation)
            return trust_state_record(identity, generation_version, snapshot_digest, snapshot_digest, expires, key_fingerprint)

        def selected_version_below(version: darray[u8]&, previous: Model::Version) -> bool:
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return false if not SemVer::parse(version, &parsed)
            return SemVer::compare(parsed, previous) < 0

        def trust_state_read(path: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            loaded: mutable darray[u8] = []
            read_status: i64 = RegistryFiles::read_trusted_file(path, 1048576.usize(), &loaded)
            if read_status < 0:
                # Only the descriptor-relative ENOENT result is an empty
                # history. Insecure parents, symlinks, and unreadable files
                # must never reset rollback protection.
                return ResultCode.Ok if read_status == -2
                return ResultCode.TrustStateUnavailable
            # Version 2 is accepted only for safe migration. Versions 3 and 4
            # scope package identities to the registry root; v4 also records
            # each registry's configured signing-key fingerprint.
            return ResultCode.TrustStateMalformed if loaded.count == 0 or loaded.count > 1048576 or (not RollbackRecords::version_2(loaded) and not RollbackRecords::version_3(loaded) and not RollbackRecords::version_4(loaded))
            for index in 0..<loaded.count |out, loaded|:
                out.push(loaded[index])
            return ResultCode.Ok

        def rollback_result(status: RollbackRecords::Code) -> ResultCode:
            return match status:
                RollbackRecords::Code.Ok: ResultCode.Ok
                RollbackRecords::Code.Malformed: ResultCode.TrustStateMalformed
                RollbackRecords::Code.Unavailable: ResultCode.TrustStateUnavailable
                RollbackRecords::Code.RootChanged: ResultCode.TrustRootChanged

        def trust_state_find(state: darray[u8]&, package: darray[u8]&, version_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, metadata_digest_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic]:
            return rollback_result(RollbackRecords::find(state, package, version_out, digest_out, metadata_digest_out))

        def trust_state_check_root_pin(state: darray[u8]&, root_key_identity: darray[u8]&, key_fingerprint: darray[u8]&, require_existing: bool, compare_key: bool, found_out: mutable bool&) -> ResultCode can[Memory.Allocate, Abort.Panic]:
            return rollback_result(RollbackRecords::check_root_pin(state, root_key_identity, key_fingerprint, require_existing, compare_key, found_out))

        # Package release history is scoped to the configured registry even
        # when callers deliberately share one trust-state file. The default
        # HOME-derived file was already registry-scoped; its older plain-name
        # records can be read as migration history. An override may have mixed
        # roots in one legacy record, so using that ambiguous history would
        # either contaminate another registry or silently drop rollback
        # protection. Fail closed for that one package until it is explicitly
        # re-provisioned into a fresh scoped record.
        def trust_state_find_package_history(state: darray[u8]&, root: darray[u8]&, package: darray[u8]&, version_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, metadata_digest_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic]:
            version_out.resize(0)
            digest_out.resize(0)
            metadata_digest_out.resize(0)
            scoped_identity: mutable darray[u8] = []
            return ResultCode.TrustStateUnavailable if not TrustIdentity::package(root, package, &scoped_identity)
            scoped_status: ResultCode = trust_state_find(state, scoped_identity, version_out, digest_out, metadata_digest_out) if state.count > 0 else ResultCode.Ok
            return scoped_status if scoped_status != ResultCode.Ok or version_out.count > 0
            # V3 rows are exclusively scoped identities, so a missing scoped
            # row is a genuinely new package for this registry. Only v2 can
            # carry a legacy plain-name row that is eligible for safe default
            # path migration.
            return ResultCode.Ok if not RollbackRecords::version_2(state)
            legacy_version: mutable darray[u8] = []
            legacy_digest: mutable darray[u8] = []
            legacy_metadata_digest: mutable darray[u8] = []
            legacy_status: ResultCode = trust_state_find(state, package, &legacy_version, &legacy_digest, &legacy_metadata_digest) if state.count > 0 else ResultCode.Ok
            return legacy_status if legacy_status != ResultCode.Ok or legacy_version.count == 0
            return ResultCode.TrustStateUnavailable if trust_state_has_override()
            for index in 0..<legacy_version.count |version_out, legacy_version|:
                version_out.push(legacy_version[index])
            for index in 0..<legacy_digest.count |digest_out, legacy_digest|:
                digest_out.push(legacy_digest[index])
            for index in 0..<legacy_metadata_digest.count |metadata_digest_out, legacy_metadata_digest|:
                metadata_digest_out.push(legacy_metadata_digest[index])
            return ResultCode.Ok

        def trust_state_finish(lock_fd: i64, code: ResultCode) -> ResultCode:
            return ResultCode.TrustStateUnavailable if Platform::pkg_close(lock_fd) != 0
            return code

        # The unguarded writer is private and is used only to persist the
        # authenticated index's own high-water record. Package history must
        # use the public guarded APIs above.
        def trust_state_record(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64, key_fingerprint: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            empty_index_digest: mutable darray[u8] = []
            empty_index_identity: mutable darray[u8] = []
            return trust_state_record_internal(package, version, digest, metadata_digest, expires, false, 0, empty_index_digest, empty_index_identity, key_fingerprint)

        def trust_state_record_at_index(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64, generation: u64, index_digest: darray[u8]&, index_identity: darray[u8]&, key_fingerprint: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return trust_state_record_internal(package, version, digest, metadata_digest, expires, true, generation, index_digest, index_identity, key_fingerprint)

        def trust_state_record_internal(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64, guard_index: bool, index_generation: u64, index_digest: darray[u8]&, index_identity: darray[u8]&, key_fingerprint: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not TrustIdentity::valid(package) or not PackageIdentity::valid_version(version) or not Integrity::valid_sha256_hex(digest) or not Integrity::valid_sha256_hex(metadata_digest) or not guard_index and not Integrity::valid_sha256_hex(key_fingerprint)
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return ResultCode.InvalidConfiguration if not SemVer::parse(version, &parsed) or parsed.prerelease
            return ResultCode.InvalidConfiguration if guard_index and (index_generation == 0 or not Integrity::valid_sha256_hex(index_digest) or not TrustIdentity::valid(index_identity))
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            if guard_index:
                expected_index_identity: mutable darray[u8] = []
                return ResultCode.TrustStateUnavailable if not TrustIdentity::index(root, package, &expected_index_identity)
                return ResultCode.InvalidConfiguration if not ByteText::equal(expected_index_identity, index_identity)
            state_path: mutable darray[u8] = TrustPaths::prepare(root)
            return ResultCode.TrustStateUnavailable if state_path.count == 0
            return ResultCode.TrustStateUnavailable if state_path.count > 4090.usize()
            lock_path: mutable darray[u8] = []
            for index in 0..<state_path.count |lock_path, state_path|:
                lock_path.push(state_path[index])
            ByteText::append_text(&lock_path, ".lock")
            return ResultCode.TrustStateUnavailable if lock_path.count > 4096
            # Keep the exact path independently: filesystem FFI calls can
            # invalidate temporary C-string storage, but the lock inode is
            # held by the descriptor and needs no pathname-based cleanup.
            lock_path_snapshot: mutable darray[u8] = []
            ByteText::append(&lock_path_snapshot, lock_path)
            lock_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(lock_path, &lock_c)
            lock_name: cstr = (&lock_c[0]).cast[cstr] can Unsafe.PointerCast
            lock_fd: i64 = Platform::pkg_acquire_trust_state_lock(lock_name)
            return ResultCode.TrustStateUnavailable if lock_fd < 0
            # Rebuild path buffers after the filesystem call. The stage1 ABI
            # may invalidate caller-owned darrays across FFI boundaries.
            root_after_lock: mutable darray[u8] = []
            if not configured_root(&root_after_lock):
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            root_after_fingerprint: mutable darray[u8] = []
            if not configured_root(&root_after_fingerprint):
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            if guard_index:
                current_index_identity: mutable darray[u8] = []
                if not TrustIdentity::index(root_after_fingerprint, package, &current_index_identity):
                    return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
                if not ByteText::equal(current_index_identity, index_identity):
                    return trust_state_finish(lock_fd, ResultCode.InvalidConfiguration)
            state_identity: mutable darray[u8] = []
            if PackageIdentity::valid_name(package):
                if not TrustIdentity::package(root_after_fingerprint, package, &state_identity):
                    return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            else:
                ByteText::append(&state_identity, package)
            root_key_identity: mutable darray[u8] = []
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not TrustIdentity::root_key_from_history(state_identity, &root_key_identity)
            state_path <- TrustPaths::prepare(root_after_fingerprint)
            if state_path.count == 0 or state_path.count > 4090.usize():
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            lock_path.resize(0)
            for index in 0..<state_path.count |lock_path, state_path|:
                lock_path.push(state_path[index])
            ByteText::append_text(&lock_path, ".lock")
            if not ByteText::equal(lock_path, lock_path_snapshot):
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            state: mutable darray[u8] = []
            read_status: ResultCode = trust_state_read(state_path, &state)
            return trust_state_finish(lock_fd, read_status) if read_status != ResultCode.Ok
            key_pin_found: mutable bool = false
            key_pin_status: ResultCode = trust_state_check_root_pin(state, root_key_identity, key_fingerprint, guard_index, not guard_index, &key_pin_found)
            return trust_state_finish(lock_fd, key_pin_status) if key_pin_status != ResultCode.Ok
            legacy_override_status: ResultCode = rollback_result(RollbackRecords::legacy_override_status(state, trust_state_has_override()))
            return trust_state_finish(lock_fd, legacy_override_status) if legacy_override_status != ResultCode.Ok
            observed_clock: mutable u64 = 0
            clock_missing: mutable bool = false
            observed_state_digest: mutable darray[u8] = []
            clock_path_start: usize = state_path.count
            ByteText::append_text(&state_path, ".clock")
            clock_status: ResultCode = read_rollback_clock(state_path, &observed_clock, &observed_state_digest, &clock_missing)
            state_path.resize(clock_path_start)
            return trust_state_finish(lock_fd, clock_status) if clock_status != ResultCode.Ok
            root_after_clock: mutable darray[u8] = []
            if not configured_root(&root_after_clock):
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if clock_missing and state.count > 23.usize()
            current_state_digest: mutable darray[u8] = []
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not TrustStorage::digest(state, &current_state_digest)
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not clock_missing and not ByteText::equal(observed_state_digest, current_state_digest)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if now < 0
            return trust_state_finish(lock_fd, ResultCode.ClockRollback) if observed_clock > now.u64()
            expiry_status: ResultCode = metadata_expiry_status(expires, now.u64())
            return trust_state_finish(lock_fd, expiry_status) if expiry_status != ResultCode.Ok
            if guard_index:
                expected_index_version: mutable darray[u8] = []
                ByteText::append_text(&expected_index_version, "0.0.")
                ByteText::append_decimal(&expected_index_version, index_generation)
                observed_index_version: mutable darray[u8] = []
                observed_index_digest: mutable darray[u8] = []
                observed_index_metadata_digest: mutable darray[u8] = []
                index_find_status: ResultCode = trust_state_find(state, index_identity, &observed_index_version, &observed_index_digest, &observed_index_metadata_digest) if state.count > 0 else ResultCode.Ok
                return trust_state_finish(lock_fd, index_find_status) if index_find_status != ResultCode.Ok
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if observed_index_version.count == 0
                expected_index_parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                observed_index_parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                return trust_state_finish(lock_fd, ResultCode.TrustStateMalformed) if not SemVer::parse(expected_index_version, &expected_index_parsed) or not SemVer::parse(observed_index_version, &observed_index_parsed)
                return trust_state_finish(lock_fd, ResultCode.RollbackDetected) if SemVer::compare(observed_index_parsed, expected_index_parsed) > 0
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if SemVer::compare(observed_index_parsed, expected_index_parsed) < 0
                return trust_state_finish(lock_fd, ResultCode.DigestMismatch) if not ByteText::equal(observed_index_digest, index_digest) or not ByteText::equal(observed_index_metadata_digest, index_digest)
            previous_version: mutable darray[u8] = []
            previous_digest: mutable darray[u8] = []
            previous_metadata_digest: mutable darray[u8] = []
            find_status: mutable ResultCode = ResultCode.Ok
            if state.count > 0:
                if PackageIdentity::valid_name(package):
                    find_status <- trust_state_find_package_history(state, root_after_clock, package, &previous_version, &previous_digest, &previous_metadata_digest)
                else:
                    find_status <- trust_state_find(state, package, &previous_version, &previous_digest, &previous_metadata_digest)
            return trust_state_finish(lock_fd, find_status) if find_status != ResultCode.Ok
            if previous_version.count > 0.usize():
                previous: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                return trust_state_finish(lock_fd, ResultCode.TrustStateMalformed) if not SemVer::parse(previous_version, &previous)
                return trust_state_finish(lock_fd, ResultCode.RollbackDetected) if SemVer::compare(parsed, previous) < 0
                return trust_state_finish(lock_fd, ResultCode.DigestMismatch) if SemVer::compare(parsed, previous) == 0 and (not ByteText::equal(previous_digest, digest) or not ByteText::equal(previous_metadata_digest, metadata_digest))
                if SemVer::compare(parsed, previous) == 0:
                    if key_pin_found:
                        return trust_state_finish(lock_fd, ResultCode.Ok) if observed_clock == now.u64()
                        ByteText::append_text(&state_path, ".clock")
                        clock_written: bool = TrustStorage::write_clock(state_path, now.u64(), current_state_digest)
                        state_path.resize(clock_path_start)
                        return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not clock_written
                        return trust_state_finish(lock_fd, ResultCode.Ok)
            upgraded_state: mutable darray[u8] = []
            upgrade_status: ResultCode = rollback_result(RollbackRecords::upgrade_to_v4(root_after_clock, state, trust_state_has_override(), &upgraded_state))
            return trust_state_finish(lock_fd, upgrade_status) if upgrade_status != ResultCode.Ok
            state <- upgraded_state
            if not key_pin_found:
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not TrustIdentity::valid_root_key(root_key_identity)
                pin_record_size: usize = root_key_identity.count + 9.usize() + key_fingerprint.count * 2.usize()
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if pin_record_size > 1048576.usize() or state.count > 1048576.usize() - pin_record_size
                ByteText::append(&state, root_key_identity)
                ByteText::append_text(&state, " 0.0.0 ")
                ByteText::append(&state, key_fingerprint)
                state.push(32)
                ByteText::append(&state, key_fingerprint)
                state.push(10)
            record_size: usize = state_identity.count + version.count + digest.count + metadata_digest.count + 4.usize()
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if record_size > 1048576.usize() or state.count > 1048576.usize() - record_size
            ByteText::append(&state, state_identity)
            state.push(32)
            ByteText::append(&state, version)
            state.push(32)
            ByteText::append(&state, digest)
            state.push(32)
            ByteText::append(&state, metadata_digest)
            state.push(10)
            updated_state_digest: mutable darray[u8] = []
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not TrustStorage::digest(state, &updated_state_digest)
            # Bind the proposed state bytes into the sidecar before publishing
            # the state. A crash between these atomic writes leaves a mismatch,
            # which fails closed instead of accepting either history.
            ByteText::append_text(&state_path, ".clock")
            clock_written: bool = TrustStorage::write_clock(state_path, now.u64(), updated_state_digest)
            state_path.resize(clock_path_start)
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not clock_written
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not TrustStorage::write(state_path, state)
            return trust_state_finish(lock_fd, ResultCode.Ok)

        def trust_state_verify(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not TrustIdentity::valid(package) or not PackageIdentity::valid_version(version) or not Integrity::valid_sha256_hex(digest) or not Integrity::valid_sha256_hex(metadata_digest)
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return ResultCode.InvalidConfiguration if not SemVer::parse(version, &parsed) or parsed.prerelease
            package_value: mutable darray[u8] = []
            version_value: mutable darray[u8] = []
            digest_value: mutable darray[u8] = []
            metadata_digest_value: mutable darray[u8] = []
            ByteText::append(&package_value, package)
            ByteText::append(&version_value, version)
            ByteText::append(&digest_value, digest)
            ByteText::append(&metadata_digest_value, metadata_digest)
            root: mutable darray[u8] = []
            value_ref: u8&? = Platform::pkg_getenv("ELISAPKG_REGISTRY_DIR")
            if value_ref is configured_root_value:
                value: cstr = configured_root_value.cast[cstr]
                length: usize = Platform::pkg_strlen(value)
                return ResultCode.InvalidConfiguration if length == 0 or length > 4096
                for index in 0..<length |root, value|:
                    root.push(value[index].u8())
            state_path: mutable darray[u8] = TrustPaths::lookup(root)
            return ResultCode.TrustStateUnavailable if state_path.count == 0 or state_path.count > 4090.usize()
            lock_path: mutable darray[u8] = []
            ByteText::append(&lock_path, state_path)
            ByteText::append_text(&lock_path, ".lock")
            return ResultCode.TrustStateUnavailable if lock_path.count > 4096
            # Preserve the path for the post-FFI configuration consistency
            # check. Lock ownership itself is held by the returned descriptor.
            lock_path_snapshot: mutable darray[u8] = []
            ByteText::append(&lock_path_snapshot, lock_path)
            lock_c: mutable darray[u8] = []
            ProjectFiles::path_with_nul_into(lock_path, &lock_c)
            lock_name: cstr = (&lock_c[0]).cast[cstr] can Unsafe.PointerCast
            lock_fd: i64 = Platform::pkg_acquire_trust_state_lock(lock_name)
            return ResultCode.TrustStateUnavailable if lock_fd < 0
            # FFI may invalidate caller-owned array headers. Rebuild the state
            # and lock paths after acquiring the lock before using either one.
            root_after_lock: mutable darray[u8] = []
            root_ref: u8&? = Platform::pkg_getenv("ELISAPKG_REGISTRY_DIR")
            if root_ref is configured_root_after_lock:
                root_value: cstr = configured_root_after_lock.cast[cstr]
                root_length: usize = Platform::pkg_strlen(root_value)
                if root_length == 0 or root_length > 4096:
                    return trust_state_finish(lock_fd, ResultCode.InvalidConfiguration)
                for index in 0..<root_length |root_after_lock, root_value|:
                    root_after_lock.push(root_value[index].u8())
            key_fingerprint: mutable darray[u8] = []
            key_fingerprint_status: ResultCode = configured_trust_key_fingerprint(root_after_lock, &key_fingerprint)
            if key_fingerprint_status != ResultCode.Ok:
                return trust_state_finish(lock_fd, key_fingerprint_status)
            root_after_key: mutable darray[u8] = []
            if not configured_root(&root_after_key):
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            root_key_identity: mutable darray[u8] = []
            if not TrustIdentity::root_key(root_after_key, &root_key_identity):
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            state_path <- TrustPaths::lookup(root_after_key)
            if state_path.count == 0 or state_path.count > 4090.usize():
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            lock_path.resize(0)
            ByteText::append(&lock_path, state_path)
            ByteText::append_text(&lock_path, ".lock")
            if lock_path.count > 4096:
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            if not ByteText::equal(lock_path, lock_path_snapshot):
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            state: mutable darray[u8] = []
            read_status: ResultCode = trust_state_read(state_path, &state)
            return trust_state_finish(lock_fd, read_status) if read_status != ResultCode.Ok
            key_pin_found: mutable bool = false
            key_pin_status: ResultCode = trust_state_check_root_pin(state, root_key_identity, key_fingerprint, true, true, &key_pin_found)
            return trust_state_finish(lock_fd, key_pin_status) if key_pin_status != ResultCode.Ok
            legacy_override_status: ResultCode = rollback_result(RollbackRecords::legacy_override_status(state, trust_state_has_override()))
            return trust_state_finish(lock_fd, legacy_override_status) if legacy_override_status != ResultCode.Ok
            observed_clock: mutable u64 = 0
            clock_missing: mutable bool = false
            observed_state_digest: mutable darray[u8] = []
            clock_path: mutable darray[u8] = []
            ByteText::append(&clock_path, state_path)
            ByteText::append_text(&clock_path, ".clock")
            clock_status: ResultCode = read_rollback_clock(clock_path, &observed_clock, &observed_state_digest, &clock_missing)
            return trust_state_finish(lock_fd, clock_status) if clock_status != ResultCode.Ok
            root_after_clock: mutable darray[u8] = []
            if not configured_root(&root_after_clock):
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            clock_root_key_identity: mutable darray[u8] = []
            if not TrustIdentity::root_key(root_after_clock, &clock_root_key_identity) or not ByteText::equal(clock_root_key_identity, root_key_identity):
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable)
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if clock_missing and state.count > 23.usize()
            current_state_digest: mutable darray[u8] = []
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not TrustStorage::digest(state, &current_state_digest)
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not clock_missing and not ByteText::equal(observed_state_digest, current_state_digest)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if now < 0
            return trust_state_finish(lock_fd, ResultCode.ClockRollback) if observed_clock > now.u64()
            expiry_status: ResultCode = metadata_expiry_status(expires, now.u64())
            return trust_state_finish(lock_fd, expiry_status) if expiry_status != ResultCode.Ok
            previous_version: mutable darray[u8] = []
            previous_digest: mutable darray[u8] = []
            previous_metadata_digest: mutable darray[u8] = []
            find_status: ResultCode = trust_state_find_package_history(state, root_after_clock, package_value, &previous_version, &previous_digest, &previous_metadata_digest)
            return trust_state_finish(lock_fd, find_status) if find_status != ResultCode.Ok
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if previous_version.count == 0.usize()
            previous: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return trust_state_finish(lock_fd, ResultCode.TrustStateMalformed) if not SemVer::parse(previous_version, &previous)
            return trust_state_finish(lock_fd, ResultCode.RollbackDetected) if SemVer::compare(parsed, previous) < 0
            if SemVer::compare(parsed, previous) == 0 and (not ByteText::equal(previous_digest, digest_value) or not ByteText::equal(previous_metadata_digest, metadata_digest_value)):
                return trust_state_finish(lock_fd, ResultCode.DigestMismatch)
            return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if SemVer::compare(parsed, previous) > 0
            if now.u64() > observed_clock:
                clock_written: bool = TrustStorage::write_clock(clock_path, now.u64(), current_state_digest)
                return trust_state_finish(lock_fd, ResultCode.TrustStateUnavailable) if not clock_written
            return trust_state_finish(lock_fd, ResultCode.Ok)

        # Persist TUF role floors separately from the fixture provider's
        # SemVer history. The state file is scoped by registry identity inside
        # each row so an explicit shared trust-state override cannot mix roots.
        def checkpoint_store_result(status: CheckpointStore::Code) -> ResultCode:
            return match status:
                CheckpointStore::Code.InvalidConfiguration: ResultCode.InvalidConfiguration
                CheckpointStore::Code.ResourceLimit: ResultCode.ResourceLimit
                CheckpointStore::Code.MalformedMetadata: ResultCode.MalformedMetadata
                CheckpointStore::Code.TrustStateUnavailable: ResultCode.TrustStateUnavailable
                CheckpointStore::Code.Ok: ResultCode.Ok
                CheckpointStore::Code.ClockUnavailable: ResultCode.ClockUnavailable
                CheckpointStore::Code.ClockRollback: ResultCode.ClockRollback
                CheckpointStore::Code.TrustStateMalformed: ResultCode.TrustStateMalformed
                CheckpointStore::Code.RollbackDetected: ResultCode.RollbackDetected
                CheckpointStore::Code.TufEquivocationDetected: ResultCode.TufEquivocationDetected

        def read_rollback_clock(path: darray[u8]&, out: mutable u64&, state_digest: mutable darray[u8]&, missing: mutable bool&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return match TrustStorage::read_clock(path, out, state_digest, missing):
                TrustStorage::Code.Ok: ResultCode.Ok
                TrustStorage::Code.Unavailable: ResultCode.TrustStateUnavailable
                TrustStorage::Code.Malformed: ResultCode.TrustStateMalformed

        const max_metadata_lifetime_seconds: u64 = 2592000

        def metadata_expiry_status(expires: u64, now: u64) -> ResultCode:
            return ResultCode.ExpiredMetadata if expires <= now
            return ResultCode.ExpiryHorizon if expires - now > max_metadata_lifetime_seconds
            return ResultCode.Ok
