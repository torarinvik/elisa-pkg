# Authenticated, deterministic registry provider.
#
# The provider is intentionally file-backed for the first vertical slice. A
# future HTTP transport may feed the same metadata bytes into this module, but
# it must preserve the exact verification and path rules below. Network code,
# credentials, and archive extraction stay outside this namespace.

include "./platform.elisa"
include "./archive.elisa"
include "./integrity.elisa"
include "./json.elisa"
include "./resolve.elisa"
include "./solver.elisa"
include "./trust.elisa"

module Registry:
    public:
        const enum ResultCode of u8:
            Ok
            NotConfigured
            InvalidConfiguration
            MissingIndex
            NoMatchingVersion
            MalformedMetadata
            MissingSignature
            MissingTrustRoot
            InvalidSignature
            ExpiredMetadata
            RollbackDetected
            DigestMismatch
            ArchiveMissing
            ResourceLimit
            TrustStateUnavailable
            TrustStateMalformed
            ClockRollback
            Unsatisfiable
            ClockUnavailable

        # Render a selected stable version as the exact solver requirement used
        # when replaying registry lock preferences. Keeping this formatter in
        # the provider namespace prevents cache paths or CLI-only formatting
        # helpers from leaking into resolver constraints.
        def exact_requirement(version: Model::Version, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            registry_append_decimal(out, version.major)
            out.push(46)
            registry_append_decimal(out, version.minor)
            out.push(46)
            registry_append_decimal(out, version.patch)

        # Decode dependency constraints from already authenticated metadata.
        # The output is kept separate from metadata records because the current
        # stage1 compiler cannot safely move recursive darray fields nested in a
        # public record; keeping this buffer at the call boundary preserves
        # ownership and makes the limitation explicit.
        def read_dependencies(metadata: darray[u8]&, out: mutable darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return metadata_dependencies(metadata, out)

        # Return the authenticated registry's bounded version index. The index
        # itself is syntax-checked by the caller before it is used for solving;
        # it never supplies a trust root or an archive identity.
        def read_index(package: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return ResultCode.InvalidConfiguration if not valid_package_path(package)
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not valid_registry_root(root)
            path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not join_path_leaf(root, package, "index", &path)
            loaded: i64 = read_trusted_file(path, 1048576.usize(), out)
            return ResultCode.MissingIndex if loaded == -2
            return ResultCode.ResourceLimit if loaded == -27
            return ResultCode.InvalidConfiguration if loaded < 0
            return ResultCode.MalformedMetadata if loaded == 0 or out.count > 1048576
            return ResultCode.Ok

        # Read one archive selected by authenticated metadata. The caller must
        # supply the exact version, archive leaf, digest, and size returned by
        # `resolve`; this boundary never follows a URL or accepts an arbitrary
        # path. The bytes are checked again immediately before they are handed
        # to cache or extraction code so a mutable fixture cannot race the
        # metadata verification step unnoticed.
        def read_archive(package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, expected_digest: darray[u8]&, expected_size: u64, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return ResultCode.InvalidConfiguration if not valid_package_path(package) or not Archive::is_safe_entry(version) or not Archive::is_safe_entry(archive) or not valid_digest(expected_digest) or expected_size > 67108864
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not valid_registry_root(root)
            path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not join_path_version(root, package, version, &path)
            path.push(47)
            for index in 0..<archive.count |path, archive|:
                path.push(archive[index])
            return ResultCode.ArchiveMissing if not read_file(path, 67108864.usize(), out)
            return ResultCode.DigestMismatch if out.count.u64() != expected_size
            return ResultCode.MalformedMetadata if not Archive::verify_ustar_archive(out)
            digest_bytes: mutable darray[u8] = []
            digest: mutable darray[u8] = []
            return ResultCode.DigestMismatch if Integrity::sha256(out, &digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(digest_bytes, &digest) or not bytes_equal(digest, expected_digest)
            return ResultCode.Ok

        # Record the authenticated immutable package identity in user-owned
        # trust state. This is separate from the project lockfile so deleting
        # or restoring a project cannot reset rollback protection.
        def record_trusted(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return trust_state_record(package, version, digest, metadata_digest, expires)

        # Check an identity against persisted signed metadata evidence and
        # advance the state-bound wall-clock floor while holding the same lock
        # used by writers. Offline callers invoke this only after authenticating
        # the cached metadata and archive bytes.
        def verify_trusted(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return trust_state_verify(package, version, digest, metadata_digest, expires)

        # Resolve one package and verify its detached metadata. The regular
        # entry also verifies the selected archive before exposing success.
        def resolve(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return resolve_internal(package, requirement, previous_version, version_out, archive_out, digest_out, archive_size_out, metadata_out, true)

        # Candidate enumeration authenticates metadata without reading every
        # archive. This keeps a large signed index from forcing unbounded
        # archive I/O before the solver knows which versions are selected.
        def resolve_metadata(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return resolve_internal(package, requirement, previous_version, version_out, archive_out, digest_out, archive_size_out, metadata_out, false)

        # Read the detached signature that authenticated one immutable metadata
        # record. This is used only after an online fetch has verified the record,
        # so the signature can be carried into the content-addressed offline cache.
        def read_signature(package: darray[u8]&, version: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return ResultCode.InvalidConfiguration if not valid_package_path(package) or not Archive::is_safe_entry(version)
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not valid_registry_root(root)
            metadata_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not join_path_version(root, package, version, &metadata_path)
            metadata_path.push(47)
            metadata_path.push(109)
            metadata_path.push(101)
            metadata_path.push(116)
            metadata_path.push(97)
            metadata_path.push(100)
            metadata_path.push(97)
            metadata_path.push(116)
            metadata_path.push(97)
            metadata_path.push(46)
            metadata_path.push(115)
            metadata_path.push(105)
            metadata_path.push(103)
            return ResultCode.MissingSignature if not read_file(metadata_path, 64.usize(), out)
            return ResultCode.MissingSignature if out.count != 64.usize()
            return ResultCode.Ok

        # Verify a metadata snapshot restored from the offline cache. The cache
        # supplies exact bytes and the detached signature; this function repeats
        # the same identity, digest, trust-root, expiry, and dependency checks as
        # the live provider before exposing any fields to lock validation.
        def verify_metadata_snapshot(package: darray[u8]&, version: darray[u8]&, expected_metadata_digest: darray[u8]&, metadata: darray[u8]&, signature: darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, expires_out: mutable u64&, dependencies_out: mutable darray[Solver::Constraint]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            archive_out.resize(0)
            digest_out.resize(0)
            archive_size_out <- 0
            expires_out <- 0
            dependencies_out.resize(0)
            return ResultCode.InvalidConfiguration if not valid_package_path(package) or not Archive::is_safe_entry(version) or not valid_digest(expected_metadata_digest)
            return ResultCode.MalformedMetadata if metadata.count == 0.usize() or metadata.count > 1048576.usize() or not Json::valid_document(metadata) or not Json::unique_object_keys(metadata) or not metadata_root_object(metadata) or not metadata_allowed_fields(metadata)
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not valid_registry_root(root)
            return ResultCode.MalformedMetadata if not metadata_identity(metadata, root, package, version, archive_out, digest_out, archive_size_out)
            metadata_digest_bytes: mutable darray[u8] = []
            metadata_digest: mutable darray[u8] = []
            return ResultCode.DigestMismatch if Integrity::sha256(metadata, &metadata_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(metadata_digest_bytes, &metadata_digest) or not bytes_equal(metadata_digest, expected_metadata_digest)
            key_path: mutable darray[u8] = []
            trust_root_status: ResultCode = configured_trust_root(root, &key_path)
            return trust_root_status if trust_root_status != ResultCode.Ok
            public_key: mutable darray[u8] = []
            return ResultCode.MissingTrustRoot if read_trusted_file(key_path, 32.usize(), &public_key) != 32
            trust_status: Trust::VerificationCode = Trust::verify_detached("ed25519", public_key, metadata, signature)
            return ResultCode.InvalidSignature if trust_status != Trust::VerificationCode.Valid
            return ResultCode.MalformedMetadata if not metadata_integer(metadata, "expires", expires_out)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return ResultCode.ClockUnavailable if now < 0
            return ResultCode.ExpiredMetadata if not expiry_is_future(expires_out, now.u64())
            return ResultCode.MalformedMetadata if not metadata_dependencies(metadata, dependencies_out)
            return ResultCode.Ok

    private:
        def resolve_internal(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&, verify_archive: bool) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            version_out.resize(0)
            archive_out.resize(0)
            digest_out.resize(0)
            metadata_out.resize(0)
            archive_size_out <- 0
            return ResultCode.InvalidConfiguration if not valid_package_path(package)
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            return ResultCode.InvalidConfiguration if not valid_registry_root(root)
            key_path: mutable darray[u8] = []
            trust_root_status: ResultCode = configured_trust_root(root, &key_path)
            return trust_root_status if trust_root_status != ResultCode.Ok
            index_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not join_path_leaf(root, package, "index", &index_path)
            index: mutable darray[u8] = []
            index_status: i64 = read_trusted_file(index_path, 1048576.usize(), &index)
            return ResultCode.MissingIndex if index_status == -2
            return ResultCode.ResourceLimit if index_status == -27
            return ResultCode.InvalidConfiguration if index_status < 0
            return ResultCode.MalformedMetadata if index_status == 0
            selected: mutable darray[u8] = []
            return ResultCode.NoMatchingVersion if not Resolve::select_highest_version(index, requirement, &selected)
            metadata_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not join_path_version(root, package, selected, &metadata_path)
            metadata_path.push(47)
            metadata_path.push(109)
            metadata_path.push(101)
            metadata_path.push(116)
            metadata_path.push(97)
            metadata_path.push(100)
            metadata_path.push(97)
            metadata_path.push(116)
            metadata_path.push(97)
            metadata_path.push(46)
            metadata_path.push(106)
            metadata_path.push(115)
            metadata_path.push(111)
            metadata_path.push(110)
            metadata: mutable darray[u8] = []
            return ResultCode.MalformedMetadata if not read_file(metadata_path, 1048576.usize(), &metadata)
            return ResultCode.MalformedMetadata if not Json::valid_document(metadata) or not Json::unique_object_keys(metadata) or not metadata_root_object(metadata)
            return ResultCode.MalformedMetadata if not metadata_allowed_fields(metadata)
            return ResultCode.MalformedMetadata if not metadata_identity(metadata, root, package, selected, archive_out, digest_out, archive_size_out)
            return ResultCode.RollbackDetected if selected_version_below(selected, previous_version)
            signature_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not sibling_path(metadata_path, "metadata.sig", &signature_path)
            signature: mutable darray[u8] = []
            return ResultCode.MissingSignature if not read_file(signature_path, 64.usize(), &signature)
            public_key: mutable darray[u8] = []
            return ResultCode.MissingTrustRoot if read_trusted_file(key_path, 32.usize(), &public_key) != 32
            trust_status: Trust::VerificationCode = Trust::verify_detached("ed25519", public_key, metadata, signature)
            return ResultCode.InvalidSignature if trust_status != Trust::VerificationCode.Valid
            expires: mutable u64 = 0
            return ResultCode.MalformedMetadata if not metadata_integer(metadata, "expires", &expires)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return ResultCode.ClockUnavailable if now < 0
            return ResultCode.ExpiredMetadata if not expiry_is_future(expires, now.u64())
            if not verify_archive:
                for index in 0..<selected.count |version_out, selected|:
                    version_out.push(selected[index])
                for index in 0..<metadata.count |metadata_out, metadata|:
                    metadata_out.push(metadata[index])
                return ResultCode.Ok
            archive_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not join_path_version(root, package, selected, &archive_path)
            archive_path.push(47)
            for index in 0..<archive_out.count |archive_path, archive_out|:
                archive_path.push(archive_out[index])
            archive_c: mutable darray[u8] = []
            path_with_nul(archive_path, &archive_c)
            archive_name: cstr = (&archive_c[0]).cast[cstr] can Unsafe.PointerCast
            actual_size: i64 = Platform::pkg_package_file_size(archive_name)
            return ResultCode.ArchiveMissing if actual_size < 0
            return ResultCode.DigestMismatch if actual_size.u64() != archive_size_out
            archive_bytes: mutable darray[u8] = []
            return ResultCode.ArchiveMissing if not read_file(archive_path, 67108864.usize(), &archive_bytes)
            return ResultCode.MalformedMetadata if not Archive::verify_ustar_archive(archive_bytes)
            actual_digest_bytes: mutable darray[u8] = []
            actual_digest: mutable darray[u8] = []
            return ResultCode.DigestMismatch if Integrity::sha256(archive_bytes, &actual_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(actual_digest_bytes, &actual_digest) or not bytes_equal(actual_digest, digest_out)
            for index in 0..<selected.count |version_out, selected|:
                version_out.push(selected[index])
            for index in 0..<metadata.count |metadata_out, metadata|:
                metadata_out.push(metadata[index])
            archive_out.resize(archive_out.count)
            return ResultCode.Ok

    public:
        def result_message(code: ResultCode) -> cstr:
            return "ok" if code == ResultCode.Ok
            return "registry is not configured" if code == ResultCode.NotConfigured
            return "registry configuration is invalid" if code == ResultCode.InvalidConfiguration
            return "registry index is missing or unreadable" if code == ResultCode.MissingIndex
            return "no registry version satisfies the requirement" if code == ResultCode.NoMatchingVersion
            return "registry metadata is malformed" if code == ResultCode.MalformedMetadata
            return "registry metadata signature is missing" if code == ResultCode.MissingSignature
            return "registry trust root is missing" if code == ResultCode.MissingTrustRoot
            return "registry metadata signature is invalid" if code == ResultCode.InvalidSignature
            return "registry metadata is expired" if code == ResultCode.ExpiredMetadata
            return "registry metadata rollback detected" if code == ResultCode.RollbackDetected
            return "registry archive digest does not match metadata" if code == ResultCode.DigestMismatch
            return "registry archive is missing or unreadable" if code == ResultCode.ArchiveMissing
            return "registry metadata exceeds the configured resource limit" if code == ResultCode.ResourceLimit
            return "registry trust state is unavailable" if code == ResultCode.TrustStateUnavailable
            return "registry trust state is malformed" if code == ResultCode.TrustStateMalformed
            return "registry trust clock moved backwards" if code == ResultCode.ClockRollback
            return "registry dependency graph is unsatisfiable" if code == ResultCode.Unsatisfiable
            return "host wall clock is unavailable" if code == ResultCode.ClockUnavailable
            return "unknown registry result"

    private:
        const max_dependencies: usize = 4096

        def registry_append_decimal(out: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            start: usize = out.count
            out.resize(start + 20.usize())
            number: mutable u64 = value
            cursor: mutable usize = start
            if number == 0:
                out[cursor] <- 48
                cursor <- cursor + 1.usize()
            else:
                while number > 0 |out, number, cursor|:
                    out[cursor] <- 48 + (number % 10).u8()
                    cursor <- cursor + 1.usize()
                    number <- number / 10
                left: mutable usize = start
                right: mutable usize = cursor
                while left < right and right - left > 1.usize() |out, left, right|:
                    right <- right - 1.usize()
                    temporary: u8 = out[left]
                    out[left] <- out[right]
                    out[right] <- temporary
                    left <- left + 1.usize()
            out.resize(cursor)

        def registry_push_text(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            length: usize = Platform::pkg_strlen(value)
            for index in 0..<length |out, value|:
                out.push(value[index].u8())

        def registry_push_array(out: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |out, value|:
                out.push(value[index])

        def registry_version_seen(seen: darray[u8]&, wanted: darray[u8]&) -> bool:
            cursor: mutable usize = 0
            while cursor < seen.count:
                finish: mutable usize = cursor
                while finish < seen.count and seen[finish] != 0 |seen, finish|:
                    finish <- finish + 1
                return true if finish - cursor == wanted.count and registry_slice_equal(seen, cursor, finish, wanted)
                cursor <- finish + 1
            return false

        def registry_slice_equal(value: darray[u8]&, start: usize, finish: usize, wanted: darray[u8]&) -> bool:
            return false if finish < start or finish - start != wanted.count
            for item in 0..<wanted.count |value, start, wanted|:
                return false if value[start + item] != wanted[item]
            return true

        def metadata_dependencies(raw: darray[u8]&, out: mutable darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            dependency_start: usize = metadata_value_start(raw, "dependencies")
            return true if dependency_start == raw.count
            dependency_end: usize = metadata_object_end(raw, dependency_start)
            return false if dependency_start >= raw.count or dependency_end <= dependency_start or raw[dependency_start] != 123
            seen: mutable darray[u8] = []
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (dependency_start + 1)..<dependency_end |raw, out, seen, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < dependency_end and is_registry_space(raw[after]) |raw, after|:
                        after <- after + 1
                    if braces == 1 and brackets == 0 and after < dependency_end and raw[after] == 58:
                        alias: mutable darray[u8] = []
                        for item in string_start..<index |raw, alias|:
                            alias.push(raw[item])
                        return false if not registry_valid_name(alias) or registry_version_seen(seen, alias)
                        for item in 0..<alias.count |seen, alias|:
                            seen.push(alias[item])
                        seen.push(0)
                        after <- after + 1
                        while after < dependency_end and is_registry_space(raw[after]) |raw, after|:
                            after <- after + 1
                        return false if after >= dependency_end or raw[after] != 123
                        value_end: usize = metadata_object_end(raw, after)
                        return false if value_end <= after or value_end > dependency_end
                        return false if not dependency_allowed_fields(raw, after, value_end)
                        requirement: mutable darray[u8] = []
                        return false if not metadata_string_in_object(raw, after, value_end, "version", &requirement)
                        parsed: mutable SemVer::Requirement = SemVer::Requirement{lower: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, upper: Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}, has_lower: false, has_upper: false, include_lower: false, include_upper: false}
                        return false if not SemVer::parse_requirement(requirement, &parsed)
                        registry_name: mutable darray[u8] = []
                        return false if not metadata_string_in_object(raw, after, value_end, "registry", &registry_name) or not bytes_equal_text(registry_name, "primary")
                        return false if out.count >= max_dependencies
                        out.push(Solver::Constraint{package: alias, requirement: requirement})
                    in_string <- false
            return true

        def metadata_value_start(raw: darray[u8]&, wanted: cstr) -> usize:
            key_length: usize = Platform::pkg_strlen(wanted)
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            braces: mutable i64 = 0
            brackets: mutable i64 = 0
            for index in 0..<raw.count |raw, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < raw.count and is_registry_space(raw[after]) |raw, after|:
                        after <- after + 1
                    if braces == 1 and brackets == 0 and after < raw.count and raw[after] == 58 and index - string_start == key_length:
                        matched: mutable bool = true
                        for item in 0..<key_length |raw, wanted, string_start, matched|:
                            matched <- false if raw[string_start + item] != wanted[item].u8()
                        if matched:
                            after <- after + 1
                            while after < raw.count and is_registry_space(raw[after]) |raw, after|:
                                after <- after + 1
                            return after
                    in_string <- false
            return raw.count

        def metadata_object_end(raw: darray[u8]&, start: usize) -> usize:
            return raw.count if start >= raw.count or raw[start] != 123
            depth: mutable i64 = 0
            in_string: mutable bool = false
            escaped: mutable bool = false
            for index in start..<raw.count |raw, depth, in_string, escaped|:
                byte: u8 = raw[index]
                if in_string:
                    if escaped:
                        escaped <- false
                    elif byte == 92:
                        escaped <- true
                    elif byte == 34:
                        in_string <- false
                elif byte == 34:
                    in_string <- true
                elif byte == 123:
                    depth <- depth + 1
                elif byte == 125:
                    depth <- depth - 1
                    return index if depth == 0
                    return raw.count if depth < 0
            return raw.count

        def metadata_string_in_object(raw: darray[u8]&, object_start: usize, object_end: usize, wanted: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if object_start >= object_end or raw[object_start] != 123
            key_length: usize = Platform::pkg_strlen(wanted)
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            for index in (object_start + 1)..<object_end |raw, in_string, escaped, string_start|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < object_end and is_registry_space(raw[after]) |raw, after|:
                        after <- after + 1
                    if after < object_end and raw[after] == 58 and index - string_start == key_length:
                        matched: mutable bool = true
                        for item in 0..<key_length |raw, wanted, string_start, matched|:
                            matched <- false if raw[string_start + item] != wanted[item].u8()
                        if matched:
                            after <- after + 1
                            while after < object_end and is_registry_space(raw[after]) |raw, after|:
                                after <- after + 1
                            return false if after >= object_end or raw[after] != 34
                            after <- after + 1
                            out.resize(0)
                            while after < object_end and raw[after] != 34:
                                return false if raw[after] < 32 or raw[after] == 92
                                out.push(raw[after])
                                after <- after + 1
                            return after < object_end
                    in_string <- false
            return false

        def is_registry_space(byte: u8) -> bool:
            return byte == 32 or byte == 9 or byte == 10 or byte == 13

        def bytes_equal_text(value: darray[u8]&, expected: cstr) -> bool:
            length: usize = Platform::pkg_strlen(expected)
            return false if value.count != length
            for index in 0..<length |value, expected|:
                return false if value[index] != expected[index].u8()
            return true

        def registry_valid_name(value: darray[u8]&) -> bool:
            return false if value.count == 0 or value.count > 64
            return false if value[0] < 97 or value[0] > 122
            previous_hyphen: mutable bool = false
            for index in 0..<value.count |value, previous_hyphen|:
                byte: u8 = value[index]
                return false if byte == 45 and (index == value.count - 1 or previous_hyphen)
                return false if (byte < 97 or byte > 122) and (byte < 48 or byte > 57) and byte != 45
                previous_hyphen <- byte == 45
            return true

        # HOME is an input boundary, even though it is normally populated by
        # the login environment. Reject control bytes and backslashes before
        # using it to derive durable trust-state paths, and collapse trailing
        # separators so `/home/user` and `/home/user/` cannot select different
        # path spellings. Keep `/` itself as the root path.
        def safe_home_length(home: cstr) -> usize:
            length: usize = Platform::pkg_strlen(home)
            return 0 if length == 0 or length > 3800 or home[0].u8() != 47
            normalized: mutable usize = length
            while normalized > 1 and home[normalized - 1].u8() == 47:
                normalized <- normalized - 1.usize()
            for index in 0..<normalized |home, normalized|:
                byte: u8 = home[index].u8()
                return 0 if byte < 32 or byte == 127 or byte == 92
            segment_start: mutable usize = 1.usize()
            for index in 1..<(normalized + 1.usize()) |home, segment_start|:
                if index == normalized or home[index].u8() == 47:
                    segment_length: usize = index - segment_start
                    return 0 if segment_length == 0.usize() or segment_length == 1.usize() and home[segment_start].u8() == 46 or segment_length == 2.usize() and home[segment_start].u8() == 46 and home[segment_start + 1.usize()].u8() == 46
                    segment_start <- index + 1.usize()
            return normalized

        def configured_root(out: mutable darray[u8]&) -> bool:
            out.resize(0)
            value_ref: u8&? = Platform::pkg_getenv("ELISAPKG_REGISTRY_DIR")
            if value_ref is configured:
                value: cstr = configured.cast[cstr]
                length: usize = Platform::pkg_strlen(value)
                return false if length == 0 or length > 4096
                for index in 0..<length |out, value|:
                    out.push(value[index].u8())
                return true
            return false

        def configured_trust_root(registry_root: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # Trust material is configured out of band. Keeping the key next
            # to mutable registry metadata would let a registry replacement
            # replace its own verification root as well.
            out.resize(0)
            value_ref: u8&? = Platform::pkg_getenv("ELISAPKG_REGISTRY_TRUST_ROOT")
            if value_ref is configured:
                value: cstr = configured.cast[cstr]
                length: usize = Platform::pkg_strlen(value)
                return ResultCode.InvalidConfiguration if length == 0 or length > 4096 or value[0].u8() != 47
                for index in 0..<length |out, value|:
                    byte: u8 = value[index].u8()
                    return ResultCode.InvalidConfiguration if byte == 0 or byte < 32 or byte == 127 or byte == 92
                    out.push(byte)
                return ResultCode.InvalidConfiguration if out[out.count - 1.usize()] == 47
                segment_start: mutable usize = 1.usize()
                for index in 1..<(length + 1.usize()) |value, segment_start|:
                    if index == length or value[index].u8() == 47:
                        segment_length: usize = index - segment_start
                        return ResultCode.InvalidConfiguration if segment_length == 0.usize() or segment_length == 1.usize() and value[segment_start].u8() == 46 or segment_length == 2.usize() and value[segment_start].u8() == 46 and value[segment_start + 1.usize()].u8() == 46
                        segment_start <- index + 1.usize()
                return ResultCode.InvalidConfiguration if path_is_same_or_beneath(out, registry_root)
                canonical_registry: mutable darray[u8] = []
                canonical_trust: mutable darray[u8] = []
                return ResultCode.InvalidConfiguration if not canonical_path(registry_root, &canonical_registry)
                return ResultCode.MissingTrustRoot if not canonical_path(out, &canonical_trust)
                return ResultCode.InvalidConfiguration if path_is_same_or_beneath(canonical_trust, canonical_registry)
                return ResultCode.Ok
            return ResultCode.MissingTrustRoot

        def path_is_same_or_beneath(candidate: darray[u8]&, parent: darray[u8]&) -> bool:
            return false if parent.count == 0 or candidate.count < parent.count
            for index in 0..<parent.count |candidate, parent|:
                return false if candidate[index] != parent[index]
            return true if candidate.count == parent.count
            return true if parent.count == 1 and parent[0] == 47
            return candidate[parent.count] == 47

        def canonical_path(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            path_c: mutable darray[u8] = []
            path_with_nul(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            resolved: mutable darray[u8] = []
            resolved.resize(4096)
            if Platform::pkg_realpath(path_name, &resolved) is canonical:
                length: usize = Platform::pkg_strlen(canonical)
                return false if length == 0 or length > 4096
                for index in 0..<length |out, canonical|:
                    out.push(canonical[index].u8())
                return true
            return false

        def valid_registry_root(root: darray[u8]&) -> bool:
            return false if root.count == 0 or root[0] != 47 or root.count > 4096 or root[root.count - 1] == 47 and root.count > 1
            segment_start: mutable usize = 1
            for index in 1..<(root.count + 1) |root, segment_start|:
                if index == root.count or root[index] == 47:
                    return false if index == segment_start
                    # Keep the configured root in canonical component form.
                    # Dot components are harmless to POSIX resolution but can
                    # create alternate textual identities for the same trust
                    # store and undermine path-boundary comparisons.
                    return false if index - segment_start == 1 and root[segment_start] == 46
                    return false if index - segment_start == 2 and root[segment_start] == 46 and root[segment_start + 1] == 46
                    segment_start <- index + 1
                else:
                    return false if root[index] < 32 or root[index] == 127 or root[index] == 0
            return true

        def valid_package_path(package: darray[u8]&) -> bool:
            return false if package.count == 0 or package.count > 256 or not Archive::is_safe_entry(package)
            return false if package[package.count - 1] == 47
            return true

        def join_path_leaf(root: darray[u8]&, package: darray[u8]&, leaf: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if root.count == 0 or not valid_registry_root(root)
            for index in 0..<root.count |out, root|:
                out.push(root[index])
            if package.count > 0:
                out.push(47) if out.count == 0 or out[out.count - 1.usize()] != 47
                for index in 0..<package.count |out, package|:
                    out.push(package[index])
            leaf_length: usize = Platform::pkg_strlen(leaf)
            if leaf_length > 0:
                out.push(47) if out.count == 0 or out[out.count - 1.usize()] != 47
                for index in 0..<leaf_length |out, leaf|:
                    out.push(leaf[index].u8())
            return out.count <= 4096

        def join_path_version(root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if version.count == 0 or not Archive::is_safe_entry(version)
            for index in 0..<root.count |out, root|:
                out.push(root[index])
            out.push(47) if out.count == 0 or out[out.count - 1.usize()] != 47
            for index in 0..<package.count |out, package|:
                out.push(package[index])
            out.push(47) if out.count == 0 or out[out.count - 1.usize()] != 47
            for index in 0..<version.count |out, version|:
                out.push(version[index])
            return out.count <= 4096

        def sibling_path(path: darray[u8]&, leaf: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            cursor: mutable usize = path.count
            while cursor > 0 and path[cursor - 1] != 47:
                cursor <- cursor - 1
            return false if cursor == 0
            for index in 0..<cursor |out, path|:
                out.push(path[index])
            leaf_length: usize = Platform::pkg_strlen(leaf)
            for index in 0..<leaf_length |out, leaf|:
                out.push(leaf[index].u8())
            return out.count <= 4096

        def path_with_nul(path: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            for index in 0..<path.count |out, path|:
                out.push(path[index])
            out.push(0)

        def read_file(path: darray[u8]&, maximum: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            path_with_nul(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            resolved: mutable darray[u8] = []
            resolved.resize(4096)
            canonical: mutable cstr = ""
            if Platform::pkg_realpath(path_name, &resolved) is found:
                canonical <- found
            else:
                return false
            canonical_length: usize = Platform::pkg_strlen(canonical)
            return false if canonical_length != path.count
            for index in 0..<path.count |path, canonical|:
                return false if path[index] != canonical[index].u8()
            size: i64 = Platform::pkg_package_file_size(path_name)
            return false if size < 0 or size > maximum or size > 67108864
            out.resize(size.usize() + 1.usize())
            raw: mutable u8& = (&out[0]).cast[mutable u8&] can Unsafe.PointerCast
            read: i64 = Platform::pkg_read_package_file(path_name, raw, out.count)
            return false if read < 0 or read != size
            out.resize(read.usize())
            return true

        def read_trusted_file(path: darray[u8]&, maximum: usize, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return -22 if maximum == 0.usize() or maximum > 1048576.usize()
            path_c: mutable darray[u8] = []
            path_with_nul(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            out.resize(maximum + 1.usize())
            raw: mutable u8& = (&out[0]).cast[mutable u8&] can Unsafe.PointerCast
            loaded: i64 = Platform::pkg_read_trusted_file(path_name, raw, out.count)
            if loaded < 0:
                out.resize(0)
                return loaded
            if loaded > maximum.i64():
                out.resize(0)
                return -27
            out.resize(loaded.usize())
            return loaded

        def metadata_identity(raw: darray[u8]&, root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, size_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            schema: mutable u64 = 0
            return false if not metadata_integer(raw, "schema-version", &schema) or schema != 1
            registry: mutable darray[u8] = []
            algorithm: mutable darray[u8] = []
            package_value: mutable darray[u8] = []
            version_value: mutable darray[u8] = []
            return false if not metadata_string(raw, "registry", &registry) or not metadata_string(raw, "algorithm", &algorithm) or not metadata_string(raw, "package", &package_value) or not metadata_string(raw, "version", &version_value)
            return false if not bytes_equal(registry, root) or not bytes_equal(package_value, package) or not bytes_equal(version_value, version)
            return false if algorithm.count != 7 or algorithm[0] != 101 or algorithm[1] != 100 or algorithm[2] != 50 or algorithm[3] != 53 or algorithm[4] != 53 or algorithm[5] != 49 or algorithm[6] != 57
            return false if not metadata_string(raw, "archive", archive_out) or not Archive::is_safe_entry(archive_out)
            return false if not metadata_string(raw, "archive-digest", digest_out) or not valid_digest(digest_out)
            parsed_size: mutable u64 = 0
            return false if not metadata_integer(raw, "archive-size", &parsed_size) or parsed_size > 67108864
            size_out <- parsed_size
            return true

        def metadata_allowed_fields(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            first: mutable usize = 0
            last: mutable usize = raw.count
            while first < last and is_registry_space(raw[first]) |raw, first|:
                first <- first + 1
            while last > first and is_registry_space(raw[last - 1]) |raw, last|:
                last <- last - 1
            return false if first >= last or raw[first] != 123 or raw[last - 1] != 125
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (first + 1)..<last |raw, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < last and is_registry_space(raw[after]) |raw, after|:
                        after <- after + 1
                    if braces == 1 and brackets == 0 and after < last and raw[after] == 58:
                        key: mutable darray[u8] = []
                        for item in string_start..<index |raw, key|:
                            key.push(raw[item])
                        allowed: bool = bytes_equal_text(key, "schema-version") or bytes_equal_text(key, "algorithm") or bytes_equal_text(key, "registry") or bytes_equal_text(key, "package") or bytes_equal_text(key, "version") or bytes_equal_text(key, "archive") or bytes_equal_text(key, "archive-size") or bytes_equal_text(key, "archive-digest") or bytes_equal_text(key, "expires") or bytes_equal_text(key, "dependencies")
                        return false if not allowed
                    in_string <- false
            return not in_string and not escaped and braces == 0 and brackets == 0

        def dependency_allowed_fields(raw: darray[u8]&, start: usize, finish: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start >= finish or raw[start] != 123
            in_string: mutable bool = false
            escaped: mutable bool = false
            string_start: mutable usize = 0
            braces: mutable i64 = 1
            brackets: mutable i64 = 0
            for index in (start + 1)..<finish |raw, in_string, escaped, string_start, braces, brackets|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 34:
                        in_string <- true
                        string_start <- index + 1
                    elif byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 91:
                        brackets <- brackets + 1
                    elif byte == 93:
                        brackets <- brackets - 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < finish and is_registry_space(raw[after]) |raw, after|:
                        after <- after + 1
                    if braces == 1 and brackets == 0 and after < finish and raw[after] == 58:
                        key: mutable darray[u8] = []
                        for item in string_start..<index |raw, key|:
                            key.push(raw[item])
                        return false if not bytes_equal_text(key, "registry") and not bytes_equal_text(key, "version")
                    in_string <- false
            return not in_string and not escaped and braces == 1 and brackets == 0

        def metadata_string(raw: darray[u8]&, wanted: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            key_length: usize = Platform::pkg_strlen(wanted)
            in_string: mutable bool = false
            escaped: mutable bool = false
            braces: mutable i64 = 0
            start: mutable usize = 0
            for index in 0..<raw.count |raw, in_string, escaped, braces, start|:
                byte: u8 = raw[index]
                if not in_string:
                    if byte == 123:
                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 34:
                        in_string <- true
                        start <- index + 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
                    while after < raw.count and (raw[after] == 32 or raw[after] == 9 or raw[after] == 10 or raw[after] == 13) |raw, after|:
                        after <- after + 1
                    if braces == 1 and after < raw.count and raw[after] == 58 and index - start == key_length:
                        matched: mutable bool = true
                        for key_index in 0..<key_length |raw, wanted, start, matched|:
                            matched <- false if raw[start + key_index] != wanted[key_index].u8()
                        if matched:
                            after <- after + 1
