                        braces <- braces + 1
                    elif byte == 125:
                        braces <- braces - 1
                    elif byte == 34:
                        in_string <- true
                        start <- index + 1
                elif escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 34:
                    after: mutable usize = index + 1
