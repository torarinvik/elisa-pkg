                            return false if after < raw.count and raw[after] != 32 and raw[after] != 9 and raw[after] != 10 and raw[after] != 13 and raw[after] != 44 and raw[after] != 125
                            out <- value
                            return true
                    in_string <- false
            return false

        def selected_version_below(version: darray[u8]&, previous: Model::Version) -> bool:
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return false if not SemVer::parse(version, &parsed)
            return SemVer::compare(parsed, previous) < 0

        def trust_state_directory(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            path_with_nul(path, &path_c)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            created: i64 = Platform::pkg_mkdir(path_name, 448.u16())
            if created == 0:
                return false if Platform::pkg_fsync_parent(path_name) != 0
                return Platform::pkg_is_trusted_directory(path_name) == 1
            return Platform::pkg_is_trusted_directory(path_name) == 1 if created == -17
            return false

        def trust_state_path(root: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            override: u8&? = Platform::pkg_getenv("ELISAPKG_TRUST_STATE")
            if override is configured:
                value: cstr = configured.cast[cstr]
                length: usize = Platform::pkg_strlen(value)
                return [] if length == 0 or length > 4096 or value[0].u8() != 47
                resolved: mutable darray[u8] = []
                for index in 0..<length |resolved, value|:
                    byte: u8 = value[index].u8()
                    return [] if byte == 0 or byte < 32 or byte == 127 or byte == 92
                    resolved.push(byte)
                return [] if resolved[resolved.count - 1.usize()] == 47
                segment_start: mutable usize = 1.usize()
                for index in 1..<(length + 1.usize()) |value, segment_start|:
                    if index == length or value[index].u8() == 47:
                        segment_length: usize = index - segment_start
                        return [] if segment_length == 0.usize() or segment_length == 1.usize() and value[segment_start].u8() == 46 or segment_length == 2.usize() and value[segment_start].u8() == 46 and value[segment_start + 1.usize()].u8() == 46
                        segment_start <- index + 1.usize()
                return [] if not trusted_state_parent(resolved)
                final_path: mutable darray[u8] = []
                for index in 0..<length |final_path, value|:
                    final_path.push(value[index].u8())
                return final_path
            home_ref: u8&? = Platform::pkg_getenv("HOME")
            if home_ref is home_value:
                home: cstr = home_value.cast[cstr]
                return trust_state_path_for_home(root, home)
            return []

        def trusted_state_parent(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if path.count == 0.usize() or path[0] != 47
            slash: mutable usize = path.count
            while slash > 0.usize() and path[slash - 1.usize()] != 47:
                slash <- slash - 1.usize()
            return false if slash == 0.usize()
            parent: mutable darray[u8] = []
            if slash == 1.usize():
                parent.push(47)
            else:
                for index in 0..<(slash - 1.usize()) |parent, path|:
                    parent.push(path[index])
            parent.push(0)
            parent_name: cstr = (&parent[0]).cast[cstr] can Unsafe.PointerCast
            return Platform::pkg_is_trusted_directory(parent_name) == 1

        def trust_state_path_for_home(root: darray[u8]&, home: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            home_length: usize = safe_home_length(home)
            return [] if home_length == 0
            root_digest_bytes: mutable darray[u8] = []
            root_digest: mutable darray[u8] = []
            return [] if Integrity::sha256(root, &root_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(root_digest_bytes, &root_digest)
            base: mutable darray[u8] = []
            for index in 0..<home_length |base, home|:
                base.push(home[index].u8())
            if home_length > 1.usize():
                registry_push_text(&base, "/.local/share/elisapkg/trust")
            else:
                registry_push_text(&base, ".local/share/elisapkg/trust")
            parent: mutable darray[u8] = []
            for index in 0..<home_length |parent, home|:
                parent.push(home[index].u8())
            if home_length > 1.usize():
                registry_push_text(&parent, "/.local")
            else:
                registry_push_text(&parent, ".local")
            # Build the final path in a local buffer before calling filesystem
            # helpers. The stage1 ABI can invalidate a caller-owned darray after
            # nested FFI calls; returning this completed value lets the caller's
            # arena own the path and keeps its cursor and allocation metadata valid.
            resolved_path: mutable darray[u8] = []
            for index in 0..<base.count |resolved_path, base|:
                resolved_path.push(base[index])
            resolved_path.push(47)
            for index in 0..<root_digest.count |resolved_path, root_digest|:
                resolved_path.push(root_digest[index])
            registry_push_text(&resolved_path, ".state")
            return [] if not trust_state_directory(&parent)
            parent.resize(home_length)
            if home_length > 1.usize():
                registry_push_text(&parent, "/.local/share")
            else:
                registry_push_text(&parent, ".local/share")
            return [] if not trust_state_directory(&parent)
            parent.resize(home_length)
            if home_length > 1.usize():
                registry_push_text(&parent, "/.local/share/elisapkg")
            else:
                registry_push_text(&parent, ".local/share/elisapkg")
            return [] if not trust_state_directory(&parent)
            return [] if not trust_state_directory(&base)
            return [] if resolved_path.count > 4096
            return resolved_path

        def trust_state_path_readonly(root: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            override: u8&? = Platform::pkg_getenv("ELISAPKG_TRUST_STATE")
            if override is configured:
                value: cstr = configured.cast[cstr]
                length: usize = Platform::pkg_strlen(value)
                return [] if length == 0 or length > 4096 or value[0].u8() != 47
                resolved: mutable darray[u8] = []
                for index in 0..<length |resolved, value|:
                    byte: u8 = value[index].u8()
                    return [] if byte == 0 or byte < 32 or byte == 127 or byte == 92
                    resolved.push(byte)
                return [] if resolved[resolved.count - 1.usize()] == 47
                segment_start: mutable usize = 1.usize()
                for index in 1..<(length + 1.usize()) |value, segment_start|:
                    if index == length or value[index].u8() == 47:
                        segment_length: usize = index - segment_start
                        return [] if segment_length == 0.usize() or segment_length == 1.usize() and value[segment_start].u8() == 46 or segment_length == 2.usize() and value[segment_start].u8() == 46 and value[segment_start + 1.usize()].u8() == 46
                        segment_start <- index + 1.usize()
                return [] if not trusted_state_parent(resolved)
                final_path: mutable darray[u8] = []
                for index in 0..<length |final_path, value|:
                    final_path.push(value[index].u8())
                return final_path
            home_ref: u8&? = Platform::pkg_getenv("HOME")
            if home_ref is home_value:
                home: cstr = home_value.cast[cstr]
                return trust_state_path_for_home_readonly(root, home)
            return []

        def trust_state_path_for_home_readonly(root: darray[u8]&, home: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            home_length: usize = safe_home_length(home)
            return [] if home_length == 0
            root_digest_bytes: mutable darray[u8] = []
            root_digest: mutable darray[u8] = []
            return [] if Integrity::sha256(root, &root_digest_bytes) != Integrity::DigestCode.Ok or not Integrity::hex_digest(root_digest_bytes, &root_digest)
            resolved: mutable darray[u8] = []
            for index in 0..<home_length |resolved, home|:
                resolved.push(home[index].u8())
            if home_length > 1.usize():
                registry_push_text(&resolved, "/.local/share/elisapkg/trust")
            else:
                registry_push_text(&resolved, ".local/share/elisapkg/trust")
            resolved.push(47)
            for index in 0..<root_digest.count |resolved, root_digest|:
                resolved.push(root_digest[index])
            registry_push_text(&resolved, ".state")
            return [] if resolved.count > 4096
            return resolved

        def trust_state_read(path: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            loaded: mutable darray[u8] = []
            read_status: i64 = read_trusted_file(path, 1048576.usize(), &loaded)
            if read_status < 0:
                # Only the descriptor-relative ENOENT result is an empty
                # history. Insecure parents, symlinks, and unreadable files
                # must never reset rollback protection.
                return ResultCode.Ok if read_status == -2
                return ResultCode.TrustStateUnavailable
            # Version 2 binds the exact signed metadata digest as well as the
            # archive digest. Legacy v1 records cannot establish that identity
            # and are deliberately rejected without migration.
            return ResultCode.TrustStateMalformed if loaded.count == 0 or loaded.count > 1048576 or not bytes_starts_with_text(loaded, "elisapkg-trust-state:2\n")
            for index in 0..<loaded.count |out, loaded|:
                out.push(loaded[index])
            return ResultCode.Ok

        def trust_state_find(state: darray[u8]&, package: darray[u8]&, version_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, metadata_digest_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic]:
            version_out.resize(0)
            digest_out.resize(0)
            metadata_digest_out.resize(0)
            cursor: mutable usize = 23.usize()
            found: mutable bool = false
            while cursor < state.count:
                finish: mutable usize = cursor
                while finish < state.count and state[finish] != 10 |state, finish|:
                    finish <- finish + 1.usize()
                # Every record is newline-terminated. A truncated final line
                # must not be treated as durable trust history.
                return ResultCode.TrustStateMalformed if finish == cursor or finish == state.count
                first_separator: mutable usize = cursor
                while first_separator < finish and state[first_separator] != 32 |state, first_separator|:
                    first_separator <- first_separator + 1.usize()
                second_separator: mutable usize = first_separator + 1.usize()
                while second_separator < finish and state[second_separator] != 32 |state, second_separator|:
                    second_separator <- second_separator + 1.usize()
                third_separator: mutable usize = second_separator + 1.usize()
                while third_separator < finish and state[third_separator] != 32 |state, third_separator|:
                    third_separator <- third_separator + 1.usize()
                return ResultCode.TrustStateMalformed if first_separator == cursor or second_separator >= finish or third_separator >= finish or first_separator + 1.usize() == second_separator or second_separator + 1.usize() == third_separator or third_separator + 1.usize() >= finish
                line_package: mutable darray[u8] = []
                line_version: mutable darray[u8] = []
                line_digest: mutable darray[u8] = []
                line_metadata_digest: mutable darray[u8] = []
                for index in cursor..<first_separator |line_package, state|:
                    line_package.push(state[index])
                for index in (first_separator + 1.usize())..<second_separator |line_version, state|:
                    line_version.push(state[index])
                for index in (second_separator + 1.usize())..<third_separator |line_digest, state|:
                    line_digest.push(state[index])
                for index in (third_separator + 1.usize())..<finish |line_metadata_digest, state|:
                    line_metadata_digest.push(state[index])
                return ResultCode.TrustStateMalformed if not registry_valid_name(line_package) or not valid_digest(line_digest) or not valid_digest(line_metadata_digest)
                parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                return ResultCode.TrustStateMalformed if not SemVer::parse(line_version, &parsed) or parsed.prerelease
                previous: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                should_copy: mutable bool = false
                if bytes_equal(line_package, package):
                    if found:
                        return ResultCode.TrustStateMalformed if not SemVer::parse(version_out, &previous)
                        return ResultCode.TrustStateMalformed if SemVer::compare(parsed, previous) < 0
                        return ResultCode.TrustStateMalformed if SemVer::compare(parsed, previous) == 0 and (not bytes_equal(digest_out, line_digest) or not bytes_equal(metadata_digest_out, line_metadata_digest))
                        should_copy <- SemVer::compare(parsed, previous) > 0
                    else:
                        should_copy <- true
                    if should_copy:
                        version_out.resize(0)
                        digest_out.resize(0)
                        metadata_digest_out.resize(0)
                        for index in 0..<line_version.count |version_out, line_version|:
                            version_out.push(line_version[index])
                        for index in 0..<line_digest.count |digest_out, line_digest|:
                            digest_out.push(line_digest[index])
                        for index in 0..<line_metadata_digest.count |metadata_digest_out, line_metadata_digest|:
                            metadata_digest_out.push(line_metadata_digest[index])
                    found <- true
                cursor <- finish + 1.usize()
            return ResultCode.Ok

        def bytes_starts_with_text(value: darray[u8]&, expected: cstr) -> bool:
            length: usize = Platform::pkg_strlen(expected)
            return false if value.count < length
            for index in 0..<length |value, expected|:
                return false if value[index] != expected[index].u8()
            return true

        def trust_state_release(lock_path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            path_with_nul(lock_path, &path_c)
            lock_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            result: i64 = Platform::pkg_rmdir(lock_name)
            # A trust lock is acquired immediately before this call. Missing
            # at release time indicates interference and must not be accepted
            # as an idempotent success.
            return result == 0

        def trust_state_finish(lock_path: darray[u8]&, code: ResultCode) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            released: bool = trust_state_release(lock_path)
            return ResultCode.TrustStateUnavailable if not released
            return code

        def trust_state_write(path: darray[u8]&, value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            stable_path: mutable darray[u8] = []
            registry_push_array(&stable_path, path)
            template: mutable darray[u8] = []
            for index in 0..<stable_path.count |template, stable_path|:
                template.push(stable_path[index])
            registry_push_text(&template, ".tmp.XXXXXX")
            template.push(0)
            fd: i64 = Platform::pkg_mkstemp(&template)
            return false if fd < 0
            temp_path_snapshot: mutable darray[u8] = []
            for index in 0..<template.count |temp_path_snapshot, template|:
                temp_path_snapshot.push(template[index])
            written: mutable usize = 0.usize()
            failed: mutable bool = false
            while written < value.count |value, written, fd, failed|:
                chunk: void& = (&value[written]).cast[void&] can Unsafe.PointerCast
                amount: i64 = Platform::pkg_write(fd, chunk, value.count - written) can Console.Write
                if amount <= 0 or amount > (value.count - written).i64():
                    failed <- true
                    break
                written <- written + amount.usize()
            failed <- true if not failed and Platform::pkg_fsync(fd) != 0
            failed <- true if Platform::pkg_close(fd) != 0
            return false if failed
            # Do not retain C-string aliases across write/fsync/close calls.
            # Rebuild both path strings from Elisa-owned snapshots immediately
            # before rename, then rebuild the destination once more before the
            # parent-directory sync.
            temp_name_buffer: mutable darray[u8] = []
            for index in 0..<temp_path_snapshot.count |temp_name_buffer, temp_path_snapshot|:
                temp_name_buffer.push(temp_path_snapshot[index])
            path_c: mutable darray[u8] = []
            path_with_nul(stable_path, &path_c)
            temp_name: cstr = (&temp_name_buffer[0]).cast[cstr] can Unsafe.PointerCast
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            if Platform::pkg_rename(temp_name, path_name) != 0:
                # The descriptor is closed before this branch. Leave the
                # temporary evidence rather than deleting a pathname that
                # could have been replaced concurrently.
                return false
            sync_path: mutable darray[u8] = []
            path_with_nul(stable_path, &sync_path)
            sync_name: cstr = (&sync_path[0]).cast[cstr] can Unsafe.PointerCast
            return Platform::pkg_fsync_parent(sync_name) == 0

        def trust_state_record(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not registry_valid_name(package) or not Archive::is_safe_entry(version) or not valid_digest(digest) or not valid_digest(metadata_digest)
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return ResultCode.InvalidConfiguration if not SemVer::parse(version, &parsed) or parsed.prerelease
            root: mutable darray[u8] = []
            return ResultCode.NotConfigured if not configured_root(&root)
            state_path: mutable darray[u8] = trust_state_path(root)
            return ResultCode.TrustStateUnavailable if state_path.count == 0
            return ResultCode.TrustStateUnavailable if state_path.count > 4090.usize()
            lock_path: mutable darray[u8] = []
            for index in 0..<state_path.count |lock_path, state_path|:
                lock_path.push(state_path[index])
            registry_push_text(&lock_path, ".lock")
            return ResultCode.TrustStateUnavailable if lock_path.count > 4096
            # Preserve the exact directory created below in an independent
            # Elisa-owned value. Cleanup never depends on a C-string or a path
            # buffer used by later FFI calls.
            release_path_snapshot: mutable darray[u8] = []
            registry_push_array(&release_path_snapshot, lock_path)
            lock_c: mutable darray[u8] = []
            path_with_nul(lock_path, &lock_c)
            lock_name: cstr = (&lock_c[0]).cast[cstr] can Unsafe.PointerCast
            return ResultCode.TrustStateUnavailable if Platform::pkg_mkdir(lock_name, 448.u16()) != 0
            # Rebuild path buffers after the filesystem call. The stage1 ABI
            # may invalidate caller-owned darrays across FFI boundaries.
            root_after_lock: mutable darray[u8] = []
            if not configured_root(&root_after_lock):
                _ = trust_state_release(release_path_snapshot)
                return ResultCode.TrustStateUnavailable
            state_path <- trust_state_path(root_after_lock)
            if state_path.count == 0 or state_path.count > 4090.usize():
                _ = trust_state_release(release_path_snapshot)
                return ResultCode.TrustStateUnavailable
            lock_path.resize(0)
            for index in 0..<state_path.count |lock_path, state_path|:
                lock_path.push(state_path[index])
            registry_push_text(&lock_path, ".lock")
            if not bytes_equal(lock_path, release_path_snapshot):
                _ = trust_state_release(release_path_snapshot)
                return ResultCode.TrustStateUnavailable
            state: mutable darray[u8] = []
            read_status: ResultCode = trust_state_read(state_path, &state)
            return trust_state_finish(release_path_snapshot, read_status) if read_status != ResultCode.Ok
            observed_clock: mutable u64 = 0
            clock_missing: mutable bool = false
            observed_state_digest: mutable darray[u8] = []
            clock_path_start: usize = state_path.count
            registry_push_text(&state_path, ".clock")
            clock_status: ResultCode = trust_clock_read(state_path, &observed_clock, &observed_state_digest, &clock_missing)
            state_path.resize(clock_path_start)
            return trust_state_finish(release_path_snapshot, clock_status) if clock_status != ResultCode.Ok
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if clock_missing and state.count > 23.usize()
            current_state_digest: mutable darray[u8] = []
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if not trust_state_digest(state, &current_state_digest)
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if not clock_missing and not bytes_equal(observed_state_digest, current_state_digest)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if now < 0
            return trust_state_finish(release_path_snapshot, ResultCode.ClockRollback) if observed_clock > now.u64()
            return trust_state_finish(release_path_snapshot, ResultCode.ExpiredMetadata) if expires <= now.u64()
            previous_version: mutable darray[u8] = []
            previous_digest: mutable darray[u8] = []
            previous_metadata_digest: mutable darray[u8] = []
            find_status: ResultCode = trust_state_find(state, package, &previous_version, &previous_digest, &previous_metadata_digest) if state.count > 0 else ResultCode.Ok
            return trust_state_finish(release_path_snapshot, find_status) if find_status != ResultCode.Ok
            if previous_version.count > 0.usize():
                previous: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
                return trust_state_finish(release_path_snapshot, ResultCode.TrustStateMalformed) if not SemVer::parse(previous_version, &previous)
                return trust_state_finish(release_path_snapshot, ResultCode.RollbackDetected) if SemVer::compare(parsed, previous) < 0
                return trust_state_finish(release_path_snapshot, ResultCode.DigestMismatch) if SemVer::compare(parsed, previous) == 0 and (not bytes_equal(previous_digest, digest) or not bytes_equal(previous_metadata_digest, metadata_digest))
                if SemVer::compare(parsed, previous) == 0:
                    registry_push_text(&state_path, ".clock")
                    clock_written: bool = trust_clock_write(state_path, now.u64(), current_state_digest)
                    state_path.resize(clock_path_start)
                    return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if not clock_written
                    return trust_state_finish(release_path_snapshot, ResultCode.Ok)
            if state.count == 0:
                registry_push_text(&state, "elisapkg-trust-state:2\n")
            record_size: usize = package.count + version.count + digest.count + metadata_digest.count + 4.usize()
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if record_size > 1048576.usize() or state.count > 1048576.usize() - record_size
            registry_push_array(&state, package)
            state.push(32)
            registry_push_array(&state, version)
            state.push(32)
            registry_push_array(&state, digest)
            state.push(32)
            registry_push_array(&state, metadata_digest)
            state.push(10)
            updated_state_digest: mutable darray[u8] = []
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if not trust_state_digest(state, &updated_state_digest)
            # Bind the proposed state bytes into the sidecar before publishing
            # the state. A crash between these atomic writes leaves a mismatch,
            # which fails closed instead of accepting either history.
            registry_push_text(&state_path, ".clock")
            clock_written: bool = trust_clock_write(state_path, now.u64(), updated_state_digest)
            state_path.resize(clock_path_start)
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if not clock_written
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if not trust_state_write(state_path, state)
            return trust_state_finish(release_path_snapshot, ResultCode.Ok)

        def trust_state_verify(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not registry_valid_name(package) or not Archive::is_safe_entry(version) or not valid_digest(digest) or not valid_digest(metadata_digest)
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return ResultCode.InvalidConfiguration if not SemVer::parse(version, &parsed) or parsed.prerelease
            package_value: mutable darray[u8] = []
            version_value: mutable darray[u8] = []
            digest_value: mutable darray[u8] = []
            metadata_digest_value: mutable darray[u8] = []
            registry_push_array(&package_value, package)
            registry_push_array(&version_value, version)
            registry_push_array(&digest_value, digest)
            registry_push_array(&metadata_digest_value, metadata_digest)
            root: mutable darray[u8] = []
            value_ref: u8&? = Platform::pkg_getenv("ELISAPKG_REGISTRY_DIR")
            if value_ref is configured_root_value:
                value: cstr = configured_root_value.cast[cstr]
                length: usize = Platform::pkg_strlen(value)
                return ResultCode.InvalidConfiguration if length == 0 or length > 4096
                for index in 0..<length |root, value|:
                    root.push(value[index].u8())
            state_path: mutable darray[u8] = trust_state_path_readonly(root)
            return ResultCode.TrustStateUnavailable if state_path.count == 0 or state_path.count > 4090.usize()
            lock_path: mutable darray[u8] = []
            registry_push_array(&lock_path, state_path)
            registry_push_text(&lock_path, ".lock")
            return ResultCode.TrustStateUnavailable if lock_path.count > 4096
            # Preserve the exact acquired lock path separately; all later
            # exits release this snapshot, even if state-path rebuilding or
            # another filesystem call invalidates temporary C-string storage.
            release_path_snapshot: mutable darray[u8] = []
            registry_push_array(&release_path_snapshot, lock_path)
            lock_c: mutable darray[u8] = []
            path_with_nul(lock_path, &lock_c)
            lock_name: cstr = (&lock_c[0]).cast[cstr] can Unsafe.PointerCast
            return ResultCode.TrustStateUnavailable if Platform::pkg_mkdir(lock_name, 448.u16()) != 0
            # FFI may invalidate caller-owned array headers. Rebuild the state
            # and lock paths after acquiring the lock before using either one.
            root_after_lock: mutable darray[u8] = []
            root_ref: u8&? = Platform::pkg_getenv("ELISAPKG_REGISTRY_DIR")
            if root_ref is configured_root_after_lock:
                root_value: cstr = configured_root_after_lock.cast[cstr]
                root_length: usize = Platform::pkg_strlen(root_value)
                if root_length == 0 or root_length > 4096:
                    _ = trust_state_release(release_path_snapshot)
                    return ResultCode.InvalidConfiguration
                for index in 0..<root_length |root_after_lock, root_value|:
                    root_after_lock.push(root_value[index].u8())
            state_path <- trust_state_path_readonly(root_after_lock)
            if state_path.count == 0 or state_path.count > 4090.usize():
                _ = trust_state_release(release_path_snapshot)
                return ResultCode.TrustStateUnavailable
            lock_path.resize(0)
            registry_push_array(&lock_path, state_path)
            registry_push_text(&lock_path, ".lock")
            if lock_path.count > 4096:
                _ = trust_state_release(release_path_snapshot)
                return ResultCode.TrustStateUnavailable
            if not bytes_equal(lock_path, release_path_snapshot):
                _ = trust_state_release(release_path_snapshot)
                return ResultCode.TrustStateUnavailable
            state: mutable darray[u8] = []
            read_status: ResultCode = trust_state_read(state_path, &state)
            return trust_state_finish(release_path_snapshot, read_status) if read_status != ResultCode.Ok
            observed_clock: mutable u64 = 0
            clock_missing: mutable bool = false
            observed_state_digest: mutable darray[u8] = []
            clock_path: mutable darray[u8] = []
            registry_push_array(&clock_path, state_path)
            registry_push_text(&clock_path, ".clock")
            clock_status: ResultCode = trust_clock_read(clock_path, &observed_clock, &observed_state_digest, &clock_missing)
            return trust_state_finish(release_path_snapshot, clock_status) if clock_status != ResultCode.Ok
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if clock_missing and state.count > 23.usize()
            current_state_digest: mutable darray[u8] = []
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if not trust_state_digest(state, &current_state_digest)
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if not clock_missing and not bytes_equal(observed_state_digest, current_state_digest)
            now: i64 = Platform::pkg_wall_clock_seconds()
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if now < 0
            return trust_state_finish(release_path_snapshot, ResultCode.ClockRollback) if observed_clock > now.u64()
            return trust_state_finish(release_path_snapshot, ResultCode.ExpiredMetadata) if expires <= now.u64()
            previous_version: mutable darray[u8] = []
            previous_digest: mutable darray[u8] = []
            previous_metadata_digest: mutable darray[u8] = []
            find_status: ResultCode = trust_state_find(state, package_value, &previous_version, &previous_digest, &previous_metadata_digest) if state.count > 0 else ResultCode.Ok
            return trust_state_finish(release_path_snapshot, find_status) if find_status != ResultCode.Ok
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if previous_version.count == 0.usize()
            previous: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateMalformed) if not SemVer::parse(previous_version, &previous)
            return trust_state_finish(release_path_snapshot, ResultCode.RollbackDetected) if SemVer::compare(parsed, previous) < 0
            if SemVer::compare(parsed, previous) == 0 and (not bytes_equal(previous_digest, digest_value) or not bytes_equal(previous_metadata_digest, metadata_digest_value)):
                return trust_state_finish(release_path_snapshot, ResultCode.DigestMismatch)
            return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if SemVer::compare(parsed, previous) > 0
            if now.u64() > observed_clock:
                clock_written: bool = trust_clock_write(clock_path, now.u64(), current_state_digest)
                return trust_state_finish(release_path_snapshot, ResultCode.TrustStateUnavailable) if not clock_written
            return trust_state_finish(release_path_snapshot, ResultCode.Ok)

        def trust_clock_read(path: darray[u8]&, out: mutable u64&, state_digest: mutable darray[u8]&, missing: mutable bool&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out <- 0
            state_digest.resize(0)
            missing <- false
            loaded: mutable darray[u8] = []
            read_status: i64 = read_trusted_file(path, 128.usize(), &loaded)
            if read_status < 0:
                if read_status == -2:
                    missing <- true
                    return ResultCode.Ok
                return ResultCode.TrustStateUnavailable
            return ResultCode.TrustStateMalformed if loaded.count < 86.usize() or loaded.count > 105.usize()
            prefix: cstr = "clock:"
            prefix_length: usize = Platform::pkg_strlen(prefix)
            return ResultCode.TrustStateMalformed if loaded.count <= prefix_length + 1.usize()
            for index in 0..<prefix_length |loaded, prefix|:
                return ResultCode.TrustStateMalformed if loaded[index] != prefix[index].u8()
            value: mutable u64 = 0
            cursor: mutable usize = prefix_length
            while cursor < loaded.count and loaded[cursor] != 10:
                return ResultCode.TrustStateMalformed if loaded[cursor] < 48 or loaded[cursor] > 57
                digit: u64 = (loaded[cursor] - 48).u64()
                return ResultCode.TrustStateMalformed if value > (18446744073709551615.u64() - digit) / 10.u64()
                value <- value * 10.u64() + digit
                cursor <- cursor + 1.usize()
            return ResultCode.TrustStateMalformed if cursor == prefix_length or cursor >= loaded.count
            cursor <- cursor + 1.usize()
            hash_prefix: cstr = "state-sha256:"
            hash_prefix_length: usize = Platform::pkg_strlen(hash_prefix)
            return ResultCode.TrustStateMalformed if loaded.count != cursor + hash_prefix_length + 65.usize()
            for index in 0..<hash_prefix_length |loaded, hash_prefix|:
                return ResultCode.TrustStateMalformed if loaded[cursor + index] != hash_prefix[index].u8()
            cursor <- cursor + hash_prefix_length
            for index in 0..<64.usize() |loaded, state_digest, cursor|:
                byte: u8 = loaded[cursor + index]
                return ResultCode.TrustStateMalformed if (byte < 48 or byte > 57) and (byte < 97 or byte > 102)
                state_digest.push(byte)
            return ResultCode.TrustStateMalformed if loaded[loaded.count - 1.usize()] != 10
            out <- value
            return ResultCode.Ok

        def trust_state_digest(state: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            digest_bytes: mutable darray[u8] = []
            out.resize(0)
            return false if Integrity::sha256(state, &digest_bytes) != Integrity::DigestCode.Ok
            return Integrity::hex_digest(digest_bytes, out)

        def trust_clock_append_decimal(out: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            start: usize = out.count
            out.resize(start + 20.usize())
            number: mutable u64 = value
            cursor: mutable usize = start
            if number == 0:
                out[cursor] <- 48
                cursor <- cursor + 1.usize()
            else:
                while number > 0 |out, number, cursor|:
                    out[cursor] <- 48 + (number % 10).u8()
                    cursor <- cursor + 1.usize()
                    number <- number / 10
                left: mutable usize = start
                right: mutable usize = cursor
                while left < right and right - left > 1.usize() |out, left, right|:
                    right <- right - 1.usize()
                    temporary: u8 = out[left]
                    out[left] <- out[right]
                    out[right] <- temporary
                    left <- left + 1.usize()
            out.resize(cursor)

        def trust_clock_write(path: darray[u8]&, value: u64, state_digest: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return false if not valid_digest(state_digest)
            encoded: mutable darray[u8] = []
            registry_push_text(&encoded, "clock:")
            trust_clock_append_decimal(&encoded, value)
            encoded.push(10)
            registry_push_text(&encoded, "state-sha256:")
            registry_push_array(&encoded, state_digest)
            encoded.push(10)
            return trust_state_write(path, encoded)

        def metadata_root_object(raw: darray[u8]&) -> bool:
            first: mutable usize = 0
            last: mutable usize = raw.count
            while first < raw.count and (raw[first] == 32 or raw[first] == 9 or raw[first] == 10 or raw[first] == 13) |raw, first|:
                first <- first + 1
            while last > first and (raw[last - 1] == 32 or raw[last - 1] == 9 or raw[last - 1] == 10 or raw[last - 1] == 13) |raw, last|:
                last <- last - 1
            return false if first >= last or raw[first] != 123 or raw[last - 1] != 125
            depth: mutable i64 = 0
            in_string: mutable bool = false
            escaped: mutable bool = false
            for index in first..<last |raw, depth, in_string, escaped|:
                byte: u8 = raw[index]
                if in_string:
                    if escaped:
                        escaped <- false
                    elif byte == 92:
                        escaped <- true
                    elif byte == 34:
                        in_string <- false
                elif byte == 34:
                    in_string <- true
                elif byte == 123:
                    depth <- depth + 1
                elif byte == 125:
                    depth <- depth - 1
                    return false if depth < 0
            return not in_string and not escaped and depth == 0

        def expiry_is_future(expires: u64, now: u64) -> bool:
            return expires > now

        def valid_digest(value: darray[u8]&) -> bool:
            return false if value.count != 64
            for index in 0..<value.count |value|:
                return false if (value[index] < 48 or value[index] > 57) and (value[index] < 97 or value[index] > 102)
            return true

        def bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true
