# Authenticated file-backed registry provider.

include "./platform.elisa"
include "./archive.elisa"
include "./integrity.elisa"
include "./json.elisa"
include "./package/model.elisa"
include "./package/package_identity.elisa"
include "./resolution/resolve.elisa"
include "./resolution/semver.elisa"
include "./resolution/solver.elisa"
include "./trust.elisa"
include "./tuf.elisa"
include "./registry/signed_index.elisa"
include "./registry/release_metadata.elisa"
include "./registry/release_archive.elisa"
include "./registry/checkpoint_store.elisa"
include "./registry/configuration.elisa"
include "./registry/rollback_store.elisa"
include "./registry/trust_identity.elisa"
include "./registry/files.elisa"
include "./registry/result.elisa"
include "./project/files.elisa"

module Registry:
    public:
        # Render the exact solver requirement used to replay a locked version.
        def exact_requirement(version: Model::Version, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            ByteText::append_decimal(out, version.major)
            out.push(46)
            ByteText::append_decimal(out, version.minor)
            out.push(46)
            ByteText::append_decimal(out, version.patch)

        # Decode dependency constraints from already authenticated metadata.
        # The output is kept separate from metadata records because the current
        # stage1 compiler cannot safely move recursive darray fields nested in a
        # public record; keeping this buffer at the call boundary preserves
        # ownership and makes the limitation explicit.
        def read_dependencies(metadata: darray[u8]&, out: mutable darray[Solver::Constraint]&) -> bool can[Memory.Allocate, Abort.Panic]:
            ReleaseMetadata::dependencies(metadata, out)

        # Return the authenticated registry's bounded version index. Its exact
        # bytes are bound to a signed, expiring per-package snapshot, whose
        # generation is recorded in the same rollback-protected user state as
        # selected release identities.
        def read_index(package: darray[u8]&, out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            yanked_flags: mutable darray[u8] = []
            read_index_with_yanked(package, out, &yanked_flags, generation_out, snapshot_digest_out, identity_out)

        # Return the exact signed yanked set beside the authenticated version
        # list. Yank state is index policy and cannot be inferred from release
        # metadata; security revocation requires a separate authenticated rule.
        # The output is a 0/1 byte bitmap aligned with newline-delimited versions.
        def read_index_with_yanked(package: darray[u8]&, out: mutable darray[u8]&, yanked_flags_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            key_fingerprint: mutable darray[u8] = []
            read_index_with_key_fingerprint(package, out, yanked_flags_out, generation_out, snapshot_digest_out, identity_out, &key_fingerprint)

    private:
        # The configured registry root and the path of its trust root.
        struct RegistryAccess:
            root: mutable darray[u8]
            key_path: mutable darray[u8]

        # A selected release and its authenticated metadata, published to the
        # caller's outputs only after every check passed.
        struct SelectedRelease:
            version: mutable darray[u8]
            archive: mutable darray[u8]
            digest: mutable darray[u8]
            archive_size: mutable u64
            metadata: mutable darray[u8]

        # Fields of a metadata snapshot verified from the offline cache.
        struct VerifiedSnapshot:
            archive: mutable darray[u8]
            digest: mutable darray[u8]
            archive_size: mutable u64
            expires: mutable u64

        # The version lines of a signed index and one yanked flag per line.
        struct SignedIndex:
            versions: mutable darray[u8]
            yanked_flags: mutable darray[u8]

        # An authenticated index, its evidence, and the key that signed it.
        struct CurrentIndex:
            versions: mutable darray[u8]
            generation: mutable u64
            digest: mutable darray[u8]
            identity: mutable darray[u8]
            key_fingerprint: mutable darray[u8]

        def empty_access() -> RegistryAccess:
            RegistryAccess{root: [], key_path: []}

        def empty_selected_release() -> SelectedRelease:
            SelectedRelease{version: [], archive: [], digest: [], archive_size: 0, metadata: []}

        def zero_version() -> Model::Version:
            Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}

        # Read and validate the configured registry root.
        def configured_registry_root(root: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            ResultCode.NotConfigured if not RegistryConfiguration::configured_root(root) else ResultCode.InvalidConfiguration if not RegistryRoot::valid(root) else ResultCode.Ok

        # Read the registry root and the path of its trust root.
        def configured_registry(access: mutable RegistryAccess&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root_status: ResultCode = configured_registry_root(&access.root)
            root_status if root_status != ResultCode.Ok else configuration_result(RegistryConfiguration::configured_trust_root(access.root, &access.key_path))

        # Authenticate `metadata` with the trust root at `key_path` and check
        # that its signed `expires` time has not passed.
        def verify_signed_metadata(key_path: darray[u8]&, metadata: darray[u8]&, signature: darray[u8]&, expires_out: mutable u64&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            public_key: mutable darray[u8] = []
            ResultCode.MissingTrustRoot if RegistryFiles::read_trusted_file(key_path, Trust::ed25519_public_key_bytes, &public_key) != Trust::ed25519_public_key_bytes.i64() else ResultCode.InvalidSignature if Trust::verify_detached("ed25519", public_key, metadata, signature) != Trust::VerificationCode.Valid else ResultCode.MalformedMetadata if not ReleaseMetadata::unsigned_field(metadata, "expires", expires_out) else metadata_expiry_result(expires_out)

        # The archive named by authenticated metadata exists with the expected
        # size and its bytes match the metadata.
        def verify_archive_file(root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&, digest: darray[u8]&, archive_size: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            archive_path: mutable darray[u8] = []
            ResultCode.InvalidConfiguration if not RegistryFiles::join_archive_path(root, package, version, archive, &archive_path) else verify_archive_at(archive_path, package, version, metadata, digest, archive_size)

        def verify_archive_at(archive_path: darray[u8]&, package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, digest: darray[u8]&, archive_size: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            actual_size: i64 =
                terminated_path: darray[u8] = ProjectFiles::with_null_terminator(archive_path)
                Platform::package_file_size((&terminated_path[0]).cast[cstr] can Unsafe.PointerCast)
            archive_bytes: mutable darray[u8] = []
            ResultCode.ArchiveMissing if actual_size < 0 else ResultCode.DigestMismatch if actual_size.u64() != archive_size else ResultCode.ArchiveMissing if not RegistryFiles::read_file(archive_path, Archive::maximum_archive_bytes, &archive_bytes) else verify_archive_payload(package, version, metadata, archive_bytes, digest, archive_size)

        # Check `expires` against the current wall clock.
        def metadata_expiry_result(expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            now: i64 = Platform::wall_clock_seconds()
            ResultCode.ClockUnavailable if now < 0 else rollback_store_result(RollbackStore::metadata_expiry_status(expires, now.u64()))

        # Record a release against the package's current authenticated index.
        # A nonzero `expected_generation` also requires that index to be the
        # exact snapshot (generation, digest, identity) that selected it.
        def record_at_current_index(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64, expected_generation: u64, expected_digest: darray[u8]&, expected_identity: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            index: mutable CurrentIndex = CurrentIndex{versions: [], generation: 0, digest: [], identity: [], key_fingerprint: []}
            index_status: ResultCode = read_current_index(package, &index)
            index_status if index_status != ResultCode.Ok else ResultCode.RollbackDetected if expected_generation != 0 and (index.generation != expected_generation or not ByteText::equal(index.digest, expected_digest) or not ByteText::equal(index.identity, expected_identity)) else ResultCode.NoMatchingVersion if not SignedRegistryIndex::contains_version(index.versions, version) else rollback_store_result(RollbackStore::record_release(package, version, digest, metadata_digest, expires, index.generation, index.digest, index.identity, index.key_fingerprint))

        def read_current_index(package: darray[u8]&, index: mutable CurrentIndex&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            yanked_flags: mutable darray[u8] = []
            read_index_with_key_fingerprint(package, &index.versions, &yanked_flags, &index.generation, &index.digest, &index.identity, &index.key_fingerprint)

        def read_index_with_key_fingerprint(package: darray[u8]&, out: mutable darray[u8]&, yanked_flags_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, key_fingerprint_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            yanked_flags_out.resize(0)
            generation_out <- 0
            snapshot_digest_out.resize(0)
            identity_out.resize(0)
            key_fingerprint_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package)
            access: mutable RegistryAccess = empty_access()
            access_status: ResultCode = configured_registry(&access)
            access_status if access_status != ResultCode.Ok else index_result(SignedRegistryIndex::read(access.root, package, access.key_path, out, yanked_flags_out, generation_out, snapshot_digest_out, identity_out, key_fingerprint_out))

    public:
        # Read one archive selected by authenticated metadata. The caller must
        # supply the exact version, archive leaf, digest, and size returned by
        # `resolve`; this boundary never follows a URL or accepts an arbitrary
        # path. The bytes are checked again immediately before they are handed
        # to cache or extraction code so a mutable fixture cannot race the
        # metadata verification step unnoticed.
        def read_archive(package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&, expected_digest: darray[u8]&, expected_size: u64, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version) or not Archive::is_safe_entry(archive) or not Integrity::valid_sha256_hex(expected_digest) or expected_size > Archive::maximum_archive_bytes.u64()
            root: mutable darray[u8] = []
            root_status: ResultCode = configured_registry_root(&root)
            root_status if root_status != ResultCode.Ok else ResultCode.MalformedMetadata if not ReleaseMetadata::valid_document(metadata) else read_selected_archive(root, package, version, metadata, archive, expected_digest, expected_size, out)

        def release_archive_matches_metadata(package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            RegistryArchive::matches_metadata(package, version, metadata, archive)

        # Record the authenticated immutable package identity in user-owned
        # trust state. This is separate from the project lockfile so deleting
        # or restoring a project cannot reset rollback protection.
        def record_trusted(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package)
            expiry_status: ResultCode = metadata_expiry_result(expires)
            empty_identity: darray[u8] = []
            expiry_status if expiry_status != ResultCode.Ok else record_at_current_index(package, version, digest, metadata_digest, expires, 0, empty_identity, empty_identity)

        # Commit a selected release only while the exact authenticated index
        # snapshot that authorized it is still the highest snapshot recorded
        # for this registry/package. The check and package-history update share
        # one trust-state lock acquisition, closing the gap between index read
        # and package trust publication.
        def record_trusted_at_index(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64, generation: u64, index_digest: darray[u8]&, index_identity: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if:
                not PackageIdentity::valid_name(package) or generation == 0 or not Integrity::valid_sha256_hex(index_digest)
                not Integrity::valid_sha256_hex(metadata_digest) or not Integrity::valid_sha256_hex(digest)
            expiry_status: ResultCode = metadata_expiry_result(expires)
            expiry_status if expiry_status != ResultCode.Ok else record_at_current_index(package, version, digest, metadata_digest, expires, generation, index_digest, index_identity)

        # Check an identity against persisted signed metadata evidence and
        # advance the state-bound wall-clock floor while holding the same lock
        # used by writers. Offline callers invoke this only after authenticating
        # the cached metadata and archive bytes.
        def verify_trusted(package: darray[u8]&, version: darray[u8]&, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) else rollback_store_result(RollbackStore::verify_release(package, version, digest, metadata_digest, expires))

        # Read the durable floors for one stable TUF registry identity. The
        # result uses the same canonical batch format accepted by the commit
        # API; an empty result means this identity has no saved checkpoints.
        # Commit rechecks these floors under its own lock, so a caller must
        # still handle concurrent refreshes through the commit result.
        def read_tuf_checkpoint_batch(registry_identity: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            out.resize(0)
            return ResultCode.InvalidConfiguration if not Tuf::valid_registry_identity_bytes(registry_identity)
            identity_copy: mutable darray[u8] = [registry_identity[item] for item in 0..<registry_identity.count]
            checkpoint_store_result(CheckpointStore::read(identity_copy, out))

        # Atomically persist the complete set of already-authenticated TUF
        # role checkpoints for one stable registry identity. The caller must
        # finish root rotation, signature thresholds, delegations, expiry,
        # snapshot/timestamp binding, and target authorization before calling.
        # The canonical sorted batch is rechecked against durable floors under
        # the same lock that publishes the replacement state file.
        def commit_authenticated_tuf_checkpoint_batch(registry_identity: darray[u8]&, batch: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return ResultCode.InvalidConfiguration if not Tuf::valid_registry_identity_bytes(registry_identity)
            # Bound the copy at the public boundary; the private persistence
            # routine owns the complete batch grammar check so future internal
            # callers cannot bypass it.
            return ResultCode.ResourceLimit if batch.count > Tuf::maximum_metadata_file_bytes
            identity_copy: mutable darray[u8] = []
            batch_copy: mutable darray[u8] = []
            ByteText::append(&identity_copy, registry_identity)
            ByteText::append(&batch_copy, batch)
            checkpoint_store_result(CheckpointStore::commit_authenticated(identity_copy, batch_copy))

        # Resolve one package and verify its detached metadata. The regular
        # entry also verifies the selected archive before exposing success.
        def resolve(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            generation: mutable u64 = 0
            snapshot_digest: mutable darray[u8] = []
            index_identity: mutable darray[u8] = []
            resolve_internal(package, requirement, previous_version, version_out, archive_out, digest_out, archive_size_out, metadata_out, true, &generation, &snapshot_digest, &index_identity)

        # Resolution variant for callers that persist a selected artifact. The
        # returned evidence is from the same verified index bytes whose version
        # list was used to select the result.
        def resolve_with_index_evidence(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            resolve_internal(package, requirement, previous_version, version_out, archive_out, digest_out, archive_size_out, metadata_out, true, generation_out, snapshot_digest_out, identity_out)

        # Verify one exact version already selected by the authenticated graph
        # solver. This entry permits the solver's exact locked-yank exception;
        # it does not choose a version and must not replace solver policy.
        def resolve_selected_with_index_evidence(package: darray[u8]&, version: darray[u8]&, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            version_out.resize(0)
            archive_out.resize(0)
            digest_out.resize(0)
            metadata_out.resize(0)
            archive_size_out <- 0
            generation_out <- 0
            snapshot_digest_out.resize(0)
            identity_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version) or not stable_version(version)
            release: mutable SelectedRelease = empty_selected_release()
            status: ResultCode = resolve_listed(package, version, generation_out, snapshot_digest_out, identity_out, &release)
            status if status != ResultCode.Ok else published_release(release, version_out, archive_out, digest_out, archive_size_out, metadata_out)

        # Candidate enumeration authenticates metadata without reading every
        # archive. This keeps a large signed index from forcing unbounded
        # archive I/O before the solver knows which versions are selected.
        def resolve_metadata(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            generation: mutable u64 = 0
            snapshot_digest: mutable darray[u8] = []
            index_identity: mutable darray[u8] = []
            resolve_internal(package, requirement, previous_version, version_out, archive_out, digest_out, archive_size_out, metadata_out, false, &generation, &snapshot_digest, &index_identity)

        # Resolve one candidate selected from the exact version-list bytes
        # returned by `read_index`. The caller verifies that snapshot once
        # before iterating its candidates; this entry authenticates the
        # selected release metadata independently. Callers without a verified
        # index must use `resolve_metadata` instead.
        def resolve_candidate_metadata(package: darray[u8]&, version: darray[u8]&, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            version_out.resize(0)
            archive_out.resize(0)
            digest_out.resize(0)
            archive_size_out <- 0
            metadata_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version)
            release: mutable SelectedRelease = empty_selected_release()
            status: ResultCode = resolve_configured_selected(package, version, &release)
            status if status != ResultCode.Ok else published_release(release, version_out, archive_out, digest_out, archive_size_out, metadata_out)

        # Read the detached signature that authenticated one immutable metadata
        # record. This is used only after an online fetch has verified the record,
        # so the signature can be carried into the content-addressed offline cache.
        def read_signature(package: darray[u8]&, version: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version)
            root: mutable darray[u8] = []
            root_status: ResultCode = configured_registry_root(&root)
            root_status if root_status != ResultCode.Ok else read_signature_at(root, package, version, out)

        # Verify a metadata snapshot restored from the offline cache. The cache
        # supplies exact bytes and the detached signature; this function repeats
        # the same identity, digest, trust-root, expiry, and dependency checks as
        # the live provider before exposing any fields to lock validation.
        def verify_metadata_snapshot(package: darray[u8]&, version: darray[u8]&, expected_metadata_digest: darray[u8]&, metadata: darray[u8]&, signature: darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, expires_out: mutable u64&, dependencies_out: mutable darray[Solver::Constraint]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            archive_out.resize(0)
            digest_out.resize(0)
            archive_size_out <- 0
            expires_out <- 0
            dependencies_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(version) or not Integrity::valid_sha256_hex(expected_metadata_digest)
            return ResultCode.MalformedMetadata if not ReleaseMetadata::valid_document(metadata)
            snapshot: mutable VerifiedSnapshot = VerifiedSnapshot{archive: [], digest: [], archive_size: 0, expires: 0}
            status: ResultCode = verify_snapshot_fields(package, version, expected_metadata_digest, metadata, signature, &snapshot, dependencies_out)
            status if status != ResultCode.Ok else published_snapshot(snapshot, archive_out, digest_out, archive_size_out, expires_out)

    private:
        # ---------- archives ------------------------------------------------------------------

        # The metadata must name `archive` with the expected digest and size;
        # then read the archive and check its bytes again.
        def read_selected_archive(root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&, expected_digest: darray[u8]&, expected_size: u64, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            metadata_status: ResultCode = metadata_selects_archive(root, package, version, metadata, archive, expected_digest, expected_size)
            metadata_status if metadata_status != ResultCode.Ok else read_archive_payload(root, package, version, metadata, archive, expected_digest, expected_size, out)

        def metadata_selects_archive(root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&, expected_digest: darray[u8]&, expected_size: u64) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            metadata_archive: mutable darray[u8] = []
            metadata_digest: mutable darray[u8] = []
            metadata_size: mutable u64 = 0
            ResultCode.MalformedMetadata if not ReleaseMetadata::match_identity_fields(metadata, root, package, version, &metadata_archive, &metadata_digest, &metadata_size) or not ByteText::equal(metadata_archive, archive) else ResultCode.DigestMismatch if not ByteText::equal(metadata_digest, expected_digest) or metadata_size != expected_size else ResultCode.Ok

        def read_archive_payload(root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&, expected_digest: darray[u8]&, expected_size: u64, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path: mutable darray[u8] = []
            verified_archive: mutable darray[u8] = []
            ResultCode.InvalidConfiguration if not RegistryFiles::join_archive_path(root, package, version, archive, &path) else ResultCode.ArchiveMissing if not RegistryFiles::read_file(path, Archive::maximum_archive_bytes, &verified_archive) else published_archive(verify_archive_payload(package, version, metadata, verified_archive, expected_digest, expected_size), verified_archive, out)

        # Hand the verified archive to the caller when `status` is Ok.
        def published_archive(status: ResultCode, archive: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            ByteText::append(out, archive) if status == ResultCode.Ok
            status

        # ---------- release selection ---------------------------------------------------------

        def resolve_internal(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&, verify_archive: bool, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            version_out.resize(0)
            archive_out.resize(0)
            digest_out.resize(0)
            metadata_out.resize(0)
            archive_size_out <- 0
            generation_out <- 0
            snapshot_digest_out.resize(0)
            identity_out.resize(0)
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package)
            release: mutable SelectedRelease = empty_selected_release()
            status: ResultCode = resolve_highest(package, requirement, previous_version, verify_archive, generation_out, snapshot_digest_out, identity_out, &release)
            status if status != ResultCode.Ok else published_release(release, version_out, archive_out, digest_out, archive_size_out, metadata_out)

        # Select the highest eligible version satisfying `requirement`.
        def resolve_highest(package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, verify_archive: bool, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, release: mutable SelectedRelease&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            access: mutable RegistryAccess = empty_access()
            access_status: ResultCode = configured_registry(&access)
            access_status if access_status != ResultCode.Ok else select_from_index(access, package, requirement, previous_version, verify_archive, generation_out, snapshot_digest_out, identity_out, release)

        def select_from_index(access: RegistryAccess&, package: darray[u8]&, requirement: darray[u8]&, previous_version: Model::Version, verify_archive: bool, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, release: mutable SelectedRelease&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            eligible_index: mutable darray[u8] = []
            index_status: ResultCode = eligible_versions(access, package, generation_out, snapshot_digest_out, identity_out, &eligible_index)
            selected: mutable darray[u8] = []
            index_status if index_status != ResultCode.Ok else ResultCode.NoMatchingVersion if not Resolve::select_highest_version(eligible_index, requirement, &selected) else resolve_selected_internal(access, package, selected, previous_version, verify_archive, release)

        # Read the signed index and keep only its versions that are not yanked.
        def eligible_versions(access: RegistryAccess&, package: darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, eligible_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            index: mutable SignedIndex = SignedIndex{versions: [], yanked_flags: []}
            index_status: ResultCode = read_signed_index(access, package, generation_out, snapshot_digest_out, identity_out, &index)
            index_status if index_status != ResultCode.Ok else ResultCode.MalformedMetadata if not SignedRegistryIndex::filter_yanked_versions(index.versions, index.yanked_flags, eligible_out) else ResultCode.Ok

        # Read the signed index of `package` with its snapshot evidence.
        def read_signed_index(access: RegistryAccess&, package: darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, index: mutable SignedIndex&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            key_fingerprint: mutable darray[u8] = []
            index_result(SignedRegistryIndex::read(access.root, package, access.key_path, &index.versions, &index.yanked_flags, generation_out, snapshot_digest_out, identity_out, &key_fingerprint))

        # A parsed, stable (non-prerelease) version.
        def stable_version(version: darray[u8]&) -> bool:
            parsed: mutable Model::Version = zero_version()
            SemVer::parse(version, &parsed) and not parsed.prerelease

        # Resolve `version`, which the signed index must list.
        def resolve_listed(package: darray[u8]&, version: darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, release: mutable SelectedRelease&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            access: mutable RegistryAccess = empty_access()
            access_status: ResultCode = configured_registry(&access)
            access_status if access_status != ResultCode.Ok else resolve_listed_in_index(access, package, version, generation_out, snapshot_digest_out, identity_out, release)

        def resolve_listed_in_index(access: RegistryAccess&, package: darray[u8]&, version: darray[u8]&, generation_out: mutable u64&, snapshot_digest_out: mutable darray[u8]&, identity_out: mutable darray[u8]&, release: mutable SelectedRelease&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            index: mutable SignedIndex = SignedIndex{versions: [], yanked_flags: []}
            index_status: ResultCode = read_signed_index(access, package, generation_out, snapshot_digest_out, identity_out, &index)
            index_status if index_status != ResultCode.Ok else ResultCode.NoMatchingVersion if not SignedRegistryIndex::contains_version(index.versions, version) else resolve_selected_internal(access, package, version, zero_version(), true, release)

        def resolve_configured_selected(package: darray[u8]&, version: darray[u8]&, release: mutable SelectedRelease&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            access: mutable RegistryAccess = empty_access()
            access_status: ResultCode = configured_registry(&access)
            access_status if access_status != ResultCode.Ok else resolve_selected_internal(access, package, version, zero_version(), false, release)

        # The signed index parser returns one byte per version line. Keep the
        # direct resolver fail-closed if those authenticated views ever stop
        # matching, and never offer a yanked release as a new unpinned choice.
        def resolve_selected_internal(access: RegistryAccess&, package: darray[u8]&, selected: darray[u8]&, previous_version: Model::Version, verify_archive: bool, release: mutable SelectedRelease&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return ResultCode.InvalidConfiguration if not PackageIdentity::valid_name(package) or not PackageIdentity::valid_version(selected)
            metadata_path: mutable darray[u8] = []
            return ResultCode.InvalidConfiguration if not RegistryFiles::join_path_version(access.root, package, selected, &metadata_path)
            ByteText::append_text(&metadata_path, "/metadata.json")
            return ResultCode.MalformedMetadata if not RegistryFiles::read_file(metadata_path, Json::maximum_document_bytes, &release.metadata) or not ReleaseMetadata::valid_document(release.metadata)
            return ResultCode.MalformedMetadata if not ReleaseMetadata::match_identity_fields(release.metadata, access.root, package, selected, &release.archive, &release.digest, &release.archive_size)
            return ResultCode.RollbackDetected if selected_version_below(selected, previous_version)
            ByteText::append(&release.version, selected)
            archive_checked(verify_release_signature(access.key_path, metadata_path, release.metadata), access.root, package, release, verify_archive)

        # Read the detached signature beside the metadata and verify it.
        def verify_release_signature(key_path: darray[u8]&, metadata_path: darray[u8]&, metadata: darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            signature_path: mutable darray[u8] = []
            signature: mutable darray[u8] = []
            expires: mutable u64 = 0
            ResultCode.InvalidConfiguration if not RegistryFiles::sibling_path(metadata_path, "metadata.sig", &signature_path) else ResultCode.MissingSignature if not RegistryFiles::read_file(signature_path, Trust::ed25519_signature_bytes, &signature) else verify_signed_metadata(key_path, metadata, signature, &expires)

        # After a valid signature, verify the archive file when requested.
        def archive_checked(signature_status: ResultCode, root: darray[u8]&, package: darray[u8]&, release: SelectedRelease&, verify_archive: bool) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            signature_status if signature_status != ResultCode.Ok else verify_archive_file(root, package, release.version, release.metadata, release.archive, release.digest, release.archive_size) if verify_archive else ResultCode.Ok

        # Hand a fully verified release to the caller's outputs.
        def published_release(release: SelectedRelease&, version_out: mutable darray[u8]&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, metadata_out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic]:
            ByteText::append(version_out, release.version)
            ByteText::append(metadata_out, release.metadata)
            ByteText::append(archive_out, release.archive)
            ByteText::append(digest_out, release.digest)
            archive_size_out <- release.archive_size
            ResultCode.Ok

        # ---------- signatures and cached snapshots --------------------------------------------

        def read_signature_at(root: darray[u8]&, package: darray[u8]&, version: darray[u8]&, out: mutable darray[u8]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            metadata_path: mutable darray[u8] = []
            ResultCode.InvalidConfiguration if not RegistryFiles::join_path_version(root, package, version, &metadata_path) else ResultCode.MissingSignature if not RegistryFiles::read_file(ByteText::with_text(metadata_path, "/metadata.sig"), Trust::ed25519_signature_bytes, out) or out.count != Trust::ed25519_signature_bytes else ResultCode.Ok

        def verify_snapshot_fields(package: darray[u8]&, version: darray[u8]&, expected_metadata_digest: darray[u8]&, metadata: darray[u8]&, signature: darray[u8]&, snapshot: mutable VerifiedSnapshot&, dependencies_out: mutable darray[Solver::Constraint]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root: mutable darray[u8] = []
            root_status: ResultCode = configured_registry_root(&root)
            root_status if root_status != ResultCode.Ok else ResultCode.MalformedMetadata if not ReleaseMetadata::match_identity_fields(metadata, root, package, version, &snapshot.archive, &snapshot.digest, &snapshot.archive_size) else ResultCode.DigestMismatch if not metadata_digest_matches(metadata, expected_metadata_digest) else verify_snapshot_signature(root, metadata, signature, snapshot, dependencies_out)

        def metadata_digest_matches(metadata: darray[u8]&, expected_metadata_digest: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            metadata_digest: mutable darray[u8] = []
            Integrity::sha256_hex(metadata, &metadata_digest) and ByteText::equal(metadata_digest, expected_metadata_digest)

        def verify_snapshot_signature(root: darray[u8]&, metadata: darray[u8]&, signature: darray[u8]&, snapshot: mutable VerifiedSnapshot&, dependencies_out: mutable darray[Solver::Constraint]&) -> ResultCode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            key_path: mutable darray[u8] = []
            key_status: ResultCode = configuration_result(RegistryConfiguration::configured_trust_root(root, &key_path))
            key_status if key_status != ResultCode.Ok else verified_dependencies(verify_signed_metadata(key_path, metadata, signature, &snapshot.expires), metadata, dependencies_out)

        def verified_dependencies(signature_status: ResultCode, metadata: darray[u8]&, dependencies_out: mutable darray[Solver::Constraint]&) -> ResultCode can[Memory.Allocate, Abort.Panic]:
            signature_status if signature_status != ResultCode.Ok else ResultCode.MalformedMetadata if not ReleaseMetadata::dependencies(metadata, dependencies_out) else ResultCode.Ok

        def published_snapshot(snapshot: VerifiedSnapshot&, archive_out: mutable darray[u8]&, digest_out: mutable darray[u8]&, archive_size_out: mutable u64&, expires_out: mutable u64&) -> ResultCode can[Memory.Allocate, Abort.Panic]:
            ByteText::append(archive_out, snapshot.archive)
            ByteText::append(digest_out, snapshot.digest)
            archive_size_out <- snapshot.archive_size
            expires_out <- snapshot.expires
            ResultCode.Ok

        def verify_archive_payload(package: darray[u8]&, version: darray[u8]&, metadata: darray[u8]&, archive: darray[u8]&, expected_digest: darray[u8]&, expected_size: u64) -> ResultCode can[Memory.Allocate, Abort.Panic]:
            digest: mutable darray[u8] = []
            ResultCode.DigestMismatch if archive.count.u64() != expected_size or not Integrity::sha256_hex(archive, &digest) or not ByteText::equal(digest, expected_digest) else ResultCode.MalformedMetadata if not release_archive_matches_metadata(package, version, metadata, archive) else ResultCode.Ok

        def selected_version_below(version: darray[u8]&, previous: Model::Version) -> bool:
            parsed: mutable Model::Version = Model::Version{major: 0, minor: 0, patch: 0, prerelease: false}
            false if not SemVer::parse(version, &parsed) else SemVer::compare(parsed, previous) < 0

        def checkpoint_store_result(status: CheckpointStore::Code) -> ResultCode:
            match status:
                CheckpointStore::Code.InvalidConfiguration: ResultCode.InvalidConfiguration
                CheckpointStore::Code.ResourceLimit: ResultCode.ResourceLimit
                CheckpointStore::Code.MalformedMetadata: ResultCode.MalformedMetadata
                CheckpointStore::Code.TrustStateUnavailable: ResultCode.TrustStateUnavailable
                CheckpointStore::Code.Ok: ResultCode.Ok
                CheckpointStore::Code.ClockUnavailable: ResultCode.ClockUnavailable
                CheckpointStore::Code.ClockRollback: ResultCode.ClockRollback
                CheckpointStore::Code.TrustStateMalformed: ResultCode.TrustStateMalformed
                CheckpointStore::Code.RollbackDetected: ResultCode.RollbackDetected
                CheckpointStore::Code.TufEquivocationDetected: ResultCode.TufEquivocationDetected

        def rollback_store_result(status: RollbackStore::Code) -> ResultCode:
            match status:
                RollbackStore::Code.Ok: ResultCode.Ok
                RollbackStore::Code.TrustStateUnavailable: ResultCode.TrustStateUnavailable
                RollbackStore::Code.TrustStateMalformed: ResultCode.TrustStateMalformed
                RollbackStore::Code.TrustRootChanged: ResultCode.TrustRootChanged
                RollbackStore::Code.InvalidConfiguration: ResultCode.InvalidConfiguration
                RollbackStore::Code.NotConfigured: ResultCode.NotConfigured
                RollbackStore::Code.ClockRollback: ResultCode.ClockRollback
                RollbackStore::Code.RollbackDetected: ResultCode.RollbackDetected
                RollbackStore::Code.DigestMismatch: ResultCode.DigestMismatch
                RollbackStore::Code.ExpiredMetadata: ResultCode.ExpiredMetadata
                RollbackStore::Code.ExpiryHorizon: ResultCode.ExpiryHorizon
                RollbackStore::Code.MissingTrustRoot: ResultCode.MissingTrustRoot

        def configuration_result(status: RegistryConfiguration::Code) -> ResultCode:
            match status:
                RegistryConfiguration::Code.InvalidConfiguration: ResultCode.InvalidConfiguration
                RegistryConfiguration::Code.MissingTrustRoot: ResultCode.MissingTrustRoot
                RegistryConfiguration::Code.Ok: ResultCode.Ok
                RegistryConfiguration::Code.TrustStateUnavailable: ResultCode.TrustStateUnavailable

        def index_result(status: SignedRegistryIndex::Code) -> ResultCode:
            match status:
                SignedRegistryIndex::Code.InvalidConfiguration: ResultCode.InvalidConfiguration
                SignedRegistryIndex::Code.MissingIndex: ResultCode.MissingIndex
                SignedRegistryIndex::Code.ResourceLimit: ResultCode.ResourceLimit
                SignedRegistryIndex::Code.MalformedMetadata: ResultCode.MalformedMetadata
                SignedRegistryIndex::Code.MissingSignature: ResultCode.MissingSignature
                SignedRegistryIndex::Code.MissingTrustRoot: ResultCode.MissingTrustRoot
                SignedRegistryIndex::Code.TrustStateUnavailable: ResultCode.TrustStateUnavailable
                SignedRegistryIndex::Code.Ok: ResultCode.Ok
                SignedRegistryIndex::Code.InvalidSignature: ResultCode.InvalidSignature
                SignedRegistryIndex::Code.ClockUnavailable: ResultCode.ClockUnavailable
                SignedRegistryIndex::Code.TrustStateMalformed: ResultCode.TrustStateMalformed
                SignedRegistryIndex::Code.TrustRootChanged: ResultCode.TrustRootChanged
                SignedRegistryIndex::Code.NotConfigured: ResultCode.NotConfigured
                SignedRegistryIndex::Code.ClockRollback: ResultCode.ClockRollback
                SignedRegistryIndex::Code.RollbackDetected: ResultCode.RollbackDetected
                SignedRegistryIndex::Code.DigestMismatch: ResultCode.DigestMismatch
                SignedRegistryIndex::Code.ExpiredMetadata: ResultCode.ExpiredMetadata
                SignedRegistryIndex::Code.ExpiryHorizon: ResultCode.ExpiryHorizon
