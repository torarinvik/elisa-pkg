# Safe source-fragment emission for the Elisa compiler adapter.
#
# Build owns the syntax boundary for generated aggregate source. Callers pass
# one absolute source path and receive a single include directive only after
# the path has been validated as safe to place inside a quoted source literal.

module Build:
    public:
        # An empty project root means the current working directory.
        def output_directory(project_root: darray[u8]&, release: bool) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            path: mutable darray[u8] = []
            for index in 0..<project_root.count |path, project_root|:
                path <- path.push(project_root[index])
            if project_root.count > 0.usize() and project_root[project_root.count - 1.usize()] != 47:
                path <- path.push(47)
            ByteText::append_text(&path, ".elisapkg/build/release" if release else ".elisapkg/build")
            path

        def append_include_path(path: darray[u8]&, output: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not build_valid_include_path(path, path.count)
            ByteText::append_text(output, "include \"")
            ByteText::append(output, path)
            ByteText::append_text(output, "\"\n")
            true

    private:
        const maximum_include_path_bytes: usize = 4096

        def build_valid_include_path(path: darray[u8]&, path_length: usize) -> bool:
            return false if:
                path_length == 0.usize() or path_length > maximum_include_path_bytes
                path[0] != 47
            for index in 0..<path_length |path|:
                byte: u8 = path[index]
                return false if:
                    byte < 32 or byte == 127
                    byte == 34 or byte == 92
            true
