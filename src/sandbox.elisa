# Compile-time isolation policy for package builds.
#
# Policy construction lives in Elisa. The macOS enforcement frontend is an
# explicitly temporary Seatbelt adapter; unsupported platforms fail closed.
include "./platform.elisa"
include "./text/bytes.elisa"

module Sandbox:
    public:
        def build_sandbox_available() -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            static if ELISA_TARGET_OS_MACOS:
                return Platform::pkg_access("/usr/bin/sandbox-exec", 1) == 0
            return false

        def darwin_build_profile(home: cstr, project_root: darray[u8]&, build_root: darray[u8]&,
                                 source_snapshot_root: darray[u8]&, dependency_roots: darray[u8]&, tool_paths: darray[cstr]&,
                                 executable_paths: darray[cstr]&, output_temp: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            static if not ELISA_TARGET_OS_MACOS:
                return []
            home_real: mutable darray[u8] = []
            project_real: mutable darray[u8] = []
            build_real: mutable darray[u8] = []
            snapshot_real: mutable darray[u8] = []
            if not canonical_path(home, &home_real):
                return []
            if not canonical_path_array(project_root, &project_real):
                return []
            if not canonical_path_array(build_root, &build_real):
                return []
            if not canonical_path_array(source_snapshot_root, &snapshot_real):
                return []
            return [] if not absolute_path(home_real) or not absolute_path(project_real) or not absolute_path(build_real) or not absolute_path(snapshot_real)
            # Source snapshots are a distinct read-only input boundary. If one
            # aliases writable compiler scratch, the later scratch exception
            # would silently turn verified inputs into mutable compiler state.
            return [] if:
                path_is_same_or_ancestor(build_real, snapshot_real) or path_is_same_or_ancestor(snapshot_real, build_real)
                Platform::pkg_strlen(output_temp) == 0.usize()

            tool_roots: mutable darray[u8] = []
            for index in 0..<tool_paths.count |tool_paths, tool_roots|:
                return [] if not add_toolchain_root(tool_paths[index], home_real, &tool_roots)

            system_roots: mutable darray[u8] = []
            add_existing_root("/System", &system_roots)
            add_existing_root("/usr", &system_roots)
            add_existing_root("/bin", &system_roots)
            add_existing_root("/sbin", &system_roots)
            add_existing_root("/Library/Developer/CommandLineTools", &system_roots)
            add_existing_root("/Applications/Xcode.app", &system_roots)

            extra_read_roots: mutable darray[u8] = []
            add_existing_root("/private/var/db/dyld", &extra_read_roots)
            add_existing_root("/var/select", &extra_read_roots)

            profile: mutable darray[u8] = []
            ByteText::append_text(&profile, "(version 1)\n(deny default)\n(deny network*)\n")
            ByteText::append_text(&profile, "(allow process-fork)\n(allow process-info* (target self))\n(allow signal (target self))\n")
            # Some system utilities query the filesystem root as a directory
            # object during startup; granting the literal path does not expose
            # files beneath it.
            ByteText::append_text(&profile, "(allow file-read* (literal \"/\"))\n")

            # Host runtime and SDK files are read-only. Executable access is
            # granted later to specific compiler helpers rather than to every
            # binary below these roots.
            return [] if not append_read_roots(&profile, system_roots)
            return [] if not append_read_roots(&profile, extra_read_roots)
            return [] if not append_read_alias_root(&profile, "/var/select")
            ByteText::append_text(&profile, "(allow file-read-metadata (path-ancestors \"/dev\"))\n")
            ByteText::append_text(&profile, "(allow file-read* (literal \"/dev/null\"))\n(allow file-read* (literal \"/dev/zero\"))\n(allow file-read* (literal \"/dev/random\"))\n(allow file-read* (literal \"/dev/urandom\"))\n(allow file-write* (literal \"/dev/null\"))\n")

            # Toolchain files are user-selected compiler inputs, while package
            # sources are data. Neither grants write access. Only the latter
            # may be read from project directories.
            return [] if not append_read_roots(&profile, tool_roots)
            # Homebrew's opt prefix is a symlink to the versioned Cellar
            # directory. dyld consults the install-name spelling, so preserve
            # the narrow LLVM library alias as well as the canonical tool root.
            return [] if:
                not append_selected_llvm_rules(&profile, tool_paths, home_real, "/opt/homebrew", "/opt/homebrew/opt/llvm/bin/clang", "/opt/homebrew/opt/llvm/lib")
                not append_selected_llvm_rules(&profile, tool_paths, home_real, "/usr/local", "/usr/local/opt/llvm/bin/clang", "/usr/local/opt/llvm/lib")
            return [] if not append_read_root(&profile, project_real)
            return [] if not append_dependency_rules(&profile, dependency_roots, DependencyRule.AllowRead)

            return [] if:
                not append_subpath_rule(&profile, "allow", "file-read*", "subpath", build_real)
                not append_subpath_rule(&profile, "allow", "file-write*", "subpath", build_real)

            # Explicit denials are placed after broad runtime roots. Narrow
            # project/toolchain/build exceptions are then re-added below.
            return [] if:
                not append_subpath_rule(&profile, "deny", "file-read*", "subpath", home_real)
                not append_subpath_rule(&profile, "deny", "file-write*", "subpath", home_real)
                not append_subpath_rule(&profile, "deny", "process-exec", "subpath", home_real)
                not append_subpath_rule(&profile, "deny", "file-map-executable", "subpath", home_real)
            # `/usr` is a system root, but `/usr/local` is commonly writable
            # by the invoking user (including Intel Homebrew). Do not inherit
            # that entire prefix as a compiler-readable system directory.
            # Selected toolchain files and recognized LLVM roots are granted
            # back individually after this denial.
            ByteText::append_text(&profile, "(deny file-read* (subpath \"/usr/local\"))\n")
            ByteText::append_text(&profile, "(deny file-read* (subpath \"/private/tmp\"))\n(deny file-write* (subpath \"/private/tmp\"))\n")

            return [] if not append_read_root(&profile, project_real)
            return [] if not append_dependency_rules(&profile, dependency_roots, DependencyRule.AllowRead)
            return [] if not append_read_roots(&profile, tool_roots)
            for index in 0..<tool_paths.count |tool_paths, profile|:
                return [] if not append_tool_file_read(&profile, tool_paths[index])
            return [] if not append_selected_llvm_rules(&profile, tool_paths, home_real, "/usr/local", "/usr/local/opt/llvm/bin/clang", "/usr/local/opt/llvm/lib")
            for index in 0..<tool_paths.count |tool_paths, profile|:
                return [] if not append_toolchain_library_root(&profile, tool_paths[index], home_real)

            # The compiler consumes only copied, verified package sources. The
            # live project and dependency trees stay unreadable for the child,
            # closing edit/restore races and absolute-include escapes back to
            # mutable checkout paths. Tool roots were allowed above; these
            # later denials still apply when a tool lives inside a source tree.
            # This keeps a selected tool exception from reopening package data.
            return [] if not append_subpath_rule(&profile, "deny", "file-read*", "subpath", project_real)
            return [] if not append_dependency_rules(&profile, dependency_roots, DependencyRule.DenyRead)
            # The compiler's controlled linker path uses these exact host
            # utilities. Allow their exact paths so it cannot execute
            # unrelated programs simply because they share /usr/bin.
            return [] if:
                not append_executable_path(&profile, "/usr/bin/env")
                not append_executable_path(&profile, "/bin/sh")
                not append_executable_path(&profile, "/bin/bash")
                not append_executable_path(&profile, "/usr/bin/ld")
                not append_executable_path(&profile, "/usr/bin/as")
            # Apple's linker queries the selected Xcode installation through
            # this exact helper on macOS. Keep execution to the fixed system
            # path; the rest of the Xcode tree is only a read-only tool root.
            return [] if not append_executable_path(&profile, "/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild")

            # The selected compiler and bootstrap binary can be individual
            # files anywhere on disk. Their exact paths are the only
            # toolchain execution exceptions; toolchain roots remain read-only.
            for index in 0..<executable_paths.count |executable_paths, profile|:
                return [] if not append_executable_path(&profile, executable_paths[index])

            # These directories are excluded from the source fingerprint, so
            # they must not become compiler inputs through an include directive.
            # The exact private scratch directory is reallowed below.
            return [] if not append_source_state_denials(&profile, project_real)
            return [] if not append_dependency_rules(&profile, dependency_roots, DependencyRule.DenySourceState)

            # The snapshot root is intentionally beneath reserved build state,
            # so grant its exact read boundary after those denials. Keep this
            # exception before the credential matcher; credential-like names
            # inside a malformed snapshot remain denied.
            return [] if:
                not append_read_root(&profile, snapshot_real)
                not append_source_state_denials(&profile, snapshot_real)
                not append_subpath_rule(&profile, "deny", "file-write*", "subpath", snapshot_real)

            # Common credentials and private build state are not source inputs.
            # Tool and scratch exceptions stay narrow; retain
            # these denials after those exceptions to keep obvious secret files
            # outside the compiler's view.
            ByteText::append_text(&profile, "(deny file-read* (regex #\"^.*/(\\.[eE][nN][vV][^/]*|[^/]*\\.[eE][nN][vV]|\\.[nN][eE][tT][rR][cC]|\\.[sS][sS][hH]|\\.[aA][wW][sS]|\\.[gG][nN][uU][pP][gG]|\\.[kK][uU][bB][eE]|\\.[dD][oO][cC][kK][eE][rR]|\\.[aA][zZ][uU][rR][eE]|\\.[tT][eE][rR][rR][aA][fF][oO][rR][mM](\\.[dD])?|\\.[cC][oO][nN][fF][iI][gG]/([gG][cC][lL][oO][uU][dD]|[gG][hH]|[rR][cC][lL][oO][nN][eE])|\\.[nN][pP][mM][rR][cC]|\\.[pP][yY][pP][iI][rR][cC]|\\.[gG][iI][tT]|\\.[hH][gG]|\\.[sS][vV][nN]|[iI][mM][pP][lL][eE][mM][eE][nN][tT][aA][tT][iI][oO][nN]_[pP][lL][aA][nN]\\.[mM][dD]|\\.[gG][iI][tT]-[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]|[iI][dD]_([rR][sS][aA]|[eE][dD]25519|[eE][cC][dD][sS][aA]|[dD][sS][aA])|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS][^/]*|[^/]*\\.[pP][eE][mM][^/]*|[^/]*\\.[kK][eE][yY][^/]*|[^/]*\\.[pP]12|[^/]*\\.[pP][fF][xX]|[^/]*\\.[pP]8|[^/]*\\.[jJ][kK][sS]|[^/]*\\.[kK][eE][yY][sS][tT][oO][rR][eE])($|/.*)$\"))\n")

            return [] if:
                not append_subpath_rule(&profile, "allow", "file-read*", "subpath", build_real)
                not append_subpath_rule(&profile, "allow", "file-write*", "subpath", build_real)
            output_real: mutable darray[u8] = []
            return [] if:
                not canonical_path(output_temp, &output_real) or not absolute_path(output_real)
                output_real.count <= build_real.count or not path_is_same_or_ancestor(build_real, output_real)
            # The stage1 linker emits one fixed-name C fallback under /tmp.
            # The child pre-creates it with O_EXCL before entering Seatbelt. The
            # sandbox may then truncate/write that existing inode and let clang
            # read it, but cannot create, chmod, rename, or unlink the host path.
            ByteText::append_text(&profile, "(allow file-read-metadata (path-ancestors \"/tmp\"))\n(allow file-read-metadata (literal \"/tmp\"))\n")
            ByteText::append_text(&profile, "(allow file-read-metadata (path-ancestors (param \"CALLBACK_PATH\")))\n")
            ByteText::append_text(&profile, "(allow file-read* (literal (param \"CALLBACK_PATH\")))\n")
            ByteText::append_text(&profile, "(allow file-write-data (literal (param \"CALLBACK_PATH\")))\n")
            return [] if profile.count > 65536.usize()
            return profile

    private:
        def append_read_roots(profile: mutable darray[u8]&, roots: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            cursor: mutable usize = 0
            while cursor < roots.count |roots, cursor, profile|:
                root: mutable darray[u8] = []
                return false if:
                    not next_root(roots, &cursor, &root)
                    not append_read_root(profile, root)
            return true

        const enum DependencyRule of u8:
            AllowRead
            DenyRead
            DenySourceState

        def append_dependency_rules(profile: mutable darray[u8]&, dependency_roots: darray[u8]&, rule: DependencyRule) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            cursor: mutable usize = 0
            while cursor < dependency_roots.count |dependency_roots, cursor, profile, rule|:
                dependency_path: mutable darray[u8] = []
                dependency_real: mutable darray[u8] = []
                return false if:
                    not next_root(dependency_roots, &cursor, &dependency_path)
                    not canonical_path_array(dependency_path, &dependency_real)
                if rule == DependencyRule.AllowRead:
                    return false if not append_read_root(profile, dependency_real)
                elif rule == DependencyRule.DenyRead:
                    return false if not append_subpath_rule(profile, "deny", "file-read*", "subpath", dependency_real)
                else:
                    return false if not append_source_state_denials(profile, dependency_real)
            return true

        def append_source_state_denials(out: mutable darray[u8]&, root: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            for index in 0..<3.usize() |out, root, index|:
                path: mutable darray[u8] = []
                ByteText::append(&path, root)
                if path.count == 0.usize() or path[path.count - 1.usize()] != 47:
                    path <- path.push(47)
                if index == 0.usize():
                    ByteText::append_text(&path, ".elisapkg")
                elif index == 1.usize():
                    ByteText::append_text(&path, "build")
                else:
                    ByteText::append_text(&path, "target")
                return false if not append_subpath_rule(out, "deny", "file-read*", "subpath", path)
            return false if not append_source_state_casefold_denial(out, root)
            return true

        def append_source_state_casefold_denial(out: mutable darray[u8]&, root: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(out, "(deny file-read* (regex #\"^")
            return false if not append_regex_literal_path(out, root)
            if root.count == 0.usize() or root[root.count - 1.usize()] != 47:
                out.push(47)
            ByteText::append_text(out, "(\\.[eE][lL][iI][sS][aA][pP][kK][gG]|[bB][uU][iI][lL][dD]|[tT][aA][rR][gG][eE][tT])($|/.*)$\"))\n")
            return true

        def append_regex_literal_path(out: mutable darray[u8]&, path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not absolute_path(path) or path.count > 4096.usize()
            for index in 0..<path.count |out, path, index|:
                byte: u8 = path[index]
                return false if byte == 0 or byte < 32 or byte == 127 or byte == 34 or byte == 92
                if byte == 46 or byte == 94 or byte == 36 or byte == 42 or byte == 43 or byte == 63 or byte == 40 or byte == 41 or byte == 91 or byte == 93 or byte == 123 or byte == 125 or byte == 124:
                    out.push(92)
                out.push(byte)
            return true

        def absolute_path(value: darray[u8]&) -> bool:
            return value.count > 0.usize() and value[0] == 47

        def canonical_path(path: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            out.resize(0)
            resolved: mutable darray[u8] = []
            resolved.resize(4096)
            if Platform::pkg_realpath(path, &resolved) is canonical:
                length: usize = Platform::pkg_strlen(canonical)
                return false if length == 0.usize() or length >= 4096.usize()
                for index in 0..<length |out, canonical|:
                    out.push(canonical[index].u8())
                return true
            else:
                return false

        def canonical_path_array(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_c: mutable darray[u8] = []
            ByteText::append(&path_c, path)
            path_c <- path_c.push(0)
            path_name: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
            return canonical_path(path_name, out)

        def add_existing_root(path: cstr, roots: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root: mutable darray[u8] = []
            if canonical_path(path, &root):
                append_root(roots, root)

        def path_contains_slash(path: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            length: usize = Platform::pkg_strlen(path)
            for index in 0..<length |path|:
                return true if path[index].u8() == 47
            return false

        def append_tool_file_read(out: mutable darray[u8]&, path: cstr) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return true if Platform::pkg_strlen(path) == 0.usize() or not path_contains_slash(path)
            canonical: mutable darray[u8] = []
            return false if not canonical_path(path, &canonical)
            path_bytes: mutable darray[u8] = []
            ByteText::append_text(&path_bytes, path)
            if absolute_path(path_bytes) and not ByteText::equal(path_bytes, canonical):
                return false if not append_literal_rule(out, "file-read*", path_bytes)
            return append_literal_rule(out, "file-read*", canonical)

        def parent_directory(path: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if not absolute_path(path)
            cursor: mutable usize = path.count
            while cursor > 1.usize() and path[cursor - 1.usize()] != 47 |path, cursor|:
                cursor <- cursor - 1.usize()
            return false if cursor <= 1.usize()
            for index in 0..<(cursor - 1.usize()) |out, path|:
                out.push(path[index])
            return true

        def leaf_is(path: darray[u8]&, wanted: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            start: mutable usize = path.count
            while start > 0.usize() and path[start - 1.usize()] != 47 |path, start|:
                start <- start - 1.usize()
            length: usize = Platform::pkg_strlen(wanted)
            return false if path.count - start != length
            for index in 0..<length |path, wanted, start|:
                return false if path[start + index] != wanted[index].u8()
            return true

        def append_root(roots: mutable darray[u8]&, path: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            return if not absolute_path(path)
            cursor: mutable usize = 0.usize()
            while cursor < roots.count |roots, path, cursor|:
                current: mutable darray[u8] = []
                return if:
                    not next_root(roots, &cursor, &current)
                    ByteText::equal(current, path)
            ByteText::append(roots, path)
            roots.push(0)

        def next_root(roots: darray[u8]&, cursor: mutable usize&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            out.resize(0)
            return false if cursor >= roots.count
            finish: mutable usize = cursor
            while finish < roots.count and roots[finish] != 0 |roots, finish|:
                finish <- finish + 1.usize()
            return false if finish == cursor or finish >= roots.count
            while cursor < finish |roots, cursor, out|:
                out.push(roots[cursor])
                cursor <- cursor + 1.usize()
            cursor <- cursor + 1.usize()
            return true

        def add_toolchain_root(path: cstr, home: darray[u8]&, roots: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return true if Platform::pkg_strlen(path) == 0.usize()
            canonical: mutable darray[u8] = []
            if not canonical_path(path, &canonical):
                return true if not path_contains_slash(path)
                return false
            directory: mutable darray[u8] = []
            return false if not parent_directory(canonical, &directory)
            # Read the containing directory by default. Expand one level only
            # for a recognized tool in its standard compiler/LLVM layout, and
            # never grant HOME itself or one of its ancestors as a tool root.
            root: mutable darray[u8] = []
            ByteText::append(&root, directory)
            if leaf_is(directory, "bin") and (leaf_is(canonical, "elisac-stage1") or leaf_is_clang_tool(canonical)):
                candidate: mutable darray[u8] = []
                if parent_directory(directory, &candidate) and not path_is_same_or_ancestor(candidate, home) and not is_usr_local_root(candidate):
                    root <- candidate
            elif leaf_is(directory, "scripts") and leaf_is(canonical, "elisac_stage1.sh"):
                candidate: mutable darray[u8] = []
                if parent_directory(directory, &candidate) and not path_is_same_or_ancestor(candidate, home) and not is_usr_local_root(candidate):
                    root <- candidate
            return true if path_is_same_or_ancestor(root, home)
            return true if is_usr_local_root(root)
            append_root(roots, root)
            return true

        def is_usr_local_root(path: darray[u8]&) -> bool:
            return false if path.count != 10.usize()
            expected: cstr = "/usr/local"
            for index in 0..<10.usize() |path, expected|:
                return false if path[index] != expected[index].u8()
            return true

        def append_toolchain_library_root(out: mutable darray[u8]&, path: cstr, home: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            canonical: mutable darray[u8] = []
            return true if not canonical_path(path, &canonical) or not leaf_is_clang_tool(canonical)
            binary_directory: mutable darray[u8] = []
            return true if not parent_directory(canonical, &binary_directory) or not leaf_is(binary_directory, "bin")
            toolchain_root: mutable darray[u8] = []
            return true if not parent_directory(binary_directory, &toolchain_root)
            return true if path_is_same_or_ancestor(toolchain_root, home)
            library_path: mutable darray[u8] = []
            ByteText::append(&library_path, toolchain_root)
            ByteText::append_text(&library_path, "/lib")
            library_path <- library_path.push(0)
            library_name: cstr = (&library_path[0]).cast[cstr] can Unsafe.PointerCast
            library_real: mutable darray[u8] = []
            return true if not canonical_path(library_name, &library_real)
            return append_read_root(out, library_real)

        def leaf_is_clang_tool(path: darray[u8]&) -> bool:
            return true if leaf_is(path, "clang")
            leaf_start: mutable usize = path.count
            while leaf_start > 0.usize() and path[leaf_start - 1.usize()] != 47 |path, leaf_start|:
                leaf_start <- leaf_start - 1.usize()
            leaf_length: usize = path.count - leaf_start
            return false if:
                leaf_length <= 6.usize()
                path[leaf_start] != 99 or path[leaf_start + 1.usize()] != 108 or path[leaf_start + 2.usize()] != 97 or path[leaf_start + 3.usize()] != 110 or path[leaf_start + 4.usize()] != 103 or path[leaf_start + 5.usize()] != 45
            for index in (leaf_start + 6.usize())..<path.count |path|:
                byte: u8 = path[index]
                return false if (byte < 48 or byte > 57) and byte != 46
            return true

        def tool_path_is_selected(paths: darray[cstr]&, canonical: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            for index in 0..<paths.count |paths, canonical|:
                candidate: mutable darray[u8] = []
                if canonical_path(paths[index], &candidate) and ByteText::equal(candidate, canonical):
                    return true
            return false

        def path_is_same_or_ancestor(parent: darray[u8]&, child: darray[u8]&) -> bool:
            return false if parent.count == 0.usize() or parent.count > child.count
            for index in 0..<parent.count |parent, child|:
                return false if parent[index] != child[index]
            return true if parent.count == child.count
            return true if parent.count == 1.usize() and parent[0] == 47
            return child[parent.count] == 47

        def append_executable_path(out: mutable darray[u8]&, path: cstr) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return true if Platform::pkg_strlen(path) == 0.usize()
            path_bytes: mutable darray[u8] = []
            ByteText::append_text(&path_bytes, path)
            if not absolute_path(path_bytes):
                return true if not path_contains_slash(path)
                return false
            return false if:
                not append_literal_rule(out, "file-read*", path_bytes)
                not append_literal_rule(out, "process-exec", path_bytes)
                not append_literal_rule(out, "file-map-executable", path_bytes)
            canonical: mutable darray[u8] = []
            if canonical_path(path, &canonical) and not ByteText::equal(path_bytes, canonical):
                return false if:
                    not append_literal_rule(out, "file-read*", canonical)
                    not append_literal_rule(out, "process-exec", canonical)
                    not append_literal_rule(out, "file-map-executable", canonical)
            return true

        def append_quoted_path(out: mutable darray[u8]&, path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not absolute_path(path)
            out.push(34)
            for index in 0..<path.count |out, path|:
                byte: u8 = path[index]
                return false if byte == 0 or byte < 32 or byte == 127
                if byte == 34 or byte == 92:
                    out.push(92)
                out.push(byte)
            out.push(34)
            return true

        def append_subpath_rule(out: mutable darray[u8]&, action: cstr, operation: cstr, predicate: cstr, path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(out, "(")
            ByteText::append_text(out, action)
            ByteText::append_text(out, " ")
            ByteText::append_text(out, operation)
            ByteText::append_text(out, " (")
            ByteText::append_text(out, predicate)
            ByteText::append_text(out, " ")
            return false if not append_quoted_path(out, path)
            ByteText::append_text(out, "))\n")
            return true

        def append_read_root(out: mutable darray[u8]&, root: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if:
                not append_subpath_rule(out, "allow", "file-read*", "subpath", root)
                not append_subpath_rule(out, "allow", "file-read-metadata", "path-ancestors", root)
            return true

        def append_read_alias_root(out: mutable darray[u8]&, root_name: cstr) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            root: mutable darray[u8] = []
            ByteText::append_text(&root, root_name)
            return false if:
                not absolute_path(root)
                not append_subpath_rule(out, "allow", "file-read*", "subpath", root)
                not append_subpath_rule(out, "allow", "file-read-metadata", "path-ancestors", root)
            return true

        def append_selected_llvm_rules(profile: mutable darray[u8]&, tool_paths: darray[cstr]&, home: darray[u8]&, prefix: cstr, clang_path: cstr, library_alias: cstr) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            clang: mutable darray[u8] = []
            return true if:
                not canonical_path(clang_path, &clang)
                not tool_path_is_selected(tool_paths, clang)
            return append_read_alias_root(profile, library_alias) and append_homebrew_llvm_dependency(profile, prefix, "z3", home) and append_homebrew_llvm_dependency(profile, prefix, "zstd", home)

        def append_homebrew_llvm_dependency(out: mutable darray[u8]&, prefix: cstr, formula: cstr,
                                           home: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            alias: mutable darray[u8] = []
            ByteText::append_text(&alias, prefix)
            ByteText::append_text(&alias, "/opt/")
            ByteText::append_text(&alias, formula)
            ByteText::append_text(&alias, "/lib")
            alias <- alias.push(0)
            alias_name: cstr = (&alias[0]).cast[cstr] can Unsafe.PointerCast
            canonical: mutable darray[u8] = []
            return true if not canonical_path(alias_name, &canonical)
            return true if path_is_same_or_ancestor(canonical, home) or path_is_same_or_ancestor(home, canonical)
            return false if not append_read_root(out, canonical)
            return append_read_alias_root(out, alias_name)

        def append_literal_rule(out: mutable darray[u8]&, operation: cstr, path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            ByteText::append_text(out, "(allow ")
            ByteText::append_text(out, operation)
            ByteText::append_text(out, " (literal ")
            return false if not append_quoted_path(out, path)
            ByteText::append_text(out, "))\n")
            return true
