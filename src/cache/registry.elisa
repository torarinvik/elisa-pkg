# Persist content-addressed registry archives, signed metadata, and receipts.
include "../archive.elisa"
include "../cache.elisa"
include "../integrity.elisa"
include "../json.elisa"
include "../platform.elisa"
include "../project/files.elisa"
include "../text/bytes.elisa"
include "../trust.elisa"

module RegistryCache:
    public:
        def store_archive(digest: darray[u8]&, content: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            false if not Archive::verify_ustar_archive(content) else store_verified_bytes(digest, content)

        # Store metadata and its detached signature after registry authentication.
        def store_metadata(metadata_digest: darray[u8]&, metadata: darray[u8]&, signature: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            return false if not:
                metadata.count > 0.usize()
                metadata.count <= Json::maximum_document_bytes
                signature.count == Trust::ed25519_signature_bytes
                store_verified_bytes(metadata_digest, metadata)
            signature_path: mutable darray[u8] = []
            existing: mutable darray[u8] = []
            if not Cache::registry_signature_path(metadata_digest, &signature_path):
                false
            else:
                publication_status: i64 =
                    signature_c: darray[u8] = ProjectFiles::with_null_terminator(&signature_path)
                    0 if ProjectFiles::c_string_file_exists((&signature_c[0]).cast[cstr] can Unsafe.PointerCast) else ProjectFiles::publish_file_exclusively(signature_path, signature)
                # A concurrent publication (EEXIST) is acceptable only if the final
                # detached signature is the same one we intended to store.
                (publication_status == 0 or publication_status == -17) and Cache::read_registry_signature(metadata_digest, &existing) and ByteText::equal(existing, signature)

        def read_metadata(metadata_digest: darray[u8]&, metadata_out: mutable darray[u8]&, signature_out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if Cache::read_verified_blob(metadata_digest, Json::maximum_document_bytes, metadata_out) and Cache::read_registry_signature(metadata_digest, signature_out):
                true
            else:
                metadata_out.resize(0)
                signature_out.resize(0)
                false

        def store_receipt(package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, archive_size: u64, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            path: mutable darray[u8] = []
            parent: mutable darray[u8] = []
            existing: mutable darray[u8] = []
            if not Cache::registry_receipt_path(digest, metadata_digest, &path) or not Cache::shard_path(digest, &parent) or not ProjectFiles::make_directory(&parent):
                false
            else:
                receipt: darray[u8] = Cache::encode_registry_receipt(package, version, archive, archive_size, digest, metadata_digest, expires)
                if receipt.count == 0.usize():
                    false
                else:
                    publication_status: i64 =
                        path_c: darray[u8] = ProjectFiles::with_null_terminator(&path)
                        0 if ProjectFiles::c_string_file_exists((&path_c[0]).cast[cstr] can Unsafe.PointerCast) else ProjectFiles::publish_file_exclusively(path, receipt)
                    (publication_status == 0 or publication_status == -17) and Cache::read_registry_receipt(digest, metadata_digest, &existing) and ByteText::equal(existing, receipt)

    private:
        def store_verified_bytes(digest: darray[u8]&, content: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            # Cache publication is content-addressed and immutable. Verify the bytes
            # before creating any cache entry, then revalidate the final pathname after
            # the exclusive link so a concurrent writer or replacement cannot turn a
            # successful fetch into an unverified cache hit.
            actual: mutable darray[u8] = []
            blob_path: mutable darray[u8] = []
            cache_parent: mutable darray[u8] = []
            quarantine_parent: mutable darray[u8] = []
            ByteText::append_text(&quarantine_parent, Cache::quarantine_directory)
            if not Integrity::sha256_hex(content, &actual) or not ByteText::equal(actual, digest) or not Cache::blob_path(digest, &blob_path) or not Cache::shard_path(digest, &cache_parent) or not ProjectFiles::make_directory(&cache_parent):
                false
            else:
                blob_exists: bool =
                    blob_name: darray[u8] = ProjectFiles::with_null_terminator(&blob_path)
                    ProjectFiles::c_string_file_exists((&blob_name[0]).cast[cstr] can Unsafe.PointerCast)
                if blob_exists and Cache::verify_blob(digest):
                    true
                elif blob_exists and (not ProjectFiles::make_directory(&quarantine_parent) or not Cache::quarantine_blob(digest)):
                    # An existing blob that fails verification is moved aside first.
                    false
                else:
                    publication_status: i64 = ProjectFiles::publish_file_exclusively(blob_path, content)
                    (publication_status == 0 or publication_status == -17) and Cache::verify_blob(digest)
