# Encode and match the versioned registry cache receipt.

include "../text/bytes.elisa"

extend Cache:
    public:
        const maximum_registry_receipt_bytes: usize = 2048.usize()

        def encode_registry_receipt(package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, archive_size: u64, digest: darray[u8]&, metadata_digest: darray[u8]&, expires: u64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            receipt: mutable darray[u8] = ByteText::with_decimal(registry_receipt_prefix(package, version, archive, archive_size, digest, metadata_digest), expires)
            receipt <- receipt.push(10)
            [] if receipt.count > maximum_registry_receipt_bytes else receipt

        def registry_receipt_matches(receipt: darray[u8]&, package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, archive_size: u64, digest: darray[u8]&, metadata_digest: darray[u8]&, expires_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            expires_out <- 0
            return false if receipt.count == 0.usize() or receipt.count > maximum_registry_receipt_bytes
            prefix: darray[u8] = registry_receipt_prefix(package, version, archive, archive_size, digest, metadata_digest)
            return false if not ByteText::starts_with(receipt, prefix)
            # The writer emits one to twenty decimal digits and one LF.
            return false if receipt.count - prefix.count < 2.usize() or receipt[receipt.count - 1.usize()] != 10
            finish: usize = receipt.count - 1.usize()
            ByteText::parse_canonical_unsigned_decimal(receipt, prefix.count, finish, expires_out)

    private:
        def registry_receipt_prefix(package: darray[u8]&, version: darray[u8]&, archive: darray[u8]&, archive_size: u64, digest: darray[u8]&, metadata_digest: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            prefix: mutable darray[u8] = ByteText::with_text([], "elisapkg-registry-cache:1\nregistry:primary\nname:")
            prefix <- ByteText::with_text(ByteText::with_bytes(prefix, package), "\nversion:")
            prefix <- ByteText::with_text(ByteText::with_bytes(prefix, version), "\narchive:")
            prefix <- ByteText::with_text(ByteText::with_bytes(prefix, archive), "\narchive-size:")
            prefix <- ByteText::with_text(ByteText::with_decimal(prefix, archive_size), "\narchive-digest:sha256:")
            prefix <- ByteText::with_text(ByteText::with_bytes(prefix, digest), "\nmetadata-digest:sha256:")
            ByteText::with_text(ByteText::with_bytes(prefix, metadata_digest), "\nexpires:")
