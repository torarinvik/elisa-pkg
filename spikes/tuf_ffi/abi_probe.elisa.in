extern native_tuf_engine_get_snapshot_pin_v1(trusted_root: void&, trusted_root_len: usize, timestamp: void&, timestamp_len: usize, snapshot: void&, snapshot_len: usize, metadata_name: void&, metadata_name_len: usize, now_unix_seconds: i64, now_nanoseconds: u32, out_version: mutable u64&, out_length: mutable u64&, out_sha256: mutable void&) -> i32
