extern native_tuf_engine_verify_package_target_v1(trusted_root: void&, trusted_root_len: usize, timestamp: void&, timestamp_len: usize, snapshot: void&, snapshot_len: usize, targets: void&, targets_len: usize, delegated_targets: void&, delegated_targets_len: usize, package_name: void&, package_name_len: usize, registry_identity: void&, registry_identity_len: usize, target_path: void&, target_path_len: usize, now_unix_seconds: i64, now_nanoseconds: u32, out_delegated_targets_version: mutable u64&, out_target_length: mutable u64&, out_target_sha256: mutable void&, out_release_status: mutable u8&) -> i32

module TufEngine:
    public:
        const enum Status of i32:
            Ok
            InvalidArgument
            InvalidRoot
            UnsupportedSpec
            InternalPanic
            ExpiredRoot
            InvalidMetadata
            ExpiredMetadata
            UnsupportedAlgorithm
            RevokedTarget

        const enum ReleaseStatus of u8:
            Published
            Yanked

        def abi_version() -> u32:
            return native_tuf_engine_abi_version_v1()

        def verify_root(metadata: darray[u8]&, version: mutable u64&, key_count: mutable u32&, root_threshold: mutable u32&) -> Status can[Unsafe.PointerCast]:
            return Status.InvalidArgument if metadata.count == 0.usize() or metadata.count > max_metadata_bytes
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(metadata) != Tuf::ValidationCode.WellFormed
            bytes_ptr: void& = (&metadata[0]).cast[void&] can Unsafe.PointerCast
            result: i32 = native_tuf_engine_verify_root_v1(bytes_ptr, metadata.count, version, key_count, root_threshold)
            return status_from_native(result)

        def verify_root_update(trusted_root: darray[u8]&, candidate_root: darray[u8]&, version: mutable u64&, key_count: mutable u32&, root_threshold: mutable u32&) -> Status can[Unsafe.PointerCast]:
            return Status.InvalidArgument if trusted_root.count == 0.usize() or trusted_root.count > max_metadata_bytes or candidate_root.count == 0.usize() or candidate_root.count > max_metadata_bytes
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(trusted_root) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(candidate_root) != Tuf::ValidationCode.WellFormed
            trusted_bytes_ptr: void& = (&trusted_root[0]).cast[void&] can Unsafe.PointerCast
            candidate_bytes_ptr: void& = (&candidate_root[0]).cast[void&] can Unsafe.PointerCast
            result: i32 = native_tuf_engine_verify_root_update_v1(trusted_bytes_ptr, trusted_root.count, candidate_bytes_ptr, candidate_root.count, version, key_count, root_threshold)
            return status_from_native(result)

        def check_root_expiry(root: darray[u8]&, now_unix_seconds: i64, now_nanoseconds: u32) -> Status can[Unsafe.PointerCast]:
            return Status.InvalidArgument if root.count == 0.usize() or root.count > max_metadata_bytes
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(root) != Tuf::ValidationCode.WellFormed
            root_bytes_ptr: void& = (&root[0]).cast[void&] can Unsafe.PointerCast
            result: i32 = native_tuf_engine_check_root_expiry_v1(root_bytes_ptr, root.count, now_unix_seconds, now_nanoseconds)
            return status_from_native(result)

        def verify_timestamp(trusted_root: darray[u8]&, timestamp: darray[u8]&, now_unix_seconds: i64, now_nanoseconds: u32, timestamp_version: mutable u64&, snapshot_version: mutable u64&, snapshot_length: mutable u64&, snapshot_sha256: mutable darray[u8]&) -> Status can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return Status.InvalidArgument if trusted_root.count == 0.usize() or trusted_root.count > max_metadata_bytes or timestamp.count == 0.usize() or timestamp.count > max_metadata_bytes
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(trusted_root) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(timestamp) != Tuf::ValidationCode.WellFormed
            snapshot_sha256.resize(32.usize())
            root_bytes_ptr: void& = (&trusted_root[0]).cast[void&] can Unsafe.PointerCast
            timestamp_bytes_ptr: void& = (&timestamp[0]).cast[void&] can Unsafe.PointerCast
            digest_bytes_ptr: void& = (&snapshot_sha256[0]).cast[void&] can Unsafe.PointerCast
            result: i32 = native_tuf_engine_verify_timestamp_v1(root_bytes_ptr, trusted_root.count, timestamp_bytes_ptr, timestamp.count, now_unix_seconds, now_nanoseconds, timestamp_version, snapshot_version, snapshot_length, digest_bytes_ptr)
            if result != 0:
                snapshot_sha256.resize(0.usize())
                return status_from_native(result)
            return Status.Ok

        def verify_snapshot(trusted_root: darray[u8]&, timestamp: darray[u8]&, snapshot: darray[u8]&, now_unix_seconds: i64, now_nanoseconds: u32, snapshot_version: mutable u64&, metadata_count: mutable u32&) -> Status can[Unsafe.PointerCast]:
            return Status.InvalidArgument if trusted_root.count == 0.usize() or trusted_root.count > max_metadata_bytes or timestamp.count == 0.usize() or timestamp.count > max_metadata_bytes or snapshot.count == 0.usize() or snapshot.count > max_metadata_bytes
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(trusted_root) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(timestamp) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(snapshot) != Tuf::ValidationCode.WellFormed
            root_bytes_ptr: void& = (&trusted_root[0]).cast[void&] can Unsafe.PointerCast
            timestamp_bytes_ptr: void& = (&timestamp[0]).cast[void&] can Unsafe.PointerCast
            snapshot_bytes_ptr: void& = (&snapshot[0]).cast[void&] can Unsafe.PointerCast
            result: i32 = native_tuf_engine_verify_snapshot_v1(root_bytes_ptr, trusted_root.count, timestamp_bytes_ptr, timestamp.count, snapshot_bytes_ptr, snapshot.count, now_unix_seconds, now_nanoseconds, snapshot_version, metadata_count)
            return status_from_native(result)

        def get_snapshot_pin(trusted_root: darray[u8]&, timestamp: darray[u8]&, snapshot: darray[u8]&, metadata_name: darray[u8]&, now_unix_seconds: i64, now_nanoseconds: u32, version: mutable u64&, length: mutable u64&, sha256: mutable darray[u8]&) -> Status can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            sha256.resize(0.usize())
            return Status.InvalidArgument if trusted_root.count == 0.usize() or trusted_root.count > max_metadata_bytes or timestamp.count == 0.usize() or timestamp.count > max_metadata_bytes or snapshot.count == 0.usize() or snapshot.count > max_metadata_bytes or metadata_name.count == 0.usize() or metadata_name.count > 256.usize()
            for index in 0..<metadata_name.count |metadata_name|:
                return Status.InvalidMetadata if metadata_name[index] == 0
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(trusted_root) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(timestamp) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(snapshot) != Tuf::ValidationCode.WellFormed
            sha256.resize(32.usize())
            root_bytes_ptr: void& = (&trusted_root[0]).cast[void&] can Unsafe.PointerCast
            timestamp_bytes_ptr: void& = (&timestamp[0]).cast[void&] can Unsafe.PointerCast
            snapshot_bytes_ptr: void& = (&snapshot[0]).cast[void&] can Unsafe.PointerCast
            name_bytes_ptr: void& = (&metadata_name[0]).cast[void&] can Unsafe.PointerCast
            digest_bytes_ptr: void& = (&sha256[0]).cast[void&] can Unsafe.PointerCast
            result: i32 = native_tuf_engine_get_snapshot_pin_v1(root_bytes_ptr, trusted_root.count, timestamp_bytes_ptr, timestamp.count, snapshot_bytes_ptr, snapshot.count, name_bytes_ptr, metadata_name.count, now_unix_seconds, now_nanoseconds, version, length, digest_bytes_ptr)
            if result != 0:
                sha256.resize(0.usize())
                return status_from_native(result)
            return Status.Ok

        def verify_top_level_targets(trusted_root: darray[u8]&, timestamp: darray[u8]&, snapshot: darray[u8]&, targets: darray[u8]&, now_unix_seconds: i64, now_nanoseconds: u32, targets_version: mutable u64&, target_count: mutable u32&, delegation_count: mutable u32&) -> Status can[Unsafe.PointerCast]:
            return Status.InvalidArgument if trusted_root.count == 0.usize() or trusted_root.count > max_metadata_bytes or timestamp.count == 0.usize() or timestamp.count > max_metadata_bytes or snapshot.count == 0.usize() or snapshot.count > max_metadata_bytes or targets.count == 0.usize() or targets.count > max_metadata_bytes
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(trusted_root) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(timestamp) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(snapshot) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(targets) != Tuf::ValidationCode.WellFormed
            root_bytes_ptr: void& = (&trusted_root[0]).cast[void&] can Unsafe.PointerCast
            timestamp_bytes_ptr: void& = (&timestamp[0]).cast[void&] can Unsafe.PointerCast
            snapshot_bytes_ptr: void& = (&snapshot[0]).cast[void&] can Unsafe.PointerCast
            targets_bytes_ptr: void& = (&targets[0]).cast[void&] can Unsafe.PointerCast
            result: i32 = native_tuf_engine_verify_targets_v1(root_bytes_ptr, trusted_root.count, timestamp_bytes_ptr, timestamp.count, snapshot_bytes_ptr, snapshot.count, targets_bytes_ptr, targets.count, now_unix_seconds, now_nanoseconds, targets_version, target_count, delegation_count)
            return status_from_native(result)

        def verify_package_target(trusted_root: darray[u8]&, timestamp: darray[u8]&, snapshot: darray[u8]&, targets: darray[u8]&, delegated_targets: darray[u8]&, package_name: darray[u8]&, registry_identity: darray[u8]&, target_path: darray[u8]&, now_unix_seconds: i64, now_nanoseconds: u32, delegated_targets_version: mutable u64&, target_length: mutable u64&, target_sha256: mutable darray[u8]&, release_status: mutable ReleaseStatus&) -> Status can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            target_sha256.resize(0.usize())
            return Status.InvalidArgument if trusted_root.count == 0.usize() or trusted_root.count > max_metadata_bytes or timestamp.count == 0.usize() or timestamp.count > max_metadata_bytes or snapshot.count == 0.usize() or snapshot.count > max_metadata_bytes or targets.count == 0.usize() or targets.count > max_metadata_bytes or delegated_targets.count == 0.usize() or delegated_targets.count > max_metadata_bytes or package_name.count == 0.usize() or package_name.count > 64.usize() or registry_identity.count == 0.usize() or registry_identity.count > max_registry_identity_bytes or target_path.count == 0.usize() or target_path.count > max_target_path_bytes
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(trusted_root) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(timestamp) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(snapshot) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(targets) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if Tuf::precheck_sha256_hashes(delegated_targets) != Tuf::ValidationCode.WellFormed
            return Status.InvalidMetadata if not Tuf::valid_registry_identity_bytes(registry_identity)
            target_sha256.resize(32.usize())
            root_bytes_ptr: void& = (&trusted_root[0]).cast[void&] can Unsafe.PointerCast
            timestamp_bytes_ptr: void& = (&timestamp[0]).cast[void&] can Unsafe.PointerCast
            snapshot_bytes_ptr: void& = (&snapshot[0]).cast[void&] can Unsafe.PointerCast
            targets_bytes_ptr: void& = (&targets[0]).cast[void&] can Unsafe.PointerCast
            delegated_targets_bytes_ptr: void& = (&delegated_targets[0]).cast[void&] can Unsafe.PointerCast
            package_name_ptr: void& = (&package_name[0]).cast[void&] can Unsafe.PointerCast
            registry_identity_ptr: void& = (&registry_identity[0]).cast[void&] can Unsafe.PointerCast
            target_path_ptr: void& = (&target_path[0]).cast[void&] can Unsafe.PointerCast
            native_delegated_targets_version: mutable u64 = 0.u64()
            native_target_length: mutable u64 = 0.u64()
            native_target_sha256: mutable darray[u8] = []
            native_target_sha256.resize(32.usize())
            digest_bytes_ptr: void& = (&native_target_sha256[0]).cast[void&] can Unsafe.PointerCast
            native_release_status: mutable u8 = 255.u8()
            result: i32 = native_tuf_engine_verify_package_target_v1(root_bytes_ptr, trusted_root.count, timestamp_bytes_ptr, timestamp.count, snapshot_bytes_ptr, snapshot.count, targets_bytes_ptr, targets.count, delegated_targets_bytes_ptr, delegated_targets.count, package_name_ptr, package_name.count, registry_identity_ptr, registry_identity.count, target_path_ptr, target_path.count, now_unix_seconds, now_nanoseconds, &native_delegated_targets_version, &native_target_length, digest_bytes_ptr, &native_release_status)
            if result != 0:
                target_sha256.resize(0.usize())
                return status_from_native(result)
            if native_release_status > 1:
                target_sha256.resize(0.usize())
                return Status.InvalidMetadata
            for digest_index in 0..<32.usize() |native_target_sha256, target_sha256|:
                target_sha256[digest_index] <- native_target_sha256[digest_index]
            delegated_targets_version <- native_delegated_targets_version
            target_length <- native_target_length
            release_status <- ReleaseStatus.Published if native_release_status == 0
            release_status <- ReleaseStatus.Yanked if native_release_status == 1
            return Status.Ok

    private:
        const max_metadata_bytes: usize = 1048576.usize()
        const max_target_path_bytes: usize = 4096.usize()
        const max_registry_identity_bytes: usize = 128.usize()

        def status_from_native(result: i32) -> Status:
            return Status.Ok if result == 0
            return Status.InvalidArgument if result == 1
            return Status.InvalidRoot if result == 2
            return Status.UnsupportedSpec if result == 3
            return Status.ExpiredRoot if result == 5
            return Status.InvalidMetadata if result == 6
            return Status.ExpiredMetadata if result == 7
            return Status.UnsupportedAlgorithm if result == 8
            return Status.RevokedTarget if result == 9
            return Status.InternalPanic

module TufEngineProbe:
    public:
        @link_name("elisapkg_tuf_probe_run_v1")
        def run() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return 1 if TufEngine::abi_version() != expected_abi_version

            malformed_root: mutable darray[u8] = [123, 34, 115, 105, 103, 110, 101, 100, 34, 58, 123, 125, 44, 34, 115, 105, 103, 110, 97, 116, 117, 114, 101, 115, 34, 58, 91, 93, 125]
            version: mutable u64 = 77.u64()
            key_count: mutable u32 = 77.u32()
            threshold: mutable u32 = 77.u32()
            return 2 if TufEngine::verify_root(malformed_root, &version, &key_count, &threshold) != TufEngine::Status.InvalidRoot
            return 3 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            duplicate_keys: mutable darray[u8] = [123, 34, 115, 105, 103, 110, 101, 100, 34, 58, 123, 34, 118, 101, 114, 115, 105, 111, 110, 34, 58, 49, 44, 34, 118, 101, 114, 115, 105, 111, 110, 34, 58, 50, 125, 44, 34, 115, 105, 103, 110, 97, 116, 117, 114, 101, 115, 34, 58, 91, 93, 125]
            return 4 if TufEngine::verify_root(duplicate_keys, &version, &key_count, &threshold) != TufEngine::Status.InvalidMetadata
            return 5 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            valid_root: mutable darray[u8] = [@@ROOT_BYTES@@]
            return 6 if TufEngine::verify_root(valid_root, &version, &key_count, &threshold) != TufEngine::Status.Ok
            return 70 if version != @@ROOT_VERSION@@.u64()
            return 71 if key_count != @@ROOT_KEY_COUNT@@.u32()
            return 72 if threshold != @@ROOT_THRESHOLD@@.u32()

            unsupported_algorithm_root: mutable darray[u8] = [@@UNSUPPORTED_KEY_ALGORITHM_BYTES@@]
            version <- 77.u64()
            key_count <- 77.u32()
            threshold <- 77.u32()
            return 39 if TufEngine::verify_root(unsupported_algorithm_root, &version, &key_count, &threshold) != TufEngine::Status.UnsupportedAlgorithm
            return 40 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            tampered_root: mutable darray[u8] = [@@TAMPERED_ROOT_BYTES@@]
            version <- 77.u64()
            key_count <- 77.u32()
            threshold <- 77.u32()
            return 8 if TufEngine::verify_root(tampered_root, &version, &key_count, &threshold) != TufEngine::Status.InvalidRoot
            return 9 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            unsupported_spec_root: mutable darray[u8] = [@@UNSUPPORTED_SPEC_ROOT_BYTES@@]
            return 10 if TufEngine::verify_root(unsupported_spec_root, &version, &key_count, &threshold) != TufEngine::Status.UnsupportedSpec
            return 11 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            root1: mutable darray[u8] = [@@ROOT1_BYTES@@]
            root2: mutable darray[u8] = [@@ROOT2_BYTES@@]
            root3: mutable darray[u8] = [@@ROOT3_BYTES@@]
            expired_root: mutable darray[u8] = [@@EXPIRED_ROOT_BYTES@@]
            boundary_root: mutable darray[u8] = [@@BOUNDARY_ROOT_BYTES@@]
            timestamp: mutable darray[u8] = [@@TIMESTAMP_BYTES@@]
            expired_timestamp: mutable darray[u8] = [@@EXPIRED_TIMESTAMP_BYTES@@]
            boundary_timestamp: mutable darray[u8] = [@@BOUNDARY_TIMESTAMP_BYTES@@]
            duplicate_signature_timestamp: mutable darray[u8] = [@@DUPLICATE_SIGNATURE_TIMESTAMP_BYTES@@]
            published_timestamp: mutable darray[u8] = [@@PUBLISHED_TIMESTAMP_BYTES@@]
            published_snapshot: mutable darray[u8] = [@@PUBLISHED_SNAPSHOT_BYTES@@]
            published_targets: mutable darray[u8] = [@@PUBLISHED_TARGETS_BYTES@@]
            published_delegated_targets: mutable darray[u8] = [@@PUBLISHED_DELEGATED_TARGETS_BYTES@@]
            yanked_timestamp: mutable darray[u8] = [@@YANKED_TIMESTAMP_BYTES@@]
            yanked_snapshot: mutable darray[u8] = [@@YANKED_SNAPSHOT_BYTES@@]
            yanked_delegated_targets: mutable darray[u8] = [@@YANKED_DELEGATED_TARGETS_BYTES@@]
            revoked_timestamp: mutable darray[u8] = [@@REVOKED_TIMESTAMP_BYTES@@]
            revoked_snapshot: mutable darray[u8] = [@@REVOKED_SNAPSHOT_BYTES@@]
            revoked_delegated_targets: mutable darray[u8] = [@@REVOKED_DELEGATED_TARGETS_BYTES@@]
            bad_signature_timestamp: mutable darray[u8] = [@@BAD_SIGNATURE_TIMESTAMP_BYTES@@]
            bad_signature_snapshot: mutable darray[u8] = [@@BAD_SIGNATURE_SNAPSHOT_BYTES@@]
            bad_signature_delegated_targets: mutable darray[u8] = [@@BAD_SIGNATURE_DELEGATED_TARGETS_BYTES@@]
            direct_package_timestamp: mutable darray[u8] = [@@DIRECT_PACKAGE_TIMESTAMP_BYTES@@]
            direct_package_snapshot: mutable darray[u8] = [@@DIRECT_PACKAGE_SNAPSHOT_BYTES@@]
            direct_package_targets: mutable darray[u8] = [@@DIRECT_PACKAGE_TARGETS_BYTES@@]
            wrong_scope_timestamp: mutable darray[u8] = [@@WRONG_SCOPE_TIMESTAMP_BYTES@@]
            wrong_scope_snapshot: mutable darray[u8] = [@@WRONG_SCOPE_SNAPSHOT_BYTES@@]
            wrong_scope_targets: mutable darray[u8] = [@@WRONG_SCOPE_TARGETS_BYTES@@]
            non_terminating_timestamp: mutable darray[u8] = [@@NON_TERMINATING_TIMESTAMP_BYTES@@]
            non_terminating_snapshot: mutable darray[u8] = [@@NON_TERMINATING_SNAPSHOT_BYTES@@]
            non_terminating_targets: mutable darray[u8] = [@@NON_TERMINATING_TARGETS_BYTES@@]
            zero_threshold_timestamp: mutable darray[u8] = [@@ZERO_THRESHOLD_TIMESTAMP_BYTES@@]
            zero_threshold_snapshot: mutable darray[u8] = [@@ZERO_THRESHOLD_SNAPSHOT_BYTES@@]
            zero_threshold_targets: mutable darray[u8] = [@@ZERO_THRESHOLD_TARGETS_BYTES@@]
            duplicate_delegation_key_timestamp: mutable darray[u8] = [@@DUPLICATE_DELEGATION_KEY_TIMESTAMP_BYTES@@]
            duplicate_delegation_key_snapshot: mutable darray[u8] = [@@DUPLICATE_DELEGATION_KEY_SNAPSHOT_BYTES@@]
            duplicate_delegation_key_targets: mutable darray[u8] = [@@DUPLICATE_DELEGATION_KEY_TARGETS_BYTES@@]
            package_name: mutable darray[u8] = [100, 101, 109, 111]
            registry_primary: mutable darray[u8] = [112, 114, 105, 109, 97, 114, 121]
            registry_other: mutable darray[u8] = [111, 116, 104, 101, 114]
            package_role_name: mutable darray[u8] = [112, 97, 99, 107, 97, 103, 101, 45, 100, 101, 109, 111, 46, 106, 115, 111, 110]
            package_target_path: mutable darray[u8] = [@@PACKAGE_TARGET_PATH_BYTES@@]
            bad_target_path: mutable darray[u8] = [@@BAD_TARGET_PATH_BYTES@@]
            return 12 if TufEngine::verify_root(root1, &version, &key_count, &threshold) != TufEngine::Status.Ok
            return 13 if version != 1.u64() or key_count != 1.u32() or threshold != 1.u32()
            return 14 if TufEngine::verify_root_update(root1, root2, &version, &key_count, &threshold) != TufEngine::Status.Ok
            return 15 if version != 2.u64() or key_count != 1.u32() or threshold != 1.u32()
            return 16 if TufEngine::verify_root_update(root2, root3, &version, &key_count, &threshold) != TufEngine::Status.Ok
            return 17 if version != 3.u64() or key_count != 1.u32() or threshold != 1.u32()
            return 26 if TufEngine::check_root_expiry(root2, 1700000000.i64(), 0.u32()) != TufEngine::Status.ExpiredRoot
            return 27 if TufEngine::check_root_expiry(root3, 1700000000.i64(), 0.u32()) != TufEngine::Status.Ok
            return 28 if TufEngine::check_root_expiry(expired_root, 1700000000.i64(), 0.u32()) != TufEngine::Status.ExpiredRoot
            return 29 if TufEngine::check_root_expiry(boundary_root, 1700000000.i64(), 0.u32()) != TufEngine::Status.ExpiredRoot
            return 30 if TufEngine::check_root_expiry(boundary_root, 1700000000.i64(), 1.u32()) != TufEngine::Status.ExpiredRoot

            timestamp_version: mutable u64 = 77.u64()
            snapshot_version: mutable u64 = 77.u64()
            snapshot_length: mutable u64 = 77.u64()
            snapshot_sha256: mutable darray[u8] = []
            return 31 if TufEngine::verify_timestamp(root3, timestamp, 1700000000.i64(), 0.u32(), &timestamp_version, &snapshot_version, &snapshot_length, &snapshot_sha256) != TufEngine::Status.Ok
            return 32 if timestamp_version != 1.u64() or snapshot_version != 1.u64() or snapshot_length != 2.u64() or snapshot_sha256.count != 32.usize()
            for digest_index in 0..<32 |snapshot_sha256, digest_index|:
                return 33 if snapshot_sha256[digest_index] != 0

            timestamp_version <- 77.u64()
            snapshot_version <- 77.u64()
            snapshot_length <- 77.u64()
            return 34 if TufEngine::verify_timestamp(root3, expired_timestamp, 1700000000.i64(), 0.u32(), &timestamp_version, &snapshot_version, &snapshot_length, &snapshot_sha256) != TufEngine::Status.ExpiredMetadata
            return 35 if timestamp_version != 77.u64() or snapshot_version != 77.u64() or snapshot_length != 77.u64() or snapshot_sha256.count != 0.usize()
            return 36 if TufEngine::verify_timestamp(root3, boundary_timestamp, 1699999999.i64(), 999999999.u32(), &timestamp_version, &snapshot_version, &snapshot_length, &snapshot_sha256) != TufEngine::Status.Ok
            return 37 if TufEngine::verify_timestamp(root3, boundary_timestamp, 1700000000.i64(), 0.u32(), &timestamp_version, &snapshot_version, &snapshot_length, &snapshot_sha256) != TufEngine::Status.ExpiredMetadata
            return 38 if TufEngine::verify_timestamp(root3, boundary_timestamp, 1700000000.i64(), 1.u32(), &timestamp_version, &snapshot_version, &snapshot_length, &snapshot_sha256) != TufEngine::Status.ExpiredMetadata
            timestamp_version <- 77.u64()
            snapshot_version <- 77.u64()
            snapshot_length <- 77.u64()
            return 41 if TufEngine::verify_timestamp(root3, duplicate_signature_timestamp, 1700000000.i64(), 0.u32(), &timestamp_version, &snapshot_version, &snapshot_length, &snapshot_sha256) != TufEngine::Status.InvalidMetadata
            return 42 if timestamp_version != 77.u64() or snapshot_version != 77.u64() or snapshot_length != 77.u64() or snapshot_sha256.count != 0.usize()

            verified_snapshot_version: mutable u64 = 77.u64()
            snapshot_metadata_count: mutable u32 = 77.u32()
            return 51 if TufEngine::verify_snapshot(root3, published_timestamp, published_snapshot, 1700000000.i64(), 0.u32(), &verified_snapshot_version, &snapshot_metadata_count) != TufEngine::Status.Ok
            return 52 if verified_snapshot_version != 1.u64() or snapshot_metadata_count != 2.u32()

            pinned_version: mutable u64 = 77.u64()
            pinned_length: mutable u64 = 77.u64()
            pinned_sha256: mutable darray[u8] = []
            return 53 if TufEngine::get_snapshot_pin(root3, published_timestamp, published_snapshot, package_role_name, 1700000000.i64(), 0.u32(), &pinned_version, &pinned_length, &pinned_sha256) != TufEngine::Status.Ok
            return 54 if pinned_version != 1.u64() or pinned_length != @@DELEGATED_TARGETS_LENGTH@@.u64() or pinned_sha256.count != 32.usize()
            expected_delegated_sha256: mutable darray[u8] = [@@DELEGATED_TARGETS_SHA256_BYTES@@]
            for digest_index in 0..<32 |pinned_sha256, digest_index|:
                return 55 if pinned_sha256[digest_index] != expected_delegated_sha256[digest_index]

            verified_targets_version: mutable u64 = 77.u64()
            verified_target_count: mutable u32 = 77.u32()
            verified_delegation_count: mutable u32 = 77.u32()
            return 56 if TufEngine::verify_top_level_targets(root3, published_timestamp, published_snapshot, published_targets, 1700000000.i64(), 0.u32(), &verified_targets_version, &verified_target_count, &verified_delegation_count) != TufEngine::Status.Ok
            return 57 if verified_targets_version != 1.u64() or verified_target_count != 1.u32() or verified_delegation_count != 1.u32()

            verified_targets_version <- 77.u64()
            verified_target_count <- 77.u32()
            verified_delegation_count <- 77.u32()
            return 74 if TufEngine::verify_top_level_targets(root3, direct_package_timestamp, direct_package_snapshot, direct_package_targets, 1700000000.i64(), 0.u32(), &verified_targets_version, &verified_target_count, &verified_delegation_count) != TufEngine::Status.InvalidMetadata
            return 75 if verified_targets_version != 77.u64() or verified_target_count != 77.u32() or verified_delegation_count != 77.u32()
            return 76 if TufEngine::verify_top_level_targets(root3, wrong_scope_timestamp, wrong_scope_snapshot, wrong_scope_targets, 1700000000.i64(), 0.u32(), &verified_targets_version, &verified_target_count, &verified_delegation_count) != TufEngine::Status.InvalidMetadata
            return 77 if verified_targets_version != 77.u64() or verified_target_count != 77.u32() or verified_delegation_count != 77.u32()
            return 78 if TufEngine::verify_top_level_targets(root3, non_terminating_timestamp, non_terminating_snapshot, non_terminating_targets, 1700000000.i64(), 0.u32(), &verified_targets_version, &verified_target_count, &verified_delegation_count) != TufEngine::Status.InvalidMetadata
            return 79 if verified_targets_version != 77.u64() or verified_target_count != 77.u32() or verified_delegation_count != 77.u32()
            return 80 if TufEngine::verify_top_level_targets(root3, zero_threshold_timestamp, zero_threshold_snapshot, zero_threshold_targets, 1700000000.i64(), 0.u32(), &verified_targets_version, &verified_target_count, &verified_delegation_count) != TufEngine::Status.InvalidMetadata
            return 81 if verified_targets_version != 77.u64() or verified_target_count != 77.u32() or verified_delegation_count != 77.u32()
            return 82 if TufEngine::verify_top_level_targets(root3, duplicate_delegation_key_timestamp, duplicate_delegation_key_snapshot, duplicate_delegation_key_targets, 1700000000.i64(), 0.u32(), &verified_targets_version, &verified_target_count, &verified_delegation_count) != TufEngine::Status.InvalidMetadata
            return 83 if verified_targets_version != 77.u64() or verified_target_count != 77.u32() or verified_delegation_count != 77.u32()

            delegated_targets_version: mutable u64 = 77.u64()
            archive_length: mutable u64 = 77.u64()
            archive_sha256: mutable darray[u8] = []
            release_status: mutable TufEngine::ReleaseStatus = TufEngine::ReleaseStatus.Yanked
            return 58 if TufEngine::verify_package_target(root3, published_timestamp, published_snapshot, published_targets, published_delegated_targets, package_name, registry_primary, package_target_path, 1700000000.i64(), 0.u32(), &delegated_targets_version, &archive_length, &archive_sha256, &release_status) != TufEngine::Status.Ok
            return 59 if delegated_targets_version != 1.u64() or archive_length != @@ARCHIVE_LENGTH@@.u64() or release_status != TufEngine::ReleaseStatus.Published or archive_sha256.count != 32.usize()
            expected_archive_sha256: mutable darray[u8] = [@@ARCHIVE_SHA256_BYTES@@]
            for digest_index in 0..<32 |archive_sha256, digest_index|:
                return 60 if archive_sha256[digest_index] != expected_archive_sha256[digest_index]

            return 61 if TufEngine::verify_package_target(root3, yanked_timestamp, yanked_snapshot, published_targets, yanked_delegated_targets, package_name, registry_primary, package_target_path, 1700000000.i64(), 0.u32(), &delegated_targets_version, &archive_length, &archive_sha256, &release_status) != TufEngine::Status.Ok
            return 62 if release_status != TufEngine::ReleaseStatus.Yanked or archive_length != @@ARCHIVE_LENGTH@@.u64()

            delegated_targets_version <- 77.u64()
            archive_length <- 77.u64()
            release_status <- TufEngine::ReleaseStatus.Published
            return 63 if TufEngine::verify_package_target(root3, revoked_timestamp, revoked_snapshot, published_targets, revoked_delegated_targets, package_name, registry_primary, package_target_path, 1700000000.i64(), 0.u32(), &delegated_targets_version, &archive_length, &archive_sha256, &release_status) != TufEngine::Status.RevokedTarget
            return 64 if delegated_targets_version != 77.u64() or archive_length != 77.u64() or release_status != TufEngine::ReleaseStatus.Published or archive_sha256.count != 0.usize()

            delegated_targets_version <- 77.u64()
            archive_length <- 77.u64()
            release_status <- TufEngine::ReleaseStatus.Yanked
            return 65 if TufEngine::verify_package_target(root3, published_timestamp, published_snapshot, published_targets, published_delegated_targets, package_name, registry_other, package_target_path, 1700000000.i64(), 0.u32(), &delegated_targets_version, &archive_length, &archive_sha256, &release_status) != TufEngine::Status.InvalidMetadata
            return 66 if delegated_targets_version != 77.u64() or archive_length != 77.u64() or release_status != TufEngine::ReleaseStatus.Yanked or archive_sha256.count != 0.usize()

            delegated_targets_version <- 77.u64()
            archive_length <- 77.u64()
            return 67 if TufEngine::verify_package_target(root3, published_timestamp, published_snapshot, published_targets, published_delegated_targets, package_name, registry_primary, bad_target_path, 1700000000.i64(), 0.u32(), &delegated_targets_version, &archive_length, &archive_sha256, &release_status) != TufEngine::Status.InvalidMetadata
            return 68 if delegated_targets_version != 77.u64() or archive_length != 77.u64() or archive_sha256.count != 0.usize()

            delegated_targets_version <- 77.u64()
            archive_length <- 77.u64()
            release_status <- TufEngine::ReleaseStatus.Published
            return 69 if TufEngine::verify_package_target(root3, bad_signature_timestamp, bad_signature_snapshot, published_targets, bad_signature_delegated_targets, package_name, registry_primary, package_target_path, 1700000000.i64(), 0.u32(), &delegated_targets_version, &archive_length, &archive_sha256, &release_status) != TufEngine::Status.InvalidMetadata
            return 73 if delegated_targets_version != 77.u64() or archive_length != 77.u64() or release_status != TufEngine::ReleaseStatus.Published or archive_sha256.count != 0.usize()

            version <- 77.u64()
            key_count <- 77.u32()
            threshold <- 77.u32()
            return 18 if TufEngine::verify_root_update(root1, root3, &version, &key_count, &threshold) != TufEngine::Status.InvalidRoot
            return 19 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            duplicate_root2: mutable darray[u8] = [@@DUPLICATE_ROOT2_BYTES@@]
            return 24 if TufEngine::verify_root_update(root1, duplicate_root2, &version, &key_count, &threshold) != TufEngine::Status.InvalidMetadata
            return 25 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            duplicate_signature_root2: mutable darray[u8] = [@@DUPLICATE_SIGNATURE_ROOT2_BYTES@@]
            return 43 if TufEngine::verify_root_update(root1, duplicate_signature_root2, &version, &key_count, &threshold) != TufEngine::Status.InvalidRoot
            return 44 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            oversized_signatures_root2: mutable darray[u8] = [@@OVERSIZED_SIGNATURES_ROOT2_BYTES@@]
            return 45 if TufEngine::verify_root_update(root1, oversized_signatures_root2, &version, &key_count, &threshold) != TufEngine::Status.InvalidRoot
            return 46 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            tampered_root2: mutable darray[u8] = [@@TAMPERED_ROOT2_BYTES@@]
            return 20 if TufEngine::verify_root_update(root1, tampered_root2, &version, &key_count, &threshold) != TufEngine::Status.InvalidRoot
            return 21 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            unsupported_root2: mutable darray[u8] = [@@UNSUPPORTED_ROOT2_BYTES@@]
            return 22 if TufEngine::verify_root_update(root1, unsupported_root2, &version, &key_count, &threshold) != TufEngine::Status.UnsupportedSpec
            return 23 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            oversized_role_root2: mutable darray[u8] = [@@OVERSIZED_ROLE_ROOT2_BYTES@@]
            return 47 if TufEngine::verify_root_update(root1, oversized_role_root2, &version, &key_count, &threshold) != TufEngine::Status.InvalidRoot
            return 48 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()

            oversized_root_keys: mutable darray[u8] = [@@OVERSIZED_ROOT_KEYS_BYTES@@]
            return 49 if TufEngine::verify_root(oversized_root_keys, &version, &key_count, &threshold) != TufEngine::Status.InvalidRoot
            return 50 if version != 77.u64() or key_count != 77.u32() or threshold != 77.u32()
            return 0

    private:
        const expected_abi_version: u32 = 1.u32()
